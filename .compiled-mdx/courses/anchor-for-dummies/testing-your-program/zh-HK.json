8,"column":4,"offset":3104}}},{"type":"inlineCode","value":"account","position":{"start":{"line":128,"column":4,"offset":3104},"end":{"line":128,"column":13,"offset":3113}}},{"type":"text","value":" 標誌從 JSON 文件加載本地帳戶：","position":{"start":{"line":128,"column":13,"offset":3113},"end":{"line":128,"column":32,"offset":3132}}}],"position":{"start":{"line":128,"column":1,"offset":3101},"end":{"line":128,"column":32,"offset":3132}}},{"type":"code","lang":null,"meta":null,"value":"[[test.validator.account]]\r\naddress = \"Ev8WSPQsGb4wfjybqff5eZNcS3n6HaMsBkMk9suAiuM\"\r\nfilename = \"some_account.json\"","position":{"start":{"line":130,"column":1,"offset":3136},"end":{"line":134,"column":4,"offset":3261}},"data":{"highlightId":"code-3"}},{"type":"paragraph","children":[{"type":"text","value":"此方法非常適合用於測試預配置的帳戶狀態或主網中不存在的特定配置。","position":{"start":{"line":136,"column":1,"offset":3265},"end":{"line":136,"column":33,"offset":3297}}}],"position":{"start":{"line":136,"column":1,"offset":3265},"end":{"line":136,"column":33,"offset":3297}}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Running Surfnet","position":{"start":{"line":138,"column":17,"offset":3317},"end":{"line":138,"column":39,"offset":3339}}},{"type":"mdxJsxAttribute","name":"id","value":"running-surfnet","position":{"start":{"line":138,"column":40,"offset":3340},"end":{"line":138,"column":60,"offset":3360}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":138,"column":61,"offset":3361},"end":{"line":138,"column":71,"offset":3371}}}],"children":[],"position":{"start":{"line":138,"column":1,"offset":3301},"end":{"line":138,"column":74,"offset":3374}}},{"type":"paragraph","children":[{"type":"text","value":"測試依賴於跨程式調用（CPI）的 Solana 程式，傳統上需要開發者從主網導出帳戶和程式，就像我們在本地驗證器部分看到的那樣。","position":{"start":{"line":140,"column":1,"offset":3378},"end":{"line":140,"column":65,"offset":3442}}}],"position":{"start":{"line":140,"column":1,"offset":3378},"end":{"line":140,"column":65,"offset":3442}}},{"type":"paragraph","children":[{"type":"text","value":"此過程適用於少量帳戶，但當測試複雜程式（如 Jupiter）中的 CPI 時，這些程式可能依賴於超過 40 個帳戶和 8 個以上的程式，這就完全不可行了。","position":{"start":{"line":142,"column":1,"offset":3446},"end":{"line":142,"column":78,"offset":3523}}}],"position":{"start":{"line":142,"column":1,"offset":3446},"end":{"line":142,"column":78,"offset":3523}}},{"type":"paragraph","children":[{"type":"text","value":"Surfnet 是 solana-test-validator 的替代方案，允許開發者使用按需獲取的主網帳戶在本地模擬程式。","position":{"start":{"line":144,"column":1,"offset":3527},"end":{"line":144,"column":63,"offset":3589}}}],"position":{"start":{"line":144,"column":1,"offset":3527},"end":{"line":144,"column":63,"offset":3589}}},{"type":"paragraph","children":[{"type":"text","value":"要使用它，只需通過官方的","position":{"start":{"line":146,"column":1,"offset":3593},"end":{"line":146,"column":13,"offset":3605}}},{"type":"link","title":null,"url":"https://docs.surfpool.run/install","children":[{"type":"text","value":"安裝頁面","position":{"start":{"line":146,"column":14,"offset":3606},"end":{"line":146,"column":18,"offset":3610}}}],"position":{"start":{"line":146,"column":13,"offset":3605},"end":{"line":146,"column":54,"offset":3646}}},{"type":"text","value":"安裝 surfpool，然後運行：","position":{"start":{"line":146,"column":54,"offset":3646},"end":{"line":146,"column":71,"offset":3663}}}],"position":{"start":{"line":146,"column":1,"offset":3593},"end":{"line":146,"column":71,"offset":3663}}},{"type":"code","lang":"bash","meta":null,"value":"surfpool start","position":{"start":{"line":148,"column":1,"offset":3667},"end":{"line":150,"column":4,"offset":3695}}},{"type":"paragraph","children":[{"type":"text","value":"現在，您可以通過定位本地驗證器連接到 Surfnet：","position":{"start":{"line":152,"column":1,"offset":3699},"end":{"line":152,"column":28,"offset":3726}}}],"position":{"start":{"line":152,"column":1,"offset":3699},"end":{"line":152,"column":28,"offset":3726}}},{"type":"code","lang":"ts","meta":null,"value":"import { Connection } from \"@solana/web3.js\";\r\n\r\nconst connection = new Connection(\"http://localhost:8899\", \"confirmed\");","position":{"start":{"line":154,"column":1,"offset":3730},"end":{"line":158,"column":4,"offset":3863}},"data":{"highlightId":"code-4"}},{"type":"paragraph","children":[{"type":"text","value":"我們在","position":{"start":{"line":160,"column":1,"offset":3867},"end":{"line":160,"column":4,"offset":3870}}},{"type":"link","title":null,"url":"/zh-HK/courses/testing-with-surfpool","children":[{"type":"text","value":"這裡","position":{"start":{"line":160,"column":5,"offset":3871},"end":{"line":160,"column":7,"offset":3873}}}],"position":{"start":{"line":160,"column":4,"offset":3870},"end":{"line":160,"column":46,"offset":3912}}},{"type":"text","value":"詳細介紹了 Surfnet 的設置和使用。","position":{"start":{"line":160,"column":46,"offset":3912},"end":{"line":160,"column":67,"offset":3933}}}],"position":{"start":{"line":160,"column":1,"offset":3867},"end":{"line":160,"column":67,"offset":3933}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":161,"column":1,"offset":3935}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# 測試你的程式\r\n\r\n徹底測試可以防止財務損失、建立用戶信任，並確保你的程式在所有情況下都能正確運行。\r\n\r\n> 在主網部署前進行嚴格測試。\r\n\r\n<ArticleSection name=\"TypeScript Tests\" id=\"typescript-tests\" level=\"h2\" />\r\n\r\nTypeScript 測試是最常見的方法，因為無論如何你都需要為你的 dApp 客戶端使用 TypeScript。這讓你可以同時開發測試和客戶端代碼。\r\n\r\n我們在[這裡](/zh-HK/courses/anchor-for-dummies/client-side-development)詳細介紹了客戶端設置。\r\n\r\n> 每個 Anchor CLI 專案都包含一個測試資料夾，其中有一個準備好進行測試的 TypeScript 文件。\r\n\r\nTypeScript 測試提供了以下主要優勢：\r\n- 模擬真實的客戶端互動\r\n- 測試複雜的工作流程和邊界情況\r\n- 對 API 更改提供即時反饋\r\n- 驗證成功和錯誤場景\r\n\r\n運行測試指令：\r\n\r\n```bash\r\nanchor test\r\n```\r\n\r\n> 通過在配置中將集群設置為 localnet 在 localnet 上運行。這將啟動一個本地驗證器並向提供者錢包添加 1,000 SOL。如果你需要內含數據的額外帳戶，請參考[本地驗證器](/zh-HK/courses/anchor-for-dummies/testing-your-program#running-a-local-validator)。\r\n\r\n<ArticleSection name=\"Mollusk Tests\" id=\"mollusk-tests\" level=\"h2\" />\r\n\r\n當你需要對測試環境或複雜的程式狀態設置進行精細控制時，Mollusk 提供了解決方案。\r\n\r\nMollusk 是一個專為 Solana 程式構建的 Rust 測試框架。它使你能夠：\r\n- 在沒有網絡負擔的情況下隔離測試程式邏輯\r\n- 輕鬆設置複雜的帳戶狀態\r\n- 測試速度比完整的集成測試更快\r\n- 模擬特定的區塊鏈條件和邊界情況\r\n\r\n我們在[這裡](/zh-HK/courses/testing-with-mollusk)詳細介紹了 Mollusk 測試。\r\n\r\n使用 Mollusk 創建一個新的 Anchor 程式：\r\n\r\n```bash\r\nanchor init <name-of-the-project> --test-template mollusk\r\n```\r\n\r\n運行測試指令：\r\n\r\n```bash\r\nanchor test\r\n```\r\n\r\n<ArticleSection name=\"LiteSVM 測試\" id=\"litesvm-tests\" level=\"h2\" />\r\n\r\n當你需要像 Mollusk 一樣對程式狀態進行細緻控制，但使用 TypeScript 時，LiteSVM 提供了最佳解決方案。\r\n\r\nLiteSVM 是一個輕量級測試框架，直接在你的測試過程中運行 Solana 虛擬機。它使你能夠：\r\n- 比傳統框架（如 `solana-program-test`）更快地執行測試\r\n- 精確操作帳戶狀態和系統變數\r\n- 支援多種語言測試：TypeScript、Rust 和 Python\r\n- 輕鬆模擬複雜的區塊鏈條件和邊界情況\r\n\r\nLiteSVM 通過將虛擬機嵌入到你的測試中，消除了驗證器的負擔，提供了快速開發週期所需的速度，同時不犧牲測試的準確性。\r\n\r\n我們在[這裡](/zh-HK/courses/testing-with-litesvm)全面介紹了 LiteSVM 測試。\r\n\r\n你可以設置你的 Anchor 提供者，並使用我們[之前](/zh-HK/courses/anchor-for-dummies/client-side-development)看到的客戶端設置與 `anchor-litesvm` 套件一起使用。\r\n\r\n安裝 `anchor-litesvm` 套件。\r\n\r\n```bash\r\nnpm install git:https://github.com/LiteSVM/anchor-litesvm\r\n```\r\n\r\n然後將默認的 Anchor 提供者更改為 `LiteSVMProvider`，如下所示：\r\n\r\n```ts\r\nimport { fromWorkspace, LiteSVMProvider } from \"anchor-litesvm\";\r\n\r\ntest(\"anchor\", async () => {\r\n\tconst client = fromWorkspace(\"target/types/<program-name>.ts\");\r\n\tconst provider = new LiteSVMProvider(client);\r\n\tconst program = new Program<Puppet>(IDL, provider);\r\n\r\n    // program.methods..\r\n})\r\n```\r\n\r\n<ArticleSection name=\"運行本地驗證器\" id=\"running-a-local-validator\" level=\"h2\" />\r\n\r\n使用作為個人區塊鏈沙盒的驗證器在本地模擬主網行為。當你將集群設置為 localnet 時，這將自動發生。\r\n\r\n本地驗證器運行一個簡化的 Solana 賬本，並預先安裝了原生程序。默認情況下，它僅存儲測試數據，無法訪問現有的主網帳戶——限制了使用已建立協議進行測試的能力。\r\n\r\n### 配置你的本地驗證器\r\n\r\n在 `Anchor.toml` 的 `[test]` 部分下自定義你的驗證器：\r\n\r\n```\r\n[test]\r\nstartup_wait = 10000\r\n```\r\n\r\n`startup_wait` 標誌延遲驗證器啟動，這在克隆多個增加加載時間的帳戶時非常有用。\r\n\r\n### 克隆主網帳戶\r\n\r\n使用 `[test.validator]` 配置克隆現有的主網帳戶和程序：\r\n\r\n```\r\n[test.validator]\r\nurl = \"https://api.mainnet-beta.solana.com\"\r\n\r\n[[test.validator.clone]]\r\naddress = \"7NL2qWArf2BbEBBH1vTRZCsoNqFATTddH6h8GkVvrLpG\"\r\n[[test.validator.clone]]\r\naddress = \"2RaN5auQwMdg5efgCaVqpETBV8sacWGR8tkK4m9kjo5r\"\r\n[[test.validator.clone]]\r\naddress = \"metaqbxxUerdq28cj1RbAWkYQm3ybzjb6a8bt518x1s\"\r\n```\r\n\r\n`clone` 部分會從指定的叢集複製帳戶。如果某個帳戶鏈接到由 \"BPF 可升級加載器\" 管理的程式，Anchor 會自動克隆相關的程式數據帳戶。\r\n\r\n### 加載本地帳戶數據\r\n\r\n使用 `account` 標誌從 JSON 文件加載本地帳戶：\r\n\r\n```\r\n[[test.validator.account]]\r\naddress = \"Ev8WSPQsGb4wfjybqff5eZNcS3n6HaMsBkMk9suAiuM\"\r\nfilename = \"some_account.json\"\r\n```\r\n\r\n此方法非常適合用於測試預配置的帳戶狀態或主網中不存在的特定配置。\r\n\r\n<ArticleSection name=\"Running Surfnet\" id=\"running-surfnet\" level=\"h2\" />\r\n\r\n測試依賴於跨程式調用（CPI）的 Solana 程式，傳統上需要開發者從主網導出帳戶和程式，就像我們在本地驗證器部分看到的那樣。\r\n\r\n此過程適用於少量帳戶，但當測試複雜程式（如 Jupiter）中的 CPI 時，這些程式可能依賴於超過 40 個帳戶和 8 個以上的程式，這就完全不可行了。\r\n\r\nSurfnet 是 solana-test-validator 的替代方案，允許開發者使用按需獲取的主網帳戶在本地模擬程式。\r\n\r\n要使用它，只需通過官方的[安裝頁面](https://docs.surfpool.run/install)安裝 surfpool，然後運行：\r\n\r\n```bash\r\nsurfpool start\r\n```\r\n\r\n現在，您可以通過定位本地驗證器連接到 Surfnet：\r\n\r\n```ts\r\nimport { Connection } from \"@solana/web3.js\";\r\n\r\nconst connection = new Connection(\"http://localhost:8899\", \"confirmed\");\r\n```\r\n\r\n我們在[這裡](/zh-HK/courses/testing-with-surfpool)詳細介紹了 Surfnet 的設置和使用。\r\n","highlightedCode":{"code-0":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"import"}]},{"type":"element","tagName":"span","properties":{"style":"color: