","value":"配置您的本地验证器","position":{"start":{"line":97,"column":5,"offset":2479},"end":{"line":97,"column":14,"offset":2488}}}],"position":{"start":{"line":97,"column":1,"offset":2475},"end":{"line":97,"column":14,"offset":2488}}},{"type":"paragraph","children":[{"type":"text","value":"在 ","position":{"start":{"line":99,"column":1,"offset":2492},"end":{"line":99,"column":3,"offset":2494}}},{"type":"inlineCode","value":"Anchor.toml","position":{"start":{"line":99,"column":3,"offset":2494},"end":{"line":99,"column":16,"offset":2507}}},{"type":"text","value":" 的 ","position":{"start":{"line":99,"column":16,"offset":2507},"end":{"line":99,"column":19,"offset":2510}}},{"type":"inlineCode","value":"[test]","position":{"start":{"line":99,"column":19,"offset":2510},"end":{"line":99,"column":27,"offset":2518}}},{"type":"text","value":" 部分下自定义您的验证器：","position":{"start":{"line":99,"column":27,"offset":2518},"end":{"line":99,"column":40,"offset":2531}}}],"position":{"start":{"line":99,"column":1,"offset":2492},"end":{"line":99,"column":40,"offset":2531}}},{"type":"code","lang":null,"meta":null,"value":"[test]\r\nstartup_wait = 10000","position":{"start":{"line":101,"column":1,"offset":2535},"end":{"line":104,"column":4,"offset":2573}},"data":{"highlightId":"code-1"}},{"type":"paragraph","children":[{"type":"inlineCode","value":"startup_wait","position":{"start":{"line":106,"column":1,"offset":2577},"end":{"line":106,"column":15,"offset":2591}}},{"type":"text","value":" 标志会延迟验证器启动，这在克隆多个增加加载时间的账户时非常有用。","position":{"start":{"line":106,"column":15,"offset":2591},"end":{"line":106,"column":48,"offset":2624}}}],"position":{"start":{"line":106,"column":1,"offset":2577},"end":{"line":106,"column":48,"offset":2624}}},{"type":"heading","depth":3,"children":[{"type":"text","value":"克隆主网账户","position":{"start":{"line":108,"column":5,"offset":2632},"end":{"line":108,"column":11,"offset":2638}}}],"position":{"start":{"line":108,"column":1,"offset":2628},"end":{"line":108,"column":11,"offset