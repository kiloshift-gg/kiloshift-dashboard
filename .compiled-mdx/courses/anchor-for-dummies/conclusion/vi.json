e":21,"column":60,"offset":1027}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Xây dựng và kiểm thử chương trình Anchor đầu tiên của bạn","position":{"start":{"line":22,"column":4,"offset":1032},"end":{"line":22,"column":61,"offset":1089}}}],"position":{"start":{"line":22,"column":4,"offset":1032},"end":{"line":22,"column":61,"offset":1089}}}],"position":{"start":{"line":22,"column":1,"offset":1029},"end":{"line":22,"column":61,"offset":1089}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Tham gia cộng đồng của chúng tôi để chia sẻ tiến trình và nhận trợ giúp","position":{"start":{"line":23,"column":4,"offset":1094},"end":{"line":23,"column":75,"offset":1165}}}],"position":{"start":{"line":23,"column":4,"offset":1094},"end":{"line":23,"column":75,"offset":1165}}}],"position":{"start":{"line":23,"column":1,"offset":1091},"end":{"line":23,"column":75,"offset":1165}}}],"position":{"start":{"line":20,"column":1,"offset":927},"end":{"line":23,"column":75,"offset":1165}}},{"type":"paragraph","children":[{"type":"text","value":"Hãy nhớ, mọi developer giỏi đều bắt đầu với chương trình đầu tiên của họ. Đừng ngại thử nghiệm và mắc lỗi; đó là cách chúng ta học hỏi và phát triển!","position":{"start":{"line":25,"column":1,"offset":1169},"end":{"line":25,"column":150,"offset":1318}}}],"position":{"start":{"line":25,"column":1,"offset":1169},"end":{"line":25,"column":150,"offset":1318}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":26,"column":1,"offset":1320}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\nimport { AnchorDiscriminatorCalculator } from \"../../../../components/AnchorDiscriminatorCalculator/AnchorDiscriminatorCalculator\";\r\n\r\n# Kết luận\r\n\r\nChúc mừng! Bạn đã hoàn thành khóa học Introduction to Anchor. Giờ đây bạn đã có nền tảng vững chắc trong việc hiểu cách Anchor hoạt động, từ các khái niệm cốt lõi đến chi tiết triển khai thực tế.\r\n\r\n## Những gì bạn đã học được\r\n\r\nTrong suốt khóa học này, bạn đã có được kiến thức cần thiết về:\r\n- Các nguyên tắc cơ bản của framework Anchor\r\n- Cách cấu trúc các chương trình Anchor\r\n- Hiểu về program discriminator\r\n- Các phương pháp tốt nhất để xây dựng các chương trình Solana bảo mật\r\n\r\n## Các bước tiếp theo\r\n\r\nBây giờ bạn đã sẵn sàng để bắt đầu xây dựng chương trình đầu tiên với Anchor! Cách tốt nhất để củng cố kiến thức của bạn là thông qua thực hành. Chúng tôi khuyến khích bạn:\r\n\r\n1. Đến [phần Thử thách](/vi/challenges)\r\n2. Bắt đầu với các bài tập thân thiện với người mới bắt đầu\r\n3. Xây dựng và kiểm thử chương trình Anchor đầu tiên của bạn\r\n4. Tham gia cộng đồng của chúng tôi để chia sẻ tiến trình và nhận trợ giúp\r\n\r\nHãy nhớ, mọi developer giỏi đều bắt đầu với chương trình đầu tiên của họ. Đừng ngại thử nghiệm và mắc lỗi; đó là cách chúng ta học hỏi và phát triển!\r\n","highlightedCode":{}}