ype":"text","value":"Створити та протестувати вашу першу програму Anchor","position":{"start":{"line":22,"column":4,"offset":899},"end":{"line":22,"column":55,"offset":950}}}],"position":{"start":{"line":22,"column":4,"offset":899},"end":{"line":22,"column":55,"offset":950}}}],"position":{"start":{"line":22,"column":1,"offset":896},"end":{"line":22,"column":55,"offset":950}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Приєднатися до нашої спільноти, щоб поділитися своїм прогресом і отримати допомогу","position":{"start":{"line":23,"column":4,"offset":955},"end":{"line":23,"column":86,"offset":1037}}}],"position":{"start":{"line":23,"column":4,"offset":955},"end":{"line":23,"column":86,"offset":1037}}}],"position":{"start":{"line":23,"column":1,"offset":952},"end":{"line":23,"column":86,"offset":1037}}}],"position":{"start":{"line":20,"column":1,"offset":811},"end":{"line":23,"column":86,"offset":1037}}},{"type":"paragraph","children":[{"type":"text","value":"Пам'ятайте, кожен видатний розробник починав зі своєї першої програми. Не бійтеся експериментувати та робити помилки; саме так ми вчимося і розвиваємося!","position":{"start":{"line":25,"column":1,"offset":1041},"end":{"line":25,"column":154,"offset":1194}}}],"position":{"start":{"line":25,"column":1,"offset":1041},"end":{"line":25,"column":154,"offset":1194}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":26,"column":1,"offset":1196}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\nimport { AnchorDiscriminatorCalculator } from \"../../../../components/AnchorDiscriminatorCalculator/AnchorDiscriminatorCalculator\";\r\n\r\n# Висновок\r\n\r\nВітаємо! Ви завершили курс \"Вступ до Anchor\". Тепер у вас є міцна основа для розуміння того, як працює Anchor, від його основних концепцій до практичних деталей реалізації.\r\n\r\n## Що ви вивчили\r\n\r\nПротягом цього курсу ви отримали важливі знання про:\r\n- Основи фреймворку Anchor\r\n- Як структурувати програми Anchor\r\n- Розуміння дискримінаторів програм\r\n- Найкращі практики для створення безпечних програм Solana\r\n\r\n## Наступні кроки\r\n\r\nТепер ви готові почати створювати свою першу програму з Anchor! Найкращий спосіб закріпити свої знання — це практика. Ми заохочуємо вас:\r\n\r\n1. Перейти до [розділу Завдання](/uk/challenges)\r\n2. Почати з вправ для початківців\r\n3. Створити та протестувати вашу першу програму Anchor\r\n4. Приєднатися до нашої спільноти, щоб поділитися своїм прогресом і отримати допомогу\r\n\r\nПам'ятайте, кожен видатний розробник починав зі своєї першої програми. Не бійтеся експериментувати та робити помилки; саме так ми вчимося і розвиваємося!\r\n","highlightedCode":{}}