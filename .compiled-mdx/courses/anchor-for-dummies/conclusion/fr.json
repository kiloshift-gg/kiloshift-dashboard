6},"end":{"line":21,"column":53,"offset":1125}}}],"position":{"start":{"line":21,"column":1,"offset":1073},"end":{"line":21,"column":53,"offset":1125}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Créer et tester votre premier programme Anchor","position":{"start":{"line":22,"column":4,"offset":1130},"end":{"line":22,"column":50,"offset":1176}}}],"position":{"start":{"line":22,"column":4,"offset":1130},"end":{"line":22,"column":50,"offset":1176}}}],"position":{"start":{"line":22,"column":1,"offset":1127},"end":{"line":22,"column":50,"offset":1176}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Rejoindre notre communauté pour partager vos progrès et obtenir de l'aide","position":{"start":{"line":23,"column":4,"offset":1181},"end":{"line":23,"column":77,"offset":1254}}}],"position":{"start":{"line":23,"column":4,"offset":1181},"end":{"line":23,"column":77,"offset":1254}}}],"position":{"start":{"line":23,"column":1,"offset":1178},"end":{"line":23,"column":77,"offset":1254}}}],"position":{"start":{"line":20,"column":1,"offset":1020},"end":{"line":23,"column":77,"offset":1254}}},{"type":"paragraph","children":[{"type":"text","value":"N'oubliez pas, tous les grands développeurs ont commencé par leur premier programme. N'ayez pas peur d'expérimenter et de faire des erreurs; c'est ainsi que l'on apprend et que l'on évolue !","position":{"start":{"line":25,"column":1,"offset":1258},"end":{"line":25,"column":191,"offset":1448}}}],"position":{"start":{"line":25,"column":1,"offset":1258},"end":{"line":25,"column":191,"offset":1448}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":26,"column":1,"offset":1450}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\nimport { AnchorDiscriminatorCalculator } from \"../../../../components/AnchorDiscriminatorCalculator/AnchorDiscriminatorCalculator\";\r\n\r\n# Conclusion\r\n\r\nFélicitations ! Vous avez terminé le cours Introduction à Anchor. Vous avez maintenant une base solide dans la compréhension du fonctionnement d'Anchor, de ses concepts de base aux détails de sa mise en œuvre pratique.\r\n\r\n## Ce que vous avez appris\r\n\r\nTout au long de ce cours, vous avez acquis des connaissances essentielles dans les domaines suivants :\r\n- Les principes fondamentaux du framework Anchor\r\n- Comment structurer les programmes avec Anchor\r\n- Comprendre les discriminateurs des programmes\r\n- Les bonnes pratiques pour créer des programmes Solana sécurisés\r\n\r\n## Prochaines étapes\r\n\r\nVous êtes maintenant prêt à créer votre premier programme avec Anchor ! La meilleure façon de consolider vos connaissances est de les mettre en pratique. Nous vous encourageons à :\r\n\r\n1. Explorer la [section Challenges](/en/challenges)\r\n2. Commencer par les exercices adaptés aux débutants\r\n3. Créer et tester votre premier programme Anchor\r\n4. Rejoindre notre communauté pour partager vos progrès et obtenir de l'aide\r\n\r\nN'oubliez pas, tous les grands développeurs ont commencé par leur premier programme. N'ayez pas peur d'expérimenter et de faire des erreurs; c'est ainsi que l'on apprend et que l'on évolue !\r\n","highlightedCode":{}}