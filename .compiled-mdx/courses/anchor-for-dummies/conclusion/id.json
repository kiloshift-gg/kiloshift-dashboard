olumn":48,"offset":1016}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Bangun dan uji program Anchor pertama Anda","position":{"start":{"line":22,"column":4,"offset":1021},"end":{"line":22,"column":46,"offset":1063}}}],"position":{"start":{"line":22,"column":4,"offset":1021},"end":{"line":22,"column":46,"offset":1063}}}],"position":{"start":{"line":22,"column":1,"offset":1018},"end":{"line":22,"column":46,"offset":1063}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Bergabung dengan komunitas kami untuk berbagi kemajuan Anda dan mendapatkan bantuan","position":{"start":{"line":23,"column":4,"offset":1068},"end":{"line":23,"column":87,"offset":1151}}}],"position":{"start":{"line":23,"column":4,"offset":1068},"end":{"line":23,"column":87,"offset":1151}}}],"position":{"start":{"line":23,"column":1,"offset":1065},"end":{"line":23,"column":87,"offset":1151}}}],"position":{"start":{"line":20,"column":1,"offset":921},"end":{"line":23,"column":87,"offset":1151}}},{"type":"paragraph","children":[{"type":"text","value":"Ingat, setiap pengembang hebat memulai dengan program pertama mereka. Jangan takut untuk bereksperimen dan membuat kesalahan; begitulah cara kita belajar dan berkembang!","position":{"start":{"line":25,"column":1,"offset":1155},"end":{"line":25,"column":170,"offset":1324}}}],"position":{"start":{"line":25,"column":1,"offset":1155},"end":{"line":25,"column":170,"offset":1324}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":26,"column":1,"offset":1326}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\nimport { AnchorDiscriminatorCalculator } from \"../../../../components/AnchorDiscriminatorCalculator/AnchorDiscriminatorCalculator\";\r\n\r\n# Kesimpulan\r\n\r\nSelamat! Anda telah menyelesaikan kursus Pengantar Anchor. Sekarang Anda memiliki dasar yang kuat dalam memahami cara kerja Anchor, mulai dari konsep intinya hingga detail implementasi praktisnya.\r\n\r\n## Apa yang Telah Anda Pelajari\r\n\r\nSepanjang kursus ini, Anda telah memperoleh pengetahuan penting tentang:\r\n- Dasar-dasar framework Anchor\r\n- Cara menyusun program Anchor\r\n- Memahami diskriminator program\r\n- Praktik terbaik untuk membangun program Solana yang aman\r\n\r\n## Langkah Selanjutnya\r\n\r\nAnda sekarang siap untuk mulai membangun program pertama Anda dengan Anchor! Cara terbaik untuk memperkuat pengetahuan Anda adalah melalui praktik langsung. Kami mendorong Anda untuk:\r\n\r\n1. Pergi ke [bagian Tantangan](/id/challenges)\r\n2. Mulai dengan latihan yang ramah untuk pemula\r\n3. Bangun dan uji program Anchor pertama Anda\r\n4. Bergabung dengan komunitas kami untuk berbagi kemajuan Anda dan mendapatkan bantuan\r\n\r\nIngat, setiap pengembang hebat memulai dengan program pertama mereka. Jangan takut untuk bereksperimen dan membuat kesalahan; begitulah cara kita belajar dan berkembang!\r\n","highlightedCode":{}}