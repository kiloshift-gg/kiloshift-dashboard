згортання.","position":{"start":{"line":21,"column":10,"offset":981},"end":{"line":21,"column":53,"offset":1024}}}],"position":{"start":{"line":21,"column":3,"offset":974},"end":{"line":21,"column":53,"offset":1024}}}],"position":{"start":{"line":21,"column":1,"offset":972},"end":{"line":21,"column":53,"offset":1024}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"help","position":{"start":{"line":22,"column":3,"offset":1028},"end":{"line":22,"column":9,"offset":1034}}},{"type":"text","value":": Вивести це повідомлення або довідку для вказаних підкоманд.","position":{"start":{"line":22,"column":9,"offset":1034},"end":{"line":22,"column":70,"offset":1095}}}],"position":{"start":{"line":22,"column":3,"offset":1028},"end":{"line":22,"column":70,"offset":1095}}}],"position":{"start":{"line":22,"column":1,"offset":1026},"end":{"line":22,"column":70,"offset":1095}}}],"position":{"start":{"line":16,"column":1,"offset":722},"end":{"line":22,"column":70,"offset":1095}}},{"type":"code","lang":"text","meta":null,"value":"Usage: sbpf <COMMAND>\r\n\r\nCommands:\r\n  init    Create a new project scaffold\r\n  build   Compile into a Solana program executable\r\n  deploy  Build and deploy the program\r\n  test    Test deployed program\r\n  e2e     Build, deploy and test a program\r\n  clean   Clean up build and deploy artifacts\r\n  help    Print this message or the help of the given subcommand(s)\r\n\r\nOptions:\r\n  -h, --help     Print help\r\n  -V, --version  Print version","position":{"start":{"line":24,"column":1,"offset":1099},"end":{"line":39,"column":4,"offset":1546}},"data":{"highlightId":"code-1"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Initialize a new project","position":{"start":{"line":41,"column":17,"offset":1566},"end":{"line":41,"column":48,"offset":1597}}},{"type":"mdxJsxAttribute","name":"id","value":"initialize-a-new-project","position":{"start":{"line":41,"column":49,"offset":1598},"end":{"line":41,"column":78,"offset":1627}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":41,"column":79,"offset":1628},"end":{"line":41,"column":89,"offset":1638}}}],"children":[],"position":{"start":{"line":41,"column":1,"offset":1550},"end":{"line":41,"column":92,"offset":1641}}},{"type":"paragraph","children":[{"type":"text","value":"Щоб створити новий проєкт, використовуйте команду ","position":{"start":{"line":43,"column":1,"offset":1645},"end":{"line":43,"column":51,"offset":1695}}},{"type":"inlineCode","value":"sbpf init","position":{"start":{"line":43,"column":51,"offset":1695},"end":{"line":43,"column":62,"offset":1706}}},{"type":"text","value":". За замовчуванням вона ініціалізує проєкт з тестами на Rust, використовуючи Mollusk. Ви також можете ініціалізувати проєкт з тестами на TypeScript, використовуючи опцію ","position":{"start":{"line":43,"column":62,"offset":1706},"end":{"line":43,"column":232,"offset":1876}}},{"type":"inlineCode","value":"--ts-tests","position":{"start":{"line":43,"column":232,"offset":1876},"end":{"line":43,"column":244,"offset":1888}}},{"type":"text","value":".","position":{"start":{"line":43,"column":244,"offset":1888},"end":{"line":43,"column":245,"offset":1889}}}],"position":{"start":{"line":43,"column":1,"offset":1645},"end":{"line":43,"column":245,"offset":1889}}},{"type":"code","lang":"text","meta":null,"value":"sbpf init --help\r\nCreate a new project scaffold\r\n\r\nUsage: sbpf init [OPTIONS] [NAME]\r\n\r\nArguments:\r\n  [NAME]  The name of the project to create\r\n\r\nOptions:\r\n  -t, --ts-tests  Initialize with TypeScript tests instead of Mollusk Rust tests\r\n  -h, --help      Print help information\r\n  -V, --version   Print version information","position":{"start":{"line":45,"column":1,"offset":1893},"end":{"line":58,"column":4,"offset":2231}},"data":{"highlightId":"code-2"}},{"type":"paragraph","children":[{"type":"text","value":"Після ініціалізації проєкту ви можете перейти до директорії проєкту та використовувати інші команди для збірки, розгортання та тестування вашої програми.","position":{"start":{"line":60,"column":1,"offset":2235},"end":{"line":60,"column":154,"offset":2388}}}],"position":{"start":{"line":60,"column":1,"offset":2235},"end":{"line":60,"column":154,"offset":2388}}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Building Programs","position":{"start":{"line":62,"column":17,"offset":2408},"end":{"line":62,"column":41,"offset":2432}}},{"type":"mdxJsxAttribute","name":"id","value":"building-programs","position":{"start":{"line":62,"column":42,"offset":2433},"end":{"line":62,"column":64,"offset":2455}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":62,"column":65,"offset":2456},"end":{"line":62,"column":75,"offset":2466}}}],"children":[],"position":{"start":{"line":62,"column":1,"offset":2392},"end":{"line":62,"column":78,"offset":2469}}},{"type":"paragraph","children":[{"type":"text","value":"sBPF надає два варіанти збірки залежно від вашого налаштування та потреб:","position":{"start":{"line":64,"column":1,"offset":2473},"end":{"line":64,"column":74,"offset":2546}}}],"position":{"start":{"line":64,"column":1,"offset":2473},"end":{"line":64,"column":74,"offset":2546}}},{"type":"heading","depth":3,"children":[{"type":"text","value":"Збірка sBPF","position":{"start":{"line":66,"column":5,"offset":2554},"end":{"line":66,"column":16,"offset":2565}}}],"position":{"start":{"line":66,"column":1,"offset":2550},"end":{"line":66,"column":16,"offset":2565}}},{"type":"paragraph","children":[{"type":"text","value":"Команда збірки використовує автономний асемблер, який не потребує додаткових залежностей. Це ідеальний варіант для навчання та експериментів, оскільки він \"просто працює\" на будь-якій платформі.","position":{"start":{"line":68,"column":1,"offset":2569},"end":{"line":68,"column":195,"offset":2763}}}],"position":{"start":{"line":68,"column":1,"offset":2569},"end":{"line":68,"column":195,"offset":2763}}},{"type":"code","lang":null,"meta":null,"value":"sbpf build","position":{"start":{"line":70,"column":1,"offset":2767},"end":{"line":72,"column":4,"offset":2787}},"data":{"highlightId":"code-3"}},{"type":"mdxFlowExpression","value":"/*\r\n\r\nTODO: Update sbpf to enable llvm build as an optional configuration then reenable this\r\n\r\n### Повна збірка\r\n\r\nСтандартна команда збірки забезпечує інтеграцію з повним набором інструментів Solana та функціями управління проєктом.\r\n\r\n> Для цього потрібно встановити [Інструменти командного рядка Solana](https://docs.anza.xyz/cli/install/).\r\n\r\n```\r\nsbpf build\r\n```\r\n\r\n*/","position":{"start":{"line":74,"column":1,"offset":2791},"end":{"line":88,"column":5,"offset":3168}},"data":{"estree":{"type":"Program","start":2792,"end":3167,"body":[],"sourceType":"module","comments":[{"type":"Block","value":"\r\n\r\nTODO: Update sbpf to enable llvm build as an optional configuration then reenable this\r\n\r\n### Повна збірка\r\n\r\nСтандартна команда збірки забезпечує інтеграцію з повним набором інструментів Solana та функціями управління проєктом.\r\n\r\n> Для цього потрібно встановити [Інструменти командного рядка Solana](https://docs.anza.xyz/cli/install/).\r\n\r\n```\r\nsbpf build\r\n```\r\n\r\n","start":2792,"end":3167,"loc":{"start":{"line":74,"column":1,"offset":2792},"end":{"line":88,"column":3,"offset":3167}},"range":[2792,3167]}],"loc":{"start":{"line":74,"column":1,"offset":2792},"end":{"line":88,"column":3,"offset":3167}},"range":[2792,3167]}}},{"type":"heading","depth":3,"children":[{"type":"text","value":"Розширене використання","position":{"start":{"line":90,"column":5,"offset":3176},"end":{"line":90,"column":27,"offset":3198}}}],"position":{"start":{"line":90,"column":1,"offset":3172},"end":{"line":90,"column":27,"offset":3198}}},{"type":"paragraph","children":[{"type":"text","value":"Ви можете замінити компонувальник за замовчуванням власним файлом компонувальника, включивши його в каталог src з тим самим ім'ям, що й ваша програма. Наприклад:","position":{"start":{"line":92,"column":1,"offset":3202},"end":{"line":92,"column":162,"offset":3363}}}],"position":{"start":{"line":92,"column":1,"offset":3202},"end":{"line":92,"column":162,"offset":3363}}},{"type":"code","lang":"text","meta":null,"value":"src/example/example.s\r\nsrc/example/example.ld","position":{"start":{"line":94,"column":1,"offset":3367},"end":{"line":97,"column":4,"offset":3426}},"data":{"highlightId":"code-4"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Середовище розробки","position":{"start":{"line":99,"column":17,"offset":3446},"end":{"line":99,"column":43,"offset":3472}}},{"type":"mdxJsxAttribute","name":"id","value":"development-environment","position":{"start":{"line":99,"column":44,"offset":3473},"end":{"line":99,"column":72,"offset":3501}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":99,"column":73,"offset":3502},"end":{"line":99,"column":83,"offset":3512}}}],"children":[],"position":{"start":{"line":99,"column":1,"offset":3430},"end":{"line":99,"column":86,"offset":3515}}},{"type":"paragraph","children":[{"type":"text","value":"Для найкращого досвіду розробки рекомендуємо встановити ","position":{"start":{"line":101,"column":1,"offset":3519},"end":{"line":101,"column":57,"offset":3575}}},{"type":"link","title":null,"url":"https://github.com/deanmlittle/vscode-sbpf-asm","children":[{"type":"text","value":"розширення VS Code для sBPF Assembly","position":{"start":{"line":101,"column":58,"offset":3576},"end":{"line":101,"column":94,"offset":3612}}}],"position":{"start":{"line":101,"column":57,"offset":3575},"end":{"line":101,"column":143,"offset":3661}}},{"type":"text","value":", яке забезпечує:","position":{"start":{"line":101,"column":143,"offset":3661},"end":{"line":101,"column":160,"offset":3678}}}],"position":{"start":{"line":101,"column":1,"offset":3519},"end":{"line":101,"column":160,"offset":3678}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Підсвічування синтаксису для sBPF асемблера","position":{"start":{"line":102,"column":3,"offset":3682},"end":{"line":102,"column":46,"offset":3725}}}],"position":{"start":{"line":102,"column":3,"offset":3682},"end":{"line":102,"column":46,"offset":3725}}}],"position":{"start":{"line":102,"column":1,"offset":3680},"end":{"line":102,"column":46,"offset":3725}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Автодоповнення коду для інструкцій та регістрів","position":{"start":{"line":103,"column":3,"offset":3729},"end":{"line":103,"column":50,"offset":3776}}}],"position":{"start":{"line":103,"column":3,"offset":3729},"end":{"line":103,"column":50,"offset":3776}}}],"position":{"start":{"line":103,"column":1,"offset":3727},"end":{"line":103,"column":50,"offset":3776}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Виявлення помилок та попередження","position":{"start":{"line":104,"column":3,"offset":3780},"end":{"line":104,"column":36,"offset":3813}}}],"position":{"start":{"line":104,"column":3,"offset":3780},"end":{"line":104,"column":36,"offset":3813}}}],"position":{"start":{"line":104,"column":1,"offset":3778},"end":{"line":104,"column":36,"offset":3813}}}],"position":{"start":{"line":102,"column":1,"offset":3680},"end":{"line":104,"column":36,"offset":3813}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":105,"column":1,"offset":3815}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Інструменти\r\n\r\nНаписання та збірка програм на sBPF Assembly традиційно вимагали повного набору інструментів Solana, який може бути складним для налаштування та залежним від платформи. Саме з цієї причини [Dean](https://x.com/deanmlittle), за участі [Claire](https://x.com/clairefxyz), створив sBPF: повний набір інструментів для створення та збірки програм на sBPF Assembly.\r\n\r\n<ArticleSection name=\"Installation\" id=\"installation\" level=\"h2\" />\r\n\r\nМи починаємо з встановлення пакета, виконавши:\r\n\r\n```\r\ncargo install --git https://github.com/Kiloshift-gg/sbpf.git\r\n```\r\n\r\nПісля цього ми зможемо виконувати всі наступні команди:\r\n- `init`: Створити каркас нового проєкту.\r\n- `build`: Скомпілювати у виконуваний файл програми Solana.\r\n- `deploy`: Зібрати та розгорнути програму.\r\n- `test`: Протестувати розгорнуту програму.\r\n- `e2e`: Зібрати, розгорнути та протестувати програму.\r\n- `clean`: Очистити артефакти збірки та розгортання.\r\n- `help`: Вивести це повідомлення або довідку для вказаних підкоманд.\r\n\r\n```text\r\nUsage: sbpf <COMMAND>\r\n\r\nCommands:\r\n  init    Create a new project scaffold\r\n  build   Compile into a Solana program executable\r\n  deploy  Build and deploy the program\r\n  test    Test deployed program\r\n  e2e     Build, deploy and test a program\r\n  clean   Clean up build and deploy artifacts\r\n  help    Print this message or the help of the given subcommand(s)\r\n\r\nOptions:\r\n  -h, --help     Print help\r\n  -V, --version  Print version\r\n```\r\n\r\n<ArticleSection name=\"Initialize a new project\" id=\"initialize-a-new-project\" level=\"h2\" />\r\n\r\nЩоб створити новий проєкт, використовуйте команду `sbpf init`. За замовчуванням вона ініціалізує проєкт з тестами на Rust, використовуючи Mollusk. Ви також можете ініціалізувати проєкт з тестами на TypeScript, використовуючи опцію `--ts-tests`.\r\n\r\n```text\r\nsbpf init --help\r\nCreate a new project scaffold\r\n\r\nUsage: sbpf init [OPTIONS] [NAME]\r\n\r\nArguments:\r\n  [NAME]  The name of the project to create\r\n\r\nOptions:\r\n  -t, --ts-tests  Initialize with TypeScript tests instead of Mollusk Rust tests\r\n  -h, --help      Print help information\r\n  -V, --version   Print version information\r\n```\r\n\r\nПісля ініціалізації проєкту ви можете перейти до директорії проєкту та використовувати інші команди для збірки, розгортання та тестування вашої програми.\r\n\r\n<ArticleSection name=\"Building Programs\" id=\"building-programs\" level=\"h2\" />\r\n\r\nsBPF надає два варіанти збірки залежно від вашого налаштування та потреб:\r\n\r\n### Збірка sBPF\r\n\r\nКоманда збірки використовує автономний асемблер, який не потребує додаткових залежностей. Це ідеальний варіант для навчання та експериментів, оскільки він \"просто працює\" на будь-якій платформі.\r\n\r\n```\r\nsbpf build\r\n```\r\n\r\n{/*\r\n\r\nTODO: Update sbpf to enable llvm build as an optional configuration then reenable this\r\n\r\n### Повна збірка\r\n\r\nСтандартна команда збірки забезпечує інтеграцію з повним набором інструментів Solana та функціями управління проєктом.\r\n\r\n> Для цього потрібно встановити [Інструменти командного рядка Solana](https://docs.anza.xyz/cli/install/).\r\n\r\n```\r\nsbpf build\r\n```\r\n\r\n */}\r\n\r\n### Розширене використання\r\n\r\nВи можете замінити компонувальник за замовчуванням власним файлом компонувальника, включивши його в каталог src з тим самим ім'ям, що й ваша програма. Наприклад:\r\n\r\n```text\r\nsrc/example/example.s\r\nsrc/example/example.ld\r\n```\r\n\r\n<ArticleSection name=\"Середовище розробки\" id=\"development-environment\" level=\"h2\" />\r\n\r\nДля найкращого досвіду розробки рекомендуємо встановити [розширення VS Code для sBPF Assembly](https://github.com/deanmlittle/vscode-sbpf-asm), яке забезпечує:\r\n- Підсвічування синтаксису для sBPF асемблера\r\n- Автодоповнення коду для інструкцій та регістрів\r\n- Виявлення помилок та попередження\r\n","highlightedCode":{"code-0":{"lang":"text","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{},"children":[{"type":"text","value":"cargo install --git https://github.com/Kiloshift-gg/sbpf.git"}]}]}]}]}]}},"code-1":{"lang":"text","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{},"children":[{"type":"text","value":"Usage: sbpf <COMMAND>"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{},"children":[{"type":"text","value":""}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{},"children":[{"type":"text","value":"Commands:"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{},"children":[{"type":"text","value":"  init    Create a new project scaffold"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{},"children":[{"type":"text","value":"  build   Compile into a Solana program executable"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{},"ch