et":113},"end":{"line":5,"column":83,"offset":195}}},{"type":"paragraph","children":[{"type":"text","value":"要了解 sBPF Assembly 及其在 Solana 程式中的角色，我們首先需要了解組合語言，以及它如何將高階程式碼與機器執行連接起來。","position":{"start":{"line":7,"column":1,"offset":199},"end":{"line":7,"column":71,"offset":269}}}],"position":{"start":{"line":7,"column":1,"offset":199},"end":{"line":7,"column":71,"offset":269}}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"The Assembly Language","position":{"start":{"line":9,"column":17,"offset":289},"end":{"line":9,"column":45,"offset":317}}},{"type":"mdxJsxAttribute","name":"id","value":"the-assembly-language","position":{"start":{"line":9,"column":46,"offset":318},"end":{"line":9,"column":72,"offset":344}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":9,"column":73,"offset":345},"end":{"line":9,"column":83,"offset":355}}}],"children":[],"position":{"start":{"line":9,"column":1,"offset":273},"end":{"line":9,"column":86,"offset":358}}},{"type":"paragraph","children":[{"type":"text","value":"組合語言是機器碼的人類可讀形式：即處理器執行的實際指令。它作為高階程式語言與電腦理解的二進制碼之間的橋樑。","position":{"start":{"line":11,"column":1,"offset":362},"end":{"line":11,"column":54,"offset":415}}}],"position":{"start":{"line":11,"column":1,"offset":362},"end":{"line":11,"column":54,"offset":415}}},{"type":"paragraph","children":[{"type":"text","value":"當你編寫像這樣的 Rust 程式碼時：","position":{"start":{"line":13,"column":1,"offset":419},"end":{"line":13,"column":20,"offset":438}}}],"position":{"start":{"line":13,"column":1,"offset":419},"end":{"line":13,"column":20,"offset":438}}},{"type":"code","lang":"rust","meta":null,"value":"let result = a + b;","position":{"start":{"line":15,"column":1,"offset":442},"end":{"line":17,"column":4,"offset":475}},"data":{"highlightId":"code-0"}},{"type":"paragraph","children":[{"type":"text","value":"編譯器會通過幾個階段進行翻譯：","position":{"start":{"line":19,"column":1,"offset":479},"end":{"line":19,"column":16,"offset":494}}}],"position":{"start":{"line":19,"column":1,"offset":479},"end":{"line":19,"column":16,"offset":494}}},{"type":"list","ordered":true,"start":1,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Rust 原始碼 → 解析和分析","position":{"start":{"line":20,"column":4,"offset":499},"end":{"line":20,"column":20,"offset":515}}}],"position":{"start":{"line":20,"column":4,"offset":499},"end":{"line":20,"column":20,"offset":515}}}],"position":{"start":{"line":20,"column":1,"offset":496},"end":{"line":20,"column":20,"offset":515}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"中間表示 → 優化","position":{"start":{"line":21,"column":4,"offset":520},"end":{"line":21,"column":13,"offset":529}}}],"position":{"start":{"line":21,"column":4,"offset":520},"end":{"line":21,"column":13,"offset":529}}}],"position":{"start":{"line":21,"column":1,"offset":517},"end":{"line":21,"column":13,"offset":529}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"組合語言 → 人類可讀的指令","position":{"start":{"line":22,"column":4,"offset":534},"end":{"line":22,"column":18,"offset":548}}}],"position":{"start":{"line":22,"column":4,"offset":534},"end":{"line":22,"column":18,"offset":548}}}],"position":{"start":{"line":22,"column":1,"offset":531},"end":{"line":22,"column":18,"offset":548}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"機器碼 → 處理器執行的二進制碼","position":{"start":{"line":23,"column":4,"offset":553},"end":{"line":23,"column":20,"offset":569}}}],"position":{"start":{"line":23,"column":4,"offset":553},"end":{"line":23,"column":20,"offset":569}}}],"position":{"start":{"line":23,"column":1,"offset":550},"end":{"line":23,"column":20,"offset":569}}}],"position":{"start":{"line":20,"column":1,"offset":496},"end":{"line":23,"column":20,"offset":569}}},{"type":"paragraph","children":[{"type":"text","value":"組合語言處於第 3 階段：轉換為二進制之前的最終人類可讀形式。每條組合指令對應於一個處理器操作：例如加法、載入記憶體或跳轉到不同的程式碼段。","position":{"start":{"line":25,"column":1,"offset":573},"end":{"line":25,"column":71,"offset":643}}}],"position":{"start":{"line":25,"column":1,"offset":573},"end":{"line":25,"column":71,"offset":643}}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"The sBPF Virtual Machine","position":{"start":{"line":27,"column":17,"offset":663},"end":{"line":27,"column":48,"offset":694}}},{"type":"mdxJsxAttribute","name":"id","value":"the-sbpf-virtual-machine","position":{"start":{"line":27,"column":49,"offset":695},"end":{"line":27,"column":78,"offset":724}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":27,"column":79,"offset":725},"end":{"line":27,"column":89,"offset":735}}}],"children":[],"position":{"start":{"line":27,"column":1,"offset":647},"end":{"line":27,"column":92,"offset":738}}},{"type":"paragraph","children":[{"type":"text","value":"Solana sBPF 是 Solana 的自定義版本，基於擴展的 Berkeley Packet Filter (eBPF) 指令集和虛擬機器，執行每個鏈上程式。它創建了一個專門的執行環境：一個 64 位元的暫存器機器，位於你的程式和驗證者的原生 CPU 之間。","position":{"start":{"line":29,"column":1,"offset":742},"end":{"line":29,"column":133,"offset":874}}}],"position":{"start":{"line":29,"column":1,"offset":742},"end":{"line":29,"column":133,"offset":874}}},{"type":"paragraph","children":[{"type":"text","value":"可以將 sBPF 想像成一台專為區塊鏈執行設計的電腦：既能快速處理高吞吐量交易，又能在數千個驗證者之間保證安全性和確定性。","position":{"start":{"line":31,"column":1,"offset":878},"end":{"line":31,"column":62,"offset":939}}}],"position":{"start":{"line":31,"column":1,"offset":878},"end":{"line":31,"column":62,"offset":939}}},{"type":"paragraph","children":[{"type":"text","value":"與直接在 CPU 上運行的原生組合語言不同，sBPF 程式碼在受控的虛擬機器環境中執行。這個虛擬機器通過在執行前驗證每條指令來保證安全性，防止崩潰、無限迴圈和未授權的記憶體訪問。","position":{"start":{"line":33,"column":1,"offset":943},"end":{"line":33,"column":90,"offset":1032}}}],"position":{"start":{"line":33,"column":1,"offset":943},"end":{"line":33,"column":90,"offset":1032}}},{"type":"paragraph","children":[{"type":"text","value":"儘管有這些安全限制，sBPF 仍然通過","position":{"start":{"line":35,"column":1,"offset":1036},"end":{"line":35,"column":20,"offset":1055}}},{"type":"inlineCode","value":"just-in-time","position":{"start":{"line":35,"column":20,"offset":1055},"end":{"line":35,"column":34,"offset":1069}}},{"type":"text","value":"編譯保持高效能，實現接近原生執行速度。","position":{"start":{"line":35,"column":34,"offset":1069},"end":{"line":35,"column":53,"offset":1088}}}],"position":{"start":{"line":35,"column":1,"offset":1036},"end":{"line":35,"column":53,"offset":1088}}},{"type":"paragraph","children":[{"type":"text","value":"虛擬機還確保了執行的確定性：相同的程式和相同的輸入在全球所有驗證者中都會產生相同的結果。這種一致性對區塊鏈共識至關重要。","position":{"start":{"line":37,"column":1,"offset":1092},"end":{"line":37,"column":61,"offset":1152}}}],"position":{"start":{"line":37,"column":1,"offset":1092},"end":{"line":37,"column":61,"offset":1152}}},{"type":"paragraph","children":[{"type":"text","value":"此外，sBPF 包括用於帳戶訪問、跨程式調用和運行時互動的系統調用（syscalls）。","position":{"start":{"line":39,"column":1,"offset":1156},"end":{"line":39,"column":45,"offset":1200}}}],"position":{"start":{"line":39,"column":1,"offset":1156},"end":{"line":39,"column":45,"offset":1200}}},{"type":"heading","depth":3,"children":[{"type":"text","value":"為什麼理解 sBPF 彙編很重要","position":{"start":{"line":41,"column":5,"offset":1208},"end":{"line":41,"column":21,"offset":1224}}}],"position":{"start":{"line":41,"column":1,"offset":1204},"end":{"line":41,"column":21,"offset":1224}}},{"type":"paragraph","children":[{"type":"text","value":"雖然 Rust 編譯器能高效地將高階代碼轉換為 sBPF 指令，但理解彙編語言有以下幾個優勢：","position":{"start":{"line":43,"column":1,"offset":1228},"end":{"line":43,"column":48,"offset":1275}}}],"position":{"start":{"line":43,"column":1,"offset":1228},"end":{"line":43,"column":48,"offset":1275}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"理解計算成本","position":{"start":{"line":44,"column":5,"offset":1281},"end":{"line":44,"column":11,"offset":1287}}}],"position":{"start":{"line":44,"column":3,"offset":1279},"end":{"line":44,"column":13,"offset":1289}}},{"type":"text","value":"：每條 sBPF 指令都會消耗計算單元（CUs）。一行 Rust 代碼可能會編譯成數百條指令——彙編語言可以揭示為什麼某些操作成本高昂。","position":{"start":{"line":44,"column":13,"offset":1289},"end":{"line":44,"column":81,"offset":1357}}}],"position":{"start":{"line":44,"column":3,"offset":1279},"end":{"line":44,"column":81,"offset":1357}}}],"position":{"start":{"line":44,"column":1,"offset":1277},"end":{"line":44,"column":81,"offset":1357}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"更小的程式大小","position":{"start":{"line":45,"column":5,"offset":1363},"end":{"line":45,"column":12,"offset":1370}}}],"position":{"start":{"line":45,"column":3,"offset":1361},"end":{"line":45,"column":14,"offset":1372}}},{"type":"text","value":"：直接用 sBPF 彙編語言編寫的程式比編譯的 Rust 等效程式小得多，從而降低部署成本並改善加載時間。","position":{"start":{"line":45,"column":14,"offset":1372},"end":{"line":45,"column":67,"offset":1425}}}],"position":{"start":{"line":45,"column":3,"offset":1361},"end":{"line":45,"column":67,"offset":1425}}}],"position":{"start":{"line":45,"column":1,"offset":1359},"end":{"line":45,"column":67,"offset":1425}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"優化機會","position":{"start":{"line":46,"column":5,"offset":1431},"end":{"line":46,"column":9,"offset":1435}}}],"position":{"start":{"line":46,"column":3,"offset":1429},"end":{"line":46,"column":11,"offset":1437}}},{"type":"text","value":"：Rust 編譯器生成安全且正確的代碼，但並不總是最有效率的。彙編語言可以揭示冗餘的安全檢查和次優的指令序列。","position":{"start":{"line":46,"column":11,"offset":1437},"end":{"line":46,"column":66,"offset":1492}}}],"position":{"start":{"line":46,"column":3,"offset":1429},"end":{"line":46,"column":66,"offset":1492}}}],"position":{"start":{"line":46,"column":1,"offset":1427},"end":{"line":46,"column":66,"offset":1492}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"調試和分析","position":{"start":{"line":47,"column":5,"offset":1498},"end":{"line":47,"column":10,"offset":1503}}}],"position":{"start":{"line":47,"column":3,"offset":1496},"end":{"line":47,"column":12,"offset":1505}}},{"type":"text","value":"：當程式行為異常時，彙編語言提供了最基礎的真相。您可以精確追踪執行了哪些指令並識別故障點。","position":{"start":{"line":47,"column":12,"offset":1505},"end":{"line":47,"column":57,"offset":1550}}}],"position":{"start":{"line":47,"column":3,"offset":1496},"end":{"line":47,"column":57,"offset":1550}}}],"position":{"start":{"line":47,"column":1,"offset":1494},"end":{"line":47,"column":57,"offset":1550}}}],"position":{"start":{"line":44,"column":1,"offset":1277},"end":{"line":47,"column":57,"offset":1550}}},{"type":"heading","depth":3,"children":[{"type":"text","value":"架構","position":{"start":{"line":49,"column":5,"offset":1558},"end":{"line":49,"column":7,"offset":1560}}}],"position":{"start":{"line":49,"column":1,"offset":1554},"end":{"line":49,"column":7,"offset":1560}}},{"type":"paragraph","children":[{"type":"text","value":"sBPF 採用一種載入-存儲架構，具有 10 個通用寄存器、一個只讀的堆疊指針，並且沒有複雜的尋址模式。","position":{"start":{"line":51,"column":1,"offset":1564},"end":{"line":51,"column":53,"offset":1616}}}],"position":{"start":{"line":51,"column":1,"offset":1564},"end":{"line":51,"column":53,"offset":1616}}},{"type":"paragraph","children":[{"type":"text","value":"這種簡單性是有意為之：更少的指令變體能夠加快驗證速度、加快 JIT 編譯速度並提供更可預測的效能。","position":{"start":{"line":53,"column":1,"offset":1620},"end":{"line":53,"column":50,"offset":1669}}}],"position":{"start":{"line":53,"column":1,"offset":1620},"end":{"line":53,"column":50,"offset":1669}}},{"type":"paragraph","children":[{"type":"text","value":"每次將 eBPF 程式載入內核時，其位元組碼會由 JIT 編譯器轉換為特定於主機 CPU 架構的原生機器指令，然後由虛擬機執行。","position":{"start":{"line":55,"column":1,"offset":1673},"end":{"line":55,"column":65,"offset":1737}}}],"position":{"start":{"line":55,"column":1,"offset":1673},"end":{"line":55,"column":65,"offset":1737}}},{"type":"heading","depth":3,"children":[{"type":"text","value":"執行","position":{"start":{"line":57,"column":5,"offset":1745},"end":{"line":57,"column":7,"offset":1747}}}],"position":{"start":{"line":57,"column":1,"offset":1741},"end":{"line":57,"column":7,"offset":1747}}},{"type":"paragraph","children":[{"type":"text","value":"sBPF 程式通過一個簡單的過程執行。程式計數器（","position":{"start":{"line":59,"column":1,"offset":1751},"end":{"line":59,"column":26,"offset":1776}}},{"type":"inlineCode","value":"PC","position":{"start":{"line":59,"column":26,"offset":1776},"end":{"line":59,"column":30,"offset":1780}}},{"type":"text","value":"）跟踪下一步要執行的指令，就像指令列表中的書籤一樣。","position":{"start":{"line":59,"column":30,"offset":1780},"end":{"line":59,"column":56,"offset":1806}}}],"position":{"start":{"line":59,"column":1,"offset":1751},"end":{"line":59,"column":56,"offset":1806}}},{"type":"paragraph","children":[{"type":"text","value":"執行週期遵循以下步驟：","position":{"start":{"line":61,"column":1,"offset":1810},"end":{"line":61,"column":12,"offset":1821}}}],"position":{"start":{"line":61,"column":1,"offset":1810},"end":{"line":61,"column":12,"offset":1821}}},{"type":"list","ordered":true,"start":1,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"提取","position":{"start":{"line":62,"column":6,"offset":1828},"end":{"line":62,"column":8,"offset":1830}}}],"position":{"start":{"line":62,"column":4,"offset":1826},"end":{"line":62,"column":10,"offset":1832}}},{"type":"text","value":"：讀取程式計數器上的指令","position":{"start":{"line":6