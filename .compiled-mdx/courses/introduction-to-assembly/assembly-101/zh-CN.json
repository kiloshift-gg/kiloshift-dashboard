17}}}],"position":{"start":{"line":46,"column":3,"offset":1354},"end":{"line":46,"column":66,"offset":1417}}}],"position":{"start":{"line":46,"column":1,"offset":1352},"end":{"line":46,"column":66,"offset":1417}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"调试和分析","position":{"start":{"line":47,"column":5,"offset":1423},"end":{"line":47,"column":10,"offset":1428}}}],"position":{"start":{"line":47,"column":3,"offset":1421},"end":{"line":47,"column":12,"offset":1430}}},{"type":"text","value":"：当程序行为异常时，汇编提供了最底层的真实信息。你可以精确追踪执行了哪些指令并找到故障点。","position":{"start":{"line":47,"column":12,"offset":1430},"end":{"line":47,"column":57,"offset":1475}}}],"position":{"start":{"line":47,"column":3,"offset":1421},"end":{"line":47,"column":57,"offset":1475}}}],"position":{"start":{"line":47,"column":1,"offset":1419},"end":{"line":47,"column":57,"offset":1475}}}],"position":{"start":{"line":44,"column":1,"offset":1205},"end":{"line":47,"column":57,"offset":1475}}},{"type":"heading","depth":3,"children":[{"type":"text","value":"架构","position":{"start":{"line":49,"column":5,"offset":1483},"end":{"line":49,"column":7,"offset":1485}}}],"position":{"start":{"line":49,"column":1,"offset":1479},"end":{"line":49,"column":7,"offset":1485}}},{"type":"paragraph","children":[{"type":"text","value":"sBPF 使用一种加载-存储架构，具有 10 个通用寄存器、一个只读堆栈指针，并且没有复杂的寻址模式。","position":{"start":{"line":51,"column":1,"offset":1489},"end":{"line":51,"column":52,"offset":1540}}}],"position":{"start":{"line":51,"column":1,"offset":1489},"end":{"line":51,"column":52,"offset":1540}}},{"type":"paragraph","children":[{"type":"text","value":"这种简化是有意为之：更少的指令变体可以实现更快的验证、更快的 JIT 编译以及更可预测的性能。","position":{"start":{"line":53,"column":1,"offset":1544},"end":{"line":53,"column":48,"offset":1591}}}],"position":{"start":{"line":53,"column":1,"offset":1544},"end":{"line":53,"column":48,"offset":1591}}},{"type":"paragraph","children":[{"type