6}}},{"type":"list","ordered":true,"start":1,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Kunjungi ","position":{"start":{"line":20,"column":4,"offset":863},"end":{"line":20,"column":13,"offset":872}}},{"type":"link","title":null,"url":"/id/challenges","children":[{"type":"text","value":"bagian Tantangan","position":{"start":{"line":20,"column":14,"offset":873},"end":{"line":20,"column":30,"offset":889}}}],"position":{"start":{"line":20,"column":13,"offset":872},"end":{"line":20,"column":47,"offset":906}}}],"position":{"start":{"line":20,"column":4,"offset":863},"end":{"line":20,"column":47,"offset":906}}}],"position":{"start":{"line":20,"column":1,"offset":860},"end":{"line":20,"column":47,"offset":906}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Mulai dengan latihan yang ramah untuk pemula","position":{"start":{"line":21,"column":4,"offset":911},"end":{"line":21,"column":48,"offset":955}}}],"position":{"start":{"line":21,"column":4,"offset":911},"end":{"line":21,"column":48,"offset":955}}}],"position":{"start":{"line":21,"column":1,"offset":908},"end":{"line":21,"column":48,"offset":955}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Bangun dan uji program Assembly pertama Anda","position":{"start":{"line":22,"column":4,"offset":960},"end":{"line":22,"column":48,"offset":1004}}}],"position":{"start":{"line":22,"column":4,"offset":960},"end":{"line":22,"column":48,"offset":1004}}}],"position":{"start":{"line":22,"column":1,"offset":957},"end":{"line":22,"column":48,"offset":1004}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Bergabunglah dengan komunitas kami untuk berbagi kemajuan Anda dan mendapatkan bantuan","position":{"start":{"line":23,"column":4,"offset":1009},"end":{"line":23,"column":90,"offset":1095}}}],"position":{"start":{"line":23,"column":4,"offset":1009},"end":{"line":23,"column":90,"offset":1095}}}],"position":{"start":{"line":23,"column":1,"offset":1006},"end":{"line":23,"column":90,"offset":1095}}}],"position":{"start":{"line":20,"column":1,"offset":860},"end":{"line":23,"column":90,"offset":1095}}},{"type":"paragraph","children":[{"type":"text","value":"Ingat, meskipun bahasa tingkat tinggi seperti Rust lebih disukai untuk sebagian besar pengembangan, memahami assembly memberi Anda kekuatan untuk mengoptimalkan jalur kritis dan men-debug masalah kompleks. Teruslah bereksperimen dan mendorong batas-batas kemungkinan dengan sBPF!","position":{"start":{"line":25,"column":1,"offset":1099},"end":{"line":25,"column":280,"offset":1378}}}],"position":{"start":{"line":25,"column":1,"offset":1099},"end":{"line":25,"column":280,"offset":1378}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":26,"column":1,"offset":1380}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Kesimpulan\r\n\r\nSelamat! Anda telah menyelesaikan kursus Pengantar Assembly. Sekarang Anda memiliki dasar yang kuat dalam memahami cara kerja BPF Solana (Solana Berkeley Packet Filter), mulai dari konsep intinya hingga detail implementasi praktisnya.\r\n\r\n## Apa yang Telah Anda Pelajari\r\n\r\nSepanjang kursus ini, Anda telah memperoleh pengetahuan penting tentang:\r\n- Arsitektur mesin virtual sBPF dan perannya dalam Solana\r\n- Memahami 11 register tujuan umum dan peran spesifiknya\r\n- Peta memori virtual tetap dan pola akses memori\r\n- Penggunaan stack dan konvensi masuk/keluar program\r\n- Perbedaan antara sBPF dan eBPF\r\n\r\n## Langkah Selanjutnya\r\n\r\nAnda sekarang siap untuk mulai menulis dan mengoptimalkan program sBPF Anda sendiri! Untuk melanjutkan perjalanan Anda:\r\n\r\n1. Kunjungi [bagian Tantangan](/id/challenges)\r\n2. Mulai dengan latihan yang ramah untuk pemula\r\n3. Bangun dan uji program Assembly pertama Anda\r\n4. Bergabunglah dengan komunitas kami untuk berbagi kemajuan Anda dan mendapatkan bantuan\r\n\r\nIngat, meskipun bahasa tingkat tinggi seperti Rust lebih disukai untuk sebagian besar pengembangan, memahami assembly memberi Anda kekuatan untuk mengoptimalkan jalur kritis dan men-debug masalah kompleks. Teruslah bereksperimen dan mendorong batas-batas kemungkinan dengan sBPF!\r\n","highlightedCode":{}}