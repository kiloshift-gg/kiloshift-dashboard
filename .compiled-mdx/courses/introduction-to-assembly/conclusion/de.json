ffset":802},"end":{"line":18,"column":112,"offset":913}}},{"type":"list","ordered":true,"start":1,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Gehe zum ","position":{"start":{"line":20,"column":4,"offset":920},"end":{"line":20,"column":13,"offset":929}}},{"type":"link","title":null,"url":"/de/challenges","children":[{"type":"text","value":"Bereich Challenges","position":{"start":{"line":20,"column":14,"offset":930},"end":{"line":20,"column":32,"offset":948}}}],"position":{"start":{"line":20,"column":13,"offset":929},"end":{"line":20,"column":49,"offset":965}}}],"position":{"start":{"line":20,"column":4,"offset":920},"end":{"line":20,"column":49,"offset":965}}}],"position":{"start":{"line":20,"column":1,"offset":917},"end":{"line":20,"column":49,"offset":965}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Beginne mit den anfängerfreundlichen Übungen","position":{"start":{"line":21,"column":4,"offset":970},"end":{"line":21,"column":48,"offset":1014}}}],"position":{"start":{"line":21,"column":4,"offset":970},"end":{"line":21,"column":48,"offset":1014}}}],"position":{"start":{"line":21,"column":1,"offset":967},"end":{"line":21,"column":48,"offset":1014}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Erstelle und teste dein erstes Assembly-Programm","position":{"start":{"line":22,"column":4,"offset":1019},"end":{"line":22,"column":52,"offset":1067}}}],"position":{"start":{"line":22,"column":4,"offset":1019},"end":{"line":22,"column":52,"offset":1067}}}],"position":{"start":{"line":22,"column":1,"offset":1016},"end":{"line":22,"column":52,"offset":1067}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Tritt unserer Community bei, um deinen Fortschritt zu teilen und Hilfe zu bekommen","position":{"start":{"line":23,"column":4,"offset":1072},"end":{"line":23,"column":86,"offset":1154}}}],"position":{"start":{"line":23,"column":4,"offset":1072},"end":{"line":23,"column":86,"offset":1154}}}],"position":{"start":{"line":23,"column":1,"offset":1069},"end":{"line":23,"column":86,"offset":1154}}}],"position":{"start":{"line":20,"column":1,"offset":917},"end":{"line":23,"column":86,"offset":1154}}},{"type":"paragraph","children":[{"type":"text","value":"Denk daran, obwohl höhere Programmiersprachen wie Rust für die meisten Entwicklungen bevorzugt werden, gibt dir das Verständnis von Assembly die Möglichkeit, kritische Pfade zu optimieren und komplexe Probleme zu debuggen. Experimentiere weiter und erweitere die Grenzen des mit sBPF Möglichen!","position":{"start":{"line":25,"column":1,"offset":1158},"end":{"line":25,"column":295,"offset":1452}}}],"position":{"start":{"line":25,"column":1,"offset":1158},"end":{"line":25,"column":295,"offset":1452}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":26,"column":1,"offset":1454}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Fazit\r\n\r\nHerzlichen Glückwunsch! Du hast den Einführungskurs zu Assembly abgeschlossen. Du verfügst jetzt über eine solide Grundlage im Verständnis der Funktionsweise von Solanas BPF (Solana Berkeley Packet Filter), von den Kernkonzepten bis hin zu praktischen Implementierungsdetails.\r\n\r\n## Was du gelernt hast\r\n\r\nIm Laufe dieses Kurses hast du wesentliches Wissen erworben über:\r\n- Die sBPF-Virtualmaschinearchitektur und ihre Rolle in Solana\r\n- Das Verständnis der 11 Allzweckregister und ihrer spezifischen Funktionen\r\n- Den festen virtuellen Speicherplan und Speicherzugriffsmuster\r\n- Stack-Nutzung und Programmein-/ausgabekonventionen\r\n- Die Unterschiede zwischen sBPF und eBPF\r\n\r\n## Nächste Schritte\r\n\r\nDu bist jetzt bereit, deine eigenen sBPF-Programme zu schreiben und zu optimieren! Um deine Reise fortzusetzen:\r\n\r\n1. Gehe zum [Bereich Challenges](/de/challenges)\r\n2. Beginne mit den anfängerfreundlichen Übungen\r\n3. Erstelle und teste dein erstes Assembly-Programm\r\n4. Tritt unserer Community bei, um deinen Fortschritt zu teilen und Hilfe zu bekommen\r\n\r\nDenk daran, obwohl höhere Programmiersprachen wie Rust für die meisten Entwicklungen bevorzugt werden, gibt dir das Verständnis von Assembly die Möglichkeit, kritische Pfade zu optimieren und komplexe Probleme zu debuggen. Experimentiere weiter und erweitere die Grenzen des mit sBPF Möglichen!\r\n","highlightedCode":{}}