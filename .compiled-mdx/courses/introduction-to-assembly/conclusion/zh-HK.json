":{"line":25,"column":1,"offset":495},"end":{"line":25,"column":79,"offset":573}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":26,"column":1,"offset":575}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# 結論\r\n\r\n恭喜你！你已完成了 Assembly 入門課程。現在你已經對 Solana 的 BPF（Solana Berkeley Packet Filter）有了堅實的基礎，從核心概念到實際實施細節。\r\n\r\n## 你學到了什麼\r\n\r\n在這個課程中，你獲得了以下重要知識：\r\n- sBPF 虛擬機架構及其在 Solana 中的角色\r\n- 理解 11 個通用寄存器及其具體作用\r\n- 固定虛擬記憶體映射和記憶體訪問模式\r\n- 堆疊使用和程式進入/退出約定\r\n- sBPF 和 eBPF 之間的差異\r\n\r\n## 下一步\r\n\r\n你現在已準備好開始撰寫和優化你自己的 sBPF 程式！繼續你的學習旅程：\r\n\r\n1. 前往 [挑戰部分](/zh-HK/challenges)\r\n2. 從適合初學者的練習開始\r\n3. 建立並測試你的第一個 Assembly 程式\r\n4. 加入我們的社群，分享你的進展並獲取幫助\r\n\r\n請記住，雖然像 Rust 這樣的高級語言是大多數開發的首選，但理解 Assembly 能讓你優化關鍵路徑並調試複雜問題。繼續實驗並突破 sBPF 的可能性！\r\n","highlightedCode":{}}