","ordered":true,"start":1,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Chuyển đến ","position":{"start":{"line":20,"column":4,"offset":845},"end":{"line":20,"column":15,"offset":856}}},{"type":"link","title":null,"url":"/vi/challenges","children":[{"type":"text","value":"phần Thử thách","position":{"start":{"line":20,"column":16,"offset":857},"end":{"line":20,"column":30,"offset":871}}}],"position":{"start":{"line":20,"column":15,"offset":856},"end":{"line":20,"column":47,"offset":888}}}],"position":{"start":{"line":20,"column":4,"offset":845},"end":{"line":20,"column":47,"offset":888}}}],"position":{"start":{"line":20,"column":1,"offset":842},"end":{"line":20,"column":47,"offset":888}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Bắt đầu với các bài tập thân thiện với người mới","position":{"start":{"line":21,"column":4,"offset":893},"end":{"line":21,"column":52,"offset":941}}}],"position":{"start":{"line":21,"column":4,"offset":893},"end":{"line":21,"column":52,"offset":941}}}],"position":{"start":{"line":21,"column":1,"offset":890},"end":{"line":21,"column":52,"offset":941}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Xây dựng và kiểm thử chương trình Assembly đầu tiên của bạn","position":{"start":{"line":22,"column":4,"offset":946},"end":{"line":22,"column":63,"offset":1005}}}],"position":{"start":{"line":22,"column":4,"offset":946},"end":{"line":22,"column":63,"offset":1005}}}],"position":{"start":{"line":22,"column":1,"offset":943},"end":{"line":22,"column":63,"offset":1005}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Tham gia cộng đồng của chúng tôi để chia sẻ tiến độ và nhận sự giúp đỡ","position":{"start":{"line":23,"column":4,"offset":1010},"end":{"line":23,"column":74,"offset":1080}}}],"position":{"start":{"line":23,"column":4,"offset":1010},"end":{"line":23,"column":74,"offset":1080}}}],"position":{"start":{"line":23,"column":1,"offset":1007},"end":{"line":23,"column":74,"offset":1080}}}],"position":{"start":{"line":20,"column":1,"offset":842},"end":{"line":23,"column":74,"offset":1080}}},{"type":"paragraph","children":[{"type":"text","value":"Hãy nhớ rằng, mặc dù các ngôn ngữ cấp cao như Rust được ưa chuộng cho hầu hết quá trình phát triển, việc hiểu assembly cho bạn sức mạnh để tối ưu hóa các đường dẫn quan trọng và gỡ lỗi các vấn đề phức tạp. Hãy tiếp tục thử nghiệm và vượt qua giới hạn của những điều có thể làm với sBPF!","position":{"start":{"line":25,"column":1,"offset":1084},"end":{"line":25,"column":287,"offset":1370}}}],"position":{"start":{"line":25,"column":1,"offset":1084},"end":{"line":25,"column":287,"offset":1370}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":26,"column":1,"offset":1372}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Kết luận\r\n\r\nXin chúc mừng! Bạn đã hoàn thành khóa học Giới thiệu về Assembly. Giờ đây bạn đã có nền tảng vững chắc để hiểu cách hoạt động của BPF của Solana (Solana Berkeley Packet Filter), từ các khái niệm cốt lõi đến chi tiết triển khai thực tế.\r\n\r\n## Những gì bạn đã học\r\n\r\nTrong suốt khóa học này, bạn đã thu được kiến thức thiết yếu về:\r\n- Kiến trúc máy ảo sBPF và vai trò của nó trong Solana\r\n- Hiểu về 11 thanh ghi đa năng và vai trò cụ thể của chúng\r\n- Bản đồ bộ nhớ ảo cố định và các mẫu truy cập bộ nhớ\r\n- Cách sử dụng ngăn xếp và quy ước vào/ra chương trình\r\n- Sự khác biệt giữa sBPF và eBPF\r\n\r\n## Các bước tiếp theo\r\n\r\nBây giờ bạn đã sẵn sàng để bắt đầu viết và tối ưu hóa các chương trình sBPF của riêng mình! Để tiếp tục hành trình:\r\n\r\n1. Chuyển đến [phần Thử thách](/vi/challenges)\r\n2. Bắt đầu với các bài tập thân thiện với người mới\r\n3. Xây dựng và kiểm thử chương trình Assembly đầu tiên của bạn\r\n4. Tham gia cộng đồng của chúng tôi để chia sẻ tiến độ và nhận sự giúp đỡ\r\n\r\nHãy nhớ rằng, mặc dù các ngôn ngữ cấp cao như Rust được ưa chuộng cho hầu hết quá trình phát triển, việc hiểu assembly cho bạn sức mạnh để tối ưu hóa các đường dẫn quan trọng và gỡ lỗi các vấn đề phức tạp. Hãy tiếp tục thử nghiệm và vượt qua giới hạn của những điều có thể làm với sBPF!\r\n","highlightedCode":{}}