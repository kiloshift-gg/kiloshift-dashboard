osition":{"start":{"line":88,"column":3,"offset":4056},"end":{"line":88,"column":40,"offset":4093}}}],"position":{"start":{"line":88,"column":1,"offset":4054},"end":{"line":88,"column":40,"offset":4093}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"The compiler generated the appropriate ","position":{"start":{"line":89,"column":3,"offset":4097},"end":{"line":89,"column":42,"offset":4136}}},{"type":"inlineCode","value":"mov64","position":{"start":{"line":89,"column":42,"offset":4136},"end":{"line":89,"column":49,"offset":4143}}},{"type":"text","value":" and ","position":{"start":{"line":89,"column":49,"offset":4143},"end":{"line":89,"column":54,"offset":4148}}},{"type":"inlineCode","value":"exit","position":{"start":{"line":89,"column":54,"offset":4148},"end":{"line":89,"column":60,"offset":4154}}},{"type":"text","value":" instructions","position":{"start":{"line":89,"column":60,"offset":4154},"end":{"line":89,"column":73,"offset":4167}}}],"position":{"start":{"line":89,"column":3,"offset":4097},"end":{"line":89,"column":73,"offset":4167}}}],"position":{"start":{"line":89,"column":1,"offset":4095},"end":{"line":89,"column":73,"offset":4167}}}],"position":{"start":{"line":87,"column":1,"offset":4017},"end":{"line":89,"column":73,"offset":4167}}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Optimized Assembly NoOp","position":{"start":{"line":91,"column":17,"offset":4187},"end":{"line":91,"column":47,"offset":4217}}},{"type":"mdxJsxAttribute","name":"id","value":"optimized-assembly-noop","position":{"start":{"line":91,"column":48,"offset":4218},"end":{"line":91,"column":76,"offset":4246}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":91,"column":77,"offset":4247},"end":{"line":91,"column":87,"offset":4257}}}],"children":[],"position":{"start":{"line":91,"column":1,"offset":4171},"end":{"line"