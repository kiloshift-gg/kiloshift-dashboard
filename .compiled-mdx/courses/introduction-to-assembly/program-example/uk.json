кого місця почати виконання вашої програми.","position":{"start":{"line":79,"column":22,"offset":3403},"end":{"line":79,"column":224,"offset":3605}}}],"position":{"start":{"line":79,"column":3,"offset":3384},"end":{"line":79,"column":224,"offset":3605}}}],"position":{"start":{"line":79,"column":1,"offset":3382},"end":{"line":79,"column":224,"offset":3605}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"entrypoint","position":{"start":{"line":80,"column":3,"offset":3609},"end":{"line":80,"column":15,"offset":3621}}},{"type":"text","value":": Це мітка, яка позначає адресу пам'яті, з якої починається виконання програми. Коли середовище виконання завантажує вашу програму, воно переходить на цю адресу.","position":{"start":{"line":80,"column":15,"offset":3621},"end":{"line":80,"column":176,"offset":3782}}}],"position":{"start":{"line":80,"column":3,"offset":3609},"end":{"line":80,"column":176,"offset":3782}}}],"position":{"start":{"line":80,"column":1,"offset":3607},"end":{"line":80,"column":176,"offset":3782}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"mov64 r0, 0x00","position":{"start":{"line":81,"column":3,"offset":3786},"end":{"line":81,"column":19,"offset":3802}}},{"type":"text","value":": Переміщення безпосереднього значення 0 в регістр r0. Оскільки r0 є регістром повернення, це встановлює код успішного повернення.","position":{"start":{"line":81,"column":19,"offset":3802},"end":{"line":81,"column":149,"offset":3932}}}],"position":{"start":{"line":81,"column":3,"offset":3786},"end":{"line":81,"column":149,"offset":3932}}}],"position":{"start":{"line":81,"column":1,"offset":3784},"end":{"line":81,"column":149,"offset":3932}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"exit","position":{"start":{"line":82,"column":3,"offset":3936},"end":{"line":82,"column":9,"offset":3942}}},{"type":"text","value":": Завершення виконання програми та повернення значення з r0 до середовища виконання.","position":{"start":{"line":82,"column":9,"offset":3942},"end":{"line":82,"column":93,"offset":4026}}}],"position":{"start":{"line":82,"column":3,"offset":3936},"end":{"line":82,"column":93,"offset":4026}}}],"position":{"start":{"line":82,"column":1,"offset":3934},"end":{"line":82,"column":93,"offset":4026}}}],"position":{"start":{"line":79,"column":1,"offset":3382},"end":{"line":82,"column":93,"offset":4026}}},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"повернення 0 означає, що ми повертаємо успішне виконання програми.","position":{"start":{"line":84,"column":3,"offset":4032},"end":{"line":84,"column":69,"offset":4098}}}],"position":{"start":{"line":84,"column":3,"offset":4032},"end":{"line":84,"column":69,"offset":4098}}}],"position":{"start":{"line":84,"column":1,"offset":4030},"end":{"line":84,"column":69,"offset":4098}}},{"type":"paragraph","children":[{"type":"text","value":"Це надзвичайно маленька програма, з лише 2 інструкціями, які споживають тільки 2 обчислювальні одиниці (CU) для виконання, що ідеально відповідає нашому коду Rust:","position":{"start":{"line":86,"column":1,"offset":4102},"end":{"line":86,"column":164,"offset":4265}}}],"position":{"start":{"line":86,"column":1,"offset":4102},"end":{"line":86,"column":164,"offset":4265}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Ми визначили функцію точки входу","position":{"start":{"line":87,"column":3,"offset":4269},"end":{"line":87,"column":35,"offset":4301}}}],"position":{"start":{"line":87,"column":3,"offset":4269},"end":{"line":87,"column":35,"offset":4301}}}],"position":{"start":{"line":87,"column":1,"offset":4267},"end":{"line":87,"column":35,"offset":4301}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Ми повертаємо Ok(()) що обчислюється як 0","position":{"start":{"line":88,"column":3,"offset":4305},"end":{"line":88,"column":44,"offset":4346}}}],"position":{"start":{"line":88,"column":3,"offset":4305},"end":{"line":88,"column":44,"offset":4346}}}],"position":{"start":{"line":88,"column":1,"offset":4303},"end":{"line":88,"column":44,"offset":4346}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Компілятор згенерував відповідні інструкції ","position":{"start":{"line":89,"column":3,"offset":4350},"end":{"line":89,"column":47,"offset":4394}}},{"type":"inlineCode","value":"mov64","position":{"start":{"line":89,"column":47,"offset":4394},"end":{"line":89,"column":54,"offset":4401}}},{"type":"text","value":" та ","position":{"start":{"line":89,"column":54,"offset":4401},"end":{"line":89,"column":58,"offset":4405}}},{"type":"inlineCode","value":"exit","position":{"start":{"line":89,"column":58,"offset":4405},"end":{"line":89,"column":64,"offset":4411}}}],"position":{"start":{"line":89,"column":3,"offset":4350},"end":{"line":89,"column":64,"offset":4411}}}],"position":{"start":{"line":89,"column":1,"offset":4348},"end":{"line":89,"column":64,"offset":4411}}}],"position":{"start":{"line":87,"column":1,"offset":4267},"end":{"line":89,"column":64,"offset":4411}}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Оптимізована збірка NoOp","position":{"start":{"line":91,"column":17,"offset":4431},"end":{"line":91,"column":48,"offset":4462}}},{"type":"mdxJsxAttribute","name":"id","value":"optimized-assembly-noop","position":{"start":{"line":91,"column":49,"offset":4463},"end":{"line":91,"column":77,"offset":4491}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":91,"column":78,"offset":4492},"end":{"line":91,"column":88,"offset":4502}}}],"children":[],"position":{"start":{"line":91,"column":1,"offset":4415},"end":{"line":91,"column":91,"offset":4505}}},{"type":"paragraph","children":[{"type":"text","value":"Однак ми можемо оптимізувати це ще більше. Оскільки середовище виконання Solana ініціалізує ","position":{"start":{"line":93,"column":1,"offset":4509},"end":{"line":93,"column":93,"offset":4601}}},{"type":"inlineCode","value":"r0","position":{"start":{"line":93,"column":93,"offset":4601},"end":{"line":93,"column":97,"offset":4605}}},{"type":"text","value":" значенням 0 за замовчуванням, ми можемо усунути надлишкову інструкцію ","position":{"start":{"line":93,"column":97,"offset":4605},"end":{"line":93,"column":168,"offset":4676}}},{"type":"inlineCode","value":"mov64","position":{"start":{"line":93,"column":168,"offset":4676},"end":{"line":93,"column":175,"offset":4683}}},{"type":"text","value":":","position":{"start":{"line":93,"column":175,"offset":4683},"end":{"line":93,"column":176,"offset":4684}}}],"position":{"start":{"line":93,"column":1,"offset":4509},"end":{"line":93,"column":176,"offset":4684}}},{"type":"code","lang":"sbpf","meta":null,"value":".globl entrypoint\r\nentrypoint:\r\n    exit","position":{"start":{"line":95,"column":1,"offset":4688},"end":{"line":99,"column":4,"offset":4742}},"data":{"highlightId":"code-3"}},{"type":"paragraph","children":[{"type":"text","value":"Ця оптимізована версія:","position":{"start":{"line":101,"column":1,"offset":4746},"end":{"line":101,"column":24,"offset":4769}}}],"position":{"start":{"line":101,"column":1,"offset":4746},"end":{"line":101,"column":24,"offset":4769}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Коштує лише 1 обчислювальну одиницю (зменшення на 50%!)","position":{"start":{"line":102,"column":3,"offset":4773},"end":{"line":102,"column":58,"offset":4828}}}],"position":{"start":{"line":102,"column":3,"offset":4773},"end":{"line":102,"column":58,"offset":4828}}}],"position":{"start":{"line":102,"column":1,"offset":4771},"end":{"line":102,"column":58,"offset":4828}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Дає ідентичні результати (","position":{"start":{"line":103,"column":3,"offset":4832},"end":{"line":103,"column":29,"offset":4858}}},{"type":"inlineCode","value":"r0","position":{"start":{"line":103,"column":29,"offset":4858},"end":{"line":103,"column":33,"offset":4862}}},{"type":"text","value":" все ще містить 0)","position":{"start":{"line":103,"column":33,"offset":4862},"end":{"line":103,"column":51,"offset":4880}}}],"position":{"start":{"line":103,"column":3,"offset":4832},"end":{"line":103,"column":51,"offset":4880}}}],"position":{"start":{"line":103,"column":1,"offset":4830},"end":{"line":103,"column":51,"offset":4880}}}],"position":{"start":{"line":102,"column":1,"offset":4771},"end":{"line":103,"column":51,"offset":4880}}},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"Ось чому розуміння асемблера допомагає з оптимізацією!","position":{"start":{"line":105,"column":3,"offset":4886},"end":{"line":105,"column":57,"offset":4940}}}],"position":{"start":{"line":105,"column":3,"offset":4886},"end":{"line":105,"column":57,"offset":4940}}}],"position":{"start":{"line":105,"column":1,"offset":4884},"end":{"line":105,"column":57,"offset":4940}}},{"type":"paragraph","children":[{"type":"text","value":"Ця оптимізація можлива, оскільки ми знаємо початкові стани регістрів — щось, чим компілятор Rust не завжди користується. Розуміння асемблера sBPF дозволяє виявляти та усувати такі неефективності в критичному для продуктивності коді.","position":{"start":{"line":107,"column":1,"offset":4944},"end":{"line":107,"column":233,"offset":5176}}}],"position":{"start":{"line":107,"column":1,"offset":4944},"end":{"line":107,"column":233,"offset":5176}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":107,"column":233,"offset":5176}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Приклад програми\r\n\r\nТепер давайте подивимося, як регістри (r0-r10), області пам'яті та інструкції працюють разом у реальній програмі. Ми почнемо з найпростішої можливої програми sBPF, щоб зрозуміти фундаментальний процес виконання.\r\n\r\n<ArticleSection name=\"NoOp-program\" id=\"noop-program\" level=\"h2\" />\r\n\r\nПрограма \"NoOp\" (No Operation, без операцій) ідеально підходить для навчання, оскільки демонструє основну структуру програми без зайвої складності:\r\n- Як програми отримують вхідні дані (у регістрі r1)\r\n- Як вони повертають результати (у регістрі r0)\r\n- Базовий потік входу/виходу, якому слідує кожна програма sBPF\r\n- Як Rust компілюється в асемблер sBPF\r\n\r\nХоча вона \"нічого не робить\", вона показує вам основу, на якій будується кожна програма Solana.\r\n\r\nТепер, коли ми знаємо основні операції sBPF, давайте подивимося, як вони виглядають у реальній (навіть якщо крихітній) програмі.\r\n\r\n<ArticleSection name=\"Pinocchio NoOp\" id=\"pinocchio-noop\" level=\"h2\" />\r\n\r\nНижче наведено високопродуктивний \"noop\", написаний за допомогою Pinocchio. Все, що він робить, це повертає успішний результат:\r\n\r\n```rust\r\n#![no_std]\r\nuse pinocchio::{entrypoint::InstructionContext, lazy_program_entrypoint, no_allocator, nostd_panic_handler, ProgramResult};\r\n\r\nlazy_program_entrypoint!(process_instruction);\r\n\r\nnostd_panic_handler!();\r\nno_allocator!();\r\n\r\nfn process_instruction(\r\n    _context: InstructionContext, // wrapper around the input buffer\r\n ) -> ProgramResult {\r\n    Ok(())\r\n}\r\n```\r\n\r\nЯкщо ми скомпілюємо цей код за допомогою `cargo build-sbf --dump`, ми отримаємо дамп ELF, який надасть нам інформацію про наш бінарний файл у директорії `/target/deploy/`.\r\n\r\nПотім ми захочемо знайти секцію `.text` — частину нашого бінарного файлу, де зберігається виконуваний код.\r\n\r\n```\r\nDisassembly of section .text\r\n0000000000000120 <entrypoint>\r\n     120 b7 00 00 00 00 00 00 00      \tmov64 r0, 0x0\r\n     128 95 00 00 00 00 00 00 00      \texit\r\n```\r\n\r\nДавайте розберемо, що насправді означають ці шістнадцяткові байти, використовуючи формат інструкцій, який ми вивчили:\r\n\r\nЦе перша інструкція: `120 b7 00 00 00 00 00 00 00`\r\n- Адреса: `0x120` (в текстовій області, що починається з 0x100000000)\r\n- Опкод: `0xb7` = `mov64` з безпосереднім значенням\r\n- dst: `0x00` = регістр `r0`\r\n- src: `0x00` = не використовується (операція з безпосереднім значенням)\r\n- offset: `0x0000` = не використовується\r\n- imm: `0x00000000` = безпосереднє значення 0\r\n\r\nІ це друга інструкція: `128 95 00 00 00 00 00 00 00`\r\n- Адреса: `0x128` (8 байтів після першої інструкції)\r\n- Опкод: `0x95` = вихід/повернення\r\n- Усі інші поля: `0x00` = не використовуються для виходу\r\n\r\n> Зміщення `0x120` - це місце, де компонувальник вирішив розмістити функцію точки входу в секції `.text` файлу ELF. Файл ELF починається з заголовків, таблиць секцій та інших метаданих, які займають перші ~`0x120` байтів (288 байтів). Фактичний виконуваний код розміщується після всієї цієї службової інформації.\r\n\r\n<ArticleSection name=\"Assembly NoOp\" id=\"assembly-noop\" level=\"h2\" />\r\n\r\nЯкщо ми дизасемблюємо бінарний файл, щоб перетворити його назад у компільований sBPF Assembly, код виглядатиме так:\r\n\r\n```sbpf\r\n.globl entrypoint\r\nentrypoint:\r\n    mov64 r0, 0x00   // r0 <- success\r\n    exit             // finish, return r0\r\n```\r\n\r\nРозберемо код:\r\n- `.globl entrypoint`: Це директива асемблера, яка вказує компонувальнику зробити символ точки входу глобально видимим. Середовище виконання Solana шукає цей символ, щоб знати, з якого місця почати виконання вашої програми.\r\n- `entrypoint`: Це мітка, яка позначає адресу пам'яті, з якої починається виконання програми. Коли середовище виконання завантажує вашу програму, воно переходить на цю адресу.\r\n- `mov64 r0, 0x00`: Переміщення безпосереднього значення 0 в регістр r0. Оскільки r0 є регістром повернення, це встановлює код успішного повернення.\r\n- `exit`: Завершення виконання програми та повернення значення з r0 до середовища виконання.\r\n\r\n> повернення 0 означає, що ми повертаємо успішне виконання програми.\r\n\r\nЦе надзвичайно маленька програма, з лише 2 інструкціями, які споживають тільки 2 обчислювальні одиниці (CU) для виконання, що ідеально відповідає нашому коду Rust:\r\n- Ми визначили функцію точки входу\r\n- Ми повертаємо Ok(()) що обчислюється як 0\r\n- Компілятор згенерував відповідні інструкції `mov64` та `exit`\r\n\r\n<ArticleSection name=\"Оптимізована збірка NoOp\" id=\"optimized-assembly-noop\" level=\"h2\" />\r\n\r\nОднак ми можемо оптимізувати це ще більше. Оскільки середовище виконання Solana ініціалізує `r0` значенням 0 за замовчуванням, ми можемо усунути надлишкову інструкцію `mov64`:\r\n\r\n```sbpf\r\n.globl entrypoint\r\nentrypoint:\r\n    exit\r\n```\r\n\r\nЦя оптимізована версія:\r\n- Коштує лише 1 обчислювальну одиницю (зменшення на 50%!)\r\n- Дає ідентичні результати (`r0` все ще містить 0)\r\n\r\n> Ось чому розуміння асемблера допомагає з оптимізацією!\r\n\r\nЦя оптимізація можлива, оскільки ми знаємо початкові стани регістрів — щось, чим компілятор Rust не завжди користується. Розуміння асемблера sBPF дозволяє виявляти та усувати такі неефективності в критичному для продуктивності коді.","highlightedCode":{"code-0":{"lang":"rust","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":