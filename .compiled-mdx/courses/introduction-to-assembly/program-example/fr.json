t":{"line":87,"column":3,"offset":4536},"end":{"line":87,"column":51,"offset":4584}}}],"position":{"start":{"line":87,"column":3,"offset":4536},"end":{"line":87,"column":51,"offset":4584}}}],"position":{"start":{"line":87,"column":1,"offset":4534},"end":{"line":87,"column":51,"offset":4584}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Nous retournons Ok(()) qui s'évalue à 0","position":{"start":{"line":88,"column":3,"offset":4588},"end":{"line":88,"column":42,"offset":4627}}}],"position":{"start":{"line":88,"column":3,"offset":4588},"end":{"line":88,"column":42,"offset":4627}}}],"position":{"start":{"line":88,"column":1,"offset":4586},"end":{"line":88,"column":42,"offset":4627}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Le compilateur a généré les instructions ","position":{"start":{"line":89,"column":3,"offset":4631},"end":{"line":89,"column":44,"offset":4672}}},{"type":"inlineCode","value":"mov64","position":{"start":{"line":89,"column":44,"offset":4672},"end":{"line":89,"column":51,"offset":4679}}},{"type":"text","value":" et ","position":{"start":{"line":89,"column":51,"offset":4679},"end":{"line":89,"column":55,"offset":4683}}},{"type":"inlineCode","value":"exit","position":{"start":{"line":89,"column":55,"offset":4683},"end":{"line":89,"column":61,"offset":4689}}},{"type":"text","value":" appropriées","position":{"start":{"line":89,"column":61,"offset":4689},"end":{"line":89,"column":73,"offset":4701}}}],"position":{"start":{"line":89,"column":3,"offset":4631},"end":{"line":89,"column":73,"offset":4701}}}],"position":{"start":{"line":89,"column":1,"offset":4629},"end":{"line":89,"column":73,"offset":4701}}}],"position":{"start":{"line":87,"column":1,"offset":4534},"end":{"line":89,"column":73,"offset":4701}}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"NoOp d'assemblage optimisé","position":{"start":{"line":91,"column":17,"offset":4721},"end":{"line":91,"column":50,"offset":4754}}},{"type":"mdxJsxAttribute","name":"id","value":"optimized-assembly-noop","position":{"start":{"line":91,"column":51,"offset":4755},"end":{"line":91,"column":79,"offset":4783}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":91,"column":80,"offset":4784},"end":{"line":91,"column":90,"offset":4794}}}],"children":[],"position":{"start":{"line":91,"column":1,"offset":4705},"end":{"line":91,"column":93,"offset":4797}}},{"type":"paragraph","children":[{"type":"text","value":"Cependant, nous pouvons optimiser davantage. Puisque l'environnement d'exécution de Solana initialise ","position":{"start":{"line":93,"column":1,"offset":4801},"end":{"line":93,"column":103,"offset":4903}}},{"type":"inlineCode","value":"r0","position":{"start":{"line":93,"column":103,"offset":4903},"end":{"line":93,"column":107,"offset":4907}}},{"type":"text","value":" à 0 par défaut, nous pouvons éliminer l'instruction redondante ","position":{"start":{"line":93,"column":107,"offset":4907},"end":{"line":93,"column":171,"offset":4971}}},{"type":"inlineCode","value":"mov64","position":{"start":{"line":93,"column":171,"offset":4971},"end":{"line":93,"column":178,"offset":4978}}},{"type":"text","value":" :","position":{"start":{"line":93,"column":178,"offset":4978},"end":{"line":93,"column":180,"offset":4980}}}],"position":{"start":{"line":93,"column":1,"offset":4801},"end":{"line":93,"column":180,"offset":4980}}},{"type":"code","lang":"sbpf","meta":null,"value":".globl entrypoint\r\nentrypoint:\r\n    exit","position":{"start":{"line":95,"column":1,"offset":4984},"end":{"line":99,"column":4,"offset":5038}},"data":{"highlightId":"code-3"}},{"type":"paragraph","children":[{"type":"text","value":"Cette version optimisée :","position":{"start":{"line":101,"column":1,"offset":5042},"end":{"line":101,"column":26,"offset":5067}}}],"position":{"start":{"line":101,"column":1,"offset":5042},"end":{"line":101,"column":26,"offset":5067}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Coûte seulement 1 unité de calcul (réduction de 50% !)","position":{"start":{"line":102,"column":3,"offset":5071},"end":{"line":102,"column":57,"offset":5125}}}],"position":{"start":{"line":102,"column":3,"offset":5071},"end":{"line":102,"column":57,"offset":5125}}}],"position":{"start":{"line":102,"column":1,"offset":5069},"end":{"line":102,"column":57,"offset":5125}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Produit des résultats identiques (","position":{"start":{"line":103,"column":3,"offset":5129},"end":{"line":103,"column":37,"offset":5163}}},{"type":"inlineCode","value":"r0","position":{"start":{"line":103,"column":37,"offset":5163},"end":{"line":103,"column":41,"offset":5167}}},{"type":"text","value":" contient toujours 0)","position":{"start":{"line":103,"column":41,"offset":5167},"end":{"line":103,"column":62,"offset":5188}}}],"position":{"start":{"line":103,"column":3,"offset":5129},"end":{"line":103,"column":62,"offset":5188}}}],"position":{"start":{"line":103,"column":1,"offset":5127},"end":{"line":103,"column":62,"offset":5188}}}],"position":{"start":{"line":102,"column":1,"offset":5069},"end":{"line":103,"column":62,"offset":5188}}},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"C'est pourquoi comprendre l'assemblage aide à l'optimisation !","position":{"start":{"line":105,"column":3,"offset":5194},"end":{"line":105,"column":65,"offset":5256}}}],"position":{"start":{"line":105,"column":3,"offset":5194},"end":{"line":105,"column":65,"offset":5256}}}],"position":{"start":{"line":105,"column":1,"offset":5192},"end":{"line":105,"column":65,"offset":5256}}},{"type":"paragraph","children":[{"type":"text","value":"Cette optimisation est possible car nous connaissons les états initiaux des registres — un avantage dont le compilateur Rust ne tire pas toujours parti. Comprendre l'assemblage sBPF vous permet d'identifier et d'éliminer de telles inefficacités dans le code critique en termes de performance.","position":{"start":{"line":107,"column":1,"offset":5260},"end":{"line":107,"column":293,"offset":5552}}}],"position":{"start":{"line":107,"column":1,"offset":5260},"end":{"line":107,"column":293,"offset":5552}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":107,"column":293,"offset":5552}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Exemple de programme\r\n\r\nVoyons maintenant comment les registres (r0-r10), les régions mémoire et les instructions fonctionnent ensemble dans un programme réel. Nous commencerons par le programme sBPF le plus simple possible pour comprendre le flux d'exécution fondamental.\r\n\r\n<ArticleSection name=\"NoOp-program\" id=\"noop-program\" level=\"h2\" />\r\n\r\nUn programme \"NoOp\" (No Operation) est parfait pour l'apprentissage car il démontre la structure essentielle du programme sans aucune complexité :\r\n- Comment les programmes reçoivent des entrées (dans le registre r1)\r\n- Comment ils renvoient des résultats (dans le registre r0)\r\n- Le flux d'entrée/sortie de base que suit chaque programme sBPF\r\n- Comment Rust se compile en assembleur sBPF\r\n\r\nMême s'il ne \"fait rien\", il vous montre la base sur laquelle chaque programme Solana est construit.\r\n\r\nMaintenant que nous connaissons les opérations sBPF de base, voyons à quoi elles ressemblent dans un vrai programme (même minuscule).\r\n\r\n<ArticleSection name=\"Pinocchio NoOp\" id=\"pinocchio-noop\" level=\"h2\" />\r\n\r\nCi-dessous se trouve un \"noop\" haute performance écrit avec Pinocchio. Tout ce qu'il fait est de retourner un succès :\r\n\r\n```rust\r\n#![no_std]\r\nuse pinocchio::{entrypoint::InstructionContext, lazy_program_entrypoint, no_allocator, nostd_panic_handler, ProgramResult};\r\n\r\nlazy_program_entrypoint!(process_instruction);\r\n\r\nnostd_panic_handler!();\r\nno_allocator!();\r\n\r\nfn process_instruction(\r\n    _context: InstructionContext, // wrapper around the input buffer\r\n ) -> ProgramResult {\r\n    Ok(())\r\n}\r\n```\r\n\r\nSi nous compilons ce code avec `cargo build-sbf --dump`, nous obtiendrons un dump ELF qui nous donne des informations sur notre binaire dans le répertoire `/target/deploy/`.\r\n\r\nNous voudrons ensuite chercher la section `.text` — la partie de notre binaire où le code exécutable est stocké.\r\n\r\n```\r\nDisassembly of section .text\r\n0000000000000120 <entrypoint>\r\n     120 b7 00 00 00 00 00 00 00      \tmov64 r0, 0x0\r\n     128 95 00 00 00 00 00 00 00      \texit\r\n```\r\n\r\nDécomposons ce que ces octets hexadécimaux signifient réellement en utilisant le format d'instruction que nous avons appris :\r\n\r\nVoici la première instruction : `120 b7 00 00 00 00 00 00 00`\r\n- Adresse : `0x120` (dans la région de texte commençant à 0x100000000)\r\n- Opcode : `0xb7` = `mov64` avec valeur immédiate\r\n- dst : `0x00` = registre `r0`\r\n- src : `0x00` = non utilisé (opération immédiate)\r\n- offset : `0x0000` = non utilisé\r\n- imm : `0x00000000` = valeur immédiate 0\r\n\r\nEt voici la seconde instruction : `128 95 00 00 00 00 00 00 00`\r\n- Adresse : `0x128` (8 octets après la première instruction)\r\n- Code opération : `0x95` = sortie/retour\r\n- Tous les autres champs : `0x00` = non utilisés pour la sortie\r\n\r\n> Le décalage `0x120` correspond à l'endroit où l'éditeur de liens a décidé de placer la fonction de point d'entrée dans la section `.text` du fichier ELF. Le fichier ELF commence par des en-têtes, des tables de sections et d'autres métadonnées qui occupent les premiers ~`0x120` octets (288 octets). Le code exécutable proprement dit vient après toutes ces informations administratives.\r\n\r\n<ArticleSection name=\"Assembly NoOp\" id=\"assembly-noop\" level=\"h2\" />\r\n\r\nSi nous désassemblions le binaire pour le reconvertir en code assembleur sBPF compilable, le code ressemblerait à ceci :\r\n\r\n```sbpf\r\n.globl entrypoint\r\nentrypoint:\r\n    mov64 r0, 0x00   // r0 <- success\r\n    exit             // finish, return r0\r\n```\r\n\r\nAnalysons ce code :\r\n- `.globl entrypoint` : c'est une directive d'assemblage qui indique à l'éditeur de liens de rendre le symbole du point d'entrée visible globalement. L'environnement d'exécution Solana recherche ce symbole pour savoir où commencer l'exécution de votre programme.\r\n- `entrypoint` : c'est une étiquette qui marque l'adresse mémoire où l'exécution du programme commence. Lorsque l'environnement d'exécution charge votre programme, il saute à cette adresse.\r\n- `mov64 r0, 0x00` : déplace la valeur immédiate 0 dans le registre r0. Comme r0 est le registre de retour, cela définit un code de retour de succès.\r\n- `exit` : termine l'exécution du programme et renvoie la valeur de r0 à l'environnement d'exécution.\r\n\r\n> retourner 0 signifie que nous retournons un succès pour le programme.\r\n\r\nC'est un programme extrêmement petit, avec seulement 2 instructions consommant uniquement 2 unités de calcul (CU) à exécuter, qui correspond parfaitement à notre code Rust :\r\n- Nous avons défini une fonction de point d'entrée\r\n- Nous retournons Ok(()) qui s'évalue à 0\r\n- Le compilateur a généré les instructions `mov64` et `exit` appropriées\r\n\r\n<ArticleSection name=\"NoOp d'assemblage optimisé\" id=\"optimized-assembly-noop\" level=\"h2\" />\r\n\r\nCependant, nous pouvons optimiser davantage. Puisque l'environnement d'exécution de Solana initialise `r0` à 0 par défaut, nous pouvons éliminer l'instruction redondante `mov64` :\r\n\r\n```sbpf\r\n.globl entrypoint\r\nentrypoint:\r\n    exit\r\n```\r\n\r\nCette version optimisée :\r\n- Coûte seulement 1 unité de calcul (réduction de 50% !)\r\n- Produit des résultats identiques (`r0` contient toujours 0)\r\n\r\n> C'est pourquoi comprendre l'assemblage aide à l'optimisation !\r\n\r\nCette optimisation est possible car nous connaissons les états initiaux des registres — un avantage dont le compilateur Rust ne tire pas toujours parti. Comprendre l'assemblage sBPF vous permet d'identifier et d'éliminer de telles inefficacités dans le code critique en termes de performance.","highlightedCode":{"code-0":{"lang":"rust","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"#![no_std]"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"use"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" pinocchio"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"::"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"{entrypoint"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"::"}]},{"type":"element","tagName":"span","properties":{"style":"color:#97E1F1;font-style:italic"},"children":[{"type":"text","value":"InstructionContext"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":", lazy_program_entrypoint, no_allocator, nostd_panic_handler, "}]},{"type":"element","tagName":"span","properties":{"style":"color:#97E1F1;font-style:italic"},"children":[{"type":"text","value":"ProgramResult"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"};"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#62E884"},"children":[{"type":"text","value":"lazy_program_entrypoint!"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"(process_instruction);"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#62E884"},"children":[{"type":"text","value":"nostd_panic_handler!"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"();"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#62E884"},"children":[{"type":"text","value":"no_allocator!"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"();"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"fn"}]},{"type":"element","tagName":"span","properties":{"style":"color:#62E884"},"childre