ition":{"start":{"line":91,"column":48,"offset":4541},"end":{"line":91,"column":76,"offset":4569}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":91,"column":77,"offset":4570},"end":{"line":91,"column":87,"offset":4580}}}],"children":[],"position":{"start":{"line":91,"column":1,"offset":4494},"end":{"line":91,"column":90,"offset":4583}}},{"type":"paragraph","children":[{"type":"text","value":"Namun, kita dapat mengoptimalkan ini lebih lanjut. Karena runtime Solana menginisialisasi ","position":{"start":{"line":93,"column":1,"offset":4587},"end":{"line":93,"column":91,"offset":4677}}},{"type":"inlineCode","value":"r0","position":{"start":{"line":93,"column":91,"offset":4677},"end":{"line":93,"column":95,"offset":4681}}},{"type":"text","value":" ke 0 secara default, kita dapat menghilangkan instruksi ","position":{"start":{"line":93,"column":95,"offset":4681},"end":{"line":93,"column":152,"offset":4738}}},{"type":"inlineCode","value":"mov64","position":{"start":{"line":93,"column":152,"offset":4738},"end":{"line":93,"column":159,"offset":4745}}},{"type":"text","value":" yang redundan:","position":{"start":{"line":93,"column":159,"offset":4745},"end":{"line":93,"column":174,"offset":4760}}}],"position":{"start":{"line":93,"column":1,"offset":4587},"end":{"line":93,"column":174,"offset":4760}}},{"type":"code","lang":"sbpf","meta":null,"value":".globl entrypoint\r\nentrypoint:\r\n    exit","position":{"start":{"line":95,"column":1,"offset":4764},"end":{"line":99,"column":4,"offset":4818}},"data":{"highlightId":"code-3"}},{"type":"paragraph","children":[{"type":"text","value":"Versi yang dioptimalkan ini:","position":{"start":{"line":101,"column":1,"offset":4822},"end":{"line":101,"column":29,"offset":4850}}}],"position":{"start":{"line":101,"column":1,"offset":4822},"end":{"line":101,"column":29,"offset":4850}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Hanya membutuhkan 1 unit komputasi (pengurangan 50%!)","position":{"start":{"line":102,"column":3,"offset":4854},"end":{"line":102,"column":56,"offset":4907}}}],"position":{"start":{"line":102,"column":3,"offset":4854},"end":{"line":102,"column":56,"offset":4907}}}],"position":{"start":{"line":102,"column":1,"offset":4852},"end":{"line":102,"column":56,"offset":4907}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Menghasilkan hasil yang identik (","position":{"start":{"line":103,"column":3,"offset":4911},"end":{"line":103,"column":36,"offset":4944}}},{"type":"inlineCode","value":"r0","position":{"start":{"line":103,"column":36,"offset":4944},"end":{"line":103,"column":40,"offset":4948}}},{"type":"text","value":" masih berisi 0)","position":{"start":{"line":103,"column":40,"offset":4948},"end":{"line":103,"column":56,"offset":4964}}}],"position":{"start":{"line":103,"column":3,"offset":4911},"end":{"line":103,"column":56,"offset":4964}}}],"position":{"start":{"line":103,"column":1,"offset":4909},"end":{"line":103,"column":56,"offset":4964}}}],"position":{"start":{"line":102,"column":1,"offset":4852},"end":{"line":103,"column":56,"offset":4964}}},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"Inilah mengapa memahami assembly membantu dalam optimasi!","position":{"start":{"line":105,"column":3,"offset":4970},"end":{"line":105,"column":60,"offset":5027}}}],"position":{"start":{"line":105,"column":3,"offset":4970},"end":{"line":105,"column":60,"offset":5027}}}],"position":{"start":{"line":105,"column":1,"offset":4968},"end":{"line":105,"column":60,"offset":5027}}},{"type":"paragraph","children":[{"type":"text","value":"Optimasi ini dimungkinkan karena kita mengetahui status register awal — sesuatu yang tidak selalu dimanfaatkan oleh compiler Rust. Memahami assembly sBPF memungkinkan Anda mengidentifikasi dan menghilangkan inefisiensi seperti ini dalam kode yang kritis terhadap performa.","position":{"start":{"line":107,"column":1,"offset":5031},"end":{"line":107,"column":273,"offset":5303}}}],"position":{"start":{"line":107,"column":1,"offset":5031},"end":{"line":107,"column":273,"offset":5303}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":107,"column":273,"offset":5303}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Contoh Program\r\n\r\nSekarang mari kita lihat bagaimana register (r0-r10), region memori, dan instruksi bekerja bersama dalam program yang sebenarnya. Kita akan mulai dengan program sBPF paling sederhana untuk memahami alur eksekusi fundamental.\r\n\r\n<ArticleSection name=\"NoOp-program\" id=\"noop-program\" level=\"h2\" />\r\n\r\nProgram \"NoOp\" (No Operation) sangat cocok untuk pembelajaran karena menunjukkan struktur program yang esensial tanpa kerumitan:\r\n- Bagaimana program menerima input (dalam register r1)\r\n- Bagaimana program mengembalikan hasil (dalam register r0)\r\n- Alur masuk/keluar dasar yang diikuti setiap program sBPF\r\n- Bagaimana Rust dikompilasi menjadi assembly sBPF\r\n\r\nMeskipun program ini \"tidak melakukan apa-apa,\" program ini menunjukkan dasar yang menjadi landasan setiap program Solana.\r\n\r\nSekarang kita telah mengetahui operasi dasar sBPF, mari kita lihat seperti apa operasi tersebut dalam program nyata (meskipun sangat kecil).\r\n\r\n<ArticleSection name=\"Pinocchio NoOp\" id=\"pinocchio-noop\" level=\"h2\" />\r\n\r\nDi bawah ini adalah \"noop\" berkinerja tinggi yang ditulis dengan Pinocchio. Yang dilakukannya hanyalah mengembalikan keberhasilan:\r\n\r\n```rust\r\n#![no_std]\r\nuse pinocchio::{entrypoint::InstructionContext, lazy_program_entrypoint, no_allocator, nostd_panic_handler, ProgramResult};\r\n\r\nlazy_program_entrypoint!(process_instruction);\r\n\r\nnostd_panic_handler!();\r\nno_allocator!();\r\n\r\nfn process_instruction(\r\n    _context: InstructionContext, // wrapper around the input buffer\r\n ) -> ProgramResult {\r\n    Ok(())\r\n}\r\n```\r\n\r\nJika kita membangun kode ini dengan `cargo build-sbf --dump`, kita akan mendapatkan dump ELF yang memberikan informasi tentang binary kita di direktori `/target/deploy/`.\r\n\r\nKemudian kita perlu mencari bagian `.text` — bagian dari binary kita tempat kode yang dapat dieksekusi disimpan.\r\n\r\n```\r\nDisassembly of section .text\r\n0000000000000120 <entrypoint>\r\n     120 b7 00 00 00 00 00 00 00      \tmov64 r0, 0x0\r\n     128 95 00 00 00 00 00 00 00      \texit\r\n```\r\n\r\nMari kita uraikan apa arti byte-byte heksadesimal ini menggunakan format instruksi yang telah kita pelajari:\r\n\r\nIni adalah instruksi pertama: `120 b7 00 00 00 00 00 00 00`\r\n- Alamat: `0x120` (dalam region teks yang dimulai pada 0x100000000)\r\n- Opcode: `0xb7` = `mov64` dengan nilai immediate\r\n- dst: `0x00` = register `r0`\r\n- src: `0x00` = tidak digunakan (operasi immediate)\r\n- offset: `0x0000` = tidak digunakan\r\n- imm: `0x00000000` = nilai immediate 0\r\n\r\nDan ini adalah instruksi kedua: `128 95 00 00 00 00 00 00 00`\r\n- Alamat: `0x128` (8 byte setelah instruksi pertama)\r\n- Opcode: `0x95` = exit/return\r\n- Semua field lainnya: `0x00` = tidak digunakan untuk exit\r\n\r\n> Offset `0x120` adalah tempat di mana linker memutuskan untuk menempatkan fungsi entrypoint dalam bagian `.text` file ELF. File ELF dimulai dengan header, tabel bagian, dan metadata lain yang mengambil ~`0x120` byte pertama (288 byte). Kode yang dapat dieksekusi sebenarnya muncul setelah semua informasi pembukuan tersebut.\r\n\r\n<ArticleSection name=\"Assembly NoOp\" id=\"assembly-noop\" level=\"h2\" />\r\n\r\nJika kita mendisassembly binary untuk mengubahnya kembali menjadi sBPF Assembly yang dapat dikompilasi, kodenya akan terlihat seperti ini:\r\n\r\n```sbpf\r\n.globl entrypoint\r\nentrypoint:\r\n    mov64 r0, 0x00   // r0 <- success\r\n    exit             // finish, return r0\r\n```\r\n\r\nMari kita uraikan kodenya:\r\n- `.globl entrypoint`: Ini adalah direktif assembler yang memberi tahu linker untuk membuat simbol entrypoint terlihat secara global. Runtime Solana mencari simbol ini untuk mengetahui di mana harus mulai mengeksekusi program Anda.\r\n- `entrypoint`: Ini adalah label yang menandai alamat memori di mana eksekusi program dimulai. Ketika runtime memuat program Anda, ia melompat ke alamat ini.\r\n- `mov64 r0, 0x00`: Memindahkan nilai langsung 0 ke register r0. Karena r0 adalah register return, ini menyiapkan kode return sukses.\r\n- `exit`: Mengakhiri eksekusi program dan mengembalikan nilai dalam r0 ke runtime.\r\n\r\n> mengembalikan 0 berarti kita mengembalikan status sukses untuk program.\r\n\r\nIni adalah program yang sangat kecil, dengan hanya 2 instruksi yang mengkonsumsi hanya 2 compute unit (CU) untuk dieksekusi yang memetakan dengan sempurna ke kode Rust kita:\r\n- Kita mendefinisikan fungsi entrypoint\r\n- Kita mengembalikan Ok(()) yang dievaluasi menjadi 0\r\n- Compiler menghasilkan instruksi `mov64` dan `exit` yang sesuai\r\n\r\n<ArticleSection name=\"Optimized Assembly NoOp\" id=\"optimized-assembly-noop\" level=\"h2\" />\r\n\r\nNamun, kita dapat mengoptimalkan ini lebih lanjut. Karena runtime Solana menginisialisasi `r0` ke 0 secara default, kita dapat menghilangkan instruksi `mov64` yang redundan:\r\n\r\n```sbpf\r\n.globl entrypoint\r\nentrypoint:\r\n    exit\r\n```\r\n\r\nVersi yang dioptimalkan ini:\r\n- Hanya membutuhkan 1 unit komputasi (pengurangan 50%!)\r\n- Menghasilkan hasil yang identik (`r0` masih berisi 0)\r\n\r\n> Inilah mengapa memahami assembly membantu dalam optimasi!\r\n\r\nOptimasi ini dimungkinkan karena kita mengetahui status register awal — sesuatu yang tidak selalu dimanfaatkan oleh compiler Rust. Memahami assembly sBPF memungkinkan Anda mengidentifikasi dan menghilangkan inefisiensi seperti ini dalam kode yang kritis terhadap performa.","highlightedCode":{"code-0":{"lang":"rust","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"#![no_std]"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"use"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" pinocchio"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"::"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"{entrypoint"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"::"}]},{"type":"element","tagName":"span","properties":{"style":"color:#97E1F1;font-style:italic"},"children":[{"type":"text","value":"InstructionContext"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":", lazy_program_entrypoint, no_allocator, nostd_panic_handler, "}]},{"type":"element","tagName":"span","properties":{"style":"color:#97E1F1;font-style:italic"},"children":[{"type":"text","value":"ProgramResult"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"};"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tag