column":8,"offset":1266}}},{"type":"inlineCode","value":"program_account_1.owner = pubkey_a","position":{"start":{"line":50,"column":8,"offset":1266},"end":{"line":50,"column":44,"offset":1302}}}],"position":{"start":{"line":50,"column":3,"offset":1261},"end":{"line":50,"column":44,"offset":1302}}}],"position":{"start":{"line":50,"column":1,"offset":1259},"end":{"line":50,"column":44,"offset":1302}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"由於兩個參數引用的是同一個賬戶，程序立即用 ","position":{"start":{"line":51,"column":3,"offset":1306},"end":{"line":51,"column":25,"offset":1328}}},{"type":"inlineCode","value":"program_account_2.owner = pubkey_b","position":{"start":{"line":51,"column":25,"offset":1328},"end":{"line":51,"column":61,"offset":1364}}},{"type":"text","value":" 覆蓋了它","position":{"start":{"line":51,"column":61,"offset":1364},"end":{"line":51,"column":66,"offset":1369}}}],"position":{"start":{"line":51,"column":3,"offset":1306},"end":{"line":51,"column":66,"offset":1369}}}],"position":{"start":{"line":51,"column":1,"offset":1304},"end":{"line":51,"column":66,"offset":1369}}}],"position":{"start":{"line":50,"column":1,"offset":1259},"end":{"line":51,"column":66,"offset":1369}}},{"type":"paragraph","children":[{"type":"text","value":"最終結果：賬戶的所有者被設置為 ","position":{"start":{"line":53,"column":1,"offset":1373},"end":{"line":53,"column":17,"offset":1389}}},{"type":"inlineCode","value":"pubkey_b","position":{"start":{"line":53,"column":17,"offset":1389},"end":{"line":53,"column":27,"offset":1399}}},{"type":"text","value":"，完全忽略了 ","position":{"start":{"line":53,"column":27,"offset":1399},"end":{"line":53,"column":34,"offset":1406}}},{"type":"inlineCode","value":"pubkey_a","position":{"start":{"line":53,"column":34,"offset":1406},"end":{"line":53,"column":44,"offset":1416}}}],"position":{"start":{"line":53,"column":1,"offset":1373},"end":{"line":53,"column":44,"offset":1416}}},{"type":"paragraph","children":[{"type":"text","value":"這看起來可能無害，但考慮其影響。一個期望為兩個不同賬戶分配特定所有權的用戶會發現只有一個賬戶被修改，且不是他們預期的方式。在複雜的協議中，這可能導致狀態不一致、多步操作失敗，甚至財務損失。","position":{"start":{"line":55,"column":1,"offset":1420},"end":{"line":55,"column":95,"offset":1514}}}],"position":{"start":{"line":55,"column":1,"offset":1420},"end":{"line":55,"column":95,"offset":1514}}},{"type":"paragraph","children":[{"type":"text","value":"解決方案非常簡單。您只需要在繼續之前驗證帳戶是否唯一：","position":{"start":{"line":57,"column":1,"offset":1518},"end":{"line":57,"column":28,"offset":1545}}}],"position":{"start":{"line":57,"column":1,"offset":1518},"end":{"line":57,"column":28,"offset":1545}}},{"type":"code","lang":"rust","meta":null,"value":"pub fn update_account(ctx: Context<UpdateAccount>, pubkey_a: Pubkey, pubkey_b: Pubkey) -> Result<()> {\r\n    if ctx.accounts.program_account_1.key() == ctx.accounts.program_account_2.key() {\r\n        return Err(ProgramError::InvalidArgument)\r\n    }\r\n\r\n    ctx.accounts.program_account_1.owner = pubkey_a;\r\n    ctx.accounts.program_account_2.owner = pubkey_b;\r\n\r\n    Ok(())\r\n}","position":{"start":{"line":59,"column":1,"offset":1549},"end":{"line":70,"column":4,"offset":1937}},"data":{"highlightId":"code-1"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Pinocchio","position":{"start":{"line":72,"column":17,"offset":1957},"end":{"line":72,"column":33,"offset":1973}}},{"type":"mdxJsxAttribute","name":"id","value":"pinocchio","position":{"start":{"line":72,"column":34,"offset":1974},"end":{"line":72,"column":48,"offset":1988}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":72,"column":49,"offset":1989},"end":{"line":72,"column":59,"offset":1999}}}],"children":[],"position":{"start":{"line":72,"column":1,"offset":1941},"end":{"line":72,"column":62,"offset":2002}}},{"type":"paragraph","children":[{"type":"text","value":"在 Pinocchio 中，適用相同的驗證模式：","position":{"start":{"line":74,"column":1,"offset":2006},"end":{"line":74,"column":25,"offset":2030}}}],"position":{"start":{"line":74,"column":1,"offset":2006},"end":{"line":74,"column":25,"offset":2030}}},{"type":"code","lang":"rust","meta":null,"value":"if pubkey_eq(self.accounts.program_account_1.key(), self.accounts.program_account_2.key()) {\r\n    return Err(ProgramError::InvalidArgument)\r\n}","position":{"start":{"line":76,"column":1,"offset":2034},"end":{"line":80,"column":4,"offset":2190}},"data":{"highlightId":"code-2"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":81,"column":1,"offset":2192}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# 重複的可變賬戶\r\n\r\n重複的可變賬戶攻擊利用了程序接受多個相同類型的可變賬戶的特性，通過多次傳遞相同的賬戶，導致程序無意中覆蓋了自己的更改。這在單個指令中創建了一個競爭條件，後續的更改可能會悄悄地取消之前的更改。\r\n\r\n這種漏洞主要影響修改程序擁有的賬戶數據的指令，而不是像 lamport 轉賬這樣的系統操作。攻擊之所以成功，是因為 Solana 的運行時不會阻止同一賬戶多次傳遞給不同的參數；檢測和處理重複賬戶是程序的責任。\r\n\r\n危險在於指令執行的順序性。當同一賬戶被傳遞兩次時，程序會先執行第一次更改，然後立即用第二次更改覆蓋，導致賬戶處於一個意外的狀態，可能無法反映用戶的意圖或程序的邏輯。\r\n\r\n<ArticleSection name=\"Anchor\" id=\"anchor\" level=\"h2\" />\r\n\r\n考慮以下這個易受攻擊的指令，它更新了兩個程序賬戶的所有權字段：\r\n\r\n```rust\r\n#[program]\r\npub mod unsafe_update_account{\r\n    use super::*;\r\n    \r\n    //..\r\n\r\n    pub fn update_account(ctx: Context<UpdateAccount>, pubkey_a: Pubkey, pubkey_b: Pubkey) -> Result<()> {\r\n        ctx.accounts.program_account_1.owner = pubkey_a;\r\n        ctx.accounts.program_account_2.owner = pubkey_b;\r\n        \r\n        Ok(())\r\n    }\r\n\r\n    //..\r\n\r\n}\r\n\r\n#[derive(Accounts)]\r\npub struct UpdateAccount<'info> {\r\n   #[account(mut)]\r\n    pub program_account_1: Account<'info, ProgramAccount>,\r\n    #[account(mut)]\r\n    pub program_account_2: Account<'info, ProgramAccount>,\r\n}\r\n\r\n#[account]\r\npub struct ProgramAccount {\r\n    owner: Pubkey,\r\n}\r\n```\r\n\r\n這段代碼有一個關鍵缺陷：它從未驗證 `program_account_1` 和 `program_account_2` 是否是不同的賬戶。\r\n\r\n攻擊者可以通過為兩個參數傳遞相同的賬戶來利用這一點。以下是發生的情況：\r\n- 程序設置 `program_account_1.owner = pubkey_a`\r\n- 由於兩個參數引用的是同一個賬戶，程序立即用 `program_account_2.owner = pubkey_b` 覆蓋了它\r\n\r\n最終結果：賬戶的所有者被設置為 `pubkey_b`，完全忽略了 `pubkey_a`\r\n\r\n這看起來可能無害，但考慮其影響。一個期望為兩個不同賬戶分配特定所有權的用戶會發現只有一個賬戶被修改，且不是他們預期的方式。在複雜的協議中，這可能導致狀態不一致、多步操作失敗，甚至財務損失。\r\n\r\n解決方案非常簡單。您只需要在繼續之前驗證帳戶是否唯一：\r\n\r\n```rust\r\npub fn update_account(ctx: Context<UpdateAccount>, pubkey_a: Pubkey, pubkey_b: Pubkey) -> Result<()> {\r\n    if ctx.accounts.program_account_1.key() == ctx.accounts.program_account_2.key() {\r\n        return Err(ProgramError::InvalidArgument)\r\n    }\r\n\r\n    ctx.accounts.program_account_1.owner = pubkey_a;\r\n    ctx.accounts.program_account_2.owner = pubkey_b;\r\n\r\n    Ok(())\r\n}\r\n```\r\n\r\n<ArticleSection name=\"Pinocchio\" id=\"pinocchio\" level=\"h2\" />\r\n\r\n在 Pinocchio 中，適用相同的驗證模式：\r\n\r\n```rust\r\nif pubkey_eq(self.accounts.program_account_1.key(), self.accounts.program_account_2.key()) {\r\n    return Err(ProgramError::InvalidArgument)\r\n}\r\n```\r\n","highlightedCode":{"code-0":{"lang":"rust","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"#[program]"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"pub"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":" mod"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" unsafe_update_account{"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"    use"}]},{"type":"element","tagName":"span","properties":{"style":"color:#BF9EEE;font-style:italic"},"children":[{"type":"text","value":" super"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"::*"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":";"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"    "}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#7B7F8B"},"children":[{"type":"text","value":"    //.."}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"    pub"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":" fn"}]},{"type":"element","tagName":"span","properties":{"style":"color:#62E884"},"children":[{"type":"text","value":" update_account"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"(ctx"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":":"}]},{"type":"element","tagName":"span","properties":{"style":"color:#97E1F1;font-style:italic"},"children":[{"type":"text","value":" Context"}]},{"type":"element","tagName":"span","p