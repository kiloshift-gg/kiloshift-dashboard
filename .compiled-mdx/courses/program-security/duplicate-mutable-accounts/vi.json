umn":94,"offset":3042}}},{"type":"code","lang":"rust","meta":null,"value":"pub fn update_account(ctx: Context<UpdateAccount>, pubkey_a: Pubkey, pubkey_b: Pubkey) -> Result<()> {\r\n    if ctx.accounts.program_account_1.key() == ctx.accounts.program_account_2.key() {\r\n        return Err(ProgramError::InvalidArgument)\r\n    }\r\n\r\n    ctx.accounts.program_account_1.owner = pubkey_a;\r\n    ctx.accounts.program_account_2.owner = pubkey_b;\r\n\r\n    Ok(())\r\n}","position":{"start":{"line":59,"column":1,"offset":3046},"end":{"line":70,"column":4,"offset":3434}},"data":{"highlightId":"code-1"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Pinocchio","position":{"start":{"line":72,"column":17,"offset":3454},"end":{"line":72,"column":33,"offset":3470}}},{"type":"mdxJsxAttribute","name":"id","value":"pinocchio","position":{"start":{"line":72,"column":34,"offset":3471},"end":{"line":72,"column":48,"offset":3485}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":72,"column":49,"offset":3486},"end":{"line":72,"column":59,"offset":3496}}}],"children":[],"position":{"start":{"line":72,"column":1,"offset":3438},"end":{"line":72,"column":62,"offset":3499}}},{"type":"paragraph","children":[{"type":"text","value":"Trong Pinocchio, cùng một pattern validation được áp dụng:","position":{"start":{"line":74,"column":1,"offset":3503},"end":{"line":74,"column":59,"offset":3561}}}],"position":{"start":{"line":74,"column":1,"offset":3503},"end":{"line":74,"column":59,"offset":3561}}},{"type":"code","lang":"rust","meta":null,"value":"if pubkey_eq(self.accounts.program_account_1.key(), self.accounts.program_account_2.key()) {\r\n    return Err(ProgramError::InvalidArgument)\r\n}","position":{"start":{"line":76,"column":1,"offset":3565},"end":{"line":80,"column":4,"offset":3721}},"data":{"highlightId":"code-2"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":81,"column":1,"offset":3723}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Duplicate Mutable Account \r\n\r\nCác cuộc tấn công duplicate mutable account (Các tài khoản có thể thay đổi bị trùng lặp) khai thác các chương trình chấp nhận nhiều ccount có thể thay đổi cùng kiểu bằng cách truyền cùng một account hai lần, khiến chương trình vô tình ghi đè các thay đổi của chính nó. Điều này tạo ra race condition trong một instruction duy nhất nơi các tahy đổi sau có thể âm thầm hủy bỏ các thay đổi trước đó.\r\n\r\nLỗ hổng này chủ yếu ảnh hưởng đến các instruction sửa đổi dữ liệu trong các account thuộc sở hữu chương trình, không phải các thao tác hệ thống như chuyển lamport. Cuộc tấn công thành công vì runtime của Solana không ngăn chặn cùng một account được truyền nhiều lần cho các tham số khác nhau; trách nhiệm của chương trình là phát hiện và xử lý các bản sao.\r\n\r\nNguy hiểm nằm ở bản chất tuần tự của việc thực thi instruction. Khi cùng một account được truyền hai lần, chương trình thực hiện thay đổi đầu tiên, sau đó ngay lập tức ghi đè nó bằng thay đổi thứ hai, khiến cho account ở trạng thái bất ngờ có thể không phản ánh ý định của người dùng hoặc logic của chương trình.\r\n\r\n<ArticleSection name=\"Anchor\" id=\"anchor\" level=\"h2\" />\r\n\r\nXem xét instruction dễ bị tấn công này cập nhật các trường ownership trên hai program account:\r\n\r\n```rust\r\n#[program]\r\npub mod unsafe_update_account{\r\n    use super::*;\r\n    \r\n    //..\r\n\r\n    pub fn update_account(ctx: Context<UpdateAccount>, pubkey_a: Pubkey, pubkey_b: Pubkey) -> Result<()> {\r\n        ctx.accounts.program_account_1.owner = pubkey_a;\r\n        ctx.accounts.program_account_2.owner = pubkey_b;\r\n        \r\n        Ok(())\r\n    }\r\n\r\n    //..\r\n\r\n}\r\n\r\n#[derive(Accounts)]\r\npub struct UpdateAccount<'info> {\r\n   #[account(mut)]\r\n    pub program_account_1: Account<'info, ProgramAccount>,\r\n    #[account(mut)]\r\n    pub program_account_2: Account<'info, ProgramAccount>,\r\n}\r\n\r\n#[account]\r\npub struct ProgramAccount {\r\n    owner: Pubkey,\r\n}\r\n```\r\n\r\nMã này có một lỗ hổng nghiêm trọng: nó không bao giờ xác minh rằng `program_account_1` và `program_account_2` là các account khác nhau.\r\n\r\nKẻ tấn công có thể khai thác điều này bằng cách truyền cùng một account cho cả hai tham số. Đây là những gì xảy ra:\r\n- Chương trình đặt `program_account_1.owner = pubkey_a`\r\n- Vì cả hai tham số đều tham chiếu đến cùng một account, chương trình ngay lập tức ghi đè điều này bằng `program_account_2.owner = pubkey_b`\r\n\r\nKết quả cuối cùng: owner của account được đặt thành `pubkey_b`, hoàn toàn bỏ qua `pubkey_a`\r\n\r\nĐiều này có thể có vẻ vô hại, nhưng hãy xem xét các tác động. Một người dùng mong đợi cập nhật hai account khác nhau với các phân công ownership cụ thể phát hiện ra rằng chỉ một account được sửa đổi, và không theo cách họ dự định. Trong các protocol phức tạp, điều này có thể dẫn đến trạng thái không nhất quán, các thao tác nhiều bước thất bại, hoặc thậm chí tổn thất tài chính.\r\n\r\nGiải pháp rất đơn giản. Bạn chỉ cần xác minh rằng các account là duy nhất trước khi tiếp tục:\r\n\r\n```rust\r\npub fn update_account(ctx: Context<UpdateAccount>, pubkey_a: Pubkey, pubkey_b: Pubkey) -> Result<()> {\r\n    if ctx.accounts.program_account_1.key() == ctx.accounts.program_account_2.key() {\r\n        return Err(ProgramError::InvalidArgument)\r\n    }\r\n\r\n    ctx.accounts.program_account_1.owner = pubkey_a;\r\n    ctx.accounts.program_account_2.owner = pubkey_b;\r\n\r\n    Ok(())\r\n}\r\n```\r\n\r\n<ArticleSection name=\"Pinocchio\" id=\"pinocchio\" level=\"h2\" />\r\n\r\nTrong Pinocchio, cùng một pattern validation được áp dụng:\r\n\r\n```rust\r\nif pubkey_eq(self.accounts.program_account_1.key(), self.accounts.program_account_2.key()) {\r\n    return Err(ProgramError::InvalidArgument)\r\n}\r\n```\r\n","highlightedCode":{"code-0":{"lang":"rust","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"#[program]"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"pub"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":" mod"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" unsafe_update_account{"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"    use"}]},{"type":"element","tagName":"span","properties":{"style":"color:#BF9EEE;font-style:italic"},"children":[{"type":"text","value":" super"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"::*"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":";"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"    "}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#7B7F8B"},"children":[{"type":"text","value":"    //.."}]}]},{"type":"text","value":"\n"},{