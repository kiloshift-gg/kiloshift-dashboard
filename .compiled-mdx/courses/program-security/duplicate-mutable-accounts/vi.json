{"mdast":{"type":"root","children":[{"type":"mdxjsEsm","value":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";","position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":1,"column":87,"offset":86}},"data":{"estree":{"type":"Program","start":0,"end":86,"loc":{"start":{"line":1,"column":0,"offset":0},"end":{"line":1,"column":86,"offset":86}},"body":[{"type":"ImportDeclaration","start":0,"end":86,"loc":{"start":{"line":1,"column":0,"offset":0},"end":{"line":1,"column":86,"offset":86}},"specifiers":[{"type":"ImportSpecifier","start":9,"end":23,"loc":{"start":{"line":1,"column":9,"offset":9},"end":{"line":1,"column":23,"offset":23}},"imported":{"type":"Identifier","start":9,"end":23,"loc":{"start":{"line":1,"column":9,"offset":9},"end":{"line":1,"column":23,"offset":23}},"name":"ArticleSection","range":[9,23]},"local":{"type":"Identifier","start":9,"end":23,"loc":{"start":{"line":1,"column":9,"offset":9},"end":{"line":1,"column":23,"offset":23}},"name":"ArticleSection","range":[9,23]},"range":[9,23]}],"source":{"type":"Literal","start":31,"end":85,"loc":{"start":{"line":1,"column":31,"offset":31},"end":{"line":1,"column":85,"offset":85}},"value":"../../../../components/ArticleSection/ArticleSection","raw":"\"../../../../components/ArticleSection/ArticleSection\"","range":[31,85]},"range":[0,86]}],"sourceType":"module","comments":[],"range":[0,86]}}},{"type":"heading","depth":1,"children":[{"type":"text","value":"Duplicate Mutable Account","position":{"start":{"line":3,"column":3,"offset":92},"end":{"line":3,"column":28,"offset":117}}}],"position":{"start":{"line":3,"column":1,"offset":90},"end":{"line":3,"column":29,"offset":118}}},{"type":"paragraph","children":[{"type":"text","value":"Các cuộc tấn công duplicate mutable account (Các tài khoản có thể thay đổi bị trùng lặp) khai thác các chương trình chấp nhận nhiều ccount có thể thay đổi cùng kiểu bằng cách truyền cùng một account hai lần, khiến chương trình vô tình ghi