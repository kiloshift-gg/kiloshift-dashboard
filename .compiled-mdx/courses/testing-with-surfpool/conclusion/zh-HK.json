column":4,"offset":650},"end":{"line":19,"column":74,"offset":720}}}],"position":{"start":{"line":19,"column":1,"offset":647},"end":{"line":19,"column":74,"offset":720}}}],"position":{"start":{"line":17,"column":1,"offset":556},"end":{"line":19,"column":74,"offset":720}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":19,"column":74,"offset":720}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# 結論\r\n\r\n恭喜你！你已完成《使用 Surfpool 進行測試》課程。現在，你已全面掌握如何使用 Surfpool 這個強大的測試框架，將主網狀態直接引入本地開發環境，實現無縫的跨程序調用（CPI）測試。\r\n\r\n<ArticleSection name=\"你所學到的內容\" id=\"what-you-learned\" level=\"h2\" />\r\n\r\n在這個課程中，你已掌握了 Surfpool 的核心概念：\r\n- **主網模擬**：了解 Surfpool 如何即時獲取主網賬戶，簡化 CPI 測試的複雜設置\r\n- **高級控制**：包括穿越到任何時代/插槽/時間戳、暫停區塊生成以及操控系統變量\r\n- **賬戶修改**：設置 SOL 供應參數、在程序間轉移賬戶以及更新代幣賬戶數據\r\n\r\n<ArticleSection name=\"下一步\" id=\"next-steps\" level=\"h2\" />\r\n\r\n現在，你已具備使用 Surfpool 為複雜的 Solana 程序構建全面測試的能力！以下是一些建議的下一步行動：\r\n1. 應用到你的項目中：將 Surfpool 集成到你現有的 Solana 程序測試套件中。\r\n2. 加入社群：在 Discord 上與其他使用 Surfpool 的開發者交流。\r\n3. 保持更新：關注 [Surfpool 的代碼庫](https://github.com/txtx/surfpool)，了解最新功能和性能改進。","highlightedCode":{}}