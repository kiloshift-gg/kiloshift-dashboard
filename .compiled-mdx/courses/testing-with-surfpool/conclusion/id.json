,"offset":1444}}}],"position":{"start":{"line":18,"column":1,"offset":1343},"end":{"line":18,"column":102,"offset":1444}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Tetap Update: Ikuti ","position":{"start":{"line":19,"column":4,"offset":1449},"end":{"line":19,"column":24,"offset":1469}}},{"type":"link","title":null,"url":"https://github.com/txtx/surfpool","children":[{"type":"text","value":"repositori Surfpool","position":{"start":{"line":19,"column":25,"offset":1470},"end":{"line":19,"column":44,"offset":1489}}}],"position":{"start":{"line":19,"column":24,"offset":1469},"end":{"line":19,"column":79,"offset":1524}}},{"type":"text","value":" untuk fitur terbaru dan peningkatan kinerja","position":{"start":{"line":19,"column":79,"offset":1524},"end":{"line":19,"column":123,"offset":1568}}}],"position":{"start":{"line":19,"column":4,"offset":1449},"end":{"line":19,"column":123,"offset":1568}}}],"position":{"start":{"line":19,"column":1,"offset":1446},"end":{"line":19,"column":123,"offset":1568}}}],"position":{"start":{"line":17,"column":1,"offset":1232},"end":{"line":19,"column":123,"offset":1568}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":19,"column":123,"offset":1568}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Kesimpulan\r\n\r\nSelamat! Anda telah menyelesaikan kursus Testing dengan Surfpool. Sekarang Anda memiliki pemahaman komprehensif tentang cara menggunakan Surfpool, sebuah framework pengujian yang kuat yang membawa status mainnet langsung ke lingkungan pengembangan lokal Anda untuk pengujian Cross-Program Invocation yang mulus.\r\n\r\n<ArticleSection name=\"What you've learned\" id=\"what-you-learned\" level=\"h2\" />\r\n\r\nSepanjang kursus ini, Anda telah menguasai konsep-konsep penting Surfpool:\r\n- **Simulasi mainnet**: Bagaimana Surfpool mengambil akun mainnet tepat waktu, menghilangkan setup kompleks untuk pengujian CPI\r\n- **Kontrol lanjutan**: Melakukan perjalanan waktu ke epoch/slot/timestamp manapun, menghentikan produksi blok, dan memanipulasi variabel sistem\r\n- **Modifikasi akun**: Mengatur parameter pasokan SOL, mentransfer akun antar program, dan memperbarui data akun token\r\n\r\n<ArticleSection name=\"Next Steps\" id=\"next-steps\" level=\"h2\" />\r\n\r\nAnda sekarang dilengkapi untuk membangun pengujian komprehensif untuk program Solana yang kompleks menggunakan Surfpool! Berikut adalah beberapa langkah selanjutnya yang direkomendasikan:\r\n1. Terapkan ke Proyek Anda: Integrasikan Surfnet ke dalam suite pengujian program Solana Anda yang sudah ada.\r\n2. Bergabung dengan Komunitas: Terhubung dengan pengembang lain yang menggunakan Surfpool di Discord.\r\n3. Tetap Update: Ikuti [repositori Surfpool](https://github.com/txtx/surfpool) untuk fitur terbaru dan peningkatan kinerja","highlightedCode":{}}