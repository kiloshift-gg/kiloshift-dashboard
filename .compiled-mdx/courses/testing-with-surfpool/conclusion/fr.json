set":1484},"end":{"line":18,"column":103,"offset":1583}}}],"position":{"start":{"line":18,"column":4,"offset":1484},"end":{"line":18,"column":103,"offset":1583}}}],"position":{"start":{"line":18,"column":1,"offset":1481},"end":{"line":18,"column":103,"offset":1583}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Restez informé : suivez le ","position":{"start":{"line":19,"column":4,"offset":1588},"end":{"line":19,"column":31,"offset":1615}}},{"type":"link","title":null,"url":"https://github.com/txtx/surfpool","children":[{"type":"text","value":"dépôt Surfpool","position":{"start":{"line":19,"column":32,"offset":1616},"end":{"line":19,"column":46,"offset":1630}}}],"position":{"start":{"line":19,"column":31,"offset":1615},"end":{"line":19,"column":81,"offset":1665}}},{"type":"text","value":" pour les dernières fonctionnalités et améliorations de performance","position":{"start":{"line":19,"column":81,"offset":1665},"end":{"line":19,"column":148,"offset":1732}}}],"position":{"start":{"line":19,"column":4,"offset":1588},"end":{"line":19,"column":148,"offset":1732}}}],"position":{"start":{"line":19,"column":1,"offset":1585},"end":{"line":19,"column":148,"offset":1732}}}],"position":{"start":{"line":17,"column":1,"offset":1376},"end":{"line":19,"column":148,"offset":1732}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":19,"column":148,"offset":1732}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Conclusion\r\n\r\nFélicitations ! Vous avez terminé le cours sur les tests avec Surfpool. Vous avez maintenant une compréhension complète de l'utilisation de Surfpool, un framework de test puissant qui intègre l'état du réseau principal directement dans votre environnement de développement local pour des tests d'invocation inter-programmes (CPI) fluides.\r\n\r\n<ArticleSection name=\"Ce que vous avez appris\" id=\"what-you-learned\" level=\"h2\" />\r\n\r\nTout au long de ce cours, vous avez maîtrisé les concepts essentiels de Surfpool :\r\n- **Simulation du réseau principal** : comment Surfpool récupère les comptes du réseau principal juste à temps, éliminant ainsi la configuration complexe pour les tests CPI\r\n- **Contrôle avancé** : voyager dans le temps vers n'importe quelle époque/slot/horodatage, mettre en pause la production de blocs et manipuler les variables système\r\n- **Modification de compte** : définir les paramètres d'approvisionnement en SOL, transférer des comptes entre programmes et mettre à jour les données des comptes de jetons\r\n\r\n<ArticleSection name=\"Prochaines étapes\" id=\"next-steps\" level=\"h2\" />\r\n\r\nVous êtes maintenant équipé pour créer des tests complets pour des programmes Solana complexes en utilisant Surfpool ! Voici quelques étapes suivantes recommandées :\r\n1. Appliquez à vos projets : intégrez Surfnet dans vos suites de tests de programmes Solana existantes.\r\n2. Rejoignez la communauté : connectez-vous avec d'autres développeurs utilisant Surfpool sur Discord.\r\n3. Restez informé : suivez le [dépôt Surfpool](https://github.com/txtx/surfpool) pour les dernières fonctionnalités et améliorations de performance","highlightedCode":{}}