18,"column":1,"offset":1305},"end":{"line":18,"column":95,"offset":1399}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Cập nhật thường xuyên: Theo dõi ","position":{"start":{"line":19,"column":4,"offset":1404},"end":{"line":19,"column":36,"offset":1436}}},{"type":"link","title":null,"url":"https://github.com/txtx/surfpool","children":[{"type":"text","value":"kho lưu trữ Surfpool","position":{"start":{"line":19,"column":37,"offset":1437},"end":{"line":19,"column":57,"offset":1457}}}],"position":{"start":{"line":19,"column":36,"offset":1436},"end":{"line":19,"column":92,"offset":1492}}},{"type":"text","value":" để biết các tính năng mới nhất và cải tiến hiệu suất","position":{"start":{"line":19,"column":92,"offset":1492},"end":{"line":19,"column":145,"offset":1545}}}],"position":{"start":{"line":19,"column":4,"offset":1404},"end":{"line":19,"column":145,"offset":1545}}}],"position":{"start":{"line":19,"column":1,"offset":1401},"end":{"line":19,"column":145,"offset":1545}}}],"position":{"start":{"line":17,"column":1,"offset":1204},"end":{"line":19,"column":145,"offset":1545}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":19,"column":145,"offset":1545}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Kết luận\r\n\r\nXin chúc mừng! Bạn đã hoàn thành khóa học Kiểm thử với Surfpool. Giờ đây bạn đã có hiểu biết toàn diện về cách sử dụng Surfpool, một framework kiểm thử mạnh mẽ mang trạng thái mainnet trực tiếp vào môi trường phát triển cục bộ của bạn để kiểm thử Cross-Program Invocation một cách liền mạch.\r\n\r\n<ArticleSection name=\"Những gì bạn đã học\" id=\"what-you-learned\" level=\"h2\" />\r\n\r\nTrong suốt khóa học này, bạn đã nắm vững các khái niệm thiết yếu của Surfpool:\r\n- **Mô phỏng mainnet**: Cách Surfpool lấy các tài khoản mainnet đúng lúc cần thiết, loại bỏ việc thiết lập phức tạp cho kiểm thử CPI\r\n- **Kiểm soát nâng cao**: Di chuyển thời gian đến bất kỳ epoch/slot/timestamp nào, tạm dừng tạo khối, và thao tác các biến hệ thống\r\n- **Sửa đổi tài khoản**: Thiết lập tham số cung cấp SOL, chuyển tài khoản giữa các chương trình, và cập nhật dữ liệu tài khoản token\r\n\r\n<ArticleSection name=\"Các bước tiếp theo\" id=\"next-steps\" level=\"h2\" />\r\n\r\nBạn đã được trang bị để xây dựng các bài kiểm thử toàn diện cho các chương trình Solana phức tạp bằng Surfpool! Dưới đây là một số bước tiếp theo được khuyến nghị:\r\n1. Áp dụng vào dự án của bạn: Tích hợp Surfnet vào bộ kiểm thử chương trình Solana hiện có của bạn.\r\n2. Tham gia cộng đồng: Kết nối với các nhà phát triển khác đang sử dụng Surfpool trên Discord.\r\n3. Cập nhật thường xuyên: Theo dõi [kho lưu trữ Surfpool](https://github.com/txtx/surfpool) để biết các tính năng mới nhất và cải tiến hiệu suất","highlightedCode":{}}