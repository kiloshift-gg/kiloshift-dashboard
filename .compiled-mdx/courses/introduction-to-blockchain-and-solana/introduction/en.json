{"mdast":{"type":"root","children":[{"type":"mdxjsEsm","value":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";","position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":1,"column":87,"offset":86}},"data":{"estree":{"type":"Program","start":0,"end":86,"loc":{"start":{"line":1,"column":0,"offset":0},"end":{"line":1,"column":86,"offset":86}},"body":[{"type":"ImportDeclaration","start":0,"end":86,"loc":{"start":{"line":1,"column":0,"offset":0},"end":{"line":1,"column":86,"offset":86}},"specifiers":[{"type":"ImportSpecifier","start":9,"end":23,"loc":{"start":{"line":1,"column":9,"offset":9},"end":{"line":1,"column":23,"offset":23}},"imported":{"type":"Identifier","start":9,"end":23,"loc":{"start":{"line":1,"column":9,"offset":9},"end":{"line":1,"column":23,"offset":23}},"name":"ArticleSection","range":[9,23]},"local":{"type":"Identifier","start":9,"end":23,"loc":{"start":{"line":1,"column":9,"offset":9},"end":{"line":1,"column":23,"offset":23}},"name":"ArticleSection","range":[9,23]},"range":[9,23]}],"source":{"type":"Literal","start":31,"end":85,"loc":{"start":{"line":1,"column":31,"offset":31},"end":{"line":1,"column":85,"offset":85}},"value":"../../../../components/ArticleSection/ArticleSection","raw":"\"../../../../components/ArticleSection/ArticleSection\"","range":[31,85]},"range":[0,86]}],"sourceType":"module","comments":[],"range":[0,86]}}},{"type":"heading","depth":1,"children":[{"type":"text","value":"Introduction to Blockchain","position":{"start":{"line":3,"column":3,"offset":92},"end":{"line":3,"column":29,"offset":118}}}],"position":{"start":{"line":3,"column":1,"offset":90},"end":{"line":3,"column":29,"offset":118}}},{"type":"paragraph","children":[{"type":"image","title":null,"url":"/graphics/course-banners/introduction-to-blockchain-and-solana.png","alt":"Introduction to Blockchain","position":{"start":{"line":5,"column":1,"offset":122},"end":{"line":5,"column":98,"offset":219}}}],"position":{"start":{"line":5,"column":1,"offset":122},"end":{"line":5,"column":98,"offset":219}}},{"type":"paragraph","children":[{"type":"text","value":"You've probably heard blockchain described as \"digital money\" or \"the future of the internet.\" These explanations miss the point entirely.","position":{"start":{"line":7,"column":1,"offset":223},"end":{"line":7,"column":139,"offset":361}}}],"position":{"start":{"line":7,"column":1,"offset":223},"end":{"line":7,"column":139,"offset":361}}},{"type":"paragraph","children":[{"type":"text","value":"Blockchains are distributed systems: networks of computers that must agree on shared data without trusting each other. This course teaches blockchain from first principles: the distributed systems problems it solves, how it solves them, and why the tradeoffs matter.","position":{"start":{"line":9,"column":1,"offset":365},"end":{"line":9,"column":267,"offset":631}}}],"position":{"start":{"line":9,"column":1,"offset":365},"end":{"line":9,"column":267,"offset":631}}},{"type":"paragraph","children":[{"type":"text","value":"Let's start by understanding why building distributed systems is one of the hardest problems in computer science.","position":{"start":{"line":11,"column":1,"offset":635},"end":{"line":11,"column":114,"offset":748}}}],"position":{"start":{"line":11,"column":1,"offset":635},"end":{"line":11,"column":114,"offset":748}}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Distributed Systems","position":{"start":{"line":13,"column":17,"offset":768},"end":{"line":13,"column":43,"offset":794}}},{"type":"mdxJsxAttribute","name":"id","value":"distributed-systems","position":{"start":{"line":13,"column":44,"offset":795},"end":{"line":13,"column":68,"offset":819}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":13,"column":69,"offset":820},"end":{"line":13,"column":79,"offset":830}}}],"children":[],"position":{"start":{"line":13,"column":1,"offset":752},"end":{"line":13,"column":82,"offset":833}}},{"type":"paragraph","children":[{"type":"text","value":"Most people think scaling from one computer to many is just \"more of the same.\" That's like thinking coordinating one person is the same as coordinating a thousand people across different time zones who might not always be reachable.","position":{"start":{"line":15,"column":1,"offset":837},"end":{"line":15,"column":234,"offset":1070}}}],"position":{"start":{"line":15,"column":1,"offset":837},"end":{"line":15,"column":234,"offset":1070}}},{"type":"paragraph","children":[{"type":"text","value":"When you write code on a single computer, you live in a predictable world:","position":{"start":{"line":17,"column":1,"offset":1074},"end":{"line":17,"column":75,"offset":1148}}}],"position":{"start":{"line":17,"column":1,"offset":1074},"end":{"line":17,"column":75,"offset":1148}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Operations either succeed or fail immediately","position":{"start":{"line":18,"column":3,"offset":1152},"end":{"line":18,"column":48,"offset":1197}}}],"position":{"start":{"line":18,"column":3,"offset":1152},"end":{"line":18,"column":48,"offset":1197}}}],"position":{"start":{"line":18,"column":1,"offset":1150},"end":{"line":18,"column":48,"offset":1197}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Data doesn't mysteriously change between reads","position":{"start":{"line":19,"column":3,"offset":1201},"end":{"line":19,"column":49,"offset":1247}}}],"position":{"start":{"line":19,"column":3,"offset":1201},"end":{"line":19,"column":49,"offset":1247}}}],"position":{"start":{"line":19,"column":1,"offset":1199},"end":{"line":19,"column":49,"offset":1247}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Time moves forward consistently","position":{"start":{"line":20,"column":3,"offset":1251},"end":{"line":20,"column":34,"offset":1282}}}],"position":{"start":{"line":20,"column":3,"offset":1251},"end":{"line":20,"column":34,"offset":1282}}}],"position":{"start":{"line":20,"column":1,"offset":1249},"end":{"line":20,"column":34,"offset":1282}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"When you save something, it's actually saved","position":{"start":{"line":21,"column":3,"offset":1286},"end":{"line":21,"column":47,"offset":1330}}}],"position":{"start":{"line":21,"column":3,"offset":1286},"end":{"line":21,"column":47,"offset":1330}}}],"position":{"start":{"line":21,"column":1,"offset":1284},"end":{"line":21,"column":47,"offset":1330}}}],"position":{"start":{"line":18,"column":1,"offset":1150},"end":{"line":21,"column":47,"offset":1330}}},{"type":"paragraph","children":[{"type":"text","value":"Let's take a simple banking system. Transferring $100 from Alice to Bob in that case is extremely easy:","position":{"start":{"line":23,"column":1,"offset":1334},"end":{"line":23,"column":104,"offset":1437}}}],"position":{"start":{"line":23,"column":1,"offset":1334},"end":{"line":23,"column":104,"offset":1437}}},{"type":"code","lang":"python","meta":null,"value":"def transfer(from_account, to_account, amount):\r\n    if from_account.balance >= amount:\r\n        from_account.balance -= amount\r\n        to_account.balance += amount\r\n        return \"Transfer successful\"\r\n    return \"Insufficient funds\"","position":{"start":{"line":25,"column":1,"offset":1441},"end":{"line":32,"column":4,"offset":1693}},"data":{"highlightId":"code-0"}},{"type":"paragraph","children":[{"type":"text","value":"This works perfectly... until you need to scale.","position":{"start":{"line":34,"column":1,"offset":1697},"end":{"line":34,"column":49,"offset":1745}}}],"position":{"start":{"line":34,"column":1,"offset":1697},"end":{"line":34,"column":49,"offset":1745}}},{"type":"paragraph","children":[{"type":"text","value":"Your bank grows beyond what one computer can handle, so you now split accounts evenly across different databases:","position":{"start":{"line":36,"column":1,"offset":1749},"end":{"line":36,"column":114,"offset":1862}}}],"position":{"start":{"line":36,"column":1,"offset":1749},"end":{"line":36,"column":114,"offset":1862}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Server A: Accounts 1 to 1,000,000","position":{"start":{"line":37,"column":3,"offset":1866},"end":{"line":37,"column":36,"offset":1899}}}],"position":{"start":{"line":37,"column":3,"offset":1866},"end":{"line":37,"column":36,"offset":1899}}}],"position":{"start":{"line":37,"column":1,"offset":1864},"end":{"line":37,"column":36,"offset":1899}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Server B: Accounts 1,000,001 to 2,000,000","position":{"start":{"line":38,"column":3,"offset":1903},"end":{"line":38,"column":44,"offset":1944}}}],"position":{"start":{"line":38,"column":3,"offset":1903},"end":{"line":38,"column":44,"offset":1944}}}],"position":{"start":{"line":38,"column":1,"offset":1901},"end":{"line":38,"column":44,"offset":1944}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Server C: Accounts 2,000,001 to 3,000,000","position":{"start":{"line":39,"column":3,"offset":1948},"end":{"line":39,"column":44,"offset":1989}}}],"position":{"start":{"line":39,"column":3,"offset":1948},"end":{"line":39,"column":44,"offset":1989}}}],"position":{"start":{"line":39,"column":1,"offset":1946},"end":{"line":39,"column":44,"offset":1989}}}],"position":{"start":{"line":37,"column":1,"offset":1864},"end":{"line":39,"column":44,"offset":1989}}},{"type":"paragraph","children":[{"type":"text","value":"Now Alice (on Server A) wants to send $100 to Bob (on Server B). That simple transfer becomes:","position":{"start":{"line":41,"column":1,"offset":1993},"end":{"line":41,"column":95,"offset":2087}}}],"position":{"start":{"line":41,"column":1,"offset":1993},"end":{"line":41,"column":95,"offset":2087}}},{"type":"code","lang":"python","meta":null,"value":"def distributed_transfer(alice_server, bob_server, amount):\r\n    # Check Alice's balance on Server A\r\n    if alice_server.get_balance(\"alice\") >= amount:\r\n        alice_server.deduct(\"alice\", amount)    # Step 1\r\n        bob_server.add(\"bob\", amount)           # Step 2\r\n        return \"Transfer successful\"\r\n    return \"Insufficient funds\"","position":{"start":{"line":43,"column":1,"offset":2091},"end":{"line":51,"column":4,"offset":2447}},"data":{"highlightId":"code-1"}},{"type":"paragraph","children":[{"type":"text","value":"Still seems straightforward? Here's what can go wrong:","position":{"start":{"line":52,"column":1,"offset":2449},"end":{"line":52,"column":55,"offset":2503}}}],"position":{"start":{"line":52,"column":1,"offset":2449},"end":{"line":52,"column":55,"offset":2503}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Network Partition: The connection between servers fails right after Step 1 but before Step 2. Alice's $100 vanishes into the digital void.","position":{"start":{"line":53,"column":3,"offset":2507},"end":{"line":53,"column":141,"offset":2645}}}],"position":{"start":{"line":53,"column":3,"offset":2507},"end":{"line":53,"column":141,"offset":2645}}}],"position":{"start":{"line":53,"column":1,"offset":2505},"end":{"line":53,"column":141,"offset":2645}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Server Crash: Server B crashes after receiving the \"add money\" command but before confirming it processed. Did Bob get the money? Nobody knows.","position":{"start":{"line":54,"column":3,"offset":2649},"end":{"line":54,"column":146,"offset":2792}}}],"position":{"start":{"line":54,"column":3,"offset":2649},"end":{"line":54,"column":146,"offset":2792}}}],"position":{"start":{"line":54,"column":1,"offset":2647},"end":{"line":54,"column":146,"offset":2792}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Race Conditions: Two transfers from Alice happen simultaneously. Both check her $100 balance, see that she has sufficient funds, and both proceed. Alice has now spent $100 that she did not have.","position":{"start":{"line":55,"column":3,"offset":2796},"end":{"line":55,"column":197,"offset":2990}}}],"position":{"start":{"line":55,"column":3,"offset":2796},"end":{"line":55,"column":197,"offset":2990}}}],"position":{"start":{"line":55,"column":1,"offset":2794},"end":{"line":55,"column":197,"offset":2990}}}],"position":{"start":{"line":53,"column":1,"offset":2505},"end":{"line":55,"column":197,"offset":2990}}},{"type":"heading","depth":3,"children":[{"type":"text","value":"CAP Theorem","position":{"start":{"line":57,"column":5,"offset":2998},"end":{"line":57,"column":16,"offset":3009}}}],"position":{"start":{"line":57,"column":1,"offset":2994},"end":{"line":57,"column":16,"offset":3009}}},{"type":"paragraph","children":[{"type":"text","value":"In 1999, computer scientist Eric Brewer formulated the CAP Theorem, which states that any distributed system can guarantee at most two of these three properties:","position":{"start":{"line":59,"column":1,"offset":3013},"end":{"line":59,"column":162,"offset":3174}}}],"position":{"start":{"line":59,"column":1,"offset":3013},"end":{"line":59,"column":162,"offset":3174}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Consistency (C): All servers always show the same data. When Alice's balance changes on Server A, every other server immediately reflects this.","position":{"start":{"line":60,"column":3,"offset":3178},"end":{"line":60,"column":146,"offset":3321}}}],"position":{"start":{"line":60,"column":3,"offset":3178},"end":{"line":60,"column":146,"offset":3321}}}],"position":{"start":{"line":60,"column":1,"offset":3176},"end":{"line":60,"column":146,"offset":3321}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Availability (A): The system keeps working even when servers crash. If Server A goes down, users can still access accounts through Servers B and C.","position":{"start":{"line":61,"column":3,"offset":3325},"end":{"line":61,"column":150,"offset":3472}}}],"position":{"start":{"line":61,"column":3,"offset":3325},"end":{"line":61,"column":150,"offset":3472}}}],"position":{"start":{"line":61,"column":1,"offset":3323},"end":{"line":61,"column":150,"offset":3472}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Partition Tolerance (P): The system survives network failures that split servers into isolated groups.","position":{"start":{"line":62,"column":3,"offset":3476},"end":{"line":62,"column":105,"offset":3578}}}],"position":{"start":{"line":62,"column":3,"offset":3476},"end":{"line":62,"column":105,"offset":3578}}}],"position":{"start":{"line":62,"column":1,"offset":3474},"end":{"line":62,"column":105,"offset":3578}}}],"position":{"start":{"line":60,"column":1,"offset":3176},"end":{"line":62,"column":105,"offset":3578}}},{"type":"paragraph","children":[{"type":"text","value":"We must guarantee partition tolerance since network partitions are inevitable: cables get cut, routers fail, data centers lose power. This leaves us choosing between Consistency OR Availability.","position":{"start":{"line":64,"column":1,"offset":3582},"end":{"line":64,"column":195,"offset":3776}}}],"position":{"start":{"line":64,"column":1,"offset":3582},"end":{"line":64,"column":195,"offset":3776}}},{"type":"paragraph","children":[{"type":"text","value":"Traditional banking systems usually choose Consistency + Partition Tolerance (CP Systems). They'd rather shut down than show incorrect account balances.","position":{"start":{"line":66,"column":1,"offset":3780},"end":{"line":66,"column":153,"offset":3932}}}],"position":{"start":{"line":66,"column":1,"offset":3780},"end":{"line":66,"column":153,"offset":3932}}},{"type":"paragraph","children":[{"type":"text","value":"Social media platforms often choose Availability + Partition Tolerance (AP Systems). They'd rather let you post (even if friends can't see it immediately) than prevent you from posting at all.","position":{"start":{"line":68,"column":1,"offset":3936},"end":{"line":68,"column":193,"offset":4128}}}],"position":{"start":{"line":68,"column":1,"offset":3936},"end":{"line":68,"column":193,"offset":4128}}},{"type":"heading","depth":3,"children":[{"type":"text","value":"The Byzantine Generals Problem","position":{"start":{"line":70,"column":5,"offset":4136},"end":{"line":70,"column":35,"offset":4166}}}],"position":{"start":{"line":70,"column":1,"offset":4132},"end":{"line":70,"column":35,"offset":4166}}},{"type":"paragraph","children":[{"type":"text","value":"In addition to the CAP Theorem, most distributed systems assume participants are honest: they might fail or disconnect, but they won't actively deceive each other. This assumption breaks down when participants can be malicious.","position":{"start":{"line":72,"column":1,"offset":4170},"end":{"line":72,"column":228,"offset":4397}}}],"position":{"start":{"line":72,"column":1,"offset":4170},"end":{"line":72,"column":228,"offset":4397}}},{"type":"paragraph","children":[{"type":"text","value":"The Byzantine Generals Problem, formulated by computer scientists in 1982, illustrates this challenge:","position":{"start":{"line":74,"column":1,"offset":4401},"end":{"line":74,"column":103,"offset":4503}}}],"position":{"start":{"line":74,"column":1,"offset":4401},"end":{"line":74,"column":103,"offset":4503}}},{"type":"paragraph","children":[{"type":"text","value":"You're a Byzantine general planning to attack a fortified city. You have several allied generals positioned around the city, each commanding their own army. To succeed, you must coordinate a simultaneous attack. If some attack while others retreat, the attacking forces will be slaughtered.","position":{"start":{"line":76,"column":1,"offset":4507},"end":{"line":76,"column":291,"offset":4797}}}],"position":{"start":{"line":76,"column":1,"offset":4507},"end":{"line":76,"column":291,"offset":4797}}},{"type":"paragraph","children":[{"type":"text","value":"You communicate only through messengers, and some generals might be traitors who want the attack to fail. Traitors can:","position":{"start":{"line":78,"column":1,"offset":4801},"end":{"line":78,"column":120,"offset":4920}}}],"position":{"start":{"line":78,"column":1,"offset":4801},"end":{"line":78,"column":120,"offset":4920}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Send \"attack\" messages to some generals and \"retreat\" to others","position":{"start":{"line":79,"column":3,"offset":4924},"end":{"line":79,"column":66,"offset":4987}}}],"position":{"start":{"line":79,"column":3,"offset":4924},"end":{"line":79,"column":66,"offset":4987}}}],"position":{"start":{"line":79,"column":1,"offset":4922},"end":{"line":79,"column":66,"offset":4987}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Modify messages from loyal generals as they pass through","position":{"start":{"line":80,"column":3,"offset":4991},"end":{"line":80,"column":59,"offset":5047}}}],"position":{"start":{"line":80,"column":3,"offset":4991},"end":{"line":80,"column":59,"offset":5047}}}],"position":{"start":{"line":80,"column":1,"offset":4989},"end":{"line":80,"column":59,"offset":5047}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Coordinate with other traitors to maximize confusion","position":{"start":{"line":81,"column":3,"offset":5051},"end":{"line":81,"column":55,"offset":5103}}}],"position":{"start":{"line":81,"column":3,"offset":5051},"end":{"line":81,"column":55,"offset":5103}}}],"position":{"start":{"line":81,"column":1,"offset":5049},"end":{"line":81,"column":55,"offset":5103}}}],"position":{"start":{"line":79,"column":1,"offset":4922},"end":{"line":81,"column":55,"offset":5103}}},{"type":"paragraph","children":[{"type":"text","value":"How do you reach consensus on \"attack\" or \"retreat\" when you can't distinguish loyal generals from traitors, and you can't trust the communication channels?","position":{"start":{"line":83,"column":1,"offset":5107},"end":{"line":83,"column":157,"offset":5263}}}],"position":{"start":{"line":83,"column":1,"offset":5107},"end":{"line":83,"column":157,"offset":5263}}},{"type":"paragraph","children":[{"type":"text","value":"This seemed impossible. For decades, computer scientists believed you couldn't build a system that was simultaneously:","position":{"start":{"line":85,"column":1,"offset":5267},"end":{"line":85,"column":119,"offset":5385}}}],"position":{"start":{"line":85,"column":1,"offset":5267},"end":{"line":85,"column":119,"offset":5385}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Byzantine fault tolerant (works despite malicious participants)","position":{"start":{"line":86,"column":3,"offset":5389},"end":{"line":86,"column":66,"offset":5452}}}],"position":{"start":{"line":86,"column":3,"offset":5389},"end":{"line":86,"column":66,"offset":5452}}}],"position":{"start":{"line":86,"column":1,"offset":5387},"end":{"line":86,"column":66,"offset":5452}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Permissionless (anyone can join without approval)","position":{"start":{"line":87,"column":3,"offset":5456},"end":{"line":87,"column":52,"offset":5505}}}],"position":{"start":{"line":87,"column":3,"offset":5456},"end":{"line":87,"column":52,"offset":5505}}}],"position":{"start":{"line":87,"column":1,"offset":5454},"end":{"line":87,"column":52,"offset":5505}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Decentralized (no central authority)","position":{"start":{"line":88,"column":3,"offset":5509},"end":{"line":88,"column":39,"offset":5545}}}],"position":{"start":{"line":88,"column":3,"offset":5509},"end":{"line":88,"column":39,"offset":5545}}}],"position":{"start":{"line":88,"column":1,"offset":5507},"end":{"line":88,"column":39,"offset":5545}}}],"position":{"start":{"line":86,"column":1,"offset":5387},"end":{"line":88,"column":39,"offset":5545}}},{"type":"paragraph","children":[{"type":"text","value":"Then in 2008, someone calling themselves Satoshi Nakamoto proved them wrong.","position":{"start":{"line":90,"column":1,"offset":5549},"end":{"line":90,"column":77,"offset":5625}}}],"position":{"start":{"line":90,"column":1,"offset":5549},"end":{"line":90,"column":77,"offset":5625}}},{"type":"heading","depth":3,"children":[{"type":"text","value":"Bitcoin: the first blockchain","position":{"start":{"line":92,"column":5,"offset":5633},"end":{"line":92,"column":34,"offset":5662}}}],"position":{"start":{"line":92,"column":1,"offset":5629},"end":{"line":92,"column":34,"offset":5662}}},{"type":"paragraph","children":[{"type":"text","value":"Bitcoin was the first practical implementation of blockchain technology. While the individual components existed before (cryptographic hashing, digital signatures, peer-to-peer networks), Satoshi was the first to combine them to solve the double-spending problem for digital currency.","position":{"start":{"line":94,"column":1,"offset":5666},"end":{"line":94,"column":285,"offset":5950}}}],"position":{"start":{"line":94,"column":1,"offset":5666},"end":{"line":94,"column":285,"offset":5950}}},{"type":"paragraph","children":[{"type":"text","value":"Blockchain, or a \"chain of blocks\" as it was called in the original Bitcoin ","position":{"start":{"line":96,"column":1,"offset":5954},"end":{"line":96,"column":77,"offset":6030}}},{"type":"link","title":null,"url":"https://bitcoin.org/bitcoin.pdf","children":[{"type":"text","value":"whitepaper","position":{"start":{"line":96,"column":78,"offset":6031},"end":{"line":96,"column":88,"offset":6041}}}],"position":{"start":{"line":96,"column":77,"offset":6030},"end":{"line":96,"column":122,"offset":6075}}},{"type":"text","value":", finally created a system that was distributed, Byzantine fault tolerant, and permissionless simultaneously.","position":{"start":{"line":96,"column":122,"offset":6075},"end":{"line":96,"column":231,"offset":6184}}}],"position":{"start":{"line":96,"column":1,"offset":5954},"end":{"line":96,"column":231,"offset":6184}}},{"type":"paragraph","children":[{"type":"text","value":"The breakthrough wasn't trying to identify who to trust; it was making lying more economically expensive than telling the truth. Proof of Work accomplishes this by requiring participants to spend real computational energy to propose changes. An attacker would need to spend more on electricity than they could gain from an attack.","position":{"start":{"line":98,"column":1,"offset":6188},"end":{"line":98,"column":331,"offset":6518}}}],"position":{"start":{"line":98,"column":1,"offset":6188},"end":{"line":98,"column":331,"offset":6518}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":98,"column":331,"offset":6518}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Introduction to Blockchain\r\n\r\n![Introduction to Blockchain](/graphics/course-banners/introduction-to-blockchain-and-solana.png)\r\n\r\nYou've probably heard blockchain described as \"digital money\" or \"the future of the internet.\" These explanations miss the point entirely.\r\n\r\nBlockchains are distributed systems: networks of computers that must agree on shared data without trusting each other. This course teaches blockchain from first principles: the distributed systems problems it solves, how it solves them, and why the tradeoffs matter.\r\n\r\nLet's start by understanding why building distributed systems is one of the hardest problems in computer science.\r\n\r\n<ArticleSection name=\"Distributed Systems\" id=\"distributed-systems\" level=\"h2\" />\r\n\r\nMost people think scaling from one computer to many is just \"more of the same.\" That's like thinking coordinating one person is the same as coordinating a thousand people across different time zones who might not always be reachable.\r\n\r\nWhen you write code on a single computer, you live in a predictable world:\r\n- Operations either succeed or fail immediately\r\n- Data doesn't mysteriously change between reads\r\n- Time moves forward consistently\r\n- When you save something, it's actually saved\r\n\r\nLet's take a simple banking system. Transferring $100 from Alice to Bob in that case is extremely easy:\r\n\r\n```python\r\ndef transfer(from_account, to_account, amount):\r\n    if from_account.balance >= amount:\r\n        from_account.balance -= amount\r\n        to_account.balance += amount\r\n        return \"Transfer successful\"\r\n    return \"Insufficient funds\"\r\n```\r\n\r\nThis works perfectly... until you need to scale.\r\n\r\nYour bank grows beyond what one computer can handle, so you now split accounts evenly across different databases:\r\n- Server A: Accounts 1 to 1,000,000\r\n- Server B: Accounts 1,000,001 to 2,000,000\r\n- Server C: Accounts 2,000,001 to 3,000,000\r\n\r\nNow Alice (on Server A) wants to send $100 to Bob (on Server B). That simple transfer becomes:\r\n\r\n```python\r\ndef distributed_transfer(alice_server, bob_server, amount):\r\n    # Check Alice's balance on Server A\r\n    if alice_server.get_balance(\"alice\") >= amount:\r\n        alice_server.deduct(\"alice\", amount)    # Step 1\r\n        bob_server.add(\"bob\", amount)           # Step 2\r\n        return \"Transfer successful\"\r\n    return \"Insufficient funds\"\r\n```\r\nStill seems straightforward? Here's what can go wrong:\r\n- Network Partition: The connection between servers fails right after Step 1 but before Step 2. Alice's $100 vanishes into the digital void.\r\n- Server Crash: Server B crashes after receiving the \"add money\" command but before confirming it processed. Did Bob get the money? Nobody knows.\r\n- Race Conditions: Two transfers from Alice happen simultaneously. Both check her $100 balance, see that she has sufficient funds, and both proceed. Alice has now spent $100 that she did not have.\r\n\r\n### CAP Theorem\r\n\r\nIn 1999, computer scientist Eric Brewer formulated the CAP Theorem, which states that any distributed system can guarantee at most two of these three properties:\r\n- Consistency (C): All servers always show the same data. When Alice's balance changes on Server A, every other server immediately reflects this.\r\n- Availability (A): The system keeps working even when servers crash. If Server A goes down, users can still access accounts through Servers B and C.\r\n- Partition Tolerance (P): The system survives network failures that split servers into isolated groups.\r\n\r\nWe must guarantee partition tolerance since network partitions are inevitable: cables get cut, routers fail, data centers lose power. This leaves us choosing between Consistency OR Availability.\r\n\r\nTraditional banking systems usually choose Consistency + Partition Tolerance (CP Systems). They'd rather shut down than show incorrect account balances.\r\n\r\nSocial media platforms often choose Availability + Partition Tolerance (AP Systems). They'd rather let you post (even if friends can't see it immediately) than prevent you from posting at all.\r\n\r\n### The Byzantine Generals Problem\r\n\r\nIn addition to the CAP Theorem, most distributed systems assume participants are honest: they might fail or disconnect, but they won't actively deceive each other. This assumption breaks down when participants can be malicious.\r\n\r\nThe Byzantine Generals Problem, formulated by computer scientists in 1982, illustrates this challenge:\r\n\r\nYou're a Byzantine general planning to attack a fortified city. You have several allied generals positioned around the city, each commanding their own army. To succeed, you must coordinate a simultaneous attack. If some attack while others retreat, the attacking forces will be slaughtered.\r\n\r\nYou communicate only through messengers, and some generals might be traitors who want the attack to fail. Traitors can:\r\n- Send \"attack\" messages to some generals and \"retreat\" to others\r\n- Modify messages from loyal generals as they pass through\r\n- Coordinate with other traitors to maximize confusion\r\n\r\nHow do you reach consensus on \"attack\" or \"retreat\" when you can't distinguish loyal generals from traitors, and you can't trust the communication channels?\r\n\r\nThis seemed impossible. For decades, computer scientists believed you couldn't build a system that was simultaneously:\r\n- Byzantine fault tolerant (works despite malicious participants)\r\n- Permissionless (anyone can join without approval)\r\n- Decentralized (no central authority)\r\n\r\nThen in 2008, someone calling themselves Satoshi Nakamoto proved them wrong.\r\n\r\n### Bitcoin: the first blockchain\r\n\r\nBitcoin was the first practical implementation of blockchain technology. While the individual components existed before (cryptographic hashing, digital signatures, peer-to-peer networks), Satoshi was the first to combine them to solve the double-spending problem for digital currency.\r\n\r\nBlockchain, or a \"chain of blocks\" as it was called in the original Bitcoin [whitepaper](https://bitcoin.org/bitcoin.pdf), finally created a system that was distributed, Byzantine fault tolerant, and permissionless simultaneously.\r\n\r\nThe breakthrough wasn't trying to identify who to trust; it was making lying more economically expensive than telling the truth. Proof of Work accomplishes this by requiring participants to spend real computational energy to propose changes. An attacker would need to spend more on electricity than they could gain from an attack.","highlightedCode":{"code-0":{"lang":"python","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"def"}]},{"type":"element","tagName":"span","properties":{"style":"color:#62E884"},"children":[{"type":"text","value":" transfer"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"("}]},{"type":"element","tagName":"span","properties":{"style":"color:#FFB86C;font-style:italic"},"children":[{"type":"text","value":"from_account"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":", "}]},{"type":"element","tagName":"span","properties":{"style":"color:#FFB86C;font-style:italic"},"children":[{"type":"text","value":"to_account"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":", "}]},{"type":"element","tagName":"span","properties":{"style":"color:#FFB86C;font-style:italic"},"children":[{"type":"text","value":"amount"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"):"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"    if"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" from_account.balance "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":">="}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" amount:"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"        from_account.balance "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"-="}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" amount"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"        to_account.balance "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"+="}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" amount"}]}]},{"type":"text","value":"\n"},{