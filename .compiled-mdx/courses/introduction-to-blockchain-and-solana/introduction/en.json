s":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"        bob_server.add("}]},{"type":"element","tagName":"span","properties":{"style":"color:#DEE492"},"children":[{"type":"text","value":"\""}]},{"type":"element","tagName":"span","properties":{"style":"color:#E7EE98"},"children":[{"type":"text","value":"bob\", amount)           # Step 2"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"        return"}]},{"type":"element","tagName":"span","properties":{"style":"color:#DEE492"},"children":[{"type":"text","value":" \""}]},{"type":"element","tagName":"span","properties":{"style":"color:#E7EE98"},"children":[{"type":"text","value":"Transfer successful\""}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"    return"}]},{"type":"element","tagName":"span","properties":{"style":"color:#DEE492"},"children":[{"type":"text","value":" \""}]},{"type":"element","tagName":"span","properties":{"style":"color:#E7EE98"},"children":[{"type":"text","value":"Insufficient funds\""}]}]}]}]}]}}}}