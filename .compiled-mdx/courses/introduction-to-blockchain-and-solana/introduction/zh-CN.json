{"mdast":{"type":"root","children":[{"type":"mdxjsEsm","value":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";","position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":1,"column":87,"offset":86}},"data":{"estree":{"type":"Program","start":0,"end":86,"loc":{"start":{"line":1,"column":0,"offset":0},"end":{"line":1,"column":86,"offset":86}},"body":[{"type":"ImportDeclaration","start":0,"end":86,"loc":{"start":{"line":1,"column":0,"offset":0},"end":{"line":1,"column":86,"offset":86}},"specifiers":[{"type":"ImportSpecifier","start":9,"end":23,"loc":{"start":{"line":1,"column":9,"offset":9},"end":{"line":1,"column":23,"offset":23}},"imported":{"type":"Identifier","start":9,"end":23,"loc":{"start":{"line":1,"column":9,"offset":9},"end":{"line":1,"column":23,"offset":23}},"name":"ArticleSection","range":[9,23]},"local":{"type":"Identifier","start":9,"end":23,"loc":{"start":{"line":1,"column":9,"offset":9},"end":{"line":1,"column":23,"offset":23}},"name":"ArticleSection","range":[9,23]},"range":[9,23]}],"source":{"type":"Literal","start":31,"end":85,"loc":{"start":{"line":1,"column":31,"offset":31},"end":{"line":1,"column":85,"offset":85}},"value":"../../../../components/ArticleSection/ArticleSection","raw":"\"../../../../components/ArticleSection/ArticleSection\"","range":[31,85]},"range":[0,86]}],"sourceType":"module","comments":[],"range":[0,86]}}},{"type":"heading","depth":1,"children":[{"type":"text","value":"区块链简介","position":{"start":{"line":3,"column":3,"offset":92},"end":{"line":3,"column":8,"offset":97}}}],"position":{"start":{"line":3,"column":1,"offset":90},"end":{"line":3,"column":8,"offset":97}}},{"type":"paragraph","children":[{"type":"image","title":null,"url":"/graphics/course-banners/introduction-to-blockchain-and-solana.png","alt":"区块链简介","position":{"start":{"line":5,"column":1,"offset":101},"end":{"line":5,"column":77,"offset":177}}}],"position":{"start":{"line":5,"column":1,"offset":101},"end":{"line":5,"column":77,"offset":177}}},{"type":"paragraph","children":[{"type":"text","value":"你可能听说过区块链被描述为“数字货币”或“互联网的未来”。这些解释完全没有抓住重点。","position":{"start":{"line":7,"column":1,"offset":181},"end":{"line":7,"column":43,"offset":223}}}],"position":{"start":{"line":7,"column":1,"offset":181},"end":{"line":7,"column":43,"offset":223}}},{"type":"paragraph","children":[{"type":"text","value":"区块链是分布式系统：一组计算机网络，它们必须在不互相信任的情况下就共享数据达成一致。本课程从基本原理讲解区块链：它解决的分布式系统问题、解决方法以及权衡的重要性。","position":{"start":{"line":9,"column":1,"offset":227},"end":{"line":9,"column":82,"offset":308}}}],"position":{"start":{"line":9,"column":1,"offset":227},"end":{"line":9,"column":82,"offset":308}}},{"type":"paragraph","children":[{"type":"text","value":"让我们先了解为什么构建分布式系统是计算机科学中最难的问题之一。","position":{"start":{"line":11,"column":1,"offset":312},"end":{"line":11,"column":32,"offset":343}}}],"position":{"start":{"line":11,"column":1,"offset":312},"end":{"line":11,"column":32,"offset":343}}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"分布式系统","position":{"start":{"line":13,"column":17,"offset":363},"end":{"line":13,"column":29,"offset":375}}},{"type":"mdxJsxAttribute","name":"id","value":"distributed-systems","position":{"start":{"line":13,"column":30,"offset":376},"end":{"line":13,"column":54,"offset":400}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":13,"column":55,"offset":401},"end":{"line":13,"column":65,"offset":411}}}],"children":[],"position":{"start":{"line":13,"column":1,"offset":347},"end":{"line":13,"column":68,"offset":414}}},{"type":"paragraph","children":[{"type":"text","value":"大多数人认为，从一台计算机扩展到多台计算机只是“更多相同的事情”。这就像认为协调一个人和协调分布在不同时区、可能并不总是能联系上的一千人是一样的。","position":{"start":{"line":15,"column":1,"offset":418},"end":{"line":15,"column":74,"offset":491}}}],"position":{"start":{"line":15,"column":1,"offset":418},"end":{"line":15,"column":74,"offset":491}}},{"type":"paragraph","children":[{"type":"text","value":"当你在单台计算机上编写代码时，你生活在一个可预测的世界中：","position":{"start":{"line":17,"column":1,"offset":495},"end":{"line":17,"column":30,"offset":524}}}],"position":{"start":{"line":17,"column":1,"offset":495},"end":{"line":17,"column":30,"offset":524}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"操作要么立即成功，要么立即失败","position":{"start":{"line":18,"column":3,"offset":528},"end":{"line":18,"column":18,"offset":543}}}],"position":{"start":{"line":18,"column":3,"offset":528},"end":{"line":18,"column":18,"offset":543}}}],"position":{"start":{"line":18,"column":1,"offset":526},"end":{"line":18,"column":18,"offset":543}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"数据在读取之间不会神秘地改变","position":{"start":{"line":19,"column":3,"offset":547},"end":{"line":19,"column":17,"offset":561}}}],"position":{"start":{"line":19,"column":3,"offset":547},"end":{"line":19,"column":17,"offset":561}}}],"position":{"start":{"line":19,"column":1,"offset":545},"end":{"line":19,"column":17,"offset":561}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"时间始终向前推进","position":{"start":{"line":20,"column":3,"offset":565},"end":{"line":20,"column":11,"offset":573}}}],"position":{"start":{"line":20,"column":3,"offset":565},"end":{"line":20,"column":11,"offset":573}}}],"position":{"start":{"line":20,"column":1,"offset":563},"end":{"line":20,"column":11,"offset":573}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"当你保存某些内容时，它确实被保存了","position":{"start":{"line":21,"column":3,"offset":577},"end":{"line":21,"column":20,"offset":594}}}],"position":{"start":{"line":21,"column":3,"offset":577},"end":{"line":21,"column":20,"offset":594}}}],"position":{"start":{"line":21,"column":1,"offset":575},"end":{"line":21,"column":20,"offset":594}}}],"position":{"start":{"line":18,"column":1,"offset":526},"end":{"line":21,"column":20,"offset":594}}},{"type":"paragraph","children":[{"type":"text","value":"让我们以一个简单的银行系统为例。在这种情况下，将 100 美元从 Alice 转给 Bob 是非常容易的：","position":{"start":{"line":23,"column":1,"offset":598},"end":{"line":23,"column":54,"offset":651}}}],"position":{"start":{"line":23,"column":1,"offset":598},"end":{"line":23,"column":54,"offset":651}}},{"type":"code","lang":"python","meta":null,"value":"def transfer(from_account, to_account, amount):\r\n    if from_account.balance >= amount:\r\n        from_account.balance -= amount\r\n        to_account.balance += amount\r\n        return \"Transfer successful\"\r\n    return \"Insufficient funds\"","position":{"start":{"line":25,"column":1,"offset":655},"end":{"line":32,"column":4,"offset":907}},"data":{"highlightId":"code-0"}},{"type":"paragraph","children":[{"type":"text","value":"这在单机环境下运行得非常完美……直到你需要扩展。","position":{"start":{"line":34,"column":1,"offset":911},"end":{"line":34,"column":25,"offset":935}}}],"position":{"start":{"line":34,"column":1,"offset":911},"end":{"line":34,"column":25,"offset":935}}},{"type":"paragraph","children":[{"type":"text","value":"你的银行业务增长到单台计算机无法处理的程度，因此你现在将账户均匀分布到不同的数据库中：","position":{"start":{"line":36,"column":1,"offset":939},"end":{"line":36,"column":44,"offset":982}}}],"position":{"start":{"line":36,"column":1,"offset":939},"end":{"line":36,"column":44,"offset":982}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"服务器 A：账户 1 到 1,000,000","position":{"start":{"line":37,"column":3,"offset":986},"end":{"line":37,"column":25,"offset":1008}}}],"position":{"start":{"line":37,"column":3,"offset":986},"end":{"line":37,"column":25,"offset":1008}}}],"position":{"start":{"line":37,"column":1,"offset":984},"end":{"line":37,"column":25,"offset":1008}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"服务器 B：账户 1,000,001 到 2,000,000","position":{"start":{"line":38,"column":3,"offset":1012},"end":{"line":38,"column":33,"offset":1042}}}],"position":{"start":{"line":38,"column":3,"offset":1012},"end":{"line":38,"column":33,"offset":1042}}}],"position":{"start":{"line":38,"column":1,"offset":1010},"end":{"line":38,"column":33,"offset":1042}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"服务器 C：账户 2,000,001 到 3,000,000","position":{"start":{"line":39,"column":3,"offset":1046},"end":{"line":39,"column":33,"offset":1076}}}],"position":{"start":{"line":39,"column":3,"offset":1046},"end":{"line":39,"column":33,"offset":1076}}}],"position":{"start":{"line":39,"column":1,"offset":1044},"end":{"line":39,"column":33,"offset":1076}}}],"position":{"start":{"line":37,"column":1,"offset":984},"end":{"line":39,"column":33,"offset":1076}}},{"type":"paragraph","children":[{"type":"text","value":"现在，Alice（在服务器 A 上）想要向 Bob（在服务器 B 上）转账 100 美元。这个简单的转账变成了：","position":{"start":{"line":41,"column":1,"offset":1080},"end":{"line":41,"column":57,"offset":1136}}}],"position":{"start":{"line":41,"column":1,"offset":1080},"end":{"line":41,"column":57,"offset":1136}}},{"type":"code","lang":"python","meta":null,"value":"def distributed_transfer(alice_server, bob_server, amount):\r\n    # Check Alice's balance on Server A\r\n    if alice_server.get_balance(\"alice\") >= amount:\r\n        alice_server.deduct(\"alice\", amount)    # Step 1\r\n        bob_server.add(\"bob\", amount)           # Step 2\r\n        return \"Transfer successful\"\r\n    return \"Insufficient funds\"","position":{"start":{"line":43,"column":1,"offset":1140},"end":{"line":51,"column":4,"offset":1496}},"data":{"highlightId":"code-1"}},{"type":"paragraph","children":[{"type":"text","value":"看起来仍然很简单吗？以下是可能出错的地方：","position":{"start":{"line":52,"column":1,"offset":1498},"end":{"line":52,"column":22,"offset":1519}}}],"position":{"start":{"line":52,"column":1,"offset":1498},"end":{"line":52,"column":22,"offset":1519}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"网络分区：服务器之间的连接在步骤 1 之后但在步骤 2 之前失败。Alice 的 100 美元消失在数字虚空中。","position":{"start":{"line":53,"column":3,"offset":1523},"end":{"line":53,"column":59,"offset":1579}}}],"position":{"start":{"line":53,"column":3,"offset":1523},"end":{"line":53,"column":59,"offset":1579}}}],"position":{"start":{"line":53,"column":1,"offset":1521},"end":{"line":53,"column":59,"offset":1579}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"服务器崩溃：服务器 B 在接收到“添加资金”命令后崩溃，但在确认处理之前崩溃。Bob 收到钱了吗？没人知道。","position":{"start":{"line":54,"column":3,"offset":1583},"end":{"line":54,"column":57,"offset":1637}}}],"position":{"start":{"line":54,"column":3,"offset":1583},"end":{"line":54,"column":57,"offset":1637}}}],"position":{"start":{"line":54,"column":1,"offset":1581},"end":{"line":54,"column":57,"offset":1637}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"竞争条件：Alice 的两笔转账同时发生。两者都检查了她的 100 美元余额，发现她有足够的资金，并都继续进行。Alice 现在花费了她并没有的 100 美元。","position":{"start":{"line":55,"column":3,"offset":1641},"end":{"line":55,"column":83,"offset":1721}}}],"position":{"start":{"line":55,"column":3,"offset":1641},"end":{"line":55,"column":83,"offset":1721}}}],"position":{"start":{"line":55,"column":1,"offset":1639},"end":{"line":55,"column":83,"offset":1721}}}],"position":{"start":{"line":53,"column":1,"offset":1521},"end":{"line":55,"column":83,"offset":1721}}},{"type":"heading","depth":3,"children":[{"type":"text","value":"CAP 定理","position":{"start":{"line":57,"column":5,"offset":1729},"end":{"line":57,"column":11,"offset":1735}}}],"position":{"start":{"line":57,"column":1,"offset":1725},"end":{"line":57,"column":11,"offset":1735}}},{"type":"paragraph","children":[{"type":"text","value":"1999 年，计算机科学家 Eric Brewer 提出了 CAP 定理，该定理指出任何分布式系统最多只能保证以下三个属性中的两个：","position":{"start":{"line":59,"column":1,"offset":1739},"end":{"line":59,"column":67,"offset":1805}}}],"position":{"start":{"line":59,"column":1,"offset":1739},"end":{"line":59,"column":67,"offset":1805}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"一致性 (C)：所有服务器始终显示相同的数据。当 Alice 的余额在服务器 A 上发生变化时，其他所有服务器会立即反映这一变化。","position":{"start":{"line":60,"column":3,"offset":1809},"end":{"line":60,"column":68,"offset":1874}}}],"position":{"start":{"line":60,"column":3,"offset":1809},"end":{"line":60,"column":68,"offset":1874}}}],"position":{"start":{"line":60,"column":1,"offset":1807},"end":{"line":60,"column":68,"offset":1874}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"可用性 (A)：即使服务器崩溃，系统也能继续工作。如果服务器 A 宕机，用户仍然可以通过服务器 B 和 C 访问账户。","position":{"start":{"line":61,"column":3,"offset":1878},"end":{"line":61,"column":62,"offset":1937}}}],"position":{"start":{"line":61,"column":3,"offset":1878},"end":{"line":61,"column":62,"offset":1937}}}],"position":{"start":{"line":61,"column":1,"offset":1876},"end":{"line":61,"column":62,"offset":1937}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"分区容错性 (P)：系统能够在网络故障将服务器分隔成孤立组时继续运行。","position":{"start":{"line":62,"column":3,"offset":1941},"end":{"line":62,"column":38,"offset":1976}}}],"position":{"start":{"line":62,"column":3,"offset":1941},"end":{"line":62,"column":38,"offset":1976}}}],"position":{"start":{"line":62,"column":1,"offset":1939},"end":{"line":62,"column":38,"offset":1976}}}],"position":{"start":{"line":60,"column":1,"offset":1807},"end":{"line":62,"column":38,"offset":1976}}},{"type":"paragraph","children":[{"type":"text","value":"我们必须保证分区容错性，因为网络分区是不可避免的：电缆会被切断，路由器会失效，数据中心会断电。这使我们需要在一致性和可用性之间做出选择。","position":{"start":{"line":64,"column":1,"offset":1980},"end":{"line":64,"column":69,"offset":2048}}}],"position":{"start":{"line":64,"column":1,"offset":1980},"end":{"line":64,"column":69,"offset":2048}}},{"type":"paragraph","children":[{"type":"text","value":"传统银行系统通常选择一致性 + 分区容错性（CP 系统）。它们宁愿关闭系统也不愿显示错误的账户余额。","position":{"start":{"line":66,"column":1,"offset":2052},"end":{"line":66,"column":51,"offset":2102}}}],"position":{"start":{"line":66,"column":1,"offset":2052},"end":{"line":66,"column":51,"offset":2102}}},{"type":"paragraph","children":[{"type":"text","value":"社交媒体平台通常选择可用性 + 分区容错性（AP 系统）。它们宁愿让你发布内容（即使朋友无法立即看到）也不愿完全阻止你发布。","position":{"start":{"line":68,"column":1,"offset":2106},"end":{"line":68,"column":63,"offset":2168}}}],"position":{"start":{"line":68,"column":1,"offset":2106},"end":{"line":68,"column":63,"offset":2168}}},{"type":"heading","depth":3,"children":[{"type":"text","value":"拜占庭将军问题","position":{"start":{"line":70,"column":5,"offset":2176},"end":{"line":70,"column":12,"offset":2183}}}],"position":{"start":{"line":70,"column":1,"offset":2172},"end":{"line":70,"column":12,"offset":2183}}},{"type":"paragraph","children":[{"type":"text","value":"除了 CAP 定理，大多数分布式系统假设参与者是诚实的：他们可能会失败或断开连接，但不会主动欺骗彼此。当参与者可能是恶意的时，这一假设就不成立了。","position":{"start":{"line":72,"column":1,"offset":2187},"end":{"line":72,"column":74,"offset":2260}}}],"position":{"start":{"line":72,"column":1,"offset":2187},"end":{"line":72,"column":74,"offset":2260}}},{"type":"paragraph","children":[{"type":"text","value":"计算机科学家在 1982 年提出的拜占庭将军问题，说明了这一挑战：","position":{"start":{"line":74,"column":1,"offset":2264},"end":{"line":74,"column":34,"offset":2297}}}],"position":{"start":{"line":74,"column":1,"offset":2264},"end":{"line":74,"column":34,"offset":2297}}},{"type":