{"mdast":{"type":"root","children":[{"type":"mdxjsEsm","value":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";","position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":1,"column":87,"offset":86}},"data":{"estree":{"type":"Program","start":0,"end":86,"loc":{"start":{"line":1,"column":0,"offset":0},"end":{"line":1,"column":86,"offset":86}},"body":[{"type":"ImportDeclaration","start":0,"end":86,"loc":{"start":{"line":1,"column":0,"offset":0},"end":{"line":1,"column":86,"offset":86}},"specifiers":[{"type":"ImportSpecifier","start":9,"end":23,"loc":{"start":{"line":1,"column":9,"offset":9},"end":{"line":1,"column":23,"offset":23}},"imported":{"type":"Identifier","start":9,"end":23,"loc":{"start":{"line":1,"column":9,"offset":9},"end":{"line":1,"column":23,"offset":23}},"name":"ArticleSection","range":[9,23]},"local":{"type":"Identifier","start":9,"end":23,"loc":{"start":{"line":1,"column":9,"offset":9},"end":{"line":1,"column":23,"offset":23}},"name":"ArticleSection","range":[9,23]},"range":[9,23]}],"source":{"type":"Literal","start":31,"end":85,"loc":{"start":{"line":1,"column":31,"offset":31},"end":{"line":1,"column":85,"offset":85}},"value":"../../../../components/ArticleSection/ArticleSection","raw":"\"../../../../components/ArticleSection/ArticleSection\"","range":[31,85]},"range":[0,86]}],"sourceType":"module","comments":[],"range":[0,86]}}},{"type":"heading","depth":1,"children":[{"type":"text","value":"區塊鏈簡介","position":{"start":{"line":3,"column":3,"offset":92},"end":{"line":3,"column":8,"offset":97}}}],"position":{"start":{"line":3,"column":1,"offset":90},"end":{"line":3,"column":8,"offset":97}}},{"type":"paragraph","children":[{"type":"image","title":null,"url":"/graphics/course-banners/introduction-to-blockchain-and-solana.png","alt":"區塊鏈簡介","position":{"start":{"line":5,"column":1,"offset":101},"end":{"line":5,"column":77,"offset":177}}}],"position":{"start":{"line":5,"column":1,"offset":101},"end":{"line":5,"column":77,"offset":177}}},{"type":"paragraph","children":[{"type":"text","value":"你可能聽過區塊鏈被描述為「數字貨幣」或「互聯網的未來」。這些解釋完全忽略了重點。","position":{"start":{"line":7,"column":1,"offset":181},"end":{"line":7,"column":41,"offset":221}}}],"position":{"start":{"line":7,"column":1,"offset":181},"end":{"line":7,"column":41,"offset":221}}},{"type":"paragraph","children":[{"type":"text","value":"區塊鏈是分佈式系統：一個由多台電腦組成的網絡，這些電腦必須在不互相信任的情況下就共享數據達成一致。本課程從基本原理教你了解區塊鏈：它解決的分佈式系統問題、解決方法以及為什麼權衡取捨很重要。","position":{"start":{"line":9,"column":1,"offset":225},"end":{"line":9,"column":95,"offset":319}}}],"position":{"start":{"line":9,"column":1,"offset":225},"end":{"line":9,"column":95,"offset":319}}},{"type":"paragraph","children":[{"type":"text","value":"讓我們先了解為什麼構建分佈式系統是計算機科學中最困難的問題之一。","position":{"start":{"line":11,"column":1,"offset":323},"end":{"line":11,"column":33,"offset":355}}}],"position":{"start":{"line":11,"column":1,"offset":323},"end":{"line":11,"column":33,"offset":355}}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"分佈式系統","position":{"start":{"line":13,"column":17,"offset":375},"end":{"line":13,"column":29,"offset":387}}},{"type":"mdxJsxAttribute","name":"id","value":"distributed-systems","position":{"start":{"line":13,"column":30,"offset":388},"end":{"line":13,"column":54,"offset":412}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":13,"column":55,"offset":413},"end":{"line":13,"column":65,"offset":423}}}],"children":[],"position":{"start":{"line":13,"column":1,"offset":359},"end":{"line":13,"column":68,"offset":426}}},{"type":"paragraph","children":[{"type":"text","value":"大多數人認為從一台電腦擴展到多台電腦只是「更多相同的東西」。這就像認為協調一個人與協調一千個分佈在不同時區且可能無法隨時聯繫到的人是一樣的。","position":{"start":{"line":15,"column":1,"offset":430},"end":{"line":15,"column":71,"offset":500}}}],"position":{"start":{"line":15,"column":1,"offset":430},"end":{"line":15,"column":71,"offset":500}}},{"type":"paragraph","children":[{"type":"text","value":"當你在單台電腦上編寫代碼時，你生活在一個可預測的世界中：","position":{"start":{"line":17,"column":1,"offset":504},"end":{"line":17,"column":29,"offset":532}}}],"position":{"start":{"line":17,"column":1,"offset":504},"end":{"line":17,"column":29,"offset":532}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"操作要麼立即成功，要麼立即失敗","position":{"start":{"line":18,"column":3,"offset":536},"end":{"line":18,"column":18,"offset":551}}}],"position":{"start":{"line":18,"column":3,"offset":536},"end":{"line":18,"column":18,"offset":551}}}],"position":{"start":{"line":18,"column":1,"offset":534},"end":{"line":18,"column":18,"offset":551}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"數據在讀取之間不會神秘地改變","position":{"start":{"line":19,"column":3,"offset":555},"end":{"line":19,"column":17,"offset":569}}}],"position":{"start":{"line":19,"column":3,"offset":555},"end":{"line":19,"column":17,"offset":569}}}],"position":{"start":{"line":19,"column":1,"offset":553},"end":{"line":19,"column":17,"offset":569}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"時間一致地向前推進","position":{"start":{"line":20,"column":3,"offset":573},"end":{"line":20,"column":12,"offset":582}}}],"position":{"start":{"line":20,"column":3,"offset":573},"end":{"line":20,"column":12,"offset":582}}}],"position":{"start":{"line":20,"column":1,"offset":571},"end":{"line":20,"column":12,"offset":582}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"當你保存某些東西時，它確實被保存了","position":{"start":{"line":21,"column":3,"offset":586},"end":{"line":21,"column":20,"offset":603}}}],"position":{"start":{"line":21,"column":3,"offset":586},"end":{"line":21,"column":20,"offset":603}}}],"position":{"start":{"line":21,"column":1,"offset":584},"end":{"line":21,"column":20,"offset":603}}}],"position":{"start":{"line":18,"column":1,"offset":534},"end":{"line":21,"column":20,"offset":603}}},{"type":"paragraph","children":[{"type":"text","value":"讓我們以一個簡單的銀行系統為例。在這種情況下，將 100 美元從 Alice 轉移到 Bob 是非常容易的：","position":{"start":{"line":23,"column":1,"offset":607},"end":{"line":23,"column":55,"offset":661}}}],"position":{"start":{"line":23,"column":1,"offset":607},"end":{"line":23,"column":55,"offset":661}}},{"type":"code","lang":"python","meta":null,"value":"def transfer(from_account, to_account, amount):\r\n    if from_account.balance >= amount:\r\n        from_account.balance -= amount\r\n        to_account.balance += amount\r\n        return \"Transfer successful\"\r\n    return \"Insufficient funds\"","position":{"start":{"line":25,"column":1,"offset":665},"end":{"line":32,"column":4,"offset":917}},"data":{"highlightId":"code-0"}},{"type":"paragraph","children":[{"type":"text","value":"這一切運行得非常順利……直到你需要擴展。","position":{"start":{"line":34,"column":1,"offset":921},"end":{"line":34,"column":21,"offset":941}}}],"position":{"start":{"line":34,"column":1,"offset":921},"end":{"line":34,"column":21,"offset":941}}},{"type":"paragraph","children":[{"type":"text","value":"你的銀行業務增長超過了一台電腦的處理能力，因此你現在將賬戶平均分配到不同的數據庫：","position":{"start":{"line":36,"column":1,"offset":945},"end":{"line":36,"column":42,"offset":986}}}],"position":{"start":{"line":36,"column":1,"offset":945},"end":{"line":36,"column":42,"offset":986}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"伺服器 A：賬戶 1 到 1,000,000","position":{"start":{"line":37,"column":3,"offset":990},"end":{"line":37,"column":25,"offset":1012}}}],"position":{"start":{"line":37,"column":3,"offset":990},"end":{"line":37,"column":25,"offset":1012}}}],"position":{"start":{"line":37,"column":1,"offset":988},"end":{"line":37,"column":25,"offset":1012}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"伺服器 B：賬戶 1,000,001 到 2,000,000","position":{"start":{"line":38,"column":3,"offset":1016},"end":{"line":38,"column":33,"offset":1046}}}],"position":{"start":{"line":38,"column":3,"offset":1016},"end":{"line":38,"column":33,"offset":1046}}}],"position":{"start":{"line":38,"column":1,"offset":1014},"end":{"line":38,"column":33,"offset":1046}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"伺服器 C：賬戶 2,000,001 到 3,000,000","position":{"start":{"line":39,"column":3,"offset":1050},"end":{"line":39,"column":33,"offset":1080}}}],"position":{"start":{"line":39,"column":3,"offset":1050},"end":{"line":39,"column":33,"offset":1080}}}],"position":{"start":{"line":39,"column":1,"offset":1048},"end":{"line":39,"column":33,"offset":1080}}}],"position":{"start":{"line":37,"column":1,"offset":988},"end":{"line":39,"column":33,"offset":1080}}},{"type":"paragraph","children":[{"type":"text","value":"現在，Alice（在伺服器 A 上）想要向 Bob（在伺服器 B 上）轉賬 100 美元。這個簡單的轉賬變成了：","position":{"start":{"line":41,"column":1,"offset":1084},"end":{"line":41,"column":57,"offset":1140}}}],"position":{"start":{"line":41,"column":1,"offset":1084},"end":{"line":41,"column":57,"offset":1140}}},{"type":"code","lang":"python","meta":null,"value":"def distributed_transfer(alice_server, bob_server, amount):\r\n    # Check Alice's balance on Server A\r\n    if alice_server.get_balance(\"alice\") >= amount:\r\n        alice_server.deduct(\"alice\", amount)    # Step 1\r\n        bob_server.add(\"bob\", amount)           # Step 2\r\n        return \"Transfer successful\"\r\n    return \"Insufficient funds\"","position":{"start":{"line":43,"column":1,"offset":1144},"end":{"line":51,"column":4,"offset":1500}},"data":{"highlightId":"code-1"}},{"type":"paragraph","children":[{"type":"text","value":"看起來仍然很簡單？以下是可能出現的問題：","position":{"start":{"line":53,"column":1,"offset":1504},"end":{"line":53,"column":21,"offset":1524}}}],"position":{"start":{"line":53,"column":1,"offset":1504},"end":{"line":53,"column":21,"offset":1524}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"網絡分區：伺服器之間的連接在步驟1之後但步驟2之前失敗。Alice的$100消失在數字虛空中。","position":{"start":{"line":54,"column":3,"offset":1528},"end":{"line":54,"column":50,"offset":1575}}}],"position":{"start":{"line":54,"column":3,"offset":1528},"end":{"line":54,"column":50,"offset":1575}}}],"position":{"start":{"line":54,"column":1,"offset":1526},"end":{"line":54,"column":50,"offset":1575}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"伺服器崩潰：伺服器B在接收到“添加金額”指令後崩潰，但在確認處理之前崩潰。Bob是否收到金額？無人知曉。","position":{"start":{"line":55,"column":3,"offset":1579},"end":{"line":55,"column":55,"offset":1631}}}],"position":{"start":{"line":55,"column":3,"offset":1579},"end":{"line":55,"column":55,"offset":1631}}}],"position":{"start":{"line":55,"column":1,"offset":1577},"end":{"line":55,"column":55,"offset":1631}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"競爭條件：Alice的兩筆轉賬同時進行。兩者都檢查她的$100餘額，看到她有足夠的資金，然後都繼續進行。Alice現在花費了她並沒有的$100。","position":{"start":{"line":56,"column":3,"offset":1635},"end":{"line":56,"column":75,"offset":1707}}}],"position":{"start":{"line":56,"column":3,"offset":1635},"end":{"line":56,"column":75,"offset":1707}}}],"position":{"start":{"line":56,"column":1,"offset":1633},"end":{"line":56,"column":75,"offset":1707}}}],"position":{"start":{"line":54,"column":1,"offset":1526},"end":{"line":56,"column":75,"offset":1707}}},{"type":"heading","depth":3,"children":[{"type":"text","value":"CAP定理","position":{"start":{"line":58,"column":5,"offset":1715},"end":{"line":58,"column":10,"offset":1720}}}],"position":{"start":{"line":58,"column":1,"offset":1711},"end":{"line":58,"column":10,"offset":1720}}},{"type":"paragraph","children":[{"type":"text","value":"1999年，計算機科學家Eric Brewer提出了CAP定理，該定理指出任何分佈式系統最多只能保證以下三個屬性中的兩個：","position":{"start":{"line":60,"column":1,"offset":1724},"end":{"line":60,"column":62,"offset":1785}}}],"position":{"start":{"line":60,"column":1,"offset":1724},"end":{"line":60,"column":62,"offset":1785}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"一致性（C）：所有伺服器始終顯示相同的數據。當Alice的餘額在伺服器A上更改時，其他所有伺服器立即反映這一變化。","position":{"start":{"line":61,"column":3,"offset":1789},"end":{"line":61,"column":60,"offset":1846}}}],"position":{"start":{"line":61,"column":3,"offset":1789},"end":{"line":61,"column":60,"offset":1846}}}],"position":{"start":{"line":61,"column":1,"offset":1787},"end":{"line":61,"column":60,"offset":1846}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"可用性（A）：即使伺服器崩潰，系統仍然可以運行。如果伺服器A宕機，用戶仍然可以通過伺服器B和C訪問賬戶。","position":{"start":{"line":62,"column":3,"offset":1850},"end":{"line":62,"column":55,"offset":1902}}}],"position":{"start":{"line":62,"column":3,"offset":1850},"end":{"line":62,"column":55,"offset":1902}}}],"position":{"start":{"line":62,"column":1,"offset":1848},"end":{"line":62,"column":55,"offset":1902}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"分區容錯性（P）：系統能夠在網絡故障將伺服器分隔成孤立組時繼續運行。","position":{"start":{"line":63,"column":3,"offset":1906},"end":{"line":63,"column":37,"offset":1940}}}],"position":{"start":{"line":63,"column":3,"offset":1906},"end":{"line":63,"column":37,"offset":1940}}}],"position":{"start":{"line":63,"column":1,"offset":1904},"end":{"line":63,"column":37,"offset":1940}}}],"position":{"start":{"line":61,"column":1,"offset":1787},"end":{"line":63,"column":37,"offset":1940}}},{"type":"paragraph","children":[{"type":"text","value":"我們必須保證分區容錯性，因為網絡分區是不可避免的：電纜會被切斷，路由器會失效，數據中心會斷電。這使我們需要在一致性或可用性之間進行選擇。","position":{"start":{"line":65,"column":1,"offset":1944},"end":{"line":65,"column":69,"offset":2012}}}],"position":{"start":{"line":65,"column":1,"offset":1944},"end":{"line":65,"column":69,"offset":2012}}},{"type":"paragraph","children":[{"type":"text","value":"傳統銀行系統通常選擇一致性+分區容錯性（CP系統）。它們寧願關閉系統，也不願顯示不正確的賬戶餘額。","position":{"start":{"line":67,"column":1,"offset":2016},"end":{"line":67,"column":50,"offset":2065}}}],"position":{"start":{"line":67,"column":1,"offset":2016},"end":{"line":67,"column":50,"offset":2065}}},{"type":"paragraph","children":[{"type":"text","value":"社交媒體平台通常選擇可用性+分區容錯性（AP系統）。它們寧願讓你發佈（即使朋友無法立即看到），也不願阻止你發佈內容。","position":{"start":{"line":69,"column":1,"offset":2069},"end":{"line":69,"column":59,"offset":2127}}}],"position":{"start":{"line":69,"column":1,"offset":2069},"end":{"line":69,"column":59,"offset":2127}}},{"type":"heading","depth":3,"children":[{"type":"text","value":"拜占庭將軍問題","position":{"start":{"line":71,"column":5,"offset":2135},"end":{"line":71,"column":12,"offset":2142}}}],"position":{"start":{"line":71,"column":1,"offset":2131},"end":{"line":71,"column":12,"offset":2142}}},{"type":"paragraph","children":[{"type":"text","value":"除了CAP定理，大多數分佈式系統假設參與者是誠實的：他們可能會失敗或斷線，但不會故意欺騙彼此。當參與者可能是惡意的時，這一假設就不成立了。","position":{"start":{"line":73,"column":1,"offset":2146},"end":{"line":73,"column":70,"offset":2215}}}],"position":{"start":{"line":73,"column":1,"offset":2146},"end":{"line":73,"column":70,"offset":2215}}},{"type":"paragraph","children":[{"type":"text","value":"拜占庭將軍問題由計算機科學家於1982年提出，說明了這一挑戰：","position":{"start":{"line":75,"column":1,"offset":2219},"end":{"line":75,"column":32,"offset":2250}}}],"position":{"start":{"line":75,"column":1,"offset":2219},"end":{"line":75,"column":32,"offset":2250}}},{"type":"paragraph","children":[{"type":"text","value":"你是一名拜占庭將軍，計劃攻擊一座設防的城市。你有幾位盟軍將軍分佈在城市周圍，每位將軍指揮自己的軍隊。要成功，你必須協調同時進攻。如果有些人進攻而其他人撤退，進攻的部隊將被屠殺。","position":{"start":{"line":77,"column":1,"offset":2254},"end":{"line":77,"column":89,"offset":2342}}}],"position":{"start":{"line":77,"column":1,"offset":2254},"end":{"line":77,"column":89,"offset":2342}}},{"type":"paragraph","children":[{"type":"text","value":"你只能通過信使進行通信，而某些將軍可能是叛徒，他們希望進攻失敗。叛徒可能會：","position":{"start":{"line":79,"column":1,"offset":2346},"end":{"line":79,"column":39,"offset":2384}}}],"position":{"start":{"line":79,"column":1,"offset":2346},"end":{"line":79,"column":39,"offset":2384}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"向一些將軍發送「進攻」信息，向其他人發送「撤退」信息","position":{"start":{"line":80,"column":3,"offset":2388},"end":{"line":80,"column":29,"offset":2414}}}],"position":{"start":{"line":80,"column":3,"offset":2388},"end":{"line":80,"column":29,"offset":2414}}}],"position":{"start":{"line":80,"column":1,"offset":2386},"end":{"line":80,"column":29,"offset":2414}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"修改忠誠將軍的消息內容","position":{"start":{"line":81,"column":3,"offset":2418},"end":{"line":81,"column":14,"offset":2429}}}],"position":{"start":{"line":81,"column":3,"offset":2418},"end":{"line":81,"column":14,"offset":2429}}}],"position":{"start":{"line":81,"column":1,"offset":2416},"end":{"line":81,"column":14,"offset":2429}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"與其他叛徒協調以最大化混亂","position":{"start":{"line":82,"column":3,"offset":2433},"end":{"line":82,"column":16,"offset":2446}}}],"position":{"start":{"line":82,"column":3,"offset":2433},"end":{"line":82,"column":16,"offset":2446}}}],"position":{"start":{"line":82,"column":1,"offset":2431},"end":{"line":82,"column":16,"offset":2446}}}],"position":{"start":{"line":80,"column":1,"offset":2386},"end":{"line":82,"column":16,"offset":2446}}},{"type":"paragraph","children":[{"type":"text","value":"當你無法區分忠誠將軍和叛徒，且無法信任通信渠道時，如何就「進攻」或「撤退」達成共識？","position":{"start":{"line":84,"column":1,"offset":2450},"end":{"line":84,"column":43,"offset":2492}}}],"position":{"start":{"line":84,"column":1,"offset":2450},"end":{"line":84,"column":43,"offset":2492}}},{"type":"paragraph","children":[{"type":"text","value":"這似乎是不可能的。幾十年來，計算機科學家認為不可能構建一個同時具備以下特性的系統：","position":{"start":{"line":86,"column":1,"offset":2496},"end":{"line":86,"column":42,"offset":2537}}}],"position":{"start":{"line":86,"column":1,"offset":2496},"end":{"line":86,"column":42,"offset":2537}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"拜占庭容錯（即使有惡意參與者也能運行）","position":{"start":{"line":87,"column":3,"offset":2541},"end":{"line":87,"column":22,"offset":2560}}}],"position":{"start":{"line":87,"column":3,"offset":2541},"end":{"line":87,"column":22,"offset":2560}}}],"position":{"start":{"line":87,"column":1,"offset":2539},"end":{"line":87,"column":22,"offset":2560}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"無需許可（任何人都可以無需批准加入）","position":{"start":{"line":88,"column":3,"offset":2564},"end":{"line":88,"column":21,"offset":2582}}}],"position":{"start":{"line":88,"column":3,"offset":2564},"end":{"line":88,"column":21,"offset":2582}}}],"position":{"start":{"line":88,"column":1,"offset":2562},"end":{"line":88,"column":21,"offset":2582}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"去中心化（無中央權威）","position":{"start":{"line":89,"column":3,"offset":2586},"end":{"line":89,"column":14,"offset":2597}}}],"position":{"start":{"line":89,"column":3,"offset":2586},"end":{"line":89,"column":14,"offset":2597}}}],"position":{"start":{"line":89,"column":1,"offset":2584},"end":{"line":89,"column":14,"offset":2597}}}],"position":{"start":{"line":87,"column":1,"offset":2539},"end":{"line":89,"column":14,"offset":2597}}},{"type":"paragraph","children":[{"type":"text","value":"直到2008年，一位自稱中本聰的人證明了他們是錯的。","position":{"start":{"line":91,"column":1,"offset":2601},"end":{"line":91,"column":27,"offset":2627}}}],"position":{"start":{"line":91,"column":1,"offset":2601},"end":{"line":91,"column":27,"offset":2627}}},{"type":"heading","depth":3,"children":[{"type":"text","value":"比特幣：第一個區塊鏈","position":{"start":{"line":93,"column":5,"offset":2635},"end":{"line":93,"column":15,"offset":2645}}}],"position":{"start":{"line":93,"column":1,"offset":2631},"end":{"line":93,"column":15,"offset":2645}}},{"type":"paragraph","children":[{"type":"text","value":"比特幣是區塊鏈技術的第一個實際應用。雖然加密哈希、數字簽名、點對點網絡等組件早已存在，但中本聰是第一個將它們結合起來，解決數字貨幣雙重支付問題的人。","position":{"start":{"line":95,"column":1,"offset":2649},"end":{"line":95,"column":75,"offset":2723}}}],"position":{"start":{"line":95,"column":1,"offset":2649},"end":{"line":95,"column":75,"offset":2723}}},{"type":"paragraph","children":[{"type":"text","value":"區塊鏈（Blockchain），或稱為「區塊鏈條」，這個名稱最早出現在原始的比特幣","position":{"start":{"line":97,"column":1,"offset":2727},"end":{"line":97,"column":42,"offset":2768}}},{"type":"link","title":null,"url":"https://bitcoin.org/bitcoin.pdf","children":[{"type":"text","value":"白皮書","position":{"start":{"line":97,"column":43,"offset":2769},"end":{"line":97,"column":46,"offset":2772}}}],"position":{"start":{"line":97,"column":42,"offset":2768},"end":{"line":97,"column":80,"offset":2806}}},{"type":"text","value":"中，最終創造了一個同時具備分佈式、拜占庭容錯性和無需許可的系統。","position":{"start":{"line":97,"column":80,"offset":2806},"end":{"line":97,"column":112,"offset":2838}}}],"position":{"start":{"line":97,"column":1,"offset":2727},"end":{"line":97,"column":112,"offset":2838}}},{"type":"paragraph","children":[{"type":"text","value":"這項突破並非試圖辨別誰值得信任，而是讓撒謊在經濟上比說真話更昂貴。工作量證明（Proof of Work）通過要求參與者消耗真實的計算能量來提出更改來實現這一點。攻擊者需要花費的電力成本將超過他們從攻擊中獲得的收益。","position":{"start":{"line":99,"column":1,"offset":2842},"end":{"line":99,"column":109,"offset":2950}}}],"position":{"start":{"line":99,"column":1,"offset":2842},"end":{"line":99,"column":109,"offset":2950}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":99,"column":109,"offset":2950}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# 區塊鏈簡介\r\n\r\n![區塊鏈簡介](/graphics/course-banners/introduction-to-blockchain-and-solana.png)\r\n\r\n你可能聽過區塊鏈被描述為「數字貨幣」或「互聯網的未來」。這些解釋完全忽略了重點。\r\n\r\n區塊鏈是分佈式系統：一個由多台電腦組成的網絡，這些電腦必須在不互相信任的情況下就共享數據達成一致。本課程從基本原理教你了解區塊鏈：它解決的分佈式系統問題、解決方法以及為什麼權衡取捨很重要。\r\n\r\n讓我們先了解為什麼構建分佈式系統是計算機科學中最困難的問題之一。\r\n\r\n<ArticleSection name=\"分佈式系統\" id=\"distributed-systems\" level=\"h2\" />\r\n\r\n大多數人認為從一台電腦擴展到多台電腦只是「更多相同的東西」。這就像認為協調一個人與協調一千個分佈在不同時區且可能無法隨時聯繫到的人是一樣的。\r\n\r\n當你在單台電腦上編寫代碼時，你生活在一個可預測的世界中：\r\n- 操作要麼立即成功，要麼立即失敗\r\n- 數據在讀取之間不會神秘地改變\r\n- 時間一致地向前推進\r\n- 當你保存某些東西時，它確實被保存了\r\n\r\n讓我們以一個簡單的銀行系統為例。在這種情況下，將 100 美元從 Alice 轉移到 Bob 是非常容易的：\r\n\r\n```python\r\ndef transfer(from_account, to_account, amount):\r\n    if from_account.balance >= amount:\r\n        from_account.balance -= amount\r\n        to_account.balance += amount\r\n        return \"Transfer successful\"\r\n    return \"Insufficient funds\"\r\n```\r\n\r\n這一切運行得非常順利……直到你需要擴展。\r\n\r\n你的銀行業務增長超過了一台電腦的處理能力，因此你現在將賬戶平均分配到不同的數據庫：\r\n- 伺服器 A：賬戶 1 到 1,000,000\r\n- 伺服器 B：賬戶 1,000,001 到 2,000,000\r\n- 伺服器 C：賬戶 2,000,001 到 3,000,000\r\n\r\n現在，Alice（在伺服器 A 上）想要向 Bob（在伺服器 B 上）轉賬 100 美元。這個簡單的轉賬變成了：\r\n\r\n```python\r\ndef distributed_transfer(alice_server, bob_server, amount):\r\n    # Check Alice's balance on Server A\r\n    if alice_server.get_balance(\"alice\") >= amount:\r\n        alice_server.deduct(\"alice\", amount)    # Step 1\r\n        bob_server.add(\"bob\", amount)           # Step 2\r\n        return \"Transfer successful\"\r\n    return \"Insufficient funds\"\r\n```\r\n\r\n看起來仍然很簡單？以下是可能出現的問題：\r\n- 網絡分區：伺服器之間的連接在步驟1之後但步驟2之前失敗。Alice的$100消失在數字虛空中。\r\n- 伺服器崩潰：伺服器B在接收到“添加金額”指令後崩潰，但在確認處理之前崩潰。Bob是否收到金額？無人知曉。\r\n- 競爭條件：Alice的兩筆轉賬同時進行。兩者都檢查她的$100餘額，看到她有足夠的資金，然後都繼續進行。Alice現在花費了她並沒有的$100。\r\n\r\n### CAP定理\r\n\r\n1999年，計算機科學家Eric Brewer提出了CAP定理，該定理指出任何分佈式系統最多只能保證以下三個屬性中的兩個：\r\n- 一致性（C）：所有伺服器始終顯示相同的數據。當Alice的餘額在伺服器A上更改時，其他所有伺服器立即反映這一變化。\r\n- 可用性（A）：即使伺服器崩潰，系統仍然可以運行。如果伺服器A宕機，用戶仍然可以通過伺服器B和C訪問賬戶。\r\n- 分區容錯性（P）：系統能夠在網絡故障將伺服器分隔成孤立組時繼續運行。\r\n\r\n我們必須保證分區容錯性，因為網絡分區是不可避免的：電纜會被切斷，路由器會失效，數據中心會斷電。這使我們需要在一致性或可用性之間進行選擇。\r\n\r\n傳統銀行系統通常選擇一致性+分區容錯性（CP系統）。它們寧願關閉系統，也不願顯示不正確的賬戶餘額。\r\n\r\n社交媒體平台通常選擇可用性+分區容錯性（AP系統）。它們寧願讓你發佈（即使朋友無法立即看到），也不願阻止你發佈內容。\r\n\r\n### 拜占庭將軍問題\r\n\r\n除了CAP定理，大多數分佈式系統假設參與者是誠實的：他們可能會失敗或斷線，但不會故意欺騙彼此。當參與者可能是惡意的時，這一假設就不成立了。\r\n\r\n拜占庭將軍問題由計算機科學家於1982年提出，說明了這一挑戰：\r\n\r\n你是一名拜占庭將軍，計劃攻擊一座設防的城市。你有幾位盟軍將軍分佈在城市周圍，每位將軍指揮自己的軍隊。要成功，你必須協調同時進攻。如果有些人進攻而其他人撤退，進攻的部隊將被屠殺。\r\n\r\n你只能通過信使進行通信，而某些將軍可能是叛徒，他們希望進攻失敗。叛徒可能會：\r\n- 向一些將軍發送「進攻」信息，向其他人發送「撤退」信息\r\n- 修改忠誠將軍的消息內容\r\n- 與其他叛徒協調以最大化混亂\r\n\r\n當你無法區分忠誠將軍和叛徒，且無法信任通信渠道時，如何就「進攻」或「撤退」達成共識？\r\n\r\n這似乎是不可能的。幾十年來，計算機科學家認為不可能構建一個同時具備以下特性的系統：\r\n- 拜占庭容錯（即使有惡意參與者也能運行）\r\n- 無需許可（任何人都可以無需批准加入）\r\n- 去中心化（無中央權威）\r\n\r\n直到2008年，一位自稱中本聰的人證明了他們是錯的。\r\n\r\n### 比特幣：第一個區塊鏈\r\n\r\n比特幣是區塊鏈技術的第一個實際應用。雖然加密哈希、數字簽名、點對點網絡等組件早已存在，但中本聰是第一個將它們結合起來，解決數字貨幣雙重支付問題的人。\r\n\r\n區塊鏈（Blockchain），或稱為「區塊鏈條」，這個名稱最早出現在原始的比特幣[白皮書](https://bitcoin.org/bitcoin.pdf)中，最終創造了一個同時具備分佈式、拜占庭容錯性和無需許可的系統。\r\n\r\n這項突破並非試圖辨別誰值得信任，而是讓撒謊在經濟上比說真話更昂貴。工作量證明（Proof of Work）通過要求參與者消耗真實的計算能量來提出更改來實現這一點。攻擊者需要花費的電力成本將超過他們從攻擊中獲得的收益。","highlightedCode":{"code-0":{"lang":"python","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"def"}]},{"type":"element","tagName":"span","properties":{"style":"color:#62E884"},"children":[{"type":"text","value":" transfer"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"("}]},{"type":"element","tagName":"span","properties":{"style":"color:#FFB86C;font-style:italic"},"children":[{"type":"text","value":"from_account"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":", "}]},{"type":"element","tagName":"span","properties":{"style":"color:#FFB86C;font-style:italic"},"children":[{"type":"text","value":"to_account"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":", "}]},{"type":"element","tagName":"span","properties":{"style":"color:#FFB86C;font-style:italic"},"children":[{"type":"text","value":"amount"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"):"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"    if"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" from_account.balance "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":">="}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" amount:"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"        from_account.balance "}]},{"type":"element","tagName":"span","proper