t","value":"以太坊最初使用工作量证明（Proof of Work），但在 2022 年通过“合并”（The Merge）切换到了权益证明（Proof of Stake）。这一转变在保持安全性的同时带来了重要的优势：","position":{"start":{"line":55,"column":1,"offset":1772},"end":{"line":55,"column":102,"offset":1873}}}],"position":{"start":{"line":55,"column":1,"offset":1772},"end":{"line":55,"column":102,"offset":1873}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"数学终局性：大约 13 分钟后，交易变得数学上不可逆","position":{"start":{"line":56,"column":3,"offset":1877},"end":{"line":56,"column":29,"offset":1903}}}],"position":{"start":{"line":56,"column":3,"offset":1877},"end":{"line":56,"column":29,"offset":1903}}}],"position":{"start":{"line":56,"column":1,"offset":1875},"end":{"line":56,"column":29,"offset":1903}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"能源效率：不再需要大量电力消耗","position":{"start":{"line":57,"column":3,"offset":1907},"end":{"line":57,"column":18,"offset":1922}}}],"position":{"start":{"line":57,"column":3,"offset":1907},"end":{"line":57,"column":18,"offset":1922}}}],"position":{"start":{"line":57,"column":1,"offset":1905},"end":{"line":57,"column":18,"offset":1922}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"未来升级：权益证明支持分片技术，将网络分成并行链以提高吞吐量","position":{"start":{"line":58,"column":3,"offset":1926},"end":{"line":58,"column":33,"offset":1956}}}],"position":{"start":{"line":58,"column":3,"offset":1926},"end":{"line":58,"column":33,"offset":1956}}}],"position":{"start":{"line":58,"column":1,"offset":1924},"end":{"line":58,"column":33,"offset":1956}}}],"position":{"start":{"line":56,"column":1,"offset":1875},"end":{"line":58,"column":33,"offset":1956}}},{"type":"heading","depth":3,"children":[{"type":"text","value":"账户模型","position":{"start":{"line":60,"column":5,"offset":1964},"end":{"line":60,"column":9,"offset":1968}}}],"position":{"start":{"line":60,"column":1,"offset":1960},"end":{"line":60,"column":9,"offset":1968}}},{"type":"paragraph","children":[{"type":"text","value":"以太坊用更为熟悉的基于账户的余额系统取代了比特币的 UTXO 系统，从而实现了：","position":{"start":{"line":62,"column":1,"offset":1972},"end":{"line":62,"column":41,"offset":2012}}}],"position":{"start":{"line":62,"column":1,"offset":1972},"end":{"line":62,"column":41,"offset":2012}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"智能合约：驻留在区块链上的程序，能够维护自己的状态","position":{"start":{"line":63,"column":3,"offset":2016},"end":{"line":63,"column":28,"offset":2041}}}],"position":{"start":{"line":63,"column":3,"offset":2016},"end":{"line":63,"column":28,"offset":2041}}}],"position":{"start":{"line":63,"column":1,"offset":2014},"end":{"line":63,"column":28,"offset":2041}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"外部账户：类似于比特币地址的用户控制账户","position":{"start":{"line":64,"column":3,"offset":2045},"end":{"line":64,"column":23,"offset":2065}}}],"position":{"start":{"line":64,"column":3,"offset":2045},"end":{"line":64,"column":23,"offset":2065}}}],"position":{"start":{"line":64,"column":1,"offset":2043},"end":{"line":64,"column":23,"offset":2065}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"合约间调用：智能合约可以无缝地相互交互","position":{"start":{"line":65,"column":3,"offset":2069},"end":{"line":65,"column":22,"offset":2088}}}],"position":{"start":{"line":65,"column":3,"offset":2069},"end":{"line":65,"column":22,"offset":2088}}}],"position":{"start":{"line":65,"column":1,"offset":2067},"end":{"line":65,"column":22,"offset":2088}}}],"position":{"start":{"line":63,"column":1,"offset":2014},"end":{"line":65,"column":22,"offset":2088}}},{"type":"paragraph","children":