t","value":"安全假設是攻擊的電力成本高於攻擊者可能獲得的收益。","position":{"start":{"line":37,"column":1,"offset":997},"end":{"line":37,"column":26,"offset":1022}}}],"position":{"start":{"line":37,"column":1,"offset":997},"end":{"line":37,"column":26,"offset":1022}}},{"type":"heading","depth":3,"children":[{"type":"text","value":"權益證明（Proof of Stake）","position":{"start":{"line":39,"column":5,"offset":1030},"end":{"line":39,"column":25,"offset":1050}}}],"position":{"start":{"line":39,"column":1,"offset":1026},"end":{"line":39,"column":25,"offset":1050}}},{"type":"paragraph","children":[{"type":"text","value":"在權益證明系統中，參與者不是消耗電力，而是將自己的資金置於風險之中：","position":{"start":{"line":41,"column":1,"offset":1054},"end":{"line":41,"column":35,"offset":1088}}}],"position":{"start":{"line":41,"column":1,"offset":1054},"end":{"line":41,"column":35,"offset":1088}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"參與者將加密貨幣代幣鎖定作為抵押","position":{"start":{"line":42,"column":3,"offset":1092},"end":{"line":42,"column":19,"offset":1108}}}],"position":{"start":{"line":42,"column":3,"offset":1092},"end":{"line":42,"column":19,"offset":1108}}}],"position":{"start":{"line":42,"column":1,"offset":1090},"end":{"line":42,"column":19,"offset":1108}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"協議隨機選擇驗證者來提議區塊，選擇的權重取決於他們的權益","position":{"start":{"line":43,"column":3,"offset":1112},"end":{"line":43,"column":31,"offset":1140}}}],"position":{"start":{"line":43,"column":3,"offset":1112},"end":{"line":43,"column":31,"offset":1140}}}],"position":{"start":{"line":43,"column":1,"offset":1110},"end":{"line":43,"column":31,"offset":1140}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"被選中的驗證者提議區塊，其他驗證者投票接受或拒絕","position":{"start":{"line":44,"column":3,"off