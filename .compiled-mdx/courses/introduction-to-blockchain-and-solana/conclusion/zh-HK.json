{"mdast":{"type":"root","children":[{"type":"mdxjsEsm","value":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";","position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":1,"column":87,"offset":86}},"data":{"estree":{"type":"Program","start":0,"end":86,"loc":{"start":{"line":1,"column":0,"offset":0},"end":{"line":1,"column":86,"offset":86}},"body":[{"type":"ImportDeclaration","start":0,"end":86,"loc":{"start":{"line":1,"column":0,"offset":0},"end":{"line":1,"column":86,"offset":86}},"specifiers":[{"type":"ImportSpecifier","start":9,"end":23,"loc":{"start":{"line":1,"column":9,"offset":9},"end":{"line":1,"column":23,"offset":23}},"imported":{"type":"Identifier","start":9,"end":23,"loc":{"start":{"line":1,"column":9,"offset":9},"end":{"line":1,"column":23,"offset":23}},"name":"ArticleSection","range":[9,23]},"local":{"type":"Identifier","start":9,"end":23,"loc":{"start":{"line":1,"column":9,"offset":9},"end":{"line":1,"column":23,"offset":23}},"name":"ArticleSection","range":[9,23]},"range":[9,23]}],"source":{"type":"Literal","start":31,"end":85,"loc":{"start":{"line":1,"column":31,"offset":31},"end":{"line":1,"column":85,"offset":85}},"value":"../../../../components/ArticleSection/ArticleSection","raw":"\"../../../../components/ArticleSection/ArticleSection\"","range":[31,85]},"range":[0,86]}],"sourceType":"module","comments":[],"range":[0,86]}}},{"type":"heading","depth":1,"children":[{"type":"text","value":"結論","position":{"start":{"line":3,"column":3,"offset":92},"end":{"line":3,"column":5,"offset":94}}}],"position":{"start":{"line":3,"column":1,"offset":90},"end":{"line":3,"column":5,"offset":94}}},{"type":"paragraph","children":[{"type":"text","value":"恭喜你！你已完成區塊鏈與 Solana 入門課程。現在，你對區塊鏈的基本概念以及 Solana 作為高性能區塊鏈的運作方式有了扎實的理解。","position":{"start":{"line":5,"column":1,"offset":98},"end":{"line":5,"column":70,"offset":167}}}],"position":{"start":{"line":5,"column":1,"offset":98},"end":{"line":5,"column":70,"offset":167}