"offset":1903}}}],"position":{"start":{"line":21,"column":1,"offset":1760},"end":{"line":21,"column":144,"offset":1903}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Cập nhật thường xuyên: Theo dõi ","position":{"start":{"line":22,"column":4,"offset":1908},"end":{"line":22,"column":36,"offset":1940}}},{"type":"link","title":null,"url":"https://github.com/LiteSVM/litesvm","children":[{"type":"text","value":"kho lưu trữ LiteSVM","position":{"start":{"line":22,"column":37,"offset":1941},"end":{"line":22,"column":56,"offset":1960}}}],"position":{"start":{"line":22,"column":36,"offset":1940},"end":{"line":22,"column":93,"offset":1997}}},{"type":"text","value":" để biết các tính năng mới nhất, các ràng buộc ngôn ngữ và cải tiến hiệu suất","position":{"start":{"line":22,"column":93,"offset":1997},"end":{"line":22,"column":170,"offset":2074}}}],"position":{"start":{"line":22,"column":4,"offset":1908},"end":{"line":22,"column":170,"offset":2074}}}],"position":{"start":{"line":22,"column":1,"offset":1905},"end":{"line":22,"column":170,"offset":2074}}}],"position":{"start":{"line":18,"column":1,"offset":1323},"end":{"line":22,"column":170,"offset":2074}}},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"Đặc biệt cảm ơn ","position":{"start":{"line":24,"column":3,"offset":2080},"end":{"line":24,"column":19,"offset":2096}}},{"type":"link","title":null,"url":"https://x.com/exoaursen","children":[{"type":"text","value":"Aursen","position":{"start":{"line":24,"column":20,"offset":2097},"end":{"line":24,"column":26,"offset":2103}}}],"position":{"start":{"line":24,"column":19,"offset":2096},"end":{"line":24,"column":52,"offset":2129}}},{"type":"text","value":" và đội ngũ ","position":{"start":{"line":24,"column":52,"offset":2129},"end":{"line":24,"column":64,"offset":2141}}},{"type":"link","title":null,"url":"https://x.com/exotic_markets_","children":[{"type":"text","value":"Exotic Markets","position":{"start":{"line":24,"column":65,"offset":2142},"end":{"line":24,"column":79,"offset":2156}}}],"position":{"start":{"line":24,"column":64,"offset":2141},"end":{"line":24,"column":111,"offset":2188}}},{"type":"text","value":" đã tạo ra và duy trì LiteSVM, giúp việc kiểm thử chương trình Solana hiệu suất cao trở nên dễ tiếp cận với các nhà phát triển trên nhiều ngôn ngữ khác nhau.","position":{"start":{"line":24,"column":111,"offset":2188},"end":{"line":24,"column":268,"offset":2345}}}],"position":{"start":{"line":24,"column":3,"offset":2080},"end":{"line":24,"column":268,"offset":2345}}}],"position":{"start":{"line":24,"column":1,"offset":2078},"end":{"line":24,"column":268,"offset":2345}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":24,"column":268,"offset":2345}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Kết luận\r\n\r\nXin chúc mừng! Bạn đã hoàn thành khóa học Kiểm thử với LiteSVM. Giờ đây bạn đã có hiểu biết toàn diện về cách sử dụng LiteSVM, một framework kiểm thử nhanh và nhẹ mang Solana Virtual Machine trực tiếp vào quy trình kiểm thử của bạn để lặp lại nhanh chóng và kiểm thử chương trình chính xác.\r\n\r\n<ArticleSection name=\"Những gì bạn đã học\" id=\"what-you-learned\" level=\"h2\" />\r\n\r\nTrong suốt khóa học này, bạn đã nắm vững các khái niệm thiết yếu của LiteSVM:\r\n- **Lợi thế về hiệu suất**: Cách VM trong quy trình của LiteSVM mang lại tốc độ thực thi nhanh hơn đáng kể so với các framework kiểm thử truyền thống\r\n- **Quản lý tài khoản**: Tạo và cấu hình tài khoản hệ thống, tài khoản chương trình và tài khoản SPL token cho các kịch bản kiểm thử toàn diện\r\n- **Thực thi giao dịch**: Thiết lập, mô phỏng và thực hiện các giao dịch với việc kiểm tra kết quả đúng cách\r\n- **Kiểm soát nâng cao**: Thao tác với sysvars, kiểm soát hành vi runtime và tùy chỉnh môi trường kiểm thử\r\n\r\n<ArticleSection name=\"Các bước tiếp theo\" id=\"next-steps\" level=\"h2\" />\r\n\r\nBạn đã được trang bị để xây dựng các bài kiểm thử nhanh, đáng tin cậy cho các chương trình Solana của mình bằng LiteSVM! Dưới đây là một số bước tiếp theo được khuyến nghị:\r\n1. Áp dụng vào dự án của bạn: Tích hợp LiteSVM vào bộ kiểm thử chương trình Solana hiện có và trải nghiệm cải thiện hiệu suất trực tiếp\r\n2. Khám phá kiểm thử nâng cao: Sử dụng khả năng thao tác tài khoản của LiteSVM để kiểm thử các trường hợp biên phức tạp và kịch bản lỗi khó tái tạo với các framework khác\r\n3. Đánh giá hiệu suất: Tận dụng tốc độ của LiteSVM để chạy bộ kiểm thử toàn diện trong quá trình phát triển và quy trình CI/CD\r\n4. Tham gia cộng đồng: Kết nối với các nhà phát triển khác đang sử dụng LiteSVM trên Discord và chia sẻ chiến lược kiểm thử cũng như tối ưu hóa\r\n5. Cập nhật thường xuyên: Theo dõi [kho lưu trữ LiteSVM](https://github.com/LiteSVM/litesvm) để biết các tính năng mới nhất, các ràng buộc ngôn ngữ và cải tiến hiệu suất\r\n\r\n> Đặc biệt cảm ơn [Aursen](https://x.com/exoaursen) và đội ngũ [Exotic Markets](https://x.com/exotic_markets_) đã tạo ra và duy trì LiteSVM, giúp việc kiểm thử chương trình Solana hiệu suất cao trở nên dễ tiếp cận với các nhà phát triển trên nhiều ngôn ngữ khác nhau.","highlightedCode":{}}