":16,"column":336,"offset":1127}}},{"type":"paragraph","children":[{"type":"text","value":"Unlike traditional testing approaches that spawn separate validator processes, LiteSVM embeds the VM within your tests. This architecture delivers dramatically faster compilation and execution times without sacrificing testing accuracy.","position":{"start":{"line":18,"column":1,"offset":1131},"end":{"line":18,"column":237,"offset":1367}}}],"position":{"start":{"line":18,"column":1,"offset":1131},"end":{"line":18,"column":237,"offset":1367}}},{"type":"paragraph","children":[{"type":"text","value":"The library offers an intuitive API with smart defaults for quick setup, plus extensive configuration options for advanced testing scenarios.","position":{"start":{"line":20,"column":1,"offset":1371},"end":{"line":20,"column":142,"offset":1512}}}],"position":{"start":{"line":20,"column":1,"offset":1371},"end":{"line":20,"column":143,"offset":1513}}},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"LiteSVM supports Rust, TypeScript/JavaScript, and Python (via ","position":{"start":{"line":22,"column":3,"offset":1519},"end":{"line":22,"column":65,"offset":1581}}},{"type":"inlineCode","value":"solders","position":{"start":{"line":22,"column":65,"offset":1581},"end":{"line":22,"column":74,"offset":1590}}},{"type":"text","value":").","position":{"start":{"line":22,"column":74,"offset":1590},"end":{"line":22,"column":76,"offset":1592}}}],"position":{"start":{"line":22,"column":3,"offset":1519},"end":{"line":22,"column":76,"offset":1592}}}],"position":{"start":{"line":22,"column":1,"offset":1517},"end":{"line":22,"column":76,"offset":1592}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":22,"column":76,"offset":1592}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# LiteSVM 101\r\n\r\n![Testing with LiteSVM](/graphics/course-banners/testing-with-litesvm.png)\r\n\r\nSolana program testing traditionally forces you to choose between speed and accuracy. LiteSVM eliminates this tradeoff by delivering an in-process testing environment that's both lightning-fast and feature-complete.\r\n\r\nLiteSVM provides three critical advantages for Solana developers:\r\n- **Faster execution** compared to `solana-program-test` and `solana-test-validator`\r\n- **Direct account state manipulation** for testing complex edge cases\r\n- **Built-in performance profiling** for identifying optimization and improvements\r\n\r\n<ArticleSection name=\"What is LiteSVM\" id=\"what-is-litesvm\" level=\"h2\" />\r\n\r\n[LiteSVM](https://github.com/LiteSVM/litesvm) is a lightweight Solana Virtual Machine that runs directly in your test process. Created by [Aursen](https://x.com/exoaursen) from [Exotic Markets](https://x.com/exotic_markets_), it eliminates the overhead of external validators while maintaining full compatibility with Solana's runtime.\r\n\r\nUnlike traditional testing approaches that spawn separate validator processes, LiteSVM embeds the VM within your tests. This architecture delivers dramatically faster compilation and execution times without sacrificing testing accuracy.\r\n\r\nThe library offers an intuitive API with smart defaults for quick setup, plus extensive configuration options for advanced testing scenarios. \r\n\r\n> LiteSVM supports Rust, TypeScript/JavaScript, and Python (via `solders`).","highlightedCode":{}}