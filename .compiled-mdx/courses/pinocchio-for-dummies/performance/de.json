es Programms überprüfe ihre Korrektheit, indem du die erwartete Adresse direkt so ableitest:","position":{"start":{"line":25,"column":1,"offset":2137},"end":{"line":25,"column":199,"offset":2335}}}],"position":{"start":{"line":25,"column":1,"offset":2137},"end":{"line":25,"column":199,"offset":2335}}},{"type":"code","lang":"rust","meta":null,"value":"let (associated_token_account, _) = find_program_address(\r\n    &[\r\n        self.accounts.owner.key(),\r\n        self.accounts.token_program.key(),\r\n        self.accounts.mint.key(),\r\n    ],\r\n    &pinocchio_associated_token_account::ID,\r\n);","position":{"start":{"line":27,"column":1,"offset":2339},"end":{"line":36,"column":4,"offset":2591}},"data":{"highlightId":"code-0"}},{"type":"paragraph","children":[{"type":"text","value":"Durch die Minimierung unnötiger Prüfungen und Kontoanforderungen reduzierst du die Rechenkosten und optimierst die Ausführung deines Programms; so entfaltest du das volle Leistungspotenzial der nativen Solana-Entwicklung.","position":{"start":{"line":38,"column":1,"offset":2595},"end":{"line":38,"column":222,"offset":2816}}}],"position":{"start":{"line":38,"column":1,"offset":2595},"end":{"line":38,"column":222,"offset":2816}}},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"Das Hinzufügen von Prüfungen, um den Befehl frühzeitig fehlschlagen zu lassen, hat seine Vorteile, da die verbrauchten Recheneinheiten definitiv niedriger sein werden. Überlege also, ob der Befehl hauptsächlich mit Flags wie ","position":{"start":{"line":40,"column":3,"offset":2822},"end":{"line":40,"column":228,"offset":3047}}},{"type":"inlineCode","value":"{ skipPreflight: true }","position":{"start":{"line":40,"column":228,"offset":3047},"end":{"line":40,"column":253,"offset":3072}}},{"type":"text","value":" verwendet wird.","position":{"start":{"line":40,"column":253,"offset":3072},"end":{"line":40,"column":269,"offset":3088}}}],"position":{"start":{"line":40,"column":3