,"offset":3784}}},{"type":"paragraph","children":[{"type":"text","value":"Anda dapat menggunakan atribut kompilasi kondisional Rust untuk menyertakan atau mengecualikan kode berdasarkan fitur yang aktif. Contohnya:","position":{"start":{"line":62,"column":1,"offset":3788},"end":{"line":62,"column":141,"offset":3928}}}],"position":{"start":{"line":62,"column":1,"offset":3788},"end":{"line":62,"column":141,"offset":3928}}},{"type":"code","lang":"rust","meta":null,"value":"pub fn process(ctx: Context<'info>) -> ProgramResult {\r\n    #[cfg(not(feature = \"perf\"))]\r\n    sol_log(\"Create Class\");\r\n    Self::try_from(ctx)?.execute()\r\n}","position":{"start":{"line":64,"column":1,"offset":3932},"end":{"line":70,"column":4,"offset":4104}},"data":{"highlightId":"code-2"}},{"type":"paragraph","children":[{"type":"text","value":"Kebanyakan program mengembalikan nama instruksi sebagai log untuk memudahkan debugging dan memastikan bahwa instruksi yang benar dipanggil.","position":{"start":{"line":72,"column":1,"offset":4108},"end":{"line":72,"column":140,"offset":4247}}}],"position":{"start":{"line":72,"column":1,"offset":4108},"end":{"line":72,"column":140,"offset":4247}}},{"type":"paragraph","children":[{"type":"text","value":"Namun, ini mahal dan sebenarnya tidak diperlukan kecuali untuk membuat explorer lebih mudah dibaca dan untuk meningkatkan debugging.","position":{"start":{"line":74,"column":1,"offset":4251},"end":{"line":74,"column":133,"offset":4383}}}],"position":{"start":{"line":74,"column":1,"offset":4251},"end":{"line":74,"column":133,"offset":4383}}},{"type":"code","lang":"rust","meta":null,"value":"#[cfg(not(feature = \"perf\"))]\r\nif name.len() > MAX_NAME_LEN {\r\n    return Err(ProgramError::InvalidArgument);\r\n}","position":{"start":{"line":76,"column":1,"offset":4387},"end":{"line":81,"column":4,"offset":4513}},"data":{"highlightId":"code-3"}},{"type":"paragraph","children":[{"type":"text","value":"Contoh lain adalah pemeriksaan berlebihan yang telah