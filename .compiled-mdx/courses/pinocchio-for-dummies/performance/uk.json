lumn":174,"offset":283}}}],"position":{"start":{"line":5,"column":1,"offset":110},"end":{"line":5,"column":175,"offset":284}}},{"type":"paragraph","children":[{"type":"text","value":"У цьому розділі ми розглянемо практичні стратегії для досягнення оптимальної ефективності у ваших програмах Solana.","position":{"start":{"line":7,"column":1,"offset":288},"end":{"line":7,"column":116,"offset":403}}}],"position":{"start":{"line":7,"column":1,"offset":288},"end":{"line":7,"column":116,"offset":403}}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Superfluous Checks","position":{"start":{"line":9,"column":17,"offset":423},"end":{"line":9,"column":42,"offset":448}}},{"type":"mdxJsxAttribute","name":"id","value":"superfluous-checks","position":{"start":{"line":9,"column":43,"offset":449},"end":{"line":9,"column":66,"offset":472}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":9,"column":67,"offset":473},"end":{"line":9,"column":77,"offset":483}}}],"children":[],"position":{"start":{"line":9,"column":1,"offset":407},"end":{"line":9,"column":80,"offset":486}}},{"type":"paragraph","children":[{"type":"text","value":"Розробники часто додають додаткові обмеження для облікових записів з міркувань безпеки, але це може створювати непотрібні накладні витрати. Важливо розрізняти необхідні та надлишкові перевірки.","position":{"start":{"line":11,"column":1,"offset":490},"end":{"line":11,"column":194,"offset":683}}}],"position":{"start":{"line":11,"column":1,"offset":490},"end":{"line":11,"column":194,"offset":683}}},{"type":"paragraph","children":[{"type":"text","value":"Наприклад, коли просто читаєте з ","position":{"start":{"line":13,"column":1,"offset":687},"end":{"line":13,"column":34,"offset":720}}},{"type":"inlineCode","value":"Token Account","position":{"start":{"line":13,"column":34,"offset":720},"end":{"line":13,"column":49,"offset":735}}},{"type":"text","value":" або ","position":{"start":{"line":13,"column":49,"offset":735},"end":{"line":13,"column":54,"offset":740}}},{"type":"inlineCode","value":"Mint","position":{"start":{"line":13,"column":54,"offset":740},"end":{"line":13,"column":60,"offset":746}}},{"type":"text","value":", десеріалізація та валідація необхідні. Але якщо ці самі облікові записи пізніше використовуються в CPI (Cross-Program Invocation), будь-яка невідповідність або помилка призведе до збою інструкції в цей момент. Таким чином, попередні перевірки можуть бути надлишковими.","position":{"start":{"line":13,"column":60,"offset":746},"end":{"line":13,"column":330,"offset":1016}}}],"position":{"start":{"line":13,"column":1,"offset":687},"end":{"line":13,"column":330,"offset":1016}}},{"type":"paragraph","children":[{"type":"text","value":"Аналогічно, перевірка \"власника\" токен-акаунта часто є зайвою; особливо якщо обліковий запис контролюється PDA (Program Derived Address). Якщо власник неправильний, CPI не вдасться через недійсні сіди. У випадках, коли переказ не виконується через PDA, вам слід зосередитися на перевірці отримувача, особливо при внесенні коштів на рахунок, контрольований PDA, оскільки інтереси відправника узгоджені з інтересами програми.","position":{"start":{"line":15,"column":1,"offset":1020},"end":{"line":15,"column":424,"offset":1443}}}],"position":{"start":{"line":15,"column":1,"offset":1020},"end":{"line":15,"column":424,"offset":1443}}},{"type":"paragraph","children":[{"type":"text","value":"Розглянемо приклад ","position":{"start":{"line":17,"column":1,"offset":1447},"end":{"line":17,"column":20,"offset":1466}}},{"type":"inlineCode","value":"Escrow","position":{"start":{"line":17,"column":20,"offset":1466},"end":{"line":17,"column":28,"offset":1474}}},{"type":"text","value":":","position":{"start":{"line":17,"column":28,"offset":1474},"end":{"line":17,"column":29,"offset":1475}}}],"position":{"start":{"line":17,"column":1,"offset":1447},"end":{"line":17,"column":29,"offset":1475}}},{"type":"paragraph","children":[{"type":"text","value":"...","position":{"start":{"line":19,"column":1,"offset":1479},"end":{"line":19,"column":4,"offset":1482}}}],"position":{"start":{"line":19,"column":1,"offset":1479},"end":{"line":19,"column":4,"offset":1482}}},{"type":"heading","depth":3,"children":[{"type":"text","value":"Associated Token Program","position":{"start":{"line":21,"column":5,"offset":1490},"end":{"line":21,"column":29,"offset":1514}}}],"position":{"start":{"line":21,"column":1,"offset":1486},"end":{"line":21,"column":29,"offset":1514}}},{"type":"paragraph","children":[{"type":"inlineCode","value":"Associated Token Accounts","position":{"start":{"line":23,"column":1,"offset":1518},"end":{"line":23,"column":28,"offset":1545}}},{"type":"text","value":" (ATA) зручні, але мають вартість продуктивності. Уникайте примусового їх використання, якщо це не є абсолютно необхідним, і ніколи не вимагайте їх створення в логіці ваших інструкцій. Для більшості сценаріїв шаблон ","position":{"start":{"line":23,"column":28,"offset":1545},"end":{"line":23,"column":244,"offset":1761}}},{"type":"inlineCode","value":"init-if-needed","position":{"start":{"line":23,"column":244,"offset":1761},"end":{"line":23,"column":260,"offset":1777}}},{"type":"text","value":" додає непотрібну складність і використання ресурсів (як у інструкціях Amm, які складаються маршрутизаторами на кшталт Jupiter).","position":{"start":{"line":23,"column":260,"offset":1777},"end":{"line":23,"column":388,"offset":1905}}}],"position":{"start":{"line":23,"column":1,"offset":1518},"end":{"line":23,"column":388,"offset":1905}}},{"type":"paragraph","children":[{"type":"text","value":"Якщо ваша програма покладається на ATA, переконайтеся, що вони створені зовнішньо. У вашій програмі перевіряйте їхню правильність, безпосередньо виводячи очікувану адресу таким чином:","position":{"start":{"line":25,"column":1,"offset":1909},"end":{"line":25,"column":184,"offset":2092}}}],"position":{"start":{"line":25,"column":1,"offset":1909},"end":{"line":25,"column":184,"offset":2092}}},{"type":"code","lang":"rust","meta":null,"value":"let (associated_token_account, _) = find_program_address(\r\n    &[\r\n        self.accounts.owner.key(),\r\n        self.accounts.token_program.key(),\r\n        self.accounts.mint.key(),\r\n    ],\r\n    &pinocchio_associated_token_account::ID,\r\n);","position":{"start":{"line":27,"column":1,"offset":2096},"end":{"line":36,"column":4,"offset":2348}},"data":{"highlightId":"code-0"}},{"type":"paragraph","children":[{"type":"text","value":"Мінімізуючи непотрібні перевірки та вимоги до облікових записів, ви зменшуєте обчислювальні витрати та оптимізуєте виконання вашої програми, розкриваючи повний потенціал продуктивності нативної розробки на Solana.","position":{"start":{"line":38,"column":1,"offset":2352},"end":{"line":38,"column":214,"offset":2565}}}],"position":{"start":{"line":38,"column":1,"offset":2352},"end":{"line":38,"column":214,"offset":2565}}},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"Додавання перевірок для раннього завершення інструкції має свої переваги, оскільки спожиті обчислювальні одиниці будуть точно нижчими. Тому подумайте, чи інструкція буде в основному використовуватися з прапорцями на кшталт ","position":{"start":{"line":40,"column":3,"offset":2571},"end":{"line":40,"column":226,"offset":2794}}},{"type":"inlineCode","value":"{ skipPreflight: true }","position":{"start":{"line":40,"column":226,"offset":2794},"end":{"line":40,"column":251,"offset":2819}}},{"type":"text","value":".","position":{"start":{"line":40,"column":251,"offset":2819},"end":{"line":40,"column":252,"offset":2820}}}],"position":{"start":{"line":40,"column":3,"offset":2571},"end":{"line":40,"column":252,"offset":2820}}}],"position":{"start":{"line":40,"column":1,"offset":2569},"end":{"line":40,"column":252,"offset":2820}}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"n