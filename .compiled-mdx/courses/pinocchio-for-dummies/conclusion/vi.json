ffset":1324}}}],"position":{"start":{"line":23,"column":1,"offset":1250},"end":{"line":23,"column":75,"offset":1324}}}],"position":{"start":{"line":20,"column":1,"offset":1083},"end":{"line":23,"column":75,"offset":1324}}},{"type":"paragraph","children":[{"type":"text","value":"Hãy nhớ rằng, mọi nhà phát triển giỏi đều bắt đầu với chương trình đầu tiên của họ. Đừng ngại thử nghiệm và mắc lỗi; đó là cách chúng ta học hỏi và phát triển!","position":{"start":{"line":25,"column":1,"offset":1328},"end":{"line":25,"column":160,"offset":1487}}}],"position":{"start":{"line":25,"column":1,"offset":1328},"end":{"line":25,"column":160,"offset":1487}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":26,"column":1,"offset":1489}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\nimport { AnchorDiscriminatorCalculator } from \"../../../../components/AnchorDiscriminatorCalculator/AnchorDiscriminatorCalculator\";\r\n\r\n# Kết luận\r\n\r\nChúc mừng! Bạn đã hoàn thành khóa học Introduction to Pinocchio. Giờ đây bạn đã có nền tảng vững chắc trong việc hiểu cách Pinocchio hoạt động, từ các khái niệm cốt lõi đến chi tiết triển khai thực tế.\r\n\r\n<ArticleSection name=\"Những gì bạn đã học\" id=\"what-you-learned\" level=\"h2\" />\r\n\r\nTrong suốt khóa học này, bạn đã có được kiến thức thiết yếu về:\r\n- Các nguyên tắc cơ bản của Pinocchio\r\n- Cách cấu trúc các chương trình Pinocchio\r\n- Hiểu về discriminator, trait `TryFrom`, account và instruction\r\n- Các thực hành tốt nhất để xây dựng các chương trình Solana an toàn\r\n\r\n<ArticleSection name=\"Các bước tiếp theo\" id=\"next-steps\" level=\"h2\" />\r\n\r\nBây giờ bạn đã sẵn sàng để bắt đầu xây dựng chương trình đầu tiên của mình với Pinocchio! Cách tốt nhất để củng cố kiến thức của bạn là thông qua thực hành trực tiếp. Chúng tôi khuyến khích bạn:\r\n\r\n1. Đến [phần Thử thách](/vi/challenges)\r\n2. Bắt đầu với các bài tập thân thiện với người mới bắt đầu\r\n3. Xây dựng và kiểm tra chương trình Pinocchio đầu tiên của bạn\r\n4. Tham gia cộng đồng của chúng tôi để chia sẻ tiến trình và nhận trợ giúp\r\n\r\nHãy nhớ rằng, mọi nhà phát triển giỏi đều bắt đầu với chương trình đầu tiên của họ. Đừng ngại thử nghiệm và mắc lỗi; đó là cách chúng ta học hỏi và phát triển!\r\n","highlightedCode":{}}