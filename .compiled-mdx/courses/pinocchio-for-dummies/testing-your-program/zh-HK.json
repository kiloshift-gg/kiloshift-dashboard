。","position":{"start":{"line":19,"column":45,"offset":488},"end":{"line":19,"column":62,"offset":505}}}],"position":{"start":{"line":19,"column":1,"offset":444},"end":{"line":19,"column":62,"offset":505}}},{"type":"paragraph","children":[{"type":"text","value":"要測試你的 pinocchio 程式，只需在你的 ","position":{"start":{"line":21,"column":1,"offset":509},"end":{"line":21,"column":26,"offset":534}}},{"type":"inlineCode","value":"test.rs","position":{"start":{"line":21,"column":26,"offset":534},"end":{"line":21,"column":35,"offset":543}}},{"type":"text","value":" 文件中使用 ","position":{"start":{"line":21,"column":35,"offset":543},"end":{"line":21,"column":42,"offset":550}}},{"type":"inlineCode","value":"test","position":{"start":{"line":21,"column":42,"offset":550},"end":{"line":21,"column":48,"offset":556}}},{"type":"text","value":" 配置標誌進行導入，並在 ","position":{"start":{"line":21,"column":48,"offset":556},"end":{"line":21,"column":61,"offset":569}}},{"type":"inlineCode","value":"lib.rs","position":{"start":{"line":21,"column":61,"offset":569},"end":{"line":21,"column":69,"offset":577}}},{"type":"text","value":" 中執行：","position":{"start":{"line":21,"column":69,"offset":577},"end":{"line":21,"column":74,"offset":582}}}],"position":{"start":{"line":21,"column":1,"offset":509},"end":{"line":21,"column":74,"offset":582}}},{"type":"code","lang":"rust","meta":null,"value":"#[cfg(test)]\r\npub mod tests;","position":{"start":{"line":23,"column":1,"offset":586},"end":{"line":26,"column":4,"offset":628}},"data":{"highlightId":"code-0"}},{"type":"paragraph","children":[{"type":"text","value":"使用以下命令運行你的測試：","position":{"start":{"line":28,"column":1,"offset":632},"end":{"line":28,"column":14,"offset":645}}}],"position":{"start":{"line":28,"column":1,"offset":632},"end":{"line":28,"column":14,"offset":645}}},{"type":"code","lang":null,"meta":null,"value":"cargo test-sbf","position":{"start":{"line":30,"column":1,"offset":649},"end":{"line":32,"column":4,"offset":673}},"data":{"highlightId":"code-1"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":32,"column":4,"offset":673}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# 測試你的程式  \r\n\r\n在主網部署之前，徹底測試是必不可少的，這樣可以識別潛在的漏洞和問題。\r\n\r\n經過充分測試的程式可以防止財務損失、建立用戶信任，並確保應用程式在各種情況下正確運行。\r\n\r\n<ArticleSection name=\"Mollusk Tests\" id=\"mollusk-tests\" level=\"h2\" />\r\n\r\n當設置複雜的程式狀態或需要進行複雜的鏈上交互變得困難時，Mollusk 提供了對測試環境更細緻的控制。\r\n\r\nMollusk 是一個專為 Solana 程式設計的 Rust 測試框架，它能夠讓你：\r\n- 在沒有網絡負擔的情況下獨立測試程式邏輯\r\n- 輕鬆設置複雜的賬戶狀態和程式條件\r\n- 測試速度比完整的集成測試更快\r\n- 模擬特定的區塊鏈條件和邊界情況\r\n\r\n我們在[這裡](/zh-HK/courses/testing-with-mollusk)詳細介紹了 Mollusk 測試。\r\n\r\n要測試你的 pinocchio 程式，只需在你的 `test.rs` 文件中使用 `test` 配置標誌進行導入，並在 `lib.rs` 中執行：\r\n\r\n```rust\r\n#[cfg(test)]\r\npub mod tests;\r\n```\r\n\r\n使用以下命令運行你的測試：\r\n\r\n```\r\ncargo test-sbf\r\n```","highlightedCode":{"code-0":{"lang":"rust","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"#[cfg(test)]"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"pub"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":" mod"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" tests;"}]}]}]}]}]}},"code-1":{"lang":"text","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{},"children":[{"type":"text","value":"cargo test-sbf"}]}]}]}]}]}}}}