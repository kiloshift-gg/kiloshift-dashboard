mn":1,"offset":1041},"end":{"line":17,"column":65,"offset":1105}}}],"position":{"start":{"line":14,"column":1,"offset":797},"end":{"line":17,"column":65,"offset":1105}}},{"type":"paragraph","children":[{"type":"text","value":"Chúng tôi đã đề cập đến việc kiểm thử Mollusk một cách chi tiết ","position":{"start":{"line":19,"column":1,"offset":1109},"end":{"line":19,"column":65,"offset":1173}}},{"type":"link","title":null,"url":"/vi/courses/testing-with-mollusk","children":[{"type":"text","value":"tại đây","position":{"start":{"line":19,"column":66,"offset":1174},"end":{"line":19,"column":73,"offset":1181}}}],"position":{"start":{"line":19,"column":65,"offset":1173},"end":{"line":19,"column":108,"offset":1216}}},{"type":"text","value":".","position":{"start":{"line":19,"column":108,"offset":1216},"end":{"line":19,"column":109,"offset":1217}}}],"position":{"start":{"line":19,"column":1,"offset":1109},"end":{"line":19,"column":109,"offset":1217}}},{"type":"paragraph","children":[{"type":"text","value":"Để kiểm thử chương trình pinocchio của bạn, chỉ cần import tệp ","position":{"start":{"line":21,"column":1,"offset":1221},"end":{"line":21,"column":64,"offset":1284}}},{"type":"inlineCode","value":"test.rs","position":{"start":{"line":21,"column":64,"offset":1284},"end":{"line":21,"column":73,"offset":1293}}},{"type":"text","value":" của bạn với cờ cấu hình ","position":{"start":{"line":21,"column":73,"offset":1293},"end":{"line":21,"column":98,"offset":1318}}},{"type":"inlineCode","value":"test","position":{"start":{"line":21,"column":98,"offset":1318},"end":{"line":21,"column":104,"offset":1324}}},{"type":"text","value":" trong tệp ","position":{"start":{"line":21,"column":104,"offset":1324},"end":{"line":21,"column":115,"offset":1335}}},{"type":"inlineCode","value":"lib.rs","position":{"start":{"line":21,"column":115,"offset":1335},"end":{"line":21,"column":123,"offset":1343}}},{"type":"text","value":" của bạn:","position":{"start":{"line":21,"column":123,"offset":1343},"end":{"line":21,"column":132,"offset":1352}}}],"position":{"start":{"line":21,"column":1,"offset":1221},"end":{"line":21,"column":132,"offset":1352}}},{"type":"code","lang":"rust","meta":null,"value":"#[cfg(test)]\r\npub mod tests;","position":{"start":{"line":23,"column":1,"offset":1356},"end":{"line":26,"column":4,"offset":1398}},"data":{"highlightId":"code-0"}},{"type":"paragraph","children":[{"type":"text","value":"Chạy các kiểm thử của bạn bằng lệnh:","position":{"start":{"line":28,"column":1,"offset":1402},"end":{"line":28,"column":37,"offset":1438}}}],"position":{"start":{"line":28,"column":1,"offset":1402},"end":{"line":28,"column":37,"offset":1438}}},{"type":"code","lang":null,"meta":null,"value":"cargo test-sbf","position":{"start":{"line":30,"column":1,"offset":1442},"end":{"line":32,"column":4,"offset":1466}},"data":{"highlightId":"code-1"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":32,"column":4,"offset":1466}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Kiểm thử chương trình của bạn  \r\n\r\nThông qua việc kiểm thử, bạn có thể phát hiện các lỗi và lỗ hổng tiềm ẩn trước khi triển khai lên mainnet.\r\n\r\nCác chương trình được kiểm thử kỹ lưỡng giúp ngăn chặn tổn thất tài chính, xây dựng lòng tin của người dùng và đảm bảo ứng dụng hoạt động chính xác trong nhiều điều kiện khác nhau.\r\n\r\n<ArticleSection name=\"Kiểm thử bằng Mollusk\" id=\"mollusk-tests\" level=\"h2\" />\r\n\r\nKhi thiết lập các trạng thái chương trình phức tạp hoặc yêu cầu các tương tác onchain tinh vi gặp khó khăn, Mollusk cung cấp khả năng kiểm soát chi tiết hơn đối với môi trường kiểm thử.\r\n\r\nMollusk là một framework kiểm thử Rust được thiết kế đặc biệt cho các chương trình Solana, cho phép bạn:\r\n- Kiểm thử logic chương trình một cách độc lập mà không bị ảnh hưởng bởi mạng\r\n- Thiết lập các trạng thái tài khoản và điều kiện chương trình phức tạp một cách dễ dàng\r\n- Chạy các bài kiểm tra nhanh hơn so với các bài kiểm tra tích hợp đầy đủ\r\n- Giả lập các điều kiện blockchain cụ thể và các trường hợp biên\r\n\r\nChúng tôi đã đề cập đến việc kiểm thử Mollusk một cách chi tiết [tại đây](/vi/courses/testing-with-mollusk).\r\n\r\nĐể kiểm thử chương trình pinocchio của bạn, chỉ cần import tệp `test.rs` của bạn với cờ cấu hình `test` trong tệp `lib.rs` của bạn:\r\n\r\n```rust\r\n#[cfg(test)]\r\npub mod tests;\r\n```\r\n\r\nChạy các kiểm thử của bạn bằng lệnh:\r\n\r\n```\r\ncargo test-sbf\r\n```","highlightedCode":{"code-0":{"lang":"rust","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"#[cfg(test)]"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"pub"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":" mod"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" tests;"}]}]}]}]}]}},"code-1":{"lang":"text","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{},"children":[{"type":"text","value":"cargo test-sbf"}]}]}]}]}]}}}}