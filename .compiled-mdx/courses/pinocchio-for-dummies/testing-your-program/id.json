ffset":1060}}}],"position":{"start":{"line":14,"column":1,"offset":776},"end":{"line":17,"column":72,"offset":1060}}},{"type":"paragraph","children":[{"type":"text","value":"Kami telah membahas pengujian Mollusk secara menyeluruh ","position":{"start":{"line":19,"column":1,"offset":1064},"end":{"line":19,"column":57,"offset":1120}}},{"type":"link","title":null,"url":"/id/courses/testing-with-mollusk","children":[{"type":"text","value":"di sini","position":{"start":{"line":19,"column":58,"offset":1121},"end":{"line":19,"column":65,"offset":1128}}}],"position":{"start":{"line":19,"column":57,"offset":1120},"end":{"line":19,"column":100,"offset":1163}}},{"type":"text","value":".","position":{"start":{"line":19,"column":100,"offset":1163},"end":{"line":19,"column":101,"offset":1164}}}],"position":{"start":{"line":19,"column":1,"offset":1064},"end":{"line":19,"column":101,"offset":1164}}},{"type":"paragraph","children":[{"type":"text","value":"Untuk menguji program pinocchio Anda, cukup impor file ","position":{"start":{"line":21,"column":1,"offset":1168},"end":{"line":21,"column":56,"offset":1223}}},{"type":"inlineCode","value":"test.rs","position":{"start":{"line":21,"column":56,"offset":1223},"end":{"line":21,"column":65,"offset":1232}}},{"type":"text","value":" Anda dengan flag konfigurasi ","position":{"start":{"line":21,"column":65,"offset":1232},"end":{"line":21,"column":95,"offset":1262}}},{"type":"inlineCode","value":"test","position":{"start":{"line":21,"column":95,"offset":1262},"end":{"line":21,"column":101,"offset":1268}}},{"type":"text","value":" di ","position":{"start":{"line":21,"column":101,"offset":1268},"end":{"line":21,"column":105,"offset":1272}}},{"type":"inlineCode","value":"lib.rs","position":{"start":{"line":21,"column":105,"offset":1272},"end":{"line":21,"column":113,"offset":1280}}},{"type":"text","value":" Anda:","position":{"start":{"line":21,"column":113,"offset":1280},"end":{"line":21,"column":119,"offset":1286}}}],"position":{"start":{"line":21,"column":1,"offset":1168},"end":{"line":21,"column":119,"offset":1286}}},{"type":"code","lang":"rust","meta":null,"value":"#[cfg(test)]\r\npub mod tests;","position":{"start":{"line":23,"column":1,"offset":1290},"end":{"line":26,"column":4,"offset":1332}},"data":{"highlightId":"code-0"}},{"type":"paragraph","children":[{"type":"text","value":"Jalankan pengujian Anda menggunakan:","position":{"start":{"line":28,"column":1,"offset":1336},"end":{"line":28,"column":37,"offset":1372}}}],"position":{"start":{"line":28,"column":1,"offset":1336},"end":{"line":28,"column":37,"offset":1372}}},{"type":"code","lang":null,"meta":null,"value":"cargo test-sbf","position":{"start":{"line":30,"column":1,"offset":1376},"end":{"line":32,"column":4,"offset":1400}},"data":{"highlightId":"code-1"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":32,"column":4,"offset":1400}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Menguji Program Anda  \r\n\r\nPengujian menyeluruh sangat penting sebelum penerapan di mainnet untuk mengidentifikasi potensi bug dan kerentanan. \r\n\r\nProgram yang teruji dengan baik mencegah kerugian finansial, membangun kepercayaan pengguna, dan memastikan aplikasi berperilaku dengan benar dalam berbagai kondisi.\r\n\r\n<ArticleSection name=\"Mollusk Tests\" id=\"mollusk-tests\" level=\"h2\" />\r\n\r\nKetika menyiapkan status program yang kompleks atau memerlukan interaksi onchain yang rumit terbukti sulit, Mollusk menyediakan kontrol yang lebih terperinci atas lingkungan pengujian.\r\n\r\nMollusk adalah framework pengujian Rust yang dirancang khusus untuk program Solana yang memungkinkan Anda:\r\n- Menguji logika program secara terisolasi tanpa overhead jaringan\r\n- Menyiapkan status akun yang kompleks dan kondisi program dengan mudah\r\n- Menjalankan pengujian lebih cepat daripada pengujian integrasi penuh\r\n- Membuat mock untuk kondisi blockchain tertentu dan kasus-kasus khusus\r\n\r\nKami telah membahas pengujian Mollusk secara menyeluruh [di sini](/id/courses/testing-with-mollusk).\r\n\r\nUntuk menguji program pinocchio Anda, cukup impor file `test.rs` Anda dengan flag konfigurasi `test` di `lib.rs` Anda:\r\n\r\n```rust\r\n#[cfg(test)]\r\npub mod tests;\r\n```\r\n\r\nJalankan pengujian Anda menggunakan:\r\n\r\n```\r\ncargo test-sbf\r\n```","highlightedCode":{"code-0":{"lang":"rust","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"#[cfg(test)]"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"pub"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":" mod"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" tests;"}]}]}]}]}]}},"code-1":{"lang":"text","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{},"children":[{"type":"text","value":"cargo test-sbf"}]}]}]}]}]}}}}