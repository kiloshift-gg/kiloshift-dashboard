"column":1,"offset":756},"end":{"line":17,"column":59,"offset":1013}}},{"type":"paragraph","children":[{"type":"text","value":"Ми детально розглянули тестування з Mollusk ","position":{"start":{"line":19,"column":1,"offset":1017},"end":{"line":19,"column":45,"offset":1061}}},{"type":"link","title":null,"url":"/uk/courses/testing-with-mollusk","children":[{"type":"text","value":"тут","position":{"start":{"line":19,"column":46,"offset":1062},"end":{"line":19,"column":49,"offset":1065}}}],"position":{"start":{"line":19,"column":45,"offset":1061},"end":{"line":19,"column":84,"offset":1100}}},{"type":"text","value":".","position":{"start":{"line":19,"column":84,"offset":1100},"end":{"line":19,"column":85,"offset":1101}}}],"position":{"start":{"line":19,"column":1,"offset":1017},"end":{"line":19,"column":85,"offset":1101}}},{"type":"paragraph","children":[{"type":"text","value":"Щоб протестувати вашу програму pinocchio, просто імпортуйте ваш ","position":{"start":{"line":21,"column":1,"offset":1105},"end":{"line":21,"column":65,"offset":1169}}},{"type":"inlineCode","value":"test.rs","position":{"start":{"line":21,"column":65,"offset":1169},"end":{"line":21,"column":74,"offset":1178}}},{"type":"text","value":" файл з прапорцем конфігурації ","position":{"start":{"line":21,"column":74,"offset":1178},"end":{"line":21,"column":105,"offset":1209}}},{"type":"inlineCode","value":"test","position":{"start":{"line":21,"column":105,"offset":1209},"end":{"line":21,"column":111,"offset":1215}}},{"type":"text","value":" у вашому ","position":{"start":{"line":21,"column":111,"offset":1215},"end":{"line":21,"column":121,"offset":1225}}},{"type":"inlineCode","value":"lib.rs","position":{"start":{"line":21,"column":121,"offset":1225},"end":{"line":21,"column":129,"offset":1233}}},{"type":"text","value":":","position":{"start":{"line":21,"column":129,"offset":1233},"end":{"line":21,"column":130,"offset":1234}}}],"position":{"start":{"line":21,"column":1,"offset":1105},"end":{"line":21,"column":130,"offset":1234}}},{"type":"code","lang":"rust","meta":null,"value":"#[cfg(test)]\r\npub mod tests;","position":{"start":{"line":23,"column":1,"offset":1238},"end":{"line":26,"column":4,"offset":1280}},"data":{"highlightId":"code-0"}},{"type":"paragraph","children":[{"type":"text","value":"Запустіть ваші тести за допомогою:","position":{"start":{"line":28,"column":1,"offset":1284},"end":{"line":28,"column":35,"offset":1318}}}],"position":{"start":{"line":28,"column":1,"offset":1284},"end":{"line":28,"column":35,"offset":1318}}},{"type":"code","lang":null,"meta":null,"value":"cargo test-sbf","position":{"start":{"line":30,"column":1,"offset":1322},"end":{"line":32,"column":4,"offset":1346}},"data":{"highlightId":"code-1"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":32,"column":4,"offset":1346}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Тестування вашої програми  \r\n\r\nРетельне тестування є необхідним перед розгортанням у мережі майннет для виявлення потенційних помилок і вразливостей. \r\n\r\nДобре протестовані програми запобігають фінансовим втратам, будують довіру користувачів і забезпечують правильну роботу додатків у різних умовах.\r\n\r\n<ArticleSection name=\"Mollusk Tests\" id=\"mollusk-tests\" level=\"h2\" />\r\n\r\nКоли налаштування складних станів програми або виконання складних взаємодій в мережі виявляється складним, Mollusk забезпечує більш детальний контроль над середовищем тестування.\r\n\r\nMollusk — це фреймворк для тестування на Rust, розроблений спеціально для програм Solana, який дозволяє:\r\n- Тестувати логіку програми ізольовано без мережевих накладних витрат\r\n- Легко налаштовувати складні стани облікових записів і умови програми\r\n- Запускати тести швидше, ніж повні інтеграційні тести\r\n- Імітувати специфічні умови блокчейну та граничні випадки\r\n\r\nМи детально розглянули тестування з Mollusk [тут](/uk/courses/testing-with-mollusk).\r\n\r\nЩоб протестувати вашу програму pinocchio, просто імпортуйте ваш `test.rs` файл з прапорцем конфігурації `test` у вашому `lib.rs`:\r\n\r\n```rust\r\n#[cfg(test)]\r\npub mod tests;\r\n```\r\n\r\nЗапустіть ваші тести за допомогою:\r\n\r\n```\r\ncargo test-sbf\r\n```","highlightedCode":{"code-0":{"lang":"rust","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"#[cfg(test)]"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"pub"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":" mod"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" tests;"}]}]}]}]}]}},"code-1":{"lang":"text","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{},"children":[{"type":"text","value":"cargo test-sbf"}]}]}]}]}]}}}}