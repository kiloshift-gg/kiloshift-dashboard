enum, implement ","position":{"start":{"line":56,"column":1,"offset":2105},"end":{"line":56,"column":132,"offset":2236}}},{"type":"inlineCode","value":"TryFrom<u32>","position":{"start":{"line":56,"column":132,"offset":2236},"end":{"line":56,"column":146,"offset":2250}}},{"type":"text","value":":","position":{"start":{"line":56,"column":146,"offset":2250},"end":{"line":56,"column":147,"offset":2251}}}],"position":{"start":{"line":56,"column":1,"offset":2105},"end":{"line":56,"column":147,"offset":2251}}},{"type":"code","lang":"rust","meta":null,"value":"impl TryFrom<u32> for PinocchioError {\r\n    type Error = ProgramError;\r\n    fn try_from(error: u32) -> Result<Self, Self::Error> {\r\n        match error {\r\n            0 => Ok(PinocchioError::NotRentExempt),\r\n            _ => Err(ProgramError::InvalidArgument),\r\n        }\r\n    }\r\n}","position":{"start":{"line":58,"column":1,"offset":2255},"end":{"line":68,"column":4,"offset":2550}},"data":{"highlightId":"code-3"}},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"This is optional, but useful for advanced error handling and testing.","position":{"start":{"line":70,"column":3,"offset":2556},"end":{"line":70,"column":72,"offset":2625}}}],"position":{"start":{"line":70,"column":3,"offset":2556},"end":{"line":70,"column":72,"offset":2625}}}],"position":{"start":{"line":70,"column":1,"offset":2554},"end":{"line":70,"column":72,"offset":2625}}},{"type":"heading","depth":3,"children":[{"type":"text","value":"Human Readable Errors","position":{"start":{"line":72,"column":5,"offset":2633},"end":{"line":72,"column":26,"offset":2654}}}],"position":{"start":{"line":72,"column":1,"offset":2629},"end":{"line":72,"column":26,"offset":2654}}},{"type":"paragraph","children":[{"type":"text","value":"For logging and debugging, you may want to provide a string representation of your errors. Implementing the ","position":{"start":{"line":74,"column":1,"offset":2658},"end":{"line":74,"column":109,"offset":2766}}},{"type":"inlineCode","value":"ToStr","position":{"start":{"line":74,"column":109,"offset":2766},"end":{"line":74,"column":116,"offset":2773}}},{"type":"text","value":" trait allows you to do this:","position":{"start":{"line":74,"column":116,"offset":2773},"end":{"line":74,"column":145,"offset":2802}}}],"position":{"start":{"line":74,"column":1,"offset":2658},"end":{"line":74,"column":145,"offset":2802}}},{"type":"code","lang":"rust","meta":null,"value":"impl ToStr for PinocchioError {\r\n    fn to_str<E>(&self) -> &'static str {\r\n        match self {\r\n            PinocchioError::NotRentExempt => \"Error: Lamport balance below rent-exempt threshold\",\r\n        }\r\n    }\r\n}","position":{"start":{"line":76,"column":1,"offset":2806},"end":{"line":84,"column":4,"offset":3037}},"data":{"highlightId":"code-4"}},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"This step is also optional, but it can make error reporting more user-friendly.","position":{"start":{"line":86,"column":3,"offset":3043},"end":{"line":86,"column":82,"offset":3122}}}],"position":{"start":{"line":86,"column":3,"offset":3043},"end":{"line":86,"column":82,"offset":3122}}}],"position":{"start":{"line":86,"column":1,"offset":3041},"end":{"line":86,"column":82,"offset":3122}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":87,"column":1,"offset":3124}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Errors\r\n\r\nClear, descriptive error types are essential in Solana programs built with Pinocchio. They make debugging easier and provide meaningful feedback to users and clients interacting with your program.\r\n\r\n### The PinocchioError Enum\r\n\r\nWhen defining custom error types in Rust, you have several options, such as `thiserror`, `anyhow`, and `failure`. For Pinocchio programs, `thiserror` is the preferred choice because:\r\n- It lets you annotate each error variant with a human-readable message using the `#[error(\"...\")]` attribute.\r\n- It automatically implements the `core::error::Error` and `Display` traits, making your errors easy to print and debug.\r\n- All error messages and formatting are checked at compile time, reducing the risk of runtime issues.\r\n- Most importantly, `thiserror` supports `no_std` environments when you disable its default features, which is required for Pinocchio programs.\r\n\r\nTo use thiserror in a Pinocchio program, add it to your `Cargo.toml` like this:\r\n\r\n```\r\n[dependencies]\r\nthiserror = { version = \"2.0\", default-features = false }\r\n```\r\n\r\nHere’s how you can define a custom error type for your Pinocchio program:\r\n\r\n```rust\r\nuse {\r\n    num_derive::FromPrimitive,\r\n    pinocchio::program_error::{ProgramError, ToStr},\r\n    thiserror::Error,\r\n};\r\n\r\n#[derive(Clone, Debug, Eq, Error, FromPrimitive, PartialEq)]\r\npub enum PinocchioError {\r\n    // 0\r\n    /// Lamport balance below rent-exempt threshold.\r\n    #[error(\"Lamport balance below rent-exempt threshold\")]\r\n    NotRentExempt,\r\n}\r\n```\r\n\r\nEach variant is annotated with a message that will be displayed when the error occurs.\r\n\r\nTo return your custom errors from Solana instructions, implement `From<PinocchioError>` for `ProgramError`:\r\n\r\n```rust\r\nimpl From<PinocchioError> for ProgramError {\r\n    fn from(e: PinocchioError) -> Self {\r\n        ProgramError::Custom(e as u32)\r\n    }\r\n}\r\n```\r\n\r\nThis allows you to use the `?` operator and return your custom errors seamlessly.\r\n\r\n### Deserialize Errors from Raw Values\r\n\r\nIf you need to convert raw error codes (such as those from logs or cross-program invocations) back into your error enum, implement `TryFrom<u32>`:\r\n\r\n```rust\r\nimpl TryFrom<u32> for PinocchioError {\r\n    type Error = ProgramError;\r\n    fn try_from(error: u32) -> Result<Self, Self::Error> {\r\n        match error {\r\n            0 => Ok(PinocchioError::NotRentExempt),\r\n            _ => Err(ProgramError::InvalidArgument),\r\n        }\r\n    }\r\n}\r\n```\r\n\r\n> This is optional, but useful for advanced error handling and testing.\r\n\r\n### Human Readable Errors\r\n\r\nFor logging and debugging, you may want to provide a string representation of your errors. Implementing the `ToStr` trait allows you to do this:\r\n\r\n```rust\r\nimpl ToStr for PinocchioError {\r\n    fn to_str<E>(&self) -> &'static str {\r\n        match self {\r\n            PinocchioError::NotRentExempt => \"Error: Lamport balance below rent-exempt threshold\",\r\n        }\r\n    }\r\n}\r\n```\r\n\r\n> This step is also optional, but it can make error reporting more user-friendly.\r\n","highlightedCode":{"code-0":{"lang":"text","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{},"children":[{"type":"text","value":"[dependencies]"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{},"children":[{"type":"text","value":"thiserror = { version = \"2.0\", default-features = false }"}]}]}]}]}]}},"code-1":{"lang":"rust","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"use"}]},{"type":"element","tagName":"span","proper