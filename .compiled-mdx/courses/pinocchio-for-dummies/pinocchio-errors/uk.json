et":1872}}},{"type":"inlineCode","value":"From<PinocchioError>","position":{"start":{"line":42,"column":74,"offset":1872},"end":{"line":42,"column":96,"offset":1894}}},{"type":"text","value":" для ","position":{"start":{"line":42,"column":96,"offset":1894},"end":{"line":42,"column":101,"offset":1899}}},{"type":"inlineCode","value":"ProgramError","position":{"start":{"line":42,"column":101,"offset":1899},"end":{"line":42,"column":115,"offset":1913}}},{"type":"text","value":":","position":{"start":{"line":42,"column":115,"offset":1913},"end":{"line":42,"column":116,"offset":1914}}}],"position":{"start":{"line":42,"column":1,"offset":1799},"end":{"line":42,"column":116,"offset":1914}}},{"type":"code","lang":"rust","meta":null,"value":"impl From<PinocchioError> for ProgramError {\r\n    fn from(e: PinocchioError) -> Self {\r\n        ProgramError::Custom(e as u32)\r\n    }\r\n}","position":{"start":{"line":44,"column":1,"offset":1918},"end":{"line":50,"column":4,"offset":2068}},"data":{"highlightId":"code-2"}},{"type":"paragraph","children":[{"type":"text","value":"Це дозволяє вам використовувати оператор ","position":{"start":{"line":52,"column":1,"offset":2072},"end":{"line":52,"column":42,"offset":2113}}},{"type":"inlineCode","value":"?","position":{"start":{"line":52,"column":42,"offset":2113},"end":{"line":52,"column":45,"offset":2116}}},{"type":"text","value":" та безперешкодно повертати ваші користувацькі помилки.","position":{"start":{"line":52,"column":45,"offset":2116},"end":{"line":52,"column":100,"offset":2171}}}],"position":{"start":{"line":52,"column":1,"offset":2072},"end":{"line":52,"column":100,"offset":2171}}},{"type":"heading","depth":3,"children":[{"type":"text","value":"Десеріалізація помилок з необроблених значень","position":{"start":{"line":54,"column":5,"offset":2179},"end":{"line":54,"column":50,"offset":2224}}}],"position":{"start":{"line":54,"column":1,"offset":2175},"end":{"line":54,"column":50,"offset":2224}}},{"type":"paragraph","children":[{"type":"text","value":"Якщо вам потрібно перетворити необроблені коди помилок (наприклад, з логів або міжпрограмних викликів) назад у ваш перелік помилок, реалізуйте ","position":{"start":{"line":56,"column":1,"offset":2228},"end":{"line":56,"column":144,"offset":2371}}},{"type":"inlineCode","value":"TryFrom<u32>","position":{"start":{"line":56,"column":144,"offset":2371},"end":{"line":56,"column":158,"offset":2385}}},{"type":"text","value":":","position":{"start":{"line":56,"column":158,"offset":2385},"end":{"line":56,"column":159,"offset":2386}}}],"position":{"start":{"line":56,"column":1,"offset":2228},"end":{"line":56,"column":159,"offset":2386}}},{"type":"code","lang":"rust","meta":null,"value":"impl TryFrom<u32> for PinocchioError {\r\n    type Error = ProgramError;\r\n    fn try_from(error: u32) -> Result<Self, Self::Error> {\r\n        match error {\r\n            0 => Ok(PinocchioError::NotRentExempt),\r\n            _ => Err(ProgramError::InvalidArgument),\r\n        }\r\n    }\r\n}","position":{"start":{"line":58,"column":1,"offset":2390},"end":{"line":68,"column":4,"offset":2685}},"data":{"highlightId":"code-3"}},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"Це необов'язково, але корисно для розширеної обробки помилок та тестування.","position":{"start":{"line":70,"column":3,"offset":2691},"end":{"line":70,"column":78,"offset":2766}}}],"position":{"start":{"line":70,"column":3,"offset":2691},"end":{"line":70,"column":78,"offset":2766}}}],"position":{"start":{"line":70,"column":1,"offset":2689},"end":{"line":70,"column":78,"offset":2766}}},{"type":"heading","depth":3,"children":[{"type":"text","value":"Зрозумілі для людини помилки","position":{"start":{"line":72,"column":5,"offset":2774},"end":{"line":72,"column":33,"offset":2802}}}],"position":{"start":{"line":72,"column":1,"offset":2770},"end":{"line":72,"column":33,"offset":2802}}},{"type":"paragraph","children":[{"type":"text","value":"Для логування та налагодження вам може знадобитися рядкове представлення ваших помилок. Реалізація трейту ","position":{"start":{"line":74,"column":1,"offset":2806},"end":{"line":74,"column":107,"offset":2912}}},{"type":"inlineCode","value":"ToStr","position":{"start":{"line":74,"column":107,"offset":2912},"end":{"line":74,"column":114,"offset":2919}}},{"type":"text","value":" дозволяє це зробити:","position":{"start":{"line":74,"column":114,"offset":2919},"end":{"line":74,"column":135,"offset":2940}}}],"position":{"start":{"line":74,"column":1,"offset":2806},"end":{"line":74,"column":135,"offset":2940}}},{"type":"code","lang":"rust","meta":null,"value":"impl ToStr for PinocchioError {\r\n    fn to_str<E>(&self) -> &'static str {\r\n        match self {\r\n            PinocchioError::NotRentExempt => \"Error: Lamport balance below rent-exempt threshold\",\r\n        }\r\n    }\r\n}","position":{"start":{"line":76,"column":1,"offset":2944},"end":{"line":84,"column":4,"offset":3175}},"data":{"highlightId":"code-4"}},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"Цей крок також необов'язковий, але він може зробити звітування про помилки більш зручним для користувача.","position":{"start":{"line":86,"column":3,"offset":3181},"end":{"line":86,"column":108,"offset":3286}}}],"position":{"start":{"line":86,"column":3,"offset":3181},"end":{"line":86,"column":108,"offset":3286}}}],"position":{"start":{"line":86,"column":1,"offset":3179},"end":{"line":86,"column":108,"offset":3286}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":87,"column":1,"offset":3288}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Помилки\r\n\r\nЧіткі, описові типи помилок є важливими в програмах Solana, створених за допомогою Pinocchio. Вони полегшують налагодження та надають змістовний зворотний зв'язок користувачам і клієнтам, які взаємодіють з вашою програмою.\r\n\r\n### Перелік PinocchioError\r\n\r\nПри визначенні користувацьких типів помилок у Rust ви маєте кілька варіантів, таких як `thiserror`, `anyhow`, та `failure`. Для програм Pinocchio, `thiserror` є найкращим вибором, тому що:\r\n- Дозволяє анотувати кожен варіант помилки зрозумілим для людини повідомленням за допомогою атрибута `#[error(\"...\")]`.\r\n- Автоматично реалізує трейти `core::error::Error` та `Display`, що робить ваші помилки легкими для виведення та налагодження.\r\n- Усі повідомлення про помилки та форматування перевіряються під час компіляції, зменшуючи ризик проблем під час виконання.\r\n- Найважливіше, `thiserror` підтримує середовища `no_std` при вимкненні його типових функцій, що необхідно для програм Pinocchio.\r\n\r\nЩоб використовувати thiserror у програмі Pinocchio, додайте його до вашого `Cargo.toml` таким чином:\r\n\r\n```\r\n[dependencies]\r\nthiserror = { version = \"2.0\", default-features = false }\r\n```\r\n\r\nОсь як ви можете визначити користувацький тип помилки для вашої програми Pinocchio:\r\n\r\n```rust\r\nuse {\r\n    num_derive::FromPrimitive,\r\n    pinocchio::program_error::{ProgramError, ToStr},\r\n    thiserror::Error,\r\n};\r\n\r\n#[derive(Clone, Debug, Eq, Error, FromPrimitive, PartialEq)]\r\npub enum PinocchioError {\r\n    // 0\r\n    /// Lamport balance below rent-exempt threshold.\r\n    #[error(\"Lamport balance below rent-exempt threshold\")]\r\n    NotRentExempt,\r\n}\r\n```\r\n\r\nКожен варіант анотований повідомленням, яке буде відображатися при виникненні помилки.\r\n\r\nЩоб повертати ваші користувацькі помилки з інструкцій Solana, реалізуйте `From<PinocchioError>` для `ProgramError`:\r\n\r\n```rust\r\nimpl From<PinocchioError> for ProgramError {\r\n    fn from(e: PinocchioError) -> Self {\r\n        ProgramError::Custom(e as u32)\r\n    }\r\n}\r\n```\r\n\r\nЦе дозволяє вам використовувати оператор `?` та безперешкодно повертати ваші користувацькі помилки.\r\n\r\n### Десеріалізація помилок з необроблених значень\r\n\r\nЯкщо вам потрібно перетворити необроблені коди помилок (наприклад, з логів або міжпрограмних викликів) назад у ваш перелік помилок, реалізуйте `TryFrom<u32>`:\r\n\r\n```rust\r\nimpl TryFrom<u32> for PinocchioError {\r\n    type Error = ProgramError;\r\n    fn try_from(error: u32) -> Result<Self, Self::Error> {\r\n        match error {\r\n            0 => Ok(PinocchioError::NotRentExempt),\r\n            _ => Err(ProgramError::InvalidArgument),\r\n        }\r\n    }\r\n}\r\n```\r\n\r\n> Це необов'язково, але корисно для розширеної обробки помилок та тестування.\r\n\r\n### Зрозумілі для людини помилки\r\n\r\nДля логування та налагодження вам може знадобитися рядкове представлення ваших помилок. Реалізація трейту `ToStr` дозволяє це зробити:\r\n\r\n```rust\r\nimpl ToStr for PinocchioError {\r\n    fn to_str<E>(&self) -> &'static str {\r\n        match self {\r\n            PinocchioError::NotRentExempt => \"Error: Lamport balance below rent-exempt threshold\",\r\n        }\r\n    }\r\n}\r\n```\r\n\r\n> Цей крок також необов'язковий, але він може зробити звітування про помилки більш зручним для користувача.\r\n","highlightedCode":{"code-0":{"lang":"text","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{},"children":[{"type":"text","value":"[dependencies]"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{},"children":[{"type":"text","value":"thiserror = { version = \"2.0\", default-features = false }"}]}]}]}]}]}},"code-1":{"lang":"rust","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#1