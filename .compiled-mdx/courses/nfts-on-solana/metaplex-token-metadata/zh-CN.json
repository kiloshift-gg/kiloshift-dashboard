column":82,"offset":1056}}}],"position":{"start":{"line":38,"column":1,"offset":975},"end":{"line":38,"column":82,"offset":1056}}},{"type":"paragraph","children":[{"type":"text","value":"这创造了可持续的经济模型，使创作者在初次销售后仍能从其作品中持续获益。","position":{"start":{"line":40,"column":1,"offset":1060},"end":{"line":40,"column":36,"offset":1095}}}],"position":{"start":{"line":40,"column":1,"offset":1060},"end":{"line":40,"column":36,"offset":1095}}},{"type":"paragraph","children":[{"type":"text","value":"Token Metadata 程序成功弥合了原始区块链数据与用户可访问的数字资产之间的差距。通过为铸造账户添加丰富的上下文信息，该程序使应用程序能够以有意义的方式显示、分类和交互代币。","position":{"start":{"line":42,"column":1,"offset":1099},"end":{"line":42,"column":93,"offset":1191}}}],"position":{"start":{"line":42,"column":1,"offset":1099},"end":{"line":42,"column":93,"offset":1191}}},{"type":"paragraph","children":[{"type":"text","value":"这一元数据层为 Solana 上现有的多样化数字资产生态系统奠定了基础。","position":{"start":{"line":44,"column":1,"offset":1195},"end":{"line":44,"column":37,"offset":1231}}}],"position":{"start":{"line":44,"column":1,"offset":1195},"end":{"line":44,"column":37,"offset":1231}}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"主版本账户","position":{"start":{"line":46,"column":17,"offset":1251},"end":{"line":46,"column":29,"offset":1263}}},{"type":"mdxJsxAttribute","name":"id","value":"master-edition-account","position":{"start":{"line":46,"column":30,"offset":1264},"end":{"line":46,"column":57,"offset":1291}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":46,"column":58,"offset":1292},"end":{"line":46,"column":68,"offset":1302}}}],"children":[],"position":{"start":{"line":46,"column":1,"offset":1235},"end":{"line":46,"column":71,"offset":1305}}},{"type":"paragraph","children":[{"type":"text","value":"虽然元数据账户能够有效支持同质化和非同质化代币，但确保真实的 NFT 特性需要额外的控制机制。","position":{"start":{"line":48,"column":1,"offset":1309},"end":{"line":48,"column":48,"offset":1356}}}],"position":{"start":{"lin