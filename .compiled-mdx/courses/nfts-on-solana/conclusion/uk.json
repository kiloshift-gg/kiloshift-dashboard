set":987},"end":{"line":19,"column":29,"offset":1001}}}],"position":{"start":{"line":19,"column":14,"offset":986},"end":{"line":19,"column":46,"offset":1018}}},{"type":"text","value":" для практичних вправ","position":{"start":{"line":19,"column":46,"offset":1018},"end":{"line":19,"column":67,"offset":1039}}}],"position":{"start":{"line":19,"column":4,"offset":976},"end":{"line":19,"column":67,"offset":1039}}}],"position":{"start":{"line":19,"column":1,"offset":973},"end":{"line":19,"column":67,"offset":1039}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Приєднуйтесь до нашої спільноти, щоб поділитися своїми ідеями, реалізаціями та отримати допомогу","position":{"start":{"line":20,"column":4,"offset":1044},"end":{"line":20,"column":100,"offset":1140}}}],"position":{"start":{"line":20,"column":4,"offset":1044},"end":{"line":20,"column":100,"offset":1140}}}],"position":{"start":{"line":20,"column":1,"offset":1041},"end":{"line":20,"column":100,"offset":1140}}}],"position":{"start":{"line":18,"column":1,"offset":842},"end":{"line":20,"column":100,"offset":1140}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":21,"column":1,"offset":1142}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Висновок\r\n\r\nВітаємо! Ви завершили комплексний курс про NFT на Solana та розвинули глибоке розуміння невзаємозамінних токенів у екосистемі Solana.\r\n\r\n<ArticleSection name=\"Що ви вивчили\" id=\"what-you-learned\" level=\"h2\" />\r\n\r\nПротягом цього курсу ви отримали важливі знання про:\r\n- Основні властивості NFT: неподільність, унікальність, фіксована пропозиція, групованість та метадані\r\n- Програму Metaplex Token Metadata: `Metadata`, `Master Edition` та `Token Record` акаунти\r\n- Програму Metaplex Core: дизайн з одним акаунтом для підвищення ефективності та їхню систему плагінів\r\n\r\n<ArticleSection name=\"Наступні кроки\" id=\"next-steps\" level=\"h2\" />\r\n\r\nТепер ви готові почати створювати свій перший NFT! Ось кілька рекомендованих наступних кроків:\r\n\r\n1. Дізнайтеся більше про те, як використовувати ці програми в [офіційній документації Metaplex](https://developers.metaplex.com).\r\n2. Дослідіть [розділ Завдань](/uk/challenges) для практичних вправ\r\n3. Приєднуйтесь до нашої спільноти, щоб поділитися своїми ідеями, реалізаціями та отримати допомогу\r\n","highlightedCode":{}}