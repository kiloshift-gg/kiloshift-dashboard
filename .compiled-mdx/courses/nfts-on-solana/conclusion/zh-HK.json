fset":571},"end":{"line":19,"column":40,"offset":610}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"加入我們的社群，分享你的想法、實現方式並獲得幫助","position":{"start":{"line":20,"column":4,"offset":615},"end":{"line":20,"column":28,"offset":639}}}],"position":{"start":{"line":20,"column":4,"offset":615},"end":{"line":20,"column":28,"offset":639}}}],"position":{"start":{"line":20,"column":1,"offset":612},"end":{"line":20,"column":28,"offset":639}}}],"position":{"start":{"line":18,"column":1,"offset":500},"end":{"line":20,"column":28,"offset":639}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":21,"column":1,"offset":641}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# 結論\r\n\r\n恭喜你！你已完成全面的 Solana 上的 NFT 課程，並對 Solana 上的非同質化代幣有了深入的了解。\r\n\r\n<ArticleSection name=\"你所學到的內容\" id=\"what-you-learned\" level=\"h2\" />\r\n\r\n在這個課程中，你已掌握以下重要知識：\r\n- NFT 的核心屬性：不可分割性、唯一性、固定供應量、可分組性和元數據\r\n- Metaplex Token Metadata 程式：`Metadata`、`Master Edition` 和 `Token Record` 帳戶\r\n- Metaplex Core 程式：單一帳戶設計以提升效率及其插件系統\r\n\r\n<ArticleSection name=\"下一步\" id=\"next-steps\" level=\"h2\" />\r\n\r\n你現在已準備好開始創建你的第一個 NFT！以下是一些建議的下一步：\r\n\r\n1. 在 [Metaplex](https://developers.metaplex.com) 官方文檔中了解更多關於如何使用這些程式。\r\n2. 探索 [挑戰部分](/zh-HK/challenges) 以進行實踐練習\r\n3. 加入我們的社群，分享你的想法、實現方式並獲得幫助\r\n","highlightedCode":{}}