olumn":4,"offset":2459}},"data":{"highlightId":"code-4"}},{"type":"paragraph","children":[{"type":"text","value":"Selanjutnya, periksa apakah instruksi tersebut adalah yang Anda harapkan. Untuk melakukannya, bandingkan diskriminator instruksi dengan yang diharapkan. Dalam kasus ini, karena ini adalah instruksi Anchor lainnya, Anda dapat melakukannya seperti ini:","position":{"start":{"line":59,"column":1,"offset":2463},"end":{"line":59,"column":251,"offset":2713}}}],"position":{"start":{"line":59,"column":1,"offset":2463},"end":{"line":59,"column":251,"offset":2713}}},{"type":"code","lang":"rust","meta":null,"value":"require!(ix.data[0..8].eq(instruction::TakeEnd::DISCRIMINATOR.as_slice()), EscrowError::InvalidIx);","position":{"start":{"line":61,"column":1,"offset":2717},"end":{"line":63,"column":4,"offset":2830}},"data":{"highlightId":"code-5"}},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"Anchor memudahkan ini dengan menyediakan trait ","position":{"start":{"line":65,"column":3,"offset":2836},"end":{"line":65,"column":50,"offset":2883}}},{"type":"inlineCode","value":"Discriminator","position":{"start":{"line":65,"column":50,"offset":2883},"end":{"line":65,"column":65,"offset":2898}}},{"type":"text","value":" ","position":{"start":{"line":65,"column":65,"offset":2898},"end":{"line":65,"column":66,"offset":2899}}},{"type":"inlineCode","value":"anchor_lang::Discriminator","position":{"start":{"line":65,"column":66,"offset":2899},"end":{"line":65,"column":94,"offset":2927}}},{"type":"text","value":" langsung pada\r\ninstruksi.","position":{"start":{"line":65,"column":94,"offset":2927},"end":{"line":66,"column":11,"offset":2953}}}],"position":{"start":{"line":65,"column":3,"offset":2836},"end":{"line":66,"column":11,"offset":2953}}}],"position":{"start":{"line":65,"column":1,"offset":2834},"end":{"line":66,"column":11,"offset":2953}}},{"type":"paragraph","children":[{"type":"text","value":"Anda kemudian dapat melakukan pemeriksaan yang lebih spesifik berdasarkan logika instruksi yang sedang diperiksa.","position":{"start":{"line":68,"column":1,"offset":2957},"end":{"line":68,"column":114,"offset":3070}}}],"position":{"start":{"line":68,"column":1,"offset":2957},"end":{"line":68,"column":114,"offset":3070}}},{"type":"paragraph","children":[{"type":"text","value":"Dalam contoh ini, kita memeriksa bahwa data instruksi (jumlah) sudah benar. Data instruksi selalu di-deserialisasi setelah diskriminator, jadi Anda dapat melakukannya seperti ini:","position":{"start":{"line":70,"column":1,"offset":3074},"end":{"line":70,"column":180,"offset":3253}}}],"position":{"start":{"line":70,"column":1,"offset":3074},"end":{"line":70,"column":180,"offset":3253}}},{"type":"code","lang":"rust","meta":null,"value":"require!(ix.data[8..16].eq(&escrow.take_amount.to_le_bytes()), EscrowError::InvalidAmount);","position":{"start":{"line":72,"column":1,"offset":3257},"end":{"line":74,"column":4,"offset":3362}},"data":{"highlightId":"code-6"}},{"type":"paragraph","children":[{"type":"text","value":"Terakhir, periksa akun yang ada dalam instruksi yang diintrospeksi. Langkah ini mengharuskan Anda mengetahui struktur pasti dari struct ","position":{"start":{"line":76,"column":1,"offset":3366},"end":{"line":76,"column":137,"offset":3502}}},{"type":"inlineCode","value":"Account","position":{"start":{"line":76,"column":137,"offset":3502},"end":{"line":76,"column":146,"offset":3511}}},{"type":"text","value":", karena Anda akan meminta data atau kunci publik dari akun pada indeks tertentu:","position":{"start":{"line":76,"column":146,"offset":3511},"end":{"line":76,"column":227,"offset":3592}}}],"position":{"start":{"line":76,"column":1,"offset":3366},"end":{"line":76,"column":227,"offset":3592}}},{"type":"code","lang":"rust","meta":null,"value":"let maker_ata = get_associated_token_address(&ctx.accounts.maker.key(), &escrow.mint_b);\r\nrequire_keys_eq!(ix.accounts.get(3).unwrap().pubkey, maker_ata, EscrowError::InvalidMakerATA);","position":{"start":{"line":78,"column":1,"offset":3596},"end":{"line":81,"column":4,"offset":3794}},"data":{"highlightId":"code-7"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":82,"column":1,"offset":3796}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Introspeksi Instruksi dengan Anchor\r\n\r\nAnchor tidak memiliki helper bawaan untuk sysvar `Instruction`, tetapi semua tipe dan fungsi dari crate `solana_program` secara inheren didukung di Anchor.\r\n\r\nUntuk menggunakan Introspeksi Instruksi di Anchor, Anda perlu menambahkan crate `solana_program` ke proyek Anda:\r\n\r\n```sh\r\ncargo add solana-program\r\n```\r\n\r\nSetelah menambahkan crate, Anda dapat mengakses fungsi-fungsi yang diperlukan dengan mengimpornya:\r\n\r\n```rust\r\nuse solana_program::sysvar::instructions::{\r\n    self,\r\n    load_current_index_checked, \r\n    load_instruction_at_checked\r\n}; \r\n```\r\n\r\n<ArticleSection name=\"Cara menggunakan Introspeksi\" id=\"how-to-use-introspection\" level=\"h2\" />\r\n\r\nSeperti yang disebutkan dalam pendahuluan, Introspeksi Instruksi bekerja dengan mendeserialkan data dari akun sysvar `Instruction` untuk memberikan detail tentang instruksi dalam sebuah transaksi.\r\n\r\nMeskipun fungsi `load_instruction_at_checked` memverifikasi bahwa akun yang dideserialkan adalah yang benar, adalah praktik yang baik untuk menambahkan pemeriksaan tambahan ke struct akun Anda:\r\n\r\n```rust\r\n#[account(address = instructions::ID)]\r\n/// CHECK: InstructionsSysvar account\r\ninstructions: UncheckedAccount<'info>,\r\n```\r\n\r\nSekarang Anda dapat mulai bekerja dengan Introspeksi Instruksi.\r\n\r\nPertama, periksa indeks instruksi saat ini menggunakan fungsi `load_current_index_checked`:\r\n\r\n```rust\r\n// Check the index of the currently executing instruction. This could be in a different position than [0]).\r\nlet index = load_current_index_checked(&ctx.accounts.instructions.to_account_info())?;\r\n```\r\n\r\nSelanjutnya, Anda dapat memeriksa instruksi pada indeks relatif menggunakan `load_instruction_at_checked`. Di sini, kita akan memeriksa instruksi yang langsung mengikuti instruksi saat ini:\r\n\r\n```rust\r\n// Load the next instruction to check its input.\r\nlet ix = load_instruction_at_checked(index as usize + 1, &ctx.accounts.instructions.to_account_info())?;\r\n```\r\n\r\nSebelum melanjutkan ke langkah berikutnya, penting untuk mempertimbangkan informasi apa yang penting untuk mencegah serangan berbahaya.\r\n\r\nBiasanya kita mulai dengan memeriksa apakah program yang dipanggil adalah yang diharapkan. Dalam contoh ini, kita melakukan introspeksi instruksi lain dari program yang sama:\r\n\r\n```rust\r\nrequire_keys_eq!(ix.program_id, ID, EscrowError::InvalidProgram);\r\n```\r\n\r\nSelanjutnya, periksa apakah instruksi tersebut adalah yang Anda harapkan. Untuk melakukannya, bandingkan diskriminator instruksi dengan yang diharapkan. Dalam kasus ini, karena ini adalah instruksi Anchor lainnya, Anda dapat melakukannya seperti ini:\r\n\r\n```rust\r\nrequire!(ix.data[0..8].eq(instruction::TakeEnd::DISCRIMINATOR.as_slice()), EscrowError::InvalidIx);\r\n```\r\n\r\n> Anchor memudahkan ini dengan menyediakan trait `Discriminator` `anchor_lang::Discriminator` langsung pada\r\ninstruksi.\r\n\r\nAnda kemudian dapat melakukan pemeriksaan yang lebih spesifik berdasarkan logika instruksi yang sedang diperiksa.\r\n\r\nDalam contoh ini, kita memeriksa bahwa data instruksi (jumlah) sudah benar. Data instruksi selalu di-deserialisasi setelah diskriminator, jadi Anda dapat melakukannya seperti ini:\r\n\r\n```rust\r\nrequire!(ix.data[8..16].eq(&escrow.take_amount.to_le_bytes()), EscrowError::InvalidAmount);\r\n```\r\n\r\nTerakhir, periksa akun yang ada dalam instruksi yang diintrospeksi. Langkah ini mengharuskan Anda mengetahui struktur pasti dari struct `Account`, karena Anda akan meminta data atau kunci publik dari akun pada indeks tertentu:\r\n\r\n```rust\r\nlet maker_ata = get_associated_token_address(&ctx.accounts.maker.key(), &escrow.mint_b);\r\nrequire_keys_eq!(ix.accounts.get(3).unwrap().pubkey, maker_ata, EscrowError::InvalidMakerATA);\r\n```\r\n","highlightedCode":{"code-0":{"lang":"rust","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"use"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" solana_program"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"::"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"sysvar"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"::"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"instructions"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"::"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"{"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#BF9EEE;font-style:italic"},"children":[{"type":"text","value":"    self"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":","}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"clas