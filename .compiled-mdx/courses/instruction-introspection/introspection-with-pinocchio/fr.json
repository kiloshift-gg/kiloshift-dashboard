 one we want to check for the correct input.\r\nlet instruction = instruction_sysvar.load_instruction_at(index as usize + 1)?;","position":{"start":{"line":28,"column":1,"offset":1738},"end":{"line":31,"column":4,"offset":1921}},"data":{"highlightId":"code-2"}},{"type":"paragraph","children":[{"type":"text","value":"Avant de passer à l'étape suivante, nous devons nous demander quelles informations sont essentielles pour prévenir une attaque malveillante.","position":{"start":{"line":33,"column":1,"offset":1925},"end":{"line":33,"column":141,"offset":2065}}}],"position":{"start":{"line":33,"column":1,"offset":1925},"end":{"line":33,"column":141,"offset":2065}}},{"type":"paragraph","children":[{"type":"text","value":"Nous commençons généralement par vérifier si le programme utilisé est bien celui que nous attendons. Dans cet exemple, nous introspectons une autre instruction du Programme Système, nous pouvons donc procéder comme ceci :","position":{"start":{"line":35,"column":1,"offset":2069},"end":{"line":35,"column":222,"offset":2290}}}],"position":{"start":{"line":35,"column":1,"offset":2069},"end":{"line":35,"column":222,"offset":2290}}},{"type":"code","lang":"rust","meta":null,"value":"if instruction.get_program_id() != &pinocchio_system::ID {\r\n    return Err(ProgramError::InvalidInstructionData);\r\n}","position":{"start":{"line":37,"column":1,"offset":2294},"end":{"line":41,"column":4,"offset":2424}},"data":{"highlightId":"code-3"}},{"type":"paragraph","children":[{"type":"text","value":"Ensuite, nous vérifions si l'instruction correspond à celle que nous attendons. Pour ce faire, nous comparons le discriminateur et les données d'instruction avec les valeurs attendues. Nous commençons par créer une variable  ","position":{"start":{"line":43,"column":1,"offset":2428},"end":{"line":43,"column":226,"offset":2653}}},{"type":"inlineCode","value":"instruction_data","position":{"start":{"line":43,"column":226,"offset":2653},"end":{"line":43,"column":244,"offset":2671}}},{"type":"text","value":" et la vérifions comme ceci :","position":{"start":{"line":43,"column":244,"offset":2671},"end":{"line":43,"column":273,"offset":2700}}}],"position":{"start":{"line":43,"column":1,"offset":2428},"end":{"line":43,"column":273,"offset":2700}}},{"type":"code","lang":"rust","meta":null,"value":"let mut instruction_data = [0u8; 12];\r\ninstruction_data[0..4].copy_from_slice(&2u32.to_le_bytes());\r\ninstruction_data[4..12].copy_from_slice(&100_000_000u64.to_le_bytes());\r\n\r\nif instruction.get_instruction_data() != instruction_data {\r\n    return Err(ProgramError::InvalidInstructionData);\r\n}","position":{"start":{"line":45,"column":1,"offset":2704},"end":{"line":53,"column":4,"offset":3011}},"data":{"highlightId":"code-4"}},{"type":"paragraph","children":[{"type":"text","value":"Nous pouvons ensuite effectuer des vérifications plus spécifiques au programme en fonction de la logique de l'instruction que nous vérifions.","position":{"start":{"line":55,"column":1,"offset":3015},"end":{"line":55,"column":142,"offset":3156}}}],"position":{"start":{"line":55,"column":1,"offset":3015},"end":{"line":55,"column":142,"offset":3156}}},{"type":"paragraph","children":[{"type":"text","value":"Nous pouvons également vérifier les comptes présents dans l'instruction introspectée. Cette étape nécessite de connaître la structure exacte de la structure de compte car nous allons demander les données ou la clé publique d'un compte à un index précis comme ceci :","position":{"start":{"line":57,"column":1,"offset":3160},"end":{"line":57,"column":266,"offset":3425}}}],"position":{"start":{"line":57,"column":1,"offset":3160},"end":{"line":57,"column":266,"offset":3425}}},{"type":"code","lang":"rust","meta":null,"value":"if !pubkey_eq(instruction.get_account_meta_at(0)?.key(), self.accounts.from.key()) {\r\n    return Err(ProgramError::InvalidAccountData);\r\n}","position":{"start":{"line":59,"column":1,"offset":3429},"end":{"line":63,"column":4,"offset":3581}},"data":{"highlightId":"code-5"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":64,"column":1,"offset":3583}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Introspection des Instructions avec Pinocchio\r\n\r\nPinocchio utilise des types différents de ceux de la crate `solana_program`. Cela signifie que nous devions créer un nouveau SDK optimisé pour Pinocchio.\r\n\r\nAvec l'aide d'[Orion](https://x.com/BasedOrion_), nous avons créé un ensemble de fonctions d'aide qui respectaient l'implémentation \"originelle\" mais avons rendu la sysvar `Instruction` — l'une des sysvars les plus coûteuses à utiliser — l'une des plus efficaces.\r\n\r\nPour cette raison, nous pouvons utiliser l'*introspection des instructions* dans Pinocchio sans installer de crates externes et accéder à toutes les informations dont nous avons besoin en important ces fonctions :\r\n\r\n```rust\r\nuse pinocchio::sysvars::instructions::Instructions;\r\n```\r\n\r\n<ArticleSection name=\"Comment utiliser l'Introspection\" id=\"how-to-use-introspection\" level=\"h2\" />\r\n\r\nComme mentionné précédemment, l'Introspection des Instructions désérialise simplement les données du compte sysvar `Instruction` afin de fournir toutes les données dont nous avons besoin concernant nos instructions.\r\n\r\nNous commençons par vérifier l'index actuel. Nous pouvons le faire en utilisant la fonction `load_current_index_checked` comme ceci :\r\n\r\n```rust\r\nlet instruction_sysvar = unsafe { Instructions::new_unchecked(&self.accounts.sysvar_instructions.try_borrow_data()?) };\r\nlet index = instruction_sysvar.load_current_index();\r\n```\r\n\r\nAprès cela, nous pouvons vérifier une instruction à un index relatif à l'aide de `load_instruction_at_checked`. Cette fois-ci, nous allons vérifier l'instruction qui suit immédiatement celle qui effectue l'introspection, comme ceci :\r\n\r\n```rust\r\n// We load the next instruction, which is the one we want to check for the correct input.\r\nlet instruction = instruction_sysvar.load_instruction_at(index as usize + 1)?;\r\n```\r\n\r\nAvant de passer à l'étape suivante, nous devons nous demander quelles informations sont essentielles pour prévenir une attaque malveillante.\r\n\r\nNous commençons généralement par vérifier si le programme utilisé est bien celui que nous attendons. Dans cet exemple, nous introspectons une autre instruction du Programme Système, nous pouvons donc procéder comme ceci :\r\n\r\n```rust\r\nif instruction.get_program_id() != &pinocchio_system::ID {\r\n    return Err(ProgramError::InvalidInstructionData);\r\n}\r\n```\r\n\r\nEnsuite, nous vérifions si l'instruction correspond à celle que nous attendons. Pour ce faire, nous comparons le discriminateur et les données d'instruction avec les valeurs attendues. Nous commençons par créer une variable  `instruction_data` et la vérifions comme ceci :\r\n\r\n```rust\r\nlet mut instruction_data = [0u8; 12];\r\ninstruction_data[0..4].copy_from_slice(&2u32.to_le_bytes());\r\ninstruction_data[4..12].copy_from_slice(&100_000_000u64.to_le_bytes());\r\n\r\nif instruction.get_instruction_data() != instruction_data {\r\n    return Err(ProgramError::InvalidInstructionData);\r\n}\r\n```\r\n\r\nNous pouvons ensuite effectuer des vérifications plus spécifiques au programme en fonction de la logique de l'instruction que nous vérifions.\r\n\r\nNous pouvons également vérifier les comptes présents dans l'instruction introspectée. Cette étape nécessite de connaître la structure exacte de la structure de compte car nous allons demander les données ou la clé publique d'un compte à un index précis comme ceci :\r\n\r\n```rust\r\nif !pubkey_eq(instruction.get_account_meta_at(0)?.key(), self.accounts.from.key()) {\r\n    return Err(ProgramError::InvalidAccountData);\r\n}\r\n```\r\n","highlightedCode":{"code-0":{"lang":"rust","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"use"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" pinocchio"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"::"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"sysvars"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"::"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"instructions"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"::"}]},{"type":"element","tagName":"span","properties":{"style":"color:#97E1F1;font-style:italic"},"children":[{"type":"text","value":"Instructions"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":";"}]}]}]}]}]}},"code-1":{"lang":"rust","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"let"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" instruction_sysvar "}]},{"type":"element","tagName":"span","properties":{"style":"col