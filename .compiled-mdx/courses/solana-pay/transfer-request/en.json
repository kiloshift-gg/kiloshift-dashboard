lse,"checked":null,"children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Non-Interactive Nature:","position":{"start":{"line":53,"column":5,"offset":3017},"end":{"line":53,"column":28,"offset":3040}}}],"position":{"start":{"line":53,"column":3,"offset":3015},"end":{"line":53,"column":30,"offset":3042}}},{"type":"text","value":" Once generated, these URLs work independently of your servers. Perfect for situations where network connectivity might be unreliable or when you want to minimize infrastructure dependencies.","position":{"start":{"line":53,"column":30,"offset":3042},"end":{"line":53,"column":221,"offset":3233}}}],"position":{"start":{"line":53,"column":3,"offset":3015},"end":{"line":53,"column":221,"offset":3233}}}],"position":{"start":{"line":53,"column":1,"offset":3013},"end":{"line":53,"column":221,"offset":3233}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Guaranteed Execution:","position":{"start":{"line":54,"column":5,"offset":3239},"end":{"line":54,"column":26,"offset":3260}}}],"position":{"start":{"line":54,"column":3,"offset":3237},"end":{"line":54,"column":28,"offset":3262}}},{"type":"text","value":" Payment parameters are locked in the URL, ensuring customers pay exactly what you expect without dynamic pricing changes.","position":{"start":{"line":54,"column":28,"offset":3262},"end":{"line":54,"column":150,"offset":3384}}}],"position":{"start":{"line":54,"column":3,"offset":3237},"end":{"line":54,"column":150,"offset":3384}}}],"position":{"start":{"line":54,"column":1,"offset":3235},"end":{"line":54,"column":150,"offset":3384}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Offline Capability:","position":{"start":{"line":55,"column":5,"offset":3390},"end":{"line":55,"column":24,"offset":3409}}}],"position":{"start":{"line":55,"column":3,"offset":3388},"end":{"line":55,"column":26,"offset":3411}}},{"type":"text","value":" URLs can be generated locally on devices like POS terminals, enabling payments even if backend systems are temporarily unavailable.","position":{"start":{"line":55,"column":26,"offset":3411},"end":{"line":55,"column":158,"offset":3543}}}],"position":{"start":{"line":55,"column":3,"offset":3388},"end":{"line":55,"column":158,"offset":3543}}}],"position":{"start":{"line":55,"column":1,"offset":3386},"end":{"line":55,"column":158,"offset":3543}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Reduced Server Load:","position":{"start":{"line":56,"column":5,"offset":3549},"end":{"line":56,"column":25,"offset":3569}}}],"position":{"start":{"line":56,"column":3,"offset":3547},"end":{"line":56,"column":27,"offset":3571}}},{"type":"text","value":" No API calls needed during payment processing, making them highly scalable for high-volume scenarios.","position":{"start":{"line":56,"column":27,"offset":3571},"end":{"line":56,"column":129,"offset":3673}}}],"position":{"start":{"line":56,"column":3,"offset":3547},"end":{"line":56,"column":129,"offset":3673}}}],"position":{"start":{"line":56,"column":1,"offset":3545},"end":{"line":56,"column":129,"offset":3673}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Universal Compatibility:","position":{"start":{"line":57,"column":5,"offset":3679},"end":{"line":57,"column":29,"offset":3703}}}],"position":{"start":{"line":57,"column":3,"offset":3677},"end":{"line":57,"column":31,"offset":3705}}},{"type":"text","value":" Any Solana wallet can process these requests without requiring wallet-specific integrations.","position":{"start":{"line":57,"column":31,"offset":3705},"end":{"line":57,"column":124,"offset":3798}}}],"position":{"start":{"line":57,"column":3,"offset":3677},"end":{"line":57,"column":124,"offset":3798}}}],"position":{"start":{"line":57,"column":1,"offset":3675},"end":{"line":57,"column":124,"offset":3798}}}],"position":{"start":{"line":53,"column":1,"offset":3013},"end":{"line":57,"column":124,"offset":3798}}},{"type":"paragraph","children":[{"type":"text","value":"Consider transfer requests when you need guaranteed payment amounts, want to reduce server dependencies, or require a payment method that works reliably in all network conditions.","position":{"start":{"line":59,"column":1,"offset":3802},"end":{"line":59,"column":180,"offset":3981}}}],"position":{"start":{"line":59,"column":1,"offset":3802},"end":{"line":59,"column":180,"offset":3981}}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Example","position":{"start":{"line":61,"column":17,"offset":4001},"end":{"line":61,"column":31,"offset":4015}}},{"type":"mdxJsxAttribute","name":"id","value":"example","position":{"start":{"line":61,"column":32,"offset":4016},"end":{"line":61,"column":44,"offset":4028}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":61,"column":45,"offset":4029},"end":{"line":61,"column":55,"offset":4039}}}],"children":[],"position":{"start":{"line":61,"column":1,"offset":3985},"end":{"line":61,"column":58,"offset":4042}}},{"type":"paragraph","children":[{"type":"text","value":"As fully fledged example, you can use the ","position":{"start":{"line":63,"column":1,"offset":4046},"end":{"line":63,"column":43,"offset":4088}}},{"type":"link","title":null,"url":"https://github.com/solana-foundation/solana-pay/blob/master/core/example/payment-flow-merchant/main.ts","children":[{"type":"text","value":"Payment Flow Merchant Example","position":{"start":{"line":63,"column":44,"offset":4089},"end":{"line":63,"column":73,"offset":4118}}}],"position":{"start":{"line":63,"column":43,"offset":4088},"end":{"line":63,"column":178,"offset":4223}}},{"type":"text","value":" from Solana Foundation","position":{"start":{"line":63,"column":178,"offset":4223},"end":{"line":63,"column":201,"offset":4246}}}],"position":{"start":{"line":63,"column":1,"offset":4046},"end":{"line":63,"column":201,"offset":4246}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":64,"column":1,"offset":4248}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Transfer Requests\r\n\r\nTransfer requests are Solana Pay's most straightforward payment method, designed for simple SOL or SPL token transfers without requiring any server interaction. When a user scans a QR code or clicks a transfer request link, their wallet has everything needed to compose and execute the transaction immediately.\r\n\r\nThe beauty of transfer requests lies in their simplicity: all payment information is encoded directly in the URL, making them completely self-contained and instantly executable.\r\n\r\n<ArticleSection name=\"URL Structure and Parameters\" id=\"url-structure\" level=\"h2\" />\r\n\r\nTransfer request URLs follow a standardized format that any Solana wallet can interpret:\r\n\r\n```\r\nsolana:<recipient>?<optional-query-params>\r\n```\r\n\r\n**Required Parameter:**\r\n- `recipient`: A base58-encoded public key representing the destination wallet. This is the only mandatory field, ensuring payments go directly from customer to merchant without intermediaries.\r\n\r\n**Optional Parameters:**\r\n- **`amount`**: Specifies the exact transfer amount as a decimal value. Without this, wallets prompt users to enter an amount manually—perfect for donations or flexible payment scenarios.\r\n- **`spl-token`**: The mint address for SPL token transfers. Transforms a SOL transfer into any token transfer, from USDC payments to custom loyalty tokens.\r\n- **`reference`**: A unique identifier for tracking payments on-chain. Since merchants don't control transaction signatures, references serve as searchable identifiers for payment reconciliation and customer support.\r\n- **`label` and `message`**: User-facing strings that explain payment context. Label typically identifies the merchant, while message describes the specific purchase.\r\n- **`memo`**: Creates an on-chain record using Solana's memo program. Valuable for compliance, accounting, or providing permanent transaction context.\r\n\r\n### Example \r\n\r\nHere's a transfer request for 1 SOL that demonstrates practical parameter usage:\r\n\r\n```\r\nsolana:22222222222222222222222222222222222222222222?amount=1&label=Kiloshift%20Subscription&message=1%20Month&memo=Order12345&reference=abc123def456\r\n```\r\n\r\nFor businesses accepting stablecoins, here's a USDC transfer request:\r\n\r\n```\r\nsolana:22222222222222222222222222222222222222222222?amount=200&spl-token=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v&label=Kiloshift%20Subscription&message=1%20Month&memo=Order12345&reference=abc123def456\r\n```\r\n\r\n<ArticleSection name=\"When to Use Transfer Requests\" id=\"when-to-use\" level=\"h2\" />\r\n\r\nTransfer requests excel in scenarios where payment details are predetermined and unchanging:\r\n\r\n**Perfect Use Cases:**\r\n- **E-commerce checkouts** with fixed pricing\r\n- **Donation campaigns** where users choose amounts\r\n- **Subscription payments** with known amounts\r\n- **Point-of-sale systems** for in-person transactions\r\n- **Invoice payments** with specific amounts\r\n\r\n**Key Advantages:**\r\n- **Non-Interactive Nature:** Once generated, these URLs work independently of your servers. Perfect for situations where network connectivity might be unreliable or when you want to minimize infrastructure dependencies.\r\n- **Guaranteed Execution:** Payment parameters are locked in the URL, ensuring customers pay exactly what you expect without dynamic pricing changes.\r\n- **Offline Capability:** URLs can be generated locally on devices like POS terminals, enabling payments even if backend systems are temporarily unavailable.\r\n- **Reduced Server Load:** No API calls needed during payment processing, making them highly scalable for high-volume scenarios.\r\n- **Universal Compatibility:** Any Solana wallet can process these requests without requiring wallet-specific integrations.\r\n\r\nConsider transfer requests when you need guaranteed payment amounts, want to reduce server dependencies, or require a payment method that works reliably in all network conditions.\r\n\r\n<ArticleSection name=\"Example\" id=\"example\" level=\"h2\" />\r\n\r\nAs fully fledged example, you can use the [Payment Flow Merchant Example](https://github.com/solana-foundation/solana-pay/blob/master/core/example/payment-flow-merchant/main.ts) from Solana Foundation\r\n","highlightedCode":{"code-0":{"lang":"text","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{},"children":[{"type":"text","value":"solana:<recipient>?<optional-query-params>"}]}]}]}]}]}},"code-1":{"lang":"text","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{},"children":[{"type":"text","value":"solana:22222222222222222222222222222222222222222222?amount=1&label=Kiloshift%20Subscription&message=1%20Month&memo=Order12345&reference=abc123def456"}]}]}]}]}]}},"code-2":{"lang":"text","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{},"children":[{"type":"text","value":"solana:22222222222222222222222222222222222222222222?amount=200&spl-token=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v&label=Kiloshift%20Subscription&message=1%20Month&memo=Order12345&reference=abc123def456"}]}]}]}]}]}}}}