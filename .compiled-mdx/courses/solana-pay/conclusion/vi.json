"column":1,"offset":867},"end":{"line":21,"column":87,"offset":953}}}],"position":{"start":{"line":19,"column":1,"offset":757},"end":{"line":21,"column":87,"offset":953}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":21,"column":87,"offset":953}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Kết luận\r\n\r\nChúc mừng! Bạn đã hoàn thành khóa học về Solana Pay. Bạn đã có một hiểu biết vững chắc về cách triển khai các yêu cầu Transfer hoặc Transaction được nhúng vào mã QR.\r\n\r\n<ArticleSection name=\"Những gì bạn đã học\" id=\"what-you-learned\" level=\"h2\" />\r\n\r\nThông qua khóa học này, bạn đã được học về:\r\n- Solana Pay là gì và tại sao nó lại quan trọng\r\n- Cách tạo yêu cầu Transfer\r\n- Cách tạo yêu cầu Transaction\r\n- Cách nhúng các yêu cầu đó vào mã QR\r\n\r\n<ArticleSection name=\"Các bước tiếp theo\" id=\"next-steps\" level=\"h2\" />\r\n\r\nBạn đã sẵn sàng để bắt đầu xây dựng các trừu tượng mạnh mẽ thông qua mã QR! Dưới đây là một số bước tiếp theo được khuyến nghị:\r\n\r\n1. Thử nghiệm triển khai Solana Pay của chính bạn\r\n2. Khám phá [Phần thử thách](/vi/challenges) để thực hành\r\n3. Tham gia cộng đồng của chúng tôi để chia sẻ các triển khai của bạn và nhận trợ giúp","highlightedCode":{}}