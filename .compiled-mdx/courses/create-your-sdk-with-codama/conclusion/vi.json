"column":4,"offset":934},"end":{"line":19,"column":40,"offset":970}}}],"position":{"start":{"line":19,"column":1,"offset":931},"end":{"line":19,"column":40,"offset":970}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Tạo một SDK cho một vài chương trình","position":{"start":{"line":20,"column":4,"offset":975},"end":{"line":20,"column":40,"offset":1011}}}],"position":{"start":{"line":20,"column":4,"offset":975},"end":{"line":20,"column":40,"offset":1011}}}],"position":{"start":{"line":20,"column":1,"offset":972},"end":{"line":20,"column":40,"offset":1011}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Sử dụng SDK để xây dựng một số kiểm thử cho chương trình của bạn","position":{"start":{"line":21,"column":4,"offset":1016},"end":{"line":21,"column":68,"offset":1080}}}],"position":{"start":{"line":21,"column":4,"offset":1016},"end":{"line":21,"column":68,"offset":1080}}}],"position":{"start":{"line":21,"column":1,"offset":1013},"end":{"line":21,"column":68,"offset":1080}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Tham gia cộng đồng của chúng tôi để chia sẻ tiến trình của bạn và nhận trợ giúp","position":{"start":{"line":22,"column":4,"offset":1085},"end":{"line":22,"column":83,"offset":1164}}}],"position":{"start":{"line":22,"column":4,"offset":1085},"end":{"line":22,"column":83,"offset":1164}}}],"position":{"start":{"line":22,"column":1,"offset":1082},"end":{"line":22,"column":83,"offset":1164}}}],"position":{"start":{"line":19,"column":1,"offset":931},"end":{"line":22,"column":83,"offset":1164}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":23,"column":1,"offset":1166}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\nimport { AnchorDiscriminatorCalculator } from \"../../../../components/AnchorDiscriminatorCalculator/AnchorDiscriminatorCalculator\";\r\n\r\n# Kết luận\r\n\r\nChúc mừng! Bạn đã hoàn thành khóa học `Tạo SDK của bạn với Codama`. Bây giờ bạn đã có nền tảng vững chắc trong việc hiểu cách Codama IDL hoạt động, từ các khái niệm cốt lõi đến chi tiết triển khai thực tế.\r\n\r\n## Những gì bạn đã học được\r\n\r\nTrong suốt khóa học này, bạn đã có được kiến thức cần thiết về:\r\n- Codama là gì và cách `nodes`, `visitors` và `renderers` được sử dụng\r\n- Cách xây dựng một Codama IDL từ đầu\r\n- Cách xây dựng một Codama IDL từ một Anchor IDL và cập nhật nếu cần thiết\r\n\r\n## Các bước tiếp theo\r\n\r\nBây giờ bạn đã sẵn sàng để bắt đầu xây dựng SDK đầu tiên của bạn với Codama! Cách tốt nhất để củng cố kiến thức của bạn là thông qua thực hành. Chúng tôi khuyến khích bạn:\r\n\r\n1. Đến [phần Thử thách](/vi/challenges)\r\n2. Tạo một SDK cho một vài chương trình\r\n3. Sử dụng SDK để xây dựng một số kiểm thử cho chương trình của bạn\r\n4. Tham gia cộng đồng của chúng tôi để chia sẻ tiến trình của bạn và nhận trợ giúp\r\n","highlightedCode":{}}