":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Створити SDK для однієї з програм","position":{"start":{"line":20,"column":4,"offset":886},"end":{"line":20,"column":37,"offset":919}}}],"position":{"start":{"line":20,"column":4,"offset":886},"end":{"line":20,"column":37,"offset":919}}}],"position":{"start":{"line":20,"column":1,"offset":883},"end":{"line":20,"column":37,"offset":919}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Використати SDK для створення тестів для вашої програми","position":{"start":{"line":21,"column":4,"offset":924},"end":{"line":21,"column":59,"offset":979}}}],"position":{"start":{"line":21,"column":4,"offset":924},"end":{"line":21,"column":59,"offset":979}}}],"position":{"start":{"line":21,"column":1,"offset":921},"end":{"line":21,"column":59,"offset":979}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Приєднатися до нашої спільноти, щоб поділитися своїм прогресом і отримати допомогу","position":{"start":{"line":22,"column":4,"offset":984},"end":{"line":22,"column":86,"offset":1066}}}],"position":{"start":{"line":22,"column":4,"offset":984},"end":{"line":22,"column":86,"offset":1066}}}],"position":{"start":{"line":22,"column":1,"offset":981},"end":{"line":22,"column":86,"offset":1066}}}],"position":{"start":{"line":19,"column":1,"offset":833},"end":{"line":22,"column":86,"offset":1066}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":23,"column":1,"offset":1068}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\nimport { AnchorDiscriminatorCalculator } from \"../../../../components/AnchorDiscriminatorCalculator/AnchorDiscriminatorCalculator\";\r\n\r\n# Висновок\r\n\r\nВітаємо! Ви завершили курс `Create your SDK with Codama`. Тепер у вас є міцна основа для розуміння того, як працює Codama IDL, від основних концепцій до практичних деталей реалізації.\r\n\r\n## Що ви вивчили\r\n\r\nПротягом цього курсу ви отримали важливі знання про:\r\n- Що таке Codama і як використовуються `nodes`, `visitors` та `renderers`\r\n- Як створити Codama IDL з нуля\r\n- Як створити Codama IDL з Anchor IDL та оновити його за потреби\r\n\r\n## Наступні кроки\r\n\r\nТепер ви готові почати створювати свій перший SDK з Codama! Найкращий спосіб закріпити свої знання — це практика. Ми рекомендуємо вам:\r\n\r\n1. Перейти до [розділу Завдання](/uk/challenges)\r\n2. Створити SDK для однієї з програм\r\n3. Використати SDK для створення тестів для вашої програми\r\n4. Приєднатися до нашої спільноти, щоб поділитися своїм прогресом і отримати допомогу\r\n","highlightedCode":{}}