:49,"offset":1020}}}],"position":{"start":{"line":19,"column":4,"offset":975},"end":{"line":19,"column":49,"offset":1020}}}],"position":{"start":{"line":19,"column":1,"offset":972},"end":{"line":19,"column":49,"offset":1020}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Erstelle ein SDK für eines der Programme","position":{"start":{"line":20,"column":4,"offset":1025},"end":{"line":20,"column":44,"offset":1065}}}],"position":{"start":{"line":20,"column":4,"offset":1025},"end":{"line":20,"column":44,"offset":1065}}}],"position":{"start":{"line":20,"column":1,"offset":1022},"end":{"line":20,"column":44,"offset":1065}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Verwende das SDK, um Tests für dein Programm zu erstellen","position":{"start":{"line":21,"column":4,"offset":1070},"end":{"line":21,"column":61,"offset":1127}}}],"position":{"start":{"line":21,"column":4,"offset":1070},"end":{"line":21,"column":61,"offset":1127}}}],"position":{"start":{"line":21,"column":1,"offset":1067},"end":{"line":21,"column":61,"offset":1127}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Tritt unserer Community bei, um deinen Fortschritt zu teilen und Hilfe zu bekommen","position":{"start":{"line":22,"column":4,"offset":1132},"end":{"line":22,"column":86,"offset":1214}}}],"position":{"start":{"line":22,"column":4,"offset":1132},"end":{"line":22,"column":86,"offset":1214}}}],"position":{"start":{"line":22,"column":1,"offset":1129},"end":{"line":22,"column":86,"offset":1214}}}],"position":{"start":{"line":19,"column":1,"offset":972},"end":{"line":22,"column":86,"offset":1214}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":23,"column":1,"offset":1216}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\nimport { AnchorDiscriminatorCalculator } from \"../../../../components/AnchorDiscriminatorCalculator/AnchorDiscriminatorCalculator\";\r\n\r\n# Fazit\r\n\r\nHerzlichen Glückwunsch! Du hast den `Create your SDK with Codama` Kurs abgeschlossen. Du verfügst jetzt über eine solide Grundlage im Verständnis der Funktionsweise von Codama IDL, von den Kernkonzepten bis hin zu praktischen Implementierungsdetails.\r\n\r\n## Was du gelernt hast\r\n\r\nIm Laufe dieses Kurses hast du wesentliches Wissen erworben über:\r\n- Was Codama ist und wie `nodes`, `visitors` und `renderers` verwendet werden\r\n- Wie man ein Codama IDL von Grund auf erstellt\r\n- Wie man ein Codama IDL aus einem Anchor IDL erstellt und bei Bedarf aktualisiert\r\n\r\n## Nächste Schritte\r\n\r\nDu bist jetzt bereit, dein erstes SDK mit Codama zu entwickeln! Der beste Weg, dein Wissen zu festigen, ist durch praktische Übung. Wir empfehlen dir:\r\n\r\n1. Gehe zum [Bereich Challenges](/de/challenges)\r\n2. Erstelle ein SDK für eines der Programme\r\n3. Verwende das SDK, um Tests für dein Programm zu erstellen\r\n4. Tritt unserer Community bei, um deinen Fortschritt zu teilen und Hilfe zu bekommen\r\n","highlightedCode":{}}