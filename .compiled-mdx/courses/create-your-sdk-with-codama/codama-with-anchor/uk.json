о виникає потреба додати зручні для розробників функції, такі як власні угоди про іменування, додаткову інформацію про типи або спеціалізовані методи клієнта. Система відвідувачів Codama робить ці вдосконалення простими та потужними.","position":{"start":{"line":23,"column":1,"offset":914},"end":{"line":23,"column":308,"offset":1221}}}],"position":{"start":{"line":23,"column":1,"offset":914},"end":{"line":23,"column":308,"offset":1221}}},{"type":"paragraph","children":[{"type":"text","value":"Ви можете дізнатися більше про те, як налаштовувати та вдосконалювати ваш конвертований IDL за допомогою відвідувачів у уроці ","position":{"start":{"line":25,"column":1,"offset":1225},"end":{"line":25,"column":127,"offset":1351}}},{"type":"link","title":null,"url":"/uk/courses/create-your-sdk-with-codama/updating-codama-idl","children":[{"type":"text","value":"Оновлення Codama IDL","position":{"start":{"line":25,"column":128,"offset":1352},"end":{"line":25,"column":148,"offset":1372}}}],"position":{"start":{"line":25,"column":127,"offset":1351},"end":{"line":25,"column":210,"offset":1434}}},{"type":"text","value":".","position":{"start":{"line":25,"column":210,"offset":1434},"end":{"line":25,"column":211,"offset":1435}}}],"position":{"start":{"line":25,"column":1,"offset":1225},"end":{"line":25,"column":211,"offset":1435}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":25,"column":211,"offset":1435}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Створення Codama IDL з Anchor IDL\r\n\r\nСтворення Codama IDL з Anchor надзвичайно просте. Після генерації Anchor IDL за допомогою команди anchor build, нам потрібно встановити пакет '@codama/nodes-from-anchor':\r\n\r\n```\r\npnpm install codama @codama/nodes-from-anchor\r\n```\r\n\r\nА потім конвертувати Anchor IDL безпосередньо за допомогою функції `rootNodeFromAnchor `:\r\n\r\n```ts\r\nimport { createFromRoot } from 'codama';\r\nimport { rootNodeFromAnchor } from '@codama/nodes-from-anchor';\r\nimport anchorIdl from 'anchor-idl.json';\r\n\r\nconst codama = createFromRoot(rootNodeFromAnchor(anchorIdl));\r\n```\r\n\r\nЦе дає вам повністю функціональний Codama IDL, готовий для генерації клієнта. Однак справжня потужність Codama полягає в можливості розширювати та налаштовувати ваш IDL за межами того, що можливо з базовими визначеннями Anchor.\r\n\r\nОскільки процес конвертації зосереджується на структурному перекладі, часто виникає потреба додати зручні для розробників функції, такі як власні угоди про іменування, додаткову інформацію про типи або спеціалізовані методи клієнта. Система відвідувачів Codama робить ці вдосконалення простими та потужними.\r\n\r\nВи можете дізнатися більше про те, як налаштовувати та вдосконалювати ваш конвертований IDL за допомогою відвідувачів у уроці [Оновлення Codama IDL](/uk/courses/create-your-sdk-with-codama/updating-codama-idl).","highlightedCode":{"code-0":{"lang":"text","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{},"children":[{"type":"text","value":"pnpm install codama @codama/nodes-from-anchor"}]}]}]}]}]}},"code-1":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"import"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" { createFromRoot } "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"from"}]},{"type":"element","tagName":"span","properties":{"style":"color:#DEE492"},"children":[{"type":"text","value":" '"}]},{"type":"element","tagName":"span","properties":{"style":"color:#E7EE98"},"children":[{"type":"text","value":"codama"}]},{"type":"element","tagName":"span","properties":{"style":"color:#DEE492"},"children":[{"type":"text","value":"'"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":";"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"import"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" { rootNodeFromAnchor } "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"from"}]},{"type":"element","tagName":"span","properties":{"style":"color:#DEE492"},"children":[{"type":"text","value":" '"}]},{"type":"element","tagName":"span","properties":{"style":"color:#E7EE98"},"children":[{"type":"text","value":"@codama/nodes-from-anchor"}]},{"type":"element","tagName":"span","properties":{"style":"color:#DEE492"},"children":[{"type":"text","value":"'"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":";"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"import"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" anchorIdl "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"from"}]},{"type":"element","tagName":"span","properties":{"style":"color:#DEE492"},"children":[{"type":"text","value":" '"}]},{"type":"element","tagName":"span","properties":{"style":"color:#E7EE98"},"children":[{"type":"text","value":"anchor-idl.json"}]},{"type":"element","tagName":"span","properties":{"style":"color:#DEE492"},"children":[{"type":"text","value":"'"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":";"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"const"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" codama "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"="}]},{"type":"element","tagName":"span","properties":{"style":"color:#62E884"},"children":[{"type":"text","value":" createFromRoot"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"("}]},{"type":"element","tagName":"span","properties":{"style":"color:#62E884"},"children":[{"type":"text","value":"rootNodeFromAnchor"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"(anchorIdl));"}]}]}]}]}]}}}}