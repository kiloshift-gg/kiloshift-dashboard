ne":5,"column":1,"offset":143},"end":{"line":5,"column":191,"offset":333}}}],"position":{"start":{"line":5,"column":1,"offset":143},"end":{"line":5,"column":191,"offset":333}}},{"type":"code","lang":null,"meta":null,"value":"pnpm install codama @codama/nodes-from-anchor","position":{"start":{"line":7,"column":1,"offset":337},"end":{"line":9,"column":4,"offset":392}},"data":{"highlightId":"code-0"}},{"type":"paragraph","children":[{"type":"text","value":"Puis convertir l'IDL Anchor directement en utilisant la fonction ","position":{"start":{"line":11,"column":1,"offset":396},"end":{"line":11,"column":66,"offset":461}}},{"type":"inlineCode","value":"rootNodeFromAnchor ","position":{"start":{"line":11,"column":66,"offset":461},"end":{"line":11,"column":87,"offset":482}}},{"type":"text","value":" :","position":{"start":{"line":11,"column":87,"offset":482},"end":{"line":11,"column":89,"offset":484}}}],"position":{"start":{"line":11,"column":1,"offset":396},"end":{"line":11,"column":89,"offset":484}}},{"type":"code","lang":"ts","meta":null,"value":"import { createFromRoot } from 'codama';\r\nimport { rootNodeFromAnchor } from '@codama/nodes-from-anchor';\r\nimport anchorIdl from 'anchor-idl.json';\r\n\r\nconst codama = createFromRoot(rootNodeFromAnchor(anchorIdl));","position":{"start":{"line":13,"column":1,"offset":488},"end":{"line":19,"column":4,"offset":712}},"data":{"highlightId":"code-1"}},{"type":"paragraph","children":[{"type":"text","value":"Cela vous donne un IDL Codama entièrement fonctionnel, prêt pour la génération de client. Cependant, la véritable puissance de Codama réside dans sa capacité à améliorer et personnaliser votre IDL au-delà de ce qui est possible avec les définitions Anchor brutes.","position":{"start":{"line":21,"column":1,"offset":716},"end":{"line":21,"column":264,"offset":979}}}],"position":{"start":{"line":21,"column":1,"offset":716},"end":{"line":21,"column":264,"offset":979}}},{"type":"paragraph","children":[{"type":"text","value":"Comme le processus de conversion se concentre sur la traduction structurelle, vous voudrez souvent ajouter des fonctionnalités conviviales pour les développeurs, comme des conventions de nommage personnalisées, des informations de type supplémentaires ou des méthodes client spécialisées. Le système de visiteurs de Codama rend ces améliorations simples et puissantes.","position":{"start":{"line":23,"column":1,"offset":983},"end":{"line":23,"column":369,"offset":1351}}}],"position":{"start":{"line":23,"column":1,"offset":983},"end":{"line":23,"column":369,"offset":1351}}},{"type":"paragraph","children":[{"type":"text","value":"Vous pouvez en apprendre davantage sur la façon de personnaliser et d'améliorer votre IDL converti en utilisant les visiteurs dans la leçon ","position":{"start":{"line":25,"column":1,"offset":1355},"end":{"line":25,"column":141,"offset":1495}}},{"type":"link","title":null,"url":"/en/courses/create-your-sdk-with-codama/updating-codama-idl","children":[{"type":"text","value":"Mise à jour de l'IDL Codama","position":{"start":{"line":25,"column":142,"offset":1496},"end":{"line":25,"column":169,"offset":1523}}}],"position":{"start":{"line":25,"column":141,"offset":1495},"end":{"line":25,"column":231,"offset":1585}}},{"type":"text","value":".","position":{"start":{"line":25,"column":231,"offset":1585},"end":{"line":25,"column":232,"offset":1586}}}],"position":{"start":{"line":25,"column":1,"offset":1355},"end":{"line":25,"column":232,"offset":1586}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":25,"column":232,"offset":1586}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Créer votre IDL Codama à partir d'un IDL Anchor\r\n\r\nCréer un IDL Codama à partir d'Anchor est extrêmement simple. Une fois que vous avez généré votre IDL Anchor avec anchor build, nous devons installer le package '@codama/nodes-from-anchor' :\r\n\r\n```\r\npnpm install codama @codama/nodes-from-anchor\r\n```\r\n\r\nPuis convertir l'IDL Anchor directement en utilisant la fonction `rootNodeFromAnchor ` :\r\n\r\n```ts\r\nimport { createFromRoot } from 'codama';\r\nimport { rootNodeFromAnchor } from '@codama/nodes-from-anchor';\r\nimport anchorIdl from 'anchor-idl.json';\r\n\r\nconst codama = createFromRoot(rootNodeFromAnchor(anchorIdl));\r\n```\r\n\r\nCela vous donne un IDL Codama entièrement fonctionnel, prêt pour la génération de client. Cependant, la véritable puissance de Codama réside dans sa capacité à améliorer et personnaliser votre IDL au-delà de ce qui est possible avec les définitions Anchor brutes.\r\n\r\nComme le processus de conversion se concentre sur la traduction structurelle, vous voudrez souvent ajouter des fonctionnalités conviviales pour les développeurs, comme des conventions de nommage personnalisées, des informations de type supplémentaires ou des méthodes client spécialisées. Le système de visiteurs de Codama rend ces améliorations simples et puissantes.\r\n\r\nVous pouvez en apprendre davantage sur la façon de personnaliser et d'améliorer votre IDL converti en utilisant les visiteurs dans la leçon [Mise à jour de l'IDL Codama](/en/courses/create-your-sdk-with-codama/updating-codama-idl).","highlightedCode":{"code-0":{"lang":"text","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{},"children":[{"type":"text","value":"pnpm install codama @codama/nodes-from-anchor"}]}]}]}]}]}},"code-1":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"import"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" { createFromRoot } "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"from"}]},{"type":"element","tagName":"span","properties":{"style":"color:#DEE492"},"children":[{"type":"text","value":" '"}]},{"type":"element","tagName":"span","properties":{"style":"color:#E7EE98"},"children":[{"type":"text","value":"codama"}]},{"type":"element","tagName":"span","properties":{"style":"color:#DEE492"},"children":[{"type":"text","value":"'"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":";"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"import"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" { rootNodeFromAnchor } "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"from"}]},{"type":"element","tagName":"span","properties":{"style":"color:#DEE492"},"children":[{"type":"text","value":" '"}]},{"type":"element","tagName":"span","properties":{"style":"color:#E7EE98"},"children":[{"type":"text","value":"@codama/nodes-from-anchor"}]},{"type":"element","tagName":"span","properties":{"style":"color:#DEE492"},"children":[{"type":"text","value":"'"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":";"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class