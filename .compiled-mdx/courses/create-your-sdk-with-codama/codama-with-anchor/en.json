n want to add developer-friendly features like custom naming conventions, additional type information, or specialized client methods. Codama's visitor system makes these enhancements straightforward and powerful.","position":{"start":{"line":23,"column":1,"offset":913},"end":{"line":23,"column":288,"offset":1200}}}],"position":{"start":{"line":23,"column":1,"offset":913},"end":{"line":23,"column":288,"offset":1200}}},{"type":"paragraph","children":[{"type":"text","value":"You can learn more on how to customize and enhance your converted IDL using visitors in the ","position":{"start":{"line":25,"column":1,"offset":1204},"end":{"line":25,"column":93,"offset":1296}}},{"type":"link","title":null,"url":"/en/courses/create-your-sdk-with-codama/updating-codama-idl","children":[{"type":"text","value":"Updating Codama IDL","position":{"start":{"line":25,"column":94,"offset":1297},"end":{"line":25,"column":113,"offset":1316}}}],"position":{"start":{"line":25,"column":93,"offset":1296},"end":{"line":25,"column":175,"offset":1378}}},{"type":"text","value":" lesson.","position":{"start":{"line":25,"column":175,"offset":1378},"end":{"line":25,"column":183,"offset":1386}}}],"position":{"start":{"line":25,"column":1,"offset":1204},"end":{"line":25,"column":183,"offset":1386}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":25,"column":183,"offset":1386}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Build your Codama IDL from Anchor IDL\r\n\r\nCreating a Codama IDL from Anchor is extremely straightforward. Once you generate your Anchor IDL with anchor build, we need to install the '@codama/nodes-from-anchor' package:\r\n\r\n```\r\npnpm install codama @codama/nodes-from-anchor\r\n```\r\n\r\nAnd then convert the Anchor IDL directly using the `rootNodeFromAnchor ` function:\r\n\r\n```ts\r\nimport { createFromRoot } from 'codama';\r\nimport { rootNodeFromAnchor } from '@codama/nodes-from-anchor';\r\nimport anchorIdl from 'anchor-idl.json';\r\n\r\nconst codama = createFromRoot(rootNodeFromAnchor(anchorIdl));\r\n```\r\n\r\nThis gives you a fully functional Codama IDL that's ready for client generation. However, the real power of Codama comes from its ability to enhance and customize your IDL beyond what's possible with raw Anchor definitions.\r\n\r\nSince the conversion process focuses on structural translation, you'll often want to add developer-friendly features like custom naming conventions, additional type information, or specialized client methods. Codama's visitor system makes these enhancements straightforward and powerful.\r\n\r\nYou can learn more on how to customize and enhance your converted IDL using visitors in the [Updating Codama IDL](/en/courses/create-your-sdk-with-codama/updating-codama-idl) lesson.","highlightedCode":{"code-0":{"lang":"text","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{},"children":[{"type":"text","value":"pnpm install codama @codama/nodes-from-anchor"}]}]}]}]}]}},"code-1":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"import"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" { createFromRoot } "}]},{"type":"element","tagName":"span","properties":{"styl