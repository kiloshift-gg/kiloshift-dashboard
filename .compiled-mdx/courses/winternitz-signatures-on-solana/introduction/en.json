on":{"start":{"line":60,"column":5,"offset":4838},"end":{"line":60,"column":20,"offset":4853}}}],"position":{"start":{"line":60,"column":1,"offset":4834},"end":{"line":60,"column":20,"offset":4853}}},{"type":"paragraph","children":[{"type":"text","value":"To sign message ","position":{"start":{"line":62,"column":1,"offset":4857},"end":{"line":62,"column":17,"offset":4873}}},{"type":"inlineCode","value":"M","position":{"start":{"line":62,"column":17,"offset":4873},"end":{"line":62,"column":20,"offset":4876}}},{"type":"text","value":":","position":{"start":{"line":62,"column":20,"offset":4876},"end":{"line":62,"column":21,"offset":4877}}}],"position":{"start":{"line":62,"column":1,"offset":4857},"end":{"line":62,"column":21,"offset":4877}}},{"type":"list","ordered":true,"start":1,"spread":true,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Convert message to base representation: ","position":{"start":{"line":64,"column":4,"offset":4884},"end":{"line":64,"column":44,"offset":4924}}},{"type":"inlineCode","value":"M → (m₁, m₂, ..., m_l₁)","position":{"start":{"line":64,"column":44,"offset":4924},"end":{"line":64,"column":69,"offset":4949}}},{"type":"text","value":" where each ","position":{"start":{"line":64,"column":69,"offset":4949},"end":{"line":64,"column":81,"offset":4961}}},{"type":"inlineCode","value":"mᵢ ∈ [0, 2^w - 1]","position":{"start":{"line":64,"column":81,"offset":4961},"end":{"line":64,"column":100,"offset":4980}}}],"position":{"start":{"line":64,"column":4,"offset":4884},"end":{"line":64,"column":100,"offset":4980}}}],"position":{"start":{"line":64,"column":1,"offset":4881},"end":{"line":64,"column":100,"offset":4980}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Calculate checksum: ","position":{"start":{"line":66,"column":4,"offset":4987},"end":{"line":66,"column":24,"offset":5007}}},{"type":"inlineCode","value":"c = Σ((2^w - 1) - mᵢ) for i = 1 to l₁","position":{"start":{"line":66,"column":24,"offset":5007},"end":{"line":66,"column":63,"offset":5046}}},{"type":"text","value":" and convert c to base representation: ","position":{"start":{"line":66,"column":63,"offset":5046},"end":{"line":66,"column":102,"offset":5085}}},{"type":"inlineCode","value":"c → (c₁, c₂, ..., c_l₂)","position":{"start":{"line":66,"column":102,"offset":5085},"end":{"line":66,"column":127,"offset":5110}}}],"position":{"start":{"line":66,"column":4,"offset":4987},"end":{"line":66,"column":127,"offset":5110}}}],"position":{"start":{"line":66,"column":1,"offset":4984},"end":{"line":66,"column":127,"offset":5110}}}],"position":{"start":{"line":64,"column":1,"offset":4881},"end":{"line":66,"column":127,"offset":5110}}},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"To calculate the actual checksum value for that message we can use the appropriate checksum private key components and hash them the right number of times based on the checksum digits","position":{"start":{"line":68,"column":3,"offset":5116},"end":{"line":68,"column":186,"offset":5299}}}],"position":{"start":{"line":68,"column":3,"offset":5116},"end":{"line":68,"column":186,"offset":5299}}}],"position":{"start":{"line":68,"column":1,"offset":5114},"end":{"line":68,"column":186,"offset":5299}}},{"type":"list","ordered":true,"start":3,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Generate signature: Where the base representation indicate the number of times the private key needs to be hashed.","position":{"start":{"line":70,"column":4,"offset":5306},"end":{"line":70,"column":118,"offset":5420}}}],"position":{"start":{"line":70,"column":4,"offset":5306},"end":{"line":70,"column":118,"offset":5420}}}],"position":{"start":{"line":70,"column":1,"offset":5303},"end":{"line":70,"column":118,"offset":542