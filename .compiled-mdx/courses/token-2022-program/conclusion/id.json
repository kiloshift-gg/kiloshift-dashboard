e":19,"column":69,"offset":1164}}}],"position":{"start":{"line":19,"column":1,"offset":1096},"end":{"line":19,"column":69,"offset":1164}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Bergabunglah dengan komunitas kami untuk berbagi ide, implementasi, dan mendapatkan bantuan","position":{"start":{"line":20,"column":4,"offset":1169},"end":{"line":20,"column":95,"offset":1260}}}],"position":{"start":{"line":20,"column":4,"offset":1169},"end":{"line":20,"column":95,"offset":1260}}}],"position":{"start":{"line":20,"column":1,"offset":1166},"end":{"line":20,"column":95,"offset":1260}}}],"position":{"start":{"line":18,"column":1,"offset":927},"end":{"line":20,"column":95,"offset":1260}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":21,"column":1,"offset":1262}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Kesimpulan\r\n\r\nSelamat! Anda telah menyelesaikan kursus Program Token2022. Sekarang Anda memiliki pemahaman yang kuat tentang bagaimana Token2022 bekerja di Solana dan perannya.\r\n\r\n<ArticleSection name=\"Apa yang telah Anda pelajari\" id=\"what-you-learned\" level=\"h2\" />\r\n\r\nSepanjang kursus ini, Anda telah mendapatkan pengetahuan penting tentang:\r\n- Perbedaan mendasar antara program Legacy dan program Token2022 yang baru\r\n- Bagaimana Token Extension bekerja dan bagaimana mereka berinteraksi dengan akun `Mint` dan `Token`\r\n- Struktur data dari setiap Token Extension\r\n\r\n<ArticleSection name=\"Langkah Selanjutnya\" id=\"next-steps\" level=\"h2\" />\r\n\r\nAnda sekarang siap untuk mulai menggunakan program token baru dan ekstensi untuk meningkatkan kemampuan program Anda! Berikut adalah beberapa langkah selanjutnya yang direkomendasikan:\r\n\r\n1. Pelajari lebih lanjut tentang bagaimana Anda dapat menggunakan program ini dengan typescript di [bagian Token2022 dengan Web3Js](/id/courses/token-2022-with-web3js)\r\n2. Jelajahi [bagian Tantangan](/id/challenges) untuk latihan praktis\r\n3. Bergabunglah dengan komunitas kami untuk berbagi ide, implementasi, dan mendapatkan bantuan\r\n","highlightedCode":{}}