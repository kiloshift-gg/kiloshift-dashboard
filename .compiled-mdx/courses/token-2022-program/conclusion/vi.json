99},"end":{"line":19,"column":71,"offset":1066}}}],"position":{"start":{"line":19,"column":1,"offset":996},"end":{"line":19,"column":71,"offset":1066}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Tham gia cộng đồng của chúng tôi để chia sẻ ý tưởng, triển khai của bạn và nhận trợ giúp","position":{"start":{"line":20,"column":4,"offset":1071},"end":{"line":20,"column":92,"offset":1159}}}],"position":{"start":{"line":20,"column":4,"offset":1071},"end":{"line":20,"column":92,"offset":1159}}}],"position":{"start":{"line":20,"column":1,"offset":1068},"end":{"line":20,"column":92,"offset":1159}}}],"position":{"start":{"line":18,"column":1,"offset":848},"end":{"line":20,"column":92,"offset":1159}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":21,"column":1,"offset":1161}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Kết luận\r\n\r\nChúc mừng! Bạn đã hoàn thành khóa học Token2022 Program. Giờ đây bạn đã có hiểu biết vững chắc về cách Token2022 hoạt động trên Solana và vai trò của nó.\r\n\r\n<ArticleSection name=\"Những gì bạn đã học\" id=\"what-you-learned\" level=\"h2\" />\r\n\r\nTrong suốt khóa học này, bạn đã có được kiến thức thiết yếu về:\r\n- Sự khác biệt cơ bản giữa Legacy và Token2022 program mới\r\n- Cách Token Extension hoạt động và cách chúng giao tiếp với `Mint` và `Token` account\r\n- Cấu trúc dữ liệu của mỗi Token Extension\r\n\r\n<ArticleSection name=\"Các bước tiếp theo\" id=\"next-steps\" level=\"h2\" />\r\n\r\nBây giờ bạn đã sẵn sàng để bắt đầu sử dụng token program mới và các extension để tăng sức mạnh cho chương trình của bạn! Đây là một số bước tiếp theo được khuyến nghị:\r\n\r\n1. Tìm hiểu thêm về cách bạn có thể sử dụng chương trình này với typescript trong [phần Token2022 with Web3Js](/vi/courses/token-2022-with-web3js)\r\n2. Khám phá [phần Thử thách](/vi/challenges) cho các bài tập thực hành\r\n3. Tham gia cộng đồng của chúng tôi để chia sẻ ý tưởng, triển khai của bạn và nhận trợ giúp\r\n","highlightedCode":{}}