:9,"column":58,"offset":335},"end":{"line":9,"column":62,"offset":339}}}],"position":{"start":{"line":9,"column":1,"offset":278},"end":{"line":9,"column":62,"offset":339}}},{"type":"paragraph","children":[{"type":"text","value":"以下是如何使用 Cpi Guard 擴展創建代幣的方法：","position":{"start":{"line":11,"column":1,"offset":343},"end":{"line":11,"column":29,"offset":371}}}],"position":{"start":{"line":11,"column":1,"offset":343},"end":{"line":11,"column":29,"offset":371}}},{"type":"code","lang":"ts","meta":null,"value":"import {\r\n    Keypair,\r\n    SystemProgram,\r\n    Transaction,\r\n    sendAndConfirmTransaction,\r\n} from '@solana/web3.js';\r\nimport {\r\n    createInitializeAccountInstruction,\r\n    createEnableCpiGuardInstruction,\r\n    getAccountLen,\r\n    ExtensionType,\r\n    TOKEN_2022_PROGRAM_ID,\r\n} from '@solana/spl-token';\r\n\r\nconst tokenAccount = Keypair.generate();\r\n\r\n// Calculate the size needed for a Token account with Cpi Guard extension\r\nconst accountLen = getAccountLen([ExtensionType.CpiGuard]);\r\n\r\n// Calculate minimum lamports required for rent exemption\r\nconst lamports = await connection.getMinimumBalanceForRentExemption(accountLen);\r\n\r\n// Create the account with the correct size and owner\r\nconst createAccountInstruction = SystemProgram.createAccount({\r\n    fromPubkey: keypair.publicKey,\r\n    newAccountPubkey: tokenAccount.publicKey,\r\n    space: accountLen,\r\n    lamports,\r\n    programId: TOKEN_2022_PROGRAM_ID,\r\n});\r\n\r\n// Initialize the Cpi Guard extension\r\nconst enableCpiGuardInstruction = createEnableCpiGuardInstruction(\r\n    tokenAccount.publicKey,\r\n    keypair.publicKey,\r\n    undefined,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\n// Initialize the Token account itself\r\nconst initializeAccountInstruction = createInitializeAccountInstruction(\r\n    tokenAccount.publicKey,\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAccountInstruction,\r\n    initializeAccountInstruction,\r\n    enableCpiGuardInstruction\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair, tokenAccount], {skipPreflight: false});\r\n\r\nconsole.log(`Token accounts created! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":13,"column":1,"offset":375},"end":{"line":70,"column":4,"offset":2137}},"data":{"highlightId":"code-0"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"禁用 CPI Guard","position":{"start":{"line":72,"column":17,"offset":2157},"end":{"line":72,"column":36,"offset":2176}}},{"type":"mdxJsxAttribute","name":"id","value":"disabling-the-cpi-guard","position":{"start":{"line":72,"column":37,"offset":2177},"end":{"line":72,"column":65,"offset":2205}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":72,"column":66,"offset":2206},"end":{"line":72,"column":76,"offset":2216}}}],"children":[],"position":{"start":{"line":72,"column":1,"offset":2141},"end":{"line":72,"column":79,"offset":2219}}},{"type":"paragraph","children":[{"type":"text","value":"當我們希望啟用被 Cpi Guard 阻止的某些行為時，可以使用 ","position":{"start":{"line":74,"column":1,"offset":2223},"end":{"line":74,"column":34,"offset":2256}}},{"type":"inlineCode","value":"disableCpiGuard","position":{"start":{"line":74,"column":34,"offset":2256},"end":{"line":74,"column":51,"offset":2273}}},{"type":"text","value":" 指令輕鬆禁用該保護，如下所示：","position":{"start":{"line":74,"column":51,"offset":2273},"end":{"line":74,"column":67,"offset":2289}}}],"position":{"start":{"line":74,"column":1,"offset":2223},"end":{"line":74,"column":67,"offset":2289}}},{"type":"code","lang":"ts","meta":null,"value":"const disableCpiGuardInstruction = createDisableCpiGuardInstruction(\r\n    tokenAccount,\r\n    keypair.publicKey,\r\n    undefined,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);","position":{"start":{"line":76,"column":1,"offset":2293},"end":{"line":83,"column":4,"offset":2464}},"data":{"highlightId":"code-1"}},{"type":"paragraph","children":[{"type":"text","value":"當我們完成後，想要重新添加安全層時，可以使用 ","position":{"start":{"line":85,"column":1,"offset":2468},"end":{"line":85,"column":24,"offset":2491}}},{"type":"inlineCode","value":"enableCpiGuard","position":{"start":{"line":85,"column":24,"offset":2491},"end":{"line":85,"column":40,"offset":2507}}},{"type":"text","value":" 指令重新啟用，如下所示：","position":{"start":{"line":85,"column":40,"offset":2507},"end":{"line":85,"column":53,"offset":2520}}}],"position":{"start":{"line":85,"column":1,"offset":2468},"end":{"line":85,"column":53,"offset":2520}}},{"type":"code","lang":"ts","meta":null,"value":"const enableCpiGuardInstruction = createEnableCpiGuardInstruction(\r\n    tokenAccount,\r\n    keypair.publicKey,\r\n    undefined,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);","position":{"start":{"line":87,"column":1,"offset":2524},"end":{"line":94,"column":4,"offset":2693}},"data":{"highlightId":"code-2"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":95,"column":1,"offset":2695}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Cpi Guard 擴展\r\n\r\n`CpiGuard` 擴展是一個 `Token` 賬戶擴展，用於禁止跨程序調用中的某些操作，從而保護用戶免受惡意程序試圖在未經明確同意的情況下操控其代幣賬戶的行為。\r\n\r\n<ArticleSection name=\"初始化代幣賬戶\" id=\"initializing-the-token-account\" level=\"h2\" />\r\n\r\n要在 `Token` 賬戶上初始化 `CpiGuard` 擴展，我們需要使用 `enableCpiGuard()` 函數。\r\n\r\n以下是如何使用 Cpi Guard 擴展創建代幣的方法：\r\n\r\n```ts\r\nimport {\r\n    Keypair,\r\n    SystemProgram,\r\n    Transaction,\r\n    sendAndConfirmTransaction,\r\n} from '@solana/web3.js';\r\nimport {\r\n    createInitializeAccountInstruction,\r\n    createEnableCpiGuardInstruction,\r\n    getAccountLen,\r\n    ExtensionType,\r\n    TOKEN_2022_PROGRAM_ID,\r\n} from '@solana/spl-token';\r\n\r\nconst tokenAccount = Keypair.generate();\r\n\r\n// Calculate the size needed for a Token account with Cpi Guard extension\r\nconst accountLen = getAccountLen([ExtensionType.CpiGuard]);\r\n\r\n// Calculate minimum lamports required for rent exemption\r\nconst lamports = await connection.getMinimumBalanceForRentExemption(accountLen);\r\n\r\n// Create the account with the correct size and owner\r\nconst createAccountInstruction = SystemProgram.createAccount({\r\n    fromPubkey: keypair.publicKey,\r\n    newAccountPubkey: tokenAccount.publicKey,\r\n    space: accountLen,\r\n    lamports,\r\n    programId: TOKEN_2022_PROGRAM_ID,\r\n});\r\n\r\n// Initialize the Cpi Guard extension\r\nconst enableCpiGuardInstruction = createEnableCpiGuardInstruction(\r\n    tokenAccount.publicKey,\r\n    keypair.publicKey,\r\n    undefined,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\n// Initialize the Token account itself\r\nconst initializeAccountInstruction = createInitializeAccountInstruction(\r\n    tokenAccount.publicKey,\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAccountInstruction,\r\n    initializeAccountInstruction,\r\n    enableCpiGuardInstruction\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair, tokenAccount], {skipPreflight: false});\r\n\r\nconsole.log(`Token accounts created! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\n<ArticleSection name=\"禁用 CPI Guard\" id=\"disabling-the-cpi-guard\" level=\"h2\" />\r\n\r\n當我們希望啟用被 Cpi Guard 阻止的某些行為時，可以使用 `disableCpiGuard` 指令輕鬆禁用該保護，如下所示：\r\n\r\n```ts\r\nconst disableCpiGuardInstruction = createDisableCpiGuardInstruction(\r\n    tokenAccount,\r\n    keypair.publicKey,\r\n    undefined,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n```\r\n\r\n當我們完成後，想要重新添加安全層時，可以使用 `enableCpiGuard` 指令重新啟用，如下所示：\r\n\r\n```ts\r\nconst enableCpiGuardInstruction = createEnableCpiGuardInstruction(\r\n    tokenAccount,\r\n    keypair.publicKey,\r\n    undefined,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n```\r\n","highlightedCode":{"code-0":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"import"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" {"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"    Keypair,"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"    SystemProgram,"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"    Transaction,"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"    sendAndConfirmTransaction,"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"} "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"from"}]},{"type":"