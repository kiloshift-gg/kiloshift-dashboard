:40,"offset":575},"end":{"line":9,"column":47,"offset":582}}},{"type":"text","value":"Konto zu initialisieren, benötigen wir die ","position":{"start":{"line":9,"column":47,"offset":582},"end":{"line":9,"column":90,"offset":625}}},{"type":"inlineCode","value":"enableCpiGuard()","position":{"start":{"line":9,"column":90,"offset":625},"end":{"line":9,"column":108,"offset":643}}},{"type":"text","value":"Funktion.","position":{"start":{"line":9,"column":108,"offset":643},"end":{"line":9,"column":117,"offset":652}}}],"position":{"start":{"line":9,"column":1,"offset":536},"end":{"line":9,"column":117,"offset":652}}},{"type":"paragraph","children":[{"type":"text","value":"Hier ist, wie man einen Token mit der Cpi Guard-Erweiterung erstellt:","position":{"start":{"line":11,"column":1,"offset":656},"end":{"line":11,"column":70,"offset":725}}}],"position":{"start":{"line":11,"column":1,"offset":656},"end":{"line":11,"column":70,"offset":725}}},{"type":"code","lang":"ts","meta":null,"value":"import {\r\n    Keypair,\r\n    SystemProgram,\r\n    Transaction,\r\n    sendAndConfirmTransaction,\r\n} from '@solana/web3.js';\r\nimport {\r\n    createInitializeAccountInstruction,\r\n    createEnableCpiGuardInstruction,\r\n    getAccountLen,\r\n    ExtensionType,\r\n    TOKEN_2022_PROGRAM_ID,\r\n} from '@solana/spl-token';\r\n\r\nconst tokenAccount = Keypair.generate();\r\n\r\n// Calculate the size needed for a Token account with Cpi Guard extension\r\nconst accountLen = getAccountLen([ExtensionType.CpiGuard]);\r\n\r\n// Calculate minimum lamports required for rent exemption\r\nconst lamports = await connection.getMinimumBalanceForRentExemption(accountLen);\r\n\r\n// Create the account with the correct size and owner\r\nconst createAccountInstruction = SystemProgram.createAccount({\r\n    fromPubkey: keypair.publicKey,\r\n    newAccountPubkey: tokenAccount.publicKey,\r\n    space: accountLen,\r\n    lamports,\r\n    programId: TOKEN_2022_PROGRAM_ID,\r\n});\r\n\r\n// Initialize the Cpi Guard extension\r\nconst enableCpiGuardInstruction = createEnableCpiGuardInstruction(\r\n    tokenAccount.publicKey,\r\n    keypair.publicKey,\r\n    undefined,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\n// Initialize the Token account itself\r\nconst initializeAccountInstruction = createInitializeAccountInstruction(\r\n    tokenAccount.publicKey,\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAccountInstruction,\r\n    initializeAccountInstruction,\r\n    enableCpiGuardInstruction\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair, tokenAccount], {skipPreflight: false});\r\n\r\nconsole.log(`Token accounts created! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":13,"column":1,"offset":729},"end":{"line":70,"column":4,"offset":2491}},"data":{"highlightId":"code-0"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Deaktivieren des CPI Guards","position":{"start":{"line":72,"column":17,"offset":2511},"end":{"line":72,"column":51,"offset":2545}}},{"type":"mdxJsxAttribute","name":"id","value":"disabling-the-cpi-guard","position":{"start":{"line":72,"column":52,"offset":2546},"end":{"line":72,"column":80,"offset":2574}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":72,"column":81,"offset":2575},"end":{"line":72,"column":91,"offset":2585}}}],"children":[],"position":{"start":{"line":72,"column":1,"offset":2495},"end":{"line":72,"column":94,"offset":2588}}},{"type":"paragraph","children":[{"type":"text","value":"Wenn wir einige der durch den Cpi Guard blockierten Verhaltensweisen aktivieren möchten, können wir den Guard einfach mit der ","position":{"start":{"line":74,"column":1,"offset":2592},"end":{"line":74,"column":127,"offset":2718}}},{"type":"inlineCode","value":"disableCpiGuard","position":{"start":{"line":74,"column":127,"offset":2718},"end":{"line":74,"column":144,"offset":2735}}},{"type":"text","value":"Anweisung deaktivieren, wie folgt:","position":{"start":{"line":74,"column":144,"offset":2735},"end":{"line":74,"column":178,"offset":2769}}}],"position":{"start":{"line":74,"column":1,"offset":2592},"end":{"line":74,"column":178,"offset":2769}}},{"type":"code","lang":"ts","meta":null,"value":"const disableCpiGuardInstruction = createDisableCpiGuardInstruction(\r\n    tokenAccount,\r\n    keypair.publicKey,\r\n    undefined,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);","position":{"start":{"line":76,"column":1,"offset":2773},"end":{"line":83,"column":4,"offset":2944}},"data":{"highlightId":"code-1"}},{"type":"paragraph","children":[{"type":"text","value":"Und wenn wir fertig sind und die Sicherheitsebene wieder hinzufügen möchten, können wir sie mit der ","position":{"start":{"line":85,"column":1,"offset":2948},"end":{"line":85,"column":101,"offset":3048}}},{"type":"inlineCode","value":"enableCpiGuard","position":{"start":{"line":85,"column":101,"offset":3048},"end":{"line":85,"column":117,"offset":3064}}},{"type":"text","value":"Anweisung wie folgt wieder aktivieren:","position":{"start":{"line":85,"column":117,"offset":3064},"end":{"line":85,"column":155,"offset":3102}}}],"position":{"start":{"line":85,"column":1,"offset":2948},"end":{"line":85,"column":155,"offset":3102}}},{"type":"code","lang":"ts","meta":null,"value":"const enableCpiGuardInstruction = createEnableCpiGuardInstruction(\r\n    tokenAccount,\r\n    keypair.publicKey,\r\n    undefined,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);","position":{"start":{"line":87,"column":1,"offset":3106},"end":{"line":94,"column":4,"offset":3275}},"data":{"highlightId":"code-2"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":95,"column":1,"offset":3277}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Die Cpi Guard-Erweiterung\r\n\r\nDie `CpiGuard`Erweiterung ist eine `Token`Kontoerweiterung, die bestimmte Aktionen innerhalb von programmübergreifenden Aufrufen (Cross-Program Invocations) verbietet und Benutzer vor bösartigen Programmen schützt, die versuchen könnten, ihre Token-Konten ohne ausdrückliche Zustimmung zu manipulieren.\r\n\r\n<ArticleSection name=\"Initialisierung des Token-Kontos\" id=\"initializing-the-token-account\" level=\"h2\" />\r\n\r\nUm die `CpiGuard`Erweiterung auf einem `Token`Konto zu initialisieren, benötigen wir die `enableCpiGuard()`Funktion.\r\n\r\nHier ist, wie man einen Token mit der Cpi Guard-Erweiterung erstellt:\r\n\r\n```ts\r\nimport {\r\n    Keypair,\r\n    SystemProgram,\r\n    Transaction,\r\n    sendAndConfirmTransaction,\r\n} from '@solana/web3.js';\r\nimport {\r\n    createInitializeAccountInstruction,\r\n    createEnableCpiGuardInstruction,\r\n    getAccountLen,\r\n    ExtensionType,\r\n    TOKEN_2022_PROGRAM_ID,\r\n} from '@solana/spl-token';\r\n\r\nconst tokenAccount = Keypair.generate();\r\n\r\n// Calculate the size needed for a Token account with Cpi Guard extension\r\nconst accountLen = getAccountLen([ExtensionType.CpiGuard]);\r\n\r\n// Calculate minimum lamports required for rent exemption\r\nconst lamports = await connection.getMinimumBalanceForRentExemption(accountLen);\r\n\r\n// Create the account with the correct size and owner\r\nconst createAccountInstruction = SystemProgram.createAccount({\r\n    fromPubkey: keypair.publicKey,\r\n    newAccountPubkey: tokenAccount.publicKey,\r\n    space: accountLen,\r\n    lamports,\r\n    programId: TOKEN_2022_PROGRAM_ID,\r\n});\r\n\r\n// Initialize the Cpi Guard extension\r\nconst enableCpiGuardInstruction = createEnableCpiGuardInstruction(\r\n    tokenAccount.publicKey,\r\n    keypair.publicKey,\r\n    undefined,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\n// Initialize the Token account itself\r\nconst initializeAccountInstruction = createInitializeAccountInstruction(\r\n    tokenAccount.publicKey,\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAccountInstruction,\r\n    initializeAccountInstruction,\r\n    enableCpiGuardInstruction\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair, tokenAccount], {skipPreflight: false});\r\n\r\nconsole.log(`Token accounts created! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\n<ArticleSection name=\"Deaktivieren des CPI Guards\" id=\"disabling-the-cpi-guard\" level=\"h2\" />\r\n\r\nWenn wir einige der durch den Cpi Guard blockierten Verhaltensweisen aktivieren möchten, können wir den Guard einfach mit der `disableCpiGuard`Anweisung deaktivieren, wie folgt:\r\n\r\n```ts\r\nconst disableCpiGuardInstruction = createDisableCpiGuardInstruction(\r\n    tokenAccount,\r\n    keypair.publicKey,\r\n    undefined,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n```\r\n\r\nUnd wenn wir fertig sind und die Sicherheitsebene wieder hinzufügen möchten, können wir sie mit der `enableCpiGuard`Anweisung wie folgt wieder aktivieren:\r\n\r\n```ts\r\nconst enableCpiGuardInstruction = createEnableCpiGuardInstruction(\r\n    tokenAccount,\r\n    keypair.publicKey,\r\n    undefined,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n```\r\n","highlightedCode":{"code-0":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"import"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" {"}]}]},{"type":"te