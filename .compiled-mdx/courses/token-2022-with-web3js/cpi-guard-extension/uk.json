  tokenAccount.publicKey,\r\n    keypair.publicKey,\r\n    undefined,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\n// Initialize the Token account itself\r\nconst initializeAccountInstruction = createInitializeAccountInstruction(\r\n    tokenAccount.publicKey,\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAccountInstruction,\r\n    initializeAccountInstruction,\r\n    enableCpiGuardInstruction\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair, tokenAccount], {skipPreflight: false});\r\n\r\nconsole.log(`Token accounts created! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":13,"column":1,"offset":634},"end":{"line":70,"column":4,"offset":2396}},"data":{"highlightId":"code-0"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Вимкнення CPI Guard","position":{"start":{"line":72,"column":17,"offset":2416},"end":{"line":72,"column":43,"offset":2442}}},{"type":"mdxJsxAttribute","name":"id","value":"disabling-the-cpi-guard","position":{"start":{"line":72,"column":44,"offset":2443},"end":{"line":72,"column":72,"offset":2471}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":72,"column":73,"offset":2472},"end":{"line":72,"column":83,"offset":2482}}}],"children":[],"position":{"start":{"line":72,"column":1,"offset":2400},"end":{"line":72,"column":86,"offset":2485}}},{"type":"paragraph","children":[{"type":"text","value":"Коли ми хочемо дозволити деякі з поведінок, які блокуються Cpi Guard, ми можемо легко вимкнути захист за допомогою інструкції ","position":{"start":{"line":74,"column":1,"offset":2489},"end":{"line":74,"column":127,"offset":2615}}},{"type":"inlineCode","value":"disableCpiGuard","position":{"start":{"line":74,"column":127,"offset":2615},"end":{"line":74,"column":144,"offset":2632}}},{"type":"text","value":" таким чином:","position":{"start":{"line":74,"column":144,"offset":2632},"end":{"line":74,"column":157,"offset":2645}}}],"position":{"start":{"line":74,"column":1,"offset":2489},"end":{"line":74,"column":157,"offset":2645}}},{"type":"code","lang":"ts","meta":null,"value":"const disableCpiGuardInstruction = createDisableCpiGuardInstruction(\r\n    tokenAccount,\r\n    keypair.publicKey,\r\n    undefined,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);","position":{"start":{"line":76,"column":1,"offset":2649},"end":{"line":83,"column":4,"offset":2820}},"data":{"highlightId":"code-1"}},{"type":"paragraph","children":[{"type":"text","value":"А коли ми закінчили і хочемо повернути шар безпеки, ми можемо повторно активувати його за допомогою інструкції ","position":{"start":{"line":85,"column":1,"offset":2824},"end":{"line":85,"column":112,"offset":2935}}},{"type":"inlineCode","value":"enableCpiGuard","position":{"start":{"line":85,"column":112,"offset":2935},"end":{"line":85,"column":128,"offset":2951}}},{"type":"text","value":" таким чином:","position":{"start":{"line":85,"column":128,"offset":2951},"end":{"line":85,"column":141,"offset":2964}}}],"position":{"start":{"line":85,"column":1,"offset":2824},"end":{"line":85,"column":141,"offset":2964}}},{"type":"code","lang":"ts","meta":null,"value":"const enableCpiGuardInstruction = createEnableCpiGuardInstruction(\r\n    tokenAccount,\r\n    keypair.publicKey,\r\n    undefined,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);","position":{"start":{"line":87,"column":1,"offset":2968},"end":{"line":94,"column":4,"offset":3137}},"data":{"highlightId":"code-2"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":95,"column":1,"offset":3139}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Розширення Cpi Guard\r\n\r\nРозширення `CpiGuard` є розширенням облікового запису `Token`, яке забороняє певні дії всередині міжпрограмних викликів, захищаючи користувачів від зловмисних програм, які можуть спробувати маніпулювати їхніми токен-рахунками без явної згоди.\r\n\r\n<ArticleSection name=\"Ініціалізація токен-рахунку\" id=\"initializing-the-token-account\" level=\"h2\" />\r\n\r\nЩоб ініціалізувати розширення `CpiGuard` на обліковому записі `Token`, нам знадобиться функція `enableCpiGuard()`.\r\n\r\nОсь як створити токен з розширенням Cpi Guard:\r\n\r\n```ts\r\nimport {\r\n    Keypair,\r\n    SystemProgram,\r\n    Transaction,\r\n    sendAndConfirmTransaction,\r\n} from '@solana/web3.js';\r\nimport {\r\n    createInitializeAccountInstruction,\r\n    createEnableCpiGuardInstruction,\r\n    getAccountLen,\r\n    ExtensionType,\r\n    TOKEN_2022_PROGRAM_ID,\r\n} from '@solana/spl-token';\r\n\r\nconst tokenAccount = Keypair.generate();\r\n\r\n// Calculate the size needed for a Token account with Cpi Guard extension\r\nconst accountLen = getAccountLen([ExtensionType.CpiGuard]);\r\n\r\n// Calculate minimum lamports required for rent exemption\r\nconst lamports = await connection.getMinimumBalanceForRentExemption(accountLen);\r\n\r\n// Create the account with the correct size and owner\r\nconst createAccountInstruction = SystemProgram.createAccount({\r\n    fromPubkey: keypair.publicKey,\r\n    newAccountPubkey: tokenAccount.publicKey,\r\n    space: accountLen,\r\n    lamports,\r\n    programId: TOKEN_2022_PROGRAM_ID,\r\n});\r\n\r\n// Initialize the Cpi Guard extension\r\nconst enableCpiGuardInstruction = createEnableCpiGuardInstruction(\r\n    tokenAccount.publicKey,\r\n    keypair.publicKey,\r\n    undefined,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\n// Initialize the Token account itself\r\nconst initializeAccountInstruction = createInitializeAccountInstruction(\r\n    tokenAccount.publicKey,\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAccountInstruction,\r\n    initializeAccountInstruction,\r\n    enableCpiGuardInstruction\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair, tokenAccount], {skipPreflight: false});\r\n\r\nconsole.log(`Token accounts created! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\n<ArticleSection name=\"Вимкнення CPI Guard\" id=\"disabling-the-cpi-guard\" level=\"h2\" />\r\n\r\nКоли ми хочемо дозволити деякі з поведінок, які блокуються Cpi Guard, ми можемо легко вимкнути захист за допомогою інструкції `disableCpiGuard` таким чином:\r\n\r\n```ts\r\nconst disableCpiGuardInstruction = createDisableCpiGuardInstruction(\r\n    tokenAccount,\r\n    keypair.publicKey,\r\n    undefined,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n```\r\n\r\nА коли ми закінчили і хочемо повернути шар безпеки, ми можемо повторно активувати його за допомогою інструкції `enableCpiGuard` таким чином:\r\n\r\n```ts\r\nconst enableCpiGuardInstruction = createEnableCpiGuardInstruction(\r\n    tokenAccount,\r\n    keypair.publicKey,\r\n    undefined,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n```\r\n","highlightedCode":{"code-0":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"import"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" {"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"    Keypair,"}]}]},{"type":"text","value":"\n"},{"type":"element","t