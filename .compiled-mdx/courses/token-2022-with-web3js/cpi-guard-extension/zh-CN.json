osition":{"start":{"line":9,"column":58,"offset":360},"end":{"line":9,"column":62,"offset":364}}}],"position":{"start":{"line":9,"column":1,"offset":303},"end":{"line":9,"column":62,"offset":364}}},{"type":"paragraph","children":[{"type":"text","value":"以下是如何使用 Cpi Guard 扩展创建一个 mint：","position":{"start":{"line":11,"column":1,"offset":368},"end":{"line":11,"column":31,"offset":398}}}],"position":{"start":{"line":11,"column":1,"offset":368},"end":{"line":11,"column":31,"offset":398}}},{"type":"code","lang":"ts","meta":null,"value":"import {\r\n    Keypair,\r\n    SystemProgram,\r\n    Transaction,\r\n    sendAndConfirmTransaction,\r\n} from '@solana/web3.js';\r\nimport {\r\n    createInitializeAccountInstruction,\r\n    createInitializeImmutableOwnerInstruction,\r\n    getAccountLen,\r\n    ExtensionType,\r\n    TOKEN_2022_PROGRAM_ID,\r\n} from '@solana/spl-token';\r\n\r\nconst tokenAccount = Keypair.generate();\r\n\r\n// Calculate the size needed for a Token account with Transfer Fee extension\r\nconst accountLen = getAccountLen([ExtensionType.ImmutableOwner]);\r\n\r\n// Calculate minimum lamports required for rent exemption\r\nconst lamports = await connection.getMinimumBalanceForRentExemption(accountLen);\r\n\r\n// Create the account with the correct size and owner\r\nconst createAccountInstruction = SystemProgram.createAccount({\r\n    fromPubkey: keypair.publicKey,\r\n    newAccountPubkey: tokenAccount.publicKey,\r\n    space: accountLen,\r\n    lamports,\r\n    programId: TOKEN_2022_PROGRAM_ID,\r\n});\r\n\r\n// Initialize the Cpi Guard extension\r\nconst enableCpiGuardInstruction = createEnableCpiGuardInstruction(\r\n    tokenAccount.publicKey,\r\n    keypair.publicKey,\r\n    undefined,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\n// Initialize the Token account itself\r\nconst initializeAccountInstruction = createInitializeAccountInstruction(\r\n    tokenAccount.publicKey,\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAccountInstruction,\r\n    initializeAccountInstruction,\r\n    enableCpiGuardInstruction\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair, tokenAccount], {skipPreflight: false});\r\n\r\nconsole.log(`Token accounts created! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":13,"column":1,"offset":402},"end":{"line":70,"column":4,"offset":2183}},"data":{"highlightId":"code-0"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"禁用 CPI Guard","position":{"start":{"line":72,"column":17,"offset":2203},"end":{"line":72,"column":36,"offset":2222}}},{"type":"mdxJsxAttribute","name":"id","value":"disabling-the-cpi-guard","position":{"start":{"line":72,"column":37,"offset":2223},"end":{"line":72,"column":65,"offset":2251}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":72,"column":66,"offset":2252},"end":{"line":72,"column":76,"offset":2262}}}],"children":[],"position":{"start":{"line":72,"column":1,"offset":2187},"end":{"line":72,"column":79,"offset":2265}}},{"type":"paragraph","children":[{"type":"text","value":"当我们希望启用被 Cpi Guard 阻止的一些行为时，可以通过使用 ","position":{"start":{"line":74,"column":1,"offset":2269},"end":{"line":74,"column":36,"offset":2304}}},{"type":"inlineCode","value":"disableCpiGuard","position":{"start":{"line":74,"column":36,"offset":2304},"end":{"line":74,"column":53,"offset":2321}}},{"type":"text","value":" 指令轻松禁用该保护，如下所示：","position":{"start":{"line":74,"column":53,"offset":2321},"end":{"line":74,"column":69,"offset":2337}}}],"position":{"start":{"line":74,"column":1,"offset":2269},"end":{"line":74,"column":69,"offset":2337}}},{"type":"code","lang":"ts","meta":null,"value":"const disableCpiGuardInstruction = createDisableCpiGuardInstruction(\r\n    tokenAccount,\r\n    keypair.publicKey,\r\n    undefined,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);","position":{"start":{"line":76,"column":1,"offset":2341},"end":{"line":83,"column":4,"offset":2512}},"data":{"highlightId":"code-1"}},{"type":"paragraph","children":[{"type":"text","value":"完成后，如果我们希望重新添加安全层，可以通过使用 ","position":{"start":{"line":85,"column":1,"offset":2516},"end":{"line":85,"column":26,"offset":2541}}},{"type":"inlineCode","value":"enableCpiGuard","position":{"start":{"line":85,"column":26,"offset":2541},"end":{"line":85,"column":42,"offset":2557}}},{"type":"text","value":" 指令重新启用，如下所示：","position":{"start":{"line":85,"column":42,"offset":2557},"end":{"line":85,"column":55,"offset":2570}}}],"position":{"start":{"line":85,"column":1,"offset":2516},"end":{"line":85,"column":55,"offset":2570}}},{"type":"code","lang":"ts","meta":null,"value":"const enableCpiGuardInstruction = createEnableCpiGuardInstruction(\r\n    tokenAccount,\r\n    keypair.publicKey,\r\n    undefined,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);","position":{"start":{"line":87,"column":1,"offset":2574},"end":{"line":94,"column":4,"offset":2743}},"data":{"highlightId":"code-2"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":95,"column":1,"offset":2745}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Cpi Guard 扩展\r\n\r\n`CpiGuard` 扩展是一种 `Token` 账户扩展，它禁止在跨程序调用中执行某些操作，从而保护用户免受可能试图在未经明确同意的情况下操控其 token account 的恶意程序的侵害。\r\n\r\n<ArticleSection name=\"初始化 Token Account\" id=\"initializing-the-token-account\" level=\"h2\" />\r\n\r\n要在 `Token` 账户上初始化 `CpiGuard` 扩展，我们需要使用 `enableCpiGuard()` 函数。\r\n\r\n以下是如何使用 Cpi Guard 扩展创建一个 mint：\r\n\r\n```ts\r\nimport {\r\n    Keypair,\r\n    SystemProgram,\r\n    Transaction,\r\n    sendAndConfirmTransaction,\r\n} from '@solana/web3.js';\r\nimport {\r\n    createInitializeAccountInstruction,\r\n    createInitializeImmutableOwnerInstruction,\r\n    getAccountLen,\r\n    ExtensionType,\r\n    TOKEN_2022_PROGRAM_ID,\r\n} from '@solana/spl-token';\r\n\r\nconst tokenAccount = Keypair.generate();\r\n\r\n// Calculate the size needed for a Token account with Transfer Fee extension\r\nconst accountLen = getAccountLen([ExtensionType.ImmutableOwner]);\r\n\r\n// Calculate minimum lamports required for rent exemption\r\nconst lamports = await connection.getMinimumBalanceForRentExemption(accountLen);\r\n\r\n// Create the account with the correct size and owner\r\nconst createAccountInstruction = SystemProgram.createAccount({\r\n    fromPubkey: keypair.publicKey,\r\n    newAccountPubkey: tokenAccount.publicKey,\r\n    space: accountLen,\r\n    lamports,\r\n    programId: TOKEN_2022_PROGRAM_ID,\r\n});\r\n\r\n// Initialize the Cpi Guard extension\r\nconst enableCpiGuardInstruction = createEnableCpiGuardInstruction(\r\n    tokenAccount.publicKey,\r\n    keypair.publicKey,\r\n    undefined,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\n// Initialize the Token account itself\r\nconst initializeAccountInstruction = createInitializeAccountInstruction(\r\n    tokenAccount.publicKey,\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAccountInstruction,\r\n    initializeAccountInstruction,\r\n    enableCpiGuardInstruction\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair, tokenAccount], {skipPreflight: false});\r\n\r\nconsole.log(`Token accounts created! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\n<ArticleSection name=\"禁用 CPI Guard\" id=\"disabling-the-cpi-guard\" level=\"h2\" />\r\n\r\n当我们希望启用被 Cpi Guard 阻止的一些行为时，可以通过使用 `disableCpiGuard` 指令轻松禁用该保护，如下所示：\r\n\r\n```ts\r\nconst disableCpiGuardInstruction = createDisableCpiGuardInstruction(\r\n    tokenAccount,\r\n    keypair.publicKey,\r\n    undefined,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n```\r\n\r\n完成后，如果我们希望重新添加安全层，可以通过使用 `enableCpiGuard` 指令重新启用，如下所示：\r\n\r\n```ts\r\nconst enableCpiGuardInstruction = createEnableCpiGuardInstruction(\r\n    tokenAccount,\r\n    keypair.publicKey,\r\n    undefined,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n```\r\n","highlightedCode":{"code-0":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"import"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" {"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"    Keypair,"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"    SystemProgram,"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"    Transaction,"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"    sendAndConfirmTransaction,"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"} "}]},{"type":"element","tagName":