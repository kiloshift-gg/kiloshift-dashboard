nAccount.publicKey,\r\n    keypair.publicKey,\r\n    undefined,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\n// Initialize the Token account itself\r\nconst initializeAccountInstruction = createInitializeAccountInstruction(\r\n    tokenAccount.publicKey,\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAccountInstruction,\r\n    initializeAccountInstruction,\r\n    enableCpiGuardInstruction\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair, tokenAccount], {skipPreflight: false});\r\n\r\nconsole.log(`Token accounts created! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":13,"column":1,"offset":614},"end":{"line":70,"column":4,"offset":2395}},"data":{"highlightId":"code-0"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Vô hiệu hóa CPI Guard","position":{"start":{"line":72,"column":17,"offset":2415},"end":{"line":72,"column":45,"offset":2443}}},{"type":"mdxJsxAttribute","name":"id","value":"disabling-the-cpi-guard","position":{"start":{"line":72,"column":46,"offset":2444},"end":{"line":72,"column":74,"offset":2472}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":72,"column":75,"offset":2473},"end":{"line":72,"column":85,"offset":2483}}}],"children":[],"position":{"start":{"line":72,"column":1,"offset":2399},"end":{"line":72,"column":88,"offset":2486}}},{"type":"paragraph","children":[{"type":"text","value":"Khi chúng ta muốn tái kích hoạt một số hành vi bị chặn bởi Cpi guard, chúng ta có thể dễ dàng vô hiệu hóa guard bằng cách sử dụng instruction ","position":{"start":{"line":74,"column":1,"offset":2490},"end":{"line":74,"column":143,"offset":2632}}},{"type":"inlineCode","value":"disableCpiGuard","position":{"start":{"line":74,"column":143,"offset":2632},"end":{"line":74,"column":160,"offset":2649}}},{"type":"text","value":" như thế này:","position":{"start":{"line":74,"column":160,"offset":2649},"end":{"line":74,"column":173,"offset":2662}}}],"position":{"start":{"line":74,"column":1,"offset":2490},"end":{"line":74,"column":173,"offset":2662}}},{"type":"code","lang":"ts","meta":null,"value":"const disableCpiGuardInstruction = createDisableCpiGuardInstruction(\r\n    tokenAccount,\r\n    keypair.publicKey,\r\n    undefined,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);","position":{"start":{"line":76,"column":1,"offset":2666},"end":{"line":83,"column":4,"offset":2837}},"data":{"highlightId":"code-1"}},{"type":"paragraph","children":[{"type":"text","value":"Và khi chúng ta hoàn thành và muốn thêm lại lớp bảo mật, chúng ta có thể kích hoạt lại bằng cách sử dụng instruction ","position":{"start":{"line":85,"column":1,"offset":2841},"end":{"line":85,"column":118,"offset":2958}}},{"type":"inlineCode","value":"enableCpiGuard","position":{"start":{"line":85,"column":118,"offset":2958},"end":{"line":85,"column":134,"offset":2974}}},{"type":"text","value":" như thế này:","position":{"start":{"line":85,"column":134,"offset":2974},"end":{"line":85,"column":147,"offset":2987}}}],"position":{"start":{"line":85,"column":1,"offset":2841},"end":{"line":85,"column":147,"offset":2987}}},{"type":"code","lang":"ts","meta":null,"value":"const enableCpiGuardInstruction = createEnableCpiGuardInstruction(\r\n    tokenAccount,\r\n    keypair.publicKey,\r\n    undefined,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);","position":{"start":{"line":87,"column":1,"offset":2991},"end":{"line":94,"column":4,"offset":3160}},"data":{"highlightId":"code-2"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":95,"column":1,"offset":3162}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Phần mở rộng CPI Guard\r\n\r\nPhần mở rộng `CpiGuard` là một `Token` account extension ngăn chặn một số hành động bên trong cross-program invocation, bảo vệ người dùng khỏi các chương trình độc hại có thể cố gắng thao tác token account của họ mà không có sự đồng ý rõ ràng.\r\n\r\n<ArticleSection name=\"Khởi tạo Token Account\" id=\"initializing-the-token-account\" level=\"h2\" />\r\n\r\nĐể khởi tạo extension `CpiGuard` trên `Token` account, chúng ta sẽ cần hàm `enableCpiGuard()`.\r\n\r\nĐây là cách tạo mint với phần mở rộng Cpi Guard:\r\n\r\n```ts\r\nimport {\r\n    Keypair,\r\n    SystemProgram,\r\n    Transaction,\r\n    sendAndConfirmTransaction,\r\n} from '@solana/web3.js';\r\nimport {\r\n    createInitializeAccountInstruction,\r\n    createInitializeImmutableOwnerInstruction,\r\n    getAccountLen,\r\n    ExtensionType,\r\n    TOKEN_2022_PROGRAM_ID,\r\n} from '@solana/spl-token';\r\n\r\nconst tokenAccount = Keypair.generate();\r\n\r\n// Calculate the size needed for a Token account with Transfer Fee extension\r\nconst accountLen = getAccountLen([ExtensionType.ImmutableOwner]);\r\n\r\n// Calculate minimum lamports required for rent exemption\r\nconst lamports = await connection.getMinimumBalanceForRentExemption(accountLen);\r\n\r\n// Create the account with the correct size and owner\r\nconst createAccountInstruction = SystemProgram.createAccount({\r\n    fromPubkey: keypair.publicKey,\r\n    newAccountPubkey: tokenAccount.publicKey,\r\n    space: accountLen,\r\n    lamports,\r\n    programId: TOKEN_2022_PROGRAM_ID,\r\n});\r\n\r\n// Initialize the Cpi Guard extension\r\nconst enableCpiGuardInstruction = createEnableCpiGuardInstruction(\r\n    tokenAccount.publicKey,\r\n    keypair.publicKey,\r\n    undefined,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\n// Initialize the Token account itself\r\nconst initializeAccountInstruction = createInitializeAccountInstruction(\r\n    tokenAccount.publicKey,\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAccountInstruction,\r\n    initializeAccountInstruction,\r\n    enableCpiGuardInstruction\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair, tokenAccount], {skipPreflight: false});\r\n\r\nconsole.log(`Token accounts created! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\n<ArticleSection name=\"Vô hiệu hóa CPI Guard\" id=\"disabling-the-cpi-guard\" level=\"h2\" />\r\n\r\nKhi chúng ta muốn tái kích hoạt một số hành vi bị chặn bởi Cpi guard, chúng ta có thể dễ dàng vô hiệu hóa guard bằng cách sử dụng instruction `disableCpiGuard` như thế này:\r\n\r\n```ts\r\nconst disableCpiGuardInstruction = createDisableCpiGuardInstruction(\r\n    tokenAccount,\r\n    keypair.publicKey,\r\n    undefined,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n```\r\n\r\nVà khi chúng ta hoàn thành và muốn thêm lại lớp bảo mật, chúng ta có thể kích hoạt lại bằng cách sử dụng instruction `enableCpiGuard` như thế này:\r\n\r\n```ts\r\nconst enableCpiGuardInstruction = createEnableCpiGuardInstruction(\r\n    tokenAccount,\r\n    keypair.publicKey,\r\n    undefined,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n```\r\n","highlightedCode":{"code-0":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"import"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" {"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"    Keypair,"}]}]},{"type":