t":3573}}},{"type":"inlineCode","value":"transferChecked()","position":{"start":{"line":99,"column":44,"offset":3573},"end":{"line":99,"column":63,"offset":3592}}},{"type":"text","value":", ","position":{"start":{"line":99,"column":63,"offset":3592},"end":{"line":99,"column":65,"offset":3594}}},{"type":"inlineCode","value":"burnChecked()","position":{"start":{"line":99,"column":65,"offset":3594},"end":{"line":99,"column":80,"offset":3609}}},{"type":"text","value":", ... instructions and pass in the ","position":{"start":{"line":99,"column":80,"offset":3609},"end":{"line":99,"column":115,"offset":3644}}},{"type":"inlineCode","value":"PermanentDelegate","position":{"start":{"line":99,"column":115,"offset":3644},"end":{"line":99,"column":134,"offset":3663}}},{"type":"text","value":" authority in the ","position":{"start":{"line":99,"column":134,"offset":3663},"end":{"line":99,"column":152,"offset":3681}}},{"type":"inlineCode","value":"authority","position":{"start":{"line":99,"column":152,"offset":3681},"end":{"line":99,"column":163,"offset":3692}}},{"type":"text","value":" field.","position":{"start":{"line":99,"column":163,"offset":3692},"end":{"line":99,"column":170,"offset":3699}}}],"position":{"start":{"line":99,"column":1,"offset":3530},"end":{"line":99,"column":170,"offset":3699}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":99,"column":170,"offset":3699}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# The Permanent Delegate Extension\r\n\r\nThe `PermanentDelegate` extension is a Mint account extension that allows a permanent delegate for all tokens of the mint that is capable of transferring or burning any token of that mint, from any token account.\r\n\r\n<ArticleSection name=\"Initializing the Mint Account\" id=\"initializing-the-mint-account\" level=\"h2\" />\r\n\r\nTo initialize the `PermanentDelegate` extension on a `Mint` account we're going to need the `initializePermanentDelegate()` function. \r\n\r\nHere's how to create a mint with the Permanent Delegate extension:\r\n\r\n```ts\r\nimport {\r\n    Keypair,\r\n    SystemProgram,\r\n    Transaction,\r\n    sendAndConfirmTransaction,\r\n} from '@solana/web3.js';\r\nimport {\r\n    createInitializeMintInstruction,\r\n    createInitializePermanentDelegateInstruction,\r\n    getMintLen,\r\n    ExtensionType,\r\n    TOKEN_2022_PROGRAM_ID,\r\n} from '@solana/spl-token';\r\n\r\nconst mint = Keypair.generate();\r\n\r\n// Calculate the size needed for a Mint account with Permanent Delegate extension\r\nconst mintLen = getMintLen([ExtensionType.PermanentDelegate]);\r\n\r\n// Calculate minimum lamports required for rent exemption\r\nconst lamports = await connection.getMinimumBalanceForRentExemption(mintLen);\r\n\r\n// Create the account with the correct size and owner\r\nconst createAccountInstruction = SystemProgram.createAccount({\r\n    fromPubkey: keypair.publicKey,\r\n    newAccountPubkey: mint.publicKey,\r\n    space: mintLen,\r\n    lamports,\r\n    programId: TOKEN_2022_PROGRAM_ID,\r\n});\r\n\r\n// Initialize the Permanent Delegate extension\r\nconst initializePermanentDelegate = createInitializePermanentDelegateInstruction(\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\n// Initialize the mint itself\r\nconst initializeMintInstruction = createInitializeMintInstruction(\r\n    mint.publicKey,\r\n    6,\r\n    keypair.publicKey,\r\n    null,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\n// Combine all instructions in the correct order\r\nconst transaction = new Transaction().add(\r\n    createAccountInstruction,\r\n    initializePermanentDelegate,\r\n    initializeMintInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair, mint]);\r\n\r\nconsole.log(`Mint created! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\n<ArticleSection name=\"Closing the Mint Account\" id=\"closing-the-mint-account\" level=\"h2\" />\r\n\r\nIf a `Mint` account has a supply of zero, the `CloseMint Authority` can reclaim the rent on that account by using the `closeAccount` instruction like so:\r\n\r\n```ts\r\nconst closeMintInstruction = createCloseAccountInstruction(\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n    keypair.publicKey,\r\n    [],\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\nconst transaction = new Transaction().add(closeMintInstruction);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair], {skipPreflight: false});\r\n\r\nconsole.log(`Mint closed! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\n<ArticleSection name=\"Permissioned Actions\" id=\"permissioned-actions\" level=\"h2\" />\r\n\r\nUnlike regular delegates which can be revoked, this delegate authority is permanent and immutable. \r\n\r\nThis means that every normal action like `transfer()`, `burn()`, `approve()` and `freeze()` can be executed whenever needed directly by the authority without needing the signature of the actual owner.\r\n\r\nThis means that we can just use the normal `transferChecked()`, `burnChecked()`, ... instructions and pass in the `PermanentDelegate` authority in the `authority` field.","highlightedCode":{"code-0":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"import"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" {"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span