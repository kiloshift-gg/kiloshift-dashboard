 6,\r\n    keypair.publicKey,\r\n    null,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\n// Combine all instructions in the correct order\r\nconst transaction = new Transaction().add(\r\n    createAccountInstruction,\r\n    initializePermanentDelegate,\r\n    initializeMintInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair, mint]);\r\n\r\nconsole.log(`Mint created! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":13,"column":1,"offset":657},"end":{"line":71,"column":4,"offset":2398}},"data":{"highlightId":"code-0"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Closing the Mint Account","position":{"start":{"line":73,"column":17,"offset":2418},"end":{"line":73,"column":48,"offset":2449}}},{"type":"mdxJsxAttribute","name":"id","value":"closing-the-mint-account","position":{"start":{"line":73,"column":49,"offset":2450},"end":{"line":73,"column":78,"offset":2479}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":73,"column":79,"offset":2480},"end":{"line":73,"column":89,"offset":2490}}}],"children":[],"position":{"start":{"line":73,"column":1,"offset":2402},"end":{"line":73,"column":92,"offset":2493}}},{"type":"paragraph","children":[{"type":"text","value":"If a ","position":{"start":{"line":75,"column":1,"offset":2497},"end":{"line":75,"column":6,"offset":2502}}},{"type":"inlineCode","value":"Mint","position":{"start":{"line":75,"column":6,"offset":2502},"end":{"line":75,"column":12,"offset":2508}}},{"type":"text","value":" account has a supply of zero, the ","position":{"start":{"line":75,"column":12,"offset":2508},"end":{"line":75,"column":47,"offset":2543}}},{"type":"inlineCode","value":"CloseMint Authority","position":{"start":{"line":75,"column":47,"offset":2543},"end":{"line":75,"column":68,"offset":2564}}},{"type":"text","value":" can recla