 [keypair, mint]);\r\n\r\nconsole.log(`Mint created! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":13,"column":1,"offset":425},"end":{"line":71,"column":4,"offset":2161}},"data":{"highlightId":"code-0"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"关闭 Mint Account","position":{"start":{"line":73,"column":17,"offset":2181},"end":{"line":73,"column":39,"offset":2203}}},{"type":"mdxJsxAttribute","name":"id","value":"closing-the-mint-account","position":{"start":{"line":73,"column":40,"offset":2204},"end":{"line":73,"column":69,"offset":2233}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":73,"column":70,"offset":2234},"end":{"line":73,"column":80,"offset":2244}}}],"children":[],"position":{"start":{"line":73,"column":1,"offset":2165},"end":{"line":73,"column":83,"offset":2247}}},{"type":"paragraph","children":[{"type":"text","value":"如果 ","position":{"start":{"line":75,"column":1,"offset":2251},"end":{"line":75,"column":4,"offset":2254}}},{"type":"inlineCode","value":"Mint","position":{"start":{"line":75,"column":4,"offset":2254},"end":{"line":75,"column":10,"offset":2260}}},{"type":"text","value":" 账户的供应量为零，","position":{"start":{"line":75,"column":10,"offset":2260},"end":{"line":75,"column":20,"offset":2270}}},{"type":"inlineCode","value":"CloseMint Authority","position":{"start":{"line":75,"column":20,"offset":2270},"end":{"line":75,"column":41,"offset":2291}}},{"type":"text","value":" 可以通过使用 ","position":{"start":{"line":75,"column":41,"offset":2291},"end":{"line":75,"column":49,"offset":2299}}},{"type":"inlineCode","value":"closeAccount","position":{"start":{"line":75,"column":49,"offset":2299},"end":{"line":75,"column":63,"offset":2313}}},{"type":"text","value":" 指令来回收该账户的 rent，如下所示：","position":{"start":{"line":75,"column":63,"offset":2313},"end":{"line":75,"column":84,"offset":2334}}}],"po