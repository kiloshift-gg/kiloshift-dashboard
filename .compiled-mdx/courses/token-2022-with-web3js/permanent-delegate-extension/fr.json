itializeMintInstruction(\r\n    mint.publicKey,\r\n    6,\r\n    keypair.publicKey,\r\n    null,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\n// Combine all instructions in the correct order\r\nconst transaction = new Transaction().add(\r\n    createAccountInstruction,\r\n    initializePermanentDelegate,\r\n    initializeMintInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair, mint]);\r\n\r\nconsole.log(`Mint created! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":13,"column":1,"offset":706},"end":{"line":71,"column":4,"offset":2447}},"data":{"highlightId":"code-0"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Closing the Mint Account","position":{"start":{"line":73,"column":17,"offset":2467},"end":{"line":73,"column":48,"offset":2498}}},{"type":"mdxJsxAttribute","name":"id","value":"closing-the-mint-account","position":{"start":{"line":73,"column":49,"offset":2499},"end":{"line":73,"column":78,"offset":2528}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":73,"column":79,"offset":2529},"end":{"line":73,"column":89,"offset":2539}}}],"children":[],"position":{"start":{"line":73,"column":1,"offset":2451},"end":{"line":73,"column":92,"offset":2542}}},{"type":"paragraph","children":[{"type":"text","value":"Si un compte ","position":{"start":{"line":75,"column":1,"offset":2546},"end":{"line":75,"column":14,"offset":2559}}},{"type":"inlineCode","value":"Mint","position":{"start":{"line":75,"column":14,"offset":2559},"end":{"line":75,"column":20,"offset":2565}}},{"type":"text","value":" a une offre de zéro, le ","position":{"start":{"line":75,"column":20,"offset":2565},"end":{"line":75,"column":45,"offset":2590}}},{"type":"inlineCode","value":"CloseMint Authority","position":{"start":{"line":75,"column":45,"offset":2590},"end":{"line":75,"column":