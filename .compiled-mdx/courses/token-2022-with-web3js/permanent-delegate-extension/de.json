izeMintInstruction(\r\n    mint.publicKey,\r\n    6,\r\n    keypair.publicKey,\r\n    null,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\n// Combine all instructions in the correct order\r\nconst transaction = new Transaction().add(\r\n    createAccountInstruction,\r\n    initializePermanentDelegate,\r\n    initializeMintInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair, mint]);\r\n\r\nconsole.log(`Mint created! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":13,"column":1,"offset":704},"end":{"line":71,"column":4,"offset":2445}},"data":{"highlightId":"code-0"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Schließen des Mint-Kontos","position":{"start":{"line":73,"column":17,"offset":2465},"end":{"line":73,"column":49,"offset":2497}}},{"type":"mdxJsxAttribute","name":"id","value":"closing-the-mint-account","position":{"start":{"line":73,"column":50,"offset":2498},"end":{"line":73,"column":79,"offset":2527}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":73,"column":80,"offset":2528},"end":{"line":73,"column":90,"offset":2538}}}],"children":[],"position":{"start":{"line":73,"column":1,"offset":2449},"end":{"line":73,"column":93,"offset":2541}}},{"type":"paragraph","children":[{"type":"text","value":"Wenn ein ","position":{"start":{"line":75,"column":1,"offset":2545},"end":{"line":75,"column":10,"offset":2554}}},{"type":"inlineCode","value":"Mint","position":{"start":{"line":75,"column":10,"offset":2554},"end":{"line":75,"column":16,"offset":2560}}},{"type":"text","value":" Konto einen Bestand von null hat, kann der ","position":{"start":{"line":75,"column":16,"offset":2560},"end":{"line":75,"column":60,"offset":2604}}},{"type":"inlineCode","value":"CloseMint Authority","position":{"start":{"line":75,"column":60,"offset":2604},"end":{"line":7