fset":785},"end":{"line":17,"column":45,"offset":817}}},{"type":"text","value":" cho các bài tập thực hành","position":{"start":{"line":17,"column":45,"offset":817},"end":{"line":17,"column":71,"offset":843}}}],"position":{"start":{"line":17,"column":4,"offset":776},"end":{"line":17,"column":71,"offset":843}}}],"position":{"start":{"line":17,"column":1,"offset":773},"end":{"line":17,"column":71,"offset":843}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Tham gia cộng đồng của chúng tôi để chia sẻ ý tưởng, triển khai của bạn và nhận trợ giúp","position":{"start":{"line":18,"column":4,"offset":848},"end":{"line":18,"column":92,"offset":936}}}],"position":{"start":{"line":18,"column":4,"offset":848},"end":{"line":18,"column":92,"offset":936}}}],"position":{"start":{"line":18,"column":1,"offset":845},"end":{"line":18,"column":92,"offset":936}}}],"position":{"start":{"line":17,"column":1,"offset":773},"end":{"line":18,"column":92,"offset":936}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":19,"column":1,"offset":938}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Kết luận\r\n\r\nChúc mừng! Bạn đã hoàn thành khóa học Token2022 with Web3js. Giờ đây bạn đã có hiểu biết vững chắc về cách Token2022 hoạt động với Web3js.\r\n\r\n<ArticleSection name=\"Những gì bạn đã học\" id=\"what-you-learned\" level=\"h2\" />\r\n\r\nTrong suốt khóa học này, bạn đã có được kiến thức thiết yếu về:\r\n- Cách tạo Mint và Token account sử dụng thư viện `@solana/spl-token`\r\n- Cách tạo và sử dụng từng Token Extension qua các ví dụ\r\n\r\n<ArticleSection name=\"Các bước tiếp theo\" id=\"next-steps\" level=\"h2\" />\r\n\r\nBây giờ bạn đã sẵn sàng để bắt đầu sử dụng token program mới và các phần mở rộng để tăng sức mạnh cho chương trình của bạn! Đây là một số bước tiếp theo được khuyến nghị:\r\n\r\n1. Khám phá [phần Thử thách](/vi/challenges) cho các bài tập thực hành\r\n2. Tham gia cộng đồng của chúng tôi để chia sẻ ý tưởng, triển khai của bạn và nhận trợ giúp\r\n","highlightedCode":{}}