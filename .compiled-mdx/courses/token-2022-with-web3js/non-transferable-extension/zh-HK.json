olumn":82,"offset":334},"end":{"line":9,"column":86,"offset":338}}}],"position":{"start":{"line":9,"column":1,"offset":253},"end":{"line":9,"column":86,"offset":338}}},{"type":"paragraph","children":[{"type":"text","value":"以下是如何使用不可轉讓擴展創建鑄幣的方法：","position":{"start":{"line":11,"column":1,"offset":342},"end":{"line":11,"column":22,"offset":363}}}],"position":{"start":{"line":11,"column":1,"offset":342},"end":{"line":11,"column":22,"offset":363}}},{"type":"code","lang":"ts","meta":null,"value":"import {\r\n    Keypair,\r\n    SystemProgram,\r\n    Transaction,\r\n    sendAndConfirmTransaction,\r\n} from '@solana/web3.js';\r\nimport {\r\n    createInitializeMintInstruction,\r\n    createInitializeNonTransferableMintInstruction,\r\n    getMintLen,\r\n    ExtensionType,\r\n    TOKEN_2022_PROGRAM_ID,\r\n} from '@solana/spl-token';\r\n\r\nconst mint = Keypair.generate();\r\n\r\n// Calculate the size needed for a Mint account with Non Transferable extension\r\nconst mintLen = getMintLen([ExtensionType.NonTransferable]);\r\n\r\n// Calculate minimum lamports required for rent exemption\r\nconst lamports = await connection.getMinimumBalanceForRentExemption(mintLen);\r\n\r\n// Create the account with the correct size and owner\r\nconst createAccountInstruction = SystemProgram.createAccount({\r\n    fromPubkey: keypair.publicKey,\r\n    newAccountPubkey: mint.publicKey,\r\n    space: mintLen,\r\n    lamports,\r\n    programId: TOKEN_2022_PROGRAM_ID,\r\n});\r\n\r\n// Initialize the Non Transferable extension\r\nconst initializeMintNonTransferable = createInitializeNonTransferableMintInstruction(\r\n    mint.publicKey,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\n// Initialize the mint itself\r\nconst initializeMintInstruction = createInitializeMintInstruction(\r\n    mint.publicKey,\r\n    6,\r\n    keypair.publicKey,\r\n    null,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\n// Combine all instructions in the correct order\r\nconst transaction = new Transaction().add(\r\n    createAccountInstruction,\r\n    initializeMintNonTransferable,\r\n    initializeMintInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair, mint]);\r\n\r\nconsole.log(`Mint created! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":13,"column":1,"offset":367},"end":{"line":70,"column":4,"offset":2086}},"data":{"highlightId":"code-0"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":70,"column":4,"offset":2086}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# 不可轉讓擴展\r\n\r\n`NonTransferable` 擴展是一個 `Mint` 賬戶擴展，該擴展防止代幣在賬戶之間轉移，使其永久綁定於當前持有人。\r\n\r\n<ArticleSection name=\"初始化鑄幣賬戶\" id=\"initializing-the-mint-account\" level=\"h2\" />\r\n\r\n要在 `Mint` 賬戶上初始化 `MintCloseAuthority` 擴展，我們需要使用 `initializeNonTransferableMint()` 函數。\r\n\r\n以下是如何使用不可轉讓擴展創建鑄幣的方法：\r\n\r\n```ts\r\nimport {\r\n    Keypair,\r\n    SystemProgram,\r\n    Transaction,\r\n    sendAndConfirmTransaction,\r\n} from '@solana/web3.js';\r\nimport {\r\n    createInitializeMintInstruction,\r\n    createInitializeNonTransferableMintInstruction,\r\n    getMintLen,\r\n    ExtensionType,\r\n    TOKEN_2022_PROGRAM_ID,\r\n} from '@solana/spl-token';\r\n\r\nconst mint = Keypair.generate();\r\n\r\n// Calculate the size needed for a Mint account with Non Transferable extension\r\nconst mintLen = getMintLen([ExtensionType.NonTransferable]);\r\n\r\n// Calculate minimum lamports required for rent exemption\r\nconst lamports = await connection.getMinimumBalanceForRentExemption(mintLen);\r\n\r\n// Create the account with the correct size and owner\r\nconst createAccountInstruction = SystemProgram.createAccount({\r\n    fromPubkey: keypair.publicKey,\r\n    newAccountPubkey: mint.publicKey,\r\n    space: mintLen,\r\n    lamports,\r\n    programId: TOKEN_2022_PROGRAM_ID,\r\n});\r\n\r\n// Initialize the Non Transferable extension\r\nconst initializeMintNonTransferable = createInitializeNonTransferableMintInstruction(\r\n    mint.publicKey,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\n// Initialize the mint itself\r\nconst initializeMintInstruction = createInitializeMintInstruction(\r\n    mint.publicKey,\r\n    6,\r\n    keypair.publicKey,\r\n    null,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\n// Combine all instructions in the correct order\r\nconst transaction = new Transaction().add(\r\n    createAccountInstruction,\r\n    initializeMintNonTransferable,\r\n    initializeMintInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair, mint]);\r\n\r\nconsole.log(`Mint created! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```","highlightedCode":{"code-0":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"import"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" {"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"    Keypair,"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"    SystemProgram,"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tag