na/web3.js';\r\nimport {\r\n    createInitializeAccountInstruction,\r\n    createInitializeImmutableOwnerInstruction,\r\n    getAccountLen,\r\n    ExtensionType,\r\n    TOKEN_2022_PROGRAM_ID,\r\n} from '@solana/spl-token';\r\n\r\nconst tokenAccount = Keypair.generate();\r\n\r\n// Calculate the size needed for a Token account with Transfer Fee extension\r\nconst accountLen = getAccountLen([ExtensionType.ImmutableOwner]);\r\n\r\n// Calculate minimum lamports required for rent exemption\r\nconst lamports = await connection.getMinimumBalanceForRentExemption(accountLen);\r\n\r\n// Create the account with the correct size and owner\r\nconst createAccountInstruction = SystemProgram.createAccount({\r\n    fromPubkey: keypair.publicKey,\r\n    newAccountPubkey: tokenAccount.publicKey,\r\n    space: accountLen,\r\n    lamports,\r\n    programId: TOKEN_2022_PROGRAM_ID,\r\n});\r\n\r\n// Initialize the Immutable Owner extension\r\nconst initializeImmutableOwnerInstruction = createInitializeImmutableOwnerInstruction(\r\n    tokenAccount.publicKey,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\n// Initialize the Token account itself\r\nconst initializeAccountInstruction = createInitializeAccountInstruction(\r\n    tokenAccount.publicKey,\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAccountInstruction,\r\n    initializeImmutableOwnerInstruction,\r\n    initializeAccountInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair, tokenAccount], {skipPreflight: false});\r\n\r\nconsole.log(`Token accounts created! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":15,"column":1,"offset":698},"end":{"line":70,"column":4,"offset":2476}},"data":{"highlightId":"code-0"}},{"type":"paragraph","children":[{"type":"text","value":"Như đã được đề cập, nếu chúng ta muốn thêm phần mở rộng này vào một account ","position":{"start":{"line":72,"column":1,"offset":2480},"end":{"line":72,"column":77,"offset":2556}}},{"type":"inlineCode","value":"Associated Token","position":{"start":{"line":72,"column":77,"offset":2556},"end":{"line":72,"column":95,"offset":2574}}},{"type":"text","value":", chúng ta chỉ cần khởi tạo nó với chương trình Token2022.","position":{"start":{"line":72,"column":95,"offset":2574},"end":{"line":72,"column":153,"offset":2632}}}],"position":{"start":{"line":72,"column":1,"offset":2480},"end":{"line":72,"column":153,"offset":2632}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":72,"column":153,"offset":2632}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Immutable Owner Extension\r\n\r\nPhần mở rộng `ImmutableOwner` là một `Token` account extension ngăn chặn bất kỳ thay đổi nào trong quyền sở hữu của `Token` account. Điều này bảo vệ account chống lại truy cập trái phép và các nỗ lực transfer.\r\n\r\n> Tất cả ATA của `Token` Extensions Program đều có immutable owner được bật theo mặc định\r\n\r\n<ArticleSection name=\"Khởi tạo Token Account\" id=\"initializing-the-token-account\" level=\"h2\" />\r\n\r\nĐể khởi tạo extension `ImmutableOwner` trên `Token` account, chúng ta sẽ cần hàm `initializeImmutableOwner()`.\r\n\r\nĐây là cách tạo mint với phần mở rộng Immutable Owner:\r\n\r\n```ts\r\nimport {\r\n    Keypair,\r\n    SystemProgram,\r\n    Transaction,\r\n    sendAndConfirmTransaction,\r\n} from '@solana/web3.js';\r\nimport {\r\n    createInitializeAccountInstruction,\r\n    createInitializeImmutableOwnerInstruction,\r\n    getAccountLen,\r\n    ExtensionType,\r\n    TOKEN_2022_PROGRAM_ID,\r\n} from '@solana/spl-token';\r\n\r\nconst tokenAccount = Keypair.generate();\r\n\r\n// Calculate the size needed for a Token account with Transfer Fee extension\r\nconst accountLen = getAccountLen([ExtensionType.ImmutableOwner]);\r\n\r\n// Calculate minimum lamports required for rent exemption\r\nconst lamports = await connection.getMinimumBalanceForRentExemption(accountLen);\r\n\r\n// Create the account with the correct size and owner\r\nconst createAccountInstruction = SystemProgram.createAccount({\r\n    fromPubkey: keypair.publicKey,\r\n    newAccountPubkey: tokenAccount.publicKey,\r\n    space: accountLen,\r\n    lamports,\r\n    programId: TOKEN_2022_PROGRAM_ID,\r\n});\r\n\r\n// Initialize the Immutable Owner extension\r\nconst initializeImmutableOwnerInstruction = createInitializeImmutableOwnerInstruction(\r\n    tokenAccount.publicKey,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\n// Initialize the Token account itself\r\nconst initializeAccountInstruction = createInitializeAccountInstruction(\r\n    tokenAccount.publicKey,\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAccountInstruction,\r\n    initializeImmutableOwnerInstruction,\r\n    initializeAccountInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair, tokenAccount], {skipPreflight: false});\r\n\r\nconsole.log(`Token accounts created! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\nNhư đã được đề cập, nếu chúng ta muốn thêm phần mở rộng này vào một account `Associated Token`, chúng ta chỉ cần khởi tạo nó với chương trình Token2022.","highlightedCode":{"code-0":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"import"}]},{"type":"element","tagName":"span","properties":