\n} from '@solana/web3.js';\r\nimport {\r\n    createInitializeAccountInstruction,\r\n    createInitializeImmutableOwnerInstruction,\r\n    getAccountLen,\r\n    ExtensionType,\r\n    TOKEN_2022_PROGRAM_ID,\r\n} from '@solana/spl-token';\r\n\r\nconst tokenAccount = Keypair.generate();\r\n\r\n// Calculate the size needed for a Token account with Immutable Owner extension\r\nconst accountLen = getAccountLen([ExtensionType.ImmutableOwner]);\r\n\r\n// Calculate minimum lamports required for rent exemption\r\nconst lamports = await connection.getMinimumBalanceForRentExemption(accountLen);\r\n\r\n// Create the account with the correct size and owner\r\nconst createAccountInstruction = SystemProgram.createAccount({\r\n    fromPubkey: keypair.publicKey,\r\n    newAccountPubkey: tokenAccount.publicKey,\r\n    space: accountLen,\r\n    lamports,\r\n    programId: TOKEN_2022_PROGRAM_ID,\r\n});\r\n\r\n// Initialize the Immutable Owner extension\r\nconst initializeImmutableOwnerInstruction = createInitializeImmutableOwnerInstruction(\r\n    tokenAccount.publicKey,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\n// Initialize the Token account itself\r\nconst initializeAccountInstruction = createInitializeAccountInstruction(\r\n    tokenAccount.publicKey,\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAccountInstruction,\r\n    initializeImmutableOwnerInstruction,\r\n    initializeAccountInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair, tokenAccount], {skipPreflight: false});\r\n\r\nconsole.log(`Token accounts created! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":15,"column":1,"offset":716},"end":{"line":70,"column":4,"offset":2497}},"data":{"highlightId":"code-0"}},{"type":"paragraph","children":[{"type":"text","value":"As pointed out, if we want to add this extension to an ","position":{"start":{"line":72,"column":1,"offset":2501},"end":{"line":72,"column":56,"offset":2556}}},{"type":"inlineCode","value":"Associated Token","position":{"start":{"line":72,"column":56,"offset":2556},"end":{"line":72,"column":74,"offset":2574}}},{"type":"text","value":" account, we just initialize it with the Token2022 program.","position":{"start":{"line":72,"column":74,"offset":2574},"end":{"line":72,"column":133,"offset":2633}}}],"position":{"start":{"line":72,"column":1,"offset":2501},"end":{"line":72,"column":133,"offset":2633}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":72,"column":133,"offset":2633}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# The Immutable Owner Extension\r\n\r\nThe `ImmutableOwner` extension is a `Token` account extension that prevents any changes in ownership of the `Token` account. This secures accounts against unauthorized access and transfer attempts.\r\n\r\n> All `Token` Extensions Program ATAs have immutable owners enabled by default\r\n\r\n<ArticleSection name=\"Initializing the Token Account\" id=\"initializing-the-token-account\" level=\"h2\" />\r\n\r\nTo initialize the `ImmutableOwner` extension on a `Token` account we're going to need the `initializeImmutableOwner()` function. \r\n\r\nHere's how to create a token with the Immutable Owner extension:\r\n\r\n```ts\r\nimport {\r\n    Keypair,\r\n    SystemProgram,\r\n    Transaction,\r\n    sendAndConfirmTransaction,\r\n} from '@solana/web3.js';\r\nimport {\r\n    createInitializeAccountInstruction,\r\n    createInitializeImmutableOwnerInstruction,\r\n    getAccountLen,\r\n    ExtensionType,\r\n    TOKEN_2022_PROGRAM_ID,\r\n} from '@solana/spl-token';\r\n\r\nconst tokenAccount = Keypair.generate();\r\n\r\n// Calculate the size needed for a Token account with Immutable Owner extension\r\nconst accountLen = getAccountLen([ExtensionType.ImmutableOwner]);\r\n\r\n// Calculate minimum lamports required for rent exemption\r\nconst lamports = await connection.getMinimumBalanceForRentExemption(accountLen);\r\n\r\n// Create the account with the correct size and owner\r\nconst createAccountInstruction = SystemProgram.createAccount({\r\n    fromPubkey: keypair.publicKey,\r\n    newAccountPubkey: tokenAccount.publicKey,\r\n    space: accountLen,\r\n    lamports,\r\n    programId: TOKEN_2022_PROGRAM_ID,\r\n});\r\n\r\n// Initialize the Immutable Owner extension\r\nconst initializeImmutableOwnerInstruction = createInitializeImmutableOwnerInstruction(\r\n    tokenAccount.publicKey,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\n// Initialize the Token account itself\r\nconst initializeAccountInstruction = createInitializeAccountInstruction(\r\n    tokenAccount.publicKey,\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAccountInstruction,\r\n    initializeImmutableOwnerInstruction,\r\n    initializeAccountInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair, tokenAccount], {skipPreflight: false});\r\n\r\nconsole.log(`Token accounts created! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\nAs pointed out, if we want to add this extension to an `Associated Token` account, we just initialize it with the Token2022 program.","highlightedCode":{"code-0":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"import"}]},{"type":"element","tagName":"span","properties":{