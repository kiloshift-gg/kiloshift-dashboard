rt":{"line":9,"column":52,"offset":459},"end":{"line":9,"column":87,"offset":494}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":9,"column":88,"offset":495},"end":{"line":9,"column":98,"offset":505}}}],"children":[],"position":{"start":{"line":9,"column":1,"offset":408},"end":{"line":9,"column":101,"offset":508}}},{"type":"paragraph","children":[{"type":"text","value":"Untuk menginisialisasi ekstensi ","position":{"start":{"line":11,"column":1,"offset":512},"end":{"line":11,"column":33,"offset":544}}},{"type":"inlineCode","value":"ImmutableOwner","position":{"start":{"line":11,"column":33,"offset":544},"end":{"line":11,"column":49,"offset":560}}},{"type":"text","value":" pada akun ","position":{"start":{"line":11,"column":49,"offset":560},"end":{"line":11,"column":60,"offset":571}}},{"type":"inlineCode","value":"Token","position":{"start":{"line":11,"column":60,"offset":571},"end":{"line":11,"column":67,"offset":578}}},{"type":"text","value":" kita akan membutuhkan fungsi ","position":{"start":{"line":11,"column":67,"offset":578},"end":{"line":11,"column":97,"offset":608}}},{"type":"inlineCode","value":"initializeImmutableOwner()","position":{"start":{"line":11,"column":97,"offset":608},"end":{"line":11,"column":125,"offset":636}}},{"type":"text","value":".","position":{"start":{"line":11,"column":125,"offset":636},"end":{"line":11,"column":126,"offset":637}}}],"position":{"start":{"line":11,"column":1,"offset":512},"end":{"line":11,"column":126,"offset":637}}},{"type":"paragraph","children":[{"type":"text","value":"Berikut cara membuat token dengan ekstensi Pemilik Tidak Dapat Diubah:","position":{"start":{"line":13,"column":1,"offset":641},"end":{"line":13,"column":71,"offset":711}}}],"position":{"start":{"line":13,"column":1,"offset":641},"end":{"line":13,"column":71,"offset":711}}},{"type":"code","lang":"ts","meta":null,"value":"import {\r\n    Keypair,\r\n    SystemProgram,\r\n    Transaction,\r\n    sendAndConfirmTransaction,\r\n} from '@solana/web3.js';\r\nimport {\r\n    createInitializeAccountInstruction,\r\n    createInitializeImmutableOwnerInstruction,\r\n    getAccountLen,\r\n    ExtensionType,\r\n    TOKEN_2022_PROGRAM_ID,\r\n} from '@solana/spl-token';\r\n\r\nconst tokenAccount = Keypair.generate();\r\n\r\n// Calculate the size needed for a Token account with Immutable Owner extension\r\nconst accountLen = getAccountLen([ExtensionType.ImmutableOwner]);\r\n\r\n// Calculate minimum lamports required for rent exemption\r\nconst lamports = await connection.getMinimumBalanceForRentExemption(accountLen);\r\n\r\n// Create the account with the correct size and owner\r\nconst createAccountInstruction = SystemProgram.createAccount({\r\n    fromPubkey: keypair.publicKey,\r\n    newAccountPubkey: tokenAccount.publicKey,\r\n    space: accountLen,\r\n    lamports,\r\n    programId: TOKEN_2022_PROGRAM_ID,\r\n});\r\n\r\n// Initialize the Immutable Owner extension\r\nconst initializeImmutableOwnerInstruction = createInitializeImmutableOwnerInstruction(\r\n    tokenAccount.publicKey,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\n// Initialize the Token account itself\r\nconst initializeAccountInstruction = createInitializeAccountInstruction(\r\n    tokenAccount.publicKey,\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAccountInstruction,\r\n    initializeImmutableOwnerInstruction,\r\n    initializeAccountInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair, tokenAccount], {skipPreflight: false});\r\n\r\nconsole.log(`Token accounts created! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":15,"column":1,"offset":715},"end":{"line":70,"column":4,"offset":2496}},"data":{"highlightId":"code-0"}},{"type":"paragraph","children":[{"type":"text","value":"Seperti yang ditunjukkan, jika kita ingin menambahkan ekstensi ini ke akun ","position":{"start":{"line":72,"column":1,"offset":2500},"end":{"line":72,"column":76,"offset":2575}}},{"type":"inlineCode","value":"Associated Token","position":{"start":{"line":72,"column":76,"offset":2575},"end":{"line":72,"column":94,"offset":2593}}},{"type":"text","value":", kita cukup menginisialisasinya dengan program Token2022.","position":{"start":{"line":72,"column":94,"offset":2593},"end":{"line":72,"column":152,"offset":2651}}}],"position":{"start":{"line":72,"column":1,"offset":2500},"end":{"line":72,"column":152,"offset":2651}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":72,"column":152,"offset":2651}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Ekstensi Pemilik Tidak Dapat Diubah\r\n\r\nEkstensi `ImmutableOwner` adalah ekstensi akun `Token` yang mencegah perubahan kepemilikan akun `Token`. Ini mengamankan akun dari akses tidak sah dan upaya transfer.\r\n\r\n> Semua ATA Program Ekstensi `Token` memiliki pemilik tidak dapat diubah yang diaktifkan secara default\r\n\r\n<ArticleSection name=\"Menginisialisasi Akun Token\" id=\"initializing-the-token-account\" level=\"h2\" />\r\n\r\nUntuk menginisialisasi ekstensi `ImmutableOwner` pada akun `Token` kita akan membutuhkan fungsi `initializeImmutableOwner()`.\r\n\r\nBerikut cara membuat token dengan ekstensi Pemilik Tidak Dapat Diubah:\r\n\r\n```ts\r\nimport {\r\n    Keypair,\r\n    SystemProgram,\r\n    Transaction,\r\n    sendAndConfirmTransaction,\r\n} from '@solana/web3.js';\r\nimport {\r\n    createInitializeAccountInstruction,\r\n    createInitializeImmutableOwnerInstruction,\r\n    getAccountLen,\r\n    ExtensionType,\r\n    TOKEN_2022_PROGRAM_ID,\r\n} from '@solana/spl-token';\r\n\r\nconst tokenAccount = Keypair.generate();\r\n\r\n// Calculate the size needed for a Token account with Immutable Owner extension\r\nconst accountLen = getAccountLen([ExtensionType.ImmutableOwner]);\r\n\r\n// Calculate minimum lamports required for rent exemption\r\nconst lamports = await connection.getMinimumBalanceForRentExemption(accountLen);\r\n\r\n// Create the account with the correct size and owner\r\nconst createAccountInstruction = SystemProgram.createAccount({\r\n    fromPubkey: keypair.publicKey,\r\n    newAccountPubkey: tokenAccount.publicKey,\r\n    space: accountLen,\r\n    lamports,\r\n    programId: TOKEN_2022_PROGRAM_ID,\r\n});\r\n\r\n// Initialize the Immutable Owner extension\r\nconst initializeImmutableOwnerInstruction = createInitializeImmutableOwnerInstruction(\r\n    tokenAccount.publicKey,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\n// Initialize the Token account itself\r\nconst initializeAccountInstruction = createInitializeAccountInstruction(\r\n    tokenAccount.publicKey,\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAccountInstruction,\r\n    initializeImmutableOwnerInstruction,\r\n    initializeAccountInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair, tokenAccount], {skipPreflight: false});\r\n\r\nconsole.log(`Token accounts created! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\nSeperti yang ditunjukkan, jika kita ingin menambahkan ekstensi ini ke akun `Associated Token`, kita cukup menginisialisasinya dengan program Token2022.","highlightedCode":{"code-0":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"import"}]},{"type":