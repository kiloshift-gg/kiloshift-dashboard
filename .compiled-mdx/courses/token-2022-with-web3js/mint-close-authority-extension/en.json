ffset":499},"end":{"line":9,"column":102,"offset":600}}},{"type":"paragraph","children":[{"type":"text","value":"To initialize the ","position":{"start":{"line":11,"column":1,"offset":604},"end":{"line":11,"column":19,"offset":622}}},{"type":"inlineCode","value":"MintCloseAuthority","position":{"start":{"line":11,"column":19,"offset":622},"end":{"line":11,"column":39,"offset":642}}},{"type":"text","value":" extension on a ","position":{"start":{"line":11,"column":39,"offset":642},"end":{"line":11,"column":55,"offset":658}}},{"type":"inlineCode","value":"Mint","position":{"start":{"line":11,"column":55,"offset":658},"end":{"line":11,"column":61,"offset":664}}},{"type":"text","value":" account we're going to need the ","position":{"start":{"line":11,"column":61,"offset":664},"end":{"line":11,"column":94,"offset":697}}},{"type":"inlineCode","value":"initializeMintCloseAuthority()","position":{"start":{"line":11,"column":94,"offset":697},"end":{"line":11,"column":126,"offset":729}}},{"type":"text","value":" function.","position":{"start":{"line":11,"column":126,"offset":729},"end":{"line":11,"column":136,"offset":739}}}],"position":{"start":{"line":11,"column":1,"offset":604},"end":{"line":11,"column":137,"offset":740}}},{"type":"paragraph","children":[{"type":"text","value":"Here's how to create a mint with the Mint Close extension:","position":{"start":{"line":13,"column":1,"offset":744},"end":{"line":13,"column":59,"offset":802}}}],"position":{"start":{"line":13,"column":1,"offset":744},"end":{"line":13,"column":59,"offset":802}}},{"type":"code","lang":"ts","meta":null,"value":"import {\r\n    Keypair,\r\n    SystemProgram,\r\n    Transaction,\r\n    sendAndConfirmTransaction,\r\n} from '@solana/web3.js';\r\nimport {\r\n    createInitializeMintInstruction,\r\n    createInitializeMintCloseAuthorityInstruction,\r\n    getMintLen,\r\n    ExtensionType,\r\n    TOKEN_2022_PROGRAM_ID,\r\n} from '@solana/spl-token';\r\n\r\nconst mint = Keypair.generate();\r\n\r\n// Calculate the size needed for a Mint account with Mint Close Authority extension\r\nconst mintLen = getMintLen([ExtensionType.MintCloseAuthority]);\r\n\r\n// Calculate minimum lamports required for rent exemption\r\nconst lamports = await connection.getMinimumBalanceForRentExemption(mintLen);\r\n\r\n// Create the account with the correct size and owner\r\nconst createAccountInstruction = SystemProgram.createAccount({\r\n    fromPubkey: keypair.publicKey,\r\n    newAccountPubkey: mint.publicKey,\r\n    space: mintLen,\r\n    lamports,\r\n    programId: TOKEN_2022_PROGRAM_ID,\r\n});\r\n\r\n// Initialize the Mint Close Authority extension\r\nconst initializeMintCloseAuthority = createInitializeMintCloseAuthorityInstruction(\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\n// Initialize the mint itself\r\nconst initializeMintInstruction = createInitializeMintInstruction(\r\n    mint.publicKey,\r\n    6,\r\n    keypair.publicKey,\r\n    null,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\n// Combine all instructions in the correct order\r\nconst transaction = new Transaction().add(\r\n    createAccountInstruction,\r\n    initializeMintCloseAuthority,\r\n    initializeMintInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair, mint]);\r\n\r\nconsole.log(`Mint created! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":15,"column":1,"offset":806},"end":{"line":73,"column":4,"offset":2556}},"data":{"highlightId":"code-0"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Closing the Mint Account","position":{"start":{"line":75,"column":17,"offset":2576},"end":{"line":75,"column":48,"offset":2607}}},{"type":"mdxJsxAttribute","name":"id","value":"closing-the-mint-account","position":{"start":{"line":75,"column":49,"offset":2608},"end":{"line":75,"column":78,"offset":2637}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":75,"column":79,"offset":2638},"end":{"line":75,"column":89,"offset":2648}}}],"children":[],"position":{"start":{"line":75,"column":1,"offset":2560},"end":{"line":75,"column":92,"offset":2651}}},{"type":"paragraph","children":[{"type":"text","value":"If a ","position":{"start":{"line":77,"column":1,"offset":2655},"end":{"line":77,"column":6,"offset":2660}}},{"type":"inlineCode","value":"Mint","position":{"start":{"line":77,"column":6,"offset":2660},"end":{"line":77,"column":12,"offset":2666}}},{"type":"text","value":" account has a supply of zero, the ","position":{"start":{"line":77,"column":12,"offset":2666},"end":{"line":77,"column":47,"offset":2701}}},{"type":"inlineCode","value":"CloseMint Authority","position":{"start":{"line":77,"column":47,"offset":2701},"end":{"line":77,"column":68,"offset":2722}}},{"type":"text","value":" can reclaim the rent on that account by using the ","position":{"start":{"line":77,"column":68,"offset":2722},"end":{"line":77,"column":119,"offset":2773}}},{"type":"inlineCode","value":"closeAccount","position":{"start":{"line":77,"column":119,"offset":2773},"end":{"line":77,"column":133,"offset":2787}}},{"type":"text","value":" instruction like so:","position":{"start":{"line":77,"column":133,"offset":2787},"end":{"line":77,"column":154,"offset":2808}}}],"position":{"start":{"line":77,"column":1,"offset":2655},"end":{"line":77,"column":154,"offset":2808}}},{"type":"code","lang":"ts","meta":null,"value":"const closeMintInstruction = createCloseAccountInstruction(\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n    keypair.publicKey,\r\n    [],\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\nconst transaction = new Transaction().add(closeMintInstruction);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair], {skipPreflight: false});\r\n\r\nconsole.log(`Mint closed! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":79,"column":1,"offset":2812},"end":{"line":93,"column":4,"offset":3290}},"data":{"highlightId":"code-1"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":93,"column":4,"offset":3290}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# The Mint Close Authority Extension\r\n\r\nThe `MintCloseAuthority` extension is a `Mint` extension that allows the authority to close and retrieve the rent from a `Mint` account that has a current supply of 0.\r\n\r\nThis extension is useful for cleaning up unused mints and reclaiming the SOL that was used to pay for the account's rent exemption. The mint can only be closed when no tokens are in circulation.\r\n\r\n<ArticleSection name=\"Initializing the Mint Account\" id=\"initializing-the-mint-account\" level=\"h2\" />\r\n\r\nTo initialize the `MintCloseAuthority` extension on a `Mint` account we're going to need the `initializeMintCloseAuthority()` function. \r\n\r\nHere's how to create a mint with the Mint Close extension:\r\n\r\n```ts\r\nimport {\r\n    Keypair,\r\n    SystemProgram,\r\n    Transaction,\r\n    sendAndConfirmTransaction,\r\n} from '@solana/web3.js';\r\nimport {\r\n    createInitializeMintInstruction,\r\n    createInitializeMintCloseAuthorityInstruction,\r\n    getMintLen,\r\n    ExtensionType,\r\n    TOKEN_2022_PROGRAM_ID,\r\n} from '@solana/spl-token';\r\n\r\nconst mint = Keypair.generate();\r\n\r\n// Calculate the size needed for a Mint account with Mint Close Authority extension\r\nconst mintLen = getMintLen([ExtensionType.MintCloseAuthority]);\r\n\r\n// Calculate minimum lamports required for rent exemption\r\nconst lamports = await connection.getMinimumBalanceForRentExemption(mintLen);\r\n\r\n// Create the account with the correct size and owner\r\nconst createAccountInstruction = SystemProgram.createAccount({\r\n    fromPubkey: keypair.publicKey,\r\n    newAccountPubkey: mint.publicKey,\r\n    space: mintLen,\r\n    lamports,\r\n    programId: TOKEN_2022_PROGRAM_ID,\r\n});\r\n\r\n// Initialize the Mint Close Authority extension\r\nconst initializeMintCloseAuthority = createInitializeMintCloseAuthorityInstruction(\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\n// Initialize the mint itself\r\nconst initializeMintInstruction = createInitializeMintInstruction(\r\n    mint.publicKey,\r\n    6,\r\n    keypair.publicKey,\r\n    null,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\n// Combine all instructions in the correct order\r\nconst transaction = new Transaction().add(\r\n    createAccountInstruction,\r\n    initializeMintCloseAuthority,\r\n    initializeMintInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair, mint]);\r\n\r\nconsole.log(`Mint created! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\n<ArticleSection name=\"Closing the Mint Account\" id=\"closing-the-mint-account\" level=\"h2\" />\r\n\r\nIf a `Mint` account has a supply of zero, the `CloseMint Authority` can reclaim the rent on that account by using the `closeAccount` instruction like so:\r\n\r\n```ts\r\nconst closeMintInstruction = createCloseAccountInstruction(\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n    keypair.publicKey,\r\n    [],\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\nconst transaction = new Transaction().add(closeMintInstruction);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair], {skipPreflight: false});\r\n\r\nconsole.log(`Mint closed! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```","highlightedCode":{"code-0":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"t