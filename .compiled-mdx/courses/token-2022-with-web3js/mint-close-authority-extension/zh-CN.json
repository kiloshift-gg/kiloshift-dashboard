y,\r\n    space: mintLen,\r\n    lamports,\r\n    programId: TOKEN_2022_PROGRAM_ID,\r\n});\r\n\r\n// Initialize the Mint Close Authority extension\r\nconst initializeMintCloseAuthority = createInitializeMintCloseAuthorityInstruction(\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\n// Initialize the mint itself\r\nconst initializeMintInstruction = createInitializeMintInstruction(\r\n    mint.publicKey,\r\n    6,\r\n    keypair.publicKey,\r\n    null,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\n// Combine all instructions in the correct order\r\nconst transaction = new Transaction().add(\r\n    createAccountInstruction,\r\n    initializeMintCloseAuthority,\r\n    initializeMintInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair, mint]);\r\n\r\nconsole.log(`Mint created! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":15,"column":1,"offset":463},"end":{"line":73,"column":4,"offset":2205}},"data":{"highlightId":"code-0"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"关闭铸币账户","position":{"start":{"line":75,"column":17,"offset":2225},"end":{"line":75,"column":30,"offset":2238}}},{"type":"mdxJsxAttribute","name":"id","value":"closing-the-mint-account","position":{"start":{"line":75,"column":31,"offset":2239},"end":{"line":75,"column":60,"offset":2268}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":75,"column":61,"offset":2269},"end":{"line":75,"column":71,"offset":2279}}}],"children":[],"position":{"start":{"line":75,"column":1,"offset":2209},"end":{"line":75,"column":74,"offset":2282}}},{"type":"paragraph","children":[{"type":"text","value":"如果 ","position":{"start":{"line":77,"column":1,"offset":2286},"end":{"line":77,"column":4,"offset":2289}}},{"type":"inlineCode","value":"Mint","position":{"start":{"line":77,"column":4,"offset":2289},"end":{"line":77,"column":10,"offset":2295}}},{"type":"text","value":" 账户的供应量为零，","position":{"start":{"line":77,"column":10,"offset":2295},"end":{"line":77,"column":20,"offset":2305}}},{"type":"inlineCode","value":"CloseMint Authority","position":{"start":{"line":77,"column":20,"offset":2305},"end":{"line":77,"column":41,"offset":2326}}},{"type":"text","value":" 可以通过使用 ","position":{"start":{"line":77,"column":41,"offset":2326},"end":{"line":77,"column":49,"offset":2334}}},{"type":"inlineCode","value":"closeAccount","position":{"start":{"line":77,"column":49,"offset":2334},"end":{"line":77,"column":63,"offset":2348}}},{"type":"text","value":" 指令来回收该账户的租金，如下所示：","position":{"start":{"line":77,"column":63,"offset":2348},"end":{"line":77,"column":81,"offset":2366}}}],"position":{"start":{"line":77,"column":1,"offset":2286},"end":{"line":77,"column":81,"offset":2366}}},{"type":"code","lang":"ts","meta":null,"value":"const closeMintInstruction = createCloseAccountInstruction(\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n    keypair.publicKey,\r\n    [],\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\nconst transaction = new Transaction().add(closeMintInstruction);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair], {skipPreflight: false});\r\n\r\nconsole.log(`Mint closed! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":79,"column":1,"offset":2370},"end":{"line":93,"column":4,"offset":2848}},"data":{"highlightId":"code-1"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":93,"column":4,"offset":2848}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Mint Close Authority 扩展\r\n\r\n`MintCloseAuthority` 扩展是一个 `Mint` 扩展，允许权限方关闭并从当前供应量为 0 的 `Mint` 账户中取回租金。\r\n\r\n此扩展对于清理未使用的铸币账户并回收用于支付账户租金豁免的 SOL 非常有用。只有在没有代币流通时，铸币账户才能被关闭。\r\n\r\n<ArticleSection name=\"初始化铸币账户\" id=\"initializing-the-mint-account\" level=\"h2\" />\r\n\r\n要在 `Mint` 账户上初始化 `MintCloseAuthority` 扩展，我们需要使用 `initializeMintCloseAuthority()` 函数。\r\n\r\n以下是如何创建带有 Mint Close 扩展的铸币账户：\r\n\r\n```ts\r\nimport {\r\n    Keypair,\r\n    SystemProgram,\r\n    Transaction,\r\n    sendAndConfirmTransaction,\r\n} from '@solana/web3.js';\r\nimport {\r\n    createInitializeMintInstruction,\r\n    createInitializeMintCloseAuthorityInstruction,\r\n    getMintLen,\r\n    ExtensionType,\r\n    TOKEN_2022_PROGRAM_ID,\r\n} from '@solana/spl-token';\r\n\r\nconst mint = Keypair.generate();\r\n\r\n// Calculate the size needed for a Mint account with Transfer Fee extension\r\nconst mintLen = getMintLen([ExtensionType.MintCloseAuthority]);\r\n\r\n// Calculate minimum lamports required for rent exemption\r\nconst lamports = await connection.getMinimumBalanceForRentExemption(mintLen);\r\n\r\n// Create the account with the correct size and owner\r\nconst createAccountInstruction = SystemProgram.createAccount({\r\n    fromPubkey: keypair.publicKey,\r\n    newAccountPubkey: mint.publicKey,\r\n    space: mintLen,\r\n    lamports,\r\n    programId: TOKEN_2022_PROGRAM_ID,\r\n});\r\n\r\n// Initialize the Mint Close Authority extension\r\nconst initializeMintCloseAuthority = createInitializeMintCloseAuthorityInstruction(\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\n// Initialize the mint itself\r\nconst initializeMintInstruction = createInitializeMintInstruction(\r\n    mint.publicKey,\r\n    6,\r\n    keypair.publicKey,\r\n    null,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\n// Combine all instructions in the correct order\r\nconst transaction = new Transaction().add(\r\n    createAccountInstruction,\r\n    initializeMintCloseAuthority,\r\n    initializeMintInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair, mint]);\r\n\r\nconsole.log(`Mint created! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\n<ArticleSection name=\"关闭铸币账户\" id=\"closing-the-mint-account\" level=\"h2\" />\r\n\r\n如果 `Mint` 账户的供应量为零，`CloseMint Authority` 可以通过使用 `closeAccount` 指令来回收该账户的租金，如下所示：\r\n\r\n```ts\r\nconst closeMintInstruction = createCloseAccountInstruction(\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n    keypair.publicKey,\r\n    [],\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\nconst transaction = new Transaction().add(closeMintInstruction);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair], {skipPreflight: false});\r\n\r\nconsole.log(`Mint closed! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```","highlightedCode":{"code-0":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"import"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" {"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"    Keypair,"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"    SystemProgram,"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6