ntLen,\r\n    lamports,\r\n    programId: TOKEN_2022_PROGRAM_ID,\r\n});\r\n\r\n// Initialize the Mint Close Authority extension\r\nconst initializeMintCloseAuthority = createInitializeMintCloseAuthorityInstruction(\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\n// Initialize the mint itself\r\nconst initializeMintInstruction = createInitializeMintInstruction(\r\n    mint.publicKey,\r\n    6,\r\n    keypair.publicKey,\r\n    null,\r\n    TOKEN_2022_PROGRAM_ID,\r\n);\r\n\r\n// Combine all instructions in the correct order\r\nconst transaction = new Transaction().add(\r\n    createAccountInstruction,\r\n    initializeMintCloseAuthority,\r\n    initializeMintInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair, mint]);\r\n\r\nconsole.log(`Mint created! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":15,"column":1,"offset":436},"end":{"line":73,"column":4,"offset":2186}},"data":{"highlightId":"code-0"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"關閉鑄幣帳戶","position":{"start":{"line":75,"column":17,"offset":2206},"end":{"line":75,"column":30,"offset":2219}}},{"type":"mdxJsxAttribute","name":"id","value":"closing-the-mint-account","position":{"start":{"line":75,"column":31,"offset":2220},"end":{"line":75,"column":60,"offset":2249}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":75,"column":61,"offset":2250},"end":{"line":75,"column":71,"offset":2260}}}],"children":[],"position":{"start":{"line":75,"column":1,"offset":2190},"end":{"line":75,"column":74,"offset":2263}}},{"type":"paragraph","children":[{"type":"text","value":"如果 ","position":{"start":{"line":77,"column":1,"offset":2267},"end":{"line":77,"column":4,"offset":2270}}},{"type":"inlineCode","value":"Mint","position":{"start":{"line":77,"column":