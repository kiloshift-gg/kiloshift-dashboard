ffset":499},"end":{"line":9,"column":102,"offset":600}}},{"type":"paragraph","children":[{"type":"text","value":"To initialize the ","position":{"start":{"line":11,"column":1,"offset":604},"end":{"line":11,"column":19,"offset":622}}},{"type":"inlineCode","value":"MintCloseAuthority","position":{"start":{"line":11,"column":19,"offset":622},"end":{"line":11,"column":39,"offset":642}}},{"type":"text","value":" extension on a ","position":{"start":{"line":11,"column":39,"offset":642},"end":{"line":11,"column":55,"offset":658}}},{"type":"inlineCode","value":"Mint","position":{"start":{"line":11,"column":55,"offset":658},"end":{"line":11,"column":61,"offset":664}}},{"type":"text","value":" account we can simply use the macro that ","position":{"start":{"line":11,"column":61,"offset":664},"end":{"line":11,"column":103,"offset":706}}},{"type":"inlineCode","value":"Anchor","position":{"start":{"line":11,"column":103,"offset":706},"end":{"line":11,"column":111,"offset":714}}},{"type":"text","value":" created for us.","position":{"start":{"line":11,"column":111,"offset":714},"end":{"line":11,"column":127,"offset":730}}}],"position":{"start":{"line":11,"column":1,"offset":604},"end":{"line":11,"column":127,"offset":730}}},{"type":"paragraph","children":[{"type":"text","value":"Here's how to create a mint with the Mint Close extension:","position":{"start":{"line":13,"column":1,"offset":734},"end":{"line":13,"column":59,"offset":792}}}],"position":{"start":{"line":13,"column":1,"offset":734},"end":{"line":13,"column":59,"offset":792}}},{"type":"code","lang":"rust","meta":null,"value":"#[derive(Accounts)]\r\npub struct CreateMint<'info> {\r\n    #[account(mut)]\r\n    pub signer: Signer<'info>,\r\n    #[account(\r\n        init,\r\n        payer = signer,\r\n        mint::decimals = 6,\r\n        mint::authority = signer.key(),\r\n        mint::token_program = token_program,\r\n        extensions::close_authority::authority = signer,\r\n    )]\r\n    pub mint: InterfaceAccount<'info, Mint>,\r\n    pub system_program: Program<'info, System>,\r\n    pub token_program: Interface<'info, TokenInterface>,\r\n}","position":{"start":{"line":15,"column":1,"offset":796},"end":{"line":32,"column":4,"offset":1308}},"data":{"highlightId":"code-0"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Closing the Mint Account","position":{"start":{"line":34,"column":17,"offset":1328},"end":{"line":34,"column":48,"offset":1359}}},{"type":"mdxJsxAttribute","name":"id","value":"closing-the-mint-account","position":{"start":{"line":34,"column":49,"offset":1360},"end":{"line":34,"column":78,"offset":1389}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":34,"column":79,"offset":1390},"end":{"line":34,"column":89,"offset":1400}}}],"children":[],"position":{"start":{"line":34,"column":1,"offset":1312},"end":{"line":34,"column":92,"offset":1403}}},{"type":"paragraph","children":[{"type":"text","value":"If a ","position":{"start":{"line":36,"column":1,"offset":1407},"end":{"line":36,"column":6,"offset":1412}}},{"type":"inlineCode","value":"Mint","position":{"start":{"line":36,"column":6,"offset":1412},"end":{"line":36,"column":12,"offset":1418}}},{"type":"text","value":" account has a supply of zero, the ","position":{"start":{"line":36,"column":12,"offset":1418},"end":{"line":36,"column":47,"offset":1453}}},{"type":"inlineCode","value":"CloseMint Authority","position":{"start":{"line":36,"column":47,"offset":1453},"end":{"line":36,"column":68,"offset":1474}}},{"type":"text","value":" can reclaim the rent on that account by using the ","position":{"start":{"line":36,"column":68,"offset":1474},"end":{"line":36,"column":119,"offset":1525}}},{"type":"inlineCode","value":"close_account()","position":{"start":{"line":36,"column":119,"offset":1525},"end":{"line":36,"column":136,"offset":1542}}},{"type":"text","value":" instruction like so:","position":{"start":{"line":36,"column":136,"offset":1542},"end":{"line":36,"column":157,"offset":1563}}}],"position":{"start":{"line":36,"column":1,"offset":1407},"end":{"line":36,"column":157,"offset":1563}}},{"type":"code","lang":"rust","meta":null,"value":"use anchor_lang::prelude::*;\r\nuse anchor_lang::system_program::{create_account, CreateAccount};\r\nuse anchor_spl::{\r\n    token_2022::{close_account, CloseAccount},\r\n    token_interface::{\r\n        spl_token_2022::{\r\n            extension::{\r\n                mint_close_authority::MintCloseAuthority\r\n            },\r\n        },\r\n        Mint, Token2022,\r\n    },\r\n};\r\n\r\n#[derive(Accounts)]\r\npub struct Close<'info> {\r\n    #[account(mut)]\r\n    pub authority: Signer<'info>,\r\n\r\n    #[account(\r\n        mut,\r\n        extensions::close_authority::authority = authority,\r\n    )]\r\n    pub mint_account: InterfaceAccount<'info, Mint>,\r\n    pub token_program: Program<'info, Token2022>,\r\n}\r\n\r\npub fn close(ctx: Context<Close>) -> Result<()> {\r\n    // cpi to token extensions programs to close mint account\r\n    // alternatively, this can also be done in the client\r\n    close_account(CpiContext::new(\r\n        ctx.accounts.token_program.to_account_info(),\r\n        CloseAccount {\r\n            account: ctx.accounts.mint_account.to_account_info(),\r\n            destination: ctx.accounts.authority.to_account_info(),\r\n            authority: ctx.accounts.authority.to_account_info(),\r\n        },\r\n    ))?;\r\n    Ok(())\r\n}","position":{"start":{"line":38,"column":1,"offset":1567},"end":{"line":79,"column":4,"offset":2787}},"data":{"highlightId":"code-1"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":79,"column":4,"offset":2787}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# The Mint Close Authority Extension\r\n\r\nThe `MintCloseAuthority` extension is a `Mint` extension that allows the authority to close and retrieve the rent from a `Mint` account that has a current supply of 0.\r\n\r\nThis extension is useful for cleaning up unused mints and reclaiming the SOL that was used to pay for the account's rent exemption. The mint can only be closed when no tokens are in circulation.\r\n\r\n<ArticleSection name=\"Initializing the Mint Account\" id=\"initializing-the-mint-account\" level=\"h2\" />\r\n\r\nTo initialize the `MintCloseAuthority` extension on a `Mint` account we can simply use the macro that `Anchor` created for us.\r\n\r\nHere's how to create a mint with the Mint Close extension:\r\n\r\n```rust\r\n#[derive(Accounts)]\r\npub struct CreateMint<'info> {\r\n    #[account(mut)]\r\n    pub signer: Signer<'info>,\r\n    #[account(\r\n        init,\r\n        payer = signer,\r\n        mint::decimals = 6,\r\n        mint::authority = signer.key(),\r\n        mint::token_program = token_program,\r\n        extensions::close_authority::authority = signer,\r\n    )]\r\n    pub mint: InterfaceAccount<'info, Mint>,\r\n    pub system_program: Program<'info, System>,\r\n    pub token_program: Interface<'info, TokenInterface>,\r\n}\r\n```\r\n\r\n<ArticleSection name=\"Closing the Mint Account\" id=\"closing-the-mint-account\" level=\"h2\" />\r\n\r\nIf a `Mint` account has a supply of zero, the `CloseMint Authority` can reclaim the rent on that account by using the `close_account()` instruction like so:\r\n\r\n```rust\r\nuse anchor_lang::prelude::*;\r\nuse anchor_lang::system_program::{create_account, CreateAccount};\r\nuse anchor_spl::{\r\n    token_2022::{close_account, CloseAccount},\r\n    token_interface::{\r\n        spl_token_2022::{\r\n            extension::{\r\n                mint_close_authority::MintCloseAuthority\r\n            },\r\n        },\r\n        Mint, Token2022,\r\n    },\r\n};\r\n\r\n#[derive(Accounts)]\r\npub struct Close<'info> {\r\n    #[account(mut)]\r\n    pub authority: Signer<'info>,\r\n\r\n    #[account(\r\n        mut,\r\n        extensions::close_authority::authority = authority,\r\n    )]\r\n    pub mint_account: InterfaceAccount<'info, Mint>,\r\n    pub token_program: Program<'info, Token2022>,\r\n}\r\n\r\npub fn close(ctx: Context<Close>) -> Result<()> {\r\n    // cpi to token extensions programs to close mint account\r\n    // alternatively, this can also be done in the client\r\n    close_account(CpiContext::new(\r\n        ctx.accounts.token_program.to_account_info(),\r\n        CloseAccount {\r\n            account: ctx.accounts.mint_account.to_account_info(),\r\n            destination: ctx.accounts.authority.to_account_info(),\r\n            authority: ctx.accounts.authority.to_account_info(),\r\n        },\r\n    ))?;\r\n    Ok(())\r\n}\r\n```","highlightedCode":{"code-0":{"lang":"rust","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"#[derive("}]},{"type":"element","tagName":"span","properties":{"style":"color:#97E1F1;font-style:italic"},"children":[{"type":"text","value":"Accounts"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":")]"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"pub"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":" struct"}]},{"type":"element","tagName":"span","properties":{"style":"color:#97E1F1;font-style:italic"},"children":[{"type":"text","value":" CreateMint"}]},{"type":"element","tagName":"span","properties