ram,\r\n        extensions::close_authority::authority = signer,\r\n    )]\r\n    pub mint: InterfaceAccount<'info, Mint>,\r\n    pub system_program: Program<'info, System>,\r\n    pub token_program: Interface<'info, TokenInterface>,\r\n}","position":{"start":{"line":15,"column":1,"offset":908},"end":{"line":32,"column":4,"offset":1420}},"data":{"highlightId":"code-0"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Schließen des Mint-Kontos","position":{"start":{"line":34,"column":17,"offset":1440},"end":{"line":34,"column":49,"offset":1472}}},{"type":"mdxJsxAttribute","name":"id","value":"closing-the-mint-account","position":{"start":{"line":34,"column":50,"offset":1473},"end":{"line":34,"column":79,"offset":1502}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":34,"column":80,"offset":1503},"end":{"line":34,"column":90,"offset":1513}}}],"children":[],"position":{"start":{"line":34,"column":1,"offset":1424},"end":{"line":34,"column":93,"offset":1516}}},{"type":"paragraph","children":[{"type":"text","value":"Wenn ein ","position":{"start":{"line":36,"column":1,"offset":1520},"end":{"line":36,"column":10,"offset":1529}}},{"type":"inlineCode","value":"Mint","position":{"start":{"line":36,"column":10,"offset":1529},"end":{"line":36,"column":16,"offset":1535}}},{"type":"text","value":" Konto einen Bestand von null hat, kann die ","position":{"start":{"line":36,"column":16,"offset":1535},"end":{"line":36,"column":60,"offset":1579}}},{"type":"inlineCode","value":"CloseMint Authority","position":{"start":{"line":36,"column":60,"offset":1579},"end":{"line":36,"column":81,"offset":1600}}},{"type":"text","value":" die Miete für dieses Konto zurückfordern, indem sie die ","position":{"start":{"line":36,"column":81,"offset":1600},"end":{"line":36,"column":138,"offset":1657}}},{"type":"inlineCode","value":"close_account()","position":{"start":{"line":36,"column":138,"offset":1657},"end":{"line":36,"column":155,"offset":1674}}},{"type":"text","value":" Anweisung wie folgt verwendet:","position":{"start":{"line":36,"column":155,"offset":1674},"end":{"line":36,"column":186,"offset":1705}}}],"position":{"start":{"line":36,"column":1,"offset":1520},"end":{"line":36,"column":186,"offset":1705}}},{"type":"code","lang":"rust","meta":null,"value":"use anchor_lang::prelude::*;\r\nuse anchor_lang::system_program::{create_account, CreateAccount};\r\nuse anchor_spl::{\r\n    token_2022::{close_account, CloseAccount},\r\n    token_interface::{\r\n        spl_token_2022::{\r\n            extension::{\r\n                mint_close_authority::MintCloseAuthority\r\n            },\r\n        },\r\n        Mint, Token2022,\r\n    },\r\n};\r\n\r\n#[derive(Accounts)]\r\npub struct Close<'info> {\r\n    #[account(mut)]\r\n    pub authority: Signer<'info>,\r\n\r\n    #[account(\r\n        mut,\r\n        extensions::close_authority::authority = authority,\r\n    )]\r\n    pub mint_account: InterfaceAccount<'info, Mint>,\r\n    pub token_program: Program<'info, Token2022>,\r\n}\r\n\r\npub fn close(ctx: Context<Close>) -> Result<()> {\r\n    // cpi to token extensions programs to close mint account\r\n    // alternatively, this can also be done in the client\r\n    close_account(CpiContext::new(\r\n        ctx.accounts.token_program.to_account_info(),\r\n        CloseAccount {\r\n            account: ctx.accounts.mint_account.to_account_info(),\r\n            destination: ctx.accounts.authority.to_account_info(),\r\n            authority: ctx.accounts.authority.to_account_info(),\r\n        },\r\n    ))?;\r\n    Ok(())\r\n}","position":{"start":{"line":38,"column":1,"offset":1709},"end":{"line":79,"column":4,"offset":2929}},"data":{"highlightId":"code-1"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":79,"column":4,"offset":2929}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Die Mint Close Authority Erweiterung\r\n\r\nDie `MintCloseAuthority` Erweiterung ist eine `Mint` Erweiterung, die es der Autorität ermöglicht, ein `Mint` Konto zu schließen und die Miete zurückzuerhalten, wenn das Konto einen aktuellen Bestand von 0 hat.\r\n\r\nDiese Erweiterung ist nützlich, um ungenutzte Mints zu bereinigen und das SOL zurückzufordern, das für die Mietbefreiung des Kontos verwendet wurde. Die Mint kann nur geschlossen werden, wenn keine Token im Umlauf sind.\r\n\r\n<ArticleSection name=\"Initialisierung des Mint-Kontos\" id=\"initializing-the-mint-account\" level=\"h2\" />\r\n\r\nUm die `MintCloseAuthority` Erweiterung auf einem `Mint` Konto zu initialisieren, können wir einfach das Makro verwenden, das `Anchor` für uns erstellt hat.\r\n\r\nHier ist, wie man eine Mint mit der Mint Close Erweiterung erstellt:\r\n\r\n```rust\r\n#[derive(Accounts)]\r\npub struct CreateMint<'info> {\r\n    #[account(mut)]\r\n    pub signer: Signer<'info>,\r\n    #[account(\r\n        init,\r\n        payer = signer,\r\n        mint::decimals = 6,\r\n        mint::authority = signer.key(),\r\n        mint::token_program = token_program,\r\n        extensions::close_authority::authority = signer,\r\n    )]\r\n    pub mint: InterfaceAccount<'info, Mint>,\r\n    pub system_program: Program<'info, System>,\r\n    pub token_program: Interface<'info, TokenInterface>,\r\n}\r\n```\r\n\r\n<ArticleSection name=\"Schließen des Mint-Kontos\" id=\"closing-the-mint-account\" level=\"h2\" />\r\n\r\nWenn ein `Mint` Konto einen Bestand von null hat, kann die `CloseMint Authority` die Miete für dieses Konto zurückfordern, indem sie die `close_account()` Anweisung wie folgt verwendet:\r\n\r\n```rust\r\nuse anchor_lang::prelude::*;\r\nuse anchor_lang::system_program::{create_account, CreateAccount};\r\nuse anchor_spl::{\r\n    token_2022::{close_account, CloseAccount},\r\n    token_interface::{\r\n        spl_token_2022::{\r\n            extension::{\r\n                mint_close_authority::MintCloseAuthority\r\n            },\r\n        },\r\n        Mint, Token2022,\r\n    },\r\n};\r\n\r\n#[derive(Accounts)]\r\npub struct Close<'info> {\r\n    #[account(mut)]\r\n    pub authority: Signer<'info>,\r\n\r\n    #[account(\r\n        mut,\r\n        extensions::close_authority::authority = authority,\r\n    )]\r\n    pub mint_account: InterfaceAccount<'info, Mint>,\r\n    pub token_program: Program<'info, Token2022>,\r\n}\r\n\r\npub fn close(ctx: Context<Close>) -> Result<()> {\r\n    // cpi to token extensions programs to close mint account\r\n    // alternatively, this can also be done in the client\r\n    close_account(CpiContext::new(\r\n        ctx.accounts.token_program.to_account_info(),\r\n        CloseAccount {\r\n            account: ctx.accounts.mint_account.to_account_info(),\r\n            destination: ctx.accounts.authority.to_account_info(),\r\n            authority: ctx.accounts.authority.to_account_info(),\r\n        },\r\n    ))?;\r\n    Ok(())\r\n}\r\n```","highlightedCode":{"code-0":{"lang":"rust","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"#[derive("}]},{"type":"element","tagName":"span","properties":{"style":"color:#97E1F1;font-style:italic"},"children":[{"type":"text","value":"Accounts"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":")]"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"pub"}]},{"type":"element","tagName"