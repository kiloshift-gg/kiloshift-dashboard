pub struct CreateMint<'info> {\r\n    #[account(mut)]\r\n    pub signer: Signer<'info>,\r\n    #[account(\r\n        init,\r\n        payer = signer,\r\n        mint::decimals = 6,\r\n        mint::authority = signer.key(),\r\n        mint::token_program = token_program,\r\n        extensions::close_authority::authority = signer,\r\n    )]\r\n    pub mint: InterfaceAccount<'info, Mint>,\r\n    pub system_program: Program<'info, System>,\r\n    pub token_program: Interface<'info, TokenInterface>,\r\n}","position":{"start":{"line":15,"column":1,"offset":909},"end":{"line":32,"column":4,"offset":1421}},"data":{"highlightId":"code-0"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Fermeture du Compte de Mint","position":{"start":{"line":34,"column":17,"offset":1441},"end":{"line":34,"column":51,"offset":1475}}},{"type":"mdxJsxAttribute","name":"id","value":"closing-the-mint-account","position":{"start":{"line":34,"column":52,"offset":1476},"end":{"line":34,"column":81,"offset":1505}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":34,"column":82,"offset":1506},"end":{"line":34,"column":92,"offset":1516}}}],"children":[],"position":{"start":{"line":34,"column":1,"offset":1425},"end":{"line":34,"column":95,"offset":1519}}},{"type":"paragraph","children":[{"type":"text","value":"Si un compte de ","position":{"start":{"line":36,"column":1,"offset":1523},"end":{"line":36,"column":17,"offset":1539}}},{"type":"inlineCode","value":"Mint","position":{"start":{"line":36,"column":17,"offset":1539},"end":{"line":36,"column":23,"offset":1545}}},{"type":"text","value":" a un solde nul, la ","position":{"start":{"line":36,"column":23,"offset":1545},"end":{"line":36,"column":43,"offset":1565}}},{"type":"inlineCode","value":"CloseMint Authority","position":{"start":{"line":36,"column":43,"offset":1565},"end":{"line":36,"column":64,"offset":1586}}},{"type":"text","value":" peut récupérer la rente du compte en utilisant l'instruction ","position":{"start":{"line":36,"column":64,"offset":1586},"end":{"line":36,"column":126,"offset":1648}}},{"type":"inlineCode","value":"close_account()","position":{"start":{"line":36,"column":126,"offset":1648},"end":{"line":36,"column":143,"offset":1665}}},{"type":"text","value":" comme ceci :","position":{"start":{"line":36,"column":143,"offset":1665},"end":{"line":36,"column":156,"offset":1678}}}],"position":{"start":{"line":36,"column":1,"offset":1523},"end":{"line":36,"column":156,"offset":1678}}},{"type":"code","lang":"rust","meta":null,"value":"use anchor_lang::prelude::*;\r\nuse anchor_lang::system_program::{create_account, CreateAccount};\r\nuse anchor_spl::{\r\n    token_2022::{close_account, CloseAccount},\r\n    token_interface::{\r\n        spl_token_2022::{\r\n            extension::{\r\n                mint_close_authority::MintCloseAuthority\r\n            },\r\n        },\r\n        Mint, Token2022,\r\n    },\r\n};\r\n\r\n#[derive(Accounts)]\r\npub struct Close<'info> {\r\n    #[account(mut)]\r\n    pub authority: Signer<'info>,\r\n\r\n    #[account(\r\n        mut,\r\n        extensions::close_authority::authority = authority,\r\n    )]\r\n    pub mint_account: InterfaceAccount<'info, Mint>,\r\n    pub token_program: Program<'info, Token2022>,\r\n}\r\n\r\npub fn close(ctx: Context<Close>) -> Result<()> {\r\n    // cpi to token extensions programs to close mint account\r\n    // alternatively, this can also be done in the client\r\n    close_account(CpiContext::new(\r\n        ctx.accounts.token_program.to_account_info(),\r\n        CloseAccount {\r\n            account: ctx.accounts.mint_account.to_account_info(),\r\n            destination: ctx.accounts.authority.to_account_info(),\r\n            authority: ctx.accounts.authority.to_account_info(),\r\n        },\r\n    ))?;\r\n    Ok(())\r\n}","position":{"start":{"line":38,"column":1,"offset":1682},"end":{"line":79,"column":4,"offset":2902}},"data":{"highlightId":"code-1"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":79,"column":4,"offset":2902}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# L'Extension Mint Close Authority\r\n\r\nL'extension `MintCloseAuthority` (Autorité de fermeture du mint) est une extension de compte de `Mint` qui permet à l'autorité de fermer et de récupérer la rente d'un compte de `Mint` donc l'offre actuelle est de 0.\r\n\r\nCette extension est utile pour nettoyer les mints inutilisés et récupérer les SOL qui ont été utilisés pour rendre le compte exempt de rente. Le mint ne peut être fermée que lorsqu'il n'y a plus de jetons en circulation.\r\n\r\n<ArticleSection name=\"Initialisation du Compte de Mint\" id=\"initializing-the-mint-account\" level=\"h2\" />\r\n\r\nPour initialiser l'extension `MintCloseAuthority` sur un compte de `Mint` nous pouvons simplement utiliser la macro créée pour nous par `Anchor`.\r\n\r\nVoici comment créer un compte de mint avec l'extension `MintCloseAuthority` :\r\n\r\n```rust\r\n#[derive(Accounts)]\r\npub struct CreateMint<'info> {\r\n    #[account(mut)]\r\n    pub signer: Signer<'info>,\r\n    #[account(\r\n        init,\r\n        payer = signer,\r\n        mint::decimals = 6,\r\n        mint::authority = signer.key(),\r\n        mint::token_program = token_program,\r\n        extensions::close_authority::authority = signer,\r\n    )]\r\n    pub mint: InterfaceAccount<'info, Mint>,\r\n    pub system_program: Program<'info, System>,\r\n    pub token_program: Interface<'info, TokenInterface>,\r\n}\r\n```\r\n\r\n<ArticleSection name=\"Fermeture du Compte de Mint\" id=\"closing-the-mint-account\" level=\"h2\" />\r\n\r\nSi un compte de `Mint` a un solde nul, la `CloseMint Authority` peut récupérer la rente du compte en utilisant l'instruction `close_account()` comme ceci :\r\n\r\n```rust\r\nuse anchor_lang::prelude::*;\r\nuse anchor_lang::system_program::{create_account, CreateAccount};\r\nuse anchor_spl::{\r\n    token_2022::{close_account, CloseAccount},\r\n    token_interface::{\r\n        spl_token_2022::{\r\n            extension::{\r\n                mint_close_authority::MintCloseAuthority\r\n            },\r\n        },\r\n        Mint, Token2022,\r\n    },\r\n};\r\n\r\n#[derive(Accounts)]\r\npub struct Close<'info> {\r\n    #[account(mut)]\r\n    pub authority: Signer<'info>,\r\n\r\n    #[account(\r\n        mut,\r\n        extensions::close_authority::authority = authority,\r\n    )]\r\n    pub mint_account: InterfaceAccount<'info, Mint>,\r\n    pub token_program: Program<'info, Token2022>,\r\n}\r\n\r\npub fn close(ctx: Context<Close>) -> Result<()> {\r\n    // cpi to token extensions programs to close mint account\r\n    // alternatively, this can also be done in the client\r\n    close_account(CpiContext::new(\r\n        ctx.accounts.token_program.to_account_info(),\r\n        CloseAccount {\r\n            account: ctx.accounts.mint_account.to_account_info(),\r\n            destination: ctx.accounts.authority.to_account_info(),\r\n            authority: ctx.accounts.authority.to_account_info(),\r\n        },\r\n    ))?;\r\n    Ok(())\r\n}\r\n```","highlightedCode":{"code-0":{"lang":"rust","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"#[derive("}]},{"type":"element","tagName":"span","properties":{"style":"color:#97E1F1;font-style:italic"},"children":[{"type":"text","value":"Accounts"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":")]"}]}]},{"type":"text","value":"\n"},{"type":"e