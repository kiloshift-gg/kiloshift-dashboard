   pub system_program: Program<'info, System>,\r\n    pub token_program: Interface<'info, TokenInterface>,\r\n}","position":{"start":{"line":15,"column":1,"offset":779},"end":{"line":32,"column":4,"offset":1291}},"data":{"highlightId":"code-0"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Закриття рахунку Mint","position":{"start":{"line":34,"column":17,"offset":1311},"end":{"line":34,"column":45,"offset":1339}}},{"type":"mdxJsxAttribute","name":"id","value":"closing-the-mint-account","position":{"start":{"line":34,"column":46,"offset":1340},"end":{"line":34,"column":75,"offset":1369}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":34,"column":76,"offset":1370},"end":{"line":34,"column":86,"offset":1380}}}],"children":[],"position":{"start":{"line":34,"column":1,"offset":1295},"end":{"line":34,"column":89,"offset":1383}}},{"type":"paragraph","children":[{"type":"text","value":"Якщо рахунок ","position":{"start":{"line":36,"column":1,"offset":1387},"end":{"line":36,"column":14,"offset":1400}}},{"type":"inlineCode","value":"Mint","position":{"start":{"line":36,"column":14,"offset":1400},"end":{"line":36,"column":20,"offset":1406}}},{"type":"text","value":" має запас нуль, ","position":{"start":{"line":36,"column":20,"offset":1406},"end":{"line":36,"column":37,"offset":1423}}},{"type":"inlineCode","value":"CloseMint Authority","position":{"start":{"line":36,"column":37,"offset":1423},"end":{"line":36,"column":58,"offset":1444}}},{"type":"text","value":" може повернути орендну плату за цей рахунок, використовуючи інструкцію ","position":{"start":{"line":36,"column":58,"offset":1444},"end":{"line":36,"column":130,"offset":1516}}},{"type":"inlineCode","value":"close_account()","position":{"start":{"line":36,"column":130,"offset":1516},"end":{"line":36,"column":147,"offset":1533}}},{"type":"text","value":" таким чином:","position":{"start":{"line":36,"column":147,"offset":1533},"end":{"line":36,"column":160,"offset":1546}}}],"position":{"start":{"line":36,"column":1,"offset":1387},"end":{"line":36,"column":160,"offset":1546}}},{"type":"code","lang":"rust","meta":null,"value":"use anchor_lang::prelude::*;\r\nuse anchor_lang::system_program::{create_account, CreateAccount};\r\nuse anchor_spl::{\r\n    token_2022::{close_account, CloseAccount},\r\n    token_interface::{\r\n        spl_token_2022::{\r\n            extension::{\r\n                mint_close_authority::MintCloseAuthority\r\n            },\r\n        },\r\n        Mint, Token2022,\r\n    },\r\n};\r\n\r\n#[derive(Accounts)]\r\npub struct Close<'info> {\r\n    #[account(mut)]\r\n    pub authority: Signer<'info>,\r\n\r\n    #[account(\r\n        mut,\r\n        extensions::close_authority::authority = authority,\r\n    )]\r\n    pub mint_account: InterfaceAccount<'info, Mint>,\r\n    pub token_program: Program<'info, Token2022>,\r\n}\r\n\r\npub fn close(ctx: Context<Close>) -> Result<()> {\r\n    // cpi to token extensions programs to close mint account\r\n    // alternatively, this can also be done in the client\r\n    close_account(CpiContext::new(\r\n        ctx.accounts.token_program.to_account_info(),\r\n        CloseAccount {\r\n            account: ctx.accounts.mint_account.to_account_info(),\r\n            destination: ctx.accounts.authority.to_account_info(),\r\n            authority: ctx.accounts.authority.to_account_info(),\r\n        },\r\n    ))?;\r\n    Ok(())\r\n}","position":{"start":{"line":38,"column":1,"offset":1550},"end":{"line":79,"column":4,"offset":2770}},"data":{"highlightId":"code-1"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":79,"column":4,"offset":2770}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Розширення Mint Close Authority\r\n\r\nРозширення `MintCloseAuthority` є розширенням `Mint`, яке дозволяє власнику закрити та отримати орендну плату з рахунку `Mint`, який має поточний запас 0.\r\n\r\nЦе розширення корисне для очищення невикористаних мінтів та повернення SOL, який був використаний для оплати звільнення рахунку від оренди. Мінт можна закрити лише тоді, коли в обігу немає токенів.\r\n\r\n<ArticleSection name=\"Ініціалізація рахунку Mint\" id=\"initializing-the-mint-account\" level=\"h2\" />\r\n\r\nЩоб ініціалізувати розширення `MintCloseAuthority` на рахунку `Mint`, ми можемо просто використати макрос, який створив для нас `Anchor`.\r\n\r\nОсь як створити мінт з розширенням Mint Close:\r\n\r\n```rust\r\n#[derive(Accounts)]\r\npub struct CreateMint<'info> {\r\n    #[account(mut)]\r\n    pub signer: Signer<'info>,\r\n    #[account(\r\n        init,\r\n        payer = signer,\r\n        mint::decimals = 6,\r\n        mint::authority = signer.key(),\r\n        mint::token_program = token_program,\r\n        extensions::close_authority::authority = signer,\r\n    )]\r\n    pub mint: InterfaceAccount<'info, Mint>,\r\n    pub system_program: Program<'info, System>,\r\n    pub token_program: Interface<'info, TokenInterface>,\r\n}\r\n```\r\n\r\n<ArticleSection name=\"Закриття рахунку Mint\" id=\"closing-the-mint-account\" level=\"h2\" />\r\n\r\nЯкщо рахунок `Mint` має запас нуль, `CloseMint Authority` може повернути орендну плату за цей рахунок, використовуючи інструкцію `close_account()` таким чином:\r\n\r\n```rust\r\nuse anchor_lang::prelude::*;\r\nuse anchor_lang::system_program::{create_account, CreateAccount};\r\nuse anchor_spl::{\r\n    token_2022::{close_account, CloseAccount},\r\n    token_interface::{\r\n        spl_token_2022::{\r\n            extension::{\r\n                mint_close_authority::MintCloseAuthority\r\n            },\r\n        },\r\n        Mint, Token2022,\r\n    },\r\n};\r\n\r\n#[derive(Accounts)]\r\npub struct Close<'info> {\r\n    #[account(mut)]\r\n    pub authority: Signer<'info>,\r\n\r\n    #[account(\r\n        mut,\r\n        extensions::close_authority::authority = authority,\r\n    )]\r\n    pub mint_account: InterfaceAccount<'info, Mint>,\r\n    pub token_program: Program<'info, Token2022>,\r\n}\r\n\r\npub fn close(ctx: Context<Close>) -> Result<()> {\r\n    // cpi to token extensions programs to close mint account\r\n    // alternatively, this can also be done in the client\r\n    close_account(CpiContext::new(\r\n        ctx.accounts.token_program.to_account_info(),\r\n        CloseAccount {\r\n            account: ctx.accounts.mint_account.to_account_info(),\r\n            destination: ctx.accounts.authority.to_account_info(),\r\n            authority: ctx.accounts.authority.to_account_info(),\r\n        },\r\n    ))?;\r\n    Ok(())\r\n}\r\n```","highlightedCode":{"code-0":{"lang":"rust","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"#[derive("}]},{"type":"element","tagName":"span","properties":{"style":"color:#97E1F1;font-style:italic"},"children":[{"type":"text","value":"Accounts"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":")]"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"pub"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":" struct"}]},{"type":"element","tagName":"span","properties":{"style":"color:#97E1F1;font-style:italic"},"children":[{"type":"text","value":" CreateMint"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"ch