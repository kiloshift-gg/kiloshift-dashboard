umn":164,"offset":1516}}}],"position":{"start":{"line":36,"column":1,"offset":1353},"end":{"line":36,"column":164,"offset":1516}}},{"type":"code","lang":"rust","meta":null,"value":"use anchor_lang::prelude::*;\r\nuse anchor_lang::system_program::{create_account, CreateAccount};\r\nuse anchor_spl::{\r\n    token_2022::{close_account, CloseAccount},\r\n    token_interface::{\r\n        spl_token_2022::{\r\n            extension::{\r\n                mint_close_authority::MintCloseAuthority\r\n            },\r\n        },\r\n        Mint, Token2022,\r\n    },\r\n};\r\n\r\n#[derive(Accounts)]\r\npub struct Close<'info> {\r\n    #[account(mut)]\r\n    pub authority: Signer<'info>,\r\n\r\n    #[account(\r\n        mut,\r\n        extensions::close_authority::authority = authority,\r\n    )]\r\n    pub mint_account: InterfaceAccount<'info, Mint>,\r\n    pub token_program: Program<'info, Token2022>,\r\n}\r\n\r\npub fn close(ctx: Context<Close>) -> Result<()> {\r\n    // cpi to token extensions programs to close mint account\r\n    // alternatively, this can also be done in the client\r\n    close_account(CpiContext::new(\r\n        ctx.accounts.token_program.to_account_info(),\r\n        CloseAccount {\r\n            account: ctx.accounts.mint_account.to_account_info(),\r\n            destination: ctx.accounts.authority.to_account_info(),\r\n            authority: ctx.accounts.authority.to_account_info(),\r\n        },\r\n    ))?;\r\n    Ok(())\r\n}","position":{"start":{"line":38,"column":1,"offset":1520},"end":{"line":79,"column":4,"offset":2740}},"data":{"highlightId":"code-1"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":79,"column":4,"offset":2740}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Mint Close Authority Extension\r\n\r\nPhần mở rộng `MintCloseAuthority` là một `Mint` extension cho phép authority đóng và lấy lại phí thuê từ `Mint` account có supply hiện tại là 0.\r\n\r\nPhần mở rộng này hữu ích để dọn dẹp các mint không sử dụng và lấy lại SOL đã được sử dụng để trả cho phí thuê của account. Mint chỉ có thể được đóng khi không có token nào đang lưu thông.\r\n\r\n<ArticleSection name=\"Khởi tạo Mint Account\" id=\"initializing-the-mint-account\" level=\"h2\" />\r\n\r\nĐể khởi tạo phần mở rộng `MintCloseAuthority` trên `Mint` account, chúng ta chỉ cần sử dụng macro mà `Anchor` đã tạo cho chúng ta.\r\n\r\nĐây là cách tạo mint với phần mở rộng Mint Close:\r\n\r\n```rust\r\n#[derive(Accounts)]\r\npub struct CreateMint<'info> {\r\n    #[account(mut)]\r\n    pub signer: Signer<'info>,\r\n    #[account(\r\n        init,\r\n        payer = signer,\r\n        mint::decimals = 6,\r\n        mint::authority = signer.key(),\r\n        mint::token_program = token_program,\r\n        extensions::close_authority::authority = signer,\r\n    )]\r\n    pub mint: InterfaceAccount<'info, Mint>,\r\n    pub system_program: Program<'info, System>,\r\n    pub token_program: Interface<'info, TokenInterface>,\r\n}\r\n```\r\n\r\n<ArticleSection name=\"Đóng Mint Account\" id=\"closing-the-mint-account\" level=\"h2\" />\r\n\r\nNếu `Mint` account có supply bằng không, `CloseMint Authority` có thể lấy lại phí thuê trên account đó bằng cách sử dụng instruction `close_account()` như thế này:\r\n\r\n```rust\r\nuse anchor_lang::prelude::*;\r\nuse anchor_lang::system_program::{create_account, CreateAccount};\r\nuse anchor_spl::{\r\n    token_2022::{close_account, CloseAccount},\r\n    token_interface::{\r\n        spl_token_2022::{\r\n            extension::{\r\n                mint_close_authority::MintCloseAuthority\r\n            },\r\n        },\r\n        Mint, Token2022,\r\n    },\r\n};\r\n\r\n#[derive(Accounts)]\r\npub struct Close<'info> {\r\n    #[account(mut)]\r\n    pub authority: Signer<'info>,\r\n\r\n    #[account(\r\n        mut,\r\n        extensions::close_authority::authority = authority,\r\n    )]\r\n    pub mint_account: InterfaceAccount<'info, Mint>,\r\n    pub token_program: Program<'info, Token2022>,\r\n}\r\n\r\npub fn close(ctx: Context<Close>) -> Result<()> {\r\n    // cpi to token extensions programs to close mint account\r\n    // alternatively, this can also be done in the client\r\n    close_account(CpiContext::new(\r\n        ctx.accounts.token_program.to_account_info(),\r\n        CloseAccount {\r\n            account: ctx.accounts.mint_account.to_account_info(),\r\n            destination: ctx.accounts.authority.to_account_info(),\r\n            authority: ctx.accounts.authority.to_account_info(),\r\n        },\r\n    ))?;\r\n    Ok(())\r\n}\r\n```","highlightedCode":{"code-0":{"lang":"rust","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"#[derive("}]},{"type":"element","tagName":"span","properties":{"style":"color:#97E1F1;font-style:italic"},"children":[{"type":"text","value":"Accounts"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":")]"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"pub"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":" struct"}]},{"type":"element","tagName":"span","properties":{"style":"color:#97E1F1;font-style:italic"},"children":[{"type":"text","value":" CreateMint"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"<'"}]},{"type":"element","tag