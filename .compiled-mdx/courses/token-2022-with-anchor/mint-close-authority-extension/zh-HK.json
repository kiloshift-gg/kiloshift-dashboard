":"id","value":"closing-the-mint-account","position":{"start":{"line":34,"column":31,"offset":966},"end":{"line":34,"column":60,"offset":995}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":34,"column":61,"offset":996},"end":{"line":34,"column":71,"offset":1006}}}],"children":[],"position":{"start":{"line":34,"column":1,"offset":936},"end":{"line":34,"column":74,"offset":1009}}},{"type":"paragraph","children":[{"type":"text","value":"如果 ","position":{"start":{"line":36,"column":1,"offset":1013},"end":{"line":36,"column":4,"offset":1016}}},{"type":"inlineCode","value":"Mint","position":{"start":{"line":36,"column":4,"offset":1016},"end":{"line":36,"column":10,"offset":1022}}},{"type":"text","value":" 帳戶的供應量為零，","position":{"start":{"line":36,"column":10,"offset":1022},"end":{"line":36,"column":20,"offset":1032}}},{"type":"inlineCode","value":"CloseMint Authority","position":{"start":{"line":36,"column":20,"offset":1032},"end":{"line":36,"column":41,"offset":1053}}},{"type":"text","value":" 可以通過使用 ","position":{"start":{"line":36,"column":41,"offset":1053},"end":{"line":36,"column":49,"offset":1061}}},{"type":"inlineCode","value":"close_account()","position":{"start":{"line":36,"column":49,"offset":1061},"end":{"line":36,"column":66,"offset":1078}}},{"type":"text","value":" 指令來回收該帳戶的租金，如下所示：","position":{"start":{"line":36,"column":66,"offset":1078},"end":{"line":36,"column":84,"offset":1096}}}],"position":{"start":{"line":36,"column":1,"offset":1013},"end":{"line":36,"column":84,"offset":1096}}},{"type":"code","lang":"rust","meta":null,"value":"use anchor_lang::prelude::*;\r\nuse anchor_lang::system_program::{create_account, CreateAccount};\r\nuse anchor_spl::{\r\n    token_2022::{close_account, CloseAccount},\r\n    token_interface::{\r\n        spl_token_2022::{\r\n            extension::{\r\n                mint_close_authority::MintCloseAuthority\r\n            },\r\n        },\r\n        Mint, Token2022,\r\n    },\r\n};\r\n\r\n#[derive(Accounts)]\r\npub struct Close<'info> {\r\n    #[account(mut)]\r\n    pub authority: Signer<'info>,\r\n\r\n    #[account(\r\n        mut,\r\n        extensions::close_authority::authority = authority,\r\n    )]\r\n    pub mint_account: InterfaceAccount<'info, Mint>,\r\n    pub token_program: Program<'info, Token2022>,\r\n}\r\n\r\npub fn close(ctx: Context<Close>) -> Result<()> {\r\n    // cpi to token extensions programs to close mint account\r\n    // alternatively, this can also be done in the client\r\n    close_account(CpiContext::new(\r\n        ctx.accounts.token_program.to_account_info(),\r\n        CloseAccount {\r\n            account: ctx.accounts.mint_account.to_account_info(),\r\n            destination: ctx.accounts.authority.to_account_info(),\r\n            authority: ctx.accounts.authority.to_account_info(),\r\n        },\r\n    ))?;\r\n    Ok(())\r\n}","position":{"start":{"line":38,"column":1,"offset":1100},"end":{"line":79,"column":4,"offset":2320}},"data":{"highlightId":"code-1"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":79,"column":4,"offset":2320}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# 鑄幣關閉權限擴展\r\n\r\n`MintCloseAuthority` 擴展是一個 `Mint` 擴展，允許權限關閉並回收來自供應量為 0 的 `Mint` 帳戶的租金。\r\n\r\n此擴展對於清理未使用的鑄幣並回收用於支付帳戶租金豁免的 SOL 非常有用。只有當沒有代幣在流通時，鑄幣才可以被關閉。\r\n\r\n<ArticleSection name=\"初始化鑄幣帳戶\" id=\"initializing-the-mint-account\" level=\"h2\" />\r\n\r\n要在 `Mint` 帳戶上初始化 `MintCloseAuthority` 擴展，我們可以簡單地使用 `Anchor` 為我們創建的宏。\r\n\r\n以下是如何使用鑄幣關閉擴展創建鑄幣的方法：\r\n\r\n```rust\r\n#[derive(Accounts)]\r\npub struct CreateMint<'info> {\r\n    #[account(mut)]\r\n    pub signer: Signer<'info>,\r\n    #[account(\r\n        init,\r\n        payer = signer,\r\n        mint::decimals = 6,\r\n        mint::authority = signer.key(),\r\n        mint::token_program = token_program,\r\n        extensions::close_authority::authority = signer,\r\n    )]\r\n    pub mint: InterfaceAccount<'info, Mint>,\r\n    pub system_program: Program<'info, System>,\r\n    pub token_program: Interface<'info, TokenInterface>,\r\n}\r\n```\r\n\r\n<ArticleSection name=\"關閉鑄幣帳戶\" id=\"closing-the-mint-account\" level=\"h2\" />\r\n\r\n如果 `Mint` 帳戶的供應量為零，`CloseMint Authority` 可以通過使用 `close_account()` 指令來回收該帳戶的租金，如下所示：\r\n\r\n```rust\r\nuse anchor_lang::prelude::*;\r\nuse anchor_lang::system_program::{create_account, CreateAccount};\r\nuse anchor_spl::{\r\n    token_2022::{close_account, CloseAccount},\r\n    token_interface::{\r\n        spl_token_2022::{\r\n            extension::{\r\n                mint_close_authority::MintCloseAuthority\r\n            },\r\n        },\r\n        Mint, Token2022,\r\n    },\r\n};\r\n\r\n#[derive(Accounts)]\r\npub struct Close<'info> {\r\n    #[account(mut)]\r\n    pub authority: Signer<'info>,\r\n\r\n    #[account(\r\n        mut,\r\n        extensions::close_authority::authority = authority,\r\n    )]\r\n    pub mint_account: InterfaceAccount<'info, Mint>,\r\n    pub token_program: Program<'info, Token2022>,\r\n}\r\n\r\npub fn close(ctx: Context<Close>) -> Result<()> {\r\n    // cpi to token extensions programs to close mint account\r\n    // alternatively, this can also be done in the client\r\n    close_account(CpiContext::new(\r\n        ctx.accounts.token_program.to_account_info(),\r\n        CloseAccount {\r\n            account: ctx.accounts.mint_account.to_account_info(),\r\n            destination: ctx.accounts.authority.to_account_info(),\r\n            authority: ctx.accounts.authority.to_account_info(),\r\n        },\r\n    ))?;\r\n    Ok(())\r\n}\r\n```","highlightedCode":{"code-0":{"lang":"rust","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":