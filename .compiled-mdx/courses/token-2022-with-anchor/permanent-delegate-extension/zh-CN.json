`freeze()`，都可以在需要时直接由权限方执行，而无需实际所有者的签名。\r\n\r\n这意味着我们可以直接使用常规的 `transferChecked()`、`burnChecked()` 等指令，并在 `authority` 字段中传入 `PermanentDelegate` 权限。","highlightedCode":{"code-0":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"#["}]},{"type":"element","tagName":"span","properties":{"style":"color:#62E884"},"children":[{"type":"text","value":"derive"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"(Accounts)]"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"pub struct CreateMint"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"<"}]},{"type":"element","tagName":"span","properties":{"style":"color:#DEE492"},"children":[{"type":"text","value":"'"}]},{"type":"element","tagName":"span","properties":{"style":"color:#E7EE98"},"children":[{"type":"text","value":"info> "}]},{"type":"element","tagName":"span","properties":{"style":"color:#EE6666;font-style:italic;text-decoration:underline"},"children":[{"type":"text","value":"{"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"    #["}]},{"type":"element","tagName":"span","properties":{"style":"color:#62E884"},"children":[{"type":"text","value":"account"}]},{"type":"elem