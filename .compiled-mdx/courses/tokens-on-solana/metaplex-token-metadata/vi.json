":13,"column":300,"offset":1157}}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Metadata Account","position":{"start":{"line":15,"column":17,"offset":1177},"end":{"line":15,"column":40,"offset":1200}}},{"type":"mdxJsxAttribute","name":"id","value":"metadata-account","position":{"start":{"line":15,"column":41,"offset":1201},"end":{"line":15,"column":62,"offset":1222}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":15,"column":63,"offset":1223},"end":{"line":15,"column":73,"offset":1233}}}],"children":[],"position":{"start":{"line":15,"column":1,"offset":1161},"end":{"line":15,"column":76,"offset":1236}}},{"type":"paragraph","children":[{"type":"text","value":"Account ","position":{"start":{"line":17,"column":1,"offset":1240},"end":{"line":17,"column":9,"offset":1248}}},{"type":"inlineCode","value":"Metadata","position":{"start":{"line":17,"column":9,"offset":1248},"end":{"line":17,"column":19,"offset":1258}}},{"type":"text","value":" hoạt động như thẻ định danh kỹ thuật số của token của bạn, lưu trữ tất cả các thông tin mà biến đổi một địa chỉ mint thành một tài sản có thể nhận dạng.","position":{"start":{"line":17,"column":19,"offset":1258},"end":{"line":17,"column":172,"offset":1411}}}],"position":{"start":{"line":17,"column":1,"offset":1240},"end":{"line":17,"column":172,"offset":1411}}},{"type":"paragraph","children":[{"type":"text","value":"Điều này không chỉ nói về tên và hình ảnh đẹp mắt: đó là việc tạo nền tảng cho cách thức mà token của bạn xuất hiện trên toàn bộ hệ sinh thái Solana.","position":{"start":{"line":19,"column":1,"offset":1415},"end":{"line":19,"column":150,"offset":1564}}}],"position":{"start":{"line":19,"column":1,"offset":1415},"end":{"line":19,"column":150,"offset":1564}}},{"type":"paragraph","children":[{"type":"text","value":"Sử dụng hệ thống địa chỉ PDA của Solana, mỗi token có được chính xác một account metadata được liên kết toán học với mint của nó. Điều này tạo ra một liên kết không thể phá vỡ giữa token kỹ thuật số và thông tin mô tả của nó, đảm bảo tính nhất quán trên tất cả các ứng dụng và ngăn ngừa xung đột nhận dạng:","position":{"start":{"line":21,"column":1,"offset":1568},"end":{"line":21,"column":307,"offset":1874}}}],"position":{"start":{"line":21,"column":1,"offset":1568},"end":{"line":21,"column":307,"offset":1874}}},{"type":"code","lang":"rust","meta":null,"value":"const ID: Pubkey = solana_pubkey::pubkey!(\"metaqbxxUerdq28cj1RbAWkYQm3ybzjb6a8bt518x1s\");\r\n\r\nconst PREFIX: &str = \"metadata\";\r\n\r\nlet (metadata, _) = Pubkey::find_program_address(\r\n    &[\r\n        PREFIX.as_bytes(), \r\n        &ID, \r\n        mint.as_ref()\r\n    ], \r\n    &ID  \r\n);","position":{"start":{"line":23,"column":1,"offset":1878},"end":{"line":36,"column":4,"offset":2169}},"data":{"highlightId":"code-0"}},{"type":"paragraph","children":[{"type":"text","value":"Account metadata trở thành 1 tấm hộ chiếu thống nhất của token của bạn, chứa tất cả những thông tin mà các ứng dụng cần để hiển thị tài sản của bạn đúng cách.","position":{"start":{"line":38,"column":1,"offset":2173},"end":{"line":38,"column":159,"offset":2331}}}],"position":{"start":{"line":38,"column":1,"offset":2173},"end":{"line":38,"column":159,"offset":2331}}},{"type":"paragraph","children":[{"type":"text","value":"Tên token thay thế các địa chỉ vô nghĩa, các ký hiệu cung cấp nhận dạng ngay lập tức (hãy nghĩ đến \"SOL\" thay vì chuỗi dài ở trên), và các tham chiếu URI trỏ đến các tài nguyên phong phú như logo và mô tả chi tiết.","position":{"start":{"line":40,"column":1,"offset":2335},"end":{"line":40,"column":215,"offset":2549}}}],"position":{"start":{"line":40,"column":1,"offset":2335},"end":{"line":40,"column":215,"offset":2549}}},{"type":"paragraph","children":[{"type":"text","value":"Kết qủa là gì? Token của bạn không chỉ tồn tại trên chuỗi khối, mà còn hiện diện trong các ví, xuất hiện một cách chuyên nghiệp trong các trình khám phá, và tích hợp liền mạch với các ứng dụng trên toàn bộ hệ sinh thái Solana.","position":{"start":{"line":42,"column":1,"offset":2553},"end":{"line":42,"column":227,"offset":2779}}}],"position":{"start":{"line":42,"column":1,"offset":2553},"end":{"line":42,"column":227,"offset":2779}}},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"Để tìm hiểu thêm về cách sử dụng chương trình ","position":{"start":{"line":44,"column":3,"offset":2785},"end":{"line":44,"column":49,"offset":2831}}},{"type":"inlineCode","value":"Token Metadata","position":{"start":{"line":44,"column":49,"offset":2831},"end":{"line":44,"column":65,"offset":2847}}},{"type":"text","value":", tham khảo ","position":{"start":{"line":44,"column":65,"offset":2847},"end":{"line":44,"column":77,"offset":2859}}},{"type":"link","title":null,"url":"https://developers.metaplex.com/token-metadata","children":[{"type":"text","value":"tài liệu chính thức","position":{"start":{"line":44,"column":78,"offset":2860},"end":{"line":44,"column":97,"offset":2879}}}],"position":{"start":{"line":44,"column":77,"offset":2859},"end":{"line":44,"column":146,"offset":2928}}}],"position":{"start":{"line":44,"column":3,"offset":2785},"end":{"line":44,"column":146,"offset":2928}}}],"position":{"start":{"line":44,"column":1,"offset":2783},"end":{"line":44,"column":146,"offset":2928}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":44,"column":146,"offset":2928}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Chương trình Metaplex Token Metadata\r\n\r\nHãy tưởng tượng bạn ra mắt một token trên Solana, chỉ để thấy nó xuất hiện trong mọi ví như một chuỗi ký tự vô nghĩa như \"7xKXtg2CW87d97TXJSDpbD5jBkheTqA83TZRuJosgAsU\".\r\n\r\nNgười dùng sẽ không biết mình đang giữ gì, và dự án của bạn sẽ không thể phân biệt được với hàng ngàn token vô danh khác đang tràn lan trên mạng.\r\n\r\nChương trình Metaplex Token Metadata giải quyết vấn đề này bằng cách biến các mục blockchain vô danh thành các tài sản kỹ thuật số có thương hiệu, dễ nhận dạng.\r\n\r\nTrong khi chương trình SPL-Token hoạt động xuất sắc trong các cơ chế kỹ thuật theo dõi tính sở hữu, quản lý nguồn cung và chuyển giao, nó thiết kế các token như các cấu trúc dữ liệu cơ bản mà không có bất kỳ ngữ cảnh có thể đọc được nào.\r\n\r\nĐây là nơi Metaplex thực hiện ma thuật của mình, kết nối các chức năng blockchain thô và trải nghiệm người dùng. Thay vì địa chỉ mã hóa, người dùng thấy \"Solana (SOL)\" với các logo quen thuộc, các mô tả rõ ràng, và tất cả các thông tin ngữ cảnh mà làm cho token thực sự có thể sử dụng trong thực tế.\r\n\r\n<ArticleSection name=\"Metadata Account\" id=\"metadata-account\" level=\"h2\" />\r\n\r\nAccount `Metadata` hoạt động như thẻ định danh kỹ thuật số của token của bạn, lưu trữ tất cả các thông tin mà biến đổi một địa chỉ mint thành một tài sản có thể nhận dạng.\r\n\r\nĐiều này không chỉ nói về tên và hình ảnh đẹp mắt: đó là việc tạo nền tảng cho cách thức mà token của bạn xuất hiện trên toàn bộ hệ sinh thái Solana.\r\n\r\nSử dụng hệ thống địa chỉ PDA của Solana, mỗi token có được chính xác một account metadata được liên kết toán học với mint của nó. Điều này tạo ra một liên kết không thể phá vỡ giữa token kỹ thuật số và thông tin mô tả của nó, đảm bảo tính nhất quán trên tất cả các ứng dụng và ngăn ngừa xung đột nhận dạng:\r\n\r\n```rust\r\nconst ID: Pubkey = solana_pubkey::pubkey!(\"metaqbxxUerdq28cj1RbAWkYQm3ybzjb6a8bt518x1s\");\r\n\r\nconst PREFIX: &str = \"metadata\";\r\n\r\nlet (metadata, _) = Pubkey::find_program_address(\r\n    &[\r\n        PREFIX.as_bytes(), \r\n        &ID, \r\n        mint.as_ref()\r\n    ], \r\n    &ID  \r\n);\r\n```\r\n\r\nAccount metadata trở thành 1 tấm hộ chiếu thống nhất của token của bạn, chứa tất cả những thông tin mà các ứng dụng cần để hiển thị tài sản của bạn đúng cách.\r\n\r\nTên token thay thế các địa chỉ vô nghĩa, các ký hiệu cung cấp nhận dạng ngay lập tức (hãy nghĩ đến \"SOL\" thay vì chuỗi dài ở trên), và các tham chiếu URI trỏ đến các tài nguyên phong phú như logo và mô tả chi tiết.\r\n\r\nKết qủa là gì? Token của bạn không chỉ tồn tại trên chuỗi khối, mà còn hiện diện trong các ví, xuất hiện một cách chuyên nghiệp trong các trình khám phá, và tích hợp liền mạch với các ứng dụng trên toàn bộ hệ sinh thái Solana.\r\n\r\n> Để tìm hiểu thêm về cách sử dụng chương trình `Token Metadata`, tham khảo [tài liệu chính thức](https://developers.metaplex.com/token-metadata)","highlightedCode":{"code-0":{"lang":"rust","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"const"}]},{"type":"element","tagName":"span","properties":{"style":"color:#BF9EEE"},"children":[{"type":"text","value":" ID"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":":"}]},{"type":"element","tagName":"span","properties":{"style":"color:#97E1F1;font-style:italic"},"children":[{"type":"text","value":" Pubkey"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":" ="}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" solana_pubkey"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"::"}]},{"type":"element","tagName":"span","properties":{"style":"color:#62E884"},"children":[{"type":"text","value":"pubkey!"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"("}]},{"type"