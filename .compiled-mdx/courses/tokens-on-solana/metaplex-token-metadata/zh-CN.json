,"end":{"line":15,"column":76,"offset":583}}},{"type":"paragraph","children":[{"type":"inlineCode","value":"Metadata","position":{"start":{"line":17,"column":1,"offset":587},"end":{"line":17,"column":11,"offset":597}}},{"type":"text","value":" 账户充当您的代币的数字身份证，存储所有信息，将一个简单的铸币地址转变为可识别的资产。","position":{"start":{"line":17,"column":11,"offset":597},"end":{"line":17,"column":54,"offset":640}}}],"position":{"start":{"line":17,"column":1,"offset":587},"end":{"line":17,"column":54,"offset":640}}},{"type":"paragraph","children":[{"type":"text","value":"这不仅仅是关于漂亮的名称和图片：这是为您的代币在整个 Solana 生态系统中的展示方式奠定基础。","position":{"start":{"line":19,"column":1,"offset":644},"end":{"line":19,"column":50,"offset":693}}}],"position":{"start":{"line":19,"column":1,"offset":644},"end":{"line":19,"column":50,"offset":693}}},{"type":"paragraph","children":[{"type":"text","value":"通过 Solana 的程序派生地址系统，每个代币都会获得一个与其铸币地址数学关联的元数据账户。这在技术代币和描述性信息之间创建了不可分割的联系，确保了所有应用程序中的一致性，并防止身份冲突：","position":{"start":{"line":21,"column":1,"offset":697},"end":{"line":21,"column":96,"offset":792}}}],"position":{"start":{"line":21,"column":1,"offset":697},"end":{"line":21,"column":96,"offset":792}}},{"type":"code","lang":"rust","meta":null,"value":"const ID: Pubkey = solana_pubkey::pubkey!(\"metaqbxxUerdq28cj1RbAWkYQm3ybzjb6a8bt518x1s\");\r\n\r\nconst PREFIX: &str = \"metadata\";\r\n\r\nlet (metadata, _) = Pubkey::find_program_address(\r\n    &[\r\n        PREFIX.as_bytes(), \r\n        &ID, \r\n        mint.as_ref()\r\n    ], \r\n    &ID  \r\n);","position":{"start":{"line":23,"column":1,"offset":796},"end":{"line":36,"column":4,"offset":1087}},"data":{"highlightId":"code-0"}},{"type":"paragraph","children":[{"type":"text","value":"元数据账户成为您的代币的通用护照，包含应用程序正确显示您的资产所需的一切信息。","position":{"start":{"line":38,"column":1,"offset":1091},"end":{"line":38,"column":40,"offset":1130}}}],"position":{"start":{"line":38,"column":1,"offset":1091},"end":{"line":38,"column":40,"offset":1130}}},{"type":"paragraph","children":[{"type":"text","value":"代币名称取代了难以理解的地址，符号提供了即时识别（想想“SOL”而不是上面那串长长的字符），URI引用指向丰富的媒体内容，如标志和详细描述。","position":{"start":{"line":40,"column":1,"offset":1134},"end":{"line":40,"column":71,"offset":1204}}}],"position":{"start":{"line":40,"column":1,"offset":1134},"end":{"line":40,"column":71,"offset":1204}}},{"type":"paragraph","children":[{"type":"text","value":"结果是什么？您的代币不仅仅存在于区块链上——它在钱包中蓬勃发展，在区块链浏览器中以专业的方式展示，并无缝集成到Solana生态系统中的各种应用中。","position":{"start":{"line":42,"column":1,"offset":1208},"end":{"line":42,"column":74,"offset":1281}}}],"position":{"start":{"line":42,"column":1,"offset":1208},"end":{"line":42,"column":74,"offset":1281}}},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"想了解更多关于如何使用","position":{"start":{"line":44,"column":3,"offset":1287},"end":{"line":44,"column":14,"offset":1298}}},{"type":"inlineCode","value":"Token Metadata","position":{"start":{"line":44,"column":14,"offset":1298},"end":{"line":44,"column":30,"offset":1314}}},{"type":"text","value":"程序的信息，请参考","position":{"start":{"line":44,"column":30,"offset":1314},"end":{"line":44,"column":39,"offset":1323}}},{"type":"link","title":null,"url":"https://developers.metaplex.com/token-metadata","children":[{"type":"text","value":"官方文档","position":{"start":{"line":44,"column":40,"offset":1324},"end":{"line":44,"column":44,"offset":1328}}}],"position":{"start":{"line":44,"column":39,"offset":1323},"end":{"line":44,"column":93,"offset":1377}}}],"position":{"start":{"line":44,"column":3,"offset":1287},"end":{"line":44,"column":93,"offset":1377}}}],"position":{"start":{"line":44,"column":1,"offset":1285},"end":{"line":44,"column":93,"offset":1377}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":44,"column":93,"offset":1377}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Metaplex 代币元数据程序\r\n\r\n想象一下，在 Solana 上发行一个代币，但它在每个钱包中都显示为一串毫无意义的字符，例如 \"7xKXtg2CW87d97TXJSDpbD5jBkheTqA83TZRuJosgAsU\"。\r\n\r\n用户根本不知道他们持有的是什么，而您精心设计的项目将与网络上成千上万个其他匿名代币毫无区别。\r\n\r\nMetaplex 代币元数据程序通过将匿名的区块链条目转变为品牌化、可识别的数字资产，解决了这一关键问题。\r\n\r\n虽然 SPL-Token 程序在技术机制方面表现出色——跟踪所有权、管理供应和促进转账，但它将代币仅仅作为没有任何可读上下文的基础数据结构。\r\n\r\n这正是 Metaplex 发挥其魔力的地方，它弥合了原始区块链功能与用户体验之间的差距。用户不再看到神秘的地址，而是看到 \"Solana (SOL)\"，配有熟悉的标志、清晰的描述以及所有使代币在现实世界中真正可用的上下文信息。\r\n\r\n<ArticleSection name=\"Metadata Account\" id=\"metadata-account\" level=\"h2\" />\r\n\r\n`Metadata` 账户充当您的代币的数字身份证，存储所有信息，将一个简单的铸币地址转变为可识别的资产。\r\n\r\n这不仅仅是关于漂亮的名称和图片：这是为您的代币在整个 Solana 生态系统中的展示方式奠定基础。\r\n\r\n通过 Solana 的程序派生地址系统，每个代币都会获得一个与其铸币地址数学关联的元数据账户。这在技术代币和描述性信息之间创建了不可分割的联系，确保了所有应用程序中的一致性，并防止身份冲突：\r\n\r\n```rust\r\nconst ID: Pubkey = solana_pubkey::pubkey!(\"metaqbxxUerdq28cj1RbAWkYQm3ybzjb6a8bt518x1s\");\r\n\r\nconst PREFIX: &str = \"metadata\";\r\n\r\nlet (metadata, _) = Pubkey::find_program_address(\r\n    &[\r\n        PREFIX.as_bytes(), \r\n        &ID, \r\n        mint.as_ref()\r\n    ], \r\n    &ID  \r\n);\r\n```\r\n\r\n元数据账户成为您的代币的通用护照，包含应用程序正确显示您的资产所需的一切信息。\r\n\r\n代币名称取代了难以理解的地址，符号提供了即时识别（想想“SOL”而不是上面那串长长的字符），URI引用指向丰富的媒体内容，如标志和详细描述。\r\n\r\n结果是什么？您的代币不仅仅存在于区块链上——它在钱包中蓬勃发展，在区块链浏览器中以专业的方式展示，并无缝集成到Solana生态系统中的各种应用中。\r\n\r\n> 想了解更多关于如何使用`Token Metadata`程序的信息，请参考[官方文档](https://developers.metaplex.com/token-metadata)","highlightedCode":{"code-0":{"lang":"rust","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"const"}]},{"type":"element","tagName":"span","properties":{"style":"color:#BF9EEE"},"children":[{"type":"text","value":" ID"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":":"}]},{"type":"element","tagName":"span","properties":{"style":"color:#97E1F1;font-style:italic"},"children":[{"type":"text","value":" Pubkey"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":" ="}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" solana_pubkey"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"::"}]},{"type":"element","tagName":"span","properties":{"style":"color:#62E884"},"children":[{"type":"text","value":"pubkey!"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"("}]},{"type":"element","tagName":"span","properties":{"style":"color:#E7EE98"},"children":[{"type":"text","value":"\"metaqbxxUerdq28cj1RbAWkYQm3ybzjb6a8bt518x1s\""}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":");"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"const"}]},{"type":"element","tagName":"span","properties":{"style":"color:#BF9EEE"},"children":[{"type":"text","value":" PREFIX"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":":"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":" &"}]},{"type":"element","tagName":"span","properties":{"style":"color:#97E1F1;font-style:italic"},"children":[{"type":"text","value":"str"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":" ="}]},{"type":"element","tagName":"span","properties":{"style":"color:#E