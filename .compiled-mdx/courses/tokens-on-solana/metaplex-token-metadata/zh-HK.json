,"column":1,"offset":537},"end":{"line":15,"column":76,"offset":612}}},{"type":"paragraph","children":[{"type":"inlineCode","value":"Metadata","position":{"start":{"line":17,"column":1,"offset":616},"end":{"line":17,"column":11,"offset":626}}},{"type":"text","value":" 帳戶就像是您的代幣的數字身份證，存儲所有將簡單的鑄幣地址轉化為可識別資產的信息。","position":{"start":{"line":17,"column":11,"offset":626},"end":{"line":17,"column":52,"offset":667}}}],"position":{"start":{"line":17,"column":1,"offset":616},"end":{"line":17,"column":52,"offset":667}}},{"type":"paragraph","children":[{"type":"text","value":"這不僅僅是關於漂亮的名稱和圖片：這是為您的代幣在整個 Solana 生態系統中的展示方式奠定基礎。","position":{"start":{"line":19,"column":1,"offset":671},"end":{"line":19,"column":50,"offset":720}}}],"position":{"start":{"line":19,"column":1,"offset":671},"end":{"line":19,"column":50,"offset":720}}},{"type":"paragraph","children":[{"type":"text","value":"使用 Solana 的程式衍生地址系統，每個代幣都會獲得一個與其鑄幣數學鏈接的唯一 metadata 帳戶。這在技術代幣與其描述信息之間創造了一個不可分割的聯繫，確保所有應用程序中的一致性並防止身份衝突：","position":{"start":{"line":21,"column":1,"offset":724},"end":{"line":21,"column":103,"offset":826}}}],"position":{"start":{"line":21,"column":1,"offset":724},"end":{"line":21,"column":103,"offset":826}}},{"type":"code","lang":"rust","meta":null,"value":"const ID: Pubkey = solana_pubkey::pubkey!(\"metaqbxxUerdq28cj1RbAWkYQm3ybzjb6a8bt518x1s\");\r\n\r\nconst PREFIX: &str = \"metadata\";\r\n\r\nlet (metadata, _) = Pubkey::find_program_address(\r\n    &[\r\n        PREFIX.as_bytes(), \r\n        &ID, \r\n        mint.as_ref()\r\n    ], \r\n    &ID  \r\n);","position":{"start":{"line":23,"column":1,"offset":830},"end":{"line":36,"column":4,"offset":1121}},"data":{"highlightId":"code-0"}},{"type":"paragraph","children":[{"type":"text","value":"metadata 帳戶成為您的代幣的通用護照，包含應用程序正確顯示您的資產所需的一切。","position":{"start":{"line":38,"column":1,"offset":1125},"end":{"line":38,"column":44,"offset":1168}}}],"position":{"start":{"line":38,"column":1,"offset":1125},"end":{"line":38,"column":44,"offset":1168}}},{"type":"paragraph","children":[{"type":"text","value":"代幣名稱取代了難以理解的地址，符號提供了即時識別（想想「SOL」而不是上面那串長長的字符），而 URI 引用則指向豐富的媒體，例如標誌和詳細描述。","position":{"start":{"line":40,"column":1,"offset":1172},"end":{"line":40,"column":74,"offset":1245}}}],"position":{"start":{"line":40,"column":1,"offset":1172},"end":{"line":40,"column":74,"offset":1245}}},{"type":"paragraph","children":[{"type":"text","value":"結果是什麼？您的代幣不僅僅存在於區塊鏈上——它在錢包中蓬勃發展，在區塊瀏覽器中專業呈現，並無縫整合到 Solana 生態系統中的應用程式中。","position":{"start":{"line":42,"column":1,"offset":1249},"end":{"line":42,"column":71,"offset":1319}}}],"position":{"start":{"line":42,"column":1,"offset":1249},"end":{"line":42,"column":71,"offset":1319}}},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"想了解更多有關如何使用","position":{"start":{"line":44,"column":3,"offset":1325},"end":{"line":44,"column":14,"offset":1336}}},{"type":"inlineCode","value":"Token Metadata","position":{"start":{"line":44,"column":14,"offset":1336},"end":{"line":44,"column":30,"offset":1352}}},{"type":"text","value":"程式的資訊，請參考","position":{"start":{"line":44,"column":30,"offset":1352},"end":{"line":44,"column":39,"offset":1361}}},{"type":"link","title":null,"url":"https://developers.metaplex.com/token-metadata","children":[{"type":"text","value":"官方文件","position":{"start":{"line":44,"column":40,"offset":1362},"end":{"line":44,"column":44,"offset":1366}}}],"position":{"start":{"line":44,"column":39,"offset":1361},"end":{"line":44,"column":93,"offset":1415}}}],"position":{"start":{"line":44,"column":3,"offset":1325},"end":{"line":44,"column":93,"offset":1415}}}],"position":{"start":{"line":44,"column":1,"offset":1323},"end":{"line":44,"column":93,"offset":1415}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":44,"column":93,"offset":1415}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Metaplex Token Metadata Program\r\n\r\n想像一下，在 Solana 上發行一個代幣，但它在每個錢包中都顯示為一串毫無意義的字符，例如「7xKXtg2CW87d97TXJSDpbD5jBkheTqA83TZRuJosgAsU」。\r\n\r\n用戶完全不知道他們持有的是什麼，而您精心設計的項目將無法與網絡上數以千計的其他匿名代幣區分開來。\r\n\r\nMetaplex Token Metadata Program 解決了這個關鍵問題，將匿名的區塊鏈條目轉化為有品牌、可識別的數字資產。\r\n\r\n雖然 SPL-Token 程式在技術機制方面表現出色——追蹤所有權、管理供應和促進轉移——但它將代幣留作沒有任何人類可讀上下文的簡單數據結構。\r\n\r\n這正是 Metaplex 發揮其魔力的地方，彌合了原始區塊鏈功能與用戶體驗之間的差距。用戶不再看到神秘的地址，而是看到「Solana (SOL)」，配有熟悉的標誌、清晰的描述以及所有使代幣在現實世界中真正可用的上下文信息。\r\n\r\n<ArticleSection name=\"Metadata Account\" id=\"metadata-account\" level=\"h2\" />\r\n\r\n`Metadata` 帳戶就像是您的代幣的數字身份證，存儲所有將簡單的鑄幣地址轉化為可識別資產的信息。\r\n\r\n這不僅僅是關於漂亮的名稱和圖片：這是為您的代幣在整個 Solana 生態系統中的展示方式奠定基礎。\r\n\r\n使用 Solana 的程式衍生地址系統，每個代幣都會獲得一個與其鑄幣數學鏈接的唯一 metadata 帳戶。這在技術代幣與其描述信息之間創造了一個不可分割的聯繫，確保所有應用程序中的一致性並防止身份衝突：\r\n\r\n```rust\r\nconst ID: Pubkey = solana_pubkey::pubkey!(\"metaqbxxUerdq28cj1RbAWkYQm3ybzjb6a8bt518x1s\");\r\n\r\nconst PREFIX: &str = \"metadata\";\r\n\r\nlet (metadata, _) = Pubkey::find_program_address(\r\n    &[\r\n        PREFIX.as_bytes(), \r\n        &ID, \r\n        mint.as_ref()\r\n    ], \r\n    &ID  \r\n);\r\n```\r\n\r\nmetadata 帳戶成為您的代幣的通用護照，包含應用程序正確顯示您的資產所需的一切。\r\n\r\n代幣名稱取代了難以理解的地址，符號提供了即時識別（想想「SOL」而不是上面那串長長的字符），而 URI 引用則指向豐富的媒體，例如標誌和詳細描述。\r\n\r\n結果是什麼？您的代幣不僅僅存在於區塊鏈上——它在錢包中蓬勃發展，在區塊瀏覽器中專業呈現，並無縫整合到 Solana 生態系統中的應用程式中。\r\n\r\n> 想了解更多有關如何使用`Token Metadata`程式的資訊，請參考[官方文件](https://developers.metaplex.com/token-metadata)","highlightedCode":{"code-0":{"lang":"rust","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"const"}]},{"type":"element","tagName":"span","properties":{"style":"color:#BF9EEE"},"children":[{"type":"text","value":" ID"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"ch