mn":1,"offset":4000},"end":{"line":65,"column":67,"offset":4066}}}],"position":{"start":{"line":63,"column":1,"offset":3872},"end":{"line":65,"column":67,"offset":4066}}},{"type":"paragraph","children":[{"type":"text","value":"Ось як ці дані виглядають в мережі:","position":{"start":{"line":67,"column":1,"offset":4070},"end":{"line":67,"column":36,"offset":4105}}}],"position":{"start":{"line":67,"column":1,"offset":4070},"end":{"line":67,"column":36,"offset":4105}}},{"type":"code","lang":"rust","meta":null,"value":"pub struct Account {\r\n    /// The mint associated with this account\r\n    pub mint: Pubkey,\r\n    /// The owner of this account.\r\n    pub owner: Pubkey,\r\n    /// The amount of tokens this account holds.\r\n    pub amount: u64,\r\n    /// If `delegate` is `Some` then `delegated_amount` represents\r\n    /// the amount authorized by the delegate\r\n    pub delegate: COption<Pubkey>,\r\n    /// The account's state\r\n    pub state: AccountState,\r\n    /// If is_native.is_some, this is a native token, and the value logs the\r\n    /// rent-exempt reserve. An Account is required to be rent-exempt, so\r\n    /// the value is used by the Processor to ensure that wrapped SOL\r\n    /// accounts do not drop below this threshold.\r\n    pub is_native: COption<u64>,\r\n    /// The amount delegated\r\n    pub delegated_amount: u64,\r\n    /// Optional authority to close the account.\r\n    pub close_authority: COption<Pubkey>,\r\n}","position":{"start":{"line":69,"column":1,"offset":4109},"end":{"line":92,"column":4,"offset":5023}},"data":{"highlightId":"code-1"}},{"type":"paragraph","children":[{"type":"text","value":"Кожен гаманець повинен мати рахунок токена для кожного токена (монети), який він хоче зберігати, з адресою гаманця, встановленою як власник рахунку токена. Кожен гаманець може володіти кількома рахунками токенів для одного й того ж токена (монети), але рахунок токена може мати лише одного власника і зберігати одиниці лише одного токена (монети).","position":{"start":{"line":94,"column":1,"offset":5027},"end":{"line":94,"column":348,"offset":5374}}}],"position":{"start":{"line":94,"column":1,"offset":5027},"end":{"line":94,"column":348,"offset":5374}}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Асоційований токен-рахунок","position":{"start":{"line":96,"column":17,"offset":5394},"end":{"line":96,"column":50,"offset":5427}}},{"type":"mdxJsxAttribute","name":"id","value":"the-associated-token-account","position":{"start":{"line":96,"column":51,"offset":5428},"end":{"line":96,"column":84,"offset":5461}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":96,"column":85,"offset":5462},"end":{"line":96,"column":95,"offset":5472}}}],"children":[],"position":{"start":{"line":96,"column":1,"offset":5378},"end":{"line":96,"column":98,"offset":5475}}},{"type":"paragraph","children":[{"type":"text","value":"Асоційовані токен-рахунки спрощують процес пошуку адреси токен-рахунку для конкретного мінту та власника. Розглядайте Асоційований токен-рахунок як \"стандартний\" токен-рахунок для певного мінту та власника.","position":{"start":{"line":98,"column":1,"offset":5479},"end":{"line":98,"column":207,"offset":5685}}}],"position":{"start":{"line":98,"column":1,"offset":5479},"end":{"line":98,"column":207,"offset":5685}}},{"type":"paragraph","children":[{"type":"text","value":"Асоційований токен-рахунок створюється з адресою, яка походить від адреси власника та адреси мінт-рахунку. Важливо розуміти, що Асоційований токен-рахунок — це просто токен-рахунок з певною адресою.","position":{"start":{"line":100,"column":1,"offset":5689},"end":{"line":100,"column":199,"offset":5887}}}],"position":{"start":{"line":100,"column":1,"offset":5689},"end":{"line":100,"column":199,"offset":5887}}},{"type":"paragraph","children":[{"type":"text","value":"Це вводить ключову концепцію в розробці на Solana: ","position":{"start":{"line":102,"column":1,"offset":5891},"end":{"line":102,"column":52,"offset":5942}}},{"type":"link","title":null,"url":"https://solana.com/docs/core/pda","children":[{"type":"text","value":"Адреса, похідна від програми","position":{"start":{"line":102,"column":53,"offset":5943},"end":{"line":102,"column":81,"offset":5971}}}],"position":{"start":{"line":102,"column":52,"offset":5942},"end":{"line":102,"column":116,"offset":6006}}},{"type":"text","value":" (PDA). PDA детерміновано виводить адресу, використовуючи заздалегідь визначені вхідні дані, що полегшує пошук адреси рахунку.","position":{"start":{"line":102,"column":116,"offset":6006},"end":{"line":102,"column":242,"offset":6132}}}],"position":{"start":{"line":102,"column":1,"offset":5891},"end":{"line":102,"column":242,"offset":6132}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":102,"column":242,"offset":6132}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Mint та токен-рахунки\r\n\r\nЯк ми зазначали в попередньому розділі, основними будівельними блоками програми `SPL Token` є рахунки: mint-рахунки, які містять усю інформацію про токени, та токен-рахунки, які містять усю інформацію про володіння цими конкретними токенами.\r\n\r\nДля кожного унікального mint існують тисячі різних токен-рахунків, які представляють кількість власників цього токена в реєстрі.\r\n\r\nУ цьому розділі ми детальніше розглянемо ці різні типи рахунків:\r\n\r\n<ArticleSection name=\"Mint-рахунок\" id=\"the-mint-account\" level=\"h2\" />\r\n\r\nТокени в Solana унікально ідентифікуються за адресою Mint-рахунку, яким володіє Token Program. Цей рахунок діє як глобальний лічильник для конкретного токена і зберігає такі дані:\r\n- Supply: Загальна пропозиція токена\r\n- Decimals: Десяткова точність токена\r\n- Mint authority: Рахунок, уповноважений створювати нові одиниці токена, збільшуючи пропозицію\r\n- Freeze authority: Рахунок, уповноважений заморожувати токени в токен-рахунку, запобігаючи їх передачі або спаленню\r\n\r\nОсь як ці дані виглядають у блокчейні:\r\n\r\n```rust\r\npub struct Mint {\r\n    /// Optional authority used to mint new tokens. The mint authority may only\r\n    /// be provided during mint creation. If no mint authority is present\r\n    /// then the mint has a fixed supply and no further tokens may be\r\n    /// minted.\r\n    pub mint_authority: COption<Pubkey>,\r\n    /// Total supply of tokens.\r\n    pub supply: u64,\r\n    /// Number of base 10 digits to the right of the decimal place.\r\n    pub decimals: u8,\r\n    /// Is `true` if this structure has been initialized\r\n    pub is_initialized: bool,\r\n    /// Optional authority to freeze token accounts.\r\n    pub freeze_authority: COption<Pubkey>,\r\n}\r\n```\r\n\r\n### Метадані\r\n\r\nВ оглядачах блокчейну та гаманцях токени зазвичай відображаються у впізнаваному та зрозумілому для людини вигляді завдяки конкретній назві та зображенню, пов'язаним з ними.\r\n\r\nМи називаємо цю назву, символ та зображення `Metadata` токена. Адже у своїй нативній формі рахунок `Mint` — це просто публічний ключ довжиною 32 байти без прикріпленої інформації, зрозумілої для людини.\r\n\r\nУ нативному вигляді, в оригінальній програмі SPL Token, неможливо встановити метадані безпосередньо на токені. З цієї причини протоколи, такі як [Metaplex](https://www.metaplex.com/), розробили програму [MPL-token-metadata](https://github.com/metaplex-foundation/mpl-token-metadata), щоб запропонувати спосіб, за допомогою якого кожен токен може мати пов'язані метадані.\r\n\r\n> З Розширеннями Токенів та [програмою Token2022](/uk/courses/token-2022-program) це повністю змінюється. Розширення Метаданих дозволяє вбудовувати метадані безпосередньо в рахунок монети, усуваючи потребу в зовнішніх програмах.\r\n\r\n### Невзаємозамінні токени\r\n\r\nХоча корисність токенів спеціально делегується творцю, який може вирішити зробити цей конкретний токен токеном управління, утилітарним токеном або токеном спільноти, існують певні характеристики, за якими ми можемо розрізняти взаємозамінні та невзаємозамінні токени:\r\n\r\nНевзаємозамінні токени повинні мати:\r\n- Запас 1, оскільки вони унікальні\r\n- 0 десяткових знаків, оскільки вони неподільні\r\n- Відсутність повноважень на карбування, оскільки ми не хочемо додавати більше токенів з такою ж характеристикою, оскільки це \"знищило\" б унікальність токена\r\n\r\nНативно неможливо забезпечити ці характеристики в програмі Token. З цієї причини програми, такі як `MPL-token-metadata` не лише пропонують реалізацію для метаданих, але й пропонують реалізацію для забезпечення цих обмежень і легкого створення NFT.\r\n\r\n<ArticleSection name=\"Рахунок токена\" id=\"the-token-account\" level=\"h2\" />\r\n\r\nПрограма Token створює Рахунки Токенів для відстеження індивідуального володіння кожною одиницею токена. Рахунок Токена зберігає такі дані як:\r\n- Монета: Токен, одиниці якого зберігає Рахунок Токена\r\n- Власник: Рахунок, уповноважений переказувати токени з Рахунку Токена\r\n- Кількість: Кількість токенів, які Рахунок Токена наразі зберігає\r\n\r\nОсь як ці дані виглядають в мережі:\r\n\r\n```rust\r\npub struct Account {\r\n    /// The mint associated with this account\r\n    pub mint: Pubkey,\r\n    /// The owner of this account.\r\n    pub owner: Pubkey,\r\n    /// The amount of tokens this account holds.\r\n    pub amount: u64,\r\n    /// If `delegate` is `Some` then `delegated_amount` represents\r\n    /// the amount authorized by the delegate\r\n    pub delegate: COption<Pubkey>,\r\n    /// The account's state\r\n    pub state: AccountState,\r\n    /// If is_native.is_some, this is a native token, and the value logs the\r\n    /// rent-exempt reserve. An Account is required to be rent-exempt, so\r\n    /// the value is used by the Processor to ensure that wrapped SOL\r\n    /// accounts do not drop below this threshold.\r\n    pub is_native: COption<u64>,\r\n    /// The amount delegated\r\n    pub delegated_amount: u64,\r\n    /// Optional authority to close the account.\r\n    pub close_authority: COption<Pubkey>,\r\n}\r\n```\r\n\r\nКожен гаманець повинен мати рахунок токена для кожного токена (монети), який він хоче зберігати, з адресою гаманця, встановленою як власник рахунку токена. Кожен гаманець може володіти кількома рахунками токенів для одного й того ж токена (монети), але рахунок токена може мати лише одного власника і зберігати одиниці лише одного токена (монети).\r\n\r\n<ArticleSection name=\"Асоційований токен-рахунок\" id=\"the-associated-token-account\" level=\"h2\" />\r\n\r\nАсоційовані токен-рахунки спрощують процес пошуку адреси токен-рахунку для конкретного мінту та власника. Розглядайте Асоційований токен-рахунок як \"стандартний\" токен-рахунок для певного мінту та власника.\r\n\r\nАсоційований токен-рахунок створюється з адресою, яка походить від адреси власника та адреси мінт-рахунку. Важливо розуміти, що Асоційований токен-рахунок — це просто токен-рахунок з певною адресою.\r\n\r\nЦе вводить ключову концепцію в розробці на Solana: [Адреса, похідна від програми](https://solana.com/docs/core/pda) (PDA). PDA детерміновано виводить адресу, використовуючи заздалегідь визначені вхідні дані, що полегшує пошук адреси рахунку.","highlightedCode":{"code-0":{"lang":"rust","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"pub"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":" struct"}]},{"type":"element","tagName":"span","properties":{"style":"color:#97E1F1;font-style:italic"},"children":[{"type":"text","value":" Mint"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" {"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#7B7F8B"},"children":[{"type":"text","value":"    /// Optional authority used to mint new tokens. The mint authority may only"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#7B7F8B"},"children":[{"type":"text","value":"    /// be provided during mint creation. If no mint authority is present"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#7B7F8B"},"children":[{"type":"text","value":"    /// then the mint has a fixed supply and no further tokens may be"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#7B7F8B"},"children":[{"type":"text","value":"    /// minted."}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"    pub"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" mint_authority"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":":"}]},{"type":"element","tagName":"span","properties":{"style":"color:#97E1F1;font-style:italic"},"children":[{"type":"text","value":" COption"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"<"}]},{"type":"element