"line":60,"column":68,"offset":3759}}}],"children":[],"position":{"start":{"line":60,"column":1,"offset":3692},"end":{"line":60,"column":71,"offset":3762}}},{"type":"paragraph","children":[{"type":"text","value":"Program Token membuat Akun Token untuk melacak kepemilikan individual dari setiap unit token. Akun Token menyimpan data seperti:","position":{"start":{"line":62,"column":1,"offset":3766},"end":{"line":62,"column":129,"offset":3894}}}],"position":{"start":{"line":62,"column":1,"offset":3766},"end":{"line":62,"column":129,"offset":3894}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Mint: Token yang unit-unitnya disimpan oleh Akun Token","position":{"start":{"line":63,"column":3,"offset":3898},"end":{"line":63,"column":57,"offset":3952}}}],"position":{"start":{"line":63,"column":3,"offset":3898},"end":{"line":63,"column":57,"offset":3952}}}],"position":{"start":{"line":63,"column":1,"offset":3896},"end":{"line":63,"column":57,"offset":3952}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Pemilik: Akun yang berwenang untuk mentransfer token dari Akun Token","position":{"start":{"line":64,"column":3,"offset":3956},"end":{"line":64,"column":71,"offset":4024}}}],"position":{"start":{"line":64,"column":3,"offset":3956},"end":{"line":64,"column":71,"offset":4024}}}],"position":{"start":{"line":64,"column":1,"offset":3954},"end":{"line":64,"column":71,"offset":4024}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Jumlah: Jumlah token yang saat ini disimpan oleh Akun Token","position":{"start":{"line":65,"column":3,"offset":4028},"end":{"line":65,"column":62,"offset":4087}}}],"position":{"start":{"line":65,"column":3,"offset":4028},"end":{"line":65,"column":62,"offset":4087}}}],"position":{"start":{"line":65,"column":1,"offset":4026},"end":{"line":65,"column":62,"offset":4087}}}],"position":{"start":{"line":63,"column":1,"offset":3896},"end":{"line":65,"column":62,"offset":4087}}},{"type":"paragraph","children":[{"type":"text","value":"Beginilah tampilan data tersebut di blockchain:","position":{"start":{"line":67,"column":1,"offset":4091},"end":{"line":67,"column":48,"offset":4138}}}],"position":{"start":{"line":67,"column":1,"offset":4091},"end":{"line":67,"column":48,"offset":4138}}},{"type":"code","lang":"rust","meta":null,"value":"pub struct Account {\r\n    /// The mint associated with this account\r\n    pub mint: Pubkey,\r\n    /// The owner of this account.\r\n    pub owner: Pubkey,\r\n    /// The amount of tokens this account holds.\r\n    pub amount: u64,\r\n    /// If `delegate` is `Some` then `delegated_amount` represents\r\n    /// the amount authorized by the delegate\r\n    pub delegate: COption<Pubkey>,\r\n    /// The account's state\r\n    pub state: AccountState,\r\n    /// If is_native.is_some, this is a native token, and the value logs the\r\n    /// rent-exempt reserve. An Account is required to be rent-exempt, so\r\n    /// the value is used by the Processor to ensure that wrapped SOL\r\n    /// accounts do not drop below this threshold.\r\n    pub is_native: COption<u64>,\r\n    /// The amount delegated\r\n    pub delegated_amount: u64,\r\n    /// Optional authority to close the account.\r\n    pub close_authority: COption<Pubkey>,\r\n}","position":{"start":{"line":69,"column":1,"offset":4142},"end":{"line":92,"column":4,"offset":5056}},"data":{"highlightId":"code-1"}},{"type":"paragraph","children":[{"type":"text","value":"Setiap dompet perlu memiliki akun token untuk setiap token (mint) yang ingin disimpannya, dengan alamat dompet ditetapkan sebagai pemilik akun token. Setiap dompet dapat memiliki beberapa akun token untuk token (mint) yang sama, tetapi akun token hanya dapat memiliki satu pemilik dan menyimpan unit dari satu token (mint).","position":{"start":{"line":94,"column":1,"offset":5060},"end":{"line":94,"column":324,"offset":5383}}}],"position":{"start":{"line":94,"column":1,"offset":5060},"end":{"line":94,"column":324,"offset":5383}}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Akun Token Terkait","position":{"start":{"line":96,"column":17,"offset":5403},"end":{"line":96,"column":42,"offset":5428}}},{"type":"mdxJsxAttribute","name":"id","value":"the-associated-token-account","position":{"start":{"line":96,"column":43,"offset":5429},"end":{"line":96,"column":76,"offset":5462}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":96,"column":77,"offset":5463},"end":{"line":96,"column":87,"offset":5473}}}],"children":[],"position":{"start":{"line":96,"column":1,"offset":5387},"end":{"line":96,"column":90,"offset":5476}}},{"type":"paragraph","children":[{"type":"text","value":"Akun Token Terkait menyederhanakan proses pencarian alamat akun token untuk mint dan pemilik tertentu. Anggap Akun Token Terkait sebagai akun token \"default\" untuk mint dan pemilik tertentu.","position":{"start":{"line":98,"column":1,"offset":5480},"end":{"line":98,"column":191,"offset":5670}}}],"position":{"start":{"line":98,"column":1,"offset":5480},"end":{"line":98,"column":191,"offset":5670}}},{"type":"paragraph","children":[{"type":"text","value":"Akun Token Terkait dibuat dengan alamat yang diturunkan dari alamat pemilik dan alamat akun mint. Penting untuk dipahami bahwa Akun Token Terkait hanyalah akun token dengan alamat tertentu.","position":{"start":{"line":100,"column":1,"offset":5674},"end":{"line":100,"column":190,"offset":5863}}}],"position":{"start":{"line":100,"column":1,"offset":5674},"end":{"line":100,"column":190,"offset":5863}}},{"type":"paragraph","children":[{"type":"text","value":"Ini memperkenalkan konsep kunci dalam pengembangan Solana: ","position":{"start":{"line":102,"column":1,"offset":5867},"end":{"line":102,"column":60,"offset":5926}}},{"type":"link","title":null,"url":"https://solana.com/docs/core/pda","children":[{"type":"text","value":"Program Derived Address","position":{"start":{"line":102,"column":61,"offset":5927},"end":{"line":102,"column":84,"offset":5950}}}],"position":{"start":{"line":102,"column":60,"offset":5926},"end":{"line":102,"column":119,"offset":5985}}},{"type":"text","value":" (PDA). PDA menurunkan alamat secara deterministik menggunakan input yang telah ditentukan, sehingga memudahkan pencarian alamat sebuah akun.","position":{"start":{"line":102,"column":119,"offset":5985},"end":{"line":102,"column":260,"offset":6126}}}],"position":{"start":{"line":102,"column":1,"offset":5867},"end":{"line":102,"column":260,"offset":6126}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":102,"column":260,"offset":6126}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Akun Mint dan Token\r\n\r\nSeperti yang telah kami sebutkan di bagian sebelumnya, blok pembangun program `SPL Token` adalah akun: akun mint yang mewakili semua informasi tentang token dan akun token yang mewakili semua informasi tentang kepemilikan token tersebut.\r\n\r\nUntuk setiap mint yang unik, terdapat ribuan akun token berbeda yang mewakili berapa banyak pemegang token tersebut dalam buku besar.\r\n\r\nPada bagian ini kita akan membahas lebih dalam tentang akun-akun yang berbeda ini:\r\n\r\n<ArticleSection name=\"Akun Mint\" id=\"the-mint-account\" level=\"h2\" />\r\n\r\nToken di Solana diidentifikasi secara unik oleh alamat Akun Mint yang dimiliki oleh Program Token. Akun ini bertindak sebagai penghitung global untuk token tertentu dan menyimpan data seperti:\r\n- Supply: Total pasokan token\r\n- Decimals: Presisi desimal token\r\n- Mint authority: Akun yang berwenang untuk membuat unit baru token, meningkatkan pasokan\r\n- Freeze authority: Akun yang berwenang untuk membekukan token dalam Akun Token, mencegahnya ditransfer atau dibakar\r\n\r\nBeginilah tampilan data tersebut di blockchain:\r\n\r\n```rust\r\npub struct Mint {\r\n    /// Optional authority used to mint new tokens. The mint authority may only\r\n    /// be provided during mint creation. If no mint authority is present\r\n    /// then the mint has a fixed supply and no further tokens may be\r\n    /// minted.\r\n    pub mint_authority: COption<Pubkey>,\r\n    /// Total supply of tokens.\r\n    pub supply: u64,\r\n    /// Number of base 10 digits to the right of the decimal place.\r\n    pub decimals: u8,\r\n    /// Is `true` if this structure has been initialized\r\n    pub is_initialized: bool,\r\n    /// Optional authority to freeze token accounts.\r\n    pub freeze_authority: COption<Pubkey>,\r\n}\r\n```\r\n\r\n### Metadata\r\n\r\nDi explorer dan dompet, token biasanya muncul dengan nama dan gambar yang dapat dikenali dan mudah dibaca oleh manusia.\r\n\r\nKita menyebut nama, simbol, dan gambar tersebut sebagai `Metadata` dari token. Karena dalam bentuk aslinya, akun `Mint` hanyalah kunci publik sepanjang 32 byte tanpa informasi yang dapat dibaca manusia.\r\n\r\nSecara alami, dalam program SPL Token asli, tidak mungkin untuk menetapkan metadata langsung pada token. Karena alasan ini, protokol seperti [Metaplex](https://www.metaplex.com/) mengembangkan program [MPL-token-metadata](https://github.com/metaplex-foundation/mpl-token-metadata) untuk menawarkan cara agar setiap token memiliki metadata terkait.\r\n\r\n> Dengan Token Extensions dan [program Token2022](/id/courses/token-2022-program), ini berubah sepenuhnya. Ekstensi Metadata memungkinkan Anda untuk menyematkan metadata langsung ke dalam akun mint itu sendiri, menghilangkan kebutuhan untuk program eksternal.\r\n\r\n### Token Non-fungible\r\n\r\nSementara utilitas token secara khusus didelegasikan kepada pembuat, yang dapat memutuskan untuk menjadikan token tersebut sebagai token tata kelola, token utilitas, atau token komunitas, ada beberapa karakteristik yang dapat kita ikuti untuk membedakan antara token fungible dan non-fungible:\r\n\r\nToken non-fungible harus memiliki:\r\n- Pasokan sebanyak 1 karena mereka unik\r\n- 0 desimal karena mereka tidak dapat dibagi\r\n- Tidak ada otoritas mint karena kita tidak ingin menambahkan lebih banyak token dengan karakteristik yang sama, karena akan \"menghancurkan\" keunikan token tersebut\r\n\r\nSecara alami tidak mungkin untuk memaksakan karakteristik ini dalam program Token. Karena alasan ini, program seperti `MPL-token-metadata` tidak hanya menawarkan implementasi untuk metadata tetapi juga menawarkan implementasi untuk memaksakan batasan ini dan dengan mudah membuat NFT.\r\n\r\n<ArticleSection name=\"Akun Token\" id=\"the-token-account\" level=\"h2\" />\r\n\r\nProgram Token membuat Akun Token untuk melacak kepemilikan individual dari setiap unit token. Akun Token menyimpan data seperti:\r\n- Mint: Token yang unit-unitnya disimpan oleh Akun Token\r\n- Pemilik: Akun yang berwenang untuk mentransfer token dari Akun Token\r\n- Jumlah: Jumlah token yang saat ini disimpan oleh Akun Token\r\n\r\nBeginilah tampilan data tersebut di blockchain:\r\n\r\n```rust\r\npub struct Account {\r\n    /// The mint associated with this account\r\n    pub mint: Pubkey,\r\n    /// The owner of this account.\r\n    pub owner: Pubkey,\r\n    /// The amount of tokens this account holds.\r\n    pub amount: u64,\r\n    /// If `delegate` is `Some` then `delegated_amount` represents\r\n    /// the amount authorized by the delegate\r\n    pub delegate: COption<Pubkey>,\r\n    /// The account's state\r\n    pub state: AccountState,\r\n    /// If is_native.is_some, this is a native token, and the value logs the\r\n    /// rent-exempt reserve. An Account is required to be rent-exempt, so\r\n    /// the value is used by the Processor to ensure that wrapped SOL\r\n    /// accounts do not drop below this threshold.\r\n    pub is_native: COption<u64>,\r\n    /// The amount delegated\r\n    pub delegated_amount: u64,\r\n    /// Optional authority to close the account.\r\n    pub close_authority: COption<Pubkey>,\r\n}\r\n```\r\n\r\nSetiap dompet perlu memiliki akun token untuk setiap token (mint) yang ingin disimpannya, dengan alamat dompet ditetapkan sebagai pemilik akun token. Setiap dompet dapat memiliki beberapa akun token untuk token (mint) yang sama, tetapi akun token hanya dapat memiliki satu pemilik dan menyimpan unit dari satu token (mint).\r\n\r\n<ArticleSection name=\"Akun Token Terkait\" id=\"the-associated-token-account\" level=\"h2\" />\r\n\r\nAkun Token Terkait menyederhanakan proses pencarian alamat akun token untuk mint dan pemilik tertentu. Anggap Akun Token Terkait sebagai akun token \"default\" untuk mint dan pemilik tertentu.\r\n\r\nAkun Token Terkait dibuat dengan alamat yang diturunkan dari alamat pemilik dan alamat akun mint. Penting untuk dipahami bahwa Akun Token Terkait hanyalah akun token dengan alamat tertentu.\r\n\r\nIni memperkenalkan konsep kunci dalam pengembangan Solana: [Program Derived Address](https://solana.com/docs/core/pda) (PDA). PDA menurunkan alamat secara deterministik menggunakan input yang telah ditentukan, sehingga memudahkan pencarian alamat sebuah akun.","highlightedCode":{"code-0":{"lang":"rust","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"pub"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":" struct"}]},{"type":"element","tagName":"span","properties":{"style":"color:#97E1F1;font-style:italic"},"children":[{"type":"text","value":" Mint"}]},