ken2022 程序","position":{"start":{"line":47,"column":26,"offset":1545},"end":{"line":47,"column":38,"offset":1557}}}],"position":{"start":{"line":47,"column":25,"offset":1544},"end":{"line":47,"column":74,"offset":1593}}},{"type":"text","value":"，这一切将完全改变。Metadata 扩展允许您将元数据直接嵌入到 mint account 中，从而无需依赖外部程序。","position":{"start":{"line":47,"column":74,"offset":1593},"end":{"line":47,"column":134,"offset":1653}}}],"position":{"start":{"line":47,"column":3,"offset":1522},"end":{"line":47,"column":134,"offset":1653}}}],"position":{"start":{"line":47,"column":1,"offset":1520},"end":{"line":47,"column":134,"offset":1653}}},{"type":"heading","depth":3,"children":[{"type":"text","value":"非同质化代币","position":{"start":{"line":49,"column":5,"offset":1661},"end":{"line":49,"column":11,"offset":1667}}}],"position":{"start":{"line":49,"column":1,"offset":1657},"end":{"line":49,"column":11,"offset":1667}}},{"type":"paragraph","children":[{"type":"text","value":"虽然代币的用途由创建者具体决定，他们可以将特定代币设定为治理代币、实用代币或社区代币，但我们可以通过一些特性来区分同质化代币和非同质化代币：","position":{"start":{"line":51,"column":1,"offset":1671},"end":{"line":51,"column":71,"offset":1741}}}],"position":{"start":{"line":51,"column":1,"offset":1671},"end":{"line":51,"column":71,"offset":1741}}},{"type":"paragraph","children":[{"type":"text","value":"非同质化代币需要具备以下特性：","position":{"start":{"line":53,"column":1,"offset":1745},"end":{"line":53,"column":16,"offset":1760}}}],"position":{"start":{"line":53,"column":1,"offset":1745},"end":{"line":53,"column":16,"offset":1760}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"供应量为 1，因为它们是独一无二的","position":{"start":{"line":54,"column":3,"offset":1764},"end":{"line":54,"column":20,"offset":1781}}}],"position":{"start":{"line":54,"column":3,"offset":1764},"end":{"line":54,"column":20,"offset":1781}}}],"position":{"start":{"line":54,"column":1,"offset":1762},"end":{"line