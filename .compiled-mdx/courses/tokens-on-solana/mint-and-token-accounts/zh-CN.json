ldren":[{"type":"paragraph","children":[{"type":"text","value":"供应量：代币的总供应量","position":{"start":{"line":14,"column":3,"offset":424},"end":{"line":14,"column":14,"offset":435}}}],"position":{"start":{"line":14,"column":3,"offset":424},"end":{"line":14,"column":14,"offset":435}}}],"position":{"start":{"line":14,"column":1,"offset":422},"end":{"line":14,"column":14,"offset":435}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"小数位数：代币的小数精度","position":{"start":{"line":15,"column":3,"offset":439},"end":{"line":15,"column":15,"offset":451}}}],"position":{"start":{"line":15,"column":3,"offset":439},"end":{"line":15,"column":15,"offset":451}}}],"position":{"start":{"line":15,"column":1,"offset":437},"end":{"line":15,"column":15,"offset":451}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Mint 权限：被授权创建代币新单位、增加供应量的账户","position":{"start":{"line":16,"column":3,"offset":455},"end":{"line":16,"column":30,"offset":482}}}],"position":{"start":{"line":16,"column":3,"offset":455},"end":{"line":16,"column":30,"offset":482}}}],"position":{"start":{"line":16,"column":1,"offset":453},"end":{"line":16,"column":30,"offset":482}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"冻结权限：被授权冻结 Token 账户中代币的账户，防止其被转移或销毁","position":{"start":{"line":17,"column":3,"offset":486},"end":{"line":17,"column":38,"offset":521}}}],"position":{"start":{"line":17,"column":3,"offset":486},"end":{"line":17,"column":38,"offset":521}}}],"position":{"start":{"line":17,"column":1,"offset":484},"end":{"line":17,"column":38,"offset":521}}}],"position":{"start":{"line":14,"column":1,"offset":422},"end":{"line":17,"column":38,"offset":521}}},{"type":"paragraph","children":[{"type":"text","value":"以下是链上数据的展示方式：","position":{"start":{"line":19,"column":1,"offset":525},"end":{"line":19,"column":14,"offset":538}}}],"position":{"start":{"line":19,"column":1,"offset":525},"end":{"line":19,"column":14,"offset":538}}},{"type":"code","lang":"rust","meta":null,"value":"pub struct Mint {\r\n    /// Optional authority used to mint new tokens. The mint authority may only\r\n    /// be provided during mint creation. If no mint authority is present\r\n    /// then the mint has a fixed supply and no further tokens may be\r\n    /// minted.\r\n    pub mint_authority: COption<Pubkey>,\r\n    /// Total supply of tokens.\r\n    pub supply: u64,\r\n    /// Number of base 10 digits to the right of the decimal place.\r\n    pub decimals: u8,\r\n    /// Is `true` if this structure has been initialized\r\n    pub is_initialized: bool,\r\n    /// Optional authority to freeze token accounts.\r\n    pub freeze_authority: COption<Pubkey>,\r\n}","position":{"start":{"line":21,"column":1,"offset":542},"end":{"line":37,"column":4,"offset":1196}},"data":{"highlightId":"code-0"}},{"type":"heading","depth":3,"children":[{"type":"text","value":"元数据","position":{"start":{"line":39,"column":5,"offset":1204},"end":{"line":39,"column":8,"offset":1207}}}],"position":{"start":{"line":39,"column":1,"offset":1200},"end":{"line":39,"column":8,"offset":1207}}},{"type":"paragraph","children":[{"type":"text","value":"在区块浏览器和钱包中，代币通常通过特定的名称和图像变得可识别且易于阅读。","position":{"start":{"line":41,"column":1,"offset":1211},"end":{"line":41,"column":37,"offset":1247}}}],"position":{"start":{"line":41,"column":1,"offset":1211},"end":{"line":41,"column":37,"offset":1247}}},{"type":"paragraph","children":[{"type":"text","value":"我们将代币的名称、符号和图像称为 ","position":{"start":{"line":43,"column":1,"offset":1251},"end":{"line":43,"column":18,"offset":1268}}},{"type":"inlineCode","value":"Metadata","position":{"start":{"line":43,"column":18,"offset":1268},"end":{"line":43,"column":28,"offset":1278}}},{"type":"text","value":"。因为在其原生形式中，","position":{"start":{"line":43,"column":28,"offset":1278},"end":{"line":43,"column":39,"offset":1289}}},{"typ