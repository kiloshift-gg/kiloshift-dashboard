rch die Adresse eines Mint-Kontos identifiziert, das dem Token-Programm gehört. Dieses Konto fungiert als globaler Zähler für einen bestimmten Token und speichert Daten wie:","position":{"start":{"line":13,"column":1,"offset":708},"end":{"line":13,"column":211,"offset":918}}}],"position":{"start":{"line":13,"column":1,"offset":708},"end":{"line":13,"column":211,"offset":918}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Supply: Gesamtangebot des Tokens","position":{"start":{"line":14,"column":3,"offset":922},"end":{"line":14,"column":35,"offset":954}}}],"position":{"start":{"line":14,"column":3,"offset":922},"end":{"line":14,"column":35,"offset":954}}}],"position":{"start":{"line":14,"column":1,"offset":920},"end":{"line":14,"column":35,"offset":954}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Decimals: Dezimalpräzision des Tokens","position":{"start":{"line":15,"column":3,"offset":958},"end":{"line":15,"column":40,"offset":995}}}],"position":{"start":{"line":15,"column":3,"offset":958},"end":{"line":15,"column":40,"offset":995}}}],"position":{"start":{"line":15,"column":1,"offset":956},"end":{"line":15,"column":40,"offset":995}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Mint authority: Das Konto, das berechtigt ist, neue Einheiten des Tokens zu erstellen und damit das Angebot zu erhöhen","position":{"start":{"line":16,"column":3,"offset":999},"end":{"line":16,"column":121,"offset":1117}}}],"position":{"start":{"line":16,"column":3,"offset":999},"end":{"line":16,"column":121,"offset":1117}}}],"position":{"start":{"line":16,"column":1,"offset":997},"end":{"line":16,"column":121,"offset":1117}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Freeze authority: Das Konto, das berechtigt ist, Tokens in einem Token-Konto einzufrieren und damit deren Übertragung oder Verbrennung zu verhindern","position":{"start":{"line":17,"column":3,"offset":1121},"end":{"line":17,"column":151,"offset":1269}}}],"position":{"start":{"line":17,"column":3,"offset":1121},"end":{"line":17,"column":151,"offset":1269}}}],"position":{"start":{"line":17,"column":1,"offset":1119},"end":{"line":17,"column":151,"offset":1269}}}],"position":{"start":{"line":14,"column":1,"offset":920},"end":{"line":17,"column":151,"offset":1269}}},{"type":"paragraph","children":[{"type":"text","value":"So sehen diese Daten in der Blockchain aus:","position":{"start":{"line":19,"column":1,"offset":1273},"end":{"line":19,"column":44,"offset":1316}}}],"position":{"start":{"line":19,"column":1,"offset":1273},"end":{"line":19,"column":44,"offset":1316}}},{"type":"code","lang":"rust","meta":null,"value":"pub struct Mint {\r\n    /// Optional authority used to mint new tokens. The mint authority may only\r\n    /// be provided during mint creation. If no mint authority is present\r\n    /// then the mint has a fixed supply and no further tokens may be\r\n    /// minted.\r\n    pub mint_authority: COption<Pubkey>,\r\n    /// Total supply of tokens.\r\n    pub supply: u64,\r\n    /// Number of base 10 digits to the right of the decimal place.\r\n    pub decimals: u8,\r\n    /// Is `true` if this structure has been initialized\r\n    pub is_initialized: bool,\r\n    /// Optional authority to freeze token accounts.\r\n    pub freeze_authority: COption<Pubkey>,\r\n}","position":{"start":{"line":21,"column":1,"offset":1320},"end":{"line":37,"column":4,"offset":1974}},"data":{"highlightId":"code-0"}},{"type":"heading","depth":3,"children":[{"type":"text","value":"Metadaten","position":{"start":{"line":39,"column":5,"offset":1982},"end":{"line":39,"column":14,"offset":1991}}}],"position":{"start":{"line":39,"column":1,"offset":1978},"