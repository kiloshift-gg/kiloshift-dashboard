,"position":{"start":{"line":20,"column":1,"offset":1040},"end":{"line":20,"column":71,"offset":1110}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Tham gia cộng đồng của chúng tôi để chia sẻ ý tưởng, triển khai của bạn và nhận trợ giúp","position":{"start":{"line":21,"column":4,"offset":1115},"end":{"line":21,"column":92,"offset":1203}}}],"position":{"start":{"line":21,"column":4,"offset":1115},"end":{"line":21,"column":92,"offset":1203}}}],"position":{"start":{"line":21,"column":1,"offset":1112},"end":{"line":21,"column":92,"offset":1203}}}],"position":{"start":{"line":19,"column":1,"offset":893},"end":{"line":21,"column":92,"offset":1203}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":22,"column":1,"offset":1205}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Kết luận\r\n\r\nChúc mừng! Bạn đã hoàn thành khóa học Token trên Solana. Giờ đây bạn đã có hiểu biết vững chắc về cách token hoạt động trên Solana và vai trò của chúng.\r\n\r\n<ArticleSection name=\"Những gì bạn đã học\" id=\"what-you-learned\" level=\"h2\" />\r\n\r\nTrong suốt khóa học này, bạn đã có được kiến thức thiết yếu về:\r\n- Các loại token khác nhau và tại sao chúng quan trọng.\r\n- Cách token hoạt động trên Solana so với các hệ sinh thái khác.\r\n- Mint, Token và Associated Token account là gì.\r\n- Những hành động nào có thể được thực hiện trên các token này.\r\n\r\n<ArticleSection name=\"Các bước tiếp theo\" id=\"next-steps\" level=\"h2\" />\r\n\r\nBây giờ bạn đã sẵn sàng để bắt đầu sử dụng token program mới và các extension để tăng sức mạnh cho chương trình của bạn! Đây là một số bước tiếp theo được khuyến nghị:\r\n\r\n1. Tìm hiểu thêm về cách bạn có thể sử dụng chương trình này với typescript trong [phần SPL-Token with Web3Js](/vi/courses/spl-token-with-web3js)\r\n2. Khám phá [phần Thử thách](/vi/challenges) cho các bài tập thực hành\r\n3. Tham gia cộng đồng của chúng tôi để chia sẻ ý tưởng, triển khai của bạn và nhận trợ giúp\r\n","highlightedCode":{}}