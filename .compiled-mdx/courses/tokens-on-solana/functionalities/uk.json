lumn":3,"offset":3424},"end":{"line":59,"column":31,"offset":3452}}},{"type":"inlineCode","value":"Mint","position":{"start":{"line":59,"column":31,"offset":3452},"end":{"line":59,"column":37,"offset":3458}}},{"type":"text","value":" рахунок, який має пропозицію 0","position":{"start":{"line":59,"column":37,"offset":3458},"end":{"line":59,"column":68,"offset":3489}}}],"position":{"start":{"line":59,"column":3,"offset":3424},"end":{"line":59,"column":68,"offset":3489}}}],"position":{"start":{"line":59,"column":1,"offset":3422},"end":{"line":59,"column":68,"offset":3489}}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Freeze Account","position":{"start":{"line":61,"column":17,"offset":3509},"end":{"line":61,"column":38,"offset":3530}}},{"type":"mdxJsxAttribute","name":"id","value":"set-mint-to","position":{"start":{"line":61,"column":39,"offset":3531},"end":{"line":61,"column":55,"offset":3547}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":61,"column":56,"offset":3548},"end":{"line":61,"column":66,"offset":3558}}}],"children":[],"position":{"start":{"line":61,"column":1,"offset":3493},"end":{"line":61,"column":69,"offset":3561}}},{"type":"paragraph","children":[{"type":"text","value":"Запобігає всім операціям з токенами на рахунку, доки його не буде розморожено. Лише орган заморожування емісії може виконувати цю операцію.","position":{"start":{"line":63,"column":1,"offset":3565},"end":{"line":63,"column":140,"offset":3704}}}],"position":{"start":{"line":63,"column":1,"offset":3565},"end":{"line":63,"column":140,"offset":3704}}},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"Повністю вимикає перекази, схвалення та спалювання, і це впливає лише на конкретний заморожений рахунок","position":{"start":{"line":65,"column":3,"offset":3710},"end":{"line":65,"column":106,"offset":3813}}}],"position":{"start":{"line":65,"column":3,"offset":3710},"end":{"line":65,"column":106,"offset":3813}}}],"position":{"start":{"line":65,"column":1,"offset":3708},"end":{"line":65,"column":106,"offset":3813}}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Розморожування рахунку","position":{"start":{"line":67,"column":17,"offset":3833},"end":{"line":67,"column":46,"offset":3862}}},{"type":"mdxJsxAttribute","name":"id","value":"thaw-account","position":{"start":{"line":67,"column":47,"offset":3863},"end":{"line":67,"column":64,"offset":3880}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":67,"column":65,"offset":3881},"end":{"line":67,"column":75,"offset":3891}}}],"children":[],"position":{"start":{"line":67,"column":1,"offset":3817},"end":{"line":67,"column":78,"offset":3894}}},{"type":"paragraph","children":[{"type":"text","value":"Повторно вмикає операції з токенами на раніше замороженому рахунку. Лише орган заморожування емітента може розморожувати рахунки.","position":{"start":{"line":69,"column":1,"offset":3898},"end":{"line":69,"column":130,"offset":4027}}}],"position":{"start":{"line":69,"column":1,"offset":3898},"end":{"line":69,"column":130,"offset":4027}}},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"Відновлює повну функціональність замороженого рахунку і може виконуватися лише органом заморожування емітента","position":{"start":{"line":71,"column":3,"offset":4033},"end":{"line":71,"column":112,"offset":4142}}}],"position":{"start":{"line":71,"column":3,"offset":4033},"end":{"line":71,"column":112,"offset":4142}}}],"position":{"start":{"line":71,"column":1,"offset":4031},"end":{"line":71,"column":112,"offset":4142}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":72,"column":1,"offset":4144}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Функціональності\r\n\r\nПрограма токенів працює через набір інструкцій, які дозволяють створювати випуски токенів, ініціалізувати токен-рахунки, переказувати токени між рахунками та керувати повноваженнями.\r\n\r\nВона також підтримує мультипідписні рахунки для підвищеної безпеки та надає механізми для заморожування рахунків і делегування повноважень на токени.\r\n\r\n<ArticleSection name=\"Initializing an Account\" id=\"intializing-an-account\" level=\"h2\" />\r\n\r\nПрограма токенів має різні інструкції та допоміжні функції, які абстрагують складності ініціалізації нового рахунку.\r\n\r\nІснують різні інструкції, якщо ми хочемо ініціалізувати `Mint` рахунок або `Token` рахунок. У випадку з `Associated Token` рахунком, асоційована токен-програма використовує інструкцію `initializeAccount` під капотом після отримання правильної програмно-похідної адреси.\r\n\r\n> Ця функція лише ініціалізує рахунок, тому нам потрібно переконатися, що ми використовуємо інструкцію `createAccount()` з Системної Програми перед цим, і встановити правильного власника (програму токенів), простір та ламports, щоб зробити його захищеним від орендної плати.\r\n\r\n<ArticleSection name=\"Transfer\" id=\"transfer\" level=\"h2\" />\r\n\r\nПереміщує токени з одного рахунку на інший. Це основна операція для надсилання токенів між користувачами.\r\n\r\nВласник токен-рахунку повинен бути `Signer` цієї транзакції, а призначенням цього переказу має бути інший токен-рахунок.\r\n\r\n> Сума, яку ми вирішуємо перевести, вказується без десяткових знаків. Тому, якщо ми хочемо надіслати 1 токен, який має 6 десяткових знаків, нам потрібно використовувати нотацію `1e6`.\r\n\r\n<ArticleSection name=\"Approve\" id=\"approve\" level=\"h2\" />\r\n\r\nНадає делегату повноваження на переказ певної кількості токенів від імені власника рахунку. Це дозволяє програмно переказувати токени без надання повного контролю над рахунком.\r\n\r\n> Ми встановлюємо \"схвалену\" суму, і делегат може переказувати лише до цієї суми\r\n\r\n<ArticleSection name=\"Revoke\" id=\"revoke\" level=\"h2\" />\r\n\r\nСкасовує повноваження поточного делегата над рахунком, повертаючи повний контроль власнику рахунку.\r\n\r\n> Негайно скасовує будь-яке існуюче делегування, і лише власник рахунку може скасувати делегування (не сам делегат)\r\n\r\n<ArticleSection name=\"Set Authority\" id=\"set-authority\" level=\"h2\" />\r\n\r\nЗмінює повноваження емісії або рахунку. Це дозволяє передавати право власності або оновлювати певні типи повноважень.\r\n\r\n> Може змінювати повноваження емісії, повноваження заморожування або власника рахунку, і встановлення повноваження на `None` є незворотною дією, яка назавжди видаляє цю можливість\r\n\r\n<ArticleSection name=\"Mint To\" id=\"mint-to\" level=\"h2\" />\r\n\r\nСтворює нові токени та депонує їх на вказаний рахунок. Лише орган емісії може виконувати цю операцію.\r\n\r\n> Збільшує загальну пропозицію токена, і сума відповідає десятковій конфігурації емісії\r\n\r\n<ArticleSection name=\"Burn\" id=\"burn\" level=\"h2\" />\r\n\r\nНазавжди знищує токени, вилучаючи їх з обігу. Це зменшує загальну пропозицію токена.\r\n\r\n> Назавжди зменшує загальну пропозицію токена, і ця дія може бути виконана власником рахунку або делегатом\r\n\r\n<ArticleSection name=\"Close Account\" id=\"close-account\" level=\"h2\" />\r\n\r\nЗакриває токен-рахунок і переказує залишок його SOL-ренти на цільовий рахунок. Токен-рахунок повинен мати нульовий баланс, якщо це не нативний SOL-рахунок.\r\n\r\n> З Token2022 можливо закрити `Mint` рахунок, який має пропозицію 0\r\n\r\n<ArticleSection name=\"Freeze Account\" id=\"set-mint-to\" level=\"h2\" />\r\n\r\nЗапобігає всім операціям з токенами на рахунку, доки його не буде розморожено. Лише орган заморожування емісії може виконувати цю операцію.\r\n\r\n> Повністю вимикає перекази, схвалення та спалювання, і це впливає лише на конкретний заморожений рахунок\r\n\r\n<ArticleSection name=\"Розморожування рахунку\" id=\"thaw-account\" level=\"h2\" />\r\n\r\nПовторно вмикає операції з токенами на раніше замороженому рахунку. Лише орган заморожування емітента може розморожувати рахунки.\r\n\r\n> Відновлює повну функціональність замороженого рахунку і може виконуватися лише органом заморожування емітента\r\n","highlightedCode":{}}