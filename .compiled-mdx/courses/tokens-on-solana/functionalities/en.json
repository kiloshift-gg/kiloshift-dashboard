he total supply of the token.","position":{"start":{"line":51,"column":1,"offset":2977},"end":{"line":51,"column":107,"offset":3083}}}],"position":{"start":{"line":51,"column":1,"offset":2977},"end":{"line":51,"column":107,"offset":3083}}},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"Permanently reduces the token's total supply and this action can be performed by the account owner or delegate","position":{"start":{"line":53,"column":3,"offset":3089},"end":{"line":53,"column":113,"offset":3199}}}],"position":{"start":{"line":53,"column":3,"offset":3089},"end":{"line":53,"column":113,"offset":3199}}}],"position":{"start":{"line":53,"column":1,"offset":3087},"end":{"line":53,"column":113,"offset":3199}}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Close Account","position":{"start":{"line":55,"column":17,"offset":3219},"end":{"line":55,"column":37,"offset":3239}}},{"type":"mdxJsxAttribute","name":"id","value":"close-account","position":{"start":{"line":55,"column":38,"offset":3240},"end":{"line":55,"column":56,"offset":3258}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":55,"column":57,"offset":3259},"end":{"line":55,"column":67,"offset":3269}}}],"children":[],"position":{"start":{"line":55,"column":1,"offset":3203},"end":{"line":55,"column":70,"offset":3272}}},{"type":"paragraph","children":[{"type":"text","value":"Closes a token account and transfers its remaining SOL rent to a destination account. The token account must have zero balance unless it's a native SOL account.","position":{"start":{"line":57,"column":1,"offset":3276},"end":{"line":57,"column":161,"offset":3436}}}],"position":{"start":{"line":57,"column":1,"offset":3276},"end":{"line":57,"column":161,"offset":3436}}},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"From Token2022 it's possible to close a ","position":{"start":{"line":59,"column":3,"offset":3442},"end":{"line":59,"column":43,"offset":3482}}},{"type":"inlineCode","value":"Mint","position":{"start":{"line":59,"column":43,"offset":3482},"end":{"line":59,"column":49,"offset":3488}}},{"type":"text","value":" account that has a supply of 0","position":{"start":{"line":59,"column":49,"offset":3488},"end":{"line":59,"column":80,"offset":3519}}}],"position":{"start":{"line":59,"column":3,"offset":3442},"end":{"line":59,"column":80,"offset":3519}}}],"position":{"start":{"line":59,"column":1,"offset":3440},"end":{"line":59,"column":80,"offset":3519}}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Freeze Account","position":{"start":{"line":61,"column":17,"offset":3539},"end":{"line":61,"column":38,"offset":3560}}},{"type":"mdxJsxAttribute","name":"id","value":"set-mint-to","position":{"start":{"line":61,"column":39,"offset":3561},"end":{"line":61,"column":55,"offset":3577}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":61,"column":56,"offset":3578},"end":{"line":61,"column":66,"offset":3588}}}],"children":[],"position":{"start":{"line":61,"column":1,"offset":3523},"end":{"line":61,"column":69,"offset":3591}}},{"type":"paragraph","children":[{"type":"text","value":"Prevents all token operations on an account until it's thawed. Only the mint's freeze authority can perform this operation.","position":{"start":{"line":63,"column":1,"offset":3595},"end":{"line":63,"column":124,"offset":3718}}}],"position":{"start":{"line":63,"column":1,"offset":3595},"end":{"line":63,"column":124,"offset":3718}}},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"Completely disables transfers, approvals, and burns and it only affects the specific frozen account","position":{"start":{"line":65,"column":3,"offset":3724},"end":{"line":65,"column":102,"offset":3823}}}],"position":{"start":{"line":65,"column":3,"offset":3724},"end":{"line":65,"column":102,"offset":3823}}}],"position":{"start":{"line":65,"column":1,"offset":3722},"end":{"line":65,"column":102,"offset":3823}}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Thaw Account","position":{"start":{"line":67,"column":17,"offset":3843},"end":{"line":67,"column":36,"offset":3862}}},{"type":"mdxJsxAttribute","name":"id","value":"thaw-account","position":{"start":{"line":67,"column":37,"offset":3863},"end":{"line":67,"column":54,"offset":3880}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":67,"column":55,"offset":3881},"end":{"line":67,"column":65,"offset":3891}}}],"children":[],"position":{"start":{"line":67,"column":1,"offset":3827},"end":{"line":67,"column":68,"offset":3894}}},{"type":"paragraph","children":[{"type":"text","value":"Re-enables token operations on a previously frozen account. Only the mint's freeze authority can thaw accounts.","position":{"start":{"line":69,"column":1,"offset":3898},"end":{"line":69,"column":112,"offset":4009}}}],"position":{"start":{"line":69,"column":1,"offset":3898},"end":{"line":69,"column":112,"offset":4009}}},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"Restores full functionality to a frozen account and can only be performed by the mint's freeze authority","position":{"start":{"line":71,"column":3,"offset":4015},"end":{"line":71,"column":107,"offset":4119}}}],"position":{"start":{"line":71,"column":3,"offset":4015},"end":{"line":71,"column":107,"offset":4119}}}],"position":{"start":{"line":71,"column":1,"offset":4013},"end":{"line":71,"column":107,"offset":4119}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":73,"column":1,"offset":4123}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Functionalities\r\n\r\nThe Token Program operates through a set of instructions that allow you to create token mints, initialize token accounts, transfer tokens between accounts, and manage authorities. \r\n\r\nIt also supports multisignature accounts for enhanced security and provides mechanisms for freezing accounts and delegating token authority.\r\n\r\n<ArticleSection name=\"Initializing an Account\" id=\"intializing-an-account\" level=\"h2\" />\r\n\r\nThe token program has different instructions and helpers that abstract away the complexities of intializing a new account. \r\n\r\nThere are different instructions if we want to initialize a `Mint` account or a `Token` account, in the case of the `Associated Token` account, the associated token program uses the `initializeAccount` instruction under the hood after having derived the correct program derived address.\r\n\r\n> This function just initializes the account, so we need to make sure that we use the `createAccount()` instruction from the System Program before, and set the correct owner (token program), space and lamports to make it rent exempt.\r\n\r\n<ArticleSection name=\"Transfer\" id=\"transfer\" level=\"h2\" />\r\n\r\nMoves tokens from one account to another. This is the basic operation for sending tokens between users.\r\n\r\nThe owner of the token account needs to be a `Signer` of that transaction, and the destination of that transfer needs to be another token account. \r\n\r\n> The amount that we decide to transfer is without decimals. So if we want to send 1 token that has 6 decimals we'll need to use the `1e6` notation.\r\n\r\n<ArticleSection name=\"Approve\" id=\"approve\" level=\"h2\" />\r\n\r\nGrants a delegate the authority to transfer a specific amount of tokens on behalf of the account owner. This enables programmatic token transfers without giving full account control.\r\n\r\n> We set an \"approved\" amount, and the delegate can transfer only up to that amount\r\n\r\n<ArticleSection name=\"Revoke\" id=\"revoke\" level=\"h2\" />\r\n\r\nRemoves the current delegate's authority over the account, returning full control to the account owner.\r\n\r\n> Immediately cancels any existing delegation and only the account owner can revoke delegation (not the delegate itself)\r\n\r\n<ArticleSection name=\"Set Authority\" id=\"set-authority\" level=\"h2\" />\r\n\r\nChanges the authority of a mint or account. This allows transferring ownership or updating specific authority types.\r\n\r\n> Can change mint authority, freeze authority, or account owner and setting authority to `None` is an irreversible action that permanently removes that capability\r\n\r\n<ArticleSection name=\"Mint To\" id=\"mint-to\" level=\"h2\" />\r\n\r\nCreates new tokens and deposits them into a specified account. Only the mint authority can perform this operation.\r\n\r\n> Increases the total supply of the token and the amount respects the mint's decimal configuration\r\n\r\n<ArticleSection name=\"Burn\" id=\"burn\" level=\"h2\" />\r\n\r\nPermanently destroys tokens by removing them from circulation. This reduces the total supply of the token.\r\n\r\n> Permanently reduces the token's total supply and this action can be performed by the account owner or delegate\r\n\r\n<ArticleSection name=\"Close Account\" id=\"close-account\" level=\"h2\" />\r\n\r\nCloses a token account and transfers its remaining SOL rent to a destination account. The token account must have zero balance unless it's a native SOL account.\r\n\r\n> From Token2022 it's possible to close a `Mint` account that has a supply of 0\r\n\r\n<ArticleSection name=\"Freeze Account\" id=\"set-mint-to\" level=\"h2\" />\r\n\r\nPrevents all token operations on an account until it's thawed. Only the mint's freeze authority can perform this operation.\r\n\r\n> Completely disables transfers, approvals, and burns and it only affects the specific frozen account\r\n\r\n<ArticleSection name=\"Thaw Account\" id=\"thaw-account\" level=\"h2\" />\r\n\r\nRe-enables token operations on a previously frozen account. Only the mint's freeze authority can thaw accounts.\r\n\r\n> Restores full functionality to a frozen account and can only be performed by the mint's freeze authority\r\n\r\n","highlightedCode":{}}