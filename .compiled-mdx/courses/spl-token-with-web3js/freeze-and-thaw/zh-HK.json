s","meta":null,"value":"// Thaw an ATA\r\nconst thawInstruction = createThawAccountInstruction(\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconst transaction = new Transaction().add(thawInstruction);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token account thawed! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":56,"column":1,"offset":1465},"end":{"line":69,"column":4,"offset":1910}},"data":{"highlightId":"code-1"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Abstracted Instruction","position":{"start":{"line":71,"column":17,"offset":1930},"end":{"line":71,"column":46,"offset":1959}}},{"type":"mdxJsxAttribute","name":"id","value":"abstracted-instruction","position":{"start":{"line":71,"column":47,"offset":1960},"end":{"line":71,"column":74,"offset":1987}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":71,"column":75,"offset":1988},"end":{"line":71,"column":85,"offset":1998}}}],"children":[],"position":{"start":{"line":71,"column":1,"offset":1914},"end":{"line":71,"column":88,"offset":2001}}},{"type":"paragraph","children":[{"type":"text","value":"以下是使用","position":{"start":{"line":73,"column":1,"offset":2005},"end":{"line":73,"column":6,"offset":2010}}},{"type":"inlineCode","value":"freezeAccount()","position":{"start":{"line":73,"column":6,"offset":2010},"end":{"line":73,"column":23,"offset":2027}}},{"type":"text","value":"指令進行抽象後的操作方式：","position":{"start":{"line":73,"column":23,"offset":2027},"end":{"line":73,"column":36,"offset":2040}}}],"position":{"start":{"line":73,"column":1,"offset":2005},"end":{"line":73,"column":36,"offset":2040}}},{"type":"code","lang":"ts","meta":null,"value":"const tokenAccount = Keypair.generate();\r\n\r\nconst ata = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    tokenAccount.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${ata.address}!`)\r\n\r\nlet tx = await freezeAccount(\r\n    connection,\r\n    keypair,\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconsole.log(`Token Account succesfully Frozen!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)","position":{"start":{"line":75,"column":1,"offset":2044},"end":{"line":96,"column":4,"offset":2552}},"data":{"highlightId":"code-2"}},{"type":"paragraph","children":[{"type":"text","value":"以下是使用","position":{"start":{"line":98,"column":1,"offset":2556},"end":{"line":98,"column":6,"offset":2561}}},{"type":"inlineCode","value":"thawAccount()","position":{"start":{"line":98,"column":6,"offset":2561},"end":{"line":98,"column":21,"offset":2576}}},{"type":"text","value":"指令進行抽象後的操作方式：","position":{"start":{"line":98,"column":21,"offset":2576},"end":{"line":98,"column":34,"offset":2589}}}],"position":{"start":{"line":98,"column":1,"offset":2556},"end":{"line":98,"column":34,"offset":2589}}},{"type":"code","lang":"ts","meta":null,"value":"let tx = await thawAccount(\r\n    connection,\r\n    keypair,\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconsole.log(`Token Account succesfully Thawed!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)","position":{"start":{"line":100,"column":1,"offset":2593},"end":{"line":110,"column":4,"offset":2873}},"data":{"highlightId":"code-3"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":110,"column":4,"offset":2873}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# 凍結和解凍指引\r\n\r\n凍結會阻止帳戶上的所有代幣操作，直到該帳戶被解凍。只有鑄幣的凍結權限持有人可以執行此操作。\r\n\r\n> 完全禁用轉賬、授權和銷毀操作，並且僅影響特定的已凍結帳戶\r\n\r\n解凍會重新啟用之前被凍結帳戶上的代幣操作。只有鑄幣的凍結權限持有人可以解凍帳戶。\r\n\r\n> 恢復已凍結帳戶的全部功能，並且只能由鑄幣的凍結權限持有人執行\r\n\r\n在我們可以凍結和解凍任何代幣之前，我們需要已經完成以下操作：\r\n- 初始化了一個我們持有`freezeAuthority`的`Mint`帳戶\r\n- 初始化了一個我們想要凍結或解凍的`Token`帳戶或`Associated Token`帳戶\r\n\r\n<ArticleSection name=\"Raw Instruction\" id=\"raw-instruction\" level=\"h2\" />\r\n\r\n僅使用「原始」指令而不進行任何抽象，以下是凍結代幣的操作方式：\r\n\r\n```ts\r\nconst keypair = Keypair.generate();\r\n\r\nconst tokenAccount = await getAssociatedTokenAddress(\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n);\r\n\r\n// Create ATA creation instruction\r\nconst createAtaInstruction = createAssociatedTokenAccountIdempotentInstruction(\r\n    keypair.publicKey, // payer\r\n    tokenAccount, // associated token account address\r\n    destination.publicKey, // owner\r\n    mint.publicKey, // mint\r\n);\r\n\r\n// Freeze an ATA\r\nconst freezeInstruction = createFreezeAccountInstruction(\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAtaInstruction,\r\n    freezeInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token accounts created and frozen! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\n僅使用「原始」指令而不進行任何抽象，以下是撤銷代幣的操作方式：\r\n\r\n```ts\r\n// Thaw an ATA\r\nconst thawInstruction = createThawAccountInstruction(\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconst transaction = new Transaction().add(thawInstruction);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token account thawed! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\n<ArticleSection name=\"Abstracted Instruction\" id=\"abstracted-instruction\" level=\"h2\" />\r\n\r\n以下是使用`freezeAccount()`指令進行抽象後的操作方式：\r\n\r\n```ts\r\nconst tokenAccount = Keypair.generate();\r\n\r\nconst ata = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    tokenAccount.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${ata.address}!`)\r\n\r\nlet tx = await freezeAccount(\r\n    connection,\r\n    keypair,\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconsole.log(`Token Account succesfully Frozen!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)\r\n```\r\n\r\n以下是使用`thawAccount()`指令進行抽象後的操作方式：\r\n\r\n```ts\r\nlet tx = await thawAccount(\r\n    connection,\r\n    keypair,\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconsole.log(`Token Account succesfully Thawed!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)\r\n```","highlightedCode":{"code-0":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"const"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" keypair "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"="}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" Keypair."}]},{"type":"element","tagName":"span","properties":{"style":"color:#62E884"},"children":[{"type":"text","value":"generate"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"();"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","propertie