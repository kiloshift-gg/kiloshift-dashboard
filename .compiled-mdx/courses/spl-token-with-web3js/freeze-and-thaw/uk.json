 https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":21,"column":1,"offset":1120},"end":{"line":52,"column":4,"offset":2045}},"data":{"highlightId":"code-0"}},{"type":"paragraph","children":[{"type":"text","value":"Використовуючи лише \"сиру\" інструкцію без будь-якої абстракції, відкликання токена виглядатиме так:","position":{"start":{"line":54,"column":1,"offset":2049},"end":{"line":54,"column":100,"offset":2148}}}],"position":{"start":{"line":54,"column":1,"offset":2049},"end":{"line":54,"column":100,"offset":2148}}},{"type":"code","lang":"ts","meta":null,"value":"// Thaw an ATA \r\nconst thawInstruction = createThawAccountInstruction(\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconst transaction = new Transaction().add(thawInstruction);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token account thawed! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":56,"column":1,"offset":2152},"end":{"line":69,"column":4,"offset":2598}},"data":{"highlightId":"code-1"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Abstracted Instruction","position":{"start":{"line":71,"column":17,"offset":2618},"end":{"line":71,"column":46,"offset":2647}}},{"type":"mdxJsxAttribute","name":"id","value":"abstracted-instruction","position":{"start":{"line":71,"column":47,"offset":2648},"end":{"line":71,"column":74,"offset":2675}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":71,"column":75,"offset":2676},"end":{"line":71,"column":85,"offset":2686}}}],"children":[],"position":{"start":{"line":71,"column":1,"offset":2602},"end":{"line":71,"column":88,"offset":2689}}},{"type":"paragraph","children":[{"type":"text","value":"Ось як ті самі інструкції виглядатимуть з абстракцією за допомогою інструкції ","position":{"start":{"line":73,"column":1,"offset":2693},"end":{"line":73,"column":79,"offset":2771}}},{"type":"inlineCode","value":"freezeAccount()","position":{"start":{"line":73,"column":79,"offset":2771},"end":{"line":73,"column":96,"offset":2788}}},{"type":"text","value":":","position":{"start":{"line":73,"column":96,"offset":2788},"end":{"line":73,"column":97,"offset":2789}}}],"position":{"start":{"line":73,"column":1,"offset":2693},"end":{"line":73,"column":97,"offset":2789}}},{"type":"code","lang":"ts","meta":null,"value":"const tokenAccount = Keypair.generate();\r\n\r\nconst ata = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    tokenAccount.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${ata.address}!`)\r\n  \r\nlet tx = await freezeAccount(\r\n    connection,\r\n    keypair,\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconsole.log(`Token Account succesfully Frozen!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)","position":{"start":{"line":75,"column":1,"offset":2793},"end":{"line":96,"column":4,"offset":3303}},"data":{"highlightId":"code-2"}},{"type":"paragraph","children":[{"type":"text","value":"Ось як ті самі інструкції виглядатимуть з абстракцією за допомогою інструкції ","position":{"start":{"line":98,"column":1,"offset":3307},"end":{"line":98,"column":79,"offset":3385}}},{"type":"inlineCode","value":"thawAccount()","position":{"start":{"line":98,"column":79,"offset":3385},"end":{"line":98,"column":94,"offset":3400}}},{"type":"text","value":":","position":{"start":{"line":98,"column":94,"offset":3400},"end":{"line":98,"column":95,"offset":3401}}}],"position":{"start":{"line":98,"column":1,"offset":3307},"end":{"line":98,"column":95,"offset":3401}}},{"type":"code","lang":"ts","meta":null,"value":"let tx = await thawAccount(\r\n    connection,\r\n    keypair,\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconsole.log(`Token Account succesfully Thawed!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)","position":{"start":{"line":100,"column":1,"offset":3405},"end":{"line":110,"column":4,"offset":3685}},"data":{"highlightId":"code-3"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":110,"column":4,"offset":3685}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Інструкції з заморожування та розморожування\r\n\r\nЗаморожування запобігає всім операціям з токенами на рахунку, доки він не буде розморожений. Лише орган заморожування емітента може виконувати цю операцію.\r\n\r\n> Повністю вимикає перекази, схвалення та спалювання, і впливає лише на конкретний заморожений рахунок\r\n\r\nРозморожування повторно вмикає операції з токенами на раніше замороженому рахунку. Лише орган заморожування емітента може розморожувати рахунки.\r\n\r\n> Відновлює повну функціональність замороженого рахунку і може виконуватися лише органом заморожування емітента\r\n\r\nПерш ніж ми зможемо заморозити та розморозити будь-який токен, нам потрібно вже мати:\r\n- Ініціалізований рахунок `Mint`, для якого ми маємо `freezeAuthority`\r\n- Ініціалізований рахунок `Token` або рахунок `Associated Token`, який ми хочемо заморозити або розморозити\r\n\r\n<ArticleSection name=\"Raw Instruction\" id=\"raw-instruction\" level=\"h2\" />\r\n\r\nВикористовуючи лише \"сиру\" інструкцію без будь-якої абстракції, заморожування токена виглядатиме так:\r\n\r\n```ts\r\nconst keypair = Keypair.generate();\r\n\r\nconst tokenAccount = await getAssociatedTokenAddress(\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n);\r\n\r\n// Create ATA creation instruction\r\nconst createAtaInstruction = createAssociatedTokenAccountIdempotentInstruction(\r\n    keypair.publicKey, // payer\r\n    tokenAccount, // associated token account address\r\n    destination.publicKey, // owner\r\n    mint.publicKey, // mint\r\n);\r\n\r\n// Freeze an ATA \r\nconst freezeInstruction = createFreezeAccountInstruction(\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAtaInstruction,\r\n    freezeInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token accounts created and frozen! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\nВикористовуючи лише \"сиру\" інструкцію без будь-якої абстракції, відкликання токена виглядатиме так:\r\n\r\n```ts\r\n// Thaw an ATA \r\nconst thawInstruction = createThawAccountInstruction(\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconst transaction = new Transaction().add(thawInstruction);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token account thawed! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\n<ArticleSection name=\"Abstracted Instruction\" id=\"abstracted-instruction\" level=\"h2\" />\r\n\r\nОсь як ті самі інструкції виглядатимуть з абстракцією за допомогою інструкції `freezeAccount()`:\r\n\r\n```ts\r\nconst tokenAccount = Keypair.generate();\r\n\r\nconst ata = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    tokenAccount.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${ata.address}!`)\r\n  \r\nlet tx = await freezeAccount(\r\n    connection,\r\n    keypair,\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconsole.log(`Token Account succesfully Frozen!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)\r\n```\r\n\r\nОсь як ті самі інструкції виглядатимуть з абстракцією за допомогою інструкції `thawAccount()`:\r\n\r\n```ts\r\nlet tx = await thawAccount(\r\n    connection,\r\n    keypair,\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconsole.log(`Token Account succesfully Thawed!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)\r\n```","highlightedCode":{"code-0":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"const"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" keypair "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"="}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" Keypair."}]},{"type":"element","tagName":"span","properties":{"style":"color:#62E884"},"children":[{"type":"text","value":"generate"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"();"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"const"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" tokenAccount "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"