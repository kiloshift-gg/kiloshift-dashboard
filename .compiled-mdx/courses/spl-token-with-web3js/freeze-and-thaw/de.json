r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token accounts created and frozen! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":21,"column":1,"offset":1166},"end":{"line":52,"column":4,"offset":2091}},"data":{"highlightId":"code-0"}},{"type":"paragraph","children":[{"type":"text","value":"Bei Verwendung einer \"rohen\" Anweisung ohne Abstraktion würde das Widerrufen eines Tokens so aussehen:","position":{"start":{"line":54,"column":1,"offset":2095},"end":{"line":54,"column":103,"offset":2197}}}],"position":{"start":{"line":54,"column":1,"offset":2095},"end":{"line":54,"column":103,"offset":2197}}},{"type":"code","lang":"ts","meta":null,"value":"// Thaw an ATA \r\nconst thawInstruction = createThawAccountInstruction(\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconst transaction = new Transaction().add(thawInstruction);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token account thawed! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":56,"column":1,"offset":2201},"end":{"line":69,"column":4,"offset":2647}},"data":{"highlightId":"code-1"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Abstracted Instruction","position":{"start":{"line":71,"column":17,"offset":2667},"end":{"line":71,"column":46,"offset":2696}}},{"type":"mdxJsxAttribute","name":"id","value":"abstracted-instruction","position":{"start":{"line":71,"column":47,"offset":2697},"end":{"line":71,"column":74,"offset":2724}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":71,"column":75,"offset":2725},"end":{"line":71,"column":85,"offset":2735}}}],"children":[],"position":{"start":{"line":71,"column":1,"offset":2651},"end":{"line":71,"column":88,"offset":2738}}},{"type":"paragraph","children":[{"type":"text","value":"So würden die gleichen Anweisungen aussehen, wenn sie mit der ","position":{"start":{"line":73,"column":1,"offset":2742},"end":{"line":73,"column":63,"offset":2804}}},{"type":"inlineCode","value":"freezeAccount()","position":{"start":{"line":73,"column":63,"offset":2804},"end":{"line":73,"column":80,"offset":2821}}},{"type":"text","value":" Anweisung abstrahiert werden:","position":{"start":{"line":73,"column":80,"offset":2821},"end":{"line":73,"column":110,"offset":2851}}}],"position":{"start":{"line":73,"column":1,"offset":2742},"end":{"line":73,"column":110,"offset":2851}}},{"type":"code","lang":"ts","meta":null,"value":"const tokenAccount = Keypair.generate();\r\n\r\nconst ata = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    tokenAccount.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${ata.address}!`)\r\n  \r\nlet tx = await freezeAccount(\r\n    connection,\r\n    keypair,\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconsole.log(`Token Account succesfully Frozen!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)","position":{"start":{"line":75,"column":1,"offset":2855},"end":{"line":96,"column":4,"offset":3365}},"data":{"highlightId":"code-2"}},{"type":"paragraph","children":[{"type":"text","value":"So würden die gleichen Anweisungen aussehen, wenn sie mit der ","position":{"start":{"line":98,"column":1,"offset":3369},"end":{"line":98,"column":63,"offset":3431}}},{"type":"inlineCode","value":"thawAccount()","position":{"start":{"line":98,"column":63,"offset":3431},"end":{"line":98,"column":78,"offset":3446}}},{"type":"text","value":" Anweisung abstrahiert werden:","position":{"start":{"line":98,"column":78,"offset":3446},"end":{"line":98,"column":108,"offset":3476}}}],"position":{"start":{"line":98,"column":1,"offset":3369},"end":{"line":98,"column":108,"offset":3476}}},{"type":"code","lang":"ts","meta":null,"value":"let tx = await thawAccount(\r\n    connection,\r\n    keypair,\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconsole.log(`Token Account succesfully Thawed!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)","position":{"start":{"line":100,"column":1,"offset":3480},"end":{"line":110,"column":4,"offset":3760}},"data":{"highlightId":"code-3"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":110,"column":4,"offset":3760}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Einfrieren und Auftauen: Anweisungen\r\n\r\nDie Freeze-Funktion verhindert alle Token-Operationen auf einem Konto, bis es wieder aufgetaut wird. Nur die Freeze-Autorität der Mint kann diese Operation durchführen.\r\n\r\n> Deaktiviert vollständig Überweisungen, Genehmigungen und Burns und betrifft nur das spezifisch eingefrorene Konto\r\n\r\nDie Thaw-Funktion aktiviert Token-Operationen auf einem zuvor eingefrorenen Konto wieder. Nur die Freeze-Autorität der Mint kann Konten auftauen.\r\n\r\n> Stellt die volle Funktionalität eines eingefrorenen Kontos wieder her und kann nur von der Freeze-Autorität der Mint durchgeführt werden\r\n\r\nBevor wir einen Token einfrieren und auftauen können, benötigen wir bereits:\r\n- Ein initialisiertes `Mint` Konto, für das wir die `freezeAuthority` besitzen\r\n- Ein initialisiertes `Token` Konto oder `Associated Token` Konto, das wir einfrieren oder auftauen möchten\r\n\r\n<ArticleSection name=\"Raw Instruction\" id=\"raw-instruction\" level=\"h2\" />\r\n\r\nBei Verwendung einer \"rohen\" Anweisung ohne Abstraktion würde das Einfrieren eines Tokens so aussehen:\r\n\r\n```ts\r\nconst keypair = Keypair.generate();\r\n\r\nconst tokenAccount = await getAssociatedTokenAddress(\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n);\r\n\r\n// Create ATA creation instruction\r\nconst createAtaInstruction = createAssociatedTokenAccountIdempotentInstruction(\r\n    keypair.publicKey, // payer\r\n    tokenAccount, // associated token account address\r\n    destination.publicKey, // owner\r\n    mint.publicKey, // mint\r\n);\r\n\r\n// Freeze an ATA \r\nconst freezeInstruction = createFreezeAccountInstruction(\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAtaInstruction,\r\n    freezeInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token accounts created and frozen! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\nBei Verwendung einer \"rohen\" Anweisung ohne Abstraktion würde das Widerrufen eines Tokens so aussehen:\r\n\r\n```ts\r\n// Thaw an ATA \r\nconst thawInstruction = createThawAccountInstruction(\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconst transaction = new Transaction().add(thawInstruction);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token account thawed! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\n<ArticleSection name=\"Abstracted Instruction\" id=\"abstracted-instruction\" level=\"h2\" />\r\n\r\nSo würden die gleichen Anweisungen aussehen, wenn sie mit der `freezeAccount()` Anweisung abstrahiert werden:\r\n\r\n```ts\r\nconst tokenAccount = Keypair.generate();\r\n\r\nconst ata = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    tokenAccount.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${ata.address}!`)\r\n  \r\nlet tx = await freezeAccount(\r\n    connection,\r\n    keypair,\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconsole.log(`Token Account succesfully Frozen!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)\r\n```\r\n\r\nSo würden die gleichen Anweisungen aussehen, wenn sie mit der `thawAccount()` Anweisung abstrahiert werden:\r\n\r\n```ts\r\nlet tx = await thawAccount(\r\n    connection,\r\n    keypair,\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconsole.log(`Token Account succesfully Thawed!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)\r\n```","highlightedCode":{"code-0":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"const"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" keypair "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"="}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" Keypair."}]},{"type":"element","tagName":"span","properties":{"style":"color:#62E884"},"children":[{"type":"text","value":"generate"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"();"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","pr