keypair.publicKey, // payer\r\n    tokenAccount, // associated token account address\r\n    destination.publicKey, // owner\r\n    mint.publicKey, // mint\r\n);\r\n\r\n// Freeze an ATA \r\nconst freezeInstruction = createFreezeAccountInstruction(\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAtaInstruction,\r\n    freezeInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token accounts created and frozen! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":21,"column":1,"offset":1115},"end":{"line":52,"column":4,"offset":2040}},"data":{"highlightId":"code-0"}},{"type":"paragraph","children":[{"type":"text","value":"En utilisant uniquement une instruction \"brute\" sans aucune abstraction, voici à quoi ressemble le déblocage d'un jeton :","position":{"start":{"line":54,"column":1,"offset":2044},"end":{"line":54,"column":122,"offset":2165}}}],"position":{"start":{"line":54,"column":1,"offset":2044},"end":{"line":54,"column":122,"offset":2165}}},{"type":"code","lang":"ts","meta":null,"value":"// Thaw an ATA \r\nconst thawInstruction = createThawAccountInstruction(\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconst transaction = new Transaction().add(thawInstruction);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token account thawed! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":56,"column":1,"offset":2169},"end":{"line":69,"column":4,"offset":2615}},"data":{"highlightId":"code-1"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Instruction Abstraite","position":{"start":{"line":71,"column":17,"offset":2635},"end":{"line":71,"column":45,"offset":2663}}},{"type":"mdxJsxAttribute","name":"id","value":"abstracted-instruction","position":{"start":{"line":71,"column":46,"offset":2664},"end":{"line":71,"column":73,"offset":2691}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":71,"column":74,"offset":2692},"end":{"line":71,"column":84,"offset":2702}}}],"children":[],"position":{"start":{"line":71,"column":1,"offset":2619},"end":{"line":71,"column":87,"offset":2705}}},{"type":"paragraph","children":[{"type":"text","value":"Voici à quoi ressemble la même instruction si elle est abstraite à l'aide de l'instruction ","position":{"start":{"line":73,"column":1,"offset":2709},"end":{"line":73,"column":92,"offset":2800}}},{"type":"inlineCode","value":"freezeAccount()","position":{"start":{"line":73,"column":92,"offset":2800},"end":{"line":73,"column":109,"offset":2817}}},{"type":"text","value":" :","position":{"start":{"line":73,"column":109,"offset":2817},"end":{"line":73,"column":111,"offset":2819}}}],"position":{"start":{"line":73,"column":1,"offset":2709},"end":{"line":73,"column":111,"offset":2819}}},{"type":"code","lang":"ts","meta":null,"value":"const tokenAccount = Keypair.generate();\r\n\r\nconst ata = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    tokenAccount.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${ata.address}!`)\r\n  \r\nlet tx = await freezeAccount(\r\n    connection,\r\n    keypair,\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconsole.log(`Token Account succesfully Frozen!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)","position":{"start":{"line":75,"column":1,"offset":2823},"end":{"line":96,"column":4,"offset":3333}},"data":{"highlightId":"code-2"}},{"type":"paragraph","children":[{"type":"text","value":"Voici à quoi ressemble la même instruction si elle est abstraite à l'aide de l'instruction ","position":{"start":{"line":98,"column":1,"offset":3337},"end":{"line":98,"column":92,"offset":3428}}},{"type":"inlineCode","value":"thawAccount()","position":{"start":{"line":98,"column":92,"offset":3428},"end":{"line":98,"column":107,"offset":3443}}},{"type":"text","value":" :","position":{"start":{"line":98,"column":107,"offset":3443},"end":{"line":98,"column":109,"offset":3445}}}],"position":{"start":{"line":98,"column":1,"offset":3337},"end":{"line":98,"column":109,"offset":3445}}},{"type":"code","lang":"ts","meta":null,"value":"let tx = await thawAccount(\r\n    connection,\r\n    keypair,\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconsole.log(`Token Account succesfully Thawed!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)","position":{"start":{"line":100,"column":1,"offset":3449},"end":{"line":110,"column":4,"offset":3729}},"data":{"highlightId":"code-3"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":110,"column":4,"offset":3729}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Instructions Freeze et Thaw\r\n\r\n`Freeze` empêche toutes les opérations liées aux jetons sur un compte jusqu'à ce qu'il soit débloqué. Seule l'autorité de gel du mint peut effectuer cette opération.\r\n\r\n> Désactive complètement les transferts, les approbations et les *burn*. Cela n'affecte que le compte gelé concerné\r\n\r\n`Thaw` réactive les opérations liées aux jetons sur un compte précédemment gelé. Seule l'autorité de gel du mint peut débloquer des comptes.\r\n\r\n> Restaure toutes les fonctionnalités du compte gelé. Ne peut être effectuée que par l'autorité de gel du mint\r\n\r\nAvant de pouvoir geler et débloquer un jeton, nous devons déjà avoir :\r\n- Initialisé un compte de `Mint` pour lequel nous détenons la `freezeAuthority`\r\n- Initialisé un compte de `Token` ou `Associated Token` que nous voulons geler ou débloquer\r\n\r\n<ArticleSection name=\"Instruction Brute\" id=\"raw-instruction\" level=\"h2\" />\r\n\r\nEn utilisant uniquement une instruction \"brute\" sans aucune abstraction, voici à quoi ressemble le gel d'un jeton :\r\n\r\n```ts\r\nconst keypair = Keypair.generate();\r\n\r\nconst tokenAccount = await getAssociatedTokenAddress(\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n);\r\n\r\n// Create ATA creation instruction\r\nconst createAtaInstruction = createAssociatedTokenAccountIdempotentInstruction(\r\n    keypair.publicKey, // payer\r\n    tokenAccount, // associated token account address\r\n    destination.publicKey, // owner\r\n    mint.publicKey, // mint\r\n);\r\n\r\n// Freeze an ATA \r\nconst freezeInstruction = createFreezeAccountInstruction(\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAtaInstruction,\r\n    freezeInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token accounts created and frozen! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\nEn utilisant uniquement une instruction \"brute\" sans aucune abstraction, voici à quoi ressemble le déblocage d'un jeton :\r\n\r\n```ts\r\n// Thaw an ATA \r\nconst thawInstruction = createThawAccountInstruction(\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconst transaction = new Transaction().add(thawInstruction);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token account thawed! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\n<ArticleSection name=\"Instruction Abstraite\" id=\"abstracted-instruction\" level=\"h2\" />\r\n\r\nVoici à quoi ressemble la même instruction si elle est abstraite à l'aide de l'instruction `freezeAccount()` :\r\n\r\n```ts\r\nconst tokenAccount = Keypair.generate();\r\n\r\nconst ata = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    tokenAccount.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${ata.address}!`)\r\n  \r\nlet tx = await freezeAccount(\r\n    connection,\r\n    keypair,\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconsole.log(`Token Account succesfully Frozen!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)\r\n```\r\n\r\nVoici à quoi ressemble la même instruction si elle est abstraite à l'aide de l'instruction `thawAccount()` :\r\n\r\n```ts\r\nlet tx = await thawAccount(\r\n    connection,\r\n    keypair,\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconsole.log(`Token Account succesfully Thawed!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)\r\n```","highlightedCode":{"code-0":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"const"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" keypair "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"="}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" Keypair."}]},{"type":"element","tagName":"span","properties":{"style"