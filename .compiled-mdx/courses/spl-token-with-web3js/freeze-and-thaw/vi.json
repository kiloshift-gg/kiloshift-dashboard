":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Instruction thô","position":{"start":{"line":17,"column":17,"offset":922},"end":{"line":17,"column":39,"offset":944}}},{"type":"mdxJsxAttribute","name":"id","value":"raw-instruction","position":{"start":{"line":17,"column":40,"offset":945},"end":{"line":17,"column":60,"offset":965}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":17,"column":61,"offset":966},"end":{"line":17,"column":71,"offset":976}}}],"children":[],"position":{"start":{"line":17,"column":1,"offset":906},"end":{"line":17,"column":74,"offset":979}}},{"type":"paragraph","children":[{"type":"text","value":"Bằng cách chỉ sử dụng instruction \"thô\" mà không có bất kỳ abstraction nào, đây là cách freeze token sẽ trông như thế nào:","position":{"start":{"line":19,"column":1,"offset":983},"end":{"line":19,"column":123,"offset":1105}}}],"position":{"start":{"line":19,"column":1,"offset":983},"end":{"line":19,"column":123,"offset":1105}}},{"type":"code","lang":"ts","meta":null,"value":"const keypair = Keypair.generate();\r\n\r\nconst tokenAccount = await getAssociatedTokenAddress(\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n);\r\n\r\n// Create ATA creation instruction\r\nconst createAtaInstruction = createAssociatedTokenAccountIdempotentInstruction(\r\n    keypair.publicKey, // payer\r\n    tokenAccount, // associated token account address\r\n    destination.publicKey, // owner\r\n    mint.publicKey, // mint\r\n);\r\n\r\n// Freeze an ATA \r\nconst freezeInstruction = createFreezeAccountInstruction(\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAtaInstruction,\r\n    freezeInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token accounts created and frozen! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":21,"column":1,"offset":1109},"end":{"line":52,"column":4,"offset":2034}},"data":{"highlightId":"code-0"}},{"type":"paragraph","children":[{"type":"text","value":"By using just \"raw\" instruction without any abstraction, this is how revoke a token would look like:","position":{"start":{"line":54,"column":1,"offset":2038},"end":{"line":54,"column":101,"offset":2138}}}],"position":{"start":{"line":54,"column":1,"offset":2038},"end":{"line":54,"column":101,"offset":2138}}},{"type":"code","lang":"ts","meta":null,"value":"// Thaw an ATA \r\nconst thawInstruction = createThawAccountInstruction(\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconst transaction = new Transaction().add(thawInstruction);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token account thawed! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":56,"column":1,"offset":2142},"end":{"line":69,"column":4,"offset":2588}},"data":{"highlightId":"code-1"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Instruction được trừu tượng hóa","position":{"start":{"line":71,"column":17,"offset":2608},"end":{"line":71,"column":55,"offset":2646}}},{"type":"mdxJsxAttribute","name":"id","value":"abstracted-instruction","position":{"start":{"line":71,"column":56,"offset":2647},"end":{"line":71,"column":83,"offset":2674}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":71,"column":84,"offset":2675},"end":{"line":71,"column":94,"offset":2685}}}],"children":[],"position":{"start":{"line":71,"column":1,"offset":2592},"end":{"line":71,"column":97,"offset":2688}}},{"type":"paragraph","children":[{"type":"text","value":"Đây là cách các instruction tương tự sẽ trông như thế nào được trừu tượng hóa với instruction ","position":{"start":{"line":73,"column":1,"offset":2692},"end":{"line":73,"column":95,"offset":2786}}},{"type":"inlineCode","value":"freezeAccount()","position":{"start":{"line":73,"column":95,"offset":2786},"end":{"line":73,"column":112,"offset":2803}}},{"type":"text","value":":","position":{"start":{"line":73,"column":112,"offset":2803},"end":{"line":73,"column":113,"offset":2804}}}],"position":{"start":{"line":73,"column":1,"offset":2692},"end":{"line":73,"column":113,"offset":2804}}},{"type":"code","lang":"ts","meta":null,"value":"const tokenAccount = Keypair.generate();\r\n\r\nconst ata = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    tokenAccount.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${ata.address}!`)\r\n  \r\nlet tx = await freezeAccount(\r\n    connection,\r\n    keypair,\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconsole.log(`Token Account succesfully Frozen!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)","position":{"start":{"line":75,"column":1,"offset":2808},"end":{"line":96,"column":4,"offset":3318}},"data":{"highlightId":"code-2"}},{"type":"paragraph","children":[{"type":"text","value":"Đây là cách các instruction tương tự sẽ trông như thế nào được trừu tượng hóa với instruction ","position":{"start":{"line":98,"column":1,"offset":3322},"end":{"line":98,"column":95,"offset":3416}}},{"type":"inlineCode","value":"thawAccount()","position":{"start":{"line":98,"column":95,"offset":3416},"end":{"line":98,"column":110,"offset":3431}}},{"type":"text","value":":","position":{"start":{"line":98,"column":110,"offset":3431},"end":{"line":98,"column":111,"offset":3432}}}],"position":{"start":{"line":98,"column":1,"offset":3322},"end":{"line":98,"column":111,"offset":3432}}},{"type":"code","lang":"ts","meta":null,"value":"let tx = await thawAccount(\r\n    connection,\r\n    keypair,\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconsole.log(`Token Account succesfully Thawed!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)","position":{"start":{"line":100,"column":1,"offset":3436},"end":{"line":110,"column":4,"offset":3716}},"data":{"highlightId":"code-3"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":110,"column":4,"offset":3716}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Instruction Freeze và Thaw\r\n\r\nFreeze ngăn chặn tất cả các thao tác token trên một account cho đến khi nó được thaw. Chỉ freeze authority của mint mới có thể thực hiện thao tác này.\r\n\r\n> Hoàn toàn vô hiệu hóa transfer, approval, và burn và nó chỉ ảnh hưởng đến account bị đóng băng cụ thể\r\n\r\nThaw kích hoạt lại các thao tác token trên một account đã bị đóng băng trước đó. Chỉ freeze authority của mint mới có thể thaw account.\r\n\r\n> Khôi phục đầy đủ chức năng cho một account bị đóng băng và chỉ có thể được thực hiện bởi freeze authority của mint\r\n\r\nTrước khi chúng ta có thể freeze và thaw bất kỳ token nào, chúng ta sẽ cần phải có:\r\n- Account `Mint` đã được khởi tạo mà chúng ta giữ quyền `freezeAuthority`\r\n- Account `Token` hoặc account `Associated Token` đã được khởi tạo mà chúng ta muốn freeze hoặc thaw\r\n\r\n<ArticleSection name=\"Instruction thô\" id=\"raw-instruction\" level=\"h2\" />\r\n\r\nBằng cách chỉ sử dụng instruction \"thô\" mà không có bất kỳ abstraction nào, đây là cách freeze token sẽ trông như thế nào:\r\n\r\n```ts\r\nconst keypair = Keypair.generate();\r\n\r\nconst tokenAccount = await getAssociatedTokenAddress(\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n);\r\n\r\n// Create ATA creation instruction\r\nconst createAtaInstruction = createAssociatedTokenAccountIdempotentInstruction(\r\n    keypair.publicKey, // payer\r\n    tokenAccount, // associated token account address\r\n    destination.publicKey, // owner\r\n    mint.publicKey, // mint\r\n);\r\n\r\n// Freeze an ATA \r\nconst freezeInstruction = createFreezeAccountInstruction(\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAtaInstruction,\r\n    freezeInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token accounts created and frozen! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\nBy using just \"raw\" instruction without any abstraction, this is how revoke a token would look like:\r\n\r\n```ts\r\n// Thaw an ATA \r\nconst thawInstruction = createThawAccountInstruction(\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconst transaction = new Transaction().add(thawInstruction);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token account thawed! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\n<ArticleSection name=\"Instruction được trừu tượng hóa\" id=\"abstracted-instruction\" level=\"h2\" />\r\n\r\nĐây là cách các instruction tương tự sẽ trông như thế nào được trừu tượng hóa với instruction `freezeAccount()`:\r\n\r\n```ts\r\nconst tokenAccount = Keypair.generate();\r\n\r\nconst ata = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    tokenAccount.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${ata.address}!`)\r\n  \r\nlet tx = await freezeAccount(\r\n    connection,\r\n    keypair,\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconsole.log(`Token Account succesfully Frozen!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)\r\n```\r\n\r\nĐây là cách các instruction tương tự sẽ trông như thế nào được trừu tượng hóa với instruction `thawAccount()`:\r\n\r\n```ts\r\nlet tx = await thawAccount(\r\n    connection,\r\n    keypair,\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconsole.log(`Token Account succesfully Thawed!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)\r\n```","highlightedCode":{"code-0":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"const"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" keypair "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"="}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" Keypair."}]},{"type":"element","tagName":"span","properties":{"style":"color:#62E884"},"children":[{"type":"text","value":"generate"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"();"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"const"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" tokenAccount "}]},{"type":"