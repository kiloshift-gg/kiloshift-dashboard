0},"end":{"line":52,"column":4,"offset":1935}},"data":{"highlightId":"code-0"}},{"type":"paragraph","children":[{"type":"text","value":"By using just \"raw\" instruction without any abstraction, this is how revoke a token would look like:","position":{"start":{"line":54,"column":1,"offset":1939},"end":{"line":54,"column":101,"offset":2039}}}],"position":{"start":{"line":54,"column":1,"offset":1939},"end":{"line":54,"column":101,"offset":2039}}},{"type":"code","lang":"ts","meta":null,"value":"// Thaw an ATA \r\nconst thawInstruction = createThawAccountInstruction(\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconst transaction = new Transaction().add(thawInstruction);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token account thawed! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":56,"column":1,"offset":2043},"end":{"line":69,"column":4,"offset":2489}},"data":{"highlightId":"code-1"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Abstracted Instruction","position":{"start":{"line":71,"column":17,"offset":2509},"end":{"line":71,"column":46,"offset":2538}}},{"type":"mdxJsxAttribute","name":"id","value":"abstracted-instruction","position":{"start":{"line":71,"column":47,"offset":2539},"end":{"line":71,"column":74,"offset":2566}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":71,"column":75,"offset":2567},"end":{"line":71,"column":85,"offset":2577}}}],"children":[],"position":{"start":{"line":71,"column":1,"offset":2493},"end":{"line":71,"column":88,"offset":2580}}},{"type":"paragraph","children":[{"type":"text","value":"This is how the same instructions would look like abstracted away with the ","position":{"start":{"line":73,"column":1,"offset":2584},"end":{"line":73,"column":76,"offset":2659}}},{"type":"inlineCode","value":"freezeAccount()","position":{"start":{"line":73,"column":76,"offset":2659},"end":{"line":73,"column":93,"offset":2676}}},{"type":"text","value":" instruction:","position":{"start":{"line":73,"column":93,"offset":2676},"end":{"line":73,"column":106,"offset":2689}}}],"position":{"start":{"line":73,"column":1,"offset":2584},"end":{"line":73,"column":106,"offset":2689}}},{"type":"code","lang":"ts","meta":null,"value":"const tokenAccount = Keypair.generate();\r\n\r\nconst ata = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    tokenAccount.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${ata.address}!`)\r\n  \r\nlet tx = await freezeAccount(\r\n    connection,\r\n    keypair,\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconsole.log(`Token Account succesfully Frozen!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)","position":{"start":{"line":75,"column":1,"offset":2693},"end":{"line":96,"column":4,"offset":3203}},"data":{"highlightId":"code-2"}},{"type":"paragraph","children":[{"type":"text","value":"This is how the same instructions would look like abstracted away with the ","position":{"start":{"line":98,"column":1,"offset":3207},"end":{"line":98,"column":76,"offset":3282}}},{"type":"inlineCode","value":"thawAccount()","position":{"start":{"line":98,"column":76,"offset":3282},"end":{"line":98,"column":91,"offset":3297}}},{"type":"text","value":" instruction:","position":{"start":{"line":98,"column":91,"offset":3297},"end":{"line":98,"column":104,"offset":3310}}}],"position":{"start":{"line":98,"column":1,"offset":3207},"end":{"line":98,"column":104,"offset":3310}}},{"type":"code","lang":"ts","meta":null,"value":"let tx = await thawAccount(\r\n    connection,\r\n    keypair,\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconsole.log(`Token Account succesfully Thawed!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)","position":{"start":{"line":100,"column":1,"offset":3314},"end":{"line":110,"column":4,"offset":3594}},"data":{"highlightId":"code-3"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":110,"column":4,"offset":3594}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Freeze and Thaw Instructions\r\n\r\nFreeze prevents all token operations on an account until it's thawed. Only the mint's freeze authority can perform this operation.\r\n\r\n> Completely disables transfers, approvals, and burns and it only affects the specific frozen account\r\n\r\nThaw re-enables token operations on a previously frozen account. Only the mint's freeze authority can thaw accounts.\r\n\r\n> Restores full functionality to a frozen account and can only be performed by the mint's freeze authority\r\n\r\nBefore we can freeze and thaw any token, we'll need to already have:\r\n- Initialized a `Mint` account which we hold the `freezeAuthority`\r\n- Initialized a `Token` account or `Associated Token` account that we want to freeze or thaw\r\n\r\n<ArticleSection name=\"Raw Instruction\" id=\"raw-instruction\" level=\"h2\" />\r\n\r\nBy using just \"raw\" instruction without any abstraction, this is how freezing a token would look like:\r\n\r\n```ts\r\nconst keypair = Keypair.generate();\r\n\r\nconst tokenAccount = await getAssociatedTokenAddress(\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n);\r\n\r\n// Create ATA creation instruction\r\nconst createAtaInstruction = createAssociatedTokenAccountIdempotentInstruction(\r\n    keypair.publicKey, // payer\r\n    tokenAccount, // associated token account address\r\n    destination.publicKey, // owner\r\n    mint.publicKey, // mint\r\n);\r\n\r\n// Freeze an ATA \r\nconst freezeInstruction = createFreezeAccountInstruction(\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAtaInstruction,\r\n    freezeInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token accounts created and frozen! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\nBy using just \"raw\" instruction without any abstraction, this is how revoke a token would look like:\r\n\r\n```ts\r\n// Thaw an ATA \r\nconst thawInstruction = createThawAccountInstruction(\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconst transaction = new Transaction().add(thawInstruction);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token account thawed! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\n<ArticleSection name=\"Abstracted Instruction\" id=\"abstracted-instruction\" level=\"h2\" />\r\n\r\nThis is how the same instructions would look like abstracted away with the `freezeAccount()` instruction:\r\n\r\n```ts\r\nconst tokenAccount = Keypair.generate();\r\n\r\nconst ata = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    tokenAccount.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${ata.address}!`)\r\n  \r\nlet tx = await freezeAccount(\r\n    connection,\r\n    keypair,\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconsole.log(`Token Account succesfully Frozen!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)\r\n```\r\n\r\nThis is how the same instructions would look like abstracted away with the `thawAccount()` instruction:\r\n\r\n```ts\r\nlet tx = await thawAccount(\r\n    connection,\r\n    keypair,\r\n    tokenAccount // account\r\n    mint // mint\r\n    keypair.publickey // authority\r\n);\r\n\r\nconsole.log(`Token Account succesfully Thawed!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)\r\n```","highlightedCode":{"code-0":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"const"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" keypair "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"="}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" Keypair."}]},{"type":"element","tagName":"span","properties":{"style":"color:#62E884"},"children":[{"type":"text","value":"generate"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"();"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"const"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" tokenAccount "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"="}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":" await"}]},{"type":"element","tagNa