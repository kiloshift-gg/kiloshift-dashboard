olumn":103,"offset":1475},"end":{"line":35,"column":104,"offset":1476}}}],"position":{"start":{"line":35,"column":1,"offset":1373},"end":{"line":35,"column":104,"offset":1476}}},{"type":"code","lang":"ts","meta":null,"value":"let tx = await burn(\r\n    connection, // connection\r\n    keypair, // payer\r\n    tokenAccount, // token account\r\n    keypair.publicKey, // owner of the token account\r\n    1e6, // amount to transfer\r\n);\r\n\r\nconsole.log(`Succesfully Burned!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)","position":{"start":{"line":37,"column":1,"offset":1480},"end":{"line":47,"column":4,"offset":1803}},"data":{"highlightId":"code-1"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Instruction được kiểm tra","position":{"start":{"line":49,"column":17,"offset":1823},"end":{"line":49,"column":49,"offset":1855}}},{"type":"mdxJsxAttribute","name":"id","value":"checked-instruction","position":{"start":{"line":49,"column":50,"offset":1856},"end":{"line":49,"column":74,"offset":1880}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":49,"column":75,"offset":1881},"end":{"line":49,"column":85,"offset":1891}}}],"children":[],"position":{"start":{"line":49,"column":1,"offset":1807},"end":{"line":49,"column":88,"offset":1894}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":50,"column":1,"offset":1896}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Instruction đốt token\r\n\r\nPhá hủy vĩnh viễn token bằng cách loại bỏ chúng khỏi lưu thông. Điều này làm giảm tổng cung của token.\r\n\r\nTrước khi chúng ta có thể đốt bất kỳ token nào, chúng ta sẽ cần phải có:\r\n- Account `Mint` đã được khởi tạo.\r\n- Account `Token` hoặc account `Associated Token` đã có tối thiểu số lượng chúng ta muốn đốt.\r\n\r\n> Số lượng token chúng ta đốt được \"chuẩn hóa\" với decimal.