nd":{"line":35,"column":88,"offset":1450}}}],"position":{"start":{"line":35,"column":1,"offset":1363},"end":{"line":35,"column":88,"offset":1450}}},{"type":"code","lang":"ts","meta":null,"value":"let tx = await burn(\r\n    connection, // connection\r\n    keypair, // payer\r\n    tokenAccount, // token account\r\n    keypair.publicKey, // owner of the token account\r\n    1e6, // amount to transfer\r\n);\r\n\r\nconsole.log(`Succesfully Burned!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)","position":{"start":{"line":37,"column":1,"offset":1454},"end":{"line":47,"column":4,"offset":1777}},"data":{"highlightId":"code-1"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Checked Instruction","position":{"start":{"line":49,"column":17,"offset":1797},"end":{"line":49,"column":43,"offset":1823}}},{"type":"mdxJsxAttribute","name":"id","value":"checked-instruction","position":{"start":{"line":49,"column":44,"offset":1824},"end":{"line":49,"column":68,"offset":1848}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":49,"column":69,"offset":1849},"end":{"line":49,"column":79,"offset":1859}}}],"children":[],"position":{"start":{"line":49,"column":1,"offset":1781},"end":{"line":49,"column":82,"offset":1862}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":50,"column":1,"offset":1864}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Інструкція спалювання\r\n\r\nНазавжди знищує токени, вилучаючи їх з обігу. Це зменшує загальну пропозицію токена.\r\n\r\nПерш ніж ми зможемо спалити будь-який токен, нам потрібно вже мати:\r\n- Ініціалізований рахунок `Mint`.\r\n- Рахунок `Token` або рахунок `Associated Token`, на якому вже є принаймні та кількість, яку ми хочемо спалити.\r\n\r\n> Кількість токенів, які ми спалюємо, \"нормалізована\" для десяткових знаків. Це означає, що якщо ми хочемо спалити 1 токен, який має 6 десяткових знаків, нам потрібно буде вказати `1e6` як кількість\r\n\r\n<ArticleSection name=\"Raw Instruction\" id=\"raw-instruction\" level=\"h2\" />\r\n\r\nВикористовуючи лише \"сиру\" інструкцію без будь-якої абстракції, спалювання токена виглядатиме так:\r\n\r\n```ts\r\n// Burn tokens to ATA \r\nconst burnInstruction = createBurnInstruction(\r\n    tokenAccount, // token account\r\n    mint, // mint\r\n    keypair.publicKey // owner\r\n    1e6, // amount\r\n);\r\n\r\nconst transaction = new Transaction().add(burnInstruction);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Tokens Burned! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\n<ArticleSection name=\"Abstracted Instruction\" id=\"abstracted-instruction\" level=\"h2\" />\r\n\r\nОсь як ті самі інструкції виглядатимуть з абстракцією за допомогою інструкції `burn()`:\r\n\r\n```ts  \r\nlet tx = await burn(\r\n    connection, // connection\r\n    keypair, // payer\r\n    tokenAccount, // token account\r\n    keypair.publicKey, // owner of the token account\r\n    1e6, // amount to transfer\r\n);\r\n\r\nconsole.log(`Succesfully Burned!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)\r\n```\r\n\r\n<ArticleSection name=\"Checked Instruction\" id=\"checked-instruction\" level=\"h2\" />\r\n","highlightedCode":{"code-0":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#7B7F8B"},"children":[{"type":"text","value":"// Burn tokens to ATA "}]}]},{"type":"text","value":"\n"},{"type":"element","tagName"