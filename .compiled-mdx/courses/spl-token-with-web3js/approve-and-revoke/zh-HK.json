fset":450}}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Raw Instruction","position":{"start":{"line":19,"column":17,"offset":470},"end":{"line":19,"column":39,"offset":492}}},{"type":"mdxJsxAttribute","name":"id","value":"raw-instruction","position":{"start":{"line":19,"column":40,"offset":493},"end":{"line":19,"column":60,"offset":513}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":19,"column":61,"offset":514},"end":{"line":19,"column":71,"offset":524}}}],"children":[],"position":{"start":{"line":19,"column":1,"offset":454},"end":{"line":19,"column":74,"offset":527}}},{"type":"paragraph","children":[{"type":"text","value":"僅使用「原始」指令而不進行任何抽象，以下是批准代幣的方式：","position":{"start":{"line":21,"column":1,"offset":531},"end":{"line":21,"column":30,"offset":560}}}],"position":{"start":{"line":21,"column":1,"offset":531},"end":{"line":21,"column":30,"offset":560}}},{"type":"code","lang":"ts","meta":null,"value":"const keypair = Keypair.generate();\r\n\r\nconst tokenAccount = await getAssociatedTokenAddress(\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n);\r\n\r\n// Create ATA creation instruction\r\nconst createAtaInstruction = createAssociatedTokenAccountIdempotentInstruction(\r\n    keypair.publicKey, // payer\r\n    tokenAccount, // associated token account address\r\n    destination.publicKey, // owner\r\n    mint.publicKey, // mint\r\n);\r\n\r\n// Delegate an ATA\r\nconst approveInstruction = createApproveInstruction(\r\n    tokenAccount // account\r\n    delegate.publicKey, // delegate\r\n    keypair.publickey // owner\r\n    1e6, // amount of tokens\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAtaInstruction,\r\n    approveInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token accounts created and delegated! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":23,"column":1,"offset":564},"end":{"line":55,"column":4,"offset":1534}},"data":{"highlightId":"code-0"}},{"type":"paragraph","children":[{"type":"text","value":"僅使用「原始」指令而不進行任何抽象，以下是撤銷代幣的方式：","position":{"start":{"line":57,"column":1,"offset":1538},"end":{"line":57,"column":30,"offset":1567}}}],"position":{"start":{"line":57,"column":1,"offset":1538},"end":{"line":57,"column":30,"offset":1567}}},{"type":"code","lang":"ts","meta":null,"value":"// Revoke the delegate of an ATA\r\nconst revokeInstruction = createRevokeInstruction(\r\n    tokenAccount // account\r\n    keypair.publickey // owner\r\n);\r\n\r\nconst transaction = new Transaction().add(revokeInstruction);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token account delegate revoked! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":59,"column":1,"offset":1571},"end":{"line":71,"column":4,"offset":2021}},"data":{"highlightId":"code-1"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Abstracted Instruction","position":{"start":{"line":73,"column":17,"offset":2041},"end":{"line":73,"column":46,"offset":2070}}},{"type":"mdxJsxAttribute","name":"id","value":"abstracted-instruction","position":{"start":{"line":73,"column":47,"offset":2071},"end":{"line":73,"column":74,"offset":2098}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":73,"column":75,"offset":2099},"end":{"line":73,"column":85,"offset":2109}}}],"children":[],"position":{"start":{"line":73,"column":1,"offset":2025},"end":{"line":73,"column":88,"offset":2112}}},{"type":"paragraph","children":[{"type":"text","value":"以下是使用","position":{"start":{"line":75,"column":1,"offset":2116},"end":{"line":75,"column":6,"offset":2121}}},{"type":"inlineCode","value":"approve()","position":{"start":{"line":75,"column":6,"offset":2121},"end":{"line":75,"column":17,"offset":2132}}},{"type":"text","value":"指令進行抽象後的相同指令：","position":{"start":{"line":75,"column":17,"offset":2132},"end":{"line":75,"column":30,"offset":2145}}}],"position":{"start":{"line":75,"column":1,"offset":2116},"end":{"line":75,"column":30,"offset":2145}}},{"type":"code","lang":"ts","meta":null,"value":"const tokenAccount = Keypair.generate();\r\n\r\nconst ata = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    tokenAccount.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${ata.address}!`)\r\n\r\nlet tx = await approve(\r\n    connection,\r\n    keypair,\r\n    ata.address, // token Account\r\n    delegate-publicKey, // delegate\r\n    keypair.publicKey, // owner\r\n    1e6, // amount\r\n);\r\n\r\nconsole.log(`Succesfully Delegated!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)","position":{"start":{"line":77,"column":1,"offset":2149},"end":{"line":99,"column":4,"offset":2682}},"data":{"highlightId":"code-2"}},{"type":"paragraph","children":[{"type":"text","value":"以下是使用","position":{"start":{"line":101,"column":1,"offset":2686},"end":{"line":101,"column":6,"offset":2691}}},{"type":"inlineCode","value":"revoke()","position":{"start":{"line":101,"column":6,"offset":2691},"end":{"line":101,"column":16,"offset":2701}}},{"type":"text","value":"指令進行抽象後的相同指令：","position":{"start":{"line":101,"column":16,"offset":2701},"end":{"line":101,"column":29,"offset":2714}}}],"position":{"start":{"line":101,"column":1,"offset":2686},"end":{"line":101,"column":29,"offset":2714}}},{"type":"code","lang":"ts","meta":null,"value":"let tx = await revoke(\r\n    connection,\r\n    keypair,\r\n    ata.address, // token Account\r\n    keypair.publicKey, // owner\r\n);\r\n\r\nconsole.log(`Succesfully Revoked Delegate!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)","position":{"start":{"line":103,"column":1,"offset":2718},"end":{"line":112,"column":4,"offset":2974}},"data":{"highlightId":"code-3"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":112,"column":4,"offset":2974}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# 批准和撤銷指令\r\n\r\n批准授予代理人代表帳戶擁有者轉移特定數量代幣的權限。這使得程式化的代幣轉移成為可能，而無需授予完整的帳戶控制權。\r\n\r\n> 我們設定一個「批准」的數量，代理人只能轉移不超過該數量的代幣\r\n\r\n撤銷會移除當前代理人對帳戶的權限，將完整控制權返回給帳戶擁有者。\r\n\r\n> 立即取消任何現有的代理權，並且只有帳戶擁有者可以撤銷代理權（代理人本身無法撤銷）\r\n\r\n在我們可以代理或撤銷任何代幣帳戶之前，我們需要已經完成以下操作：\r\n- 初始化了一個`Mint`帳戶\r\n- 初始化了一個`Token`帳戶或`Associated Token`帳戶，我們將控制該帳戶\r\n\r\n> 我們批准的代幣數量是根據小數位數「標準化」的。這意味著，如果我們想批准1個有6位小數的代幣，我們實際上需要輸入`1e6`作為數量\r\n\r\n<ArticleSection name=\"Raw Instruction\" id=\"raw-instruction\" level=\"h2\" />\r\n\r\n僅使用「原始」指令而不進行任何抽象，以下是批准代幣的方式：\r\n\r\n```ts\r\nconst keypair = Keypair.generate();\r\n\r\nconst tokenAccount = await getAssociatedTokenAddress(\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n);\r\n\r\n// Create ATA creation instruction\r\nconst createAtaInstruction = createAssociatedTokenAccountIdempotentInstruction(\r\n    keypair.publicKey, // payer\r\n    tokenAccount, // associated token account address\r\n    destination.publicKey, // owner\r\n    mint.publicKey, // mint\r\n);\r\n\r\n// Delegate an ATA\r\nconst approveInstruction = createApproveInstruction(\r\n    tokenAccount // account\r\n    delegate.publicKey, // delegate\r\n    keypair.publickey // owner\r\n    1e6, // amount of tokens\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAtaInstruction,\r\n    approveInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token accounts created and delegated! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\n僅使用「原始」指令而不進行任何抽象，以下是撤銷代幣的方式：\r\n\r\n```ts\r\n// Revoke the delegate of an ATA\r\nconst revokeInstruction = createRevokeInstruction(\r\n    tokenAccount // account\r\n    keypair.publickey // owner\r\n);\r\n\r\nconst transaction = new Transaction().add(revokeInstruction);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token account delegate revoked! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\n<ArticleSection name=\"Abstracted Instruction\" id=\"abstracted-instruction\" level=\"h2\" />\r\n\r\n以下是使用`approve()`指令進行抽象後的相同指令：\r\n\r\n```ts\r\nconst tokenAccount = Keypair.generate();\r\n\r\nconst ata = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    tokenAccount.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${ata.address}!`)\r\n\r\nlet tx = await approve(\r\n    connection,\r\n    keypair,\r\n    ata.address, // token Account\r\n    delegate-publicKey, // delegate\r\n    keypair.publicKey, // owner\r\n    1e6, // amount\r\n);\r\n\r\nconsole.log(`Succesfully Delegated!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)\r\n```\r\n\r\n以下是使用`revoke()`指令進行抽象後的相同指令：\r\n\r\n```ts\r\nlet tx = await revoke(\r\n    connection,\r\n    keypair,\r\n    ata.address, // token Account\r\n    keypair.publicKey, // owner\r\n);\r\n\r\nconsole.log(`Succesfully Revoked Delegate!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)\r\n```","highlightedCode":{"code-0":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"const"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"childr