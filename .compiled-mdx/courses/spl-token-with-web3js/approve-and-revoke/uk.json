":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Ініціалізований ","position":{"start":{"line":14,"column":3,"offset":790},"end":{"line":14,"column":19,"offset":806}}},{"type":"inlineCode","value":"Mint","position":{"start":{"line":14,"column":19,"offset":806},"end":{"line":14,"column":25,"offset":812}}},{"type":"text","value":" рахунок","position":{"start":{"line":14,"column":25,"offset":812},"end":{"line":14,"column":33,"offset":820}}}],"position":{"start":{"line":14,"column":3,"offset":790},"end":{"line":14,"column":33,"offset":820}}}],"position":{"start":{"line":14,"column":1,"offset":788},"end":{"line":14,"column":33,"offset":820}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Ініціалізований ","position":{"start":{"line":15,"column":3,"offset":824},"end":{"line":15,"column":19,"offset":840}}},{"type":"inlineCode","value":"Token","position":{"start":{"line":15,"column":19,"offset":840},"end":{"line":15,"column":26,"offset":847}}},{"type":"text","value":" рахунок або ","position":{"start":{"line":15,"column":26,"offset":847},"end":{"line":15,"column":39,"offset":860}}},{"type":"inlineCode","value":"Associated Token","position":{"start":{"line":15,"column":39,"offset":860},"end":{"line":15,"column":57,"offset":878}}},{"type":"text","value":" рахунок, над яким ми збираємося отримати контроль","position":{"start":{"line":15,"column":57,"offset":878},"end":{"line":15,"column":107,"offset":928}}}],"position":{"start":{"line":15,"column":3,"offset":824},"end":{"line":15,"column":107,"offset":928}}}],"position":{"start":{"line":15,"column":1,"offset":822},"end":{"line":15,"column":107,"offset":928}}}],"position":{"start":{"line":14,"column":1,"offset":788},"end":{"line":15,"column":107,"offset":928}}},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"Кількість токенів, які ми схвалюємо, \"нормалізується\" для десяткових знаків. Це означає, що якщо ми хочемо схвалити 1 токен, який має 6 десяткових знаків, нам потрібно буде фактично вказати ","position":{"start":{"line":17,"column":3,"offset":934},"end":{"line":17,"column":193,"offset":1124}}},{"type":"inlineCode","value":"1e6","position":{"start":{"line":17,"column":193,"offset":1124},"end":{"line":17,"column":198,"offset":1129}}},{"type":"text","value":" як суму","position":{"start":{"line":17,"column":198,"offset":1129},"end":{"line":17,"column":206,"offset":1137}}}],"position":{"start":{"line":17,"column":3,"offset":934},"end":{"line":17,"column":206,"offset":1137}}}],"position":{"start":{"line":17,"column":1,"offset":932},"end":{"line":17,"column":206,"offset":1137}}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Raw Instruction","position":{"start":{"line":19,"column":17,"offset":1157},"end":{"line":19,"column":39,"offset":1179}}},{"type":"mdxJsxAttribute","name":"id","value":"raw-instruction","position":{"start":{"line":19,"column":40,"offset":1180},"end":{"line":19,"column":60,"offset":1200}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":19,"column":61,"offset":1201},"end":{"line":19,"column":71,"offset":1211}}}],"children":[],"position":{"start":{"line":19,"column":1,"offset":1141},"end":{"line":19,"column":74,"offset":1214}}},{"type":"paragraph","children":[{"type":"text","value":"Використовуючи лише \"сиру\" інструкцію без будь-якої абстракції, схвалення токена виглядатиме так:","position":{"start":{"line":21,"column":1,"offset":1218},"end":{"line":21,"column":98,"offset":1315}}}],"position":{"start":{"line":21,"column":1,"offset":1218},"end":{"line":21,"column":98,"offset":1315}}},{"type":"code","lang":"ts","meta":null,"value":"const keypair = Keypair.generate();\r\n\r\nconst tokenAccount = await getAssociatedTokenAddress(\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n);\r\n\r\n// Create ATA creation instruction\r\nconst createAtaInstruction = createAssociatedTokenAccountIdempotentInstruction(\r\n    keypair.publicKey, // payer\r\n    tokenAccount, // associated token account address\r\n    destination.publicKey, // owner\r\n    mint.publicKey, // mint\r\n);\r\n\r\n// Delegate an ATA \r\nconst approveInstruction = createApproveInstruction(\r\n    tokenAccount // account\r\n    delegate.publicKey, // delegate\r\n    keypair.publickey // owner\r\n    1e6, // amount of tokens\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAtaInstruction,\r\n    approveInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token accounts created and delegated! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":23,"column":1,"offset":1319},"end":{"line":55,"column":4,"offset":2290}},"data":{"highlightId":"code-0"}},{"type":"paragraph","children":[{"type":"text","value":"Використовуючи лише \"сиру\" інструкцію без будь-якої абстракції, скасування дозволу на токен виглядатиме так:","position":{"start":{"line":57,"column":1,"offset":2294},"end":{"line":57,"column":109,"offset":2402}}}],"position":{"start":{"line":57,"column":1,"offset":2294},"end":{"line":57,"column":109,"offset":2402}}},{"type":"code","lang":"ts","meta":null,"value":"// Revoke the delegate of an ATA \r\nconst revokeInstruction = createRevokeInstruction(\r\n    tokenAccount // account\r\n    keypair.publickey // owner\r\n);\r\n\r\nconst transaction = new Transaction().add(revokeInstruction);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token account delegate revoked! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":59,"column":1,"offset":2406},"end":{"line":71,"column":4,"offset":2857}},"data":{"highlightId":"code-1"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Abstracted Instruction","position":{"start":{"line":73,"column":17,"offset":2877},"end":{"line":73,"column":46,"offset":2906}}},{"type":"mdxJsxAttribute","name":"id","value":"abstracted-instruction","position":{"start":{"line":73,"column":47,"offset":2907},"end":{"line":73,"column":74,"offset":2934}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":73,"column":75,"offset":2935},"end":{"line":73,"column":85,"offset":2945}}}],"children":[],"position":{"start":{"line":73,"column":1,"offset":2861},"end":{"line":73,"column":88,"offset":2948}}},{"type":"paragraph","children":[{"type":"text","value":"Ось як ті самі інструкції виглядатимуть з абстракцією за допомогою інструкції ","position":{"start":{"line":75,"column":1,"offset":2952},"end":{"line":75,"column":79,"offset":3030}}},{"type":"inlineCode","value":"approve()","position":{"start":{"line":75,"column":79,"offset":3030},"end":{"line":75,"column":90,"offset":3041}}},{"type":"text","value":":","position":{"start":{"line":75,"column":90,"offset":3041},"end":{"line":75,"column":91,"offset":3042}}}],"position":{"start":{"line":75,"column":1,"offset":2952},"end":{"line":75,"column":91,"offset":3042}}},{"type":"code","lang":"ts","meta":null,"value":"const tokenAccount = Keypair.generate();\r\n\r\nconst ata = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    tokenAccount.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${ata.address}!`)\r\n  \r\nlet tx = await approve(\r\n    connection,\r\n    keypair,\r\n    ata.address, // token Account\r\n    delegate-publicKey, // delegate\r\n    keypair.publicKey, // owner\r\n    1e6, // amount\r\n);\r\n\r\nconsole.log(`Succesfully Delegated!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)","position":{"start":{"line":77,"column":1,"offset":3046},"end":{"line":99,"column":4,"offset":3581}},"data":{"highlightId":"code-2"}},{"type":"paragraph","children":[{"type":"text","value":"Ось як ті самі інструкції виглядатимуть з абстракцією за допомогою інструкції ","position":{"start":{"line":101,"column":1,"offset":3585},"end":{"line":101,"column":79,"offset":3663}}},{"type":"inlineCode","value":"revoke()","position":{"start":{"line":101,"column":79,"offset":3663},"end":{"line":101,"column":89,"offset":3673}}},{"type":"text","value":":","position":{"start":{"line":101,"column":89,"offset":3673},"end":{"line":101,"column":90,"offset":3674}}}],"position":{"start":{"line":101,"column":1,"offset":3585},"end":{"line":101,"column":90,"offset":3674}}},{"type":"code","lang":"ts","meta":null,"value":"let tx = await revoke(\r\n    connection,\r\n    keypair,\r\n    ata.address, // token Account\r\n    keypair.publicKey, // owner\r\n);\r\n\r\nconsole.log(`Succesfully Revoked Delegate!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)","position":{"start":{"line":103,"column":1,"offset":3678},"end":{"line":112,"column":4,"offset":3934}},"data":{"highlightId":"code-3"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":112,"column":4,"offset":3934}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Інструкції з надання та скасування дозволів\r\n\r\nНадання дозволу (Approve) дає делегату право переказувати певну кількість токенів від імені власника рахунку. Це дозволяє здійснювати програмні перекази токенів без надання повного контролю над рахунком.\r\n\r\n> Ми встановлюємо \"схвалену\" суму, і делегат може переказувати лише до цієї суми\r\n\r\nСкасування дозволу (Revoke) видаляє поточні повноваження делегата над рахунком, повертаючи повний контроль власнику рахунку.\r\n\r\n> Негайно скасовує будь-яке існуюче делегування, і лише власник рахунку може скасувати делегування (не сам делегат)\r\n\r\nПерш ніж ми зможемо делегувати або скасувати делегування для будь-якого токен-рахунку, нам потрібно вже мати:\r\n- Ініціалізований `Mint` рахунок\r\n- Ініціалізований `Token` рахунок або `Associated Token` рахунок, над яким ми збираємося отримати контроль\r\n\r\n> Кількість токенів, які ми схвалюємо, \"нормалізується\" для десяткових знаків. Це означає, що якщо ми хочемо схвалити 1 токен, який має 6 десяткових знаків, нам потрібно буде фактично вказати `1e6` як суму\r\n\r\n<ArticleSection name=\"Raw Instruction\" id=\"raw-instruction\" level=\"h2\" />\r\n\r\nВикористовуючи лише \"сиру\" інструкцію без будь-якої абстракції, схвалення токена виглядатиме так:\r\n\r\n```ts\r\nconst keypair = Keypair.generate();\r\n\r\nconst tokenAccount = await getAssociatedTokenAddress(\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n);\r\n\r\n// Create ATA creation instruction\r\nconst createAtaInstruction = createAssociatedTokenAccountIdempotentInstruction(\r\n    keypair.publicKey, // payer\r\n    tokenAccount, // associated token account address\r\n    destination.publicKey, // owner\r\n    mint.publicKey, // mint\r\n);\r\n\r\n// Delegate an ATA \r\nconst approveInstruction = createApproveInstruction(\r\n    tokenAccount // account\r\n    delegate.publicKey, // delegate\r\n    keypair.publickey // owner\r\n    1e6, // amount of tokens\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAtaInstruction,\r\n    approveInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token accounts created and delegated! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\nВикористовуючи лише \"сиру\" інструкцію без будь-якої абстракції, скасування дозволу на токен виглядатиме так:\r\n\r\n```ts\r\n// Revoke the delegate of an ATA \r\nconst revokeInstruction = createRevokeInstruction(\r\n    tokenAccount // account\r\n    keypair.publickey // owner\r\n);\r\n\r\nconst transaction = new Transaction().add(revokeInstruction);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token account delegate revoked! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\n<ArticleSection name=\"Abstracted Instruction\" id=\"abstracted-instruction\" level=\"h2\" />\r\n\r\nОсь як ті самі інструкції виглядатимуть з абстракцією за допомогою інструкції `approve()`:\r\n\r\n```ts\r\nconst tokenAccount = Keypair.generate();\r\n\r\nconst ata = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    tokenAccount.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${ata.address}!`)\r\n  \r\nlet tx = await approve(\r\n    connection,\r\n    keypair,\r\n    ata.address, // token Account\r\n    delegate-publicKey, // delegate\r\n    keypair.publicKey, // owner\r\n    1e6, // amount\r\n);\r\n\r\nconsole.log(`Succesfully Delegated!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)\r\n```\r\n\r\nОсь як ті самі інструкції виглядатимуть з абстракцією за допомогою інструкції `revoke()`:\r\n\r\n```ts\r\nlet tx = await revoke(\r\n    connection,\r\n    keypair,\r\n    ata.address, // token Account\r\n    keypair.publicKey, // owner\r\n);\r\n\r\nconsole.log(`Succesfully Revoked Delegate!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)\r\n```","highlightedCode":{"code-0":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"const"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type"