ess(\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n);\r\n\r\n// Create ATA creation instruction\r\nconst createAtaInstruction = createAssociatedTokenAccountIdempotentInstruction(\r\n    keypair.publicKey, // payer\r\n    tokenAccount, // associated token account address\r\n    destination.publicKey, // owner\r\n    mint.publicKey, // mint\r\n);\r\n\r\n// Delegate an ATA \r\nconst approveInstruction = createApproveInstruction(\r\n    tokenAccount // account\r\n    delegate.publicKey, // delegate\r\n    keypair.publickey // owner\r\n    1e6, // amount of tokens\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAtaInstruction,\r\n    approveInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token accounts created and delegated! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":23,"column":1,"offset":1392},"end":{"line":55,"column":4,"offset":2363}},"data":{"highlightId":"code-0"}},{"type":"paragraph","children":[{"type":"text","value":"Bei Verwendung einer \"rohen\" Anweisung ohne Abstraktion würde der Widerruf eines Tokens so aussehen:","position":{"start":{"line":57,"column":1,"offset":2367},"end":{"line":57,"column":101,"offset":2467}}}],"position":{"start":{"line":57,"column":1,"offset":2367},"end":{"line":57,"column":101,"offset":2467}}},{"type":"code","lang":"ts","meta":null,"value":"// Revoke the delegate of an ATA \r\nconst revokeInstruction = createRevokeInstruction(\r\n    tokenAccount // account\r\n    keypair.publickey // owner\r\n);\r\n\r\nconst transaction = new Transaction().add(revokeInstruction);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token account delegate revoked! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":59,"column":1,"offset":2471},"end":{"line":71,"column":4,"offset":2922}},"data":{"highlightId":"code-1"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Abstracted Instruction","position":{"start":{"line":73,"column":17,"offset":2942},"end":{"line":73,"column":46,"offset":2971}}},{"type":"mdxJsxAttribute","name":"id","value":"abstracted-instruction","position":{"start":{"line":73,"column":47,"offset":2972},"end":{"line":73,"column":74,"offset":2999}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":73,"column":75,"offset":3000},"end":{"line":73,"column":85,"offset":3010}}}],"children":[],"position":{"start":{"line":73,"column":1,"offset":2926},"end":{"line":73,"column":88,"offset":3013}}},{"type":"paragraph","children":[{"type":"text","value":"So würden die gleichen Anweisungen aussehen, wenn sie mit der ","position":{"start":{"line":75,"column":1,"offset":3017},"end":{"line":75,"column":63,"offset":3079}}},{"type":"inlineCode","value":"approve()","position":{"start":{"line":75,"column":63,"offset":3079},"end":{"line":75,"column":74,"offset":3090}}},{"type":"text","value":" Anweisung abstrahiert werden:","position":{"start":{"line":75,"column":74,"offset":3090},"end":{"line":75,"column":104,"offset":3120}}}],"position":{"start":{"line":75,"column":1,"offset":3017},"end":{"line":75,"column":104,"offset":3120}}},{"type":"code","lang":"ts","meta":null,"value":"const tokenAccount = Keypair.generate();\r\n\r\nconst ata = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    tokenAccount.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${ata.address}!`)\r\n  \r\nlet tx = await approve(\r\n    connection,\r\n    keypair,\r\n    ata.address, // token Account\r\n    delegate-publicKey, // delegate\r\n    keypair.publicKey, // owner\r\n    1e6, // amount\r\n);\r\n\r\nconsole.log(`Succesfully Delegated!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)","position":{"start":{"line":77,"column":1,"offset":3124},"end":{"line":99,"column":4,"offset":3659}},"data":{"highlightId":"code-2"}},{"type":"paragraph","children":[{"type":"text","value":"So würden die gleichen Anweisungen aussehen, wenn sie mit der ","position":{"start":{"line":101,"column":1,"offset":3663},"end":{"line":101,"column":63,"offset":3725}}},{"type":"inlineCode","value":"revoke()","position":{"start":{"line":101,"column":63,"offset":3725},"end":{"line":101,"column":73,"offset":3735}}},{"type":"text","value":" Anweisung abstrahiert werden:","position":{"start":{"line":101,"column":73,"offset":3735},"end":{"line":101,"column":103,"offset":3765}}}],"position":{"start":{"line":101,"column":1,"offset":3663},"end":{"line":101,"column":103,"offset":3765}}},{"type":"code","lang":"ts","meta":null,"value":"let tx = await revoke(\r\n    connection,\r\n    keypair,\r\n    ata.address, // token Account\r\n    keypair.publicKey, // owner\r\n);\r\n\r\nconsole.log(`Succesfully Revoked Delegate!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)","position":{"start":{"line":103,"column":1,"offset":3769},"end":{"line":112,"column":4,"offset":4025}},"data":{"highlightId":"code-3"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":112,"column":4,"offset":4025}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Approve- und Revoke-Anweisungen\r\n\r\nApprove erteilt einem Delegierten die Berechtigung, eine bestimmte Menge an Token im Namen des Kontoinhabers zu übertragen. Dies ermöglicht programmgesteuerte Token-Übertragungen, ohne die vollständige Kontrolle über das Konto zu gewähren.\r\n\r\n> Wir legen einen \"genehmigten\" Betrag fest, und der Delegierte kann nur bis zu diesem Betrag übertragen\r\n\r\nRevoke entzieht dem aktuellen Delegierten die Berechtigung über das Konto und gibt die vollständige Kontrolle an den Kontoinhaber zurück.\r\n\r\n> Hebt sofort jede bestehende Delegation auf, und nur der Kontoinhaber kann die Delegation widerrufen (nicht der Delegierte selbst)\r\n\r\nBevor wir ein Token-Konto delegieren oder widerrufen können, müssen wir bereits Folgendes haben:\r\n- Ein initialisiertes `Mint` Konto\r\n- Ein initialisiertes `Token` Konto oder `Associated Token` Konto, über das wir die Kontrolle übernehmen wollen\r\n\r\n> Die Menge an Tokens, die wir genehmigen, wird für Dezimalstellen \"normalisiert\". Das bedeutet, wenn wir 1 Token mit 6 Dezimalstellen genehmigen wollen, müssen wir tatsächlich `1e6` als Betrag angeben\r\n\r\n<ArticleSection name=\"Raw Instruction\" id=\"raw-instruction\" level=\"h2\" />\r\n\r\nBei Verwendung einer \"rohen\" Anweisung ohne Abstraktion würde die Genehmigung eines Tokens so aussehen:\r\n\r\n```ts\r\nconst keypair = Keypair.generate();\r\n\r\nconst tokenAccount = await getAssociatedTokenAddress(\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n);\r\n\r\n// Create ATA creation instruction\r\nconst createAtaInstruction = createAssociatedTokenAccountIdempotentInstruction(\r\n    keypair.publicKey, // payer\r\n    tokenAccount, // associated token account address\r\n    destination.publicKey, // owner\r\n    mint.publicKey, // mint\r\n);\r\n\r\n// Delegate an ATA \r\nconst approveInstruction = createApproveInstruction(\r\n    tokenAccount // account\r\n    delegate.publicKey, // delegate\r\n    keypair.publickey // owner\r\n    1e6, // amount of tokens\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAtaInstruction,\r\n    approveInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token accounts created and delegated! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\nBei Verwendung einer \"rohen\" Anweisung ohne Abstraktion würde der Widerruf eines Tokens so aussehen:\r\n\r\n```ts\r\n// Revoke the delegate of an ATA \r\nconst revokeInstruction = createRevokeInstruction(\r\n    tokenAccount // account\r\n    keypair.publickey // owner\r\n);\r\n\r\nconst transaction = new Transaction().add(revokeInstruction);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token account delegate revoked! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\n<ArticleSection name=\"Abstracted Instruction\" id=\"abstracted-instruction\" level=\"h2\" />\r\n\r\nSo würden die gleichen Anweisungen aussehen, wenn sie mit der `approve()` Anweisung abstrahiert werden:\r\n\r\n```ts\r\nconst tokenAccount = Keypair.generate();\r\n\r\nconst ata = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    tokenAccount.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${ata.address}!`)\r\n  \r\nlet tx = await approve(\r\n    connection,\r\n    keypair,\r\n    ata.address, // token Account\r\n    delegate-publicKey, // delegate\r\n    keypair.publicKey, // owner\r\n    1e6, // amount\r\n);\r\n\r\nconsole.log(`Succesfully Delegated!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)\r\n```\r\n\r\nSo würden die gleichen Anweisungen aussehen, wenn sie mit der `revoke()` Anweisung abstrahiert werden:\r\n\r\n```ts\r\nlet tx = await revoke(\r\n    connection,\r\n    keypair,\r\n    ata.address, // token Account\r\n    keypair.publicKey, // owner\r\n);\r\n\r\nconsole.log(`Succesfully Revoked Delegate!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)\r\n```","highlightedCode":{"code-0":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","ta