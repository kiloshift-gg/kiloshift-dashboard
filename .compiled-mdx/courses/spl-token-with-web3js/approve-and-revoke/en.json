on(\r\n    keypair.publicKey, // payer\r\n    tokenAccount, // associated token account address\r\n    destination.publicKey, // owner\r\n    mint.publicKey, // mint\r\n);\r\n\r\n// Delegate an ATA \r\nconst approveInstruction = createApproveInstruction(\r\n    tokenAccount // account\r\n    delegate.publicKey, // delegate\r\n    keypair.publickey // owner\r\n    1e6, // amount of tokens\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAtaInstruction,\r\n    approveInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token accounts created and delegated! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":23,"column":1,"offset":1221},"end":{"line":55,"column":4,"offset":2192}},"data":{"highlightId":"code-0"}},{"type":"paragraph","children":[{"type":"text","value":"By using just \"raw\" instruction without any abstraction, this is how revoke a token would look like:","position":{"start":{"line":57,"column":1,"offset":2196},"end":{"line":57,"column":101,"offset":2296}}}],"position":{"start":{"line":57,"column":1,"offset":2196},"end":{"line":57,"column":101,"offset":2296}}},{"type":"code","lang":"ts","meta":null,"value":"// Revoke the delegate of an ATA \r\nconst revokeInstruction = createRevokeInstruction(\r\n    tokenAccount // account\r\n    keypair.publickey // owner\r\n);\r\n\r\nconst transaction = new Transaction().add(revokeInstruction);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token account delegate revoked! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":59,"column":1,"offset":2300},"end":{"line":71,"column":4,"offset":2751}},"data":{"highlightId":"code-1"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Abstracted Instruction","position":{"start":{"line":73,"column":17,"offset":2771},"end":{"line":73,"column":46,"offset":2800}}},{"type":"mdxJsxAttribute","name":"id","value":"abstracted-instruction","position":{"start":{"line":73,"column":47,"offset":2801},"end":{"line":73,"column":74,"offset":2828}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":73,"column":75,"offset":2829},"end":{"line":73,"column":85,"offset":2839}}}],"children":[],"position":{"start":{"line":73,"column":1,"offset":2755},"end":{"line":73,"column":88,"offset":2842}}},{"type":"paragraph","children":[{"type":"text","value":"This is how the same instructions would look like abstracted away with the ","position":{"start":{"line":75,"column":1,"offset":2846},"end":{"line":75,"column":76,"offset":2921}}},{"type":"inlineCode","value":"approve()","position":{"start":{"line":75,"column":76,"offset":2921},"end":{"line":75,"column":87,"offset":2932}}},{"type":"text","value":" instruction:","position":{"start":{"line":75,"column":87,"offset":2932},"end":{"line":75,"column":100,"offset":2945}}}],"position":{"start":{"line":75,"column":1,"offset":2846},"end":{"line":75,"column":100,"offset":2945}}},{"type":"code","lang":"ts","meta":null,"value":"const tokenAccount = Keypair.generate();\r\n\r\nconst ata = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    tokenAccount.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${ata.address}!`)\r\n  \r\nlet tx = await approve(\r\n    connection,\r\n    keypair,\r\n    ata.address, // token Account\r\n    delegate-publicKey, // delegate\r\n    keypair.publicKey, // owner\r\n    1e6, // amount\r\n);\r\n\r\nconsole.log(`Succesfully Delegated!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)","position":{"start":{"line":77,"column":1,"offset":2949},"end":{"line":99,"column":4,"offset":3484}},"data":{"highlightId":"code-2"}},{"type":"paragraph","children":[{"type":"text","value":"This is how the same instructions would look like abstracted away with the ","position":{"start":{"line":101,"column":1,"offset":3488},"end":{"line":101,"column":76,"offset":3563}}},{"type":"inlineCode","value":"revoke()","position":{"start":{"line":101,"column":76,"offset":3563},"end":{"line":101,"column":86,"offset":3573}}},{"type":"text","value":" instruction:","position":{"start":{"line":101,"column":86,"offset":3573},"end":{"line":101,"column":99,"offset":3586}}}],"position":{"start":{"line":101,"column":1,"offset":3488},"end":{"line":101,"column":99,"offset":3586}}},{"type":"code","lang":"ts","meta":null,"value":"let tx = await revoke(\r\n    connection,\r\n    keypair,\r\n    ata.address, // token Account\r\n    keypair.publicKey, // owner\r\n);\r\n\r\nconsole.log(`Succesfully Revoked Delegate!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)","position":{"start":{"line":103,"column":1,"offset":3590},"end":{"line":112,"column":4,"offset":3846}},"data":{"highlightId":"code-3"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":112,"column":4,"offset":3846}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Approve and Revoke Instructions\r\n\r\nApprove grants a delegate the authority to transfer a specific amount of tokens on behalf of the account owner. This enables programmatic token transfers without giving full account control.\r\n\r\n> We set an \"approved\" amount, and the delegate can transfer only up to that amount\r\n\r\nRevoke removes the current delegate's authority over the account, returning full control to the account owner.\r\n\r\n> Immediately cancels any existing delegation and only the account owner can revoke delegation (not the delegate itself)\r\n\r\nBefore we can delegate or revoke any token account, we'll need to already have:\r\n- Initialized a `Mint` account\r\n- Initialized a `Token` account or `Associated Token` account where we're going to take control of\r\n\r\n> The amount of tokens we approve are \"normalized\" for decimals. This means that if we want to approve 1 token that has 6 decimals, we'll need to actually put `1e6` as amount\r\n\r\n<ArticleSection name=\"Raw Instruction\" id=\"raw-instruction\" level=\"h2\" />\r\n\r\nBy using just \"raw\" instruction without any abstraction, this is how approve a token would look like:\r\n\r\n```ts\r\nconst keypair = Keypair.generate();\r\n\r\nconst tokenAccount = await getAssociatedTokenAddress(\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n);\r\n\r\n// Create ATA creation instruction\r\nconst createAtaInstruction = createAssociatedTokenAccountIdempotentInstruction(\r\n    keypair.publicKey, // payer\r\n    tokenAccount, // associated token account address\r\n    destination.publicKey, // owner\r\n    mint.publicKey, // mint\r\n);\r\n\r\n// Delegate an ATA \r\nconst approveInstruction = createApproveInstruction(\r\n    tokenAccount // account\r\n    delegate.publicKey, // delegate\r\n    keypair.publickey // owner\r\n    1e6, // amount of tokens\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAtaInstruction,\r\n    approveInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token accounts created and delegated! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\nBy using just \"raw\" instruction without any abstraction, this is how revoke a token would look like:\r\n\r\n```ts\r\n// Revoke the delegate of an ATA \r\nconst revokeInstruction = createRevokeInstruction(\r\n    tokenAccount // account\r\n    keypair.publickey // owner\r\n);\r\n\r\nconst transaction = new Transaction().add(revokeInstruction);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token account delegate revoked! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\n<ArticleSection name=\"Abstracted Instruction\" id=\"abstracted-instruction\" level=\"h2\" />\r\n\r\nThis is how the same instructions would look like abstracted away with the `approve()` instruction:\r\n\r\n```ts\r\nconst tokenAccount = Keypair.generate();\r\n\r\nconst ata = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    tokenAccount.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${ata.address}!`)\r\n  \r\nlet tx = await approve(\r\n    connection,\r\n    keypair,\r\n    ata.address, // token Account\r\n    delegate-publicKey, // delegate\r\n    keypair.publicKey, // owner\r\n    1e6, // amount\r\n);\r\n\r\nconsole.log(`Succesfully Delegated!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)\r\n```\r\n\r\nThis is how the same instructions would look like abstracted away with the `revoke()` instruction:\r\n\r\n```ts\r\nlet tx = await revoke(\r\n    connection,\r\n    keypair,\r\n    ata.address, // token Account\r\n    keypair.publicKey, // owner\r\n);\r\n\r\nconsole.log(`Succesfully Revoked Delegate!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)\r\n```","highlightedCode":{"code-0":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"const"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" keypair "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"="}]},{"type":"element","tagName":"sp