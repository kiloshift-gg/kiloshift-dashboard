nconst createAtaInstruction = createAssociatedTokenAccountIdempotentInstruction(\r\n    keypair.publicKey, // payer\r\n    tokenAccount, // associated token account address\r\n    destination.publicKey, // owner\r\n    mint.publicKey, // mint\r\n);\r\n\r\n// Delegate an ATA \r\nconst approveInstruction = createApproveInstruction(\r\n    tokenAccount // account\r\n    delegate.publicKey, // delegate\r\n    keypair.publickey // owner\r\n    1e6, // amount of tokens\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAtaInstruction,\r\n    approveInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token accounts created and delegated! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":23,"column":1,"offset":1297},"end":{"line":55,"column":4,"offset":2268}},"data":{"highlightId":"code-0"}},{"type":"paragraph","children":[{"type":"text","value":"Bằng cách chỉ sử dụng instruction \"thô\" mà không có bất kỳ abstraction nào, đây là cách revoke token:","position":{"start":{"line":57,"column":1,"offset":2272},"end":{"line":57,"column":102,"offset":2373}}}],"position":{"start":{"line":57,"column":1,"offset":2272},"end":{"line":57,"column":102,"offset":2373}}},{"type":"code","lang":"ts","meta":null,"value":"// Revoke the delegate of an ATA \r\nconst revokeInstruction = createRevokeInstruction(\r\n    tokenAccount // account\r\n    keypair.publickey // owner\r\n);\r\n\r\nconst transaction = new Transaction().add(revokeInstruction);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token account delegate revoked! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":59,"column":1,"offset":2377},"end":{"line":71,"column":4,"offset":2828}},"data":{"highlightId":"code-1"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Instruction được trừu tượng hóa","position":{"start":{"line":73,"column":17,"offset":2848},"end":{"line":73,"column":55,"offset":2886}}},{"type":"mdxJsxAttribute","name":"id","value":"abstracted-instruction","position":{"start":{"line":73,"column":56,"offset":2887},"end":{"line":73,"column":83,"offset":2914}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":73,"column":84,"offset":2915},"end":{"line":73,"column":94,"offset":2925}}}],"children":[],"position":{"start":{"line":73,"column":1,"offset":2832},"end":{"line":73,"column":97,"offset":2928}}},{"type":"paragraph","children":[{"type":"text","value":"Đây là cách các instruction tương tự sẽ trông như thế nào được khi được trừu tượng hóa với instruction ","position":{"start":{"line":75,"column":1,"offset":2932},"end":{"line":75,"column":104,"offset":3035}}},{"type":"inlineCode","value":"approve()","position":{"start":{"line":75,"column":104,"offset":3035},"end":{"line":75,"column":115,"offset":3046}}},{"type":"text","value":":","position":{"start":{"line":75,"column":115,"offset":3046},"end":{"line":75,"column":116,"offset":3047}}}],"position":{"start":{"line":75,"column":1,"offset":2932},"end":{"line":75,"column":116,"offset":3047}}},{"type":"code","lang":"ts","meta":null,"value":"const tokenAccount = Keypair.generate();\r\n\r\nconst ata = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    tokenAccount.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${ata.address}!`)\r\n  \r\nlet tx = await approve(\r\n    connection,\r\n    keypair,\r\n    ata.address, // token Account\r\n    delegate-publicKey, // delegate\r\n    keypair.publicKey, // owner\r\n    1e6, // amount\r\n);\r\n\r\nconsole.log(`Succesfully Delegated!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)","position":{"start":{"line":77,"column":1,"offset":3051},"end":{"line":99,"column":4,"offset":3586}},"data":{"highlightId":"code-2"}},{"type":"paragraph","children":[{"type":"text","value":"Đây là cách các instruction tương tự sẽ trông như thế nào khi được trừu tượng hóa với instruction ","position":{"start":{"line":101,"column":1,"offset":3590},"end":{"line":101,"column":99,"offset":3688}}},{"type":"inlineCode","value":"revoke()","position":{"start":{"line":101,"column":99,"offset":3688},"end":{"line":101,"column":109,"offset":3698}}},{"type":"text","value":":","position":{"start":{"line":101,"column":109,"offset":3698},"end":{"line":101,"column":110,"offset":3699}}}],"position":{"start":{"line":101,"column":1,"offset":3590},"end":{"line":101,"column":110,"offset":3699}}},{"type":"code","lang":"ts","meta":null,"value":"let tx = await revoke(\r\n    connection,\r\n    keypair,\r\n    ata.address, // token Account\r\n    keypair.publicKey, // owner\r\n);\r\n\r\nconsole.log(`Succesfully Revoked Delegate!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)","position":{"start":{"line":103,"column":1,"offset":3703},"end":{"line":112,"column":4,"offset":3959}},"data":{"highlightId":"code-3"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":112,"column":4,"offset":3959}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Instruction Approve và Revoke\r\n\r\nApprove cung cấp ủy quyền để chuyển một số lượng token cụ thể thay mặt cho chủ sở hữu account. Điều này cho phép chuyển token mà không cần cấp toàn quyền kiểm soát account.\r\n\r\n> Chúng ta đặt một số lượng \"được phê duyệt\", và đối tượng được ủy nhiệm chỉ có thể chuyển tối đa số lượng đó\r\n\r\nRevoke loại bỏ quyền của đối tượng được ủy nhiệm hiện tại đối với account, trả lại toàn quyền kiểm soát cho chủ sở hữu account.\r\n\r\n> Ngay lập tức hủy bỏ bất kỳ đối tượng được ủy nhiệm hiện có nào và chỉ chủ sở hữu account mới có thể revoke delegation (không phải bản thân đối tượng được ủy nhiệm)\r\n\r\nTrước khi chúng ta có thể delegate hoặc revoke bất kỳ token account nào, chúng ta sẽ cần phải có:\r\n- Account `Mint` đã được khởi tạo\r\n- Account `Token` hoặc account `Associated Token` đã được khởi tạo nơi chúng ta sẽ kiểm soát\r\n\r\n> Số lượng token chúng ta đúc được \"chuẩn hóa\" với decimal. Điều này có nghĩa là nếu chúng ta muốn đúc 1 token có decimal là 6, chúng ta sẽ cần thực sự đặt `1_000_000` làm amount\r\n\r\n<ArticleSection name=\"Instruction thô\" id=\"raw-instruction\" level=\"h2\" />\r\n\r\nBằng cách chỉ sử dụng instruction \"thô\" mà không có bất kỳ abstraction nào, approve token:\r\n\r\n```ts\r\nconst keypair = Keypair.generate();\r\n\r\nconst tokenAccount = await getAssociatedTokenAddress(\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n);\r\n\r\n// Create ATA creation instruction\r\nconst createAtaInstruction = createAssociatedTokenAccountIdempotentInstruction(\r\n    keypair.publicKey, // payer\r\n    tokenAccount, // associated token account address\r\n    destination.publicKey, // owner\r\n    mint.publicKey, // mint\r\n);\r\n\r\n// Delegate an ATA \r\nconst approveInstruction = createApproveInstruction(\r\n    tokenAccount // account\r\n    delegate.publicKey, // delegate\r\n    keypair.publickey // owner\r\n    1e6, // amount of tokens\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAtaInstruction,\r\n    approveInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token accounts created and delegated! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\nBằng cách chỉ sử dụng instruction \"thô\" mà không có bất kỳ abstraction nào, đây là cách revoke token:\r\n\r\n```ts\r\n// Revoke the delegate of an ATA \r\nconst revokeInstruction = createRevokeInstruction(\r\n    tokenAccount // account\r\n    keypair.publickey // owner\r\n);\r\n\r\nconst transaction = new Transaction().add(revokeInstruction);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token account delegate revoked! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\n<ArticleSection name=\"Instruction được trừu tượng hóa\" id=\"abstracted-instruction\" level=\"h2\" />\r\n\r\nĐây là cách các instruction tương tự sẽ trông như thế nào được khi được trừu tượng hóa với instruction `approve()`:\r\n\r\n```ts\r\nconst tokenAccount = Keypair.generate();\r\n\r\nconst ata = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    tokenAccount.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${ata.address}!`)\r\n  \r\nlet tx = await approve(\r\n    connection,\r\n    keypair,\r\n    ata.address, // token Account\r\n    delegate-publicKey, // delegate\r\n    keypair.publicKey, // owner\r\n    1e6, // amount\r\n);\r\n\r\nconsole.log(`Succesfully Delegated!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)\r\n```\r\n\r\nĐây là cách các instruction tương tự sẽ trông như thế nào khi được trừu tượng hóa với instruction `revoke()`:\r\n\r\n```ts\r\nlet tx = await revoke(\r\n    connection,\r\n    keypair,\r\n    ata.address, // token Account\r\n    keypair.publicKey, // owner\r\n);\r\n\r\nconsole.log(`Succesfully Revoked Delegate!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)\r\n```","highlightedCode":{"code-0":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"const"}]},{"type":"element","tagName":"span","