tIdempotentInstruction(\r\n    keypair.publicKey, // payer\r\n    tokenAccount, // associated token account address\r\n    destination.publicKey, // owner\r\n    mint.publicKey, // mint\r\n);\r\n\r\n// Delegate an ATA\r\nconst approveInstruction = createApproveInstruction(\r\n    tokenAccount // account\r\n    delegate.publicKey, // delegate\r\n    keypair.publickey // owner\r\n    1e6, // amount of tokens\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAtaInstruction,\r\n    approveInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token accounts created and delegated! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":23,"column":1,"offset":1247},"end":{"line":55,"column":4,"offset":2217}},"data":{"highlightId":"code-0"}},{"type":"paragraph","children":[{"type":"text","value":"Dengan menggunakan instruksi \"raw\" tanpa abstraksi apa pun, beginilah cara mencabut token:","position":{"start":{"line":57,"column":1,"offset":2221},"end":{"line":57,"column":91,"offset":2311}}}],"position":{"start":{"line":57,"column":1,"offset":2221},"end":{"line":57,"column":91,"offset":2311}}},{"type":"code","lang":"ts","meta":null,"value":"// Revoke the delegate of an ATA\r\nconst revokeInstruction = createRevokeInstruction(\r\n    tokenAccount // account\r\n    keypair.publickey // owner\r\n);\r\n\r\nconst transaction = new Transaction().add(revokeInstruction);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token account delegate revoked! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":59,"column":1,"offset":2315},"end":{"line":71,"column":4,"offset":2765}},"data":{"highlightId":"code-1"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Abstracted Instruction","position":{"start":{"line":73,"column":17,"offset":2785},"end":{"line":73,"column":46,"offset":2814}}},{"type":"mdxJsxAttribute","name":"id","value":"abstracted-instruction","position":{"start":{"line":73,"column":47,"offset":2815},"end":{"line":73,"column":74,"offset":2842}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":73,"column":75,"offset":2843},"end":{"line":73,"column":85,"offset":2853}}}],"children":[],"position":{"start":{"line":73,"column":1,"offset":2769},"end":{"line":73,"column":88,"offset":2856}}},{"type":"paragraph","children":[{"type":"text","value":"Beginilah instruksi yang sama akan terlihat jika diabstraksikan dengan instruksi ","position":{"start":{"line":75,"column":1,"offset":2860},"end":{"line":75,"column":82,"offset":2941}}},{"type":"inlineCode","value":"approve()","position":{"start":{"line":75,"column":82,"offset":2941},"end":{"line":75,"column":93,"offset":2952}}},{"type":"text","value":":","position":{"start":{"line":75,"column":93,"offset":2952},"end":{"line":75,"column":94,"offset":2953}}}],"position":{"start":{"line":75,"column":1,"offset":2860},"end":{"line":75,"column":94,"offset":2953}}},{"type":"code","lang":"ts","meta":null,"value":"const tokenAccount = Keypair.generate();\r\n\r\nconst ata = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    tokenAccount.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${ata.address}!`)\r\n\r\nlet tx = await approve(\r\n    connection,\r\n    keypair,\r\n    ata.address, // token Account\r\n    delegate-publicKey, // delegate\r\n    keypair.publicKey, // owner\r\n    1e6, // amount\r\n);\r\n\r\nconsole.log(`Succesfully Delegated!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)","position":{"start":{"line":77,"column":1,"offset":2957},"end":{"line":99,"column":4,"offset":3490}},"data":{"highlightId":"code-2"}},{"type":"paragraph","children":[{"type":"text","value":"Beginilah instruksi yang sama akan terlihat jika diabstraksikan dengan instruksi ","position":{"start":{"line":101,"column":1,"offset":3494},"end":{"line":101,"column":82,"offset":3575}}},{"type":"inlineCode","value":"revoke()","position":{"start":{"line":101,"column":82,"offset":3575},"end":{"line":101,"column":92,"offset":3585}}},{"type":"text","value":":","position":{"start":{"line":101,"column":92,"offset":3585},"end":{"line":101,"column":93,"offset":3586}}}],"position":{"start":{"line":101,"column":1,"offset":3494},"end":{"line":101,"column":93,"offset":3586}}},{"type":"code","lang":"ts","meta":null,"value":"let tx = await revoke(\r\n    connection,\r\n    keypair,\r\n    ata.address, // token Account\r\n    keypair.publicKey, // owner\r\n);\r\n\r\nconsole.log(`Succesfully Revoked Delegate!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)","position":{"start":{"line":103,"column":1,"offset":3590},"end":{"line":112,"column":4,"offset":3846}},"data":{"highlightId":"code-3"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":112,"column":4,"offset":3846}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Instruksi Approve dan Revoke\r\n\r\nApprove memberikan delegasi wewenang untuk mentransfer sejumlah token tertentu atas nama pemilik akun. Ini memungkinkan transfer token secara terprogram tanpa memberikan kontrol penuh atas akun.\r\n\r\n> Kita menetapkan jumlah \"disetujui\", dan delegasi hanya dapat mentransfer hingga jumlah tersebut\r\n\r\nRevoke menghapus wewenang delegasi saat ini atas akun, mengembalikan kontrol penuh kepada pemilik akun.\r\n\r\n> Segera membatalkan delegasi yang ada dan hanya pemilik akun yang dapat mencabut delegasi (bukan delegasi itu sendiri)\r\n\r\nSebelum kita dapat mendelegasikan atau mencabut akun token apa pun, kita perlu sudah memiliki:\r\n- Akun `Mint` yang sudah diinisialisasi\r\n- Akun `Token` atau akun `Associated Token` yang sudah diinisialisasi yang akan kita kendalikan\r\n\r\n> Jumlah token yang kita setujui \"dinormalisasi\" untuk desimal. Ini berarti jika kita ingin menyetujui 1 token yang memiliki 6 desimal, kita perlu memasukkan `1e6` sebagai jumlahnya\r\n\r\n<ArticleSection name=\"Raw Instruction\" id=\"raw-instruction\" level=\"h2\" />\r\n\r\nDengan menggunakan instruksi \"raw\" tanpa abstraksi apa pun, beginilah cara menyetujui token:\r\n\r\n```ts\r\nconst keypair = Keypair.generate();\r\n\r\nconst tokenAccount = await getAssociatedTokenAddress(\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n);\r\n\r\n// Create ATA creation instruction\r\nconst createAtaInstruction = createAssociatedTokenAccountIdempotentInstruction(\r\n    keypair.publicKey, // payer\r\n    tokenAccount, // associated token account address\r\n    destination.publicKey, // owner\r\n    mint.publicKey, // mint\r\n);\r\n\r\n// Delegate an ATA\r\nconst approveInstruction = createApproveInstruction(\r\n    tokenAccount // account\r\n    delegate.publicKey, // delegate\r\n    keypair.publickey // owner\r\n    1e6, // amount of tokens\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAtaInstruction,\r\n    approveInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token accounts created and delegated! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\nDengan menggunakan instruksi \"raw\" tanpa abstraksi apa pun, beginilah cara mencabut token:\r\n\r\n```ts\r\n// Revoke the delegate of an ATA\r\nconst revokeInstruction = createRevokeInstruction(\r\n    tokenAccount // account\r\n    keypair.publickey // owner\r\n);\r\n\r\nconst transaction = new Transaction().add(revokeInstruction);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token account delegate revoked! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\n<ArticleSection name=\"Abstracted Instruction\" id=\"abstracted-instruction\" level=\"h2\" />\r\n\r\nBeginilah instruksi yang sama akan terlihat jika diabstraksikan dengan instruksi `approve()`:\r\n\r\n```ts\r\nconst tokenAccount = Keypair.generate();\r\n\r\nconst ata = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    tokenAccount.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${ata.address}!`)\r\n\r\nlet tx = await approve(\r\n    connection,\r\n    keypair,\r\n    ata.address, // token Account\r\n    delegate-publicKey, // delegate\r\n    keypair.publicKey, // owner\r\n    1e6, // amount\r\n);\r\n\r\nconsole.log(`Succesfully Delegated!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)\r\n```\r\n\r\nBeginilah instruksi yang sama akan terlihat jika diabstraksikan dengan instruksi `revoke()`:\r\n\r\n```ts\r\nlet tx = await revoke(\r\n    connection,\r\n    keypair,\r\n    ata.address, // token Account\r\n    keypair.publicKey, // owner\r\n);\r\n\r\nconsole.log(`Succesfully Revoked Delegate!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)\r\n```","highlightedCode":{"code-0":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"const"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" keypair "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"="}]},{"type":"element","tagName":"span","prope