"value":"Raw Instruction","position":{"start":{"line":19,"column":17,"offset":479},"end":{"line":19,"column":39,"offset":501}}},{"type":"mdxJsxAttribute","name":"id","value":"raw-instruction","position":{"start":{"line":19,"column":40,"offset":502},"end":{"line":19,"column":60,"offset":522}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":19,"column":61,"offset":523},"end":{"line":19,"column":71,"offset":533}}}],"children":[],"position":{"start":{"line":19,"column":1,"offset":463},"end":{"line":19,"column":74,"offset":536}}},{"type":"paragraph","children":[{"type":"text","value":"仅使用“原始”指令而不进行任何抽象时，批准代币的操作如下：","position":{"start":{"line":21,"column":1,"offset":540},"end":{"line":21,"column":30,"offset":569}}}],"position":{"start":{"line":21,"column":1,"offset":540},"end":{"line":21,"column":30,"offset":569}}},{"type":"code","lang":"ts","meta":null,"value":"const keypair = Keypair.generate();\r\n\r\nconst tokenAccount = await getAssociatedTokenAddress(\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n);\r\n\r\n// Create ATA creation instruction\r\nconst createAtaInstruction = createAssociatedTokenAccountIdempotentInstruction(\r\n    keypair.publicKey, // payer\r\n    tokenAccount, // associated token account address\r\n    destination.publicKey, // owner\r\n    mint.publicKey, // mint\r\n);\r\n\r\n// Delegate an ATA \r\nconst approveInstruction = createApproveInstruction(\r\n    tokenAccount // account\r\n    delegate.publicKey, // delegate\r\n    keypair.publickey // owner\r\n    1e6, // amount of tokens\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAtaInstruction,\r\n    approveInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token accounts created and delegated! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":23,"column":1,"offset":573},"end":{"line":55,"column":4,"offset":1544}},"data":{"highlightId":"code-0"}},{"type":"paragraph","children":[{"type":"text","value":"仅使用“原始”指令而不进行任何抽象时，撤销代币的操作如下：","position":{"start":{"line":57,"column":1,"offset":1548},"end":{"line":57,"column":30,"offset":1577}}}],"position":{"start":{"line":57,"column":1,"offset":1548},"end":{"line":57,"column":30,"offset":1577}}},{"type":"code","lang":"ts","meta":null,"value":"// Revoke the delegate of an ATA \r\nconst revokeInstruction = createRevokeInstruction(\r\n    tokenAccount // account\r\n    keypair.publickey // owner\r\n);\r\n\r\nconst transaction = new Transaction().add(revokeInstruction);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token account delegate revoked! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":59,"column":1,"offset":1581},"end":{"line":71,"column":4,"offset":2032}},"data":{"highlightId":"code-1"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Abstracted Instruction","position":{"start":{"line":73,"column":17,"offset":2052},"end":{"line":73,"column":46,"offset":2081}}},{"type":"mdxJsxAttribute","name":"id","value":"abstracted-instruction","position":{"start":{"line":73,"column":47,"offset":2082},"end":{"line":73,"column":74,"offset":2109}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":73,"column":75,"offset":2110},"end":{"line":73,"column":85,"offset":2120}}}],"children":[],"position":{"start":{"line":73,"column":1,"offset":2036},"end":{"line":73,"column":88,"offset":2123}}},{"type":"paragraph","children":[{"type":"text","value":"以下是通过 ","position":{"start":{"line":75,"column":1,"offset":2127},"end":{"line":75,"column":7,"offset":2133}}},{"type":"inlineCode","value":"approve()","position":{"start":{"line":75,"column":7,"offset":2133},"end":{"line":75,"column":18,"offset":2144}}},{"type":"text","value":" 指令抽象后的操作：","position":{"start":{"line":75,"column":18,"offset":2144},"end":{"line":75,"column":28,"offset":2154}}}],"position":{"start":{"line":75,"column":1,"offset":2127},"end":{"line":75,"column":28,"offset":2154}}},{"type":"code","lang":"ts","meta":null,"value":"const tokenAccount = Keypair.generate();\r\n\r\nconst ata = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    tokenAccount.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${ata.address}!`)\r\n  \r\nlet tx = await approve(\r\n    connection,\r\n    keypair,\r\n    ata.address, // token Account\r\n    delegate-publicKey, // delegate\r\n    keypair.publicKey, // owner\r\n    1e6, // amount\r\n);\r\n\r\nconsole.log(`Succesfully Delegated!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)","position":{"start":{"line":77,"column":1,"offset":2158},"end":{"line":99,"column":4,"offset":2693}},"data":{"highlightId":"code-2"}},{"type":"paragraph","children":[{"type":"text","value":"以下是通过 ","position":{"start":{"line":101,"column":1,"offset":2697},"end":{"line":101,"column":7,"offset":2703}}},{"type":"inlineCode","value":"revoke()","position":{"start":{"line":101,"column":7,"offset":2703},"end":{"line":101,"column":17,"offset":2713}}},{"type":"text","value":" 指令抽象后的操作：","position":{"start":{"line":101,"column":17,"offset":2713},"end":{"line":101,"column":27,"offset":2723}}}],"position":{"start":{"line":101,"column":1,"offset":2697},"end":{"line":101,"column":27,"offset":2723}}},{"type":"code","lang":"ts","meta":null,"value":"let tx = await revoke(\r\n    connection,\r\n    keypair,\r\n    ata.address, // token Account\r\n    keypair.publicKey, // owner\r\n);\r\n\r\nconsole.log(`Succesfully Revoked Delegate!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)","position":{"start":{"line":103,"column":1,"offset":2727},"end":{"line":112,"column":4,"offset":2983}},"data":{"highlightId":"code-3"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":112,"column":4,"offset":2983}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# 批准和撤销指令\r\n\r\n批准允许代理人代表账户所有者转移特定数量的代币。这使得程序化的代币转移成为可能，而无需授予完整的账户控制权。\r\n\r\n> 我们设置一个“批准”的金额，代理人只能转移不超过该金额的代币\r\n\r\n撤销会移除当前代理人对账户的权限，将完整的控制权返回给账户所有者。\r\n\r\n> 立即取消任何现有的代理权限，且只有账户所有者可以撤销代理（代理人本身无法撤销）\r\n\r\n在我们可以代理或撤销任何代币账户之前，我们需要已经完成以下操作：\r\n- 初始化一个 `Mint` 账户\r\n- 初始化一个 `Token` 账户或 `Associated Token` 账户，我们将对其进行控制\r\n\r\n> 我们铸造的代币数量是根据小数位数“标准化”的。这意味着如果我们想铸造一个有 6 位小数的 1 个代币，我们实际上需要将金额设置为 `1e6`\r\n\r\n<ArticleSection name=\"Raw Instruction\" id=\"raw-instruction\" level=\"h2\" />\r\n\r\n仅使用“原始”指令而不进行任何抽象时，批准代币的操作如下：\r\n\r\n```ts\r\nconst keypair = Keypair.generate();\r\n\r\nconst tokenAccount = await getAssociatedTokenAddress(\r\n    mint.publicKey,\r\n    keypair.publicKey,\r\n);\r\n\r\n// Create ATA creation instruction\r\nconst createAtaInstruction = createAssociatedTokenAccountIdempotentInstruction(\r\n    keypair.publicKey, // payer\r\n    tokenAccount, // associated token account address\r\n    destination.publicKey, // owner\r\n    mint.publicKey, // mint\r\n);\r\n\r\n// Delegate an ATA \r\nconst approveInstruction = createApproveInstruction(\r\n    tokenAccount // account\r\n    delegate.publicKey, // delegate\r\n    keypair.publickey // owner\r\n    1e6, // amount of tokens\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAtaInstruction,\r\n    approveInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token accounts created and delegated! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\n仅使用“原始”指令而不进行任何抽象时，撤销代币的操作如下：\r\n\r\n```ts\r\n// Revoke the delegate of an ATA \r\nconst revokeInstruction = createRevokeInstruction(\r\n    tokenAccount // account\r\n    keypair.publickey // owner\r\n);\r\n\r\nconst transaction = new Transaction().add(revokeInstruction);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token account delegate revoked! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\n<ArticleSection name=\"Abstracted Instruction\" id=\"abstracted-instruction\" level=\"h2\" />\r\n\r\n以下是通过 `approve()` 指令抽象后的操作：\r\n\r\n```ts\r\nconst tokenAccount = Keypair.generate();\r\n\r\nconst ata = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    tokenAccount.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${ata.address}!`)\r\n  \r\nlet tx = await approve(\r\n    connection,\r\n    keypair,\r\n    ata.address, // token Account\r\n    delegate-publicKey, // delegate\r\n    keypair.publicKey, // owner\r\n    1e6, // amount\r\n);\r\n\r\nconsole.log(`Succesfully Delegated!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)\r\n```\r\n\r\n以下是通过 `revoke()` 指令抽象后的操作：\r\n\r\n```ts\r\nlet tx = await revoke(\r\n    connection,\r\n    keypair,\r\n    ata.address, // token Account\r\n    keypair.publicKey, // owner\r\n);\r\n\r\nconsole.log(`Succesfully Revoked Delegate!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)\r\n```","highlightedCode":{"code-0":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"const"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" keypair "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F2