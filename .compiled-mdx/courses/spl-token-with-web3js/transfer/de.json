s\r\n    destination.publicKey, // owner\r\n    mint.publicKey, // mint\r\n);\r\n\r\n// Transfer tokens to ATA \r\nconst transferInstruction = createTransferInstruction(\r\n    sourceTokenAccount, // source token account pubkey\r\n    destinationTokenAccount, // destination token account pubkey\r\n    keypair.publicKey, // owner of the source token account\r\n    1e6, // amount\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAtaInstruction,\r\n    transferInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token accounts created and tokens transferred! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":18,"column":1,"offset":972},"end":{"line":50,"column":4,"offset":2067}},"data":{"highlightId":"code-0"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Abstracted Instruction","position":{"start":{"line":52,"column":17,"offset":2087},"end":{"line":52,"column":46,"offset":2116}}},{"type":"mdxJsxAttribute","name":"id","value":"abstracted-instruction","position":{"start":{"line":52,"column":47,"offset":2117},"end":{"line":52,"column":74,"offset":2144}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":52,"column":75,"offset":2145},"end":{"line":52,"column":85,"offset":2155}}}],"children":[],"position":{"start":{"line":52,"column":1,"offset":2071},"end":{"line":52,"column":88,"offset":2158}}},{"type":"paragraph","children":[{"type":"text","value":"So würden die gleichen Anweisungen mit der ","position":{"start":{"line":54,"column":1,"offset":2162},"end":{"line":54,"column":44,"offset":2205}}},{"type":"inlineCode","value":"transfer()","position":{"start":{"line":54,"column":44,"offset":2205},"end":{"line":54,"column":56,"offset":2217}}},{"type":"text","value":" Anweisung abstrahiert aussehen:","position":{"start":{"line":54,"column":56,"offset":2217},"end":{"line":54,"column":88,"offset":2249}}}],"position":{"start":{"line":54,"column":1,"offset":2162},"end":{"line":54,"column":88,"offset":2249}}},{"type":"code","lang":"ts","meta":null,"value":"const destination = Keypair.generate();\r\n\r\nconst destinationAta = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    destination.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${destinationAta.address}!`)\r\n  \r\nlet tx = await transfer(\r\n    connection, // connection\r\n    keypair, // payer\r\n    sourceAta, // source token account\r\n    destinationAta, // destination token account\r\n    keypair.publicKey, // owner of the source token account\r\n    1e6, // amount to transfer\r\n);\r\n\r\nconsole.log(`Succesfully Transferred!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)","position":{"start":{"line":56,"column":1,"offset":2253},"end":{"line":78,"column":4,"offset":2892}},"data":{"highlightId":"code-1"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Checked Instruction","position":{"start":{"line":80,"column":17,"offset":2912},"end":{"line":80,"column":43,"offset":2938}}},{"type":"mdxJsxAttribute","name":"id","value":"checked-instruction","position":{"start":{"line":80,"column":44,"offset":2939},"end":{"line":80,"column":68,"offset":2963}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":80,"column":69,"offset":2964},"end":{"line":80,"column":79,"offset":2974}}}],"children":[],"position":{"start":{"line":80,"column":1,"offset":2896},"end":{"line":80,"column":82,"offset":2977}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":81,"column":1,"offset":2979}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Transfer-Anweisung\r\n\r\nÜberträgt Token von einem Konto auf ein anderes. Dies ist die grundlegende Operation zum Senden von Token zwischen Benutzern.\r\n\r\nBevor wir Token übertragen können, benötigen wir bereits:\r\n- Ein initialisiertes `Mint` Konto.\r\n- Ein Quell-`Token` Konto oder `Associated Token` Konto, das bereits mindestens den Betrag enthält, den wir übertragen möchten.\r\n- Ein Ziel-`Token` Konto oder `Associated Token` Konto, das die Token vom Quell-`Token` Konto empfangen wird.\r\n\r\n> Die Anzahl der Token, die wir übertragen, wird für Dezimalstellen \"normalisiert\". Das bedeutet, wenn wir 1 Token mit 6 Dezimalstellen übertragen möchten, müssen wir tatsächlich `1e6` als Betrag angeben\r\n\r\n<ArticleSection name=\"Raw Instruction\" id=\"raw-instruction\" level=\"h2\" />\r\n\r\nBei Verwendung einer \"rohen\" Anweisung ohne Abstraktion würde die Übertragung eines Tokens so aussehen:\r\n\r\n```ts\r\nconst destination = Keypair.generate();\r\n\r\nconst destinationTokenAccount = await getAssociatedTokenAddress(\r\n    mint.publicKey,\r\n    destination.publicKey,\r\n);\r\n\r\n// Create ATA creation instruction\r\nconst createAtaInstruction = createAssociatedTokenAccountIdempotentInstruction(\r\n    keypair.publicKey, // payer\r\n    destinationTokenAccount, // associated token account address\r\n    destination.publicKey, // owner\r\n    mint.publicKey, // mint\r\n);\r\n\r\n// Transfer tokens to ATA \r\nconst transferInstruction = createTransferInstruction(\r\n    sourceTokenAccount, // source token account pubkey\r\n    destinationTokenAccount, // destination token account pubkey\r\n    keypair.publicKey, // owner of the source token account\r\n    1e6, // amount\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAtaInstruction,\r\n    transferInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token accounts created and tokens transferred! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\n<ArticleSection name=\"Abstracted Instruction\" id=\"abstracted-instruction\" level=\"h2\" />\r\n\r\nSo würden die gleichen Anweisungen mit der `transfer()` Anweisung abstrahiert aussehen:\r\n\r\n```ts\r\nconst destination = Keypair.generate();\r\n\r\nconst destinationAta = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    destination.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${destinationAta.address}!`)\r\n  \r\nlet tx = await transfer(\r\n    connection, // connection\r\n    keypair, // payer\r\n    sourceAta, // source token account\r\n    destinationAta, // destination token account\r\n    keypair.publicKey, // owner of the source token account\r\n    1e6, // amount to transfer\r\n);\r\n\r\nconsole.log(`Succesfully Transferred!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)\r\n```\r\n\r\n<ArticleSection name=\"Checked Instruction\" id=\"checked-instruction\" level=\"h2\" />\r\n","highlightedCode":{"code-0":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"const"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" destination "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"="}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" Keypair."}]},{"type":"element","tagName":"span","properties":{"style":"color:#62E884"},"children":[{"type":"text","value":"generate"}]},{"type":"element","tag