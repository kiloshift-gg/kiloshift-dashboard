r\r\n    mint.publicKey, // mint\r\n);\r\n\r\n// Transfer tokens to ATA \r\nconst transferInstruction = createTransferInstruction(\r\n    sourceTokenAccount, // source token account pubkey\r\n    destinationTokenAccount, // destination token account pubkey\r\n    keypair.publicKey, // owner of the source token account\r\n    1e6, // amount\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAtaInstruction,\r\n    transferInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token accounts created and tokens transferred! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":18,"column":1,"offset":929},"end":{"line":50,"column":4,"offset":2024}},"data":{"highlightId":"code-0"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Abstracted Instruction","position":{"start":{"line":52,"column":17,"offset":2044},"end":{"line":52,"column":46,"offset":2073}}},{"type":"mdxJsxAttribute","name":"id","value":"abstracted-instruction","position":{"start":{"line":52,"column":47,"offset":2074},"end":{"line":52,"column":74,"offset":2101}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":52,"column":75,"offset":2102},"end":{"line":52,"column":85,"offset":2112}}}],"children":[],"position":{"start":{"line":52,"column":1,"offset":2028},"end":{"line":52,"column":88,"offset":2115}}},{"type":"paragraph","children":[{"type":"text","value":"This is how the same instructions would look like abstracted away with the ","position":{"start":{"line":54,"column":1,"offset":2119},"end":{"line":54,"column":76,"offset":2194}}},{"type":"inlineCode","value":"transfer()","position":{"start":{"line":54,"column":76,"offset":2194},"end":{"line":54,"column":88,"offset":2206}}},{"type":"text","value":" instruction:","position":{"start":{"line":54,"column":88,"offset":2206},"end":{"line":54,"column":101,"offset":2219}}}],"position":{"start":{"line":54,"column":1,"offset":2119},"end":{"line":54,"column":101,"offset":2219}}},{"type":"code","lang":"ts","meta":null,"value":"const destination = Keypair.generate();\r\n\r\nconst destinationAta = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    destination.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${destinationAta.address}!`)\r\n  \r\nlet tx = await transfer(\r\n    connection, // connection\r\n    keypair, // payer\r\n    sourceAta, // source token account\r\n    destinationAta, // destination token account\r\n    keypair.publicKey, // owner of the source token account\r\n    1e6, // amount to transfer\r\n);\r\n\r\nconsole.log(`Succesfully Transferred!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)","position":{"start":{"line":56,"column":1,"offset":2223},"end":{"line":78,"column":4,"offset":2862}},"data":{"highlightId":"code-1"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Checked Instruction","position":{"start":{"line":80,"column":17,"offset":2882},"end":{"line":80,"column":43,"offset":2908}}},{"type":"mdxJsxAttribute","name":"id","value":"checked-instruction","position":{"start":{"line":80,"column":44,"offset":2909},"end":{"line":80,"column":68,"offset":2933}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":80,"column":69,"offset":2934},"end":{"line":80,"column":79,"offset":2944}}}],"children":[],"position":{"start":{"line":80,"column":1,"offset":2866},"end":{"line":80,"column":82,"offset":2947}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":81,"column":1,"offset":2949}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Transfer Instruction\r\n\r\nMoves tokens from one account to another. This is the basic operation for sending tokens between users.\r\n\r\nBefore we can transfer any token, we'll need to already have:\r\n- Initialized a `Mint` account.\r\n- A source `Token` account or `Associated Token` account that already has at least the amount we want to transfer.\r\n- A destination `Token` account or `Associated Token` account that will receive the tokens from the source `Token` account.\r\n\r\n> The amount of tokens we transfer are \"normalized\" for decimals. This means that if we want to transfer 1 token that has 6 decimals, we'll need to actually put `1e6` as amount\r\n\r\n<ArticleSection name=\"Raw Instruction\" id=\"raw-instruction\" level=\"h2\" />\r\n\r\nBy using just \"raw\" instruction without any abstraction, this is how transferring a token would look like:\r\n\r\n```ts\r\nconst destination = Keypair.generate();\r\n\r\nconst destinationTokenAccount = await getAssociatedTokenAddress(\r\n    mint.publicKey,\r\n    destination.publicKey,\r\n);\r\n\r\n// Create ATA creation instruction\r\nconst createAtaInstruction = createAssociatedTokenAccountIdempotentInstruction(\r\n    keypair.publicKey, // payer\r\n    destinationTokenAccount, // associated token account address\r\n    destination.publicKey, // owner\r\n    mint.publicKey, // mint\r\n);\r\n\r\n// Transfer tokens to ATA \r\nconst transferInstruction = createTransferInstruction(\r\n    sourceTokenAccount, // source token account pubkey\r\n    destinationTokenAccount, // destination token account pubkey\r\n    keypair.publicKey, // owner of the source token account\r\n    1e6, // amount\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAtaInstruction,\r\n    transferInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token accounts created and tokens transferred! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\n<ArticleSection name=\"Abstracted Instruction\" id=\"abstracted-instruction\" level=\"h2\" />\r\n\r\nThis is how the same instructions would look like abstracted away with the `transfer()` instruction:\r\n\r\n```ts\r\nconst destination = Keypair.generate();\r\n\r\nconst destinationAta = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    destination.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${destinationAta.address}!`)\r\n  \r\nlet tx = await transfer(\r\n    connection, // connection\r\n    keypair, // payer\r\n    sourceAta, // source token account\r\n    destinationAta, // destination token account\r\n    keypair.publicKey, // owner of the source token account\r\n    1e6, // amount to transfer\r\n);\r\n\r\nconsole.log(`Succesfully Transferred!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)\r\n```\r\n\r\n<ArticleSection name=\"Checked Instruction\" id=\"checked-instruction\" level=\"h2\" />\r\n","highlightedCode":{"code-0":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"const"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" destination "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"="}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" Keypair."}]},{"type":"element","tagName":"span","properties":{"style":"color:#62E884"},"children":[{"type":"text","value":"generate"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"c