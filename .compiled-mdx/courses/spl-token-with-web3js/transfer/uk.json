nt.publicKey, // mint\r\n);\r\n\r\n// Transfer tokens to ATA \r\nconst transferInstruction = createTransferInstruction(\r\n    sourceTokenAccount, // source token account pubkey\r\n    destinationTokenAccount, // destination token account pubkey\r\n    keypair.publicKey, // owner of the source token account\r\n    1e6, // amount\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAtaInstruction,\r\n    transferInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token accounts created and tokens transferred! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":18,"column":1,"offset":924},"end":{"line":50,"column":4,"offset":2019}},"data":{"highlightId":"code-0"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Abstracted Instruction","position":{"start":{"line":52,"column":17,"offset":2039},"end":{"line":52,"column":46,"offset":2068}}},{"type":"mdxJsxAttribute","name":"id","value":"abstracted-instruction","position":{"start":{"line":52,"column":47,"offset":2069},"end":{"line":52,"column":74,"offset":2096}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":52,"column":75,"offset":2097},"end":{"line":52,"column":85,"offset":2107}}}],"children":[],"position":{"start":{"line":52,"column":1,"offset":2023},"end":{"line":52,"column":88,"offset":2110}}},{"type":"paragraph","children":[{"type":"text","value":"Ось як ті самі інструкції виглядатимуть з абстракцією за допомогою інструкції ","position":{"start":{"line":54,"column":1,"offset":2114},"end":{"line":54,"column":79,"offset":2192}}},{"type":"inlineCode","value":"transfer()","position":{"start":{"line":54,"column":79,"offset":2192},"end":{"line":54,"column":91,"offset":2204}}},{"type":"text","value":":","position":{"start":{"line":54,"column":91,"offset":2204},"end":{"line":54,"column":92,"offset":2205}}}],"position":{"start":{"line":54,"column":1,"offset":2114},"end":{"line":54,"column":92,"offset":2205}}},{"type":"code","lang":"ts","meta":null,"value":"const destination = Keypair.generate();\r\n\r\nconst destinationAta = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    destination.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${destinationAta.address}!`)\r\n  \r\nlet tx = await transfer(\r\n    connection, // connection\r\n    keypair, // payer\r\n    sourceAta, // source token account\r\n    destinationAta, // destination token account\r\n    keypair.publicKey, // owner of the source token account\r\n    1e6, // amount to transfer\r\n);\r\n\r\nconsole.log(`Succesfully Transferred!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)","position":{"start":{"line":56,"column":1,"offset":2209},"end":{"line":78,"column":4,"offset":2848}},"data":{"highlightId":"code-1"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Checked Instruction","position":{"start":{"line":80,"column":17,"offset":2868},"end":{"line":80,"column":43,"offset":2894}}},{"type":"mdxJsxAttribute","name":"id","value":"checked-instruction","position":{"start":{"line":80,"column":44,"offset":2895},"end":{"line":80,"column":68,"offset":2919}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":80,"column":69,"offset":2920},"end":{"line":80,"column":79,"offset":2930}}}],"children":[],"position":{"start":{"line":80,"column":1,"offset":2852},"end":{"line":80,"column":82,"offset":2933}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":81,"column":1,"offset":2935}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Інструкція переказу\r\n\r\nПереміщує токени з одного рахунку на інший. Це базова операція для надсилання токенів між користувачами.\r\n\r\nПерш ніж ми зможемо переказати будь-який токен, нам потрібно вже мати:\r\n- Ініціалізований рахунок `Mint`.\r\n- Вихідний рахунок `Token` або `Associated Token`, на якому вже є принаймні та сума, яку ми хочемо переказати.\r\n- Цільовий рахунок `Token` або `Associated Token`, який отримає токени з вихідного рахунку `Token`.\r\n\r\n> Кількість токенів, які ми переказуємо, \"нормалізована\" для десяткових знаків. Це означає, що якщо ми хочемо переказати 1 токен, який має 6 десяткових знаків, нам потрібно буде вказати `1e6` як суму\r\n\r\n<ArticleSection name=\"Raw Instruction\" id=\"raw-instruction\" level=\"h2\" />\r\n\r\nВикористовуючи лише \"сиру\" інструкцію без будь-якої абстракції, переказ токена виглядатиме так:\r\n\r\n```ts\r\nconst destination = Keypair.generate();\r\n\r\nconst destinationTokenAccount = await getAssociatedTokenAddress(\r\n    mint.publicKey,\r\n    destination.publicKey,\r\n);\r\n\r\n// Create ATA creation instruction\r\nconst createAtaInstruction = createAssociatedTokenAccountIdempotentInstruction(\r\n    keypair.publicKey, // payer\r\n    destinationTokenAccount, // associated token account address\r\n    destination.publicKey, // owner\r\n    mint.publicKey, // mint\r\n);\r\n\r\n// Transfer tokens to ATA \r\nconst transferInstruction = createTransferInstruction(\r\n    sourceTokenAccount, // source token account pubkey\r\n    destinationTokenAccount, // destination token account pubkey\r\n    keypair.publicKey, // owner of the source token account\r\n    1e6, // amount\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAtaInstruction,\r\n    transferInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token accounts created and tokens transferred! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\n<ArticleSection name=\"Abstracted Instruction\" id=\"abstracted-instruction\" level=\"h2\" />\r\n\r\nОсь як ті самі інструкції виглядатимуть з абстракцією за допомогою інструкції `transfer()`:\r\n\r\n```ts\r\nconst destination = Keypair.generate();\r\n\r\nconst destinationAta = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    destination.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${destinationAta.address}!`)\r\n  \r\nlet tx = await transfer(\r\n    connection, // connection\r\n    keypair, // payer\r\n    sourceAta, // source token account\r\n    destinationAta, // destination token account\r\n    keypair.publicKey, // owner of the source token account\r\n    1e6, // amount to transfer\r\n);\r\n\r\nconsole.log(`Succesfully Transferred!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)\r\n```\r\n\r\n<ArticleSection name=\"Checked Instruction\" id=\"checked-instruction\" level=\"h2\" />\r\n","highlightedCode":{"code-0":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"const"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" destination "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"="}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" Keypair."}]},{"type":"element","tagName":"span","properties":{"style":"color:#62E884"},"children":[{"type":"text","value":"generate"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"()