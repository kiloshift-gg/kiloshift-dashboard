à quoi ressemble la création d'un jeton :","position":{"start":{"line":15,"column":1,"offset":753},"end":{"line":15,"column":121,"offset":873}}}],"position":{"start":{"line":15,"column":1,"offset":753},"end":{"line":15,"column":121,"offset":873}}},{"type":"code","lang":"ts","meta":null,"value":"const destination = Keypair.generate();\r\n\r\nconst tokenAccount = await getAssociatedTokenAddress(\r\n    mint.publicKey,\r\n    destination.publicKey,\r\n);\r\n\r\n// Create ATA creation instruction\r\nconst createAtaInstruction = createAssociatedTokenAccountIdempotentInstruction(\r\n    keypair.publicKey, // payer\r\n    tokenAccount, // associated token account address\r\n    destination.publicKey, // owner\r\n    mint.publicKey, // mint\r\n);\r\n\r\n// Mint tokens to ATA \r\nconst mintToInstruction = createMintToInstruction(\r\n    mint.publicKey, // mint\r\n    tokenAccount, // destination\r\n    keypair.publicKey, // mint authority\r\n    1_000e6, // amount of tokens\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAtaInstruction,\r\n    mintToInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token accounts created and tokens minted! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":17,"column":1,"offset":877},"end":{"line":49,"column":4,"offset":1871}},"data":{"highlightId":"code-0"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Instruction Abstraite","position":{"start":{"line":51,"column":17,"offset":1891},"end":{"line":51,"column":45,"offset":1919}}},{"type":"mdxJsxAttribute","name":"id","value":"abstracted-instruction","position":{"start":{"line":51,"column":46,"offset":1920},"end":{"line":51,"column":73,"offset":1947}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":51,"column":74,"offset":1948},"end":{"line":51,"column":84,"offset":1958}}}],"children":[],"position":{"start":{"line":51,"column":1,"offset":1875},"end":{"line":51,"column":87,"offset":1961}}},{"type":"paragraph","children":[{"type":"text","value":"Voici à quoi ressemble la même instruction si elle est abstraite à l'aide de l'instruction ","position":{"start":{"line":53,"column":1,"offset":1965},"end":{"line":53,"column":92,"offset":2056}}},{"type":"inlineCode","value":"mintTo()","position":{"start":{"line":53,"column":92,"offset":2056},"end":{"line":53,"column":102,"offset":2066}}},{"type":"text","value":" :","position":{"start":{"line":53,"column":102,"offset":2066},"end":{"line":53,"column":104,"offset":2068}}}],"position":{"start":{"line":53,"column":1,"offset":1965},"end":{"line":53,"column":104,"offset":2068}}},{"type":"code","lang":"ts","meta":null,"value":"const destination = Keypair.generate();\r\n\r\nconst ata = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    destination.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${ata.address}!`)\r\n  \r\nlet tx = await mintTo(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    ata.address,\r\n    keypair.publicKey,\r\n    1e6,\r\n);\r\n\r\nconsole.log(`Succesfully Minted!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)","position":{"start":{"line":55,"column":1,"offset":2072},"end":{"line":77,"column":4,"offset":2539}},"data":{"highlightId":"code-1"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":77,"column":4,"offset":2539}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Instruction Mint To\r\n\r\nCrée de nouveaux jetons et les dépose dans un compte donné. Seule l'autorité de mint peut effectuer cette opération.\r\n\r\nAvant de pouvoir créer un jeton, nous devons déjà avoir :\r\n- Initialisé un compte de `Mint` pour lequel nous détenons la `mintAuthority`\r\n- Initialisé un compte de `Token` ou `Associated Token` où nous allons créer des jetons dedans\r\n\r\nLe nombre de jetons que nous créons est \"normalisé\" au niveau des décimales. Cela signifie que si nous voulons créer 1 jeton comportant 6 décimales, nous devrons en réalité saisir `1e6` comme montant\r\n\r\n<ArticleSection name=\"Instruction Brute\" id=\"raw-instruction\" level=\"h2\" />\r\n\r\nEn utilisant uniquement une instruction \"brute\" sans aucune abstraction, voici à quoi ressemble la création d'un jeton :\r\n\r\n```ts\r\nconst destination = Keypair.generate();\r\n\r\nconst tokenAccount = await getAssociatedTokenAddress(\r\n    mint.publicKey,\r\n    destination.publicKey,\r\n);\r\n\r\n// Create ATA creation instruction\r\nconst createAtaInstruction = createAssociatedTokenAccountIdempotentInstruction(\r\n    keypair.publicKey, // payer\r\n    tokenAccount, // associated token account address\r\n    destination.publicKey, // owner\r\n    mint.publicKey, // mint\r\n);\r\n\r\n// Mint tokens to ATA \r\nconst mintToInstruction = createMintToInstruction(\r\n    mint.publicKey, // mint\r\n    tokenAccount, // destination\r\n    keypair.publicKey, // mint authority\r\n    1_000e6, // amount of tokens\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAtaInstruction,\r\n    mintToInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token accounts created and tokens minted! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\n<ArticleSection name=\"Instruction Abstraite\" id=\"abstracted-instruction\" level=\"h2\" />\r\n\r\nVoici à quoi ressemble la même instruction si elle est abstraite à l'aide de l'instruction `mintTo()` :\r\n\r\n```ts\r\nconst destination = Keypair.generate();\r\n\r\nconst ata = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    destination.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${ata.address}!`)\r\n  \r\nlet tx = await mintTo(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    ata.address,\r\n    keypair.publicKey,\r\n    1e6,\r\n);\r\n\r\nconsole.log(`Succesfully Minted!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)\r\n```","highlightedCode":{"code-0":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"const"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" destination "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"="}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" Keypair."}]},{"type":"element","tagName":"span","properties":{"style":"color:#62E884"},"children":[{"type":"text","value":"generate"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"();"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"const"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" tokenAccount "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"="}]},{"type":"element","tagNam