","value":"h2","position":{"start":{"line":51,"column":75,"offset":1885},"end":{"line":51,"column":85,"offset":1895}}}],"children":[],"position":{"start":{"line":51,"column":1,"offset":1811},"end":{"line":51,"column":88,"offset":1898}}},{"type":"paragraph","children":[{"type":"text","value":"This is how the same instructions would look like abstracted away with the ","position":{"start":{"line":53,"column":1,"offset":1902},"end":{"line":53,"column":76,"offset":1977}}},{"type":"inlineCode","value":"mintTo()","position":{"start":{"line":53,"column":76,"offset":1977},"end":{"line":53,"column":86,"offset":1987}}},{"type":"text","value":" instruction:","position":{"start":{"line":53,"column":86,"offset":1987},"end":{"line":53,"column":99,"offset":2000}}}],"position":{"start":{"line":53,"column":1,"offset":1902},"end":{"line":53,"column":99,"offset":2000}}},{"type":"code","lang":"ts","meta":null,"value":"const destination = Keypair.generate();\r\n\r\nconst ata = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    destination.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${ata.address}!`)\r\n  \r\nlet tx = await mintTo(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    ata.address,\r\n    keypair.publicKey,\r\n    1e6,\r\n);\r\n\r\nconsole.log(`Succesfully Minted!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)","position":{"start":{"line":55,"column":1,"offset":2004},"end":{"line":77,"column":4,"offset":2471}},"data":{"highlightId":"code-1"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":77,"column":4,"offset":2471}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Mint To Instruction\r\n\r\nCreates new tokens and deposits them into a specified account. Only the mint authority can perform this operation.\r\n\r\nBefore we can mint any token, we'll need to already have:\r\n- Initialized a `Mint` account which we hold the `mintAuthority`\r\n- Initialized a `Token` account or `Associated Token` account where we're going to mint tokens to\r\n\r\n> The amount of tokens we mint are \"normalized\" for decimals. This means that if we want to mint 1 token that has 6 decimals, we'll need to actually put `1e6` as amount\r\n\r\n<ArticleSection name=\"Raw Instruction\" id=\"raw-instruction\" level=\"h2\" />\r\n\r\nBy using just \"raw\" instruction without any abstraction, this is how minting a token would look like:\r\n\r\n```ts\r\nconst destination = Keypair.generate();\r\n\r\nconst tokenAccount = await getAssociatedTokenAddress(\r\n    mint.publicKey,\r\n    destination.publicKey,\r\n);\r\n\r\n// Create ATA creation instruction\r\nconst createAtaInstruction = createAssociatedTokenAccountIdempotentInstruction(\r\n    keypair.publicKey, // payer\r\n    tokenAccount, // associated token account address\r\n    destination.publicKey, // owner\r\n    mint.publicKey, // mint\r\n);\r\n\r\n// Mint tokens to ATA \r\nconst mintToInstruction = createMintToInstruction(\r\n    mint.publicKey, // mint\r\n    tokenAccount, // destination\r\n    keypair.publicKey, // mint authority\r\n    1_000e6, // amount of tokens\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAtaInstruction,\r\n    mintToInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token accounts created and tokens minted! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\n<ArticleSection name=\"Abstracted Instruction\" id=\"abstracted-instruction\" level=\"h2\" />\r\n\r\nThis is how the same instructions would look like abstracted away with the `mintTo()` instruction:\r\n\r\n```ts\r\nconst destination = Keypair.generate();\r\n\r\nconst ata = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    destination.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${ata.address}!`)\r\n  \r\nlet tx = await mintTo(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    ata.address,\r\n    keypair.publicKey,\r\n    1e6,\r\n);\r\n\r\nconsole.log(`Succesfully Minted!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)\r\n```","highlightedCode":{"code-0":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"const"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" destination "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"="}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" Keypair."}]},{"type":"element","tagName":"span","properties":{"style":"color:#62E884"},"children":[{"type":"text","value":"generate"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"();"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"const"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" tokenAccount "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"="}]},{"type":"element","tagName":"sp