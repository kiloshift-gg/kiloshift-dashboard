set":1938}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":51,"column":75,"offset":1939},"end":{"line":51,"column":85,"offset":1949}}}],"children":[],"position":{"start":{"line":51,"column":1,"offset":1865},"end":{"line":51,"column":88,"offset":1952}}},{"type":"paragraph","children":[{"type":"text","value":"Beginilah tampilan instruksi yang sama jika diabstraksikan dengan instruksi ","position":{"start":{"line":53,"column":1,"offset":1956},"end":{"line":53,"column":77,"offset":2032}}},{"type":"inlineCode","value":"mintTo()","position":{"start":{"line":53,"column":77,"offset":2032},"end":{"line":53,"column":87,"offset":2042}}},{"type":"text","value":":","position":{"start":{"line":53,"column":87,"offset":2042},"end":{"line":53,"column":88,"offset":2043}}}],"position":{"start":{"line":53,"column":1,"offset":1956},"end":{"line":53,"column":88,"offset":2043}}},{"type":"code","lang":"ts","meta":null,"value":"const destination = Keypair.generate();\r\n\r\nconst ata = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    destination.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${ata.address}!`)\r\n  \r\nlet tx = await mintTo(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    ata.address,\r\n    keypair.publicKey,\r\n    1e6,\r\n);\r\n\r\nconsole.log(`Succesfully Minted!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)","position":{"start":{"line":55,"column":1,"offset":2047},"end":{"line":77,"column":4,"offset":2514}},"data":{"highlightId":"code-1"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":77,"column":4,"offset":2514}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Instruksi Mint To\r\n\r\nMembuat token baru dan menyimpannya ke dalam akun yang ditentukan. Hanya otoritas mint yang dapat melakukan operasi ini.\r\n\r\nSebelum kita dapat melakukan mint token apa pun, kita perlu sudah memiliki:\r\n- Akun `Mint` yang sudah diinisialisasi di mana kita memegang `mintAuthority`\r\n- Akun `Token` atau akun `Associated Token` yang sudah diinisialisasi di mana kita akan melakukan mint token\r\n\r\n> Jumlah token yang kita mint \"dinormalisasi\" untuk desimal. Ini berarti jika kita ingin melakukan mint 1 token yang memiliki 6 desimal, kita perlu memasukkan `1e6` sebagai jumlahnya\r\n\r\n<ArticleSection name=\"Instruksi Raw\" id=\"raw-instruction\" level=\"h2\" />\r\n\r\nDengan menggunakan instruksi \"raw\" tanpa abstraksi apa pun, beginilah tampilan proses mint token:\r\n\r\n```ts\r\nconst destination = Keypair.generate();\r\n\r\nconst tokenAccount = await getAssociatedTokenAddress(\r\n    mint.publicKey,\r\n    destination.publicKey,\r\n);\r\n\r\n// Create ATA creation instruction\r\nconst createAtaInstruction = createAssociatedTokenAccountIdempotentInstruction(\r\n    keypair.publicKey, // payer\r\n    tokenAccount, // associated token account address\r\n    destination.publicKey, // owner\r\n    mint.publicKey, // mint\r\n);\r\n\r\n// Mint tokens to ATA \r\nconst mintToInstruction = createMintToInstruction(\r\n    mint.publicKey, // mint\r\n    tokenAccount, // destination\r\n    keypair.publicKey, // mint authority\r\n    1_000e6, // amount of tokens\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAtaInstruction,\r\n    mintToInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token accounts created and tokens minted! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\n<ArticleSection name=\"Instruksi Terabstraksi\" id=\"abstracted-instruction\" level=\"h2\" />\r\n\r\nBeginilah tampilan instruksi yang sama jika diabstraksikan dengan instruksi `mintTo()`:\r\n\r\n```ts\r\nconst destination = Keypair.generate();\r\n\r\nconst ata = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    destination.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${ata.address}!`)\r\n  \r\nlet tx = await mintTo(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    ata.address,\r\n    keypair.publicKey,\r\n    1e6,\r\n);\r\n\r\nconsole.log(`Succesfully Minted!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)\r\n```","highlightedCode":{"code-0":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"const"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" destination "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"="}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" Keypair."}]},{"type":"element","tagName":"span","properties":{"style":"color:#62E884"},"children":[{"type":"text","value":"generate"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"();"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"const"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" tokenAccount "}]},{"type":"element","tagName":"span","properties":{"style":"color