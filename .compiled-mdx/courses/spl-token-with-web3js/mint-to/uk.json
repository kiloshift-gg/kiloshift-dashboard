54}}},{"type":"paragraph","children":[{"type":"text","value":"Використовуючи лише \"сиру\" інструкцію без будь-якої абстракції, емісія токена виглядатиме так:","position":{"start":{"line":15,"column":1,"offset":758},"end":{"line":15,"column":95,"offset":852}}}],"position":{"start":{"line":15,"column":1,"offset":758},"end":{"line":15,"column":95,"offset":852}}},{"type":"code","lang":"ts","meta":null,"value":"const destination = Keypair.generate();\r\n\r\nconst tokenAccount = await getAssociatedTokenAddress(\r\n    mint.publicKey,\r\n    destination.publicKey,\r\n);\r\n\r\n// Create ATA creation instruction\r\nconst createAtaInstruction = createAssociatedTokenAccountIdempotentInstruction(\r\n    keypair.publicKey, // payer\r\n    tokenAccount, // associated token account address\r\n    destination.publicKey, // owner\r\n    mint.publicKey, // mint\r\n);\r\n\r\n// Mint tokens to ATA \r\nconst mintToInstruction = createMintToInstruction(\r\n    mint.publicKey, // mint\r\n    tokenAccount, // destination\r\n    keypair.publicKey, // mint authority\r\n    1_000e6, // amount of tokens\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAtaInstruction,\r\n    mintToInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token accounts created and tokens minted! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":17,"column":1,"offset":856},"end":{"line":49,"column":4,"offset":1850}},"data":{"highlightId":"code-0"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Abstracted Instruction","position":{"start":{"line":51,"column":17,"offset":1870},"end":{"line":51,"column":46,"offset":1899}}},{"type":"mdxJsxAttribute","name":"id","value":"abstracted-instruction","position":{"start":{"line":51,"column":47,"offset":1900},"end":{"line":51,"column":74,"offset":1927}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":51,"column":75,"offset":1928},"end":{"line":51,"column":85,"offset":1938}}}],"children":[],"position":{"start":{"line":51,"column":1,"offset":1854},"end":{"line":51,"column":88,"offset":1941}}},{"type":"paragraph","children":[{"type":"text","value":"Ось як ті самі інструкції виглядатимуть з абстракцією за допомогою інструкції ","position":{"start":{"line":53,"column":1,"offset":1945},"end":{"line":53,"column":79,"offset":2023}}},{"type":"inlineCode","value":"mintTo()","position":{"start":{"line":53,"column":79,"offset":2023},"end":{"line":53,"column":89,"offset":2033}}},{"type":"text","value":":","position":{"start":{"line":53,"column":89,"offset":2033},"end":{"line":53,"column":90,"offset":2034}}}],"position":{"start":{"line":53,"column":1,"offset":1945},"end":{"line":53,"column":90,"offset":2034}}},{"type":"code","lang":"ts","meta":null,"value":"const destination = Keypair.generate();\r\n\r\nconst ata = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    destination.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${ata.address}!`)\r\n  \r\nlet tx = await mintTo(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    ata.address,\r\n    keypair.publicKey,\r\n    1e6,\r\n);\r\n\r\nconsole.log(`Succesfully Minted!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)","position":{"start":{"line":55,"column":1,"offset":2038},"end":{"line":77,"column":4,"offset":2505}},"data":{"highlightId":"code-1"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":77,"column":4,"offset":2505}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Інструкція Mint To\r\n\r\nСтворює нові токени та депонує їх на вказаний рахунок. Цю операцію може виконувати лише орган емісії.\r\n\r\nПерш ніж ми зможемо емітувати будь-який токен, нам потрібно вже мати:\r\n- Ініціалізований рахунок `Mint`, для якого ми маємо `mintAuthority`\r\n- Ініціалізований рахунок `Token` або рахунок `Associated Token`, на який ми збираємося емітувати токени\r\n\r\n> Кількість токенів, які ми емітуємо, \"нормалізована\" для десяткових знаків. Це означає, що якщо ми хочемо емітувати 1 токен, який має 6 десяткових знаків, нам потрібно буде фактично вказати `1e6` як кількість\r\n\r\n<ArticleSection name=\"Raw Instruction\" id=\"raw-instruction\" level=\"h2\" />\r\n\r\nВикористовуючи лише \"сиру\" інструкцію без будь-якої абстракції, емісія токена виглядатиме так:\r\n\r\n```ts\r\nconst destination = Keypair.generate();\r\n\r\nconst tokenAccount = await getAssociatedTokenAddress(\r\n    mint.publicKey,\r\n    destination.publicKey,\r\n);\r\n\r\n// Create ATA creation instruction\r\nconst createAtaInstruction = createAssociatedTokenAccountIdempotentInstruction(\r\n    keypair.publicKey, // payer\r\n    tokenAccount, // associated token account address\r\n    destination.publicKey, // owner\r\n    mint.publicKey, // mint\r\n);\r\n\r\n// Mint tokens to ATA \r\nconst mintToInstruction = createMintToInstruction(\r\n    mint.publicKey, // mint\r\n    tokenAccount, // destination\r\n    keypair.publicKey, // mint authority\r\n    1_000e6, // amount of tokens\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAtaInstruction,\r\n    mintToInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token accounts created and tokens minted! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\n<ArticleSection name=\"Abstracted Instruction\" id=\"abstracted-instruction\" level=\"h2\" />\r\n\r\nОсь як ті самі інструкції виглядатимуть з абстракцією за допомогою інструкції `mintTo()`:\r\n\r\n```ts\r\nconst destination = Keypair.generate();\r\n\r\nconst ata = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    destination.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${ata.address}!`)\r\n  \r\nlet tx = await mintTo(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    ata.address,\r\n    keypair.publicKey,\r\n    1e6,\r\n);\r\n\r\nconsole.log(`Succesfully Minted!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)\r\n```","highlightedCode":{"code-0":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"const"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" destination "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"="}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" Keypair."}]},{"type":"element","tagName":"span","properties":{"style":"color:#62E884"},"children":[{"type":"text","value":"generate"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"();"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"const"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" tokenAccount "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"ch