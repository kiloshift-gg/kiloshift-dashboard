bstracted-instruction","position":{"start":{"line":51,"column":47,"offset":1895},"end":{"line":51,"column":74,"offset":1922}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":51,"column":75,"offset":1923},"end":{"line":51,"column":85,"offset":1933}}}],"children":[],"position":{"start":{"line":51,"column":1,"offset":1849},"end":{"line":51,"column":88,"offset":1936}}},{"type":"paragraph","children":[{"type":"text","value":"So würden die gleichen Anweisungen aussehen, wenn sie mit der ","position":{"start":{"line":53,"column":1,"offset":1940},"end":{"line":53,"column":63,"offset":2002}}},{"type":"inlineCode","value":"mintTo()","position":{"start":{"line":53,"column":63,"offset":2002},"end":{"line":53,"column":73,"offset":2012}}},{"type":"text","value":" Anweisung abstrahiert werden:","position":{"start":{"line":53,"column":73,"offset":2012},"end":{"line":53,"column":103,"offset":2042}}}],"position":{"start":{"line":53,"column":1,"offset":1940},"end":{"line":53,"column":103,"offset":2042}}},{"type":"code","lang":"ts","meta":null,"value":"const destination = Keypair.generate();\r\n\r\nconst ata = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    destination.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${ata.address}!`)\r\n  \r\nlet tx = await mintTo(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    ata.address,\r\n    keypair.publicKey,\r\n    1e6,\r\n);\r\n\r\nconsole.log(`Succesfully Minted!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)","position":{"start":{"line":55,"column":1,"offset":2046},"end":{"line":77,"column":4,"offset":2513}},"data":{"highlightId":"code-1"}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":77,"column":4,"offset":2513}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Mint To Instruction\r\n\r\nErstellt neue Tokens und hinterlegt sie in einem bestimmten Konto. Nur die Mint-Autorität kann diese Operation durchführen.\r\n\r\nBevor wir Tokens prägen können, benötigen wir bereits:\r\n- Ein initialisiertes `Mint` Konto, für das wir die `mintAuthority` besitzen\r\n- Ein initialisiertes `Token` Konto oder `Associated Token` Konto, in das wir die Tokens prägen werden\r\n\r\n> Die Menge der geprägten Tokens wird für Dezimalstellen \"normalisiert\". Das bedeutet, wenn wir 1 Token mit 6 Dezimalstellen prägen möchten, müssen wir tatsächlich `1e6` als Betrag angeben\r\n\r\n<ArticleSection name=\"Raw Instruction\" id=\"raw-instruction\" level=\"h2\" />\r\n\r\nBei Verwendung der \"rohen\" Anweisung ohne Abstraktion würde das Prägen eines Tokens so aussehen:\r\n\r\n```ts\r\nconst destination = Keypair.generate();\r\n\r\nconst tokenAccount = await getAssociatedTokenAddress(\r\n    mint.publicKey,\r\n    destination.publicKey,\r\n);\r\n\r\n// Create ATA creation instruction\r\nconst createAtaInstruction = createAssociatedTokenAccountIdempotentInstruction(\r\n    keypair.publicKey, // payer\r\n    tokenAccount, // associated token account address\r\n    destination.publicKey, // owner\r\n    mint.publicKey, // mint\r\n);\r\n\r\n// Mint tokens to ATA \r\nconst mintToInstruction = createMintToInstruction(\r\n    mint.publicKey, // mint\r\n    tokenAccount, // destination\r\n    keypair.publicKey, // mint authority\r\n    1_000e6, // amount of tokens\r\n);\r\n\r\nconst transaction = new Transaction().add(\r\n    createAtaInstruction,\r\n    mintToInstruction,\r\n);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token accounts created and tokens minted! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);\r\n```\r\n\r\n<ArticleSection name=\"Abstracted Instruction\" id=\"abstracted-instruction\" level=\"h2\" />\r\n\r\nSo würden die gleichen Anweisungen aussehen, wenn sie mit der `mintTo()` Anweisung abstrahiert werden:\r\n\r\n```ts\r\nconst destination = Keypair.generate();\r\n\r\nconst ata = await getOrCreateAssociatedTokenAccount(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    destination.publicKey\r\n);\r\n\r\nconsole.log(`This is your ATA: ${ata.address}!`)\r\n  \r\nlet tx = await mintTo(\r\n    connection,\r\n    keypair,\r\n    mint,\r\n    ata.address,\r\n    keypair.publicKey,\r\n    1e6,\r\n);\r\n\r\nconsole.log(`Succesfully Minted!. Transaction Here: https://explorer.solana.com/tx/${tx}?cluster=devnet`)\r\n```","highlightedCode":{"code-0":{"lang":"ts","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"const"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" destination "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"="}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" Keypair."}]},{"type":"element","tagName":"span","properties":{"style":"color:#62E884"},"children":[{"type":"text","value":"generate"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"();"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"const"}]},{"type":"element","tagName":"span","properties":{"style":"colo