olumn":1,"offset":685},"end":{"line":15,"column":102,"offset":786}}}],"position":{"start":{"line":15,"column":1,"offset":685},"end":{"line":15,"column":102,"offset":786}}},{"type":"code","lang":"ts","meta":null,"value":"// Delegate an ATA \r\nconst closeAccountInstruction = createCloseAccountInstruction(\r\n    tokenAccount // account\r\n    keypair.publickey // destination\r\n    keypair.publickey // authority\r\n);\r\n\r\nconst transaction = new Transaction().add(closeAccountInstruction);\r\n\r\nconst signature = await sendAndConfirmTransaction(connection, transaction, [keypair]);\r\n\r\nconsole.log(`Token accounts closed! Check out your TX here: https://explorer.solana.com/tx/${signature}?cluster=devnet`);","position":{"start":{"line":17,"column":1,"offset":790},"end":{"line":30,"column":4,"offset":1278}},"data":{"highlightId":"code-0"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Abstracted Instruction","position":{"start":{"line":32,"column":17,"offset":1298},"end":{"line":32,"column":46,"offset":1327}}},{"type":"mdxJsxAttribute","name":"id","value":"abstracted-instruction","position":{"start":{"line":32,"column":47,"offset":1328},"end":{"line":32,"column":74,"offset":1355}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":32,"column":75,"offset":1356},"end":{"line":32,"column":85,"offset":1366}}}],"children":[],"position":{"start":{"line":32,"column":1,"offset":1282},"end":{"line":32,"column":88,"offset":1369}}},{"type":"paragraph","children":[{"type":"text","value":"So würden die gleichen Anweisungen aussehen, wenn sie mit der ","position":{"start":{"line":34,"column":1,"offset":1373},"end":{"line":34,"column":63,"offset":1435}}},{"type":"inlineCode","value":"closeAccount()","position":{"start":{"line":34,"column":63,"offset":1435},"end":{"line":34,"column":79,"offset":1451}}},{"type":"text","value":"Anweisung abstrahiert werden:","position":{"start":{"lin