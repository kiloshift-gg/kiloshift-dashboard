}}],"position":{"start":{"line":24,"column":1,"offset":1877},"end":{"line":24,"column":136,"offset":2012}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Tham gia Cộng đồng: Kết nối với các developer khác sử dụng Mollusk để chia sẻ chiến lược kiểm thử và best practice trên discord của chúng tôi","position":{"start":{"line":25,"column":4,"offset":2017},"end":{"line":25,"column":145,"offset":2158}}}],"position":{"start":{"line":25,"column":4,"offset":2017},"end":{"line":25,"column":145,"offset":2158}}}],"position":{"start":{"line":25,"column":1,"offset":2014},"end":{"line":25,"column":145,"offset":2158}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Cập nhật thường xuyên: Theo dõi ","position":{"start":{"line":26,"column":4,"offset":2163},"end":{"line":26,"column":36,"offset":2195}}},{"type":"link","title":null,"url":"https://github.com/anza-xyz/mollusk","children":[{"type":"text","value":"repository Mollusk","position":{"start":{"line":26,"column":37,"offset":2196},"end":{"line":26,"column":55,"offset":2214}}}],"position":{"start":{"line":26,"column":36,"offset":2195},"end":{"line":26,"column":93,"offset":2252}}},{"type":"text","value":" cho các feature và cải tiến mới nhất","position":{"start":{"line":26,"column":93,"offset":2252},"end":{"line":26,"column":130,"offset":2289}}}],"position":{"start":{"line":26,"column":4,"offset":2163},"end":{"line":26,"column":130,"offset":2289}}}],"position":{"start":{"line":26,"column":1,"offset":2160},"end":{"line":26,"column":130,"offset":2289}}}],"position":{"start":{"line":23,"column":1,"offset":1581},"end":{"line":26,"column":130,"offset":2289}}},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"Đặc biệt cảm ơn Mohammed Zeeshan đã thực hiện công việc ban đầu về nội dung mà bạn có thể tìm thấy trong ","position":{"start":{"line":28,"column":3,"offset":2295},"end":{"line":28,"column":108,"offset":2400}}},{"type":"link","title":null,"url":"https://github.com/alizeeshan1234/mollusk_testing","children":[{"type":"text","value":"repo này","position":{"start":{"line":28,"column":109,"offset":2401},"end":{"line":28,"column":117,"offset":2409}}}],"position":{"start":{"line":28,"column":108,"offset":2400},"end":{"line":28,"column":169,"offset":2461}}}],"position":{"start":{"line":28,"column":3,"offset":2295},"end":{"line":28,"column":169,"offset":2461}}}],"position":{"start":{"line":28,"column":1,"offset":2293},"end":{"line":28,"column":169,"offset":2461}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":28,"column":169,"offset":2461}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Kết luận\r\n\r\nChúc mừng! Bạn đã hoàn thành khóa học Testing with Mollusk. Giờ đây bạn đã có hiểu biết toàn diện về cách sử dụng Mollusk, một framework kiểm thử nhẹ mạnh mẽ cho các chương trình Solana cung cấp thực thi nhanh, kiểm soát chính xác, và cái nhìn sâu sắc về hiệu suất chi tiết.\r\n\r\n<ArticleSection name=\"Những gì bạn đã học\" id=\"what-you-learned\" level=\"h2\" />\r\n\r\nTrong suốt khóa học này, bạn đã có được kiến thức thiết yếu về:\r\n- Cách Mollusk cung cấp môi trường kiểm thử được tối ưu hóa sử dụng các thành phần Solana Virtual Machine (SVM) cấp thấp\r\n- Những lợi thế của cách tiếp cận nhẹ của Mollusk so với mô phỏng validator đầy đủ\r\n- Thiết lập Mollusk với crate `mollusk-svm` cốt lõi và bộ công cụ hỗ trợ cụ thể cho chương trình\r\n- Sử dụng 4 API thực thi chính của Mollusk cho kiểm thử instruction đơn lẻ và chuỗi\r\n- Triển khai kiểm tra xác thực toàn diện cho điều kiện thành công, compute unit, và trạng thái account\r\n- Tạo token account được khởi tạo sẵn (Mint, Token Account, Associated Token Account)\r\n- Benchmarking mức tiêu thụ compute unit với `MolluskComputeUnitBencher`\r\n- Phát triển và kiểm thử custom syscall cho chức năng chuyên biệt\r\n- Tùy chỉnh môi trường thực thi thông qua compute budget, feature set, và sysvar\r\n\r\n<ArticleSection name=\"Các bước tiếp theo\" id=\"next-steps\" level=\"h2\" />\r\n\r\nBây giờ bạn đã được trang bị kiến thức để xây dựng các chương trình Solana mạnh mẽ, được kiểm thử kỹ lưỡng sử dụng Mollusk! Đây là một số bước tiếp theo được khuyến nghị:\r\n1. Thực hành với Chương trình thực tế: Áp dụng kiến thức Mollusk của bạn để kiểm thử các chương trình [Anchor Programs](/vi/courses/anchor-for-dummies/testing-your-program#mollusk-tests) hoặc [Pinocchio Programs](/vi/courses/introduction-to-pinocchio/testing-your-program#mollusk-tests) của bạn\r\n2. Khám phá thử thách: Truy cập [phần Thử thách](/vi/challenges) cho các bài tập thực hành sẽ giúp bạn áp dụng kỹ năng kiểm thử Mollusk\r\n3. Tham gia Cộng đồng: Kết nối với các developer khác sử dụng Mollusk để chia sẻ chiến lược kiểm thử và best practice trên discord của chúng tôi\r\n4. Cập nhật thường xuyên: Theo dõi [repository Mollusk](https://github.com/anza-xyz/mollusk) cho các feature và cải tiến mới nhất\r\n\r\n> Đặc biệt cảm ơn Mohammed Zeeshan đã thực hiện công việc ban đầu về nội dung mà bạn có thể tìm thấy trong [repo này](https://github.com/alizeeshan1234/mollusk_testing)","highlightedCode":{}}