ez une instruction pour cela en utilisant un discriminateur d'instruction valant ","position":{"start":{"line":19,"column":5,"offset":1278},"end":{"line":19,"column":257,"offset":1530}}},{"type":"inlineCode","value":"2","position":{"start":{"line":19,"column":257,"offset":1530},"end":{"line":19,"column":260,"offset":1533}}},{"type":"text","value":".","position":{"start":{"line":19,"column":260,"offset":1533},"end":{"line":19,"column":261,"offset":1534}}}],"position":{"start":{"line":19,"column":5,"offset":1278},"end":{"line":19,"column":261,"offset":1534}}}],"position":{"start":{"line":18,"column":3,"offset":1221},"end":{"line":20,"column":17,"offset":1552}}},{"type":"mdxJsxFlowElement","name":"Requirement","attributes":[{"type":"mdxJsxAttribute","name":"title","value":"Challenge 4: Échanger","position":{"start":{"line":22,"column":16,"offset":1571},"end":{"line":22,"column":45,"offset":1600}}}],"children":[{"type":"paragraph","children":[{"type":"text","value":"Votre programme doit permettre à un utilisateur de pouvoir échanger depuis une pool de liquidités d'un Amm. Définissez une instruction pour cela en utilisant un discriminateur d'instruction valant ","position":{"start":{"line":23,"column":5,"offset":1607},"end":{"line":23,"column":202,"offset":1804}}},{"type":"inlineCode","value":"3","position":{"start":{"line":23,"column":202,"offset":1804},"end":{"line":23,"column":205,"offset":1807}}},{"type":"text","value":".","position":{"start":{"line":23,"column":205,"offset":1807},"end":{"line":23,"column":206,"offset":1808}}}],"position":{"start":{"line":23,"column":5,"offset":1607},"end":{"line":23,"column":206,"offset":1808}}}],"position":{"start":{"line":22,"column":3,"offset":1558},"end":{"line":24,"column":17,"offset":1826}}}],"position":{"start":{"line":9,"column":1,"offset":530},"end":{"line":25,"column":19,"offset":1846}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":25,"column":19,"offset":1846}}},"raw":"import { ChallengeTitle } from \"../../../../components/Challenges/ChallengeTitle\";\r\nimport { RequirementList } from \"../../../../components/Challenges/RequirementList\";\r\nimport { Requirement } from \"../../../../components/Challenges/Requirement\";\r\n\r\n<ChallengeTitle>AMM avec Pinocchio</ChallengeTitle>\r\n\r\nIl est maintenant temps de mettre à l'épreuve ce que vous avez appris. En utilisant ce que vous avez appris dans cette leçon, créez un programme amm en utilisant le framework Pinocchio qui répond aux exigences suivantes :\r\n\r\n<RequirementList>\r\n  <Requirement title=\"Challenge 1: Création du compte `Config`\">\r\n    Votre programme doit permettre à un `initializer` de créer un compte `config` et un compte de `Mint` pour votre jeton LP. Définissez une instruction pour cela en utilisant un discriminateur d'instruction valant `0`.\r\n  </Requirement>\r\n\r\n  <Requirement title=\"Challenge 2: Dépôt dans l'Amm\">\r\n    Votre programme doit permettre à un utilisateur d'effectuer un dépôt dans une pool de liquidités d'un Amm et de calculer le nombre de jetons LP qu'il recevra en échange de sa contribution. Définissez une instruction pour cela en utilisant un discriminateur d'instruction valant `1`.\r\n  </Requirement>\r\n\r\n  <Requirement title=\"Challenge 3: Retrait de l'Amm\">\r\n    Votre programme doit permettre à un utilisateur de retirer des fonds d'une pool de liquidités d'un Amm et de calculer la quantité de jetons LP à brûler pour cela. Définissez une instruction pour cela en utilisant un discriminateur d'instruction valant `2`.\r\n  </Requirement>\r\n\r\n  <Requirement title=\"Challenge 4: Échanger\">\r\n    Votre programme doit permettre à un utilisateur de pouvoir échanger depuis une pool de liquidités d'un Amm. Définissez une instruction pour cela en utilisant un discriminateur d'instruction valant `3`.\r\n  </Requirement>\r\n</RequirementList>","highlightedCode":{}}