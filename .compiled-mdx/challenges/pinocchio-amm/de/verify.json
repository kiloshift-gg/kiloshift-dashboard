niere eine Anweisung dafür mit einem Anweisungsdiskriminatorwert von ","position":{"start":{"line":19,"column":5,"offset":1276},"end":{"line":19,"column":247,"offset":1518}}},{"type":"inlineCode","value":"2","position":{"start":{"line":19,"column":247,"offset":1518},"end":{"line":19,"column":250,"offset":1521}}},{"type":"text","value":".","position":{"start":{"line":19,"column":250,"offset":1521},"end":{"line":19,"column":251,"offset":1522}}}],"position":{"start":{"line":19,"column":5,"offset":1276},"end":{"line":19,"column":251,"offset":1522}}}],"position":{"start":{"line":18,"column":3,"offset":1209},"end":{"line":20,"column":17,"offset":1540}}},{"type":"mdxJsxFlowElement","name":"Requirement","attributes":[{"type":"mdxJsxAttribute","name":"title","value":"Herausforderung 4: Tausch im AMM","position":{"start":{"line":22,"column":16,"offset":1559},"end":{"line":22,"column":56,"offset":1599}}}],"children":[{"type":"paragraph","children":[{"type":"text","value":"Dein Programm sollte einem Benutzer ermöglichen, im Liquiditätspool eines AMM zu tauschen. Definiere eine Anweisung dafür mit einem Anweisungsdiskriminatorwert von ","position":{"start":{"line":23,"column":5,"offset":1606},"end":{"line":23,"column":169,"offset":1770}}},{"type":"inlineCode","value":"3","position":{"start":{"line":23,"column":169,"offset":1770},"end":{"line":23,"column":172,"offset":1773}}},{"type":"text","value":".","position":{"start":{"line":23,"column":172,"offset":1773},"end":{"line":23,"column":173,"offset":1774}}}],"position":{"start":{"line":23,"column":5,"offset":1606},"end":{"line":23,"column":173,"offset":1774}}}],"position":{"start":{"line":22,"column":3,"offset":1546},"end":{"line":24,"column":17,"offset":1792}}}],"position":{"start":{"line":9,"column":1,"offset":525},"end":{"line":25,"column":19,"offset":1812}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":26,"column":1,"offset":1814}}},"raw":"import { ChallengeTitle } from \"../../../../components/Challenges/ChallengeTitle\";\r\nimport { RequirementList } from \"../../../../components/Challenges/RequirementList\";\r\nimport { Requirement } from \"../../../../components/Challenges/Requirement\";\r\n\r\n<ChallengeTitle>Pinocchio AMM</ChallengeTitle>\r\n\r\nEs ist nun an der Zeit, dein erlerntes Wissen auf die Probe zu stellen. Nutze das, was du in der Lektion gelernt hast, um ein AMM-Programm mit dem Pinocchio-Framework zu erstellen, das die folgenden Anforderungen erfüllt:\r\n\r\n<RequirementList>\r\n  <Requirement title=\"Herausforderung 1: Erstellen des `Config` Kontos\">\r\n    Dein Programm sollte einem `initializer` ermöglichen, ein `config` Konto zu erstellen und ein `Mint` Konto für deinen LP-Token zu erstellen. Definiere eine Anweisung dafür mit einem Anweisungsdiskriminator mit dem Wert `0`.\r\n  </Requirement>\r\n\r\n  <Requirement title=\"Herausforderung 2: Einzahlung in das AMM\">\r\n    Dein Programm sollte einem Benutzer ermöglichen, in den Liquiditätspool eines AMM einzuzahlen und die Menge an LP-Tokens zu berechnen, die sie für ihren Beitrag erhalten. Definiere eine Anweisung dafür mit einem Anweisungsdiskriminatorwert von `1`.\r\n  </Requirement>\r\n\r\n  <Requirement title=\"Herausforderung 3: Abhebung aus dem AMM\">\r\n    Dein Programm sollte einem Benutzer ermöglichen, aus dem Liquiditätspool eines AMM abzuheben und die Menge an LP-Tokens zu berechnen, die dafür verbrannt werden sollen. Definiere eine Anweisung dafür mit einem Anweisungsdiskriminatorwert von `2`.\r\n  </Requirement>\r\n\r\n  <Requirement title=\"Herausforderung 4: Tausch im AMM\">\r\n    Dein Programm sollte einem Benutzer ermöglichen, im Liquiditätspool eines AMM zu tauschen. Definiere eine Anweisung dafür mit einem Anweisungsdiskriminatorwert von `3`.\r\n  </Requirement>\r\n</RequirementList>\r\n","highlightedCode":{}}