n":{"start":{"line":11,"column":233,"offset":797},"end":{"line":11,"column":234,"offset":798}}}],"position":{"start":{"line":11,"column":5,"offset":569},"end":{"line":11,"column":234,"offset":798}}}],"position":{"start":{"line":10,"column":3,"offset":492},"end":{"line":12,"column":17,"offset":816}}},{"type":"mdxJsxFlowElement","name":"Requirement","attributes":[{"type":"mdxJsxAttribute","name":"title","value":"Завдання 2: Внесення депозиту в Amm","position":{"start":{"line":14,"column":16,"offset":835},"end":{"line":14,"column":59,"offset":878}}}],"children":[{"type":"paragraph","children":[{"type":"text","value":"Ваша програма повинна дозволяти користувачу вносити депозит у пул ліквідності Amm і розраховувати кількість токенів LP, які вони отримають за свій внесок. Визначте інструкцію для цього, використовуючи значення дискримінатора інструкцій ","position":{"start":{"line":15,"column":5,"offset":885},"end":{"line":15,"column":241,"offset":1121}}},{"type":"inlineCode","value":"1","position":{"start":{"line":15,"column":241,"offset":1121},"end":{"line":15,"column":244,"offset":1124}}},{"type":"text","value":".","position":{"start":{"line":15,"column":244,"offset":1124},"end":{"line":15,"column":245,"offset":1125}}}],"position":{"start":{"line":15,"column":5,"offset":885},"end":{"line":15,"column":245,"offset":1125}}}],"position":{"start":{"line":14,"column":3,"offset":822},"end":{"line":16,"column":17,"offset":1143}}},{"type":"mdxJsxFlowElement","name":"Requirement","attributes":[{"type":"mdxJsxAttribute","name":"title","value":"Завдання 3: Виведення коштів з Amm","position":{"start":{"line":18,"column":16,"offset":1162},"end":{"line":18,"column":58,"offset":1204}}}],"children":[{"type":"paragraph","children":[{"type":"text","value":"Ваша програма повинна дозволяти користувачу виводити кошти з пулу ліквідності Amm і розраховувати кількість токенів LP для спалювання. Визначте інструкцію для цього, використовуючи значення дискримінатора інструкцій ","position":{"start":{"line":19,"column":5,"offset":1211},"end":{"line":19,"column":221,"offset":1427}}},{"type":"inlineCode","value":"2","position":{"start":{"line":19,"column":221,"offset":1427},"end":{"line":19,"column":224,"offset":1430}}},{"type":"text","value":".","position":{"start":{"line":19,"column":224,"offset":1430},"end":{"line":19,"column":225,"offset":1431}}}],"position":{"start":{"line":19,"column":5,"offset":1211},"end":{"line":19,"column":225,"offset":1431}}}],"position":{"start":{"line":18,"column":3,"offset":1149},"end":{"line":20,"column":17,"offset":1449}}},{"type":"mdxJsxFlowElement","name":"Requirement","attributes":[{"type":"mdxJsxAttribute","name":"title","value":"Завдання 4: Обмін в Amm","position":{"start":{"line":22,"column":16,"offset":1468},"end":{"line":22,"column":47,"offset":1499}}}],"children":[{"type":"paragraph","children":[{"type":"text","value":"Ваша програма повинна дозволяти користувачу здійснювати обмін з пулу ліквідності Amm. Визначте інструкцію для цього, використовуючи значення дискримінатора інструкцій ","position":{"start":{"line":23,"column":5,"offset":1506},"end":{"line":23,"column":172,"offset":1673}}},{"type":"inlineCode","value":"3","position":{"start":{"line":23,"column":172,"offset":1673},"end":{"line":23,"column":175,"offset":1676}}},{"type":"text","value":".","position":{"start":{"line":23,"column":175,"offset":1676},"end":{"line":23,"column":176,"offset":1677}}}],"position":{"start":{"line":23,"column":5,"offset":1506},"end":{"line":23,"column":176,"offset":1677}}}],"position":{"start":{"line":22,"column":3,"offset":1455},"end":{"line":24,"column":17,"offset":1695}}}],"position":{"start":{"line":9,"column":1,"offset":471},"end":{"line":25,"column":19,"offset":1715}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":26,"column":1,"offset":1717}}},"raw":"import { ChallengeTitle } from \"../../../../components/Challenges/ChallengeTitle\";\r\nimport { RequirementList } from \"../../../../components/Challenges/RequirementList\";\r\nimport { Requirement } from \"../../../../components/Challenges/Requirement\";\r\n\r\n<ChallengeTitle>Pinocchio AMM</ChallengeTitle>\r\n\r\nТепер час перевірити те, що ви вивчили. Використовуючи знання, отримані з уроку, створіть програму amm за допомогою фреймворку Pinocchio, яка відповідає таким вимогам:\r\n\r\n<RequirementList>\r\n  <Requirement title=\"Завдання 1: Створення облікового запису `Config` \">\r\n    Ваша програма повинна дозволяти `initializer` створювати обліковий запис `config` та створювати обліковий запис `Mint` для вашого токена LP. Визначте інструкцію для цього, використовуючи дискримінатор інструкцій зі значенням `0`.\r\n  </Requirement>\r\n\r\n  <Requirement title=\"Завдання 2: Внесення депозиту в Amm\">\r\n    Ваша програма повинна дозволяти користувачу вносити депозит у пул ліквідності Amm і розраховувати кількість токенів LP, які вони отримають за свій внесок. Визначте інструкцію для цього, використовуючи значення дискримінатора інструкцій `1`.\r\n  </Requirement>\r\n\r\n  <Requirement title=\"Завдання 3: Виведення коштів з Amm\">\r\n    Ваша програма повинна дозволяти користувачу виводити кошти з пулу ліквідності Amm і розраховувати кількість токенів LP для спалювання. Визначте інструкцію для цього, використовуючи значення дискримінатора інструкцій `2`.\r\n  </Requirement>\r\n\r\n  <Requirement title=\"Завдання 4: Обмін в Amm\">\r\n    Ваша програма повинна дозволяти користувачу здійснювати обмін з пулу ліквідності Amm. Визначте інструкцію для цього, використовуючи значення дискримінатора інструкцій `3`.\r\n  </Requirement>\r\n</RequirementList>\r\n","highlightedCode":{}}