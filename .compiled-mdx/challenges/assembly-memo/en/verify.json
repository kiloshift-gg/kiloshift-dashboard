sition":{"start":{"line":24,"column":40,"offset":1124},"end":{"line":24,"column":56,"offset":1140}}}],"position":{"start":{"line":24,"column":5,"offset":1089},"end":{"line":24,"column":56,"offset":1140}}}],"position":{"start":{"line":23,"column":3,"offset":1032},"end":{"line":25,"column":17,"offset":1158}}},{"type":"mdxJsxFlowElement","name":"Requirement","attributes":[{"type":"mdxJsxAttribute","name":"title","value":"Challenge 2: Testing the Memo with Different Input","position":{"start":{"line":27,"column":16,"offset":1177},"end":{"line":27,"column":74,"offset":1235}}}],"children":[{"type":"paragraph","children":[{"type":"text","value":"To make sure that you didn't hardcode the ","position":{"start":{"line":28,"column":5,"offset":1242},"end":{"line":28,"column":47,"offset":1284}}},{"type":"inlineCode","value":"Hello, Solana!","position":{"start":{"line":28,"column":47,"offset":1284},"end":{"line":28,"column":63,"offset":1300}}},{"type":"text","value":" string, we try again with another input: ","position":{"start":{"line":28,"column":63,"offset":1300},"end":{"line":28,"column":105,"offset":1342}}},{"type":"inlineCode","value":"Hello, Solana, but different!","position":{"start":{"line":28,"column":105,"offset":1342},"end":{"line":28,"column":136,"offset":1373}}}],"position":{"start":{"line":28,"column":5,"offset":1242},"end":{"line":28,"column":136,"offset":1373}}}],"position":{"start":{"line":27,"column":3,"offset":1164},"end":{"line":29,"column":17,"offset":1391}}}],"position":{"start":{"line":22,"column":1,"offset":1011},"end":{"line":30,"column":19,"offset":1411}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":35,"column":1,"offset":1421}}},"raw":"import { ChallengeTitle } from \"../../../../components/Challenges/ChallengeTitle\";\r\nimport { RequirementList } from \"../../../../components/Challenges/RequirementList\";\r\nimport { Requirement } from \"../../../../components/Challenges/Requirement\";\r\n\r\n<ChallengeTitle>sBPF Assembly Memo</ChallengeTitle>\r\n\r\nCreate a program only has one instruction. It must:\r\n- Should fail if the instruction data contains any accounts (this can be done by setting `r0` to the number of accounts)\r\n- Set `r2` to the length of the instruction data, and `r1` to the offset of the instruction data, \r\n- Invoke the `sol_log_` syscall.\r\n\r\nStart by installing the sBPF package like explained in the [tooling section](/en/courses/introduction-to-assembly/tooling) of the Introduction to Assembly course and build your program using the following command in your terminal:\r\n\r\n```\r\nsbpf build\r\n```\r\n\r\nThis will generate a `.so` file in your `target/deploy` folder. \r\n\r\nNow click on the `take challenge` button and drop the file there!\r\n\r\n<RequirementList>\r\n  <Requirement title=\"Challenge 1: Testing the Memo\">\r\n    Your program should suceed and log `Hello, Solana!`\r\n  </Requirement>\r\n\r\n  <Requirement title=\"Challenge 2: Testing the Memo with Different Input\">\r\n    To make sure that you didn't hardcode the `Hello, Solana!` string, we try again with another input: `Hello, Solana, but different!`\r\n  </Requirement>\r\n</RequirementList>\r\n\r\n\r\n\r\n\r\n","highlightedCode":{"code-0":{"lang":"text","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{},"children":[{"type":"text","value":"sbpf build"}]}]}]}]}]}}}}