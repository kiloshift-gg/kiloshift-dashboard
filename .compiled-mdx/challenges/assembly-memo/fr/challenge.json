"offset":3217},"end":{"line":74,"column":30,"offset":3246}}},{"type":"inlineCode","value":"sol_log_","position":{"start":{"line":74,"column":30,"offset":3246},"end":{"line":74,"column":40,"offset":3256}}},{"type":"text","value":" et nous terminons :","position":{"start":{"line":74,"column":40,"offset":3256},"end":{"line":74,"column":60,"offset":3276}}}],"position":{"start":{"line":74,"column":1,"offset":3217},"end":{"line":74,"column":60,"offset":3276}}},{"type":"code","lang":"sbpf","meta":null,"value":"call 16   ; Call sol_log_ (helper ID 16)\r\nexit      ; Return using r0 value","position":{"start":{"line":76,"column":1,"offset":3280},"end":{"line":79,"column":4,"offset":3369}},"data":{"highlightId":"code-4"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Conclusion","position":{"start":{"line":81,"column":17,"offset":3389},"end":{"line":81,"column":34,"offset":3406}}},{"type":"mdxJsxAttribute","name":"id","value":"conclusion","position":{"start":{"line":81,"column":35,"offset":3407},"end":{"line":81,"column":50,"offset":3422}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":81,"column":51,"offset":3423},"end":{"line":81,"column":61,"offset":3433}}}],"children":[],"position":{"start":{"line":81,"column":1,"offset":3373},"end":{"line":81,"column":64,"offset":3436}}},{"type":"paragraph","children":[{"type":"text","value":"Le programme :","position":{"start":{"line":83,"column":1,"offset":3440},"end":{"line":83,"column":15,"offset":3454}}}],"position":{"start":{"line":83,"column":1,"offset":3440},"end":{"line":83,"column":15,"offset":3454}}},{"type":"list","ordered":true,"start":1,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Appelle 16 (","position":{"start":{"line":84,"column":4,"offset":3459},"end":{"line":84,"column":16,"offset":3471}}},{"type":"inlineCode","value":"sol_log_","position":{"start":{"line":84,"column":16,"offset":3471},"end":{"line":84,"column":26,"offset":3481}}},{"type":"text","value":") pour afficher le mémo dans le journal du validateur","position":{"start":{"line":84,"column":26,"offset":3481},"end":{"line":84,"column":79,"offset":3534}}}],"position":{"start":{"line":84,"column":4,"offset":3459},"end":{"line":84,"column":79,"offset":3534}}}],"position":{"start":{"line":84,"column":1,"offset":3456},"end":{"line":84,"column":79,"offset":3534}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Se termine en utilisant la valeur dans ","position":{"start":{"line":85,"column":4,"offset":3539},"end":{"line":85,"column":43,"offset":3578}}},{"type":"inlineCode","value":"r0","position":{"start":{"line":85,"column":43,"offset":3578},"end":{"line":85,"column":47,"offset":3582}}}],"position":{"start":{"line":85,"column":4,"offset":3539},"end":{"line":85,"column":47,"offset":3582}}}],"position":{"start":{"line":85,"column":1,"offset":3536},"end":{"line":85,"column":47,"offset":3582}}}],"position":{"start":{"line":84,"column":1,"offset":3456},"end":{"line":85,"column":47,"offset":3582}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":85,"column":47,"offset":3582}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n![Assembly Memo Challenge](/graphics/challenge-banners/assembly-memo.png)\r\n\r\n# Assembly Memo\r\n\r\nDans cette unité, nous utiliserons l'assembleur sBPF pour créer un mécanisme de journalisation pour notre programme.\r\n\r\nLa simplicité d'un programme mémo de petite taille est le point de départ idéal pour votre voyage dans l'assembleur sBPF !\r\n\r\nSi vous n'êtes pas familier avec la programmation en assembleur, suivez le [cours d'introduction à l'assembleur](/en/courses/introduction-to-assembly)\r\n\r\n<ArticleSection name=\"Conception du programme\" id=\"program-design\" level=\"h2\" />\r\n\r\nNotre programme va simplement placer l'emplacement mémoire approprié dans le bon registre, puis effectuer l'appel système `sol_log_`. Cela ressemblera à ceci :\r\n\r\n```sbpf\r\n.equ NUM_ACCOUNTS, 0x00\r\n.equ DATA_LEN, 0x08\r\n.equ DATA, 0x10\r\n.globl entrypoint\r\nentrypoint:\r\n  ldxdw r0, [r1+NUM_ACCOUNTS]\r\n  ldxdw r2, [r1+DATA_LEN]\r\n  add64 r1, DATA\r\n  call sol_log_\r\n  exit\r\n```\r\n\r\n<ArticleSection name=\"Décalages mémoire\" id=\"memory-offsets\" level=\"h2\" />\r\n\r\nLe programme commence par déclarer trois constantes `.equ` qui définissent la disposition mémoire de nos données d'instruction :\r\n\r\n```sbpf\r\n.equ NUM_ACCOUNTS, 0x00  ; Offset for number of accounts\r\n.equ DATA_LEN, 0x08      ; Offset for data length\r\n.equ DATA, 0x10          ; Offset for actual data\r\n```\r\n\r\nCes constantes marquent les décalages d'octets relatifs au pointeur du tampon d'entrée dans `r1` :\r\n- `NUM_ACCOUNTS` (0x0000) : Pointe vers le nombre de comptes dans l'en-tête des données d'instruction pour validation\r\n- `DATA_LEN` (0x08) : Pointe vers la longueur des données d'instruction dans l'en-tête des données d'instruction\r\n- `DATA` (0x10) : Pointe vers les données d'instruction dans l'en-tête des données d'instruction\r\n\r\nContrairement aux langages de haut niveau qui abstraient la disposition mémoire, l'assembleur nécessite de savoir exactement où se trouve chaque élément de données.\r\n\r\n<ArticleSection name=\"Point d'entrée et validation initiale\" id=\"entrypoint-and-validations\" level=\"h2\" />\r\n\r\n```sbpf\r\n.globl entrypoint\r\nentrypoint:\r\n  ldxdw r0, [r1+NUM_ACCOUNTS]   ; Load number of accounts into r0\r\n```\r\n\r\nChaque programme sBPF commence par un symbole global `.entrypoint`. Le runtime Solana fournit les données de compte et d'instruction via le registre `r1`.\r\n\r\nCette première instruction charge ensuite le nombre de comptes dans `r0`. Comme `r0` est le registre que la VM lit à la sortie, cela sert deux objectifs :\r\n1. Il charge le nombre de comptes pour notre utilisation\r\n2. Il garantit que le programme échouera automatiquement si des comptes sont transmis (valeur non nulle dans r0)\r\n\r\n<ArticleSection name=\"Appel système Sol Log\" id=\"sol-log-syscall\" level=\"h2\" />\r\n\r\nEnsuite, nous préparons les arguments pour l'appel système `sol_log_` :\r\n\r\n```sbpf\r\nldxdw r2, [r1+DATA_LEN]   ; Load length of memo into r2\r\nadd64  r1, DATA           ; Adjust r1 to point to memo bytes\r\n```\r\n\r\nCes instructions configurent les arguments pour `sol_log_` :\r\n- `r2` reçoit la longueur des données du mémo\r\n- `r1` est ajusté pour pointer directement vers les octets du mémo\r\n\r\nEt après cela, nous appelons `sol_log_` et nous terminons :\r\n\r\n```sbpf\r\ncall 16   ; Call sol_log_ (helper ID 16)\r\nexit      ; Return using r0 value\r\n```\r\n\r\n<ArticleSection name=\"Conclusion\" id=\"conclusion\" level=\"h2\" />\r\n\r\nLe programme :\r\n1. Appelle 16 (`sol_log_`) pour afficher le mémo dans le journal du validateur\r\n2. Se termine en utilisant la valeur dans `r0`","highlightedCode":{"code-0":{"lang":"sbpf","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":".equ NUM_ACCOUNTS, "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F1FA8C"},"children":[{"type":"text","value":"0x00"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":".equ DATA_LEN, "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F1FA8C"},"children":[{"type":"text","value":"0x08"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":".equ DATA, "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F1FA8C"},"children":[{"type":"text","value":"0x10"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#FF79C6"},"children":[{"type":"text","value":".globl"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" entrypoint"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#8BE9FD;font-weight:bold"},"children":[{"type":"text","value":"entrypoint:"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#FF79C6;font-weight:bold"},"children":[{"type":"text","value":"  ldxdw"}]},{"type":"element","tagName":"span","properties":{"style":"color:#BD93F9"},"children":[{"type":"text","value":" r0"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":", ["}]},{"type":"element","tagName":"span","properties":{"style":"color:#BD93F9"},"children":[{"type":"text","value":"r1"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"+NUM_ACCOUNTS]"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#FF79C6;font-weight:bold"},"children":[{"type":"text"