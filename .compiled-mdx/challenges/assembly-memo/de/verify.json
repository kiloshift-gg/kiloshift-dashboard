lumn":63,"offset":1185}}},{"type":"text","value":" protokollieren","position":{"start":{"line":24,"column":63,"offset":1185},"end":{"line":24,"column":78,"offset":1200}}}],"position":{"start":{"line":24,"column":5,"offset":1127},"end":{"line":24,"column":78,"offset":1200}}}],"position":{"start":{"line":23,"column":3,"offset":1070},"end":{"line":25,"column":17,"offset":1218}}},{"type":"mdxJsxFlowElement","name":"Requirement","attributes":[{"type":"mdxJsxAttribute","name":"title","value":"Challenge 2: Testen des Memos mit unterschiedlicher Eingabe","position":{"start":{"line":27,"column":16,"offset":1237},"end":{"line":27,"column":83,"offset":1304}}}],"children":[{"type":"paragraph","children":[{"type":"text","value":"Um sicherzustellen, dass du den String ","position":{"start":{"line":28,"column":5,"offset":1311},"end":{"line":28,"column":44,"offset":1350}}},{"type":"inlineCode","value":"Hello, Solana!","position":{"start":{"line":28,"column":44,"offset":1350},"end":{"line":28,"column":60,"offset":1366}}},{"type":"text","value":" nicht fest codiert hast, versuchen wir es erneut mit einer anderen Eingabe: ","position":{"start":{"line":28,"column":60,"offset":1366},"end":{"line":28,"column":137,"offset":1443}}},{"type":"inlineCode","value":"Hello, Solana, but different!","position":{"start":{"line":28,"column":137,"offset":1443},"end":{"line":28,"column":168,"offset":1474}}}],"position":{"start":{"line":28,"column":5,"offset":1311},"end":{"line":28,"column":168,"offset":1474}}}],"position":{"start":{"line":27,"column":3,"offset":1224},"end":{"line":29,"column":17,"offset":1492}}}],"position":{"start":{"line":22,"column":1,"offset":1049},"end":{"line":30,"column":19,"offset":1512}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":31,"column":1,"offset":1514}}},"raw":"import { ChallengeTitle } from \"../../../../components/Challenges/ChallengeTitle\";\r\nimport { RequirementList } from \"../../../../components/Challenges/RequirementList\";\r\nimport { Requirement } from \"../../../../components/Challenges/Requirement\";\r\n\r\n<ChallengeTitle>sBPF Assembly Memo</ChallengeTitle>\r\n\r\nErstelle ein Programm, das nur eine Anweisung hat. Es muss:\r\n- Fehlschlagen, wenn die Anweisungsdaten Konten enthalten (dies kann erreicht werden, indem `r0` auf die Anzahl der Konten gesetzt wird)\r\n- `r2` auf die Länge der Anweisungsdaten setzen und `r1` auf den Offset der Anweisungsdaten\r\n- Den `sol_log_` Syscall aufrufen.\r\n\r\nBeginne mit der Installation des sBPF-Pakets, wie im [Tooling-Abschnitt](/de/courses/introduction-to-assembly/tooling) des Kurses \"Einführung in Assembly\" erklärt, und erstelle dein Programm mit dem folgenden Befehl in deinem Terminal:\r\n\r\n```\r\nsbpf build\r\n```\r\n\r\nDies generiert eine `.so` Datei in deinem `target/deploy` Ordner.\r\n\r\nKlicke jetzt auf die Schaltfläche `take challenge` und lege die Datei dort ab!\r\n\r\n<RequirementList>\r\n  <Requirement title=\"Challenge 1: Testen des Memos\">\r\n    Dein Programm sollte erfolgreich sein und `Hello, Solana!` protokollieren\r\n  </Requirement>\r\n\r\n  <Requirement title=\"Challenge 2: Testen des Memos mit unterschiedlicher Eingabe\">\r\n    Um sicherzustellen, dass du den String `Hello, Solana!` nicht fest codiert hast, versuchen wir es erneut mit einer anderen Eingabe: `Hello, Solana, but different!`\r\n  </Requirement>\r\n</RequirementList>\r\n","highlightedCode":{"code-0":{"lang":"text","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{},"children":[{"type":"text","value":"sbpf build"}]}]}]}]}]}}}}