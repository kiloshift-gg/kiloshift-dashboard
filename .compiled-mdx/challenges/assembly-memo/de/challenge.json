nd":{"line":74,"column":32,"offset":3101}}},{"type":"text","value":" auf und beenden:","position":{"start":{"line":74,"column":32,"offset":3101},"end":{"line":74,"column":49,"offset":3118}}}],"position":{"start":{"line":74,"column":1,"offset":3070},"end":{"line":74,"column":49,"offset":3118}}},{"type":"code","lang":"sbpf","meta":null,"value":"call 16   ; Call sol_log_ (helper ID 16)\r\nexit      ; Return using r0 value","position":{"start":{"line":76,"column":1,"offset":3122},"end":{"line":79,"column":4,"offset":3211}},"data":{"highlightId":"code-4"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Fazit","position":{"start":{"line":81,"column":17,"offset":3231},"end":{"line":81,"column":29,"offset":3243}}},{"type":"mdxJsxAttribute","name":"id","value":"conclusion","position":{"start":{"line":81,"column":30,"offset":3244},"end":{"line":81,"column":45,"offset":3259}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":81,"column":46,"offset":3260},"end":{"line":81,"column":56,"offset":3270}}}],"children":[],"position":{"start":{"line":81,"column":1,"offset":3215},"end":{"line":81,"column":59,"offset":3273}}},{"type":"paragraph","children":[{"type":"text","value":"Das Programm:","position":{"start":{"line":83,"column":1,"offset":3277},"end":{"line":83,"column":14,"offset":3290}}}],"position":{"start":{"line":83,"column":1,"offset":3277},"end":{"line":83,"column":14,"offset":3290}}},{"type":"list","ordered":true,"start":1,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Ruft 16 (","position":{"start":{"line":84,"column":4,"offset":3295},"end":{"line":84,"column":13,"offset":3304}}},{"type":"inlineCode","value":"sol_log_","position":{"start":{"line":84,"column":13,"offset":3304},"end":{"line":84,"column":23,"offset":3314}}},{"type":"text","value":") auf, um das Memo im Validator-Log auszugeben","position":{"start":{"line":84,"column":23,"offset":3314},"end":{"line":84,"column":69,"offset":3360}}}],"position":{"start":{"line":84,"column":4,"offset":3295},"end":{"line":84,"column":69,"offset":3360}}}],"position":{"start":{"line":84,"column":1,"offset":3292},"end":{"line":84,"column":69,"offset":3360}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Beendet mit dem Wert in ","position":{"start":{"line":85,"column":4,"offset":3365},"end":{"line":85,"column":28,"offset":3389}}},{"type":"inlineCode","value":"r0","position":{"start":{"line":85,"column":28,"offset":3389},"end":{"line":85,"column":32,"offset":3393}}}],"position":{"start":{"line":85,"column":4,"offset":3365},"end":{"line":85,"column":32,"offset":3393}}}],"position":{"start":{"line":85,"column":1,"offset":3362},"end":{"line":85,"column":32,"offset":3393}}}],"position":{"start":{"line":84,"column":1,"offset":3292},"end":{"line":85,"column":32,"offset":3393}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":85,"column":32,"offset":3393}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n![Assembly Memo Challenge](/graphics/challenge-banners/assembly-memo.png)\r\n\r\n# Assembly Memo\r\n\r\nIn dieser Einheit werden wir sBPF Assembly verwenden, um einen Logging-Mechanismus für unser Programm zu erstellen.\r\n\r\nDie Einfachheit eines kompakten Memo-Programms ist der perfekte Ausgangspunkt für deine sBPF-Assembly-Reise!\r\n\r\nWenn du mit Assembly-Programmierung nicht vertraut bist, folge dem [Einführungskurs zu Assembly](/de/courses/introduction-to-assembly)\r\n\r\n<ArticleSection name=\"Program Design\" id=\"program-design\" level=\"h2\" />\r\n\r\nUnser Programm wird einfach den richtigen Speicherort in das richtige Register setzen und dann den `sol_log_` Syscall ausführen. Es wird so aussehen:\r\n\r\n```sbpf\r\n.equ NUM_ACCOUNTS, 0x00\r\n.equ DATA_LEN, 0x08\r\n.equ DATA, 0x10\r\n.globl entrypoint\r\nentrypoint:\r\n  ldxdw r0, [r1+NUM_ACCOUNTS]\r\n  ldxdw r2, [r1+DATA_LEN]\r\n  add64 r1, DATA\r\n  call sol_log_\r\n  exit\r\n```\r\n\r\n<ArticleSection name=\"Memory Offsets\" id=\"memory-offsets\" level=\"h2\" />\r\n\r\nDas Programm beginnt mit der Deklaration von drei `.equ` Konstanten, die das Speicherlayout unserer Instruktionsdaten definieren:\r\n\r\n```sbpf\r\n.equ NUM_ACCOUNTS, 0x00  ; Offset for number of accounts\r\n.equ DATA_LEN, 0x08      ; Offset for data length\r\n.equ DATA, 0x10          ; Offset for actual data\r\n```\r\n\r\nDiese Konstanten markieren die Byte-Offsets relativ zum Entry-Buffer-Zeiger in `r1`:\r\n- `NUM_ACCOUNTS` (0x0000): Zeigt auf die Anzahl der Konten im Instruktionsdaten-Header zur Validierung\r\n- `DATA_LEN` (0x08): Zeigt auf die Länge der Instruktionsdaten im Instruktionsdaten-Header\r\n- `DATA` (0x10): Zeigt auf die Instruktionsdaten im Instruktionsdaten-Header\r\n\r\nIm Gegensatz zu höheren Programmiersprachen, die das Speicherlayout abstrahieren, erfordert Assembly genaue Kenntnis darüber, wo jedes Datenelement gespeichert ist.\r\n\r\n<ArticleSection name=\"Entrypoint and Initial Validation\" id=\"entrypoint-and-validations\" level=\"h2\" />\r\n\r\n```sbpf\r\n.globl entrypoint\r\nentrypoint:\r\n  ldxdw r0, [r1+NUM_ACCOUNTS]   ; Load number of accounts into r0\r\n```\r\n\r\nJedes sBPF-Programm beginnt mit einem globalen `.entrypoint` Symbol. Die Solana-Laufzeitumgebung stellt Konto- und Instruktionsdaten über das Register `r1` bereit.\r\n\r\nDiese erste Anweisung lädt dann die Anzahl der Konten in `r0`. Da `r0` das Register ist, das die VM beim Beenden liest, erfüllt dies zwei Zwecke:\r\n1. Es lädt die Kontoanzahl für unsere Verwendung\r\n2. Es stellt sicher, dass das Programm automatisch fehlschlägt, wenn Konten übergeben werden (Wert ungleich Null in r0)\r\n\r\n<ArticleSection name=\"Sol Log Syscall\" id=\"sol-log-syscall\" level=\"h2\" />\r\n\r\nAls nächstes bereiten wir die Argumente für den `sol_log_` Syscall vor:\r\n\r\n```sbpf\r\nldxdw r2, [r1+DATA_LEN]   ; Load length of memo into r2\r\nadd64  r1, DATA           ; Adjust r1 to point to memo bytes\r\n```\r\n\r\nDiese Anweisungen richten die Argumente für `sol_log_` ein:\r\n- `r2` erhält die Länge der Memo-Daten\r\n- `r1` wird angepasst, um direkt auf die Memo-Bytes zu zeigen\r\n\r\nUnd danach rufen wir `sol_log_` auf und beenden:\r\n\r\n```sbpf\r\ncall 16   ; Call sol_log_ (helper ID 16)\r\nexit      ; Return using r0 value\r\n```\r\n\r\n<ArticleSection name=\"Fazit\" id=\"conclusion\" level=\"h2\" />\r\n\r\nDas Programm:\r\n1. Ruft 16 (`sol_log_`) auf, um das Memo im Validator-Log auszugeben\r\n2. Beendet mit dem Wert in `r0`","highlightedCode":{"code-0":{"lang":"sbpf","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":".equ NUM_ACCOUNTS, "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F1FA8C"},"children":[{"type":"text","value":"0x00"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":".equ DATA_LEN, "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F1FA8C"},"children":[{"type":"text","value":"0x08"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":".equ DATA, "}]},{"type":"element","tagName":"span","properties":{"style":"color