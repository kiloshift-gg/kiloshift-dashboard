de","value":"Hello, Solana!","position":{"start":{"line":24,"column":56,"offset":1147},"end":{"line":24,"column":72,"offset":1163}}}],"position":{"start":{"line":24,"column":5,"offset":1096},"end":{"line":24,"column":72,"offset":1163}}}],"position":{"start":{"line":23,"column":3,"offset":1038},"end":{"line":25,"column":17,"offset":1181}}},{"type":"mdxJsxFlowElement","name":"Requirement","attributes":[{"type":"mdxJsxAttribute","name":"title","value":"Завдання 2: Тестування нотатки з іншими вхідними даними","position":{"start":{"line":27,"column":16,"offset":1200},"end":{"line":27,"column":79,"offset":1263}}}],"children":[{"type":"paragraph","children":[{"type":"text","value":"Щоб переконатися, що ви не закодували рядок ","position":{"start":{"line":28,"column":5,"offset":1270},"end":{"line":28,"column":49,"offset":1314}}},{"type":"inlineCode","value":"Hello, Solana!","position":{"start":{"line":28,"column":49,"offset":1314},"end":{"line":28,"column":65,"offset":1330}}},{"type":"text","value":" напряму, ми спробуємо ще раз з іншими вхідними даними: ","position":{"start":{"line":28,"column":65,"offset":1330},"end":{"line":28,"column":121,"offset":1386}}},{"type":"inlineCode","value":"Hello, Solana, but different!","position":{"start":{"line":28,"column":121,"offset":1386},"end":{"line":28,"column":152,"offset":1417}}}],"position":{"start":{"line":28,"column":5,"offset":1270},"end":{"line":28,"column":152,"offset":1417}}}],"position":{"start":{"line":27,"column":3,"offset":1187},"end":{"line":29,"column":17,"offset":1435}}}],"position":{"start":{"line":22,"column":1,"offset":1017},"end":{"line":30,"column":19,"offset":1455}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":31,"column":1,"offset":1457}}},"raw":"import { ChallengeTitle } from \"../../../../components/Challenges/ChallengeTitle\";\r\nimport { RequirementList } from \"../../../../components/Challenges/RequirementList\";\r\nimport { Requirement } from \"../../../../components/Challenges/Requirement\";\r\n\r\n<ChallengeTitle>Нотатка на sBPF Асемблері</ChallengeTitle>\r\n\r\nСтворіть програму, яка має лише одну інструкцію. Вона повинна:\r\n- Завершуватися з помилкою, якщо дані інструкції містять будь-які акаунти (це можна зробити, встановивши `r0` на кількість акаунтів)\r\n- Встановити `r2` на довжину даних інструкції, а `r1` на зміщення даних інструкції, \r\n- Викликати системний виклик `sol_log_`.\r\n\r\nПочніть з встановлення пакету sBPF, як пояснено в [розділі про інструменти](/uk/courses/introduction-to-assembly/tooling) курсу \"Вступ до асемблера\", і скомпілюйте вашу програму за допомогою наступної команди в терміналі:\r\n\r\n```\r\nsbpf build\r\n```\r\n\r\nЦе згенерує файл `.so` у вашій папці `target/deploy`.\r\n\r\nТепер натисніть на кнопку `take challenge` і перетягніть туди файл!\r\n\r\n<RequirementList>\r\n  <Requirement title=\"Завдання 1: Тестування нотатки\">\r\n    Ваша програма повинна успішно виконатися і вивести `Hello, Solana!`\r\n  </Requirement>\r\n\r\n  <Requirement title=\"Завдання 2: Тестування нотатки з іншими вхідними даними\">\r\n    Щоб переконатися, що ви не закодували рядок `Hello, Solana!` напряму, ми спробуємо ще раз з іншими вхідними даними: `Hello, Solana, but different!`\r\n  </Requirement>\r\n</RequirementList>\r\n","highlightedCode":{"code-0":{"lang":"text","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{},"children":[{"type":"text","value":"sbpf build"}]}]}]}]}]}}}}