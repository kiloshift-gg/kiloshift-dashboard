n":{"start":{"line":15,"column":5,"offset":834},"end":{"line":15,"column":105,"offset":934}}}],"position":{"start":{"line":14,"column":3,"offset":756},"end":{"line":16,"column":17,"offset":952}}}],"position":{"start":{"line":9,"column":1,"offset":464},"end":{"line":17,"column":19,"offset":972}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":18,"column":1,"offset":974}}},"raw":"import { ChallengeTitle } from \"../../../../components/Challenges/ChallengeTitle\";\r\nimport { RequirementList } from \"../../../../components/Challenges/RequirementList\";\r\nimport { Requirement } from \"../../../../components/Challenges/Requirement\";\r\n\r\n<ChallengeTitle>Pinocchio Flash Loan</ChallengeTitle>\r\n\r\nEs ist Zeit, dein Wissen auf die Probe zu stellen. Erstelle ein Flash-Loan-Programm mit dem Pinocchio-Framework, das die folgenden Anforderungen erfüllt:\r\n\r\n<RequirementList>\r\n  <Requirement title=\"Herausforderung 1: Erstelle eine `Borrow` Anweisung\">\r\n    Dein Programm muss einem Kreditnehmer ermöglichen, vom Protokoll zu leihen und zu überprüfen, dass eine `Repay` Anweisung innerhalb derselben Transaktion vorhanden ist.\r\n  </Requirement>\r\n\r\n  <Requirement title=\"Herausforderung 2: Erstelle eine `Repay` Anweisung\">\r\n    Dein Programm muss dem Protokoll den geliehenen Betrag innerhalb derselben Transaktion zurückzahlen.\r\n  </Requirement>\r\n</RequirementList>\r\n","highlightedCode":{}}