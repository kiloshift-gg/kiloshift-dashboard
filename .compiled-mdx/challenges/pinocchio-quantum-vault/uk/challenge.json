lumn":25,"offset":1482},"end":{"line":31,"column":37,"offset":1494}}},{"type":"text","value":", щоб згенерувати артефакти розгортання в ","position":{"start":{"line":31,"column":37,"offset":1494},"end":{"line":31,"column":79,"offset":1536}}},{"type":"inlineCode","value":"target/deploy","position":{"start":{"line":31,"column":79,"offset":1536},"end":{"line":31,"column":94,"offset":1551}}},{"type":"text","value":":","position":{"start":{"line":31,"column":94,"offset":1551},"end":{"line":31,"column":95,"offset":1552}}}],"position":{"start":{"line":31,"column":1,"offset":1458},"end":{"line":31,"column":95,"offset":1552}}},{"type":"code","lang":"toml","meta":null,"value":"[lib]\r\ncrate-type = [\"lib\", \"cdylib\"]","position":{"start":{"line":33,"column":1,"offset":1556},"end":{"line":36,"column":4,"offset":1607}},"data":{"highlightId":"code-0"}},{"type":"paragraph","children":[{"type":"text","value":"Тепер ви готові написати вашу програму квантового сховища.","position":{"start":{"line":38,"column":1,"offset":1611},"end":{"line":38,"column":59,"offset":1669}}}],"position":{"start":{"line":38,"column":1,"offset":1611},"end":{"line":38,"column":59,"offset":1669}}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Template","position":{"start":{"line":40,"column":17,"offset":1689},"end":{"line":40,"column":32,"offset":1704}}},{"type":"mdxJsxAttribute","name":"id","value":"template","position":{"start":{"line":40,"column":33,"offset":1705},"end":{"line":40,"column":46,"offset":1718}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":40,"column":47,"offset":1719},"end":{"line":40,"column":57,"offset":1729}}}],"children":[],"position":{"start":{"line":40,"column":1,"offset":1673},"end":{"line":40,"column":60,"offset":1732}}},{"type":"paragraph","children":[{"type":"text","value":"Цього разу ми розділимо програму на маленькі, сфокусовані модулі замість того, щоб розміщувати все в ","position":{"start":{"line":42,"column":1,"offset":1736},"end":{"line":42,"column":102,"offset":1837}}},{"type":"inlineCode","value":"lib.rs","position":{"start":{"line":42,"column":102,"offset":1837},"end":{"line":42,"column":110,"offset":1845}}},{"type":"text","value":". Дерево папок буде виглядати приблизно так:","position":{"start":{"line":42,"column":110,"offset":1845},"end":{"line":42,"column":154,"offset":1889}}}],"position":{"start":{"line":42,"column":1,"offset":1736},"end":{"line":42,"column":154,"offset":1889}}},{"type":"code","lang":null,"meta":null,"value":"src\r\n├── instructions\r\n│       ├── close.rs\r\n│       ├── open.rs\r\n│       ├── mod.rs\r\n│       └── split.rs\r\n└── lib.rs","position":{"start":{"line":44,"column":1,"offset":1893},"end":{"line":52,"column":4,"offset":2021}},"data":{"highlightId":"code-1"}},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Примітка","position":{"start":{"line":54,"column":3,"offset":2027},"end":{"line":54,"column":11,"offset":2035}}}],"position":{"start":{"line":54,"column":1,"offset":2025},"end":{"line":54,"column":13,"offset":2037}}},{"type":"text","value":": Не забудьте змінити ID програми на ","position":{"start":{"line":54,"column":13,"offset":2037},"end":{"line":54,"column":50,"offset":2074}}},{"type":"inlineCode","value":"22222222222222222222222222222222222222222222","position":{"start":{"line":54,"column":50,"offset":2074},"end":{"line":54,"column":96,"offset":2120}}},{"type":"text","value":", оскільки ми використовуємо його під капотом для тестування вашої програми.","position":{"start":{"line":54,"column":96,"offset":2120},"end":{"line":54,"column":172,"offset":2196}}}],"position":{"start":{"line":54,"column":1,"offset":2025},"end":{"line":54,"column":172,"offset":2196}}},{"type":"paragraph","children":[{"type":"text","value":"Точка входу в ","position":{"start":{"line":56,"column":1,"offset":2200},"end":{"line":56,"column":15,"offset":2214}}},{"type":"inlineCode","value":"lib.rs","position":{"start":{"line":56,"column":15,"offset":2214},"end":{"line":56,"column":23,"offset":2222}}},{"type":"text","value":" дуже схожа на те, що ми розглядали в ","position":{"start":{"line":56,"column":23,"offset":2222},"end":{"line":56,"column":61,"offset":2260}}},{"type":"link","title":null,"url":"/uk/courses/introduction-to-pinocchio","children":[{"type":"text","value":"Вступі до курсу Pinocchio","position":{"start":{"line":56,"column":62,"offset":2261},"end":{"line":56,"column":87,"offset":2286}}}],"position":{"start":{"line":56,"column":61,"offset":2260},"end":{"line":56,"column":127,"offset":2326}}},{"type":"text","value":".","position":{"start":{"line":56,"column":127,"offset":2326},"end":{"line":56,"column":128,"offset":2327}}}],"position":{"start":{"line":56,"column":1,"offset":2200},"end":{"line":56,"column":128,"offset":2327}}},{"type":"code","lang":"rust","meta":null,"value":"pub mod instructions;\r\nuse instructions::*;\r\n\r\nuse pinocchio::{\r\n    account_info::AccountInfo, program_entrypoint, program_error::ProgramError,\r\n    pubkey::Pubkey, ProgramResult,\r\n};\r\n\r\nprogram_entrypoint!(process_instruction);\r\n\r\n// 22222222222222222222222222222222222222222222\r\npub const ID: Pubkey = [\r\n    0x0f, 0x1e, 0x6b, 0x14, 0x21, 0xc0, 0x4a, 0x07, \r\n    0x04, 0x31, 0x26, 0x5c, 0x19, 0xc5, 0xbb, 0xee, \r\n    0x19, 0x92, 0xba, 0xe8, 0xaf, 0xd1, 0xcd, 0x07, \r\n    0x8e, 0xf8, 0xaf, 0x70, 0x47, 0xdc, 0x11, 0xf7, \r\n];\r\n\r\nfn process_instruction(\r\n    _program_id: &Pubkey,\r\n    accounts: &[AccountInfo],\r\n    instruction_data: &[u8],\r\n) -> ProgramResult {    \r\n    match instruction_data.split_first() {\r\n        Some((OpenVault::DISCRIMINATOR, data)) => OpenVault::try_from((data, accounts))?.process(),\r\n        Some((SplitVault::DISCRIMINATOR, data)) => SplitVault::try_from((data, accounts))?.process(),\r\n        Some((CloseVault::DISCRIMINATOR, data)) => CloseVault::try_from((data, accounts))?.process(),\r\n        _ => Err(ProgramError::InvalidInstructionData)\r\n    }\r\n}","position":{"start":{"line":58,"column":1,"offset":2331},"end":{"line":89,"column":4,"offset":3429}},"data":{"highlightId":"code-2"}},{"type":"paragraph","children":[{"type":"text","value":"Нам не потрібно налаштовувати стан для цього, тому ми просто перейдемо до створення наших інструкцій.","position":{"start":{"line":91,"column":1,"offset":3433},"end":{"line":91,"column":102,"offset":3534}}}],"position":{"start":{"line":91,"column":1,"offset":3433},"end":{"line":91,"column":102,"offset":3534}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":91,"column":102,"offset":3534}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Квантове сховище\r\n\r\n![Завдання Pinocchio Quantum Vault](/graphics/challenge-banners/pinocchio-quantum-vault.png)\r\n\r\nСховище є фундаментальним будівельним блоком у DeFi, який забезпечує безпечний спосіб зберігання активів для користувачів.\r\n\r\nУ цьому завданні ми створимо сховище, яке використовує підписи Вінтерніца для перевірки транзакцій. Це особливо цікаво, оскільки підпис Вінтерніца є першим постквантовим підписом, інтегрованим у Solana.\r\n\r\n> Якщо ви не знайомі з підписом Вінтерніца, почніть з читання [Підпис Вінтерніца на Solana](/uk/courses/winternitz-signatures-on-solana), щоб зрозуміти основні концепції та базову криптографію.\r\n\r\nУ цьому завданні ми оновимо просте сховище lamport, яке ми створили в [Завданні Pinocchio Vault](/uk/challenges/pinocchio-vault), щоб дозволити використання підписів Вінтерніца як метод перевірки для транзакцій.\r\n\r\n<ArticleSection name=\"Installation\" id=\"installation\" level=\"h2\" />\r\n\r\nПерш ніж почати, переконайтеся, що Rust і Pinocchio встановлені. Потім виконайте наступне у вашому терміналі:\r\n\r\n```bash\r\n# create workspace\r\ncargo new Kiloshift-pinocchio-quantum-vault --lib --edition 2021\r\ncd Kiloshift-pinocchio-quantum-vault\r\n```\r\n\r\nДодайте `pinocchio`, `pinocchio-system`, `solana-nostd-sha256` та `solana-winternitz`:\r\n\r\n```bash\r\ncargo add pinocchio pinocchio-system solana-nostd-sha256 solana-winternitz\r\n```\r\n\r\nОголосіть типи крейту в `Cargo.toml`, щоб згенерувати артефакти розгортання в `target/deploy`:\r\n\r\n```toml\r\n[lib]\r\ncrate-type = [\"lib\", \"cdylib\"]\r\n```\r\n\r\nТепер ви готові написати вашу програму квантового сховища.\r\n\r\n<ArticleSection name=\"Template\" id=\"template\" level=\"h2\" />\r\n\r\nЦього разу ми розділимо програму на маленькі, сфокусовані модулі замість того, щоб розміщувати все в `lib.rs`. Дерево папок буде виглядати приблизно так:\r\n\r\n```\r\nsrc\r\n├── instructions\r\n│       ├── close.rs\r\n│       ├── open.rs\r\n│       ├── mod.rs\r\n│       └── split.rs\r\n└── lib.rs\r\n```\r\n\r\n**Примітка**: Не забудьте змінити ID програми на `22222222222222222222222222222222222222222222`, оскільки ми використовуємо його під капотом для тестування вашої програми.\r\n\r\nТочка входу в `lib.rs` дуже схожа на те, що ми розглядали в [Вступі до курсу Pinocchio](/uk/courses/introduction-to-pinocchio).\r\n\r\n```rust\r\npub mod instructions;\r\nuse instructions::*;\r\n\r\nuse pinocchio::{\r\n    account_info::AccountInfo, program_entrypoint, program_error::ProgramError,\r\n    pubkey::Pubkey, ProgramResult,\r\n};\r\n\r\nprogram_entrypoint!(process_instruction);\r\n\r\n// 22222222222222222222222222222222222222222222\r\npub const ID: Pubkey = [\r\n    0x0f, 0x1e, 0x6b, 0x14, 0x21, 0xc0, 0x4a, 0x07, \r\n    0x04, 0x31, 0x26, 0x5c, 0x19, 0xc5, 0xbb, 0xee, \r\n    0x19, 0x92, 0xba, 0xe8, 0xaf, 0xd1, 0xcd, 0x07, \r\n    0x8e, 0xf8, 0xaf, 0x70, 0x47, 0xdc, 0x11, 0xf7, \r\n];\r\n\r\nfn process_instruction(\r\n    _program_id: &Pubkey,\r\n    accounts: &[AccountInfo],\r\n    instruction_data: &[u8],\r\n) -> ProgramResult {    \r\n    match instruction_data.split_first() {\r\n        Some((OpenVault::DISCRIMINATOR, data)) => OpenVault::try_from((data, accounts))?.process(),\r\n        Some((SplitVault::DISCRIMINATOR, data)) => SplitVault::try_from((data, accounts))?.process(),\r\n        Some((CloseVault::DISCRIMINATOR, data)) => CloseVault::try_from((data, accounts))?.process(),\r\n        _ => Err(ProgramError::InvalidInstructionData)\r\n    }\r\n}\r\n```\r\n\r\nНам не потрібно налаштовувати стан для цього, тому ми просто перейдемо до створення наших інструкцій.","highlightedCode":{"code-0":{"lang":"toml","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"["}]},{"type":"element","tagName":"span","properties":{"style":"color:#97E1F1"},"children":[{"type":"text","value":"lib"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"]"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#97E1F1"},"children":[{"type":"text","value":"crate-type"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":" ="}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" ["}]},{"type":"element","tagName":"span","properties":{"style":"color:#DEE492"},"children":[{"type":"text","value":"\""}]},{"type":"element","tagName":"span","properties":{"style":"color:#E7EE98"},"children":[{"type":"text","value":"lib"}]},{"type":"element","tagName":"span","properties":{"style":"color:#DEE492"},"children":[{"type":"text","value":"\""}]},{"type":"element","tagName":"span","properties":