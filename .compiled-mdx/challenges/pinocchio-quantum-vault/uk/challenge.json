{"mdast":{"type":"root","children":[{"type":"mdxjsEsm","value":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";","position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":1,"column":87,"offset":86}},"data":{"estree":{"type":"Program","start":0,"end":86,"loc":{"start":{"line":1,"column":0,"offset":0},"end":{"line":1,"column":86,"offset":86}},"body":[{"type":"ImportDeclaration","start":0,"end":86,"loc":{"start":{"line":1,"column":0,"offset":0},"end":{"line":1,"column":86,"offset":86}},"specifiers":[{"type":"ImportSpecifier","start":9,"end":23,"loc":{"start":{"line":1,"column":9,"offset":9},"end":{"line":1,"column":23,"offset":23}},"imported":{"type":"Identifier","start":9,"end":23,"loc":{"start":{"line":1,"column":9,"offset":9},"end":{"line":1,"column":23,"offset":23}},"name":"ArticleSection","range":[9,23]},"local":{"type":"Identifier","start":9,"end":23,"loc":{"start":{"line":1,"column":9,"offset":9},"end":{"line":1,"column":23,"offset":23}},"name":"ArticleSection","range":[9,23]},"range":[9,23]}],"source":{"type":"Literal","start":31,"end":85,"loc":{"start":{"line":1,"column":31,"offset":31},"end":{"line":1,"column":85,"offset":85}},"value":"../../../../components/ArticleSection/ArticleSection","raw":"\"../../../../components/ArticleSection/ArticleSection\"","range":[31,85]},"range":[0,86]}],"sourceType":"module","comments":[],"range":[0,86]}}},{"type":"heading","depth":1,"children":[{"type":"text","value":"Квантове сховище","position":{"start":{"line":3,"column":3,"offset":92},"end":{"line":3,"column":19,"offset":108}}}],"position":{"start":{"line":3,"column":1,"offset":90},"end":{"line":3,"column":19,"offset":108}}},{"type":"paragraph","children":[{"type":"image","title":null,"url":"/graphics/challenge-banners/pinocchio-quantum-vault.png","alt":"Завдання Pinocchio Quantum Vault","position":{"start":{"line":5,"column":1,"offset":112},"end":{"line":5,"column":93,"offset":204}}}],"position":{"start":{"line":5,"column":1,"offset":112},"end":{"line":5,"column":93,"offset":204}}},{"type":"paragraph","children":[{"type":"text","value":"Сховище є фундаментальним будівельним блоком у DeFi, який забезпечує безпечний спосіб зберігання активів для користувачів.","position":{"start":{"line":7,"column":1,"offset":208},"end":{"line":7,"column":123,"offset":330}}}],"position":{"start":{"line":7,"column":1,"offset":208},"end":{"line":7,"column":123,"offset":330}}},{"type":"paragraph","children":[{"type":"text","value":"У цьому завданні ми створимо сховище, яке використовує підписи Вінтерніца для перевірки транзакцій. Це особливо цікаво, оскільки підпис Вінтерніца є першим постквантовим підписом, інтегрованим у Solana.","position":{"start":{"line":9,"column":1,"offset":334},"end":{"line":9,"column":203,"offset":536}}}],"position":{"start":{"line":9,"column":1,"offset":334},"end":{"line":9,"column":203,"offset":536}}},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"Якщо ви не знайомі з підписом Вінтерніца, почніть з читання ","position":{"start":{"line":11,"column":3,"offset":542},"end":{"line":11,"column":63,"offset":602}}},{"type":"link","title":null,"url":"/uk/courses/winternitz-signatures-on-solana","children":[{"type":"text","value":"Підпис Вінтерніца на Solana","position":{"start":{"line":11,"column":64,"offset":603},"end":{"line":11,"column":91,"offset":630}}}],"position":{"start":{"line":11,"column":63,"offset":602},"end":{"line":11,"column":137,"offset":676}}},{"type":"text","value":", щоб зрозуміти основні концепції та базову криптографію.","position":{"start":{"line":11,"column":137,"offset":676},"end":{"line":11,"column":194,"offset":733}}}],"position":{"start":{"line":11,"column":3,"offset":542},"end":{"line":11,"column":194,"offset":733}}}],"position":{"start":{"line":11,"column":1,"offset":540},"end":{"line":11,"column":194,"offset":733}}},{"type":"paragraph","children":[{"type":"text","value":"У цьому завданні ми оновимо просте сховище l