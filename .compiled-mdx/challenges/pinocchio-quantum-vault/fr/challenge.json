"column":1,"offset":1886},"end":{"line":40,"column":58,"offset":1943}}},{"type":"paragraph","children":[{"type":"text","value":"Cette fois, nous allons diviser le programme en petits modules ciblés au lieu de tout placer dans ","position":{"start":{"line":42,"column":1,"offset":1947},"end":{"line":42,"column":99,"offset":2045}}},{"type":"inlineCode","value":"lib.rs","position":{"start":{"line":42,"column":99,"offset":2045},"end":{"line":42,"column":107,"offset":2053}}},{"type":"text","value":". L'arborescence des dossiers ressemblera à peu près à ceci :","position":{"start":{"line":42,"column":107,"offset":2053},"end":{"line":42,"column":168,"offset":2114}}}],"position":{"start":{"line":42,"column":1,"offset":1947},"end":{"line":42,"column":168,"offset":2114}}},{"type":"code","lang":null,"meta":null,"value":"src\r\n├── instructions\r\n│       ├── close.rs\r\n│       ├── open.rs\r\n│       ├── mod.rs\r\n│       └── split.rs\r\n└── lib.rs","position":{"start":{"line":44,"column":1,"offset":2118},"end":{"line":52,"column":4,"offset":2246}},"data":{"highlightId":"code-1"}},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Remarque","position":{"start":{"line":54,"column":3,"offset":2252},"end":{"line":54,"column":11,"offset":2260}}}],"position":{"start":{"line":54,"column":1,"offset":2250},"end":{"line":54,"column":13,"offset":2262}}},{"type":"text","value":" : N'oubliez pas de changer l'ID du programme en ","position":{"start":{"line":54,"column":13,"offset":2262},"end":{"line":54,"column":62,"offset":2311}}},{"type":"inlineCode","value":"22222222222222222222222222222222222222222222","position":{"start":{"line":54,"column":62,"offset":2311},"end":{"line":54,"column":108,"offset":2357}}},{"type":"text","value":" car nous l'utilisons en arrière-plan pour tester votre programme.","position":{"start":{"line":54,"column":108,"offset":2357},"end":{"line":54,"column":174,"offset":2423}}}],"position":{"start":{"line":54,"column":1,"offset":2250},"end":{"line":54,"column":174,"offset":2423}}},{"type":"paragraph","children":[{"type":"text","value":"Le point d'entrée dans ","position":{"start":{"line":56,"column":1,"offset":2427},"end":{"line":56,"column":24,"offset":2450}}},{"type":"inlineCode","value":"lib.rs","position":{"start":{"line":56,"column":24,"offset":2450},"end":{"line":56,"column":32,"offset":2458}}},{"type":"text","value":" est très similaire à ce que nous avons vu dans le ","position":{"start":{"line":56,"column":32,"offset":2458},"end":{"line":56,"column":83,"offset":2509}}},{"type":"link","title":null,"url":"/en/courses/introduction-to-pinocchio","children":[{"type":"text","value":"Cours d'introduction à Pinocchio","position":{"start":{"line":56,"column":84,"offset":2510},"end":{"line":56,"column":116,"offset":2542}}}],"position":{"start":{"line":56,"column":83,"offset":2509},"end":{"line":56,"column":156,"offset":2582}}},{"type":"text","value":".","position":{"start":{"line":56,"column":156,"offset":2582},"end":{"line":56,"column":157,"offset":2583}}}],"position":{"start":{"line":56,"column":1,"offset":2427},"end":{"line":56,"column":157,"offset":2583}}},{"type":"code","lang":"rust","meta":null,"value":"pub mod instructions;\r\nuse instructions::*;\r\n\r\nuse pinocchio::{\r\n    account_info::AccountInfo, program_entrypoint, program_error::ProgramError,\r\n    pubkey::Pubkey, ProgramResult,\r\n};\r\n\r\nprogram_entrypoint!(process_instruction);\r\n\r\n// 22222222222222222222222222222222222222222222\r\npub const ID: Pubkey = [\r\n    0x0f, 0x1e, 0x6b, 0x14, 0x21, 0xc0, 0x4a, 0x07, \r\n    0x04, 0x31, 0x26, 0x5c, 0x19, 0xc5, 0xbb, 0xee, \r\n    0x19, 0x92, 0xba, 0xe8, 0xaf, 0xd1, 0xcd, 0x07, \r\n    0x8e, 0xf8, 0xaf, 0x70, 0x47, 0xdc, 0x11, 0xf7, \r\n];\r\n\r\nfn process_instruction(\r\n    _program_id: &Pubkey,\r\n    accounts: &[AccountInfo],\r\n    instruction_data: &[u8],\r\n) -> ProgramResult {    \r\n    match instruction_data.split_first() {\r\n        Some((OpenVault::DISCRIMINATOR, data)) => OpenVault::try_from((data, accounts))?.process(),\r\n        Some((SplitVault::DISCRIMINATOR, data)) => SplitVault::try_from((data, accounts))?.process(),\r\n        Some((CloseVault::DISCRIMINATOR, data)) => CloseVault::try_from((data, accounts))?.process(),\r\n        _ => Err(ProgramError::InvalidInstructionData)\r\n    }\r\n}","position":{"start":{"line":58,"column":1,"offset":2587},"end":{"line":89,"column":4,"offset":3685}},"data":{"highlightId":"code-2"}},{"type":"paragraph","children":[{"type":"text","value":"Nous n'avons pas besoin de configuration d'état pour cela, nous allons donc passer directement à la création de nos instructions.","position":{"start":{"line":91,"column":1,"offset":3689},"end":{"line":91,"column":130,"offset":3818}}}],"position":{"start":{"line":91,"column":1,"offset":3689},"end":{"line":91,"column":130,"offset":3818}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":91,"column":130,"offset":3818}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Le Coffre-fort Quantique\r\n\r\n![Défi Pinocchio Coffre-fort Quantique](/graphics/challenge-banners/pinocchio-quantum-vault.png)\r\n\r\nUn coffre-fort est un élément fondamental dans la DeFi qui offre aux utilisateurs un moyen sécurisé de stocker leurs actifs.\r\n\r\nDans ce défi, nous allons construire un coffre-fort qui utilise les signatures Winternitz pour la vérification des transactions. C'est particulièrement intéressant car la signature Winternitz est la première signature post-quantique intégrée sur Solana.\r\n\r\n> Si vous n'êtes pas familier avec la signature Winternitz, commencez par lire [Signature Winternitz sur Solana](/en/courses/winternitz-signatures-on-solana) pour comprendre les concepts fondamentaux et la cryptographie sous-jacente.\r\n\r\nDans ce défi, nous allons mettre à jour le coffre-fort lamport simple que nous avons construit dans le [Défi Coffre-fort Pinocchio](/en/challenges/pinocchio-vault) pour permettre l'utilisation des signatures Winternitz comme méthode de vérification pour les transactions.\r\n\r\n<ArticleSection name=\"Installation\" id=\"installation\" level=\"h2\" />\r\n\r\nAvant de commencer, assurez-vous que Rust et Pinocchio sont installés. Ensuite, exécutez ce qui suit dans votre terminal :\r\n\r\n```bash\r\n# create workspace\r\ncargo new Kiloshift-pinocchio-quantum-vault --lib --edition 2021\r\ncd Kiloshift-pinocchio-quantum-vault\r\n```\r\n\r\nAjoutez `pinocchio`, `pinocchio-system`, `solana-nostd-sha256` et `solana-winternitz` :\r\n\r\n```bash\r\ncargo add pinocchio pinocchio-system solana-nostd-sha256 solana-winternitz\r\n```\r\n\r\nDéclarez les types de crate dans `Cargo.toml` pour générer des artefacts de déploiement dans `target/deploy` :\r\n\r\n```toml\r\n[lib]\r\ncrate-type = [\"lib\", \"cdylib\"]\r\n```\r\n\r\nVous êtes maintenant prêt à écrire votre programme de coffre-fort quantique.\r\n\r\n<ArticleSection name=\"Modèle\" id=\"template\" level=\"h2\" />\r\n\r\nCette fois, nous allons diviser le programme en petits modules ciblés au lieu de tout placer dans `lib.rs`. L'arborescence des dossiers ressemblera à peu près à ceci :\r\n\r\n```\r\nsrc\r\n├── instructions\r\n│       ├── close.rs\r\n│       ├── open.rs\r\n│       ├── mod.rs\r\n│       └── split.rs\r\n└── lib.rs\r\n```\r\n\r\n**Remarque** : N'oubliez pas de changer l'ID du programme en `22222222222222222222222222222222222222222222` car nous l'utilisons en arrière-plan pour tester votre programme.\r\n\r\nLe point d'entrée dans `lib.rs` est très similaire à ce que nous avons vu dans le [Cours d'introduction à Pinocchio](/en/courses/introduction-to-pinocchio).\r\n\r\n```rust\r\npub mod instructions;\r\nuse instructions::*;\r\n\r\nuse pinocchio::{\r\n    account_info::AccountInfo, program_entrypoint, program_error::ProgramError,\r\n    pubkey::Pubkey, ProgramResult,\r\n};\r\n\r\nprogram_entrypoint!(process_instruction);\r\n\r\n// 22222222222222222222222222222222222222222222\r\npub const ID: Pubkey = [\r\n    0x0f, 0x1e, 0x6b, 0x14, 0x21, 0xc0, 0x4a, 0x07, \r\n    0x04, 0x31, 0x26, 0x5c, 0x19, 0xc5, 0xbb, 0xee, \r\n    0x19, 0x92, 0xba, 0xe8, 0xaf, 0xd1, 0xcd, 0x07, \r\n    0x8e, 0xf8, 0xaf, 0x70, 0x47, 0xdc, 0x11, 0xf7, \r\n];\r\n\r\nfn process_instruction(\r\n    _program_id: &Pubkey,\r\n    accounts: &[AccountInfo],\r\n    instruction_data: &[u8],\r\n) -> ProgramResult {    \r\n    match instruction_data.split_first() {\r\n        Some((OpenVault::DISCRIMINATOR, data)) => OpenVault::try_from((data, accounts))?.process(),\r\n        Some((SplitVault::DISCRIMINATOR, data)) => SplitVault::try_from((data, accounts))?.process(),\r\n        Some((CloseVault::DISCRIMINATOR, data)) => CloseVault::try_from((data, accounts))?.process(),\r\n        _ => Err(ProgramError::InvalidInstructionData)\r\n    }\r\n}\r\n```\r\n\r\nNous n'avons pas besoin de configuration d'état pour cela, nous allons donc passer directement à la création de nos instructions.","highlightedCode":{"code-0":{"lang":"toml","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"["}]},{"type":"element","tagName":"span","properties":{"style":"color:#97E1F1"},"children":[{"type":"text","value":"lib"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"]"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#97E1F1"},"children":[{"type":"text","value":"crate-type"}]},{"type":"element","tagName":"span","properties":