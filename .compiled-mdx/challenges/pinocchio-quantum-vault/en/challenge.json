 in ","position":{"start":{"line":42,"column":1,"offset":1742},"end":{"line":42,"column":97,"offset":1838}}},{"type":"inlineCode","value":"lib.rs","position":{"start":{"line":42,"column":97,"offset":1838},"end":{"line":42,"column":105,"offset":1846}}},{"type":"text","value":". The folder tree will look roughly like this:","position":{"start":{"line":42,"column":105,"offset":1846},"end":{"line":42,"column":151,"offset":1892}}}],"position":{"start":{"line":42,"column":1,"offset":1742},"end":{"line":42,"column":151,"offset":1892}}},{"type":"code","lang":null,"meta":null,"value":"src\r\n├── instructions\r\n│       ├── close.rs\r\n│       ├── open.rs\r\n│       ├── mod.rs\r\n│       └── split.rs\r\n└── lib.rs","position":{"start":{"line":44,"column":1,"offset":1896},"end":{"line":52,"column":4,"offset":2024}},"data":{"highlightId":"code-1"}},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Note","position":{"start":{"line":54,"column":3,"offset":2030},"end":{"line":54,"column":7,"offset":2034}}}],"position":{"start":{"line":54,"column":1,"offset":2028},"end":{"line":54,"column":9,"offset":2036}}},{"type":"text","value":": Remember to change the program ID to ","position":{"start":{"line":54,"column":9,"offset":2036},"end":{"line":54,"column":48,"offset":2075}}},{"type":"inlineCode","value":"22222222222222222222222222222222222222222222","position":{"start":{"line":54,"column":48,"offset":2075},"end":{"line":54,"column":94,"offset":2121}}},{"type":"text","value":" since we use this under the hood to test your program.","position":{"start":{"line":54,"column":94,"offset":2121},"end":{"line":54,"column":149,"offset":2176}}}],"position":{"start":{"line":54,"column":1,"offset":2028},"end":{"line":54,"column":149,"offset":2176}}},{"type":"paragraph","children":[{"type":"text","value":"The entrypoint in ","position":{"start":{"line":56,"column":1,"offset":2180},"end":{"line":56,"column":19,"offset":2198}}},{"type":"inlineCode","value":"lib.rs","position":{"start":{"line":56,"column":19,"offset":2198},"end":{"line":56,"column":27,"offset":2206}}},{"type":"text","value":" is very similar to what we covered in the ","position":{"start":{"line":56,"column":27,"offset":2206},"end":{"line":56,"column":70,"offset":2249}}},{"type":"link","title":null,"url":"/en/courses/introduction-to-pinocchio","children":[{"type":"text","value":"Introduction to Pinocchio Course","position":{"start":{"line":56,"column":71,"offset":2250},"end":{"line":56,"column":103,"offset":2282}}}],"position":{"start":{"line":56,"column":70,"offset":2249},"end":{"line":56,"column":143,"offset":2322}}},{"type":"text","value":".","position":{"start":{"line":56,"column":143,"offset":2322},"end":{"line":56,"column":144,"offset":2323}}}],"position":{"start":{"line":56,"column":1,"offset":2180},"end":{"line":56,"column":144,"offset":2323}}},{"type":"code","lang":"rust","meta":null,"value":"pub mod instructions;\r\nuse instructions::*;\r\n\r\nuse pinocchio::{\r\n    account_info::AccountInfo, program_entrypoint, program_error::ProgramError,\r\n    pubkey::Pubkey, ProgramResult,\r\n};\r\n\r\nprogram_entrypoint!(process_instruction);\r\n\r\n// 22222222222222222222222222222222222222222222\r\npub const ID: Pubkey = [\r\n    0x0f, 0x1e, 0x6b, 0x14, 0x21, 0xc0, 0x4a, 0x07, \r\n    0x04, 0x31, 0x26, 0x5c, 0x19, 0xc5, 0xbb, 0xee, \r\n    0x19, 0x92, 0xba, 0xe8, 0xaf, 0xd1, 0xcd, 0x07, \r\n    0x8e, 0xf8, 0xaf, 0x70, 0x47, 0xdc, 0x11, 0xf7, \r\n];\r\n\r\nfn process_instruction(\r\n    _program_id: &Pubkey,\r\n    accounts: &[AccountInfo],\r\n    instruction_data: &[u8],\r\n) -> ProgramResult {    \r\n    match instruction_data.split_first() {\r\n        Some((OpenVault::DISCRIMINATOR, data)) => OpenVault::try_from((data, accounts))?.process(),\r\n        Some((SplitVault::DISCRIMINATOR, data)) => SplitVault::try_from((data, accounts))?.process(),\r\n        Some((CloseVault::DISCRIMINATOR, data)) => CloseVault::try_from((data, accounts))?.process(),\r\n        _ => Err(ProgramError::InvalidInstructionData)\r\n    }\r\n}","position":{"start":{"line":58,"column":1,"offset":2327},"end":{"line":89,"column":4,"offset":3425}},"data":{"highlightId":"code-2"}},{"type":"paragraph","children":[{"type":"text","value":"We don't need any state setup for this, so we're just going to move into creating our instructions.","position":{"start":{"line":91,"column":1,"offset":3429},"end":{"line":91,"column":100,"offset":3528}}}],"position":{"start":{"line":91,"column":1,"offset":3429},"end":{"line":91,"column":100,"offset":3528}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":91,"column":100,"offset":3528}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# The Quantum Vault\r\n\r\n![Pinocchio Quantum Vault Challenge](/graphics/challenge-banners/pinocchio-quantum-vault.png)\r\n\r\nA vault is a fundamental building block in DeFi that provides a secure way for users to store their assets. \r\n\r\nIn this challenge, we'll build a vault that uses Winternitz signatures for transaction verification. This is particularly interesting because Winternitz Signature is the first post-quantum signature integrated on Solana.\r\n\r\n> If you're unfamiliar with Winternitz Signature, start by reading [Winternitz Signature on Solana](/en/courses/winternitz-signatures-on-solana) to understand the core concepts and underlying cryptography.\r\n\r\nIn this challenge, we'll update the simple lamport vault that we built in the [Pinocchio Vault Challenge](/en/challenges/pinocchio-vault) to allow Winternitz Signatures as a verification method for transactions.\r\n\r\n<ArticleSection name=\"Installation\" id=\"installation\" level=\"h2\" />\r\n\r\nBefore you begin, make sure Rust and Pinocchio are installed. Then, run the following in your terminal:\r\n\r\n```bash\r\n# create workspace\r\ncargo new Kiloshift-pinocchio-quantum-vault --lib --edition 2021\r\ncd Kiloshift-pinocchio-quantum-vault\r\n```\r\n\r\nAdd `pinocchio`, `pinocchio-system`, and `solana-nostd-sha256` and `solana-winternitz`:\r\n\r\n```bash\r\ncargo add pinocchio pinocchio-system solana-nostd-sha256 solana-winternitz\r\n```\r\n\r\nDeclare the crate types in `Cargo.toml` to generate deployment artifacts in `target/deploy`:\r\n\r\n```toml\r\n[lib]\r\ncrate-type = [\"lib\", \"cdylib\"]\r\n```\r\n\r\nYou're now ready to write your quantum vault program.\r\n\r\n<ArticleSection name=\"Template\" id=\"template\" level=\"h2\" />\r\n\r\nThis time, we'll split the program into small, focused modules instead of placing everything in `lib.rs`. The folder tree will look roughly like this:\r\n\r\n```\r\nsrc\r\n├── instructions\r\n│       ├── close.rs\r\n│       ├── open.rs\r\n│       ├── mod.rs\r\n│       └── split.rs\r\n└── lib.rs\r\n```\r\n\r\n**Note**: Remember to change the program ID to `22222222222222222222222222222222222222222222` since we use this under the hood to test your program.\r\n\r\nThe entrypoint in `lib.rs` is very similar to what we covered in the [Introduction to Pinocchio Course](/en/courses/introduction-to-pinocchio).\r\n\r\n```rust\r\npub mod instructions;\r\nuse instructions::*;\r\n\r\nuse pinocchio::{\r\n    account_info::AccountInfo, program_entrypoint, program_error::ProgramError,\r\n    pubkey::Pubkey, ProgramResult,\r\n};\r\n\r\nprogram_entrypoint!(process_instruction);\r\n\r\n// 22222222222222222222222222222222222222222222\r\npub const ID: Pubkey = [\r\n    0x0f, 0x1e, 0x6b, 0x14, 0x21, 0xc0, 0x4a, 0x07, \r\n    0x04, 0x31, 0x26, 0x5c, 0x19, 0xc5, 0xbb, 0xee, \r\n    0x19, 0x92, 0xba, 0xe8, 0xaf, 0xd1, 0xcd, 0x07, \r\n    0x8e, 0xf8, 0xaf, 0x70, 0x47, 0xdc, 0x11, 0xf7, \r\n];\r\n\r\nfn process_instruction(\r\n    _program_id: &Pubkey,\r\n    accounts: &[AccountInfo],\r\n    instruction_data: &[u8],\r\n) -> ProgramResult {    \r\n    match instruction_data.split_first() {\r\n        Some((OpenVault::DISCRIMINATOR, data)) => OpenVault::try_from((data, accounts))?.process(),\r\n        Some((SplitVault::DISCRIMINATOR, data)) => SplitVault::try_from((data, accounts))?.process(),\r\n        Some((CloseVault::DISCRIMINATOR, data)) => CloseVault::try_from((data, accounts))?.process(),\r\n        _ => Err(ProgramError::InvalidInstructionData)\r\n    }\r\n}\r\n```\r\n\r\nWe don't need any state setup for this, so we're just going to move into creating our instructions.","highlightedCode":{"code-0":{"lang":"toml","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"["}]},{"type":"element","tagName":"span","properties":{"style":"color:#97E1F1"},"children":[{"type":"text","value":"lib"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"]"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#97E1F1"},"children":[{"type":"text","value":"crate-type"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":" ="}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" ["}]},{"type":"element","tagName":"span","properties":{"style":"color:#DEE492"},"children":[{"type":"text","value":"\""}]},{"type":"element","tagName":"span","properties":{"style":"color:#E7EE98"},"children":[{"type":"text","value":"lib"}]},{"type":"element","tagName":"span","properties":{"style":"color:#DEE492"},"children":[{"type":"text","value":"\""}]},{"type":"element","tagName":"span","properties":{"style":"colo