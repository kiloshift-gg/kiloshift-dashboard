fset":1892}}},{"type":"paragraph","children":[{"type":"text","value":"Diesmal werden wir das Programm in kleine, fokussierte Module aufteilen, anstatt alles in ","position":{"start":{"line":42,"column":1,"offset":1896},"end":{"line":42,"column":91,"offset":1986}}},{"type":"inlineCode","value":"lib.rs","position":{"start":{"line":42,"column":91,"offset":1986},"end":{"line":42,"column":99,"offset":1994}}},{"type":"text","value":" zu platzieren. Die Ordnerstruktur wird ungefähr so aussehen:","position":{"start":{"line":42,"column":99,"offset":1994},"end":{"line":42,"column":160,"offset":2055}}}],"position":{"start":{"line":42,"column":1,"offset":1896},"end":{"line":42,"column":160,"offset":2055}}},{"type":"code","lang":null,"meta":null,"value":"src\r\n├── instructions\r\n│       ├── close.rs\r\n│       ├── open.rs\r\n│       ├── mod.rs\r\n│       └── split.rs\r\n└── lib.rs","position":{"start":{"line":44,"column":1,"offset":2059},"end":{"line":52,"column":4,"offset":2187}},"data":{"highlightId":"code-1"}},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Hinweis","position":{"start":{"line":54,"column":3,"offset":2193},"end":{"line":54,"column":10,"offset":2200}}}],"position":{"start":{"line":54,"column":1,"offset":2191},"end":{"line":54,"column":12,"offset":2202}}},{"type":"text","value":": Denke daran, die Programm-ID in ","position":{"start":{"line":54,"column":12,"offset":2202},"end":{"line":54,"column":46,"offset":2236}}},{"type":"inlineCode","value":"22222222222222222222222222222222222222222222","position":{"start":{"line":54,"column":46,"offset":2236},"end":{"line":54,"column":92,"offset":2282}}},{"type":"text","value":" zu ändern, da wir diese im Hintergrund verwenden, um dein Programm zu testen.","position":{"start":{"line":54,"column":92,"offset":2282},"end":{"line":54,"column":170,"offset":2360}}}],"position":{"start":{"line":54,"column":1,"offset":2191},"end":{"line":54,"column":170,"offset":2360}}},{"type":"paragraph","children":[{"type":"text","value":"Der Einstiegspunkt in ","position":{"start":{"line":56,"column":1,"offset":2364},"end":{"line":56,"column":23,"offset":2386}}},{"type":"inlineCode","value":"lib.rs","position":{"start":{"line":56,"column":23,"offset":2386},"end":{"line":56,"column":31,"offset":2394}}},{"type":"text","value":" ist sehr ähnlich zu dem, was wir im ","position":{"start":{"line":56,"column":31,"offset":2394},"end":{"line":56,"column":68,"offset":2431}}},{"type":"link","title":null,"url":"/de/courses/introduction-to-pinocchio","children":[{"type":"text","value":"Einführungskurs zu Pinocchio","position":{"start":{"line":56,"column":69,"offset":2432},"end":{"line":56,"column":97,"offset":2460}}}],"position":{"start":{"line":56,"column":68,"offset":2431},"end":{"line":56,"column":137,"offset":2500}}},{"type":"text","value":" behandelt haben.","position":{"start":{"line":56,"column":137,"offset":2500},"end":{"line":56,"column":154,"offset":2517}}}],"position":{"start":{"line":56,"column":1,"offset":2364},"end":{"line":56,"column":154,"offset":2517}}},{"type":"code","lang":"rust","meta":null,"value":"pub mod instructions;\r\nuse instructions::*;\r\n\r\nuse pinocchio::{\r\n    account_info::AccountInfo, program_entrypoint, program_error::ProgramError,\r\n    pubkey::Pubkey, ProgramResult,\r\n};\r\n\r\nprogram_entrypoint!(process_instruction);\r\n\r\n// 22222222222222222222222222222222222222222222\r\npub const ID: Pubkey = [\r\n    0x0f, 0x1e, 0x6b, 0x14, 0x21, 0xc0, 0x4a, 0x07, \r\n    0x04, 0x31, 0x26, 0x5c, 0x19, 0xc5, 0xbb, 0xee, \r\n    0x19, 0x92, 0xba, 0xe8, 0xaf, 0xd1, 0xcd, 0x07, \r\n    0x8e, 0xf8, 0xaf, 0x70, 0x47, 0xdc, 0x11, 0xf7, \r\n];\r\n\r\nfn process_instruction(\r\n    _program_id: &Pubkey,\r\n    accounts: &[AccountInfo],\r\n    instruction_data: &[u8],\r\n) -> ProgramResult {    \r\n    match instruction_data.split_first() {\r\n        Some((OpenVault::DISCRIMINATOR, data)) => OpenVault::try_from((data, accounts))?.process(),\r\n        Some((SplitVault::DISCRIMINATOR, data)) => SplitVault::try_from((data, accounts))?.process(),\r\n        Some((CloseVault::DISCRIMINATOR, data)) => CloseVault::try_from((data, accounts))?.process(),\r\n        _ => Err(ProgramError::InvalidInstructionData)\r\n    }\r\n}","position":{"start":{"line":58,"column":1,"offset":2521},"end":{"line":89,"column":4,"offset":3619}},"data":{"highlightId":"code-2"}},{"type":"paragraph","children":[{"type":"text","value":"Wir benötigen hierfür kein State-Setup, also werden wir direkt zur Erstellung unserer Anweisungen übergehen.","position":{"start":{"line":91,"column":1,"offset":3623},"end":{"line":91,"column":109,"offset":3731}}}],"position":{"start":{"line":91,"column":1,"offset":3623},"end":{"line":91,"column":109,"offset":3731}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":91,"column":109,"offset":3731}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Der Quantum Vault\r\n\r\n![Pinocchio Quantum Vault Challenge](/graphics/challenge-banners/pinocchio-quantum-vault.png)\r\n\r\nEin Vault ist ein grundlegender Baustein im DeFi-Bereich, der Nutzern eine sichere Möglichkeit bietet, ihre Assets zu speichern.\r\n\r\nIn dieser Challenge werden wir einen Vault erstellen, der Winternitz-Signaturen zur Transaktionsverifizierung verwendet. Dies ist besonders interessant, da die Winternitz-Signatur die erste Post-Quantum-Signatur ist, die in Solana integriert wurde.\r\n\r\n> Wenn du mit Winternitz-Signaturen nicht vertraut bist, beginne mit dem Lesen von [Winternitz-Signatur auf Solana](/de/courses/winternitz-signatures-on-solana), um die Kernkonzepte und die zugrundeliegende Kryptographie zu verstehen.\r\n\r\nIn dieser Challenge werden wir den einfachen Lamport-Vault, den wir in der [Pinocchio Vault Challenge](/de/challenges/pinocchio-vault) erstellt haben, aktualisieren, um Winternitz-Signaturen als Verifizierungsmethode für Transaktionen zu ermöglichen.\r\n\r\n<ArticleSection name=\"Installation\" id=\"installation\" level=\"h2\" />\r\n\r\nBevor du beginnst, stelle sicher, dass Rust und Pinocchio installiert sind. Führe dann Folgendes in deinem Terminal aus:\r\n\r\n```bash\r\n# create workspace\r\ncargo new Kiloshift-pinocchio-quantum-vault --lib --edition 2021\r\ncd Kiloshift-pinocchio-quantum-vault\r\n```\r\n\r\nFüge `pinocchio`, `pinocchio-system`, `solana-nostd-sha256` und `solana-winternitz` hinzu:\r\n\r\n```bash\r\ncargo add pinocchio pinocchio-system solana-nostd-sha256 solana-winternitz\r\n```\r\n\r\nDeklariere die Crate-Typen in `Cargo.toml`, um Deployment-Artefakte in `target/deploy` zu generieren:\r\n\r\n```toml\r\n[lib]\r\ncrate-type = [\"lib\", \"cdylib\"]\r\n```\r\n\r\nDu bist jetzt bereit, dein Quantum-Vault-Programm zu schreiben.\r\n\r\n<ArticleSection name=\"Vorlage\" id=\"template\" level=\"h2\" />\r\n\r\nDiesmal werden wir das Programm in kleine, fokussierte Module aufteilen, anstatt alles in `lib.rs` zu platzieren. Die Ordnerstruktur wird ungefähr so aussehen:\r\n\r\n```\r\nsrc\r\n├── instructions\r\n│       ├── close.rs\r\n│       ├── open.rs\r\n│       ├── mod.rs\r\n│       └── split.rs\r\n└── lib.rs\r\n```\r\n\r\n**Hinweis**: Denke daran, die Programm-ID in `22222222222222222222222222222222222222222222` zu ändern, da wir diese im Hintergrund verwenden, um dein Programm zu testen.\r\n\r\nDer Einstiegspunkt in `lib.rs` ist sehr ähnlich zu dem, was wir im [Einführungskurs zu Pinocchio](/de/courses/introduction-to-pinocchio) behandelt haben.\r\n\r\n```rust\r\npub mod instructions;\r\nuse instructions::*;\r\n\r\nuse pinocchio::{\r\n    account_info::AccountInfo, program_entrypoint, program_error::ProgramError,\r\n    pubkey::Pubkey, ProgramResult,\r\n};\r\n\r\nprogram_entrypoint!(process_instruction);\r\n\r\n// 22222222222222222222222222222222222222222222\r\npub const ID: Pubkey = [\r\n    0x0f, 0x1e, 0x6b, 0x14, 0x21, 0xc0, 0x4a, 0x07, \r\n    0x04, 0x31, 0x26, 0x5c, 0x19, 0xc5, 0xbb, 0xee, \r\n    0x19, 0x92, 0xba, 0xe8, 0xaf, 0xd1, 0xcd, 0x07, \r\n    0x8e, 0xf8, 0xaf, 0x70, 0x47, 0xdc, 0x11, 0xf7, \r\n];\r\n\r\nfn process_instruction(\r\n    _program_id: &Pubkey,\r\n    accounts: &[AccountInfo],\r\n    instruction_data: &[u8],\r\n) -> ProgramResult {    \r\n    match instruction_data.split_first() {\r\n        Some((OpenVault::DISCRIMINATOR, data)) => OpenVault::try_from((data, accounts))?.process(),\r\n        Some((SplitVault::DISCRIMINATOR, data)) => SplitVault::try_from((data, accounts))?.process(),\r\n        Some((CloseVault::DISCRIMINATOR, data)) => CloseVault::try_from((data, accounts))?.process(),\r\n        _ => Err(ProgramError::InvalidInstructionData)\r\n    }\r\n}\r\n```\r\n\r\nWir benötigen hierfür kein State-Setup, also werden wir direkt zur Erstellung unserer Anweisungen übergehen.","highlightedCode":{"code-0":{"lang":"toml","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"["}]},{"type":"element","tagName":"span","properties":{"style":"color:#97E1F1"},"children":[{"type":"text","value":"lib"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"]"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#97E1F1"},"children":[{"type":"text","value":"crate-type"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":" ="}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" ["}]},