t mọi thứ vào ","position":{"start":{"line":42,"column":1,"offset":1753},"end":{"line":42,"column":96,"offset":1848}}},{"type":"inlineCode","value":"lib.rs","position":{"start":{"line":42,"column":96,"offset":1848},"end":{"line":42,"column":104,"offset":1856}}},{"type":"text","value":". Cấu trúc thư mục sẽ trông giống như sau:","position":{"start":{"line":42,"column":104,"offset":1856},"end":{"line":42,"column":146,"offset":1898}}}],"position":{"start":{"line":42,"column":1,"offset":1753},"end":{"line":42,"column":146,"offset":1898}}},{"type":"code","lang":null,"meta":null,"value":"src\r\n├── instructions\r\n│       ├── close.rs\r\n│       ├── open.rs\r\n│       ├── mod.rs\r\n│       └── split.rs\r\n└── lib.rs","position":{"start":{"line":44,"column":1,"offset":1902},"end":{"line":52,"column":4,"offset":2030}},"data":{"highlightId":"code-1"}},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Lưu ý","position":{"start":{"line":54,"column":3,"offset":2036},"end":{"line":54,"column":8,"offset":2041}}}],"position":{"start":{"line":54,"column":1,"offset":2034},"end":{"line":54,"column":10,"offset":2043}}},{"type":"text","value":": Nhớ thay đổi ID chương trình thành ","position":{"start":{"line":54,"column":10,"offset":2043},"end":{"line":54,"column":47,"offset":2080}}},{"type":"inlineCode","value":"22222222222222222222222222222222222222222222","position":{"start":{"line":54,"column":47,"offset":2080},"end":{"line":54,"column":93,"offset":2126}}},{"type":"text","value":" vì chúng tôi sử dụng cái này để kiểm tra chương trình của bạn.","position":{"start":{"line":54,"column":93,"offset":2126},"end":{"line":54,"column":156,"offset":2189}}}],"position":{"start":{"line":54,"column":1,"offset":2034},"end":{"line":54,"column":156,"offset":2189}}},{"type":"paragraph","children":[{"type":"text","value":"Entrypoint trong tệp ","position":{"start":{"line":56,"column":1,"offset":2193},"end":{"line":56,"column":22,"offset":2214}}},{"type":"inlineCode","value":"lib.rs","position":{"start":{"line":56,"column":22,"offset":2214},"end":{"line":56,"column":30,"offset":2222}}},{"type":"text","value":" rất giống với những gì chúng tôi đã đề cập trong ","position":{"start":{"line":56,"column":30,"offset":2222},"end":{"line":56,"column":80,"offset":2272}}},{"type":"link","title":null,"url":"/vi/courses/introduction-to-pinocchio","children":[{"type":"text","value":"Khóa học Giới thiệu về Pinocchio","position":{"start":{"line":56,"column":81,"offset":2273},"end":{"line":56,"column":113,"offset":2305}}}],"position":{"start":{"line":56,"column":80,"offset":2272},"end":{"line":56,"column":153,"offset":2345}}},{"type":"text","value":".","position":{"start":{"line":56,"column":153,"offset":2345},"end":{"line":56,"column":154,"offset":2346}}}],"position":{"start":{"line":56,"column":1,"offset":2193},"end":{"line":56,"column":154,"offset":2346}}},{"type":"code","lang":"rust","meta":null,"value":"pub mod instructions;\r\nuse instructions::*;\r\n\r\nuse pinocchio::{\r\n    account_info::AccountInfo, program_entrypoint, program_error::ProgramError,\r\n    pubkey::Pubkey, ProgramResult,\r\n};\r\n\r\nprogram_entrypoint!(process_instruction);\r\n\r\n// 22222222222222222222222222222222222222222222\r\npub const ID: Pubkey = [\r\n    0x0f, 0x1e, 0x6b, 0x14, 0x21, 0xc0, 0x4a, 0x07, \r\n    0x04, 0x31, 0x26, 0x5c, 0x19, 0xc5, 0xbb, 0xee, \r\n    0x19, 0x92, 0xba, 0xe8, 0xaf, 0xd1, 0xcd, 0x07, \r\n    0x8e, 0xf8, 0xaf, 0x70, 0x47, 0xdc, 0x11, 0xf7, \r\n];\r\n\r\nfn process_instruction(\r\n    _program_id: &Pubkey,\r\n    accounts: &[AccountInfo],\r\n    instruction_data: &[u8],\r\n) -> ProgramResult {    \r\n    match instruction_data.split_first() {\r\n        Some((OpenVault::DISCRIMINATOR, data)) => OpenVault::try_from((data, accounts))?.process(),\r\n        Some((SplitVault::DISCRIMINATOR, data)) => SplitVault::try_from((data, accounts))?.process(),\r\n        Some((CloseVault::DISCRIMINATOR, data)) => CloseVault::try_from((data, accounts))?.process(),\r\n        _ => Err(ProgramError::InvalidInstructionData)\r\n    }\r\n}","position":{"start":{"line":58,"column":1,"offset":2350},"end":{"line":89,"column":4,"offset":3448}},"data":{"highlightId":"code-2"}},{"type":"paragraph","children":[{"type":"text","value":"Chúng tôi không cần bất kỳ thiết lập trạng thái nào ở đây, vì vậy chúng tôi chỉ cần chuyển sang việc tạo các instruction của mình.","position":{"start":{"line":91,"column":1,"offset":3452},"end":{"line":91,"column":131,"offset":3582}}}],"position":{"start":{"line":91,"column":1,"offset":3452},"end":{"line":91,"column":131,"offset":3582}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":91,"column":131,"offset":3582}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Vault lượng tử\r\n\r\n![Pinocchio Quantum Vault Challenge](/graphics/challenge-banners/pinocchio-quantum-vault.png)\r\n\r\nA vault is một thành phần cơ bản trong DeFi cung cấp một cách an toàn cho người dùng để lưu trữ tài sản của họ.\r\n\r\nTrong thử thách này, chúng ta sẽ xây dựng một vault sử dụng chữ ký Winternitz để xác minh giao dịch. Điều này đặc biệt thú vị vì chữ ký Winternitz là chữ ký hậu lượng tử đầu tiên được tích hợp trên Solana.\r\n\r\n> Nếu bạn không quen thuộc với chữ ký Winternitz, hãy bắt đầu bằng cách đọc [Chữ ký Winternitz trên Solana](/vi/courses/winternitz-signatures-on-solana) để hiểu các khái niệm cốt lõi và mật mã cơ bản.\r\n\r\nTrong thử thách này, chúng ta sẽ cập nhật vault lamport đơn giản mà chúng ta đã xây dựng trong [Thử thách Vault Pinocchio](/vi/challenges/pinocchio-vault) để cho phép chữ ký Winternitz làm phương pháp xác minh cho các giao dịch.\r\n\r\n<ArticleSection name=\"Cài đặt\" id=\"installation\" level=\"h2\" />\r\n\r\nTrước khi bắt đầu, hãy đảm bảo rằng Rust và Pinocchio đã được cài đặt. Sau đó, chạy lệnh sau trong terminal của bạn:\r\n\r\n```bash\r\n# create workspace\r\ncargo new Kiloshift-pinocchio-quantum-vault --lib --edition 2021\r\ncd Kiloshift-pinocchio-quantum-vault\r\n```\r\n\r\nThêm `pinocchio`, `pinocchio-system`, và `solana-nostd-sha256` và `solana-winternitz`:\r\n\r\n```bash\r\ncargo add pinocchio pinocchio-system solana-nostd-sha256 solana-winternitz\r\n```\r\n\r\nKhai báo crate types trong `Cargo.toml` để sinh ra các tập tin triển khai trong `target/deploy`:\r\n\r\n```toml\r\n[lib]\r\ncrate-type = [\"lib\", \"cdylib\"]\r\n```\r\n\r\nBạn đã sẵn sàng để viết chương trình vault lượng tử của mình.\r\n\r\n<ArticleSection name=\"Mẫu\" id=\"template\" level=\"h2\" />\r\n\r\nLần này, chúng ta sẽ chia chương trình thành các module nhỏ, tập trung thay vì đặt mọi thứ vào `lib.rs`. Cấu trúc thư mục sẽ trông giống như sau:\r\n\r\n```\r\nsrc\r\n├── instructions\r\n│       ├── close.rs\r\n│       ├── open.rs\r\n│       ├── mod.rs\r\n│       └── split.rs\r\n└── lib.rs\r\n```\r\n\r\n**Lưu ý**: Nhớ thay đổi ID chương trình thành `22222222222222222222222222222222222222222222` vì chúng tôi sử dụng cái này để kiểm tra chương trình của bạn.\r\n\r\nEntrypoint trong tệp `lib.rs` rất giống với những gì chúng tôi đã đề cập trong [Khóa học Giới thiệu về Pinocchio](/vi/courses/introduction-to-pinocchio).\r\n\r\n```rust\r\npub mod instructions;\r\nuse instructions::*;\r\n\r\nuse pinocchio::{\r\n    account_info::AccountInfo, program_entrypoint, program_error::ProgramError,\r\n    pubkey::Pubkey, ProgramResult,\r\n};\r\n\r\nprogram_entrypoint!(process_instruction);\r\n\r\n// 22222222222222222222222222222222222222222222\r\npub const ID: Pubkey = [\r\n    0x0f, 0x1e, 0x6b, 0x14, 0x21, 0xc0, 0x4a, 0x07, \r\n    0x04, 0x31, 0x26, 0x5c, 0x19, 0xc5, 0xbb, 0xee, \r\n    0x19, 0x92, 0xba, 0xe8, 0xaf, 0xd1, 0xcd, 0x07, \r\n    0x8e, 0xf8, 0xaf, 0x70, 0x47, 0xdc, 0x11, 0xf7, \r\n];\r\n\r\nfn process_instruction(\r\n    _program_id: &Pubkey,\r\n    accounts: &[AccountInfo],\r\n    instruction_data: &[u8],\r\n) -> ProgramResult {    \r\n    match instruction_data.split_first() {\r\n        Some((OpenVault::DISCRIMINATOR, data)) => OpenVault::try_from((data, accounts))?.process(),\r\n        Some((SplitVault::DISCRIMINATOR, data)) => SplitVault::try_from((data, accounts))?.process(),\r\n        Some((CloseVault::DISCRIMINATOR, data)) => CloseVault::try_from((data, accounts))?.process(),\r\n        _ => Err(ProgramError::InvalidInstructionData)\r\n    }\r\n}\r\n```\r\n\r\nChúng tôi không cần bất kỳ thiết lập trạng thái nào ở đây, vì vậy chúng tôi chỉ cần chuyển sang việc tạo các instruction của mình.","highlightedCode":{"code-0":{"lang":"toml","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"["}]},{"type":"element","tagName":"span","properties":{"style":"color:#97E1F1"},"children":[{"type":"text","value":"lib"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"]"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#97E1F1"},"children":[{"type":"text","value":"crate-type"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":" ="}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" ["}]},{"type":"element","tagName":"span","properties":{"style":"color:#DEE492"},"children":[{"type":"text","value":"\""}]},{"type":"element","tagName":"span","properties":{"style":"color:#E7EE98"},"children":[{"type":"text","value":"lib"}]},{"type":"element","tagName":"span","properties":{"style":"color:#DEE4