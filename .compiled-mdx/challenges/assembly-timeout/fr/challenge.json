ine":84,"column":1,"offset":5333},"end":{"line":84,"column":102,"offset":5434}}},{"type":"code","lang":"sbpf","meta":null,"value":"jle r1, r2, end    // If current slot <= max slot, success\r\nlddw r0, 1         // Otherwise, set error code","position":{"start":{"line":86,"column":1,"offset":5438},"end":{"line":89,"column":4,"offset":5559}},"data":{"highlightId":"code-3"}},{"type":"paragraph","children":[{"type":"text","value":"La logique de temporisation principale utilise un seul saut conditionnel :","position":{"start":{"line":91,"column":1,"offset":5563},"end":{"line":91,"column":75,"offset":5637}}}],"position":{"start":{"line":91,"column":1,"offset":5563},"end":{"line":91,"column":75,"offset":5637}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Validation temporelle : ","position":{"start":{"line":92,"column":3,"offset":5641},"end":{"line":92,"column":27,"offset":5665}}},{"type":"inlineCode","value":"jle","position":{"start":{"line":92,"column":27,"offset":5665},"end":{"line":92,"column":32,"offset":5670}}},{"type":"text","value":" (saut si inférieur ou égal) compare le slot actuel (","position":{"start":{"line":92,"column":32,"offset":5670},"end":{"line":92,"column":85,"offset":5723}}},{"type":"inlineCode","value":"r1","position":{"start":{"line":92,"column":85,"offset":5723},"end":{"line":92,"column":89,"offset":5727}}},{"type":"text","value":") à notre date limite (","position":{"start":{"line":92,"column":89,"offset":5727},"end":{"line":92,"column":112,"offset":5750}}},{"type":"inlineCode","value":"r2","position":{"start":{"line":92,"column":112,"offset":5750},"end":{"line":92,"column":116,"offset":5754}}},{"type":"text","value":"). Si nous sommes dans la fenêtre temporelle, saut vers ","position":{"start":{"line":92,"column":116,"offset":5754},"end":{"line":92,"column":172,"offset":5810}}},{"type":"inlineCode","value":"exit","position":{"start":{"line":92,"column":172,"offset":5810},"end":{"line":92,"column":178,"offset":5816}}}],"position":{"start":{"line":92,"column":3,"offset":5641},"end":{"line":92,"column":178,"offset":5816}}}],"position":{"start":{"line":92,"column":1,"offset":5639},"end":{"line":92,"column":178,"offset":5816}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Gestion du délai d'attente : Si la date limite est dépassée, l'exécution continue pour charger (","position":{"start":{"line":93,"column":3,"offset":5820},"end":{"line":93,"column":99,"offset":5916}}},{"type":"inlineCode","value":"lddw","position":{"start":{"line":93,"column":99,"offset":5916},"end":{"line":93,"column":105,"offset":5922}}},{"type":"text","value":") le code d'erreur 1 dans le registre de retour ","position":{"start":{"line":93,"column":105,"offset":5922},"end":{"line":93,"column":153,"offset":5970}}},{"type":"inlineCode","value":"r0","position":{"start":{"line":93,"column":153,"offset":5970},"end":{"line":93,"column":157,"offset":5974}}}],"position":{"start":{"line":93,"column":3,"offset":5820},"end":{"line":93,"column":157,"offset":5974}}}],"position":{"start":{"line":93,"column":1,"offset":5818},"end":{"line":93,"column":157,"offset":5974}}}],"position":{"start":{"line":92,"column":1,"offset":5639},"end":{"line":93,"column":157,"offset":5974}}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Conclusion","position":{"start":{"line":95,"column":17,"offset":5994},"end":{"line":95,"column":34,"offset":6011}}},{"type":"mdxJsxAttribute","name":"id","value":"conclusion","position":{"start":{"line":95,"column":35,"offset":6012},"end":{"line":95,"column":50,"offset":6027}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":95,"column":51,"offset":6028},"end":{"line":95,"column":61,"offset":6038}}}],"children":[],"position":{"start":{"line":95,"column":1,"offset":5978},"end":{"line":95,"column":64,"offset":6041}}},{"type":"paragraph","children":[{"type":"text","value":"Ce programme compact réalise une validation temporelle avec une consommation minimale d'unités de calcul.","position":{"start":{"line":97,"column":1,"offset":6045},"end":{"line":97,"column":106,"offset":6150}}}],"position":{"start":{"line":97,"column":1,"offset":6045},"end":{"line":97,"column":106,"offset":6150}}},{"type":"paragraph","children":[{"type":"text","value":"Le compromis réside dans la compréhension des interfaces syscall, la gestion de la pile et la disposition binaire de la sysvar ","position":{"start":{"line":99,"column":1,"offset":6154},"end":{"line":99,"column":128,"offset":6281}}},{"type":"inlineCode","value":"Clock","position":{"start":{"line":99,"column":128,"offset":6281},"end":{"line":99,"column":135,"offset":6288}}},{"type":"text","value":". Mais pour les validations temporelles critiques en termes de performance, l'assembleur offre une efficacité inégalée.","position":{"start":{"line":99,"column":135,"offset":6288},"end":{"line":99,"column":254,"offset":6407}}}],"position":{"start":{"line":99,"column":1,"offset":6154},"end":{"line":99,"column":254,"offset":6407}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":99,"column":254,"offset":6407}}},"raw":"import ArticleSection from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Délai d'expiration d'assemblage\r\n\r\n![Défi de délai d'expiration d'assemblage](/graphics/challenge-banners/assembly-timeout.png)\r\n\r\nDans cette unité, nous utiliserons l'assemblage sBPF pour créer une instruction de validation basée sur le temps qui impose des délais de hauteur de slot.\r\n\r\nEn incluant cette instruction dans votre transaction, vous créez un mécanisme de sécurité qui empêche l'exécution après un temps blockchain spécifié, protégeant ainsi contre l'exécution retardée de transactions ou les rejeux d'instructions obsolètes.\r\n\r\nPlusieurs propriétés rendent les vérifications de délai idéales pour l'assemblage :\r\n- Cas d'utilisation unique et contraint\r\n- Utilisation efficace des variables système\r\n- Aucune validation complexe de compte requise\r\n- Améliore uniquement la sécurité des transactions\r\n\r\nSi vous n'êtes pas familier avec la programmation en assemblage, suivez le [cours d'introduction à l'assemblage](/en/courses/introduction-to-assembly)\r\n\r\n<ArticleSection name=\"Conception du programme\" id=\"program-design\" level=\"h2\" />\r\n\r\nNotre programme implémente une opération temporelle cruciale : valider que la hauteur actuelle du slot de la blockchain n'a pas dépassé une échéance prédéterminée. Ce modèle est essentiel pour les opérations DeFi sensibles au temps — de la prévention des tentatives d'arbitrage obsolètes à l'application des délais d'enchères.\r\n\r\nLe programme attend :\r\n- Une hauteur maximale de slot de 8 octets dans les données d'instruction.\r\n- Accès à la sysvar Clock de Solana via `sol_get_clock_sysvar`.\r\n- Retourne un succès si le slot actuel ≤ slot max, une erreur dans le cas contraire.\r\n\r\n<ArticleSection name=\"Décalages mémoire\" id=\"memory-offsets\" level=\"h2\" />\r\n\r\nLes programmes sBPF reçoivent les données de compte sous forme de régions mémoire contiguës. Ces constantes définissent les décalages d'octets dans cette mémoire.\r\n\r\nComme notre programme n'accepte aucun compte, nous pouvons calculer où `MAX_SLOT_HEIGHT` (transmis comme données d'instruction) sera situé. Nous stockerons également les données de la sysvar `Clock` sur la pile, c'est pourquoi le `CURRENT_SLOT_HEIGHT` sera négatif.\r\n\r\nCes constantes définissent notre disposition mémoire :\r\n\r\n```sbpf\r\n.equ NUM_ACCOUNTS, 0x0000\r\n.equ MAX_SLOT_HEIGHT, 0x0010\r\n.equ CURRENT_SLOT_HEIGHT, -0x0028\r\n```\r\n\r\n- `NUM_ACCOUNTS` (0x0000) : Pointe vers le nombre de comptes dans l'en-tête des données d'instruction pour validation\r\n- `MAX_SLOT_HEIGHT` (0x0010) : Localise la hauteur de slot d'échéance de 8 octets dans la charge utile des données d'instruction\r\n- `CURRENT_SLOT_HEIGHT` (-0x0028) : Décalage de pile où le champ slot de la sysvar Clock sera stocké. Comme slot est le premier champ dans la structure Clock, ce décalage y pointe directement\r\n\r\nContrairement aux langages de haut niveau qui abstraient la disposition de la mémoire, l'assembleur nécessite de savoir exactement où se trouve chaque élément de données.\r\n\r\n<ArticleSection name=\"Point d'entrée et validation initiale\" id=\"entrypoint-and-validations\" level=\"h2\" />\r\n\r\n```sbpf\r\n.globl entrypoint\r\nentrypoint:\r\n  ldxdw r0, [r1+NUM_ACCOUNTS]       // Veto if any accounts are included\r\n  ldxdw r2, [r1+MAX_SLOT_HEIGHT]    // Store target slot height\r\n```\r\n\r\nChaque programme sBPF commence par un symbole global `.entrypoint`. L'environnement d'exécution Solana fournit les données de compte et d'instruction via le registre `r1`.\r\n\r\nL'instruction `ldxdw` charge (`ldx`) une valeur de 8 octets (double mot, `dx`) depuis la mémoire vers un registre. Voici ce qui se passe :\r\n- `ldxdw r0, [r1+NUM_ACCOUNTS]` : charge le nombre de comptes dans `r0`. Comme `r0` est le registre que la VM lit à la sortie, toute valeur non nulle fait automatiquement échouer le programme (exactement ce que nous voulons si des comptes sont transmis).\r\n- `ldxdw r2, [r1+MAX_SLOT_HEIGHT]` : pointe vers la hauteur maximale de slot autorisée que nous avons passée dans les données d'instruction. Cette valeur de 64 bits arrive dans `r2`.\r\n\r\nLes deux opérations sont sans copie : nous lisons directement à partir des données du compte sans surcharge de désérialisation.\r\n\r\n<ArticleSection name=\"La Sysvar Clock\" id=\"the-clock-sysvar\" level=\"h2\" />\r\n\r\n```sbpf\r\nmov64 r1, r10\r\nadd64 r1, CURRENT_SLOT_HEIGHT\r\ncall sol_get_clock_sysvar\r\nldxdw r1, [r1+0x0000]\r\n```\r\n\r\nL'appel système `sol_get_clock_sysvar` écrit les données `Clock` actuelles à l'adresse mémoire spécifiée dans `r1`.\r\n\r\nComme la structure Clock fait 40 octets (trop grande pour les registres qui ne contiennent que 8 octets chacun), nous utilisons la pile pour un stockage rapide sans allocation avec nettoyage automatique.\r\n\r\nComme `r10` est en lecture seule, pour opérer sur la pile, nous devons copier son adresse mémoire dans un registre : `mov64 r1, r10`\r\n\r\nEnsuite, nous ajoutons `CURRENT_SLOT_HEIGHT` (-0x0028) à `r1`. Comme cette constante est négative, il s'agit en fait d'une soustraction : `r1 = r10 - 40 bytes`, allouant 40 octets sur la pile.\r\n\r\nAprès avoir appelé la fonction `sol_get_clock_sysvar`, `r1` contient l'adresse mémoire où les données Clock ont été écrites, et non la valeur du slot elle-même. Pour cette raison, nous procédons au chargement de la valeur réelle du slot en utilisant `ldxdw r1, [r1+0x0000]`.\r\n\r\n<ArticleSection name=\"Logique de comparaison temporelle\" id=\"temporal-comparison-logic\" level=\"h2\" />\r\n\r\n```sbpf\r\njle r1, r2, end    // If current slot <= max slot, success\r\nlddw r0, 1         // Otherwise, set error code\r\n```\r\n\r\nLa logique de temporisation principale utilise un seul saut conditionnel :\r\n- Validation temporelle : `jle` (saut si inférieur ou égal) compare le slot actuel (`r1`) à notre date limite (`r2`). Si nous sommes dans la fenêtre temporelle, saut vers `exit`\r\n- Gestion du délai d'attente : Si la date limite est dépassée, l'exécution continue pour charger (`lddw`) le code d'erreur 1 dans le registre de retour `r0`\r\n\r\n<ArticleSection name=\"Conclusion\" id=\"conclusion\" level=\"h2\" />\r\n\r\nCe programme compact réalise une validation temporelle avec une consommation minimale d'unités de calcul.\r\n\r\nLe compromis réside dans la compréhension des interfaces syscall, la gestion de la pile et la disposition binaire de la sysvar `Clock`. Mais pour les validations temporelles critiques en termes de performance, l'assembleur offre une efficacité inégalée.","highlightedCode":{"code-0":{"lang":"sbpf","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":".equ NUM_ACCOUNTS, "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F1FA8C"},"children":[{"type":"text","value":"0x0000"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":".equ MAX_SLOT_HEIGHT, "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F1FA8C"},"children":[{"type":"text","value":"0x0010"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":".equ CURRENT_SLOT_HEIGHT, -"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F1FA8C"},"children":[{"type":"text","value":"0x0028"}]}]}]}]}]}},"code-1":{"lang":"sbpf","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#FF79C6"},"children":[{"type":"text","value":".globl"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" entrypoint"}]}]},{"type":"text","value":"\n"},{"t