line":72,"column":4,"offset":4134}},"data":{"highlightId":"code-2"}},{"type":"paragraph","children":[{"type":"text","value":"Системний виклик ","position":{"start":{"line":74,"column":1,"offset":4138},"end":{"line":74,"column":18,"offset":4155}}},{"type":"inlineCode","value":"sol_get_clock_sysvar","position":{"start":{"line":74,"column":18,"offset":4155},"end":{"line":74,"column":40,"offset":4177}}},{"type":"text","value":" записує поточні дані ","position":{"start":{"line":74,"column":40,"offset":4177},"end":{"line":74,"column":62,"offset":4199}}},{"type":"inlineCode","value":"Clock","position":{"start":{"line":74,"column":62,"offset":4199},"end":{"line":74,"column":69,"offset":4206}}},{"type":"text","value":" в ","position":{"start":{"line":74,"column":69,"offset":4206},"end":{"line":74,"column":72,"offset":4209}}},{"type":"inlineCode","value":"r1","position":{"start":{"line":74,"column":72,"offset":4209},"end":{"line":74,"column":76,"offset":4213}}},{"type":"text","value":".","position":{"start":{"line":74,"column":76,"offset":4213},"end":{"line":74,"column":77,"offset":4214}}}],"position":{"start":{"line":74,"column":1,"offset":4138},"end":{"line":74,"column":78,"offset":4215}}},{"type":"paragraph","children":[{"type":"text","value":"Оскільки структура Clock має розмір 40 байтів (занадто велика для регістрів, які містять лише по 8 байтів), ми використовуємо стек для швидкого зберігання без виділення пам'яті з автоматичним очищенням.","position":{"start":{"line":76,"column":1,"offset":4219},"end":{"line":76,"column":203,"offset":4421}}}],"position":{"start":{"line":76,"column":1,"offset":4219},"end":{"line":76,"column":203,"offset":4421}}},{"type":"paragraph","children":[{"type":"text","value":"Оскільки ","position":{"start":{"line":78,"column":1,"offset":4425},"end":{"line":78,"column":10,"offset":4434}}},{"type":"inlineCode","value":"r10","position":{"start":{"line":78,"column":10,"offset":4434},"end":{"line":78,"column":15,"offset":4439}}},{"type":"text","value":" доступний лише для читання, для роботи зі стеком нам потрібно скопіювати його адресу пам'яті в регістр: ","position":{"start":{"line":78,"column":15,"offset":4439},"end":{"line":78,"column":120,"offset":4544}}},{"type":"inlineCode","value":"mov64 r1, r10","position":{"start":{"line":78,"column":120,"offset":4544},"end":{"line":78,"column":135,"offset":4559}}}],"position":{"start":{"line":78,"column":1,"offset":4425},"end":{"line":78,"column":135,"offset":4559}}},{"type":"paragraph","children":[{"type":"text","value":"Потім ми додаємо ","position":{"start":{"line":80,"column":1,"offset":4563},"end":{"line":80,"column":18,"offset":4580}}},{"type":"inlineCode","value":"CURRENT_SLOT_HEIGHT","position":{"start":{"line":80,"column":18,"offset":4580},"end":{"line":80,"column":39,"offset":4601}}},{"type":"text","value":" (-0x0028) до ","position":{"start":{"line":80,"column":39,"offset":4601},"end":{"line":80,"column":53,"offset":4615}}},{"type":"inlineCode","value":"r1","position":{"start":{"line":80,"column":53,"offset":4615},"end":{"line":80,"column":57,"offset":4619}}},{"type":"text","value":". Оскільки ця константа від'ємна, це фактично віднімання: ","position":{"start":{"line":80,"column":57,"offset":4619},"end":{"line":80,"column":115,"offset":4677}}},{"type":"inlineCode","value":"r1 = r10 - 40 bytes","position":{"start":{"line":80,"column":115,"offset":4677},"end":{"line":80,"column":136,"offset":4698}}},{"type":"text","value":", що виділяє 40 байтів на стеку.","position":{"start":{"line":80,"column":136,"offset":4698},"end":{"line":80,"column":168,"offset":4730}}}],"position":{"start":{"line":80,"column":1,"offset":4563},"end":{"line":80,"column":168,"offset":4730}}},{"type":"paragraph","children":[{"type":"text","value":"Після виклику функції ","position":{"start":{"line":82,"column":1,"offset":4734},"end":{"line":82,"column":23,"offset":4756}}},{"type":"inlineCode","value":"sol_get_clock_sysvar","position":{"start":{"line":82,"column":23,"offset":4756},"end":{"line":82,"column":45,"offset":4778}}},{"type":"text","value":", ","position":{"start":{"line":82,"column":45,"offset":4778},"end":{"line":82,"column":47,"offset":4780}}},{"type":"inlineCode","value":"r1","position":{"start":{"line":82,"column":47,"offset":4780},"end":{"line":82,"column":51,"offset":4784}}},{"type":"text","value":" містить адресу пам'яті, куди були записані дані Clock, а не саме значення слоту. З цієї причини ми продовжуємо завантажувати фактичне значення слоту за допомогою ","position":{"start":{"line":82,"column":51,"offset":4784},"end":{"line":82,"column":214,"offset":4947}}},{"type":"inlineCode","value":"ldxdw r1, [r1+0x0000]","position":{"start":{"line":82,"column":214,"offset":4947},"end":{"line":82,"column":237,"offset":4970}}},{"type":"text","value":".","position":{"start":{"line":82,"column":237,"offset":4970},"end":{"line":82,"column":238,"offset":4971}}}],"position":{"start":{"line":82,"column":1,"offset":4734},"end":{"line":82,"column":238,"offset":4971}}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Логіка часового порівняння","position":{"start":{"line":84,"column":17,"offset":4991},"end":{"line":84,"column":50,"offset":5024}}},{"type":"mdxJsxAttribute","name":"id","value":"temporal-comparison-logic","position":{"start":{"line":84,"column":51,"offset":5025},"end":{"line":84,"column":81,"offset":5055}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":84,"column":82,"offset":5056},"end":{"line":84,"column":92,"offset":5066}}}],"children":[],"position":{"start":{"line":84,"column":1,"offset":4975},"end":{"line":84,"column":95,"offset":5069}}},{"type":"code","lang":"sbpf","meta":null,"value":"jle r1, r2, end    // If current slot <= max slot, success\r\nlddw r0, 1         // Otherwise, set error code","position":{"start":{"line":86,"column":1,"offset":5073},"end":{"line":89,"column":4,"offset":5194}},"data":{"highlightId":"code-3"}},{"type":"paragraph","children":[{"type":"text","value":"Основна логіка тайм-ауту використовує один умовний перехід:","position":{"start":{"line":91,"column":1,"offset":5198},"end":{"line":91,"column":60,"offset":5257}}}],"position":{"start":{"line":91,"column":1,"offset":5198},"end":{"line":91,"column":60,"offset":5257}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Часова валідація: ","position":{"start":{"line":92,"column":3,"offset":5261},"end":{"line":92,"column":21,"offset":5279}}},{"type":"inlineCode","value":"jle","position":{"start":{"line":92,"column":21,"offset":5279},"end":{"line":92,"column":26,"offset":5284}}},{"type":"text","value":" (перехід, якщо менше або дорівнює) порівнює поточний слот (","position":{"start":{"line":92,"column":26,"offset":5284},"end":{"line":92,"column":86,"offset":5344}}},{"type":"inlineCode","value":"r1","position":{"start":{"line":92,"column":86,"offset":5344},"end":{"line":92,"column":90,"offset":5348}}},{"type":"text","value":") з нашим дедлайном (","position":{"start":{"line":92,"column":90,"offset":5348},"end":{"line":92,"column":111,"offset":5369}}},{"type":"inlineCode","value":"r2","position":{"start":{"line":92,"column":111,"offset":5369},"end":{"line":92,"column":115,"offset":5373}}},{"type":"text","value":"). Якщо ми в межах часового вікна, перехід до ","position":{"start":{"line":92,"column":115,"offset":5373},"end":{"line":92,"column":161,"offset":5419}}},{"type":"inlineCode","value":"exit","position":{"start":{"line":92,"column":161,"offset":5419},"end":{"line":92,"column":167,"offset":5425}}}],"position":{"start":{"line":92,"column":3,"offset":5261},"end":{"line":92,"column":167,"offset":5425}}}],"position":{"start":{"line":92,"column":1,"offset":5259},"end":{"line":92,"column":167,"offset":5425}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Обробка тайм-ауту: Якщо дедлайн минув, виконання продовжується завантаженням (","position":{"start":{"line":93,"column":3,"offset":5429},"end":{"line":93,"column":81,"offset":5507}}},{"type":"inlineCode","value":"lddw","position":{"start":{"line":93,"column":81,"offset":5507},"end":{"line":93,"column":87,"offset":5513}}},{"type":"text","value":") коду помилки 1 у регістр повернення ","position":{"start":{"line":93,"column":87,"offset":5513},"end":{"line":93,"column":125,"offset":5551}}},{"type":"inlineCode","value":"r0","position":{"start":{"line":93,"column":125,"offset":5551},"end":{"line":93,"column":129,"offset":5555}}}],"position":{"start":{"line":93,"column":3,"offset":5429},"end":{"line":93,"column":129,"offset":5555}}}],"position":{"start":{"line":93,"column":1,"offset":5427},"end":{"line":93,"column":129,"offset":5555}}}],"position":{"start":{"line":92,"column":1,"offset":5259},"end":{"line":93,"column":129,"offset":5555}}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Висновок","position":{"start":{"line":95,"column":17,"offset":5575},"end":{"line":95,"column":32,"offset":5590}}},{"type":"mdxJsxAttribute","name":"id","value":"conclusion","position":{"start":{"line":95,"column":33,"offset":5591},"end":{"line":95,"column":48,"offset":5606}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":95,"column":49,"offset":5607},"end":{"line":95,"column":59,"offset":5617}}}],"children":[],"position":{"start":{"line":95,"column":1,"offset":5559},"end":{"line":95,"column":62,"offset":5620}}},{"type":"paragraph","children":[{"type":"text","value":"Ця компактна програма виконує часову валідацію з мінімальним споживанням обчислювальних ресурсів.","position":{"start":{"line":97,"column":1,"offset":5624},"end":{"line":97,"column":98,"offset":5721}}}],"position":{"start":{"line":97,"column":1,"offset":5624},"end":{"line":97,"column":98,"offset":5721}}},{"type":"paragraph","children":[{"type":"text","value":"Компромісом є розуміння інтерфейсів системних викликів, управління стеком та бінарної структури sysvar ","position":{"start":{"line":99,"column":1,"offset":5725},"end":{"line":99,"column":104,"offset":5828}}},{"type":"inlineCode","value":"Clock","position":{"start":{"line":99,"column":104,"offset":5828},"end":{"line":99,"column":111,"offset":5835}}},{"type":"text","value":". Але для критично важливих за продуктивністю часових валідацій, асемблер забезпечує неперевершену ефективність.","position":{"start":{"line":99,"column":111,"offset":5835},"end":{"line":99,"column":223,"offset":5947}}}],"position":{"start":{"line":99,"column":1,"offset":5725},"end":{"line":99,"column":223,"offset":5947}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":99,"column":223,"offset":5947}}},"raw":"import ArticleSection from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Таймаут збірки\r\n\r\n![Завдання з таймауту збірки](/graphics/challenge-banners/assembly-timeout.png)\r\n\r\nУ цьому розділі ми використаємо sBPF Assembly для створення інструкції перевірки на основі часу, яка забезпечує дотримання крайніх термінів висоти слоту.\r\n\r\nВключаючи цю інструкцію у свою транзакцію, ви створюєте механізм захисту, який запобігає виконанню після вказаного часу блокчейну, захищаючи від затримки виконання транзакції або повторного відтворення застарілих інструкцій.\r\n\r\nКілька властивостей роблять перевірки таймауту ідеальними для асемблера:\r\n- Єдиний, обмежений варіант використання\r\n- Ефективне використання системних змінних\r\n- Не потрібна складна перевірка облікових записів\r\n- Лише покращує безпеку транзакцій\r\n\r\nЯкщо ви не знайомі з програмуванням на асемблері, пройдіть [вступний курс з асемблера](/uk/courses/introduction-to-assembly)\r\n\r\n<ArticleSection name=\"Дизайн програми\" id=\"program-design\" level=\"h2\" />\r\n\r\nНаша програма реалізує важливу часову операцію: перевірку того, що поточна висота слоту блокчейну не перевищила заздалегідь визначений крайній термін. Цей патерн є важливим для часово-чутливих операцій DeFi — від запобігання застарілим спробам арбітражу до забезпечення дотримання термінів аукціонів.\r\n\r\nПрограма очікує:\r\n- 8-байтову максимальну висоту слоту в даних інструкції.\r\n- Доступ до системної змінної Solana Clock через `sol_get_clock_sysvar`.\r\n- Повертає успіх, якщо поточний слот ≤ максимального слоту, інакше — помилку.\r\n\r\n<ArticleSection name=\"Зміщення пам'яті\" id=\"memory-offsets\" level=\"h2\" />\r\n\r\nПрограми sBPF отримують дані облікових записів як суміжні області пам'яті. Ці константи визначають байтові зміщення в цій пам'яті.\r\n\r\nОскільки наша програма не приймає жодних облікових записів, ми можемо обчислити, де буде розташовано `MAX_SLOT_HEIGHT` (передається як дані інструкції). Ми також зберігатимемо дані системної змінної `Clock` у стеку, з цієї причини `CURRENT_SLOT_HEIGHT` буде від'ємним.\r\n\r\nЦі константи визначають нашу структуру пам'яті:   \r\n\r\n```sbpf\r\n.equ NUM_ACCOUNTS, 0x0000\r\n.equ MAX_SLOT_HEIGHT, 0x0010\r\n.equ CURRENT_SLOT_HEIGHT, -0x0028\r\n```\r\n\r\n- `NUM_ACCOUNTS` (0x0000): Вказує на кількість облікових записів у заголовку даних інструкції для перевірки\r\n- `MAX_SLOT_HEIGHT` (0x0010): Визначає місцезнаходження 8-байтової висоти слоту крайнього терміну в корисному навантаженні даних інструкції\r\n- `CURRENT_SLOT_HEIGHT` (-0x0028): Зміщення стеку, де буде зберігатися поле слоту системної змінної Clock. Оскільки слот є першим полем у структурі Clock, це зміщення вказує безпосередньо на нього\r\n\r\nНа відміну від мов високого рівня, які абстрагують розташування пам'яті, асемблер вимагає точного знання, де знаходиться кожен фрагмент даних.\r\n\r\n<ArticleSection name=\"Entrypoint and Initial Validation\" id=\"entrypoint-and-validations\" level=\"h2\" />\r\n\r\n```sbpf\r\n.globl entrypoint\r\nentrypoint:\r\n  ldxdw r0, [r1+NUM_ACCOUNTS]       // Veto if any accounts are included\r\n  ldxdw r2, [r1+MAX_SLOT_HEIGHT]    // Store target slot height\r\n```\r\n\r\nКожна програма sBPF починається з глобального символу `.entrypoint`. Середовище виконання Solana надає дані облікового запису та інструкції через регістр `r1`.\r\n\r\nІнструкція `ldxdw` завантажує (`ldx`) 8-байтове (подвійне слово, `dx`) значення з пам'яті в регістр. Ось що відбувається:\r\n- `ldxdw r0, [r1+NUM_ACCOUNTS]`: завантажує кількість облікових записів у `r0`. Оскільки `r0` є регістром, який VM читає при виході, будь-яке ненульове значення автоматично призводить до невдачі програми (саме те, що нам потрібно, якщо передаються облікові записи).\r\n- `ldxdw r2, [r1+MAX_SLOT_HEIGHT]`: вказує на максимально дозволену висоту слоту, яку ми передали в даних інструкції. Це 64-бітне значення потрапляє в `r2`.\r\n\r\nОбидві операції виконуються без копіювання: ми читаємо безпосередньо з даних облікового запису без накладних витрат на десеріалізацію.\r\n\r\n<ArticleSection name=\"The Clock Sysvar\" id=\"the-clock-sysvar\" level=\"h2\" />\r\n\r\n```sbpf\r\nmov64 r1, r10\r\nadd64 r1, CURRENT_SLOT_HEIGHT\r\ncall sol_get_clock_sysvar\r\nldxdw r1, [r1+0x0000]\r\n```\r\n\r\nСистемний виклик `sol_get_clock_sysvar` записує поточні дані `Clock` в `r1`. \r\n\r\nОскільки структура Clock має розмір 40 байтів (занадто велика для регістрів, які містять лише по 8 байтів), ми використовуємо стек для швидкого зберігання без виділення пам'яті з автоматичним очищенням.\r\n\r\nОскільки `r10` доступний лише для читання, для роботи зі стеком нам потрібно скопіювати його адресу пам'яті в регістр: `mov64 r1, r10`\r\n\r\nПотім ми додаємо `CURRENT_SLOT_HEIGHT` (-0x0028) до `r1`. Оскільки ця константа від'ємна, це фактично віднімання: `r1 = r10 - 40 bytes`, що виділяє 40 байтів на стеку.\r\n\r\nПісля виклику функції `sol_get_clock_sysvar`, `r1` містить адресу пам'яті, куди були записані дані Clock, а не саме значення слоту. З цієї причини ми продовжуємо завантажувати фактичне значення слоту за допомогою `ldxdw r1, [r1+0x0000]`.\r\n\r\n<ArticleSection name=\"Логіка часового порівняння\" id=\"temporal-comparison-logic\" level=\"h2\" />\r\n\r\n```sbpf\r\njle r1, r2, end    // If current slot <= max slot, success\r\nlddw r0, 1         // Otherwise, set error code\r\n```\r\n\r\nОсновна логіка тайм-ауту використовує один умовний перехід:\r\n- Часова валідація: `jle` (перехід, якщо менше або дорівнює) порівнює поточний слот (`r1`) з нашим дедлайном (`r2`). Якщо ми в межах часового вікна, перехід до `exit`\r\n- Обробка тайм-ауту: Якщо дедлайн минув, виконання продовжується завантаженням (`lddw`) коду помилки 1 у регістр повернення `r0`\r\n\r\n<ArticleSection name=\"Висновок\" id=\"conclusion\" level=\"h2\" />\r\n\r\nЦя компактна програма виконує часову валідацію з мінімальним споживанням обчислювальних ресурсів.\r\n\r\nКомпромісом є розуміння інтерфейсів системних викликів, управління стеком та бінарної структури sysvar `Clock`. Але для критично важливих за продуктивністю часових валідацій, асемблер забезпечує неперевершену ефективність.","highlightedCode":{"code-0":{"lang":"sbpf","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":".equ NUM_ACCOUNTS, "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F1FA8C"},"children":[{"type":"text","value":"0x0000"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":".equ MAX_SLOT_HEIGHT, "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F1FA8C"},"children":[{"type":"text","value":"0x0010"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":".equ CURRENT_SLOT_HEIGHT, -"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F1FA8C"},"children":[{"type":"text","value":"0x0028"}]}]}]}]}]}},"code-1":{"lang":"sbpf","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#FF79C6"},"children":[{"type":"text","value":".globl"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" entrypoint"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#8BE9FD;font-weight:bold"},"children":[{"type":"text","value":"entrypoint:"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#FF79C6;font-weight:bold"},"children":[{"type":"text","value":"  ldxdw"}]},{"type":"element","tagName":"span","properties":{"style":"color:#BD93F9"},"children":[{"type":"text","value":" r0"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":", ["}]},{"type":"element","tagName":"span","properties":{"style":"color:#BD93F9"},"children":[{"type":"text","value":"r1"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"+NUM_ACCOU