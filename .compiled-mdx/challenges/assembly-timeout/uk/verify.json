":1501},"end":{"line":29,"column":90,"offset":1586}}}],"position":{"start":{"line":28,"column":3,"offset":1442},"end":{"line":30,"column":17,"offset":1604}}},{"type":"mdxJsxFlowElement","name":"Requirement","attributes":[{"type":"mdxJsxAttribute","name":"title","value":"Завдання 2: Тестування невдачі таймауту","position":{"start":{"line":32,"column":16,"offset":1623},"end":{"line":32,"column":63,"offset":1670}}}],"children":[{"type":"paragraph","children":[{"type":"text","value":"Ваша програма повинна завершуватися з помилкою, коли передається слот, нижчий за поточний.","position":{"start":{"line":33,"column":5,"offset":1677},"end":{"line":33,"column":95,"offset":1767}}}],"position":{"start":{"line":33,"column":5,"offset":1677},"end":{"line":33,"column":95,"offset":1767}}}],"position":{"start":{"line":32,"column":3,"offset":1610},"end":{"line":34,"column":17,"offset":1785}}}],"position":{"start":{"line":27,"column":1,"offset":1421},"end":{"line":35,"column":19,"offset":1805}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":35,"column":19,"offset":1805}}},"raw":"import { ChallengeTitle } from \"../../../../components/Challenges/ChallengeTitle\";\r\nimport { RequirementList } from \"../../../../components/Challenges/RequirementList\";\r\nimport { Requirement } from \"../../../../components/Challenges/Requirement\";\r\n\r\n<ChallengeTitle>Таймаут sBPF Assembly</ChallengeTitle>\r\n\r\nТепер, коли ви маєте почуватися комфортно, пишучи на Assembly, замість використання `sol_get_clock_sysvar` спробуйте досягти тієї ж мети, передаючи обліковий запис `Clock`.\r\n\r\nСтворіть програму, яка має лише одну інструкцію. Вона повинна:\r\n- Приймати обліковий запис `Clock` (розміром 40).\r\n- Приймати слот u64 (8 байтів) у даних інструкції.\r\n- Використовувати перші 8 байтів облікового запису `Clock` для отримання поточного слота.\r\n- Перевіряти, чи поточний слот більший за слот, переданий в інструкції. Якщо так, повертати код помилки 1.\r\n\r\n> Щоб отримати правильне зміщення даних інструкції, ви можете використати наш [інструмент](https://sbpf.xyz). Просто не забудьте додати один обліковий запис і встановити довжину його даних як 40!\r\n\r\nПочніть із встановлення пакета sBPF, як пояснено в [розділі про інструменти](/uk/courses/introduction-to-assembly/tooling) курсу \"Вступ до Assembly\", і створіть свою програму за допомогою такої команди в терміналі:\r\n\r\n```\r\nsbpf build\r\n```\r\n\r\nЦе згенерує файл `.so` у вашій папці `target/deploy`.\r\n\r\nТепер натисніть на кнопку `take challenge` і перетягніть туди файл!\r\n\r\n<RequirementList>\r\n  <Requirement title=\"Завдання 1: Тестування таймауту\">\r\n    Ваша програма повинна успішно виконуватися, коли передається слот, вищий за поточний.\r\n  </Requirement>\r\n\r\n  <Requirement title=\"Завдання 2: Тестування невдачі таймауту\">\r\n    Ваша програма повинна завершуватися з помилкою, коли передається слот, нижчий за поточний.\r\n  </Requirement>\r\n</RequirementList>","highlightedCode":{"code-0":{"lang":"text","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{},"children":[{"type":"text","value":"sbpf build"}]}]}]}]}]}}}}