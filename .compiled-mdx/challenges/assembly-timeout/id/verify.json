5,"offset":1510},"end":{"line":29,"column":92,"offset":1597}}}],"position":{"start":{"line":28,"column":3,"offset":1454},"end":{"line":30,"column":17,"offset":1615}}},{"type":"mdxJsxFlowElement","name":"Requirement","attributes":[{"type":"mdxJsxAttribute","name":"title","value":"Tantangan 2: Menguji Kegagalan Timeout","position":{"start":{"line":32,"column":16,"offset":1634},"end":{"line":32,"column":62,"offset":1680}}}],"children":[{"type":"paragraph","children":[{"type":"text","value":"Program Anda harus gagal ketika slot yang lebih rendah dari slot saat ini diberikan.","position":{"start":{"line":33,"column":5,"offset":1687},"end":{"line":33,"column":89,"offset":1771}}}],"position":{"start":{"line":33,"column":5,"offset":1687},"end":{"line":33,"column":89,"offset":1771}}}],"position":{"start":{"line":32,"column":3,"offset":1621},"end":{"line":34,"column":17,"offset":1789}}}],"position":{"start":{"line":27,"column":1,"offset":1433},"end":{"line":35,"column":19,"offset":1809}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":35,"column":19,"offset":1809}}},"raw":"import { ChallengeTitle } from \"../../../../components/Challenges/ChallengeTitle\";\r\nimport { RequirementList } from \"../../../../components/Challenges/RequirementList\";\r\nimport { Requirement } from \"../../../../components/Challenges/Requirement\";\r\n\r\n<ChallengeTitle>Timeout sBPF Assembly</ChallengeTitle>\r\n\r\nSekarang setelah Anda mulai merasa nyaman menulis Assembly, alih-alih menggunakan `sol_get_clock_sysvar` cobalah mencapai tujuan yang sama dengan memasukkan akun `Clock`.\r\n\r\nBuat program yang hanya memiliki satu instruksi. Program tersebut harus:\r\n- Menerima akun `Clock` (berukuran 40).\r\n- Menerima slot u64 (8-byte) dalam data instruksi.\r\n- Menggunakan 8-byte pertama dari akun `Clock` untuk mengambil slot saat ini.\r\n- Memeriksa apakah slot saat ini lebih besar dari slot yang diberikan dalam instruksi. Jika ya, kembalikan kode error 1.\r\n\r\n> Untuk mendapatkan offset data instruksi yang tepat, Anda dapat menggunakan [alat kami](https://sbpf.xyz). Ingat untuk menambahkan satu akun dan atur panjang datanya sebagai 40!\r\n\r\nMulailah dengan menginstal paket sBPF seperti yang dijelaskan di [bagian alat](/id/courses/introduction-to-assembly/tooling) dari kursus Pengantar Assembly dan bangun program Anda menggunakan perintah berikut di terminal Anda:\r\n\r\n```\r\nsbpf build\r\n```\r\n\r\nIni akan menghasilkan file `.so` di folder `target/deploy` Anda.\r\n\r\nSekarang klik tombol `take challenge` dan letakkan file tersebut di sana!\r\n\r\n<RequirementList>\r\n  <Requirement title=\"Tantangan 1: Menguji Timeout\">\r\n    Program Anda harus berhasil ketika slot yang lebih tinggi dari slot saat ini diberikan.\r\n  </Requirement>\r\n\r\n  <Requirement title=\"Tantangan 2: Menguji Kegagalan Timeout\">\r\n    Program Anda harus gagal ketika slot yang lebih rendah dari slot saat ini diberikan.\r\n  </Requirement>\r\n</RequirementList>","highlightedCode":{"code-0":{"lang":"text","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{},"children":[{"type":"text","value":"sbpf build"}]}]}]}]}]}}}}