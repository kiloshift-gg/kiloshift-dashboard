{"style":"color:#BD93F9"},"children":[{"type":"text","value":"r1"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"+"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F1FA8C"},"children":[{"type":"text","value":"0x0000"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"]"}]}]}]}]}]}},"code-3":{"lang":"sbpf","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#FF79C6;font-weight:bold"},"children":[{"type":"text","value":"jle"}]},{"type":"element","tagName":"span","properties":{"style":"color:#BD93F9"},"children":[{"type":"text","value":" r1"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":", "}]},{"type":"element","tagName":"span","properties":{"style":"color:#BD93F9"},"children":[{"type":"text","value":"r2"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":", end    "}]},{"type":"element","tagName":"span","properties":{"style":"color:#7B7F8B"},"children":[{"type":"text","value":"// If current slot <= max slot, success"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#FF79C6;font-weight:bold"},"children":[{"type":"text","value":"lddw"}]},{"type":"element","tagName":"span","properties":{"style":"color:#BD93F9"},"children":[{"type":"text","value":" r0"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type"