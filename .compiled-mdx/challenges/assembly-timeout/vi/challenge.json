value":"mov64 r1, r10\r\nadd64 r1, CURRENT_SLOT_HEIGHT\r\ncall sol_get_clock_sysvar\r\nldxdw r1, [r1+0x0000]","position":{"start":{"line":67,"column":1,"offset":4063},"end":{"line":72,"column":4,"offset":4171}},"data":{"highlightId":"code-2"}},{"type":"paragraph","children":[{"type":"text","value":"Việc gọi ","position":{"start":{"line":74,"column":1,"offset":4175},"end":{"line":74,"column":10,"offset":4184}}},{"type":"inlineCode","value":"sol_get_clock_sysvar","position":{"start":{"line":74,"column":10,"offset":4184},"end":{"line":74,"column":32,"offset":4206}}},{"type":"text","value":" syscall sẽ ghi dữ liệu ","position":{"start":{"line":74,"column":32,"offset":4206},"end":{"line":74,"column":56,"offset":4230}}},{"type":"inlineCode","value":"Clock","position":{"start":{"line":74,"column":56,"offset":4230},"end":{"line":74,"column":63,"offset":4237}}},{"type":"text","value":" hiện tại vào địa chỉ ô nhớ được chỉ định trong ","position":{"start":{"line":74,"column":63,"offset":4237},"end":{"line":74,"column":111,"offset":4285}}},{"type":"inlineCode","value":"r1","position":{"start":{"line":74,"column":111,"offset":4285},"end":{"line":74,"column":115,"offset":4289}}},{"type":"text","value":".","position":{"start":{"line":74,"column":115,"offset":4289},"end":{"line":74,"column":116,"offset":4290}}}],"position":{"start":{"line":74,"column":1,"offset":4175},"end":{"line":74,"column":116,"offset":4290}}},{"type":"paragraph","children":[{"type":"text","value":"Bởi vì cấu trúc của Clock là 40 bytes (nó quá lớn cho các thanh ghi chỉ có thể lưu trữ 8 byte mỗi lần), chúng ta sử dụng stack cho việc lưu trữ nhanh chóng, không cần cấp phát và được dọn dẹp tự động.","position":{"start":{"line":76,"column":1,"offset":4294},"end":{"line":76,"column":201,"offset":4494}}}],"position":{"start":{"line":76,"column":1,"offset":4294},"end":{"line":76,"column":201,"offset":4494}}},{"type":"paragraph","children":[{"type":"text","value":"Bởi vì thanh ghi ","position":{"start":{"line":78,"column":1,"offset":4498},"end":{"line":78,"column":18,"offset":4515}}},{"type":"inlineCode","value":"r10","position":{"start":{"line":78,"column":18,"offset":4515},"end":{"line":78,"column":23,"offset":4520}}},{"type":"text","value":" là chỉ đọc, để hoạt động trên stack, chúng ta cần sao chép địa chỉ bộ nhớ của nó vào một thanh ghi: ","position":{"start":{"line":78,"column":23,"offset":4520},"end":{"line":78,"column":124,"offset":4621}}},{"type":"inlineCode","value":"mov64 r1, r10","position":{"start":{"line":78,"column":124,"offset":4621},"end":{"line":78,"column":139,"offset":4636}}}],"position":{"start":{"line":78,"column":1,"offset":4498},"end":{"line":78,"column":139,"offset":4636}}},{"type":"paragraph","children":[{"type":"text","value":"Sau đó chúng ta thêm ","position":{"start":{"line":80,"column":1,"offset":4640},"end":{"line":80,"column":22,"offset":4661}}},{"type":"inlineCode","value":"CURRENT_SLOT_HEIGHT","position":{"start":{"line":80,"column":22,"offset":4661},"end":{"line":80,"column":43,"offset":4682}}},{"type":"text","value":" (-0x0028) vào thanh ghi ","position":{"start":{"line":80,"column":43,"offset":4682},"end":{"line":80,"column":68,"offset":4707}}},{"type":"inlineCode","value":"r1","position":{"start":{"line":80,"column":68,"offset":4707},"end":{"line":80,"column":72,"offset":4711}}},{"type":"text","value":". Bởi vì hằng số này là số âm, nó thực tế là phép trừ: ","position":{"start":{"line":80,"column":72,"offset":4711},"end":{"line":80,"column":127,"offset":4766}}},{"type":"inlineCode","value":"r1 = r10 - 40 bytes","position":{"start":{"line":80,"column":127,"offset":4766},"end":{"line":80,"column":148,"offset":4787}}},{"type":"text","value":", cấp phát 40 bytes trên stack.","position":{"start":{"line":80,"column":148,"offset":4787},"end":{"line":80,"column":179,"offset":4818}}}],"position":{"start":{"line":80,"column":1,"offset":4640},"end":{"line":80,"column":179,"offset":4818}}},{"type":"paragraph","children":[{"type":"text","value":"Sau khi gọi hàm ","position":{"start":{"line":82,"column":1,"offset":4822},"end":{"line":82,"column":17,"offset":4838}}},{"type":"inlineCode","value":"sol_get_clock_sysvar","position":{"start":{"line":82,"column":17,"offset":4838},"end":{"line":82,"column":39,"offset":4860}}},{"type":"text","value":", thanh ghi ","position":{"start":{"line":82,"column":39,"offset":4860},"end":{"line":82,"column":51,"offset":4872}}},{"type":"inlineCode","value":"r1","position":{"start":{"line":82,"column":51,"offset":4872},"end":{"line":82,"column":55,"offset":4876}}},{"type":"text","value":" chứa địa chỉ bộ nhớ của dữ liệu Clock được ghi vào, không phải là giá trị của slot. Vì lý do này, chúng ta tiếp tục tải giá trị slot thực tế bằng cách sử dụng ","position":{"start":{"line":82,"column":55,"offset":4876},"end":{"line":82,"column":215,"offset":5036}}},{"type":"inlineCode","value":"ldxdw r1, [r1+0x0000]","position":{"start":{"line":82,"column":215,"offset":5036},"end":{"line":82,"column":238,"offset":5059}}},{"type":"text","value":".","position":{"start":{"line":82,"column":238,"offset":5059},"end":{"line":82,"column":239,"offset":5060}}}],"position":{"start":{"line":82,"column":1,"offset":4822},"end":{"line":82,"column":239,"offset":5060}}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Logic so sánh thời gian","position":{"start":{"line":84,"column":17,"offset":5080},"end":{"line":84,"column":47,"offset":5110}}},{"type":"mdxJsxAttribute","name":"id","value":"temporal-comparison-logic","position":{"start":{"line":84,"column":48,"offset":5111},"end":{"line":84,"column":78,"offset":5141}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":84,"column":79,"offset":5142},"end":{"line":84,"column":89,"offset":5152}}}],"children":[],"position":{"start":{"line":84,"column":1,"offset":5064},"end":{"line":84,"column":92,"offset":5155}}},{"type":"code","lang":"sbpf","meta":null,"value":"jle r1, r2, end    // If current slot <= max slot, success\r\nlddw r0, 1         // Otherwise, set error code","position":{"start":{"line":86,"column":1,"offset":5159},"end":{"line":89,"column":4,"offset":5280}},"data":{"highlightId":"code-3"}},{"type":"paragraph","children":[{"type":"text","value":"Logic chính của chúng ta là một lệnh nhảy:","position":{"start":{"line":91,"column":1,"offset":5284},"end":{"line":91,"column":43,"offset":5326}}}],"position":{"start":{"line":91,"column":1,"offset":5284},"end":{"line":91,"column":43,"offset":5326}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Temporal validation: lệnh ","position":{"start":{"line":92,"column":3,"offset":5330},"end":{"line":92,"column":29,"offset":5356}}},{"type":"inlineCode","value":"jle","position":{"start":{"line":92,"column":29,"offset":5356},"end":{"line":92,"column":34,"offset":5361}}},{"type":"text","value":" (jump if less or equal) (nhảy nếu nhỏ hơn hoặc bằng) so sánh slot hiện tại ở thanh ghi (","position":{"start":{"line":92,"column":34,"offset":5361},"end":{"line":92,"column":123,"offset":5450}}},{"type":"inlineCode","value":"r1","position":{"start":{"line":92,"column":123,"offset":5450},"end":{"line":92,"column":127,"offset":5454}}},{"type":"text","value":") với deadline của chúng ta ở thanh ghi (","position":{"start":{"line":92,"column":127,"offset":5454},"end":{"line":92,"column":168,"offset":5495}}},{"type":"inlineCode","value":"r2","position":{"start":{"line":92,"column":168,"offset":5495},"end":{"line":92,"column":172,"offset":5499}}},{"type":"text","value":"). Nếu chúng ta còn trong cửa sổ thời gian, chúng ta nhảy đến nhãn ","position":{"start":{"line":92,"column":172,"offset":5499},"end":{"line":92,"column":239,"offset":5566}}},{"type":"inlineCode","value":"end","position":{"start":{"line":92,"column":239,"offset":5566},"end":{"line":92,"column":244,"offset":5571}}},{"type":"text","value":".","position":{"start":{"line":92,"column":244,"offset":5571},"end":{"line":92,"column":245,"offset":5572}}}],"position":{"start":{"line":92,"column":3,"offset":5330},"end":{"line":92,"column":245,"offset":5572}}}],"position":{"start":{"line":92,"column":1,"offset":5328},"end":{"line":92,"column":245,"offset":5572}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Timeout handling: Nếu deadline đã qua, thực thi tiếp tục (","position":{"start":{"line":93,"column":3,"offset":5576},"end":{"line":93,"column":61,"offset":5634}}},{"type":"inlineCode","value":"lddw","position":{"start":{"line":93,"column":61,"offset":5634},"end":{"line":93,"column":67,"offset":5640}}},{"type":"text","value":") để tải mã lỗi 1 vào thanh ghi ","position":{"start":{"line":93,"column":67,"offset":5640},"end":{"line":93,"column":99,"offset":5672}}},{"type":"inlineCode","value":"r0","position":{"start":{"line":93,"column":99,"offset":5672},"end":{"line":93,"column":103,"offset":5676}}},{"type":"text","value":" để trả về lỗi.","position":{"start":{"line":93,"column":103,"offset":5676},"end":{"line":93,"column":118,"offset":5691}}}],"position":{"start":{"line":93,"column":3,"offset":5576},"end":{"line":93,"column":118,"offset":5691}}}],"position":{"start":{"line":93,"column":1,"offset":5574},"end":{"line":93,"column":118,"offset":5691}}}],"position":{"start":{"line":92,"column":1,"offset":5328},"end":{"line":93,"column":118,"offset":5691}}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Kết luận","position":{"start":{"line":95,"column":17,"offset":5711},"end":{"line":95,"column":32,"offset":5726}}},{"type":"mdxJsxAttribute","name":"id","value":"conclusion","position":{"start":{"line":95,"column":33,"offset":5727},"end":{"line":95,"column":48,"offset":5742}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":95,"column":49,"offset":5743},"end":{"line":95,"column":59,"offset":5753}}}],"children":[],"position":{"start":{"line":95,"column":1,"offset":5695},"end":{"line":95,"column":62,"offset":5756}}},{"type":"paragraph","children":[{"type":"text","value":"Chương trình này thực hiện kiểm tra thời gian với chi phí tính toán cực kỳ thấp.","position":{"start":{"line":97,"column":1,"offset":5760},"end":{"line":97,"column":81,"offset":5840}}}],"position":{"start":{"line":97,"column":1,"offset":5760},"end":{"line":97,"column":81,"offset":5840}}},{"type":"paragraph","children":[{"type":"text","value":"Sự đánh đổi ở đây là phải hiểu các giao diện syscall, quản lý ngăn xếp, và bố cục nhị phân của biến hệ thống ","position":{"start":{"line":99,"column":1,"offset":5844},"end":{"line":99,"column":110,"offset":5953}}},{"type":"inlineCode","value":"Clock","position":{"start":{"line":99,"column":110,"offset":5953},"end":{"line":99,"column":117,"offset":5960}}},{"type":"text","value":". Nhưng đối với các xác minh thời gian quan trọng về hiệu suất, assembly cung cấp nó một cách hiệu quả mà không có gì so sánh được.","position":{"start":{"line":99,"column":117,"offset":5960},"end":{"line":99,"column":248,"offset":6091}}}],"position":{"start":{"line":99,"column":1,"offset":5844},"end":{"line":99,"column":248,"offset":6091}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":99,"column":248,"offset":6091}}},"raw":"import ArticleSection from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Assembly Timeout\r\n\r\n![Assembly Timeout Challenge](/graphics/challenge-banners/assembly-timeout.png)\r\n\r\nTrong bài học này, chúng ta sẽ sử dụng sBPF Assembly để tạo một instruction kiểm tra dựa trên thời gian để đảm bảo rằng một giao dịch chỉ được thực hiện trước một thời điểm nhất định. \r\n\r\nBằng cách chèn instruction này vào trong giao dịch của bạn, bạn sẽ tạo ra một cơ chế an toàn để ngăn chặn việc thực hiện giao dịch sau một thời điểm nhất định, bảo vệ trước trường hợp thực hiện giao dịch bị trễ hoặc phát lại các lệnh cũ.\r\n\r\nMột số lý do khiến kiểm tra timeout trở thành một ứng cử viên lý tưởng cho assembly:\r\n- Các trường hợp đơn hoặc bị ràng buộc\r\n- Sử dụng hiệu quả các biến hệ thống\r\n- Không cần thực hiện các kiểm tra signer/account\r\n- Chỉ cần cải thiện tính bảo mật\r\n\r\nNếu bạn không quen thuộc với việc viết chương trình assembly, bạn nên bắt đầu bằng cách đọc bài [Giới thiệu về Assembly](/vi/courses/introduction-to-assembly).\r\n\r\n<ArticleSection name=\"Thiết kế chương trình\" id=\"program-design\" level=\"h2\" />\r\n\r\nChương trình của chúng ta sẽ triển khai việc kiểm tra một hoạt động quan trọng: xác minh rằng slot hiện tại không vượt quá một deadline nhất định. Mô hình này rất cần thiết cho các hoạt động DeFi nhạy cảm với thời gian - từ việc ngăn chặn các nỗ lực sử dụng chênh lệnh giá cũ đến việc thực thi thời hạn của một đấu giá.\r\n\r\nChương trình của chúng ta sẽ cần:\r\n- Một số 8-byte thể hiện độ cao slot-height trong dữ liệu instruction.\r\n- Truy cập vào biến hệ thống Clock của Solana thông qua `sol_get_clock_sysvar`.\r\n- Trả về thành công nếu slot hiện tại ≤ slot tối đa, ngược lại trả về lỗi.\r\n\r\n<ArticleSection name=\"Độ lệch bộ nhớ\" id=\"memory-offsets\" level=\"h2\" />\r\n\r\nChương trình sBPF nhận dữ liệu tài khoản dưới dạng các vùng nhớ liên tục. Các hằng số này xác định các độ lệch byte\r\n\r\nVì chương trình của chúng ta không nhận bất kỳ tài khoản nào, chúng ta có thể tính toán vị trí của `MAX_SLOT_HEIGHT` (được truyền trong dữ liệu của instruction). Chúng ta cũng sẽ lưu trữ dữ liệu của biến hệ thống `Clock` trên stack, vì lý do này `CURRENT_SLOT_HEIGHT` sẽ là số âm.\r\n\r\nCác hằng số định nghĩa bố cục bộ nhớ của chúng ta như sau: \r\n\r\n```sbpf\r\n.equ NUM_ACCOUNTS, 0x0000\r\n.equ MAX_SLOT_HEIGHT, 0x0010\r\n.equ CURRENT_SLOT_HEIGHT, -0x0028\r\n```\r\n\r\n- `NUM_ACCOUNTS` (0x0000): Trỏ đến số lượng tài khoản trong header của dữ liệu instruction để xác thực.\r\n- `MAX_SLOT_HEIGHT` (0x0010): Xác định vị trí của 8-byte slot-height tối đa trong dữ liệu của instruction.\r\n- `CURRENT_SLOT_HEIGHT` (-0x0028): Xác định độ lệch stack của trường dữ liệu slot được lưu trong Clock sysvar. Vì slot là trường đầu tiên trong cấu trúc Clock, độ lệch này trỏ trực tiếp đến nó.\r\n\r\nKhông giống như những ngôn ngữ bậc cao khác trừu tượng hóa bố cục bộ nhớ, assembly yêu cầu bạn phải biết chính xác vị trí của từng dữ liệu. \r\n\r\n<ArticleSection name=\"Điểm đầu vào và Xác thực ban đầu\" id=\"entrypoint-and-validations\" level=\"h2\" />\r\n\r\n```sbpf\r\n.globl entrypoint\r\nentrypoint:\r\n  ldxdw r0, [r1+NUM_ACCOUNTS]       // Veto if any accounts are included\r\n  ldxdw r2, [r1+MAX_SLOT_HEIGHT]    // Store target slot height\r\n```\r\n\r\nMỗi chương trình sBPF bắt đầu bởi một ký hiệu toàn cục `.entrypoint`. Runtime Solana cung cấp các tài khoản và dữ liệu instruction thông qua thanh ghi `r1`.\r\n\r\ninstruction `ldxdw` tải lên (`ldx`) một giá trị 8-byte (double word, `dw`) từ bộ nhớ vào thanh ghi. Đây là những gì xảy ra:\r\n- `ldxdw r0, [r1+NUM_ACCOUNTS]`: tải số lượng tài khoản vào `r0`. Vì `r0` là thanh ghi mà máy ảo đọc khi thoát, bất kỳ giá trị khác không phải 0 sẽ tự động làm thất bại chương trình (chính xác như chúng ta muốn nếu có tài khoản được truyền).\r\n- `ldxdw r2, [r1+MAX_SLOT_HEIGHT]`: trỏ đến slot-height tối đa được truyền trong dữ liệu của instruction. Giá trị 64-bit này được lưu trong `r2`.\r\n\r\nCả 2 hành động đều là zero-copy: chúng ta đang đọc trực tiếp từ dữ liệu tài khoản mà không cần deserialize.\r\n\r\n<ArticleSection name=\"Clock Sysvar\" id=\"the-clock-sysvar\" level=\"h2\" />\r\n\r\n```sbpf\r\nmov64 r1, r10\r\nadd64 r1, CURRENT_SLOT_HEIGHT\r\ncall sol_get_clock_sysvar\r\nldxdw r1, [r1+0x0000]\r\n```\r\n\r\nViệc gọi `sol_get_clock_sysvar` syscall sẽ ghi dữ liệu `Clock` hiện tại vào địa chỉ ô nhớ được chỉ định trong `r1`.\r\n\r\nBởi vì cấu trúc của Clock là 40 bytes (nó quá lớn cho các thanh ghi chỉ có thể lưu trữ 8 byte mỗi lần), chúng ta sử dụng stack cho việc lưu trữ nhanh chóng, không cần cấp phát và được dọn dẹp tự động.\r\n\r\nBởi vì thanh ghi `r10` là chỉ đọc, để hoạt động trên stack, chúng ta cần sao chép địa chỉ bộ nhớ của nó vào một thanh ghi: `mov64 r1, r10`\r\n\r\nSau đó chúng ta thêm `CURRENT_SLOT_HEIGHT` (-0x0028) vào thanh ghi `r1`. Bởi vì hằng số này là số âm, nó thực tế là phép trừ: `r1 = r10 - 40 bytes`, cấp phát 40 bytes trên stack.\r\n\r\nSau khi gọi hàm `sol_get_clock_sysvar`, thanh ghi `r1` chứa địa chỉ bộ nhớ của dữ liệu Clock được ghi vào, không phải là giá trị của slot. Vì lý do này, chúng ta tiếp tục tải giá trị slot thực tế bằng cách sử dụng `ldxdw r1, [r1+0x0000]`.\r\n\r\n<ArticleSection name=\"Logic so sánh thời gian\" id=\"temporal-comparison-logic\" level=\"h2\" />\r\n\r\n```sbpf\r\njle r1, r2, end    // If current slot <= max slot, success\r\nlddw r0, 1         // Otherwise, set error code\r\n```\r\n\r\nLogic chính của chúng ta là một lệnh nhảy:\r\n- Temporal validation: lệnh `jle` (jump if less or equal) (nhảy nếu nhỏ hơn hoặc bằng) so sánh slot hiện tại ở thanh ghi (`r1`) với deadline của chúng ta ở thanh ghi (`r2`). Nếu chúng ta còn trong cửa sổ thời gian, chúng ta nhảy đến nhãn `end`.\r\n- Timeout handling: Nếu deadline đã qua, thực thi tiếp tục (`lddw`) để tải mã lỗi 1 vào thanh ghi `r0` để trả về lỗi.\r\n\r\n<ArticleSection name=\"Kết luận\" id=\"conclusion\" level=\"h2\" />\r\n\r\nChương trình này thực hiện kiểm tra thời gian với chi phí tính toán cực kỳ thấp.\r\n\r\nSự đánh đổi ở đây là phải hiểu các giao diện syscall, quản lý ngăn xếp, và bố cục nhị phân của biến hệ thống `Clock`. Nhưng đối với các xác minh thời gian quan trọng về hiệu suất, assembly cung cấp nó một cách hiệu quả mà không có gì so sánh được.","highlightedCode":{"code-0":{"lang":"sbpf","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":".equ NUM_ACCOUNTS, "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F1FA8C"},"children":[{"type":"text","value":"0x0000"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":".equ MAX_SLOT_HEIGHT, "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F1FA8C"},"children":[{"type":"text","value":"0x0010"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":".equ CURRENT_SLOT_HEIGHT, -"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F1FA8C"},"children":[{"type":"text","value":"0x0028"}]}]}]}]}]}},"code-1":{"lang":"sbpf","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#FF79C6"},"children":[{"type":"text","value":".globl"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" entrypoint"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#8BE9FD;font-weight:bold"},"children":[{"type":"text","value":"entrypoint:"}]}]},{"type":"text","val