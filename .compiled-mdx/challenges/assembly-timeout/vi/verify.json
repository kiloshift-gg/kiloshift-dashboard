:1675}}}],"position":{"start":{"line":29,"column":5,"offset":1592},"end":{"line":29,"column":89,"offset":1676}}}],"position":{"start":{"line":28,"column":3,"offset":1535},"end":{"line":30,"column":17,"offset":1694}}},{"type":"mdxJsxFlowElement","name":"Requirement","attributes":[{"type":"mdxJsxAttribute","name":"title","value":"Thử thách 2: Kiểm thử trường hợp thất bại của Timeout","position":{"start":{"line":32,"column":16,"offset":1713},"end":{"line":32,"column":77,"offset":1774}}}],"children":[{"type":"paragraph","children":[{"type":"text","value":"Chương trình của bạn nên thất bại khi slot được truyền vào nhỏ hơn slot hiện tại.","position":{"start":{"line":33,"column":5,"offset":1781},"end":{"line":33,"column":86,"offset":1862}}}],"position":{"start":{"line":33,"column":5,"offset":1781},"end":{"line":33,"column":86,"offset":1862}}}],"position":{"start":{"line":32,"column":3,"offset":1700},"end":{"line":34,"column":17,"offset":1880}}}],"position":{"start":{"line":27,"column":1,"offset":1514},"end":{"line":35,"column":19,"offset":1900}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":35,"column":19,"offset":1900}}},"raw":"import { ChallengeTitle } from \"../../../../components/Challenges/ChallengeTitle\";\r\nimport { RequirementList } from \"../../../../components/Challenges/RequirementList\";\r\nimport { Requirement } from \"../../../../components/Challenges/Requirement\";\r\n\r\n<ChallengeTitle>sBPF Assembly Timeout</ChallengeTitle>\r\n\r\nBây giờ khi bạn đã bắt đầu cảm thấy thoải mái khi viết Assembly, thay vì sử dụng syscall `sol_get_clock_sysvar`, hãy cố gắng đạt được cùng một mục tiêu bằng cách chuyển tài khoản `Clock` vào làm một trong các tài khoản của instruction.\r\n\r\nTạo một chương trình chỉ có 1 instruction. Nó phải:\r\n- Nhận vào một tài khoản `Clock` (kích thước 40 byte).\r\n- Nhận vào một số lượng tối đa ở dạng 8-byte trong dữ liệu instruction.\r\n- Sử dụng 8 byte đầu tiên của tài khoản `Clock` để lấy slot hiện tại.\r\n- Kiểm tra xem slot hiện tại có lớn hơn số lượng tối đa được truyền trong dữ liệu instruction hay không. Nếu có, trả về mã lỗi 1.\r\n\r\n> Để lấy đúng độ lệch dữ liệu instruction, bạn có thể sử dụng công cụ của chúng tôi tại [sbpf.xyz](https://sbpf.xyz). Nhớ thêm một tài khoản và đặt độ dài dữ liệu của nó là 40!\r\n\r\nHãy bắt đầu bằng cách cài đặt các gói công cụ sBPF như được mô tả trong phần [Công cụ](/vi/courses/introduction-to-assembly/tooling) của khóa học Giới thiệu về Assembly và build chương trình của bạn bằng lệnh sau trong terminal:\r\n\r\n```bash\r\nsbpf build\r\n```\r\n\r\nĐiều này sẽ tạo ra một file `.so` trong thư mục `target/deploy` của bạn.\r\n\r\nBây giờ hãy nhấp vào nút `take challenge` và thả file vào đó!\r\n\r\n<RequirementList>\r\n  <Requirement title=\"Thử thách 1: Kiểm thử Timeout\">\r\n    Chương trình của bạn nên thành công khi slot được truyền vào lớn hơn slot hiện tại. \r\n  </Requirement>\r\n\r\n  <Requirement title=\"Thử thách 2: Kiểm thử trường hợp thất bại của Timeout\">\r\n    Chương trình của bạn nên thất bại khi slot được truyền vào nhỏ hơn slot hiện tại.\r\n  </Requirement>\r\n</RequirementList>","highlightedCode":{}}