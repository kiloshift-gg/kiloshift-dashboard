he memory address where Clock data was written, not the slot value itself. For this reason we proceed to load the actual slot value using ","position":{"start":{"line":82,"column":56,"offset":4449},"end":{"line":82,"column":205,"offset":4598}}},{"type":"inlineCode","value":"ldxdw r1, [r1+0x0000]","position":{"start":{"line":82,"column":205,"offset":4598},"end":{"line":82,"column":228,"offset":4621}}},{"type":"text","value":".","position":{"start":{"line":82,"column":228,"offset":4621},"end":{"line":82,"column":229,"offset":4622}}}],"position":{"start":{"line":82,"column":1,"offset":4394},"end":{"line":82,"column":229,"offset":4622}}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Temporal Comparison Logic","position":{"start":{"line":84,"column":17,"offset":4642},"end":{"line":84,"column":49,"offset":4674}}},{"type":"mdxJsxAttribute","name":"id","value":"temporal-comparison-logic","position":{"start":{"line":84,"column":50,"offset":4675},"end":{"line":84,"column":80,"offset":4705}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":84,"column":81,"offset":4706},"end":{"line":84,"column":91,"offset":4716}}}],"children":[],"position":{"start":{"line":84,"column":1,"offset":4626},"end":{"line":84,"column":94,"offset":4719}}},{"type":"code","lang":"sbpf","meta":null,"value":"jle r1, r2, end    // If current slot <= max slot, success\r\nlddw r0, 1         // Otherwise, set error code","position":{"start":{"line":86,"column":1,"offset":4723},"end":{"line":89,"column":4,"offset":4844}},"data":{"highlightId":"code-3"}},{"type":"paragraph","children":[{"type":"text","value":"The core timeout logic uses a single conditional jump:","position":{"start":{"line":91,"column":1,"offset":4848},"end":{"line":91,"column":55,"offset":4902}}}],"position":{"start":{"line":91,"column":1,"offset":4848},"end":{"line":91,"column":55,"offset":4902}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Temporal validation: ","position":{"start":{"line":92,"column":3,"offset":4906},"end":{"line":92,"column":24,"offset":4927}}},{"type":"inlineCode","value":"jle","position":{"start":{"line":92,"column":24,"offset":4927},"end":{"line":92,"column":29,"offset":4932}}},{"type":"text","value":" (jump if less or equal) compares current slot (","position":{"start":{"line":92,"column":29,"offset":4932},"end":{"line":92,"column":77,"offset":4980}}},{"type":"inlineCode","value":"r1","position":{"start":{"line":92,"column":77,"offset":4980},"end":{"line":92,"column":81,"offset":4984}}},{"type":"text","value":") against our deadline (","position":{"start":{"line":92,"column":81,"offset":4984},"end":{"line":92,"column":105,"offset":5008}}},{"type":"inlineCode","value":"r2","position":{"start":{"line":92,"column":105,"offset":5008},"end":{"line":92,"column":109,"offset":5012}}},{"type":"text","value":"). If we're within the time window, jump to ","position":{"start":{"line":92,"column":109,"offset":5012},"end":{"line":92,"column":153,"offset":5056}}},{"type":"inlineCode","value":"exit","position":{"start":{"line":92,"column":153,"offset":5056},"end":{"line":92,"column":159,"offset":5062}}}],"position":{"start":{"line":92,"column":3,"offset":4906},"end":{"line":92,"column":159,"offset":5062}}}],"position":{"start":{"line":92,"column":1,"offset":4904},"end":{"line":92,"column":159,"offset":5062}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Timeout handling: If the deadline has passed, execution continues to load (","position":{"start":{"line":93,"column":3,"offset":5066},"end":{"line":93,"column":78,"offset":5141}}},{"type":"inlineCode","value":"lddw","position":{"start":{"line":93,"column":78,"offset":5141},"end":{"line":93,"column":84,"offset":5147}}},{"type":"text","value":") error code 1 into return register ","position":{"start":{"line":93,"column":84,"offset":5147},"end":{"line":93,"column":120,"offset":5183}}},{"type":"inlineCode","value":"r0","position":{"start":{"line":93,"column":120,"offset":5183},"end":{"line":93,"column":124,"offset":5187}}}],"position":{"start":{"line":93,"column":3,"offset":5066},"end":{"line":93,"column":124,"offset":5187}}}],"position":{"start":{"line":93,"column":1,"offset":5064},"end":{"line":93,"column":124,"offset":5187}}}],"position":{"start":{"line":92,"column":1,"offset":4904},"end":{"line":93,"column":124,"offset":5187}}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Conclusion","position":{"start":{"line":95,"column":17,"offset":5207},"end":{"line":95,"column":34,"offset":5224}}},{"type":"mdxJsxAttribute","name":"id","value":"conclusion","position":{"start":{"line":95,"column":35,"offset":5225},"end":{"line":95,"column":50,"offset":5240}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":95,"column":51,"offset":5241},"end":{"line":95,"column":61,"offset":5251}}}],"children":[],"position":{"start":{"line":95,"column":1,"offset":5191},"end":{"line":95,"column":64,"offset":5254}}},{"type":"paragraph","children":[{"type":"text","value":"This compact program accomplishes temporal validation with minimal compute unit consumption.","position":{"start":{"line":97,"column":1,"offset":5258},"end":{"line":97,"column":93,"offset":5350}}}],"position":{"start":{"line":97,"column":1,"offset":5258},"end":{"line":97,"column":93,"offset":5350}}},{"type":"paragraph","children":[{"type":"text","value":"The trade-off is understanding syscall interfaces, stack management, and the ","position":{"start":{"line":99,"column":1,"offset":5354},"end":{"line":99,"column":78,"offset":5431}}},{"type":"inlineCode","value":"Clock","position":{"start":{"line":99,"column":78,"offset":5431},"end":{"line":99,"column":85,"offset":5438}}},{"type":"text","value":" sysvar's binary layout. But for performance-critical temporal validations, assembly provides unmatched efficiency.","position":{"start":{"line":99,"column":85,"offset":5438},"end":{"line":99,"column":200,"offset":5553}}}],"position":{"start":{"line":99,"column":1,"offset":5354},"end":{"line":99,"column":200,"offset":5553}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":99,"column":200,"offset":5553}}},"raw":"import ArticleSection from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Assembly Timeout\r\n\r\n![Assembly Timeout Challenge](/graphics/challenge-banners/assembly-timeout.png)\r\n\r\nIn this unit we'll use sBPF Assembly to create a time-based validation instruction that enforces slot-height deadlines.\r\n\r\nBy including this instruction in your transaction, you create a fail-safe mechanism that prevents execution after a specified blockchain time, protecting against delayed transaction execution or stale instruction replays.\r\n\r\nSeveral properties make timeout checks ideal for assembly:\r\n- Single, constrained use case\r\n- Efficient leverage of system variables\r\n- No complex account validation required\r\n- Only improves transaction safety\r\n\r\nIf you're unfamiliar with assembly programming, follow the [introduction to Assembly course](/en/courses/introduction-to-assembly)\r\n\r\n<ArticleSection name=\"Program Design\" id=\"program-design\" level=\"h2\" />\r\n\r\nOur program implements a crucial temporal operation: validating that the current blockchain slot height hasn't exceeded a predetermined deadline. This pattern is essential for time-sensitive DeFi operations—from preventing stale arbitrage attempts to enforcing auction deadlines.\r\n\r\nThe program expects:\r\n- An 8-byte maximum slot height in the instruction data.\r\n- Access to Solana's Clock sysvar through `sol_get_clock_sysvar`.\r\n- Returns success if current slot ≤ max slot, error otherwise.\r\n\r\n<ArticleSection name=\"Memory Offsets\" id=\"memory-offsets\" level=\"h2\" />\r\n\r\nsBPF programs receive account data as contiguous memory regions. These constants define byte offsets within that memory.\r\n\r\nSince our program accepts zero accounts, we can calculate where `MAX_SLOT_HEIGHT` (passed as instruction data) will be located. We'll also store the `Clock` sysvar data on the stack, for this reason the `CURRENT_SLOT_HEIGHT` will be negative.\r\n\r\nThese constants define our memory layout:   \r\n\r\n```sbpf\r\n.equ NUM_ACCOUNTS, 0x0000\r\n.equ MAX_SLOT_HEIGHT, 0x0010\r\n.equ CURRENT_SLOT_HEIGHT, -0x0028\r\n```\r\n\r\n- `NUM_ACCOUNTS` (0x0000): Points to the account count in the instruction data header for validation\r\n- `MAX_SLOT_HEIGHT` (0x0010): Locates the 8-byte deadline slot height within the instruction data payload\r\n- `CURRENT_SLOT_HEIGHT` (-0x0028): Stack offset where the Clock sysvar's slot field will be stored. Since slot is the first field in the Clock structure, this offset points directly to it\r\n\r\nUnlike high-level languages that abstract memory layout, assembly requires knowing exactly where every piece of data lives.\r\n\r\n<ArticleSection name=\"Entrypoint and Initial Validation\" id=\"entrypoint-and-validations\" level=\"h2\" />\r\n\r\n```sbpf\r\n.globl entrypoint\r\nentrypoint:\r\n  ldxdw r0, [r1+NUM_ACCOUNTS]       // Veto if any accounts are included\r\n  ldxdw r2, [r1+MAX_SLOT_HEIGHT]    // Store target slot height\r\n```\r\n\r\nEvery sBPF program starts at a global `.entrypoint` symbol. The Solana runtime provides account and instruction data through register `r1`.\r\n\r\nThe `ldxdw` instruction loads (`ldx`) an 8-byte (double word, `dx`) value from memory into a register. Here's what happens:\r\n- `ldxdw r0, [r1+NUM_ACCOUNTS]`: loads the account count into `r0`. Since `r0` is the register the VM reads on exit, any non-zero value automatically fails the program (exactly what we want if accounts are passed).\r\n- `ldxdw r2, [r1+MAX_SLOT_HEIGHT]`: points to the maximum allowed slot height that we passed in the instruction data. This 64-bit value lands in `r2`.\r\n\r\nBoth operations are zero-copy: we're reading directly from the account data without deserialization overhead.\r\n\r\n<ArticleSection name=\"The Clock Sysvar\" id=\"the-clock-sysvar\" level=\"h2\" />\r\n\r\n```sbpf\r\nmov64 r1, r10\r\nadd64 r1, CURRENT_SLOT_HEIGHT\r\ncall sol_get_clock_sysvar\r\nldxdw r1, [r1+0x0000]\r\n```\r\n\r\nThe `sol_get_clock_sysvar` syscall writes current `Clock` data to the memory address specified in `r1`.\r\n\r\nSince the Clock structure is 40 bytes (too large for registers that hold only 8 bytes each), we use the stack for fast, allocation-free storage with automatic cleanup.\r\n\r\nSince `r10` is read-only, to operate on the stack we need to copy its memory address into a registrar: `mov64 r1, r10`\r\n\r\nThen we add `CURRENT_SLOT_HEIGHT` (-0x0028) to `r1`. Since this constant is negative, it's actually subtraction: `r1 = r10 - 40 bytes`, allocating 40 bytes on the stack.\r\n\r\nAfter calling the `sol_get_clock_sysvar` function, `r1` contains the memory address where Clock data was written, not the slot value itself. For this reason we proceed to load the actual slot value using `ldxdw r1, [r1+0x0000]`.\r\n\r\n<ArticleSection name=\"Temporal Comparison Logic\" id=\"temporal-comparison-logic\" level=\"h2\" />\r\n\r\n```sbpf\r\njle r1, r2, end    // If current slot <= max slot, success\r\nlddw r0, 1         // Otherwise, set error code\r\n```\r\n\r\nThe core timeout logic uses a single conditional jump:\r\n- Temporal validation: `jle` (jump if less or equal) compares current slot (`r1`) against our deadline (`r2`). If we're within the time window, jump to `exit`\r\n- Timeout handling: If the deadline has passed, execution continues to load (`lddw`) error code 1 into return register `r0`\r\n\r\n<ArticleSection name=\"Conclusion\" id=\"conclusion\" level=\"h2\" />\r\n\r\nThis compact program accomplishes temporal validation with minimal compute unit consumption.\r\n\r\nThe trade-off is understanding syscall interfaces, stack management, and the `Clock` sysvar's binary layout. But for performance-critical temporal validations, assembly provides unmatched efficiency.","highlightedCode":{"code-0":{"lang":"sbpf","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":".equ NUM_ACCOUNTS, "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F1FA8C"},"children":[{"type":"text","value":"0x0000"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":".equ MAX_SLOT_HEIGHT, "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F1FA8C"},"children":[{"type":"text","value":"0x0010"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":".equ CURRENT_SLOT_HEIGHT, -"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F1FA8C"},"children":[{"type":"text","value":"0x0028"}]}]}]}]}]}},"code-1":{"lang":"sbpf","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","ta