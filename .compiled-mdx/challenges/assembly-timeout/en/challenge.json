properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"+MAX_SLOT_HEIGHT]    "}]},{"type":"element","tagName":"span","properties":{"style":"color:#7B7F8B"},"children":[{"type":"text","value":"// Store target slot height"}]}]}]}]}]}},"code-2":{"lang":"sbpf","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#FF79C6;font-weight:bold"},"children":[{"type":"text","value":"mov64"}]},{"type":"element","tagName":"span","properties":{"style":"color:#BD93F9"},"children":[{"type":"text","value":" r1"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":", "}]},{"type":"element","tagName":"span","properties":{"style":"color:#BD93F9"},"children":[{"type":"text","value":"r10"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#FF79C6;font-weight:bold"},"children":[{"type":"text","value":"add64"}]},{"type":"element","tagName":"span","properties":{"style":"color:#BD93F9"},"children":[{"type":"text","value":" r1"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":", CURRENT_SLOT_HEIGHT"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#FF79C6;font-weight:bold"},"children":[{"type":"text","value":"call"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" sol_get_clock_sysvar"}]}]},{"type":"text","value":"\n"},