ine":34,"column":17,"offset":1013}}}],"position":{"start":{"line":27,"column":1,"offset":826},"end":{"line":35,"column":19,"offset":1033}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":35,"column":19,"offset":1033}}},"raw":"import { ChallengeTitle } from \"../../../../components/Challenges/ChallengeTitle\";\r\nimport { RequirementList } from \"../../../../components/Challenges/RequirementList\";\r\nimport { Requirement } from \"../../../../components/Challenges/Requirement\";\r\n\r\n<ChallengeTitle>sBPF Assembly 超時</ChallengeTitle>\r\n\r\n現在你應該已經開始熟悉撰寫 Assembly，嘗試通過傳入 `Clock` 帳戶來實現相同的目標，而不是使用 `sol_get_clock_sysvar`。\r\n\r\n創建一個只有一個指令的程式。它必須：\r\n- 接收 `Clock` 帳戶（大小為 40）。\r\n- 接收指令數據中的一個 u64（8 字節）槽位。\r\n- 使用 `Clock` 帳戶的前 8 字節來獲取當前槽位。\r\n- 檢查當前槽位是否大於指令中傳遞的槽位。如果是，則返回錯誤代碼 1。\r\n\r\n> 要獲取正確的指令數據偏移量，你可以使用我們的 [工具](https://sbpf.xyz)。只需記住添加一個帳戶並將其數據長度設置為 40！\r\n\r\n首先按照 Assembly 入門課程 [工具部分](/zh-HK/courses/introduction-to-assembly/tooling) 中的說明安裝 sBPF 套件，然後在終端中使用以下命令構建你的程式：\r\n\r\n```\r\nsbpf build\r\n```\r\n\r\n這將在你的 `target/deploy` 資料夾中生成一個 `.so` 文件。\r\n\r\n現在點擊 `take challenge` 按鈕，然後將文件拖放到那裡！\r\n\r\n<RequirementList>\r\n  <Requirement title=\"挑戰 1：測試超時\">\r\n    當傳遞的槽位高於當前槽位時，你的程式應該成功執行。\r\n  </Requirement>\r\n\r\n  <Requirement title=\"挑戰 2：測試超時失敗\">\r\n    當傳遞的槽位低於當前槽位時，你的程式應該失敗。\r\n  </Requirement>\r\n</RequirementList>","highlightedCode":{"code-0":{"lang":"text","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{},"children":[{"type":"text","value":"sbpf build"}]}]}]}]}]}}}}