l to the borrower\r\ntransfer(\r\n    CpiContext::new(ctx.accounts.token_program.to_account_info(), Transfer {\r\n        from: ctx.accounts.borrower_ata.to_account_info(),\r\n        to: ctx.accounts.protocol_ata.to_account_info(),\r\n        authority: ctx.accounts.borrower.to_account_info(),\r\n    }), \r\n    amount_borrowed\r\n)?;","position":{"start":{"line":33,"column":1,"offset":904},"end":{"line":47,"column":4,"offset":1575}},"data":{"highlightId":"code-1"}},{"type":"paragraph","children":[{"type":"text","value":"我們的費用固定為500個基點，並執行“檢查”數學以確保金額不會溢出，避免因非常大的數字而被利用。此外，我們將金額轉換為 ","position":{"start":{"line":49,"column":1,"offset":1579},"end":{"line":49,"column":61,"offset":1639}}},{"type":"inlineCode","value":"u128","position":{"start":{"line":49,"column":61,"offset":1639},"end":{"line":49,"column":67,"offset":1645}}},{"type":"text","value":" 進行乘法以防止中間溢出，然後安全地轉回 ","position":{"start":{"line":49,"column":67,"offset":1645},"end":{"line":49,"column":88,"offset":1666}}},{"type":"inlineCode","value":"u64","position":{"start":{"line":49,"column":88,"offset":1666},"end":{"line":49,"column":93,"offset":1671}}},{"type":"text","value":"。","position":{"start":{"line":49,"column":93,"offset":1671},"end":{"line":49,"column":94,"offset":1672}}}],"position":{"start":{"line":49,"column":1,"offset":1579},"end":{"line":49,"column":94,"offset":1672}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":49,"column":94,"offset":1672}}},"raw":"# 還款\r\n\r\n還款指令通過確保借入的資金連同適當的費用一併歸還，完成我們的閃電貸款週期。此指令執行兩個重要步驟：\r\n1. 提取貸款金額：使用指令內省從借款指令的數據中檢索原始 `amount_borrowed`\r\n2. 資金轉回：計算 `fee` 並將借款金額加上費用轉回協議\r\n\r\n<ArticleSection name=\"指令內省\" id=\"instruction-introspection\" level=\"h2\" />\r\n\r\n首先，我們需要檢查交易中的第一個指令以提取原始貸款金額：\r\n\r\n```rust\r\nlet ixs = ctx.accounts.instructions.to_account_info();\r\n\r\nlet mut amount_borrowed: u64;\r\n\r\nif let Ok(borrow_ix) = load_instruction_at_checked(0, &ixs) {\r\n    // Check the amount borrowed:\r\n    let mut borrowed_data: [u8;8] = [0u8;8];\r\n    borrowed_data.copy_from_slice(&borrow_ix.data[8..16]);\r\n    amount_borrowed = u64::from_le_bytes(borrowed_data)\r\n\r\n} else {\r\n    return Err(ProtocolError::MissingBorrowIx.into());\r\n}\r\n```\r\n\r\n> 我們不會檢查這是否是實際的 `borrow_ix`，因為對於協議來說，即使他們構造了一個“假”的指令也無關緊要；協議只需收到付款即可。同時，如果我們貸出了資金，我們知道這將是第一個指令，並且 `amount_borrowed` 會在那裡。\r\n\r\n<ArticleSection name=\"資金轉移\" id=\"transfer-funds\" level=\"h2\" />\r\n\r\n接下來，我們計算協議費用並將總金額轉回：\r\n\r\n```rust\r\n// Add the fee to the amount borrowed (In our case we hardcoded it to 500 basis point)\r\nlet fee = (amount_borrowed as u128).checked_mul(500).unwrap().checked_div(10_000).ok_or(ProtocolError::Overflow)? as u64;\r\namount_borrowed = amount_borrowed.checked_add(fee).ok_or(ProtocolError::Overflow)?;\r\n\r\n// Transfer the funds from the protocol to the borrower\r\ntransfer(\r\n    CpiContext::new(ctx.accounts.token_program.to_account_info(), Transfer {\r\n        from: ctx.accounts.borrower_ata.to_account_info(),\r\n        to: ctx.accounts.protocol_ata.to_account_info(),\r\n        authority: ctx.accounts.borrower.to_account_info(),\r\n    }), \r\n    amount_borrowed\r\n)?;\r\n```\r\n\r\n我們的費用固定為500個基點，並執行“檢查”數學以確保金額不會溢出，避免因非常大的數字而被利用。此外，我們將金額轉換為 `u128` 進行乘法以防止中間溢出，然後安全地轉回 `u64`。","highlightedCode":{"code-0":{"lang":"rust","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"let"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" ixs "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"="}]},{"type":"element","tagName":"sp