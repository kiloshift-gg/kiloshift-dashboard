;\r\n\r\nif let Ok(borrow_ix) = load_instruction_at_checked(0, &ixs) {\r\n    // Check the amount borrowed:\r\n    let mut borrowed_data: [u8;8] = [0u8;8];\r\n    borrowed_data.copy_from_slice(&borrow_ix.data[8..16]);\r\n    amount_borrowed = u64::from_le_bytes(borrowed_data)\r\n\r\n} else {\r\n    return Err(ProtocolError::MissingBorrowIx.into());\r\n}","position":{"start":{"line":11,"column":1,"offset":712},"end":{"line":25,"column":4,"offset":1147}},"data":{"highlightId":"code-0"}},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"Nous ne vérifions pas qu'il s'agit bien de la vraie ","position":{"start":{"line":27,"column":3,"offset":1153},"end":{"line":27,"column":55,"offset":1205}}},{"type":"inlineCode","value":"borrow_ix","position":{"start":{"line":27,"column":55,"offset":1205},"end":{"line":27,"column":66,"offset":1216}}},{"type":"text","value":" en utilisant l'ID du programme et le discriminateur car cela n'a pas d'importance si une personne construit une \"fausse\" instruction. C'est sans danger pour le protocole puisqu'il est juste payé. Par ailleurs, si nous avons prêté l'argent, nous savons qu'il s'agira de la première instruction et que le ","position":{"start":{"line":27,"column":66,"offset":1216},"end":{"line":27,"column":370,"offset":1520}}},{"type":"inlineCode","value":"amount_borrowed","position":{"start":{"line":27,"column":370,"offset":1520},"end":{"line":27,"column":387,"offset":1537}}},{"type":"text","value":" y figurera.","position":{"start":{"line":27,"column":387,"offset":1537},"end":{"line":27,"column":399,"offset":1549}}}],"position":{"start":{"line":27,"column":3,"offset":1153},"end":{"line":27,"column":399,"offset":1549}}}],"position":{"start":{"line":27,"column":1,"offset":1151},"end":{"line":27,"column":399,"offset":1549}}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Transfert de fonds","position":{"start":{"line":29,"column":17,"offset":1569},"end":{"line":29,"column":42,"offset":1594}}},{"type":"mdxJsxAttribute","name":"id","value":"transfer-funds","position":{"start":{"line":29,"column":43,"offset":1595},"end":{"line":29,"column":62,"offset":1614}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":29,"column":63,"offset":1615},"end":{"line":29,"column":73,"offset":1625}}}],"children":[],"position":{"start":{"line":29,"column":1,"offset":1553},"end":{"line":29,"column":76,"offset":1628}}},{"type":"paragraph","children":[{"type":"text","value":"Ensuite, nous calculons les frais de protocole et transférons le montant total :","position":{"start":{"line":31,"column":1,"offset":1632},"end":{"line":31,"column":81,"offset":1712}}}],"position":{"start":{"line":31,"column":1,"offset":1632},"end":{"line":31,"column":81,"offset":1712}}},{"type":"code","lang":"rust","meta":null,"value":"// Add the fee to the amount borrowed (In our case we hardcoded it to 500 basis point)\r\nlet fee = (amount_borrowed as u128).checked_mul(500).unwrap().checked_div(10_000).ok_or(ProtocolError::Overflow)? as u64;\r\namount_borrowed = amount_borrowed.checked_add(fee).ok_or(ProtocolError::Overflow)?;\r\n\r\n// Transfer the funds from the protocol to the borrower\r\ntransfer(\r\n    CpiContext::new(ctx.accounts.token_program.to_account_info(), Transfer {\r\n        from: ctx.accounts.borrower_ata.to_account_info(),\r\n        to: ctx.accounts.protocol_ata.to_account_info(),\r\n        authority: ctx.accounts.borrower.to_account_info(),\r\n    }), \r\n    amount_borrowed\r\n)?;","position":{"start":{"line":33,"column":1,"offset":1716},"end":{"line":47,"column":4,"offset":2387}},"data":{"highlightId":"code-1"}},{"type":"paragraph","children":[{"type":"text","value":"Notre commission est codée en dur à 500 points de base et nous effectuons des calculs \"vérifiés\" pour nous assurer que le montant ne dépasse pas, ce qui pourrait être exploité avec de très grands nombres. De plus, nous convertissons le montant en ","position":{"start":{"line":49,"column":1,"offset":2391},"end":{"line":49,"column":248,"offset":2638}}},{"type":"inlineCode","value":"u128","position":{"start":{"line":49,"column":248,"offset":2638},"end":{"line":49,"column":254,"offset":2644}}},{"type":"text","value":" pour la multiplication afin d'éviter un dépassement intermédiaire, puis nous repassons en toute sécurité en ","position":{"start":{"line":49,"column":254,"offset":2644},"end":{"line":49,"column":363,"offset":2753}}},{"type":"inlineCode","value":"u64","position":{"start":{"line":49,"column":363,"offset":2753},"end":{"line":49,"column":368,"offset":2758}}},{"type":"text","value":".","position":{"start":{"line":49,"column":368,"offset":2758},"end":{"line":49,"column":369,"offset":2759}}}],"position":{"start":{"line":49,"column":1,"offset":2391},"end":{"line":49,"column":369,"offset":2759}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":49,"column":369,"offset":2759}}},"raw":"# Repay\r\n\r\nL'instruction `repay` termine notre cycle de prêt flash en garantissant que les fonds empruntés sont remboursés avec les frais appropriés. Cette instruction effectue deux étapes essentielles :\r\n1. Extrait le montant du prêt : Utilise l'introspection des instructions pour récupérer le montant `amount_borrowed` initial à partir des données de l'instruction d'emprunt\r\n2. Retourne les fonds : Calcule les `fee` et transfère le montant emprunté plus les frais au protocole\r\n\r\n<ArticleSection name=\"Introspection des Instructions\" id=\"instruction-introspection\" level=\"h2\" />\r\n\r\nTout d'abord, nous devons examiner la première instruction de la transaction afin d'extraire le montant initial du prêt :\r\n\r\n```rust\r\nlet ixs = ctx.accounts.instructions.to_account_info();\r\n\r\nlet mut amount_borrowed: u64;\r\n\r\nif let Ok(borrow_ix) = load_instruction_at_checked(0, &ixs) {\r\n    // Check the amount borrowed:\r\n    let mut borrowed_data: [u8;8] = [0u8;8];\r\n    borrowed_data.copy_from_slice(&borrow_ix.data[8..16]);\r\n    amount_borrowed = u64::from_le_bytes(borrowed_data)\r\n\r\n} else {\r\n    return Err(ProtocolError::MissingBorrowIx.into());\r\n}\r\n```\r\n\r\n> Nous ne vérifions pas qu'il s'agit bien de la vraie `borrow_ix` en utilisant l'ID du programme et le discriminateur car cela n'a pas d'importance si une personne construit une \"fausse\" instruction. C'est sans danger pour le protocole puisqu'il est juste payé. Par ailleurs, si nous avons prêté l'argent, nous savons qu'il s'agira de la première instruction et que le `amount_borrowed` y figurera.\r\n\r\n<ArticleSection name=\"Transfert de fonds\" id=\"transfer-funds\" level=\"h2\" />\r\n\r\nEnsuite, nous calculons les frais de protocole et transférons le montant total :\r\n\r\n```rust\r\n// Add the fee to the amount borrowed (In our case we hardcoded it to 500 basis point)\r\nlet fee = (amount_borrowed as u128).checked_mul(500).unwrap().checked_div(10_000).ok_or(ProtocolError::Overflow)? as u64;\r\namount_borrowed = amount_borrowed.checked_add(fee).ok_or(ProtocolError::Overflow)?;\r\n\r\n// Transfer the funds from the protocol to the borrower\r\ntransfer(\r\n    CpiContext::new(ctx.accounts.token_program.to_account_info(), Transfer {\r\n        from: ctx.accounts.borrower_ata.to_account_info(),\r\n        to: ctx.accounts.protocol_ata.to_account_info(),\r\n        authority: ctx.accounts.borrower.to_account_info(),\r\n    }), \r\n    amount_borrowed\r\n)?;\r\n```\r\n\r\nNotre commission est codée en dur à 500 points de base et nous effectuons des calculs \"vérifiés\" pour nous assurer que le montant ne dépasse pas, ce qui pourrait être exploité avec de très grands nombres. De plus, nous convertissons le montant en `u128` pour la multiplication afin d'éviter un dépassement intermédiaire, puis nous repassons en toute sécurité en `u64`.","highlightedCode":{"code-0":{"lang":"rust","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"c