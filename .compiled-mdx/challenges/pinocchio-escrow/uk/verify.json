":{"line":15,"column":155,"offset":985}}},{"type":"inlineCode","value":"1","position":{"start":{"line":15,"column":155,"offset":985},"end":{"line":15,"column":158,"offset":988}}},{"type":"text","value":".","position":{"start":{"line":15,"column":158,"offset":988},"end":{"line":15,"column":159,"offset":989}}}],"position":{"start":{"line":15,"column":5,"offset":835},"end":{"line":15,"column":159,"offset":989}}}],"position":{"start":{"line":14,"column":3,"offset":768},"end":{"line":16,"column":17,"offset":1007}}},{"type":"mdxJsxFlowElement","name":"Requirement","attributes":[{"type":"mdxJsxAttribute","name":"title","value":"Завдання 3: Скасування пропозиції ескроу","position":{"start":{"line":18,"column":16,"offset":1026},"end":{"line":18,"column":64,"offset":1074}}}],"children":[{"type":"paragraph","children":[{"type":"text","value":"Ваша програма повинна дозволяти творцю скасовувати пропозицію ескроу та повертати депоновані кошти. Переконайтеся, що ваша інструкція визначена зі значенням дискримінатора інструкцій ","position":{"start":{"line":19,"column":5,"offset":1081},"end":{"line":19,"column":188,"offset":1264}}},{"type":"inlineCode","value":"2","position":{"start":{"line":19,"column":188,"offset":1264},"end":{"line":19,"column":191,"offset":1267}}},{"type":"text","value":".","position":{"start":{"line":19,"column":191,"offset":1267},"end":{"line":19,"column":192,"offset":1268}}}],"position":{"start":{"line":19,"column":5,"offset":1081},"end":{"line":19,"column":192,"offset":1268}}}],"position":{"start":{"line":18,"column":3,"offset":1013},"end":{"line":20,"column":17,"offset":1286}}}],"position":{"start":{"line":9,"column":1,"offset":499},"end":{"line":21,"column":19,"offset":1306}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":22,"column":1,"offset":1308}}},"raw":"import { ChallengeTitle } from \"../../../../components/Challenges/ChallengeTitle\";\r\nimport { RequirementList } from \"../../../../components/Challenges/RequirementList\";\r\nimport { Requirement } from \"../../../../components/Challenges/Requirement\";\r\n\r\n<ChallengeTitle>Ескроу Піноккіо</ChallengeTitle>\r\n\r\nНастав час перевірити те, що ви вивчили. Використовуючи знання, отримані з уроку, створіть програму умовного депонування (ескроу) за допомогою фреймворку Піноккіо, яка відповідає таким вимогам:\r\n\r\n<RequirementList>\r\n  <Requirement title=\"Завдання 1: Створення пропозиції ескроу\">\r\n    Ваша програма повинна дозволяти творцю створювати пропозицію ескроу. Визначте інструкцію для цього, використовуючи дискримінатор інструкцій зі значенням `0`.\r\n  </Requirement>\r\n\r\n  <Requirement title=\"Завдання 2: Прийняття пропозиції ескроу\">\r\n    Ваша програма повинна дозволяти приймачу приймати пропозицію ескроу. Визначте інструкцію для цього, використовуючи значення дискримінатора інструкцій `1`.\r\n  </Requirement>\r\n\r\n  <Requirement title=\"Завдання 3: Скасування пропозиції ескроу\">\r\n    Ваша програма повинна дозволяти творцю скасовувати пропозицію ескроу та повертати депоновані кошти. Переконайтеся, що ваша інструкція визначена зі значенням дискримінатора інструкцій `2`.\r\n  </Requirement>\r\n</RequirementList>\r\n","highlightedCode":{}}