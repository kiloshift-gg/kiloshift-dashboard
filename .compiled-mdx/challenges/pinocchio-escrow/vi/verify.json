set":955}}},{"type":"inlineCode","value":"1","position":{"start":{"line":15,"column":153,"offset":955},"end":{"line":15,"column":156,"offset":958}}},{"type":"text","value":".","position":{"start":{"line":15,"column":156,"offset":958},"end":{"line":15,"column":157,"offset":959}}}],"position":{"start":{"line":15,"column":5,"offset":807},"end":{"line":15,"column":157,"offset":959}}}],"position":{"start":{"line":14,"column":3,"offset":747},"end":{"line":16,"column":17,"offset":977}}},{"type":"mdxJsxFlowElement","name":"Requirement","attributes":[{"type":"mdxJsxAttribute","name":"title","value":"Thử thách 3: Hủy đề nghị escrow","position":{"start":{"line":18,"column":16,"offset":996},"end":{"line":18,"column":55,"offset":1035}}}],"children":[{"type":"paragraph","children":[{"type":"text","value":"Chương trình của bạn phải cho phép maker hủy đề nghị escrow và hoàn lại tiền đã ký quỹ. Đảm bảo instruction của bạn được định nghĩa với instruction discriminator có giá trị ","position":{"start":{"line":19,"column":5,"offset":1042},"end":{"line":19,"column":178,"offset":1215}}},{"type":"inlineCode","value":"2","position":{"start":{"line":19,"column":178,"offset":1215},"end":{"line":19,"column":181,"offset":1218}}},{"type":"text","value":".","position":{"start":{"line":19,"column":181,"offset":1218},"end":{"line":19,"column":182,"offset":1219}}}],"position":{"start":{"line":19,"column":5,"offset":1042},"end":{"line":19,"column":182,"offset":1219}}}],"position":{"start":{"line":18,"column":3,"offset":983},"end":{"line":20,"column":17,"offset":1237}}}],"position":{"start":{"line":9,"column":1,"offset":492},"end":{"line":21,"column":19,"offset":1257}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":22,"column":1,"offset":1259}}},"raw":"import { ChallengeTitle } from \"../../../../components/Challenges/ChallengeTitle\";\r\nimport { RequirementList } from \"../../../../components/Challenges/RequirementList\";\r\nimport { Requirement } from \"../../../../components/Challenges/Requirement\";\r\n\r\n<ChallengeTitle>Pinocchio Escrow</ChallengeTitle>\r\n\r\nBây giờ là lúc để áp dụng những gì bạn đã học vào thực tế. Sử dụng những gì bạn đã học từ bài học, hãy xây dựng một chương trình escrow bằng Pinocchio framework đáp ứng các yêu cầu sau:\r\n\r\n<RequirementList>\r\n  <Requirement title=\"Thử thách 1: Tạo đề nghị escrow\">\r\n    Chương trình của bạn phải cho phép maker tạo đề nghị escrow. Định nghĩa một instruction để làm điều này bằng instruction discriminator với giá trị `0`.\r\n  </Requirement>\r\n\r\n  <Requirement title=\"Thử thách 2: Nhận đề nghị escrow\">\r\n    Chương trình của bạn phải cho phép taker nhận đề nghị escrow. Định nghĩa một instruction để làm điều này bằng instruction discriminator với giá trị `1`.\r\n  </Requirement>\r\n\r\n  <Requirement title=\"Thử thách 3: Hủy đề nghị escrow\">\r\n    Chương trình của bạn phải cho phép maker hủy đề nghị escrow và hoàn lại tiền đã ký quỹ. Đảm bảo instruction của bạn được định nghĩa với instruction discriminator có giá trị `2`.\r\n  </Requirement>\r\n</RequirementList>\r\n","highlightedCode":{}}