9},"end":{"line":27,"column":66,"offset":1671}}}],"position":{"start":{"line":27,"column":1,"offset":1606},"end":{"line":27,"column":66,"offset":1671}}},{"type":"mdxJsxFlowElement","name":"RequirementList","attributes":[],"children":[{"type":"mdxJsxFlowElement","name":"Requirement","attributes":[{"type":"mdxJsxAttribute","name":"title","value":"Challenge 1: Testing the Slippage with SPL-Token","position":{"start":{"line":31,"column":16,"offset":1711},"end":{"line":31,"column":72,"offset":1767}}}],"children":[{"type":"paragraph","children":[{"type":"text","value":"Your program should suceed when the amount of token in an SPL-Token Account is higher than the amount passed in.","position":{"start":{"line":32,"column":5,"offset":1774},"end":{"line":32,"column":117,"offset":1886}}}],"position":{"start":{"line":32,"column":5,"offset":1774},"end":{"line":32,"column":117,"offset":1886}}}],"position":{"start":{"line":31,"column":3,"offset":1698},"end":{"line":33,"column":17,"offset":1904}}},{"type":"mdxJsxFlowElement","name":"Requirement","attributes":[{"type":"mdxJsxAttribute","name":"title","value":"Challenge 2: Testing the Failure of a Slippage","position":{"start":{"line":35,"column":16,"offset":1923},"end":{"line":35,"column":70,"offset":1977}}}],"children":[{"type":"paragraph","children":[{"type":"text","value":"Your program should fail when the amount of token in an Token Account is lower than the amount passed in.","position":{"start":{"line":36,"column":5,"offset":1984},"end":{"line":36,"column":110,"offset":2089}}}],"position":{"start":{"line":36,"column":5,"offset":1984},"end":{"line":36,"column":110,"offset":2089}}}],"position":{"start":{"line":35,"column":3,"offset":1910},"end":{"line":37,"column":17,"offset":2107}}},{"type":"mdxJsxFlowElement","name":"Requirement","attributes":[{"type":"mdxJsxAttribute","name":"title","value":"Challenge 3: Testing the Slippage with Token2022","position":{"start":{"line":39,"column":16,"offset":2126},"end":{"line":39,"column":72,"offset":2182}}}],"children":[{"type":"paragraph","children":[{"type":"text","value":"Your program should suceed when the amount of token in an Token2022 Account is higher than the amount passed in.","position":{"start":{"line":40,"column":5,"offset":2189},"end":{"line":40,"column":117,"offset":2301}}}],"position":{"start":{"line":40,"column":5,"offset":2189},"end":{"line":40,"column":117,"offset":2301}}}],"position":{"start":{"line":39,"column":3,"offset":2113},"end":{"line":41,"column":17,"offset":2319}}}],"position":{"start":{"line":30,"column":1,"offset":1677},"end":{"line":42,"column":19,"offset":2339}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":42,"column":19,"offset":2339}}},"raw":"import { ChallengeTitle } from \"../../../../components/Challenges/ChallengeTitle\";\r\nimport { RequirementList } from \"../../../../components/Challenges/RequirementList\";\r\nimport { Requirement } from \"../../../../components/Challenges/Requirement\";\r\n\r\n<ChallengeTitle>sBPF Assembly Slippage</ChallengeTitle>\r\n\r\nNow that you should starting to be comfortable writing Assembly, instead of using just a normal account, your slippage check should work for both SPL-Token and Token2022 Accounts.\r\n\r\n> The `amount` will be placed in memory at the same constant as the example. The main difference is that we can't get the instruction data using a constant since the `data_len` of the account is dynamic (instruction data is located at the end of the last account data).\r\n\r\nCreate a program only has one instruction. It must:\r\n- Take in a single SPL or Token2022 Token account\r\n- Take in a u64 (8-byte) minimum balance in instruction data\r\n- Dynamically calculate the offset to the minimum balance\r\n- If slippage is exceeded, log the string `Slippage exceeded` and return error code 1\r\n\r\n> To get the right instruction data offset you can use our [tool](https://sbpf.xyz). But we're going to help you out: the `data_len` of the token account is at `.equ TOKEN_ACCOUNT_DATA_LEN, 0x0058`\r\n\r\nStart by installing the sBPF package like explained in the [tooling section](/en/courses/introduction-to-assembly/tooling) of the Introduction to Assembly course and build your program using the following command in your terminal:\r\n\r\n```\r\nsbpf build\r\n```\r\n\r\nThis will generate a `.so` file in your `target/deploy` folder. \r\n\r\nNow click on the `take challenge` button and drop the file there!\r\n\r\n\r\n<RequirementList>\r\n  <Requirement title=\"Challenge 1: Testing the Slippage with SPL-Token\">\r\n    Your program should suceed when the amount of token in an SPL-Token Account is higher than the amount passed in.\r\n  </Requirement>\r\n\r\n  <Requirement title=\"Challenge 2: Testing the Failure of a Slippage\">\r\n    Your program should fail when the amount of token in an Token Account is lower than the amount passed in.\r\n  </Requirement>\r\n\r\n  <Requirement title=\"Challenge 3: Testing the Slippage with Token2022\">\r\n    Your program should suceed when the amount of token in an Token2022 Account is higher than the amount passed in.\r\n  </Requirement>\r\n</RequirementList>","highlightedCode":{"code-0":{"lang":"text","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{},"children":[{"type":"text","value":"sbpf build"}]}]}]}]}]}}}}