":{"line":70,"column":45,"offset":4089},"end":{"line":70,"column":76,"offset":4120}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":70,"column":77,"offset":4121},"end":{"line":70,"column":87,"offset":4131}}}],"children":[],"position":{"start":{"line":70,"column":1,"offset":4045},"end":{"line":70,"column":90,"offset":4134}}},{"type":"code","lang":"sbpf","meta":null,"value":"lddw r1, e              // Load error message address\r\nlddw r2, 17             // Load length of error message  \r\ncall sol_log_           // Log out error message\r\nlddw r0, 1              // Return error code 1","position":{"start":{"line":72,"column":1,"offset":4138},"end":{"line":77,"column":4,"offset":4362}},"data":{"highlightId":"code-3"}},{"type":"paragraph","children":[{"type":"text","value":"Khi kiểm tra thất bại, chúng ta ghi log một thông báo lỗi có thể đọc được trước khi kết thúc chương trình:","position":{"start":{"line":79,"column":1,"offset":4366},"end":{"line":79,"column":107,"offset":4472}}}],"position":{"start":{"line":79,"column":1,"offset":4366},"end":{"line":79,"column":107,"offset":4472}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"lddw","position":{"start":{"line":80,"column":3,"offset":4476},"end":{"line":80,"column":9,"offset":4482}}},{"type":"text","value":" tải vào các giá trị ngay lập tức, trong trường hợp này là địa chỉ của chuỗi thông báo lỗi của chúng ta, nằm trong phần ","position":{"start":{"line":80,"column":9,"offset":4482},"end":{"line":80,"column":129,"offset":4602}}},{"type":"inlineCode","value":".rodata","position":{"start":{"line":80,"column":129,"offset":4602},"end":{"line":80,"column":138,"offset":4611}}},{"type":"text","value":", và độ dài của chuỗi thông báo lỗi (17 byte cho \"Slippage exceeded\").","position":{"start":{"line":80,"column":138,"offset":4611},"end":{"line":80,"column":208,"offset":4681}}}],"position":{"start":{"line":80,"column":3,"offset":4476},"end":{"line":80,"column":208,"offset":4681}}}],"position":{"start":{"line":80,"column":1,"offset":4474},"end":{"line":80,"column":208,"offset":4681}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"call sol_log_","position":{"start":{"line":81,"column":3,"offset":4685},"end":{"line":81,"column":18,"offset":4700}}},{"type":"text","value":" để gọi syscall của Solana. Runtime đọc thông báo từ bộ nhớ và thêm nó vào nhật ký giao dịch.","position":{"start":{"line":81,"column":18,"offset":4700},"end":{"line":81,"column":111,"offset":4793}}}],"position":{"start":{"line":81,"column":3,"offset":4685},"end":{"line":81,"column":111,"offset":4793}}}],"position":{"start":{"line":81,"column":1,"offset":4683},"end":{"line":81,"column":111,"offset":4793}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Chúng ta sau đó tải giá trị ","position":{"start":{"line":82,"column":3,"offset":4797},"end":{"line":82,"column":31,"offset":4825}}},{"type":"inlineCode","value":"1","position":{"start":{"line":82,"column":31,"offset":4825},"end":{"line":82,"column":34,"offset":4828}}},{"type":"text","value":" vào ","position":{"start":{"line":82,"column":34,"offset":4828},"end":{"line":82,"column":39,"offset":4833}}},{"type":"inlineCode","value":"r0","position":{"start":{"line":82,"column":39,"offset":4833},"end":{"line":82,"column":43,"offset":4837}}},{"type":"text","value":" để đánh dấu lỗi chương trình. Runtime sẽ hủy bỏ giao dịch và trả về mã lỗi này.","position":{"start":{"line":82,"column":43,"offset":4837},"end":{"line":82,"column":123,"offset":4917}}}],"position":{"start":{"line":82,"column":3,"offset":4797},"end":{"line":82,"column":123,"offset":4917}}}],"position":{"start":{"line":82,"column":1,"offset":4795},"end":{"line":82,"column":123,"offset":4917