","position":{"start":{"line":84,"column":44,"offset":4819},"end":{"line":84,"column":68,"offset":4843}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":84,"column":69,"offset":4844},"end":{"line":84,"column":79,"offset":4854}}}],"children":[],"position":{"start":{"line":84,"column":1,"offset":4776},"end":{"line":84,"column":82,"offset":4857}}},{"type":"code","lang":"sbpf","meta":null,"value":"end:\r\n    exit","position":{"start":{"line":86,"column":1,"offset":4861},"end":{"line":89,"column":4,"offset":4889}},"data":{"highlightId":"code-4"}},{"type":"paragraph","children":[{"type":"text","value":"Інструкція ","position":{"start":{"line":91,"column":1,"offset":4893},"end":{"line":91,"column":12,"offset":4904}}},{"type":"inlineCode","value":"exit","position":{"start":{"line":91,"column":12,"offset":4904},"end":{"line":91,"column":18,"offset":4910}}},{"type":"text","value":" завершує виконання програми та повертає контроль середовищу виконання Solana. Значення в ","position":{"start":{"line":91,"column":18,"offset":4910},"end":{"line":91,"column":108,"offset":5000}}},{"type":"inlineCode","value":"r0","position":{"start":{"line":91,"column":108,"offset":5000},"end":{"line":91,"column":112,"offset":5004}}},{"type":"text","value":" стає кодом виходу програми (0 для успішного виконання, ненульове значення для помилок).","position":{"start":{"line":91,"column":112,"offset":5004},"end":{"line":91,"column":200,"offset":5092}}}],"position":{"start":{"line":91,"column":1,"offset":4893},"end":{"line":91,"column":200,"offset":5092}}},{"type":"paragraph","children":[{"type":"text","value":"На відміну від мов високого рівня з автоматичним очищенням, програми на асемблері повинні явно завершуватися. Вихід за межі вашого коду призводить до невизначеної поведінки.","position":{"start":{"line":93,"column":1,"offset":5096},"end":{"line":93,"column":174,"offset":5269}}}],"position":{"start":{"line":93,"column":1,"offset":5096},"end":{"line":93,"column":174,"offset":5269}}},{"type":"heading","depth":2,"children":[{"type":"text","value":"Дані лише для читання","position":{"start":{"line":95,"column":4,"offset":5276},"end":{"line":95,"column":25,"offset":5297}}}],"position":{"start":{"line":95,"column":1,"offset":5273},"end":{"line":95,"column":25,"offset":5297}}},{"type":"code","lang":"sbpf","meta":null,"value":".rodata\r\n    e: .ascii \"Slippage exceeded\"","position":{"start":{"line":97,"column":1,"offset":5301},"end":{"line":100,"column":4,"offset":5357}},"data":{"highlightId":"code-5"}},{"type":"paragraph","children":[{"type":"text","value":"Секція ","position":{"start":{"line":102,"column":1,"offset":5361},"end":{"line":102,"column":8,"offset":5368}}},{"type":"inlineCode","value":".rodata","position":{"start":{"line":102,"column":8,"offset":5368},"end":{"line":102,"column":17,"offset":5377}}},{"type":"text","value":" (дані лише для читання) містить наше повідомлення про помилку.","position":{"start":{"line":102,"column":17,"offset":5377},"end":{"line":102,"column":80,"offset":5440}}}],"position":{"start":{"line":102,"column":1,"offset":5361},"end":{"line":102,"column":80,"offset":5440}}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Висновок","position":{"start":{"line":104,"column":17,"offset":5460},"end":{"line":104,"column":32,"offset":5475}}},{"type":"mdxJsxAttribute","name":"id","value":"conclusion","position":{"start":{"line":104,"column":33,"offset":5476},"end":{"line":104,"column":48,"offset":5491}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":104,"column":49,"offset":5492},"end":{"line":104,"column":59,"offset":5502}}}],"children":[],"position":{"start":{"line":104,"column":1,"offset":5444},"end":{"line":104,"column":62,"offset":5505}}},{"type":"paragraph","children":[{"type":"text","value":"Ця крихітна програма виконує те, що в Rust могло б зайняти десятки CU, використовуючи лише ","position":{"start":{"line":106,"column":1,"offset":5511},"end":{"line":106,"column":92,"offset":5602}}},{"type":"inlineCode","value":"4 CUs","position":{"start":{"line":106,"column":92,"offset":5602},"end":{"line":106,"column":99,"offset":5609}}},{"type":"text","value":" у випадку успіху, ","position":{"start":{"line":106,"column":99,"offset":5609},"end":{"line":106,"column":118,"offset":5628}}},{"type":"inlineCode","value":"6 CUs","position":{"start":{"line":106,"column":118,"offset":5628},"end":{"line":106,"column":125,"offset":5635}}},{"type":"text","value":" у випадку невдачі, або ","position":{"start":{"line":106,"column":125,"offset":5635},"end":{"line":106,"column":149,"offset":5659}}},{"type":"inlineCode","value":"106 CUs","position":{"start":{"line":106,"column":149,"offset":5659},"end":{"line":106,"column":158,"offset":5668}}},{"type":"text","value":" у випадку невдачі з виведенням повідомлення про помилку.","position":{"start":{"line":106,"column":158,"offset":5668},"end":{"line":106,"column":215,"offset":5725}}}],"position":{"start":{"line":106,"column":1,"offset":5511},"end":{"line":106,"column":215,"offset":5725}}},{"type":"paragraph","children":[{"type":"text","value":"Компроміс полягає в тому, що ми повинні розуміти структури пам'яті, угоди про виклики та обробку помилок на найнижчому рівні. Але для операцій, критичних до продуктивності, переваги часто виправдовують зусилля.","position":{"start":{"line":108,"column":1,"offset":5729},"end":{"line":108,"column":211,"offset":5939}}}],"position":{"start":{"line":108,"column":1,"offset":5729},"end":{"line":108,"column":211,"offset":5939}}},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"Цей код сам по собі не є \"безпечним\". Ми не перевіряємо нічого щодо переданих облікових записів. Але це має бути додаткова інструкція, яка повинна виконуватися з добрими намірами.","position":{"start":{"line":110,"column":3,"offset":5945},"end":{"line":110,"column":182,"offset":6124}}}],"position":{"start":{"line":110,"column":3,"offset":5945},"end":{"line":110,"column":182,"offset":6124}}}],"position":{"start":{"line":110,"column":1,"offset":5943},"end":{"line":110,"column":182,"offset":6124}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":111,"column":1,"offset":6126}}},"raw":"import ArticleSection from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n![Assembly Slippage Challenge](/graphics/challenge-banners/assembly-slippage.png)\r\n\r\n# Проковзування в Assembly\r\n\r\nУ цьому розділі ми використаємо sBPF Assembly для створення базової інструкції перевірки проковзування. Включивши таку інструкцію в останній індекс нашого масиву інструкцій, ми можемо створити додатковий захист останньої інстанції від помилок у смарт-контрактах або зловмисних контрактів з бітовими помилками.\r\n\r\nЄ кілька властивостей перевірки проковзування, які роблять її ідеальним кандидатом для асемблера:\r\n\r\n- Єдиний, обмежений варіант використання\r\n- Немає потреби виконувати перевірки підписувача/облікового запису\r\n- Може лише покращити безпеку\r\n\r\nЯкщо ви не знайомі з тим, як писати програми на асемблері, пройдіть [вступний курс з Assembly](/uk/courses/introduction-to-assembly)\r\n\r\n<ArticleSection name=\"Дизайн програми\" id=\"program-design\" level=\"h2\" />\r\n\r\nНаша програма реалізує просту, але важливу операцію: перевірку того, що токен-акаунт має достатній баланс перед виконанням транзакції. Цей патерн зустрічається всюди в DeFi — від свопів AMM до кредитних протоколів.\r\n\r\nПрограма очікує:\r\n- Один SPL токен-акаунт у масиві акаунтів\r\n- 8-байтову суму в даних інструкції\r\n- Повертає успіх, якщо баланс ≥ суми, інакше — помилку\r\n\r\n<ArticleSection name=\"Зміщення в пам'яті\" id=\"memory-offsets\" level=\"h2\" />\r\n\r\nПрограми sBPF отримують дані акаунтів як суміжні області пам'яті. Ці константи визначають байтові зміщення. Припускаючи, що наша програма прийматиме лише один акаунт, і це буде SPL Token Account, можна статично визначити ці зміщення як:\r\n\r\n```sbpf\r\n.equ TOKEN_ACCOUNT_BALANCE, 0x00a0\r\n.equ MINIMUM_BALANCE, 0x2918\r\n```\r\n\r\n- `TOKEN_ACCOUNT_BALANCE (0x00a0)`: вказує на поле балансу в даних акаунта SPL Token. Токен-акаунти мають стандартну структуру, де баланс (8 байтів, little-endian) знаходиться на зміщенні 160.\r\n\r\n- `MINIMUM_BALANCE (0x2918)`: визначає, де Solana розміщує корисне навантаження даних вашої інструкції. Це зміщення є частиною структури інформації про акаунт середовища виконання.\r\n\r\n> Ви можете згенерувати зміщення за допомогою наших інструментів на [sbpf.xyz](https://sbpf.xyz)\r\n\r\nНа відміну від мов високого рівня, які абстрагують розташування пам'яті, асемблер вимагає точного знання, де саме знаходиться кожен фрагмент даних.\r\n\r\n<ArticleSection name=\"Entrypoint and Initial Validation\" id=\"entrypoint-and-validations\" level=\"h2\" />\r\n\r\n```sbpf\r\n.globl entrypoint\r\nentrypoint:\r\n    ldxdw r3, [r1+MINIMUM_BALANCE]      // Get amount from IX data\r\n    ldxdw r4, [r1+TOKEN_ACCOUNT_BALANCE] // Get balance from token account\r\n```\r\n\r\nКожна програма sBPF починається з глобального символу `.entrypoint`. Середовище виконання Solana надає дані облікового запису та інструкції через регістр `r1`.\r\n\r\nІнструкція `ldxdw` завантажує (`ldx`) 8-байтове (подвійне слово, `dx`) значення з пам'яті в регістр. Ось що відбувається:\r\n- `ldxdw r3, [r1+MINIMUM_BALANCE]`: обчислює адресу пам'яті, що містить нашу необхідну суму. Значення завантажується в `r3`.\r\n- `ldxdw r4, [r1+TOKEN_ACCOUNT_BALANCE]`: вказує на поле балансу токен-акаунта. Це 64-бітне значення потрапляє в `r4`.\r\n\r\nОбидві операції виконуються без копіювання: ми читаємо безпосередньо з даних облікового запису без накладних витрат на десеріалізацію.\r\n\r\n<ArticleSection name=\"Conditional Logic and Branching\" id=\"conditional-logic-and-branching\" level=\"h2\" />\r\n\r\n```sbpf\r\njge r3, r4, end         // Skip to exit if balance is valid\r\n```\r\n\r\nІнструкція `jge` (перехід, якщо більше або дорівнює) порівнює `r3` (необхідну суму) з `r4` (доступним балансом). Якщо `r3 >= r4`, ми переходимо до мітки `end`; це схоже на ранній вихід.\r\n\r\nЯкщо умова не виконується, виконання продовжується шляхом обробки помилок. Цей шаблон розгалуження за умовою — це спосіб реалізації логіки if/else в асемблері.\r\n\r\n<ArticleSection name=\"Error Handling and Logging\" id=\"error-handling-and-logging\" level=\"h2\" />\r\n\r\n```sbpf\r\nlddw r1, e              // Load error message address\r\nlddw r2, 17             // Load length of error message  \r\ncall sol_log_           // Log out error message\r\nlddw r0, 1              // Return error code 1\r\n```\r\n\r\nКоли перевірка не вдається, ми записуємо зрозумілу для людини помилку перед завершенням:\r\n- `lddw` завантажує безпосередні значення, у цьому випадку адресу нашого рядка помилки, який знаходиться в секції `.rodata`, та його довжину (17 байтів для \"Slippage exceeded\").\r\n- `call sol_log_` викликає системний виклик логування Solana. Середовище виконання зчитує повідомлення з пам'яті та додає його до журналів транзакцій.\r\n- Потім ми завантажуємо `1` у `r0`, щоб сигналізувати про збій програми. Середовище виконання перерве транзакцію та поверне цей код помилки.\r\n\r\n<ArticleSection name=\"Завершення програми\" id=\"program-termination\" level=\"h2\" />\r\n\r\n```sbpf\r\nend:\r\n    exit\r\n```\r\n\r\nІнструкція `exit` завершує виконання програми та повертає контроль середовищу виконання Solana. Значення в `r0` стає кодом виходу програми (0 для успішного виконання, ненульове значення для помилок).\r\n\r\nНа відміну від мов високого рівня з автоматичним очищенням, програми на асемблері повинні явно завершуватися. Вихід за межі вашого коду призводить до невизначеної поведінки.\r\n\r\n## Дані лише для читання\r\n\r\n```sbpf\r\n.rodata\r\n    e: .ascii \"Slippage exceeded\"\r\n```\r\n\r\nСекція `.rodata` (дані лише для читання) містить наше повідомлення про помилку.\r\n\r\n<ArticleSection name=\"Висновок\" id=\"conclusion\" level=\"h2\" />\r\n  \r\nЦя крихітна програма виконує те, що в Rust могло б зайняти десятки CU, використовуючи лише `4 CUs` у випадку успіху, `6 CUs` у випадку невдачі, або `106 CUs` у випадку невдачі з виведенням повідомлення про помилку.\r\n\r\nКомпроміс полягає в тому, що ми повинні розуміти структури пам'яті, угоди про виклики та обробку помилок на найнижчому рівні. Але для операцій, критичних до продуктивності, переваги часто виправдовують зусилля.\r\n\r\n> Цей код сам по собі не є \"безпечним\". Ми не перевіряємо нічого щодо переданих облікових записів. Але це має бути додаткова інструкція, яка повинна виконуватися з добрими намірами.\r\n","highlightedCode":{"code-0":{"lang":"sbpf","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":".equ TOKEN_ACCOUNT_BALANCE, "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F1FA8C"},"children":[{"type":"text","value":"0x00a0"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":".equ MINIMUM_BALANCE, "}]},{"type":"element","tagName":"span","properties":{"style":"color:#F1FA8C"},"children":[{"type":"text","value":"0x2918"}]}]}]}]}]}},"code-1":{"lang":"sbpf","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type"