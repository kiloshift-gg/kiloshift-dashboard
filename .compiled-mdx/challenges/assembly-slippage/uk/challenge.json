             // Load error message address\r\nlddw r2, 17             // Load length of error message  \r\ncall sol_log_           // Log out error message\r\nlddw r0, 1              // Return error code 1","position":{"start":{"line":72,"column":1,"offset":3983},"end":{"line":77,"column":4,"offset":4207}},"data":{"highlightId":"code-3"}},{"type":"paragraph","children":[{"type":"text","value":"Коли перевірка не вдається, ми записуємо зрозумілу для людини помилку перед завершенням:","position":{"start":{"line":79,"column":1,"offset":4211},"end":{"line":79,"column":89,"offset":4299}}}],"position":{"start":{"line":79,"column":1,"offset":4211},"end":{"line":79,"column":89,"offset":4299}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"lddw","position":{"start":{"line":80,"column":3,"offset":4303},"end":{"line":80,"column":9,"offset":4309}}},{"type":"text","value":" завантажує безпосередні значення, у цьому випадку адресу нашого рядка помилки, який знаходиться в секції ","position":{"start":{"line":80,"column":9,"offset":4309},"end":{"line":80,"column":115,"offset":4415}}},{"type":"inlineCode","value":".rodata","position":{"start":{"line":80,"column":115,"offset":4415},"end":{"line":80,"column":124,"offset":4424}}},{"type":"text","value":", та його довжину (17 байтів для \"Slippage exceeded\").","position":{"start":{"line":80,"column":124,"offset":4424},"end":{"line":80,"column":178,"offset":4478}}}],"position":{"start":{"line":80,"column":3,"offset":4303},"end":{"line":80,"column":178,"offset":4478}}}],"position":{"start":{"line":80,"column":1,"offset":4301},"end":{"line":80,"column":178,"offset":4478}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"call sol_log_","position":{"start":{"line":81,"column":3,"offset":4482},"end":{"line":81,"column":18,"