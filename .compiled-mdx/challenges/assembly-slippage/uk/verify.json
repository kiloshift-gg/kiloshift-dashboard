column":1,"offset":1636},"end":{"line":27,"column":68,"offset":1703}}},{"type":"mdxJsxFlowElement","name":"RequirementList","attributes":[],"children":[{"type":"mdxJsxFlowElement","name":"Requirement","attributes":[{"type":"mdxJsxAttribute","name":"title","value":"Завдання 1: Тестування проковзування з SPL-Token","position":{"start":{"line":30,"column":16,"offset":1741},"end":{"line":30,"column":72,"offset":1797}}}],"children":[{"type":"paragraph","children":[{"type":"text","value":"Ваша програма повинна успішно виконуватися, коли кількість токенів на SPL-Token рахунку вища за кількість, передану в параметрах.","position":{"start":{"line":31,"column":5,"offset":1804},"end":{"line":31,"column":134,"offset":1933}}}],"position":{"start":{"line":31,"column":5,"offset":1804},"end":{"line":31,"column":134,"offset":1933}}}],"position":{"start":{"line":30,"column":3,"offset":1728},"end":{"line":32,"column":17,"offset":1951}}},{"type":"mdxJsxFlowElement","name":"Requirement","attributes":[{"type":"mdxJsxAttribute","name":"title","value":"Завдання 2: Тестування невдачі проковзування","position":{"start":{"line":34,"column":16,"offset":1970},"end":{"line":34,"column":68,"offset":2022}}}],"children":[{"type":"paragraph","children":[{"type":"text","value":"Ваша програма повинна завершитися невдачею, коли кількість токенів у Токен-акаунті менша за передану кількість.","position":{"start":{"line":35,"column":5,"offset":2029},"end":{"line":35,"column":116,"offset":2140}}}],"position":{"start":{"line":35,"column":5,"offset":2029},"end":{"line":35,"column":116,"offset":2140}}}],"position":{"start":{"line":34,"column":3,"offset":1957},"end":{"line":36,"column":17,"offset":2158}}},{"type":"mdxJsxFlowElement","name":"Requirement","attributes":[{"type":"mdxJsxAttribute","name":"title","value":"Завдання 3: Тестування проковзування з Token2022","position":{"start":{"line":38,"column":16,"offset":2177},"end":{"line":38,"column":72,"offset":2233}}}],"children":[{"type":"paragraph","children":[{"type":"text","value":"Ваша програма повинна успішно виконатися, коли кількість токенів у акаунті Token2022 більша за передану кількість.","position":{"start":{"line":39,"column":5,"offset":2240},"end":{"line":39,"column":119,"offset":2354}}}],"position":{"start":{"line":39,"column":5,"offset":2240},"end":{"line":39,"column":119,"offset":2354}}}],"position":{"start":{"line":38,"column":3,"offset":2164},"end":{"line":40,"column":17,"offset":2372}}}],"position":{"start":{"line":29,"column":1,"offset":1707},"end":{"line":41,"column":19,"offset":2392}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":41,"column":19,"offset":2392}}},"raw":"import { ChallengeTitle } from \"../../../../components/Challenges/ChallengeTitle\";\r\nimport { RequirementList } from \"../../../../components/Challenges/RequirementList\";\r\nimport { Requirement } from \"../../../../components/Challenges/Requirement\";\r\n\r\n<ChallengeTitle>Проковзування в sBPF асемблері</ChallengeTitle>\r\n\r\nТепер, коли ви вже маєте почуватися комфортно з написанням асемблера, ваша перевірка проковзування повинна працювати як для звичайних SPL-Token, так і для Token2022 рахунків.\r\n\r\n> `amount` буде розміщено в пам'яті за тією ж константою, що і в прикладі. Головна відмінність полягає в тому, що ми не можемо отримати дані інструкції, використовуючи константу, оскільки `data_len` рахунку є динамічним (дані інструкції розташовані в кінці даних останнього рахунку).\r\n\r\nСтворіть програму, яка має лише одну інструкцію. Вона повинна:\r\n- Приймати один SPL або Token2022 рахунок\r\n- Приймати u64 (8-байтовий) мінімальний баланс у даних інструкції\r\n- Динамічно обчислювати зміщення до мінімального балансу\r\n- Якщо проковзування перевищено, записати рядок `Slippage exceeded` і повернути код помилки 1\r\n\r\n> Щоб отримати правильне зміщення даних інструкції, ви можете використати наш [інструмент](https://sbpf.xyz). Але ми вам допоможемо: `data_len` токен-рахунку знаходиться за адресою `.equ TOKEN_ACCOUNT_DATA_LEN, 0x0058`\r\n\r\nПочніть з встановлення пакету sBPF, як пояснено в [розділі про інструменти](/uk/courses/introduction-to-assembly/tooling) курсу \"Вступ до асемблера\", і зберіть вашу програму за допомогою наступної команди в терміналі:\r\n\r\n```\r\nsbpf build\r\n```\r\n\r\nЦе згенерує файл `.so` у вашій папці `target/deploy`. \r\n\r\nТепер натисніть на кнопку `take challenge` і перетягніть туди файл!\r\n\r\n<RequirementList>\r\n  <Requirement title=\"Завдання 1: Тестування проковзування з SPL-Token\">\r\n    Ваша програма повинна успішно виконуватися, коли кількість токенів на SPL-Token рахунку вища за кількість, передану в параметрах.\r\n  </Requirement>\r\n\r\n  <Requirement title=\"Завдання 2: Тестування невдачі проковзування\">\r\n    Ваша програма повинна завершитися невдачею, коли кількість токенів у Токен-акаунті менша за передану кількість.\r\n  </Requirement>\r\n\r\n  <Requirement title=\"Завдання 3: Тестування проковзування з Token2022\">\r\n    Ваша програма повинна успішно виконатися, коли кількість токенів у акаунті Token2022 більша за передану кількість.\r\n  </Requirement>\r\n</RequirementList>","highlightedCode":{"code-0":{"lang":"text","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{},"children":[{"type":"text","value":"sbpf build"}]}]}]}]}]}}}}