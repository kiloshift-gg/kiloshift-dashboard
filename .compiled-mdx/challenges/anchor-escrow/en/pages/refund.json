ake(ctx: Context<Make>, seed: u64, receive: u64, amount: u64) -> Result<()> {\r\n        instructions::make::handler(ctx, seed, receive, amount)\r\n    }\r\n\r\n    pub fn take(ctx: Context<Take>) -> Result<()> {\r\n        instructions::take::handler(ctx)\r\n    }\r\n\r\n    pub fn refund(ctx: Context<Refund>) -> Result<()> {\r\n        instructions::refund::handler(ctx)\r\n    }\r\n}","position":{"start":{"line":35,"column":1,"offset":1964},"end":{"line":52,"column":4,"offset":2424}},"data":{"highlightId":"code-0"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Conclusion","position":{"start":{"line":54,"column":17,"offset":2444},"end":{"line":54,"column":34,"offset":2461}}},{"type":"mdxJsxAttribute","name":"id","value":"conclusion","position":{"start":{"line":54,"column":35,"offset":2462},"end":{"line":54,"column":50,"offset":2477}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":54,"column":51,"offset":2478},"end":{"line":54,"column":61,"offset":2488}}}],"children":[],"position":{"start":{"line":54,"column":1,"offset":2428},"end":{"line":54,"column":64,"offset":2491}}},{"type":"paragraph","children":[{"type":"text","value":"You can now test your program against our unit tests and claim your NFTs!","position":{"start":{"line":56,"column":1,"offset":2495},"end":{"line":56,"column":74,"offset":2568}}}],"position":{"start":{"line":56,"column":1,"offset":2495},"end":{"line":56,"column":74,"offset":2568}}},{"type":"paragraph","children":[{"type":"text","value":"Start by building your program using the following command in your terminal","position":{"start":{"line":58,"column":1,"offset":2572},"end":{"line":58,"column":76,"offset":2647}}}],"position":{"start":{"line":58,"column":1,"offset":2572},"end":{"line":58,"column":76,"offset":2647}}},{"type":"code","lang":"bash","meta":null,"value":"anchor build","position":{"start":{"line":60,"column":1,"offset":2651},"end":{"line":62,"column":4,"offset":2677}}},{"type":"paragraph","children":[{"type":"text","value":"This generated a ","position":{"start":{"line":64,"column":1,"offset":2681},"end":{"line":64,"column":18,"offset":2698}}},{"type":"inlineCode","value":".so","position":{"start":{"line":64,"column":18,"offset":2698},"end":{"line":64,"column":23,"offset":2703}}},{"type":"text","value":" file directly in your ","position":{"start":{"line":64,"column":23,"offset":2703},"end":{"line":64,"column":46,"offset":2726}}},{"type":"inlineCode","value":"target/deploy","position":{"start":{"line":64,"column":46,"offset":2726},"end":{"line":64,"column":61,"offset":2741}}},{"type":"text","value":" folder.","position":{"start":{"line":64,"column":61,"offset":2741},"end":{"line":64,"column":69,"offset":2749}}}],"position":{"start":{"line":64,"column":1,"offset":2681},"end":{"line":64,"column":70,"offset":2750}}},{"type":"paragraph","children":[{"type":"text","value":"Now click on the ","position":{"start":{"line":66,"column":1,"offset":2754},"end":{"line":66,"column":18,"offset":2771}}},{"type":"inlineCode","value":"take challenge","position":{"start":{"line":66,"column":18,"offset":2771},"end":{"line":66,"column":34,"offset":2787}}},{"type":"text","value":" button and drop the file there!","position":{"start":{"line":66,"column":34,"offset":2787},"end":{"line":66,"column":66,"offset":2819}}}],"position":{"start":{"line":66,"column":1,"offset":2754},"end":{"line":66,"column":66,"offset":2819}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":67,"column":1,"offset":2821}}},"raw":"import { ArticleSection } from \"../../../../../components/ArticleSection/ArticleSection\";\r\n\r\n<ArticleSection name=\"Refund\" id=\"refund\" level=\"h2\" />\r\n\r\nWe can now move to the `refund` instruction, that lives in the `refund.rs` and will perform these actions:\r\n- Close the escrow PDA and send its rent lamports back to the maker.\r\n- Move the full Token A balance out of the vault and back to the maker, then close the vault account.\r\n\r\n### Accounts \r\n\r\nThe accounts needed in this context are:\r\n- `maker`: the user that decided the terms of the exchange\r\n- `escrow`: the account where all the terms of this exchange lives\r\n- `mint_a`: the token that the `maker` has deposited\r\n- `vault`: the token account associated with the `escrow` and `mint_a` where the tokens have been deposited\r\n- `maker_ata_a`: the token account associated with the `maker` and `mint_a` that will receive the tokens from the `vault`\r\n- `associated_token_program`: the associated token program used to create the associated token accounts\r\n- `token_program`: the token program used to CPI the transfer\r\n- `system_program`: the system program used to create the `Escrow`\r\n\r\nThis time we're not going to help you by creating the `Context`, so try doing it yourself! Please make sure to use the right order of accounts or our tests will fail.\r\n\r\n### Logic \r\n\r\nThe logic is similar to the `take` instruction but this time we just move the tokens from the `vault` to the `maker_ata_a` before closing the now empty vault. \r\n\r\nThis time it's your turn to learn how to do it yourself, so we're not going to tell you what the solution is.\r\n\r\nJust know that once this executes, the offer is void, the vault is gone, and the maker has their Token A and rent back in their wallet.\r\n\r\n<ArticleSection name=\"Entrypoint\" id=\"entrypoint\" level=\"h2\" />\r\n\r\nNow that we created all the function in the different instruction, we can finally populate the `lib.rs` with all the function we created; like this:\r\n\r\n```rust\r\n#[program]\r\npub mod Kiloshift_anchor_escrow {\r\n    use super::*;\r\n\r\n    pub fn make(ctx: Context<Make>, seed: u64, receive: u64, amount: u64) -> Result<()> {\r\n        instructions::make::handler(ctx, seed, receive, amount)\r\n    }\r\n\r\n    pub fn take(ctx: Context<Take>) -> Result<()> {\r\n        instructions::take::handler(ctx)