tart":{"line":21,"column":182,"offset":1308},"end":{"line":21,"column":183,"offset":1309}}}],"position":{"start":{"line":21,"column":5,"offset":1131},"end":{"line":21,"column":183,"offset":1309}}}],"position":{"start":{"line":20,"column":3,"offset":1065},"end":{"line":22,"column":17,"offset":1327}}}],"position":{"start":{"line":11,"column":1,"offset":588},"end":{"line":23,"column":19,"offset":1347}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":24,"column":1,"offset":1349}}},"raw":"import { ChallengeTitle } from \"../../../../components/Challenges/ChallengeTitle\";\r\nimport { RequirementList } from \"../../../../components/Challenges/RequirementList\";\r\nimport { Requirement } from \"../../../../components/Challenges/Requirement\";\r\n\r\n<ChallengeTitle>Anchor Escrow</ChallengeTitle>\r\n\r\nIt's now time to put what you've learned to the test. Using what you've learned from the lesson, build an escrow program using the Anchor framework that satisfies the following requirements:\r\n\r\n> Your state account should be defined using an account discriminator with a value of `1`.\r\n\r\n<RequirementList>\r\n  <Requirement title=\"Challenge 1: Making an escrow offer\">\r\n    Your program should allow a maker to make an escrow offer. Define an instruction to do this using an instruction discriminator with value `0`.\r\n  </Requirement>\r\n\r\n  <Requirement title=\"Challenge 2: Taking an escrow offer\">\r\n    Your program should allow a taker to take an escrow offer. Define an instruction to do this using an instruction discriminator value of `1`.\r\n  </Requirement>\r\n\r\n  <Requirement title=\"Challenge 3: Canceling an escrow offer\">\r\n    Your program should allow the maker to cancel an escrow offer and refund the escrowed funds. Make sure your instruction is defined with an instruction discriminator value of `2`.\r\n  </Requirement>\r\n</RequirementList>\r\n","highlightedCode":{}}