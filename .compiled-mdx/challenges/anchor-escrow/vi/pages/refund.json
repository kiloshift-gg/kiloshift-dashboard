receive: u64, amount: u64) -> Result<()> {\r\n        instructions::make::handler(ctx, seed, receive, amount)\r\n    }\r\n\r\n    pub fn take(ctx: Context<Take>) -> Result<()> {\r\n        instructions::take::handler(ctx)\r\n    }\r\n\r\n    pub fn refund(ctx: Context<Refund>) -> Result<()> {\r\n        instructions::refund::handler(ctx)\r\n    }\r\n}","position":{"start":{"line":35,"column":1,"offset":1944},"end":{"line":52,"column":4,"offset":2404}},"data":{"highlightId":"code-0"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Kết luận","position":{"start":{"line":54,"column":17,"offset":2424},"end":{"line":54,"column":32,"offset":2439}}},{"type":"mdxJsxAttribute","name":"id","value":"conclusion","position":{"start":{"line":54,"column":33,"offset":2440},"end":{"line":54,"column":48,"offset":2455}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":54,"column":49,"offset":2456},"end":{"line":54,"column":59,"offset":2466}}}],"children":[],"position":{"start":{"line":54,"column":1,"offset":2408},"end":{"line":54,"column":62,"offset":2469}}},{"type":"paragraph","children":[{"type":"text","value":"Bây giờ bạn có thể kiểm tra chương trình của mình với các unit test của chúng tôi và nhận NFT!","position":{"start":{"line":56,"column":1,"offset":2473},"end":{"line":56,"column":95,"offset":2567}}}],"position":{"start":{"line":56,"column":1,"offset":2473},"end":{"line":56,"column":95,"offset":2567}}},{"type":"paragraph","children":[{"type":"text","value":"Bắt đầu bằng cách build chương trình của bạn bằng lệnh sau trong terminal","position":{"start":{"line":58,"column":1,"offset":2571},"end":{"line":58,"column":74,"offset":2644}}}],"position":{"start":{"line":58,"column":1,"offset":2571},"end":{"line":58,"column":74,"offset":2644}}},{"type":"code","lang":"bash","meta":null,"value":"anchor build","position":{"start":{"line":60,"column":1,"offset":2648},"end":{"line":62,"column":4,"offset":2674}}},{"type":"paragraph","children":[{"type":"text","value":"Lệnh này sẽ tạo ra file ","position":{"start":{"line":64,"column":1,"offset":2678},"end":{"line":64,"column":25,"offset":2702}}},{"type":"inlineCode","value":".so","position":{"start":{"line":64,"column":25,"offset":2702},"end":{"line":64,"column":30,"offset":2707}}},{"type":"text","value":" trực tiếp trong thư mục ","position":{"start":{"line":64,"column":30,"offset":2707},"end":{"line":64,"column":55,"offset":2732}}},{"type":"inlineCode","value":"target/deploy","position":{"start":{"line":64,"column":55,"offset":2732},"end":{"line":64,"column":70,"offset":2747}}},{"type":"text","value":".","position":{"start":{"line":64,"column":70,"offset":2747},"end":{"line":64,"column":71,"offset":2748}}}],"position":{"start":{"line":64,"column":1,"offset":2678},"end":{"line":64,"column":71,"offset":2748}}},{"type":"paragraph","children":[{"type":"text","value":"Bây giờ hãy click vào nút ","position":{"start":{"line":66,"column":1,"offset":2752},"end":{"line":66,"column":27,"offset":2778}}},{"type":"inlineCode","value":"take challenge","position":{"start":{"line":66,"column":27,"offset":2778},"end":{"line":66,"column":43,"offset":2794}}},{"type":"text","value":" và thả file vào đó!","position":{"start":{"line":66,"column":43,"offset":2794},"end":{"line":66,"column":63,"offset":2814}}}],"position":{"start":{"line":66,"column":1,"offset":2752},"end":{"line":66,"column":63,"offset":2814}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":66,"column":63,"offset":2814}}},"raw":"import { ArticleSection } from \"../../../../../components/ArticleSection/ArticleSection\";\r\n\r\n<ArticleSection name=\"Refund\" id=\"refund\" level=\"h2\" />\r\n\r\nBây giờ chúng ta có thể chuyển đến lệnh `refund`, nằm trong `refund.rs` và sẽ thực hiện các hành động sau:\r\n- Đóng tài khoản PDA escrow và gửi rent lamports của nó trở lại cho maker.\r\n- Chuyển toàn bộ số dư Token A ra khỏi vault và chuyển trả lại cho maker, sau đó đóng tài khoản vault.\r\n\r\n### Các tài khoản\r\n\r\nCác tài khoản cần thiết trong ngữ cảnh này là:\r\n- `maker`: người dùng đã quyết định các điều khoản của việc trao đổi\r\n- `escrow`: tài khoản nơi tất cả các điều khoản của việc trao đổi này tồn tại\r\n- `mint_a`: token mà `maker` đã gửi\r\n- `vault`: tài khoản token liên kết với `escrow` và `mint_a` nơi các token đã được giữ\r\n- `maker_ata_a`: tài khoản token liên kết với `maker` và `mint_a` sẽ nhận token từ `vault`\r\n- `associated_token_program`: chương trình associated token được sử dụng để tạo các tài khoản associated token\r\n- `token_program`: chương trình token được sử dụng để gọi CPI việc chuyển\r\n- `system_program`: chương trình hệ thống được sử dụng để tạo `Escrow`\r\n\r\nLần này chúng tôi sẽ không giúp bạn bằng cách tạo `Context`, vì vậy hãy thử tự làm! Vui lòng đảm bảo sử dụng đúng thứ tự tài khoản hoặc các bài kiểm tra của chúng tôi sẽ thất bại.\r\n\r\n### Logic\r\n\r\nLogic tương tự như lệnh `take` nhưng lần này chúng ta chỉ chuyển token từ `vault` đến `maker_ata_a` trước khi đóng vault hiện đã trống.\r\n\r\nLần này đến lượt bạn học cách tự làm, vì vậy chúng tôi sẽ không cho bạn biết giải pháp là gì.\r\n\r\nChỉ cần biết rằng một khi điều này thực thi, đề nghị sẽ vô hiệu, vault sẽ biến mất, và maker sẽ có Token A và rent của họ trở lại trong ví.\r\n\r\n<ArticleSection name=\"Entrypoint\" id=\"entrypoint\" level=\"h2\" />\r\n\r\nBây giờ chúng ta đã tạo tất cả các hàm trong các lệnh khác nhau, cuối cùng chúng ta có thể điền vào `lib.rs` với tất cả các hàm mà chúng ta đã tạo; như thế này:\r\n\r\n```rust\r\n#[program]\r\npub mod Kiloshift_anchor_escrow {\r\n    use super::*;\r\n\r\n    pub fn make(ctx: Context<Make>, seed: u64, receive: u64, amount: u64) -> Result<()> {\r\n        instructions::make::handler(ctx, seed, receive, amount)\r\n    }\r\n\r\n    pub fn take(ctx: Context<Take>) -> Result<()> {\r\n        instructions::take::handler(ctx)\r\n    }\r\n\r\n    pub fn refund(ctx: Context<Refund>) -> Result<()> {\r\n        instructions::refund::handler(ctx)\r\n    }\r\n}\r\n```\r\n\r\n<ArticleSection name=\"Kết luận\" id=\"conclusion\" level=\"h2\" />\r\n\r\nBây giờ bạn có thể kiểm tra chương trình của mình với các unit test của chúng tôi và nhận NFT!\r\n\r\nBắt đầu bằng cách build chương trình của bạn bằng lệnh sau trong terminal\r\n\r\n```bash\r\nanchor build\r\n```\r\n\r\nLệnh này sẽ tạo ra file `.so` trực tiếp trong thư mục `target/deploy`.\r\n\r\nBây giờ hãy click vào nút `take challenge` và thả file vào đó!","highlightedCode":{"code-0":{"lang":"rust","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"#[program]"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"pub"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":" mod"}]},{"type":"element","tagName":"span","properties":{"style":"color:#97E1F1;font-style:italic"},"children":[{"type":"text","value":" Kiloshift_anchor_escrow"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" {"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"    use"}]},{"type":"element","tagName":"span","properties":{"style":"color:#BF9EEE;font-style:italic"},"children":[{"type"