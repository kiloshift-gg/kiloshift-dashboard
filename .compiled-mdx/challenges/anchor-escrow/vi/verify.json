mn":173,"offset":1286},"end":{"line":21,"column":174,"offset":1287}}}],"position":{"start":{"line":21,"column":5,"offset":1118},"end":{"line":21,"column":174,"offset":1287}}}],"position":{"start":{"line":20,"column":3,"offset":1059},"end":{"line":22,"column":17,"offset":1305}}}],"position":{"start":{"line":11,"column":1,"offset":572},"end":{"line":23,"column":19,"offset":1325}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":24,"column":1,"offset":1327}}},"raw":"import { ChallengeTitle } from \"../../../../components/Challenges/ChallengeTitle\";\r\nimport { RequirementList } from \"../../../../components/Challenges/RequirementList\";\r\nimport { Requirement } from \"../../../../components/Challenges/Requirement\";\r\n\r\n<ChallengeTitle>Anchor Escrow</ChallengeTitle>\r\n\r\nBây giờ là lúc để kiểm tra những gì bạn đã học. Sử dụng những gì bạn có được từ bài học, hãy xây dựng một chương trình escrow sử dụng framework Anchor đáp ứng các yêu cầu sau:\r\n\r\n> Tài khoản state của bạn nên được định nghĩa bằng account discriminator với giá trị `1`.\r\n\r\n<RequirementList>\r\n  <Requirement title=\"Thử thách 1: Tạo đề nghị escrow\">\r\n    Chương trình của bạn nên cho phép maker tạo đề nghị escrow. Định nghĩa một lệnh để thực hiện điều này bằng instruction discriminator với giá trị `0`.\r\n  </Requirement>\r\n\r\n  <Requirement title=\"Thử thách 2: Nhận đề nghị escrow\">\r\n    Chương trình của bạn nên cho phép taker nhận đề nghị escrow. Định nghĩa một lệnh để thực hiện điều này bằng instruction discriminator với giá trị `1`.\r\n  </Requirement>\r\n\r\n  <Requirement title=\"Thử thách 3: Hủy đề nghị escrow\">\r\n    Chương trình của bạn nên cho phép maker hủy đề nghị escrow và hoàn lại tiền đã ký gửi. Đảm bảo lệnh của bạn được định nghĩa với instruction discriminator có giá trị `2`.\r\n  </Requirement>\r\n</RequirementList>\r\n","highlightedCode":{}}