e","lang":"rust","meta":null,"value":"#[program]\r\npub mod Kiloshift_anchor_escrow {\r\n    use super::*;\r\n\r\n    pub fn make(ctx: Context<Make>, seed: u64, receive: u64, amount: u64) -> Result<()> {\r\n        instructions::make::handler(ctx, seed, receive, amount)\r\n    }\r\n\r\n    pub fn take(ctx: Context<Take>) -> Result<()> {\r\n        instructions::take::handler(ctx)\r\n    }\r\n\r\n    pub fn refund(ctx: Context<Refund>) -> Result<()> {\r\n        instructions::refund::handler(ctx)\r\n    }\r\n}","position":{"start":{"line":35,"column":1,"offset":2092},"end":{"line":52,"column":4,"offset":2552}},"data":{"highlightId":"code-0"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Conclusion","position":{"start":{"line":54,"column":17,"offset":2572},"end":{"line":54,"column":34,"offset":2589}}},{"type":"mdxJsxAttribute","name":"id","value":"conclusion","position":{"start":{"line":54,"column":35,"offset":2590},"end":{"line":54,"column":50,"offset":2605}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":54,"column":51,"offset":2606},"end":{"line":54,"column":61,"offset":2616}}}],"children":[],"position":{"start":{"line":54,"column":1,"offset":2556},"end":{"line":54,"column":64,"offset":2619}}},{"type":"paragraph","children":[{"type":"text","value":"Vous pouvez maintenant tester votre programme à l'aide de nos tests unitaires et réclamer votre NFT !","position":{"start":{"line":56,"column":1,"offset":2623},"end":{"line":56,"column":102,"offset":2724}}}],"position":{"start":{"line":56,"column":1,"offset":2623},"end":{"line":56,"column":102,"offset":2724}}},{"type":"paragraph","children":[{"type":"text","value":"Commencez par compiler votre programme en utilisant la commande suivante dans votre terminal :","position":{"start":{"line":58,"column":1,"offset":2728},"end":{"line":58,"column":95,"offset":2822}}}],"position":{"start":{"line":58,"column":1,"offset":2728},"end":{"line":58,"column":95,"offset":2822}}},{"type":"code","lang":"bash","meta":null,"value":"anchor build","position":{"start":{"line":60,"column":1,"offset":2826},"end":{"line":62,"column":4,"offset":2852}}},{"type":"paragraph","children":[{"type":"text","value":"Cela générera un fichier ","position":{"start":{"line":64,"column":1,"offset":2856},"end":{"line":64,"column":26,"offset":2881}}},{"type":"inlineCode","value":".so","position":{"start":{"line":64,"column":26,"offset":2881},"end":{"line":64,"column":31,"offset":2886}}},{"type":"text","value":" directement dans votre dossier ","position":{"start":{"line":64,"column":31,"offset":2886},"end":{"line":64,"column":63,"offset":2918}}},{"type":"inlineCode","value":"target/deploy","position":{"start":{"line":64,"column":63,"offset":2918},"end":{"line":64,"column":78,"offset":2933}}},{"type":"text","value":".","position":{"start":{"line":64,"column":78,"offset":2933},"end":{"line":64,"column":79,"offset":2934}}}],"position":{"start":{"line":64,"column":1,"offset":2856},"end":{"line":64,"column":80,"offset":2935}}},{"type":"paragraph","children":[{"type":"text","value":"Cliquez ensuite sur le bouton ","position":{"start":{"line":66,"column":1,"offset":2939},"end":{"line":66,"column":31,"offset":2969}}},{"type":"inlineCode","value":"Relever le challenge","position":{"start":{"line":66,"column":31,"offset":2969},"end":{"line":66,"column":53,"offset":2991}}},{"type":"text","value":" et déposez le fichier !","position":{"start":{"line":66,"column":53,"offset":2991},"end":{"line":66,"column":77,"offset":3015}}}],"position":{"start":{"line":66,"column":1,"offset":2939},"end":{"line":66,"column":77,"offset":3015}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":67,"column":1,"offset":3017}}},"raw":"import { ArticleSection } from \"../../../../../components/ArticleSection/ArticleSection\";\r\n\r\n<ArticleSection name=\"Accepter\" id=\"refund\" level=\"h2\" />\r\n\r\nNous pouvons maintenant passer à l'instruction `refund`, qui se trouve dans le fichier `refund.rs` et qui effectuera ces actions :\r\n- Fermer le PDA d'escrow et retourner la rente au créateur.\r\n- Transférer l'intégralité du solde du Jeton A du vault vers le créateur, puis clôturer le compte du vault.\r\n\r\n### Comptes \r\n\r\nLes comptes nécessaires dans ce contexte sont :\r\n- `maker`: l'utilisateur qui décide des termes de cet échange\r\n- `escrow`: le compte où sont stockés tous les termes de cet échange\r\n- `mint_a`: le jeton que le `maker` a déposé\r\n- `vault`: le compte de jetons associé au `maker` et au `mint_a` où les jetons ont été déposés\r\n- `maker_ata_a`: le compte de jetons associé au `maker` et au `mint_a` qui recevra les jetons du `vault`\r\n- `associated_token_program`: le programme de jetons associé utilisé pour créer les comptes de jetons associés\r\n- `token_program`: le programme de jetons utilisé pour réaliser le transfert grâce à un CPI\r\n- `system_program`: le programme système utilisé pour créer l'`Escrow`\r\n\r\nCette fois-ci, nous n'allons pas vous aider à créer le `Context`, essayez de le faire vous-même ! Veillez à respecter l'ordre des comptes, sinon nos tests échoueront.\r\n\r\n### Logique\r\n\r\nLa logique est similaire à l'instruction `take` mais cette fois nous déplaçons les tokens du `vault` vers le `maker_ata_a` avant de fermer le vault désormais vide. \r\n\r\nCette fois, c'est à vous d'apprendre à le faire vous-même, nous n'allons pas vous donner la solution.\r\n\r\nSachez simplement qu'une fois cette opération effectuée, l'offre est annulée, le vault disparaît et le créateur retrouve son Token A ainsi que sa rente dans son portefeuille.\r\n\r\n<ArticleSection name=\"Point d'entrée (entrypoint)\" id=\"entrypoint\" level=\"h2\" />\r\n\r\nMaintenant que nous avons créé toutes les fonctions dans les différentes instructions, nous pouvons enfin compléter le fichier `lib.rs` avec toutes les fonctions que nous avons créées :\r\n\r\n```rust\r\n#[program]\r\npub mod Kiloshift_anchor_escrow {\r\n    use super::*;\r\n\r\n    pub fn make(ctx: Context<Make>, seed: u64, receive: u64, amount: u64) -> Result<()> {\r\n        instructions::make::handler(ctx, seed, receive, amount)\r\n    }\r\n\r\n    pub fn take(ctx: Context<Take>) -> Result<()> {\r\n        instructions::take::handler(ctx)\r\n    }\r\n\r\n    pub fn refund(ctx: Context<Refund>) -> Result<()> {\r\n        instructions::refund::handler(ctx)\r\n    }\r\n}\r\n```\r\n\r\n<ArticleSection name=\"Conclusion\" id=\"conclusion\" level=\"h2\" />\r\n\r\nVous pouvez maintenant tester votre programme à l'aide de nos tests unitaires et réclamer votre NFT !\r\n\r\nCommencez par compiler votre programme en utilisant la commande suivante dans votre terminal :\r\n\r\n```bash\r\nanchor build\r\n```\r\n\r\nCela générera un fichier `.so` directement dans votre dossier `target/deploy`. \r\n\r\nCliquez ensuite sur le bouton `Relever le challenge` et déposez le fichier !\r\n","highlightedCode":{"code-0":{"lang":"rust","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"#[program]"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"pub"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":" mod"}]},{"type":"element","tagName":"span","properties":{"style":"color:#97E1F1;font-style:italic"},"children":[{"type":"text","value":" Kiloshift_anchor_escrow"}]},{"type":"element","tagName":"span","pro