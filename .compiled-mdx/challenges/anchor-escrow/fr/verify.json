rt":{"line":21,"column":214,"offset":1436},"end":{"line":21,"column":217,"offset":1439}}},{"type":"text","value":".","position":{"start":{"line":21,"column":217,"offset":1439},"end":{"line":21,"column":218,"offset":1440}}}],"position":{"start":{"line":21,"column":5,"offset":1227},"end":{"line":21,"column":218,"offset":1440}}}],"position":{"start":{"line":20,"column":3,"offset":1160},"end":{"line":22,"column":17,"offset":1458}}}],"position":{"start":{"line":11,"column":1,"offset":623},"end":{"line":23,"column":19,"offset":1478}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":24,"column":1,"offset":1480}}},"raw":"import { ChallengeTitle } from \"../../../../components/Challenges/ChallengeTitle\";\r\nimport { RequirementList } from \"../../../../components/Challenges/RequirementList\";\r\nimport { Requirement } from \"../../../../components/Challenges/Requirement\";\r\n\r\n<ChallengeTitle>Escrow avec Anchor</ChallengeTitle>\r\n\r\nIl est maintenant temps de mettre à l'épreuve ce que vous avez appris. En utilisant ce que vous avez appris dans cette leçon, créez un programme d'escrow à l'aide du framework Anchor qui répond aux exigences suivantes :\r\n\r\n> Votre compte d'état doit être défini en utilisant un discriminateur de compte valant `1`.\r\n\r\n<RequirementList>\r\n  <Requirement title=\"Challenge 1: Créer une offre d'escrow\">\r\n    Votre programme doit permettre à un créateur de créer une offre d'escrow. Définissez une instruction pour cela en utilisant un discriminateur d'instruction valant `0`.\r\n  </Requirement>\r\n\r\n  <Requirement title=\"Challenge 2: Accepter une offre d'escrow\">\r\n    Votre programme doit permettre à un preneur d'accepter une offre d'escrow. Définissez une instruction pour cela en utilisant un discriminateur d'instruction valant `1`.\r\n  </Requirement>\r\n\r\n  <Requirement title=\"Challenge 3: Annuler une offre d'escrow\">\r\n    Votre programme doit permettre au créateur d'annuler une offre d'escrow et de restituer les fonds déposés. Assurez-vous que votre instruction est définie avec une valeur de discriminateur d'instruction valant `2`.\r\n  </Requirement>\r\n</RequirementList>\r\n","highlightedCode":{}}