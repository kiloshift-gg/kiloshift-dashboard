1399},"end":{"line":21,"column":197,"offset":1402}}},{"type":"text","value":".","position":{"start":{"line":21,"column":197,"offset":1402},"end":{"line":21,"column":198,"offset":1403}}}],"position":{"start":{"line":21,"column":5,"offset":1210},"end":{"line":21,"column":198,"offset":1403}}}],"position":{"start":{"line":20,"column":3,"offset":1141},"end":{"line":22,"column":17,"offset":1421}}}],"position":{"start":{"line":11,"column":1,"offset":609},"end":{"line":23,"column":19,"offset":1441}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":24,"column":1,"offset":1443}}},"raw":"import { ChallengeTitle } from \"../../../../components/Challenges/ChallengeTitle\";\r\nimport { RequirementList } from \"../../../../components/Challenges/RequirementList\";\r\nimport { Requirement } from \"../../../../components/Challenges/Requirement\";\r\n\r\n<ChallengeTitle>Anchor Escrow</ChallengeTitle>\r\n\r\nSekarang saatnya untuk menguji apa yang telah Anda pelajari. Dengan menggunakan apa yang telah Anda pelajari dari pelajaran ini, buatlah program escrow menggunakan framework Anchor yang memenuhi persyaratan berikut:\r\n\r\n> Akun state Anda harus didefinisikan menggunakan diskriminator akun dengan nilai `1`.\r\n\r\n<RequirementList>\r\n  <Requirement title=\"Tantangan 1: Membuat penawaran escrow\">\r\n    Program Anda harus memungkinkan pembuat untuk membuat penawaran escrow. Definisikan instruksi untuk melakukan ini menggunakan diskriminator instruksi dengan nilai `0`.\r\n  </Requirement>\r\n\r\n  <Requirement title=\"Tantangan 2: Mengambil penawaran escrow\">\r\n    Program Anda harus memungkinkan pengambil untuk mengambil penawaran escrow. Definisikan instruksi untuk melakukan ini menggunakan nilai diskriminator instruksi `1`.\r\n  </Requirement>\r\n\r\n  <Requirement title=\"Tantangan 3: Membatalkan penawaran escrow\">\r\n    Program Anda harus memungkinkan pembuat untuk membatalkan penawaran escrow dan mengembalikan dana yang di-escrow. Pastikan instruksi Anda didefinisikan dengan nilai diskriminator instruksi `2`.\r\n  </Requirement>\r\n</RequirementList>\r\n","highlightedCode":{}}