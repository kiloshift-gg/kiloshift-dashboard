sult<()> {\r\n        instructions::make::handler(ctx, seed, receive, amount)\r\n    }\r\n\r\n    pub fn take(ctx: Context<Take>) -> Result<()> {\r\n        instructions::take::handler(ctx)\r\n    }\r\n\r\n    pub fn refund(ctx: Context<Refund>) -> Result<()> {\r\n        instructions::refund::handler(ctx)\r\n    }\r\n}","position":{"start":{"line":35,"column":1,"offset":2031},"end":{"line":52,"column":4,"offset":2491}},"data":{"highlightId":"code-0"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Conclusion","position":{"start":{"line":54,"column":17,"offset":2511},"end":{"line":54,"column":34,"offset":2528}}},{"type":"mdxJsxAttribute","name":"id","value":"conclusion","position":{"start":{"line":54,"column":35,"offset":2529},"end":{"line":54,"column":50,"offset":2544}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":54,"column":51,"offset":2545},"end":{"line":54,"column":61,"offset":2555}}}],"children":[],"position":{"start":{"line":54,"column":1,"offset":2495},"end":{"line":54,"column":64,"offset":2558}}},{"type":"paragraph","children":[{"type":"text","value":"Sekarang Anda dapat menguji program Anda dengan unit test kami dan mengklaim NFT Anda!","position":{"start":{"line":56,"column":1,"offset":2562},"end":{"line":56,"column":87,"offset":2648}}}],"position":{"start":{"line":56,"column":1,"offset":2562},"end":{"line":56,"column":87,"offset":2648}}},{"type":"paragraph","children":[{"type":"text","value":"Mulailah dengan membangun program Anda menggunakan perintah berikut di terminal Anda","position":{"start":{"line":58,"column":1,"offset":2652},"end":{"line":58,"column":85,"offset":2736}}}],"position":{"start":{"line":58,"column":1,"offset":2652},"end":{"line":58,"column":85,"offset":2736}}},{"type":"code","lang":"bash","meta":null,"value":"anchor build","position":{"start":{"line":60,"column":1,"offset":2740},"end":{"line":62,"column":4,"offset":2766}}},{"type":"paragraph","children":[{"type":"text","value":"Ini akan menghasilkan file ","position":{"start":{"line":64,"column":1,"offset":2770},"end":{"line":64,"column":28,"offset":2797}}},{"type":"inlineCode","value":".so","position":{"start":{"line":64,"column":28,"offset":2797},"end":{"line":64,"column":33,"offset":2802}}},{"type":"text","value":" langsung di folder ","position":{"start":{"line":64,"column":33,"offset":2802},"end":{"line":64,"column":53,"offset":2822}}},{"type":"inlineCode","value":"target/deploy","position":{"start":{"line":64,"column":53,"offset":2822},"end":{"line":64,"column":68,"offset":2837}}},{"type":"text","value":" Anda.","position":{"start":{"line":64,"column":68,"offset":2837},"end":{"line":64,"column":74,"offset":2843}}}],"position":{"start":{"line":64,"column":1,"offset":2770},"end":{"line":64,"column":75,"offset":2844}}},{"type":"paragraph","children":[{"type":"text","value":"Sekarang klik tombol ","position":{"start":{"line":66,"column":1,"offset":2848},"end":{"line":66,"column":22,"offset":2869}}},{"type":"inlineCode","value":"take challenge","position":{"start":{"line":66,"column":22,"offset":2869},"end":{"line":66,"column":38,"offset":2885}}},{"type":"text","value":" dan letakkan file tersebut di sana!","position":{"start":{"line":66,"column":38,"offset":2885},"end":{"line":66,"column":74,"offset":2921}}}],"position":{"start":{"line":66,"column":1,"offset":2848},"end":{"line":66,"column":74,"offset":2921}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":67,"column":1,"offset":2923}}},"raw":"import { ArticleSection } from \"../../../../../components/ArticleSection/ArticleSection\";\r\n\r\n<ArticleSection name=\"Refund\" id=\"refund\" level=\"h2\" />\r\n\r\nSekarang kita dapat beralih ke instruksi `refund`, yang berada di `refund.rs` dan akan melakukan tindakan-tindakan berikut:\r\n- Menutup escrow PDA dan mengirimkan lamports sewanya kembali ke pembuat.\r\n- Memindahkan seluruh saldo Token A keluar dari vault dan kembali ke pembuat, kemudian menutup akun vault.\r\n\r\n### Akun \r\n\r\nAkun-akun yang dibutuhkan dalam konteks ini adalah:\r\n- `maker`: pengguna yang menentukan persyaratan pertukaran\r\n- `escrow`: akun tempat semua persyaratan pertukaran ini berada\r\n- `mint_a`: token yang telah disimpan oleh `maker`\r\n- `vault`: akun token yang terkait dengan `escrow` dan `mint_a` tempat token-token telah disimpan\r\n- `maker_ata_a`: akun token yang terkait dengan `maker` dan `mint_a` yang akan menerima token dari `vault`\r\n- `associated_token_program`: program token terkait yang digunakan untuk membuat akun token terkait\r\n- `token_program`: program token yang digunakan untuk CPI transfer\r\n- `system_program`: program sistem yang digunakan untuk membuat `Escrow`\r\n\r\nKali ini kami tidak akan membantu Anda dengan membuat `Context`, jadi cobalah melakukannya sendiri! Pastikan untuk menggunakan urutan akun yang benar atau tes kami akan gagal.\r\n\r\n### Logika \r\n\r\nLogikanya mirip dengan instruksi `take` tetapi kali ini kita hanya memindahkan token dari `vault` ke `maker_ata_a` sebelum menutup vault yang sekarang kosong. \r\n\r\nKali ini giliran Anda untuk belajar melakukannya sendiri, jadi kami tidak akan memberitahu Anda apa solusinya.\r\n\r\nKetahuilah bahwa setelah ini dieksekusi, penawaran menjadi tidak berlaku, vault hilang, dan pembuat mendapatkan Token A mereka beserta biaya sewa kembali ke dompet mereka.\r\n\r\n<ArticleSection name=\"Entrypoint\" id=\"entrypoint\" level=\"h2\" />\r\n\r\nSekarang setelah kita membuat semua fungsi di berbagai instruksi, akhirnya kita dapat mengisi `lib.rs` dengan semua fungsi yang telah kita buat; seperti ini:\r\n\r\n```rust\r\n#[program]\r\npub mod Kiloshift_anchor_escrow {\r\n    use super::*;\r\n\r\n    pub fn make(ctx: Context<Make>, seed: u64, receive: u64, amount: u64) -> Result<()> {\r\n        instructions::make::handler(ctx, seed, receive, amount)\r\n    }\r\n\r\n    pub fn take(ctx: Context<Take>) -> Result<()> {\r\n        instructions::take::handler(ctx)\r\n    }\r\n\r\n    pub fn refund(ctx: Context<Refund>) -> Result<()> {\r\n        instructions::refund::handler(ctx)\r\n    }\r\n}\r\n```\r\n\r\n<ArticleSection name=\"Conclusion\" id=\"conclusion\" level=\"h2\" />\r\n\r\nSekarang Anda dapat menguji program Anda dengan unit test kami dan mengklaim NFT Anda!\r\n\r\nMulailah dengan membangun program Anda menggunakan perintah berikut di terminal Anda\r\n\r\n```bash\r\nanchor build\r\n```\r\n\r\nIni akan menghasilkan file `.so` langsung di folder `target/deploy` Anda. \r\n\r\nSekarang klik tombol `take challenge` dan letakkan file tersebut di sana!\r\n","highlightedCode":{"code-0":{"lang":"rust","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"#[program]"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"pub"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":" mod"}]},{"type":"element","tagName":"span","properties":{"style":"color:#97E1F1;font-style:italic"},"children":[{"type":"text","value":" Kiloshift_anchor_escrow"}]},{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":" {"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F286C4"},"children":[{"type":"text","value":"    use"}]},{"type":"eleme