"position":{"start":{"line":33,"column":101,"offset":2162},"end":{"line":33,"column":109,"offset":2170}}},{"type":"text","value":" mit allen erstellten Funktionen füllen; so:","position":{"start":{"line":33,"column":109,"offset":2170},"end":{"line":33,"column":153,"offset":2214}}}],"position":{"start":{"line":33,"column":1,"offset":2062},"end":{"line":33,"column":153,"offset":2214}}},{"type":"code","lang":"rust","meta":null,"value":"#[program]\r\npub mod Kiloshift_anchor_escrow {\r\n    use super::*;\r\n\r\n    pub fn make(ctx: Context<Make>, seed: u64, receive: u64, amount: u64) -> Result<()> {\r\n        instructions::make::handler(ctx, seed, receive, amount)\r\n    }\r\n\r\n    pub fn take(ctx: Context<Take>) -> Result<()> {\r\n        instructions::take::handler(ctx)\r\n    }\r\n\r\n    pub fn refund(ctx: Context<Refund>) -> Result<()> {\r\n        instructions::refund::handler(ctx)\r\n    }\r\n}","position":{"start":{"line":35,"column":1,"offset":2218},"end":{"line":52,"column":4,"offset":2678}},"data":{"highlightId":"code-0"}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Conclusion","position":{"start":{"line":54,"column":17,"offset":2698},"end":{"line":54,"column":34,"offset":2715}}},{"type":"mdxJsxAttribute","name":"id","value":"conclusion","position":{"start":{"line":54,"column":35,"offset":2716},"end":{"line":54,"column":50,"offset":2731}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":54,"column":51,"offset":2732},"end":{"line":54,"column":61,"offset":2742}}}],"children":[],"position":{"start":{"line":54,"column":1,"offset":2682},"end":{"line":54,"column":64,"offset":2745}}},{"type":"paragraph","children":[{"type":"text","value":"Du kannst jetzt dein Programm gegen unsere Unit-Tests testen und deine NFTs beanspruchen!","position":{"start":{"line":56,"column":1,"offset":2749},"end":{"line":56,"column":90,"offset":2838}}}],"position":{"start":{"line":56,"column":1,"offset":2749},"end":{"line":56,"column":90,"offset":2838}}},{"type":"paragraph","children":[{"type":"text","value":"Beginne damit, dein Programm mit folgendem Befehl in deinem Terminal zu bauen","position":{"start":{"line":58,"column":1,"offset":2842},"end":{"line":58,"column":78,"offset":2919}}}],"position":{"start":{"line":58,"column":1,"offset":2842},"end":{"line":58,"column":78,"offset":2919}}},{"type":"code","lang":"bash","meta":null,"value":"anchor build","position":{"start":{"line":60,"column":1,"offset":2923},"end":{"line":62,"column":4,"offset":2949}}},{"type":"paragraph","children":[{"type":"text","value":"Dies erzeugt eine ","position":{"start":{"line":64,"column":1,"offset":2953},"end":{"line":64,"column":19,"offset":2971}}},{"type":"inlineCode","value":".so","position":{"start":{"line":64,"column":19,"offset":2971},"end":{"line":64,"column":24,"offset":2976}}},{"type":"text","value":" Datei direkt in deinem ","position":{"start":{"line":64,"column":24,"offset":2976},"end":{"line":64,"column":48,"offset":3000}}},{"type":"inlineCode","value":"target/deploy","position":{"start":{"line":64,"column":48,"offset":3000},"end":{"line":64,"column":63,"offset":3015}}},{"type":"text","value":" Ordner.","position":{"start":{"line":64,"column":63,"offset":3015},"end":{"line":64,"column":71,"offset":3023}}}],"position":{"start":{"line":64,"column":1,"offset":2953},"end":{"line":64,"column":71,"offset":3023}}},{"type":"paragraph","children":[{"type":"text","value":"Klicke jetzt auf die Schaltfläche ","position":{"start":{"line":66,"column":1,"offset":3027},"end":{"line":66,"column":35,"offset":3061}}},{"type":"inlineCode","value":"take challenge","position":{"start":{"line":66,"column":35,"offset":3061},"end":{"line":66,"column":51,"offset":3077}}},{"type":"text","value":" und lege die Datei dort ab!","position":{"start":{"line":66,"column":51,"offset":3077},"end":{"line":66,"column":79,"offset":3105}}}],"position":{"start":{"line":66,"column":1,"offset":3027},"end":{"line":66,"column":79,"offset":3105}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":67,"column":1,"offset":3107}}},"raw":"import { ArticleSection } from \"../../../../../components/ArticleSection/ArticleSection\";\r\n\r\n<ArticleSection name=\"Rückerstattung\" id=\"refund\" level=\"h2\" />\r\n\r\nWir können jetzt zur `refund` Anweisung übergehen, die sich in der `refund.rs` befindet und folgende Aktionen ausführen wird:\r\n- Schließen des Escrow PDA und Rücksendung seiner Rent-Lamports an den Ersteller.\r\n- Verschieben des gesamten Token A-Guthabens aus dem Tresor zurück zum Ersteller und anschließendes Schließen des Tresorkontos.\r\n\r\n### Konten\r\n\r\nDie in diesem Kontext benötigten Konten sind:\r\n- `maker`: der Benutzer, der die Bedingungen des Austauschs festgelegt hat\r\n- `escrow`: das Konto, in dem alle Bedingungen dieses Austauschs gespeichert sind\r\n- `mint_a`: der Token, den der `maker` eingezahlt hat\r\n- `vault`: das Token-Konto, das mit dem `escrow` und `mint_a` verknüpft ist, wo die Tokens eingezahlt wurden\r\n- `maker_ata_a`: das Token-Konto, das mit dem `maker` und `mint_a` verknüpft ist und die Tokens vom `vault` erhalten wird\r\n- `associated_token_program`: das Associated Token Program, das zur Erstellung der zugehörigen Token-Konten verwendet wird\r\n- `token_program`: das Token-Programm, das für den CPI-Transfer verwendet wird\r\n- `system_program`: das System-Programm, das zur Erstellung des `Escrow` verwendet wird\r\n\r\nDiesmal werden wir dir nicht helfen, indem wir das `Context` erstellen, also versuche es selbst! Bitte stelle sicher, dass du die richtige Reihenfolge der Konten verwendest, sonst werden unsere Tests fehlschlagen.\r\n\r\n### Logik\r\n\r\nDie Logik ähnelt der `take` Anweisung, aber diesmal verschieben wir die Tokens nur vom `vault` zum `maker_ata_a`, bevor wir den nun leeren Tresor schließen.\r\n\r\nDiesmal bist du an der Reihe, selbst zu lernen, wie man es macht, daher werden wir dir nicht verraten, wie die Lösung aussieht.\r\n\r\nBeachte, dass sobald dies ausgeführt wird, das Angebot ungültig ist, der Tresor verschwindet und der Ersteller sein Token A und die Miete zurück in seiner Wallet hat.\r\n\r\n<ArticleSection name=\"Entrypoint\" id=\"entrypoint\" level=\"h2\" />\r\n\r\nNachdem wir alle Funktionen in den verschiedenen Anweisungen erstellt haben, können wir endlich den `lib.rs` mit allen erstellten Funktionen füllen; so:\r\n\r\n```rust\r\n#[program]\r\npub mod Kiloshift_anchor_escrow {\r\n    use super::*;\r\n\r\n    pub fn make(ctx: Context<Make>, seed: u64, receive: u64, amount: u64) -> Result<()> {\r\n        instructions::make::handler(ctx, seed, receive, amount)\r\n    }\r\n\r\n    pub fn take(ctx: Context<Take>) -> Result<()> {\r\n        instructions::take::handler(ctx)\r\n    }\r\n\r\n    pub fn refund(ctx: Context<Refund>) -> Result<()> {\r\n        instructions::refund::handler(ctx)\r\n    }\r\n}\r\n```\r\n\r\n<ArticleSection name=\"Conclusion\" id=\"conclusion\" level=\"h2\" />\r\n\r\nDu kannst jetzt dein Programm gegen unsere Unit-Tests testen und deine NFTs beanspruchen!\r\n\r\nBeginne damit, dein Programm mit folgendem Befehl in deinem Terminal zu bauen\r\n\r\n```bash\r\nanchor build\r\n```\r\n\r\nDies erzeugt eine `.so` Datei direkt in deinem `target/deploy` Ordner.\r\n\r\nKlicke jetzt auf die Schaltfläche `take challenge` und lege die Datei dort ab!\r\n","highlightedCode":{"code-0":{"lang":"rust","hast":{"type":"root","children":[{"type":"element","tagName":"pre","properties":{"class":"shiki Kiloshift","style":"background-color:#11141a;color:#f6f6f4","tabindex":"0"},"children":[{"type":"element","tagName":"code","properties":{},"children":[{"type":"element","tagName":"span","properties":{"class":"line"},"children":[{"type":"element","tagName":"span","properties":{"style":"color:#F6F6F4"},"children":[{"type":"text","value":"#[program]"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"span","properties":{"class":"