,"value":"2","position":{"start":{"line":21,"column":219,"offset":1465},"end":{"line":21,"column":222,"offset":1468}}},{"type":"text","value":" definiert ist.","position":{"start":{"line":21,"column":222,"offset":1468},"end":{"line":21,"column":237,"offset":1483}}}],"position":{"start":{"line":21,"column":5,"offset":1251},"end":{"line":21,"column":237,"offset":1483}}}],"position":{"start":{"line":20,"column":3,"offset":1175},"end":{"line":22,"column":17,"offset":1501}}}],"position":{"start":{"line":11,"column":1,"offset":623},"end":{"line":23,"column":19,"offset":1521}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":24,"column":1,"offset":1523}}},"raw":"import { ChallengeTitle } from \"../../../../components/Challenges/ChallengeTitle\";\r\nimport { RequirementList } from \"../../../../components/Challenges/RequirementList\";\r\nimport { Requirement } from \"../../../../components/Challenges/Requirement\";\r\n\r\n<ChallengeTitle>Anchor Escrow</ChallengeTitle>\r\n\r\nEs ist nun an der Zeit, dein erlerntes Wissen auf die Probe zu stellen. Nutze das, was du in der Lektion gelernt hast, um ein Escrow-Programm mit dem Anchor-Framework zu erstellen, das die folgenden Anforderungen erfüllt:\r\n\r\n> Dein State-Account sollte mit einem Account-Diskriminator mit dem Wert `1` definiert werden.\r\n\r\n<RequirementList>\r\n  <Requirement title=\"Herausforderung 1: Ein Escrow-Angebot erstellen\">\r\n    Dein Programm sollte es einem Anbieter ermöglichen, ein Escrow-Angebot zu erstellen. Definiere eine Anweisung dafür mit einem Anweisungs-Diskriminator mit dem Wert `0`.\r\n  </Requirement>\r\n\r\n  <Requirement title=\"Herausforderung 2: Ein Escrow-Angebot annehmen\">\r\n    Dein Programm sollte es einem Abnehmer ermöglichen, ein Escrow-Angebot anzunehmen. Definiere eine Anweisung dafür mit einem Anweisungs-Diskriminator mit dem Wert `1`.\r\n  </Requirement>\r\n\r\n  <Requirement title=\"Herausforderung 3: Ein Escrow-Angebot stornieren\">\r\n    Dein Programm sollte es dem Anbieter ermöglichen, ein Escrow-Angebot zu stornieren und die hinterlegten Gelder zurückzuerstatten. Stelle sicher, dass deine Anweisung mit einem Anweisungs-Diskriminator mit dem Wert `2` definiert ist.\r\n  </Requirement>\r\n</RequirementList>\r\n","highlightedCode":{}}