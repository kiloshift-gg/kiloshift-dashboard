ldren":[{"type":"text","value":"注意","position":{"start":{"line":18,"column":3,"offset":636},"end":{"line":18,"column":5,"offset":638}}}],"position":{"start":{"line":18,"column":1,"offset":634},"end":{"line":18,"column":7,"offset":640}}},{"type":"text","value":"：如果你不熟悉如何使用 TypeScript 與 SPL-Token 程式，應該先閱讀 ","position":{"start":{"line":18,"column":7,"offset":640},"end":{"line":18,"column":51,"offset":684}}},{"type":"link","title":null,"url":"/zh-HK/courses/spl-token-with-web3js","children":[{"type":"text","value":"SPL Token with Web3.js","position":{"start":{"line":18,"column":52,"offset":685},"end":{"line":18,"column":74,"offset":707}}}],"position":{"start":{"line":18,"column":51,"offset":684},"end":{"line":18,"column":113,"offset":746}}},{"type":"text","value":" 以熟悉我們在這次挑戰中需要的 SDK。","position":{"start":{"line":18,"column":113,"offset":746},"end":{"line":18,"column":133,"offset":766}}}],"position":{"start":{"line":18,"column":1,"offset":634},"end":{"line":18,"column":133,"offset":766}}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Kiloshift Sandbox Environment","position":{"start":{"line":20,"column":17,"offset":786},"end":{"line":20,"column":53,"offset":822}}},{"type":"mdxJsxAttribute","name":"id","value":"Kiloshift-sandbox-environment","position":{"start":{"line":20,"column":54,"offset":823},"end":{"line":20,"column":88,"offset":857}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":20,"column":89,"offset":858},"end":{"line":20,"column":99,"offset":868}}}],"children":[],"position":{"start":{"line":20,"column":1,"offset":770},"end":{"line":20,"column":102,"offset":871}}},{"type":"paragraph","children":[{"type":"text","value":"這個挑戰設計為在 ","position":{"start":{"line":22,"column":1,"offset":875},"end":{"line":22,"column":10,"offset":884}}},{"type":"strong","children":[{"type":"text","value":"Kiloshift Sandbox Environment","position":{"start":{"line":22,"column":12,"offset":886},"end":{"line":22,"column":41,"offset":915}}}],"position":{"start":{"line":22,"column":10,"offset":884},"end":{"line":22,"column":43,"offset":917}}},{"type":"text","value":" 中完成。","position":{"start":{"line":22,"column":43,"offset":917},"end":{"line":22,"column":48,"offset":922}}}],"position":{"start":{"line":22,"column":1,"offset":875},"end":{"line":22,"column":48,"offset":922}}},{"type":"paragraph","children":[{"type":"text","value":"這個零配置的沙盒環境提供完成挑戰所需的一切。你可以使用內建的編輯器，支援類型檢查，預先打包的庫，一個錢包，以及一個隔離環境中的 RPC 節點。","position":{"start":{"line":24,"column":1,"offset":926},"end":{"line":24,"column":72,"offset":997}}}],"position":{"start":{"line":24,"column":1,"offset":926},"end":{"line":24,"column":72,"offset":997}}},{"type":"paragraph","children":[{"type":"text","value":"準備好開始編碼了嗎？點擊下方按鈕打開沙盒，開始你的挑戰吧。","position":{"start":{"line":26,"column":1,"offset":1001},"end":{"line":26,"column":30,"offset":1030}}}],"position":{"start":{"line":26,"column":1,"offset":1001},"end":{"line":26,"column":30,"offset":1030}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":27,"column":1,"offset":1032}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# 鑄造 SPL 代幣\r\n\r\n![鑄造 SPL 代幣挑戰](/graphics/challenge-banners/typescript-mint-an-spl-token.png)\r\n\r\nSPL 代幣程式，特別是使用 TypeScript 鑄造代幣，應該是你作為 Solana 開發者旅程的第一步。\r\n\r\n如果你對 SPL 代幣程式不熟悉，請先參考[這個課程](/zh-HK/courses/spl-token-with-web3js)！\r\n\r\n在這個挑戰中，我們將實現四個簡單的指令：\r\n\r\n- **建立鑄幣**：使用原始指令或 SDK 提供的抽象指令建立一個`Mint Account`。\r\n- **初始化鑄幣**：使用原始指令或 SDK 提供的抽象指令初始化已建立的`Mint Account`。*鑄幣應設置為 6 位小數，鑄幣權限設置為運行代碼的錢包，且無凍結權限*。\r\n- **建立關聯代幣帳戶**：使用原始指令或 SDK 提供的抽象指令建立並初始化一個`Associated Token Account`。\r\n- **鑄造 2100 萬代幣**：將 2100 萬（21,000,000）新建立的代幣鑄造到新建立的`Associated Token Account`。\r\n\r\n**注意**：如果你不熟悉如何使用 TypeScript 與 SPL-Token 程式，應該先閱讀 [SPL Token with Web3.js](/zh-HK/courses/spl-token-with-web3js) 以熟悉我們在這次挑戰中需要的 SDK。\r\n\r\n<ArticleSection name=\"Kiloshift Sandbox Environment\" id=\"Kiloshift-sandbox-environment\" level=\"h2\" />\r\n\r\n這個挑戰設計為在 **Kiloshift Sandbox Environment** 中完成。\r\n\r\n這個零配置的沙盒環境提供完成挑戰所需的一切。你可以使用內建的編輯器，支援類型檢查，預先打包的庫，一個錢包，以及一個隔離環境中的 RPC 節點。\r\n\r\n準備好開始編碼了嗎？點擊下方按鈕打開沙盒，開始你的挑戰吧。\r\n","highlightedCode":{}}