set":1202},"end":{"line":18,"column":116,"offset":1308}}},{"type":"link","title":null,"url":"/vi/courses/spl-token-with-web3js","children":[{"type":"text","value":"SPL Token với Web3.js","position":{"start":{"line":18,"column":117,"offset":1309},"end":{"line":18,"column":138,"offset":1330}}}],"position":{"start":{"line":18,"column":116,"offset":1308},"end":{"line":18,"column":174,"offset":1366}}},{"type":"text","value":" để làm quen với các SDK mà chúng ta sẽ cần trong thử thách này.","position":{"start":{"line":18,"column":174,"offset":1366},"end":{"line":18,"column":238,"offset":1430}}}],"position":{"start":{"line":18,"column":1,"offset":1193},"end":{"line":18,"column":238,"offset":1430}}},{"type":"mdxJsxFlowElement","name":"ArticleSection","attributes":[{"type":"mdxJsxAttribute","name":"name","value":"Môi trường Kiloshift Sandbox","position":{"start":{"line":20,"column":17,"offset":1450},"end":{"line":20,"column":52,"offset":1485}}},{"type":"mdxJsxAttribute","name":"id","value":"Kiloshift-sandbox-environment","position":{"start":{"line":20,"column":53,"offset":1486},"end":{"line":20,"column":87,"offset":1520}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":20,"column":88,"offset":1521},"end":{"line":20,"column":98,"offset":1531}}}],"children":[],"position":{"start":{"line":20,"column":1,"offset":1434},"end":{"line":20,"column":101,"offset":1534}}},{"type":"paragraph","children":[{"type":"text","value":"Thử thách được thiết kế để hoàn thành trong ","position":{"start":{"line":22,"column":1,"offset":1538},"end":{"line":22,"column":45,"offset":1582}}},{"type":"strong","children":[{"type":"text","value":"Môi trường Kiloshift Sandbox","position":{"start":{"line":22,"column":47,"offset":1584},"end":{"line":22,"column":75,"offset":1612}}}],"position":{"start":{"line":22,"column":45,"offset":1582},"end":{"line":22,"column":77,"offset":1614}}},{"type":"text","value":".","position":{"start":{"line":22,"column":77,"offset":1614},"end":{"line":22,"column":78,"offset":1615}}}],"position":{"start":{"line":22,"column":1,"offset":1538},"end":{"line":22,"column":78,"offset":1615}}},{"type":"paragraph","children":[{"type":"text","value":"Sandbox sẵn có này đi kèm với mọi thứ bạn cần để hoàn thành thử thách. Bạn có quyền truy cập vào trình soạn thảo tích hợp với hỗ trợ kiểu, các thư viện được đóng gói sẵn, một wallet, và một RPC node trong môi trường cô lập.","position":{"start":{"line":24,"column":1,"offset":1619},"end":{"line":24,"column":224,"offset":1842}}}],"position":{"start":{"line":24,"column":1,"offset":1619},"end":{"line":24,"column":224,"offset":1842}}},{"type":"paragraph","children":[{"type":"text","value":"Sẵn sàng bắt đầu viết mã? Bấm vào nút bên dưới để mở sandbox và bắt đầu thử thách của bạn.","position":{"start":{"line":26,"column":1,"offset":1846},"end":{"line":26,"column":91,"offset":1936}}}],"position":{"start":{"line":26,"column":1,"offset":1846},"end":{"line":26,"column":91,"offset":1936}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":27,"column":1,"offset":1938}}},"raw":"![Mint an SPL Token Challenge](/graphics/challenge-banners/typescript-mint-an-spl-token.png)\r\n\r\n# Tạo một SPL Token\r\n\r\n![Mint an SPL Token Challenge](/graphics/challenge-banners/typescript-mint-an-spl-token.png)\r\n\r\nChương trình SPL token, và cụ thể là tạo một số token bằng TypeScript, nên là điểm khởi đầu đầu tiên trong hành trình của bạn với tư cách là một Solana developer.\r\n\r\nNếu bạn mới làm quen với chương trình SPL Token, hãy theo dõi [khóa học này](/vi/courses/spl-token-with-web3js) trước!\r\n\r\nTrong thử thách này, chúng ta sẽ triển khai bốn instruction đơn giản:\r\n\r\n- **Tạo một Mint**: Tạo `Mint Account` bằng cách sử dụng raw instruction hoặc abstracted instruction mà SDK có sẵn.\r\n- **Khởi tạo Mint**: Khởi tạo `Mint Account` đã tạo bằng cách sử dụng raw instruction hoặc abstracted instruction mà SDK có. *Mint phải có decimal là 6, với mint authority được đặt thành wallet đang chạy code, và không có freeze authority*.\r\n- **Tạo Associated Token Account**: Khởi tạo một `Associated Token Account` bằng cách sử dụng raw instruction hoặc abstracted instruction mà SDK có.\r\n- **Đúc 21 triệu Token**: đúc 21 triệu (21,000,000) token mới tạo vào `Associated Token Account` ở trên.\r\n\r\n**Lưu ý**: Nếu bạn chưa quen với cách sử dụng chương trình SPL-Token với TypeScript, bạn nên bắt đầu bằng cách đọc [SPL Token với Web3.js](/vi/courses/spl-token-with-web3js) để làm quen với các SDK mà chúng ta sẽ cần trong thử thách này.\r\n\r\n<ArticleSection name=\"Môi trường Kiloshift Sandbox\" id=\"Kiloshift-sandbox-environment\" level=\"h2\" />\r\n\r\nThử thách được thiết kế để hoàn thành trong **Môi trường Kiloshift Sandbox**.\r\n\r\nSandbox sẵn có này đi kèm với mọi thứ bạn cần để hoàn thành thử thách. Bạn có quyền truy cập vào trình soạn thảo tích hợp với hỗ trợ kiểu, các thư viện được đóng gói sẵn, một wallet, và một RPC node trong môi trường cô lập.\r\n\r\nSẵn sàng bắt đầu viết mã? Bấm vào nút bên dưới để mở sandbox và bắt đầu thử thách của bạn.\r\n","highlightedCode":{}}