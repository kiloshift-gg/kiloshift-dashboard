e":20,"column":53,"offset":1541}}},{"type":"mdxJsxAttribute","name":"id","value":"Kiloshift-sandbox-environment","position":{"start":{"line":20,"column":54,"offset":1542},"end":{"line":20,"column":88,"offset":1576}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":20,"column":89,"offset":1577},"end":{"line":20,"column":99,"offset":1587}}}],"children":[],"position":{"start":{"line":20,"column":1,"offset":1489},"end":{"line":20,"column":102,"offset":1590}}},{"type":"paragraph","children":[{"type":"text","value":"The challenge is designed to be completed in the ","position":{"start":{"line":22,"column":1,"offset":1594},"end":{"line":22,"column":50,"offset":1643}}},{"type":"strong","children":[{"type":"text","value":"Kiloshift Sandbox Environment","position":{"start":{"line":22,"column":52,"offset":1645},"end":{"line":22,"column":81,"offset":1674}}}],"position":{"start":{"line":22,"column":50,"offset":1643},"end":{"line":22,"column":83,"offset":1676}}},{"type":"text","value":".","position":{"start":{"line":22,"column":83,"offset":1676},"end":{"line":22,"column":84,"offset":1677}}}],"position":{"start":{"line":22,"column":1,"offset":1594},"end":{"line":22,"column":84,"offset":1677}}},{"type":"paragraph","children":[{"type":"text","value":"This zero-config sandbox comes with everything you need to complete the challenge. You have access to a built-in editor with type support, pre-packaged libraries, a wallet, and an RPC node in an isolated environment.","position":{"start":{"line":24,"column":1,"offset":1681},"end":{"line":24,"column":217,"offset":1897}}}],"position":{"start":{"line":24,"column":1,"offset":1681},"end":{"line":24,"column":217,"offset":1897}}},{"type":"paragraph","children":[{"type":"text","value":"Ready to start coding? Click the button below to open the sandbox and begin your challenge.","position":{"start":{"line":26,"column":1,"offset":1901},"end":{"line":26,"column":92,"offset":1992}}}],"position":{"start":{"line":26,"column":1,"offset":1901},"end":{"line":26,"column":92,"offset":1992}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":27,"column":1,"offset":1994}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Mint an SPL Token\r\n\r\n![Mint an SPL Token Challenge](/graphics/challenge-banners/typescript-mint-an-spl-token.png)\r\n\r\nThe SPL token program, and specifically minting some tokens using TypeScript, should be the first starting point in your journey as a Solana developer.\r\n\r\nIf you are new to the SPL Token program, follow [this course](/en/courses/spl-token-with-web3js) before!\r\n\r\nIn this challenge, we're going to implement four simple instructions:\r\n\r\n- **Create a Mint**: Create a `Mint Account` using the raw instruction or the abstracted instruction that the SDK has.\r\n- **Initialize Mint**: Initialize the `Mint Account` created using the raw instruction or the abstracted instruction that the SDK has. *The mint should have 6 decimals, with mint authority set to the wallet that is running the code, and no freeze authority*.\r\n- **Create an Associated Token Account**: Create and initialize an `Associated Token Account` using the raw instruction or the abstracted instruction that the SDK has.\r\n- **Mint 21 million Tokens**: Mint 21 million (21,000,000) of the newly created tokens to the newly created `Associated Token Account`.\r\n\r\n**Note**: If you're not familiar with how to use the SPL-Token program with TypeScript, you should start by reading the [SPL Token with Web3.js](/en/courses/spl-token-with-web3js) to familiarize with the SDKs that we're going to need in this challenge.\r\n\r\n<ArticleSection name=\"Kiloshift Sandbox Environment\" id=\"Kiloshift-sandbox-environment\" level=\"h2\" />\r\n\r\nThe challenge is designed to be completed in the **Kiloshift Sandbox Environment**.\r\n\r\nThis zero-config sandbox comes with everything you need to complete the challenge. You have access to a built-in editor with type support, pre-packaged libraries, a wallet, and an RPC node in an isolated environment.\r\n\r\nReady to start coding? Click the button below to open the sandbox and begin your challenge.\r\n","highlightedCode":{}}