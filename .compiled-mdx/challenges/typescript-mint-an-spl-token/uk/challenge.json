line":20,"column":54,"offset":1537}}},{"type":"mdxJsxAttribute","name":"id","value":"Kiloshift-sandbox-environment","position":{"start":{"line":20,"column":55,"offset":1538},"end":{"line":20,"column":89,"offset":1572}}},{"type":"mdxJsxAttribute","name":"level","value":"h2","position":{"start":{"line":20,"column":90,"offset":1573},"end":{"line":20,"column":100,"offset":1583}}}],"children":[],"position":{"start":{"line":20,"column":1,"offset":1484},"end":{"line":20,"column":103,"offset":1586}}},{"type":"paragraph","children":[{"type":"text","value":"Завдання розроблено для виконання в ","position":{"start":{"line":22,"column":1,"offset":1590},"end":{"line":22,"column":37,"offset":1626}}},{"type":"strong","children":[{"type":"text","value":"середовищі пісочниці Kiloshift","position":{"start":{"line":22,"column":39,"offset":1628},"end":{"line":22,"column":69,"offset":1658}}}],"position":{"start":{"line":22,"column":37,"offset":1626},"end":{"line":22,"column":71,"offset":1660}}},{"type":"text","value":".","position":{"start":{"line":22,"column":71,"offset":1660},"end":{"line":22,"column":72,"offset":1661}}}],"position":{"start":{"line":22,"column":1,"offset":1590},"end":{"line":22,"column":72,"offset":1661}}},{"type":"paragraph","children":[{"type":"text","value":"Ця пісочниця з нульовою конфігурацією має все необхідне для виконання завдання. У вас є доступ до вбудованого редактора з підтримкою типів, попередньо упакованих бібліотек, гаманця та вузла RPC в ізольованому середовищі.","position":{"start":{"line":24,"column":1,"offset":1665},"end":{"line":24,"column":221,"offset":1885}}}],"position":{"start":{"line":24,"column":1,"offset":1665},"end":{"line":24,"column":221,"offset":1885}}},{"type":"paragraph","children":[{"type":"text","value":"Готові почати кодувати? Натисніть кнопку нижче, щоб відкрити пісочницю та розпочати своє завдання.","position":{"start":{"line":26,"column":1,"offset":1889},"end":{"line":26,"column":99,"offset":1987}}}],"position":{"start":{"line":26,"column":1,"offset":1889},"end":{"line":26,"column":99,"offset":1987}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":27,"column":1,"offset":1989}}},"raw":"import { ArticleSection } from \"../../../../components/ArticleSection/ArticleSection\";\r\n\r\n# Створення токена SPL\r\n\r\n![Завдання зі створення токена SPL](/graphics/challenge-banners/typescript-mint-an-spl-token.png)\r\n\r\nПрограма SPL токенів, а особливо створення деяких токенів за допомогою TypeScript, має бути першим кроком у вашій подорожі як розробника Solana.\r\n\r\nЯкщо ви новачок у програмі SPL Token, спочатку пройдіть [цей курс](/uk/courses/spl-token-with-web3js)!\r\n\r\nУ цьому завданні ми реалізуємо чотири прості інструкції:\r\n\r\n- **Створення Mint**: Створення `Mint Account` за допомогою необробленої інструкції або абстрагованої інструкції, яку має SDK.\r\n- **Ініціалізація Mint**: Ініціалізація створеного `Mint Account` за допомогою необробленої інструкції або абстрагованої інструкції, яку має SDK. *Mint повинен мати 6 десяткових знаків, з правами mint, встановленими для гаманця, який запускає код, і без прав заморожування*.\r\n- **Створення асоційованого токен-акаунта**: Створення та ініціалізація `Associated Token Account` за допомогою необробленої інструкції або абстрагованої інструкції, яку має SDK.\r\n- **Створення 21 мільйона токенів**: Створення 21 мільйона (21 000 000) нових токенів на щойно створеному `Associated Token Account`.\r\n\r\n**Примітка**: Якщо ви не знайомі з використанням програми SPL-Token з TypeScript, вам слід почати з читання [SPL Token з Web3.js](/uk/courses/spl-token-with-web3js), щоб ознайомитися з SDK, які нам знадобляться в цьому завданні.\r\n\r\n<ArticleSection name=\"Середовище пісочниці Kiloshift\" id=\"Kiloshift-sandbox-environment\" level=\"h2\" />\r\n\r\nЗавдання розроблено для виконання в **середовищі пісочниці Kiloshift**.\r\n\r\nЦя пісочниця з нульовою конфігурацією має все необхідне для виконання завдання. У вас є доступ до вбудованого редактора з підтримкою типів, попередньо упакованих бібліотек, гаманця та вузла RPC в ізольованому середовищі.\r\n\r\nГотові почати кодувати? Натисніть кнопку нижче, щоб відкрити пісочницю та розпочати своє завдання.\r\n","highlightedCode":{}}